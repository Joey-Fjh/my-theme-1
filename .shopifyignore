# This file contains a list of files that will be excluded from Shopify CLI
# operations such as push, pull, dev, etc.
#
# Examples:
#
# Ignore a specific file:
#   templates/product.json
#
# Ignore templates with a wildcard pattern:
#   templates/*.json
#
# Ignore templates and sections with a regular expression:
#   /(templates|sections)/.*\.json/

node_modules/*
package-lock.json
package.json
.editorconfig
.gitattributes
.gitignore
.prettierignore
.prettierrc
.theme-check.yml
.browserslistrc
eslint.config.cjs
stylelint.config.cjs
svgo.config.cjs
.vscode/**
.github/**
README.md
AGENTS.md
CLAUDE.md
docs/**
.agents/**
.claude/**
.codex/**
.cursor/**
icons/**
tailwind/**
shopify.theme.toml
.mcp.json

# Local environment files may contain secrets. Excluding them from theme upload
# reduces accidental exposure; whether Shopify CLI uploads them without this rule
# is unverified.
.env
.env.*

# Batch execution scratch files (exclude from theme upload)
.tmp-*
__pycache__/
*.pyc
