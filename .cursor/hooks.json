{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": "node .cursor/cursor-hook.mjs sessionStart" }],
    "preToolUse": [{ "command": "node .cursor/cursor-hook.mjs preToolUse", "failClosed": true }],
    "beforeShellExecution": [
      { "command": "node .cursor/cursor-hook.mjs beforeShellExecution", "failClosed": true }
    ],
    "subagentStart": [
      { "command": "node .cursor/cursor-hook.mjs subagentStart", "failClosed": true }
    ],
    "postToolUse": [{ "command": "node .cursor/cursor-hook.mjs postToolUse" }],
    "stop": [{ "command": "node .cursor/cursor-hook.mjs stop", "loop_limit": 1 }]
  }
}
