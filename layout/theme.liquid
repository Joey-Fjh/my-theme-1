<!doctype html>
{%- liquid
    assign rtl_locales = 'ar,he,fa,ur' | split: ','
    assign lang_code = request.locale.iso_code | split: '-' | first
    if rtl_locales contains lang_code
        assign dir = 'rtl'
    else
        assign dir = 'ltr'
    endif
    assign page_canvas_color_scheme = settings.page_canvas_color_scheme | default: 'scheme-2'
-%}
<html lang="{{ request.locale.iso_code }}" dir="{{ dir }}">
    <head>
        {% # Social, title, etc. %}
        {% render 'meta-tags' %}

        {% # Inlined CSS Variables %}
        {% render 'css-variables' %}

        {% # Load and preload the CSS %}
        {{ 'tailwind.output.css' | asset_url | stylesheet_tag: preload: true }}

        {% comment %} --- 1. Third-party UI libraries --- {% endcomment %}
        <script src="{{ 'vendor-swiper.min.js' | asset_url }}" defer></script>

        {% comment %} --- 2. Core utility classes (No external dependencies) --- {% endcomment %}
        <script src="{{ 'utils.js' | asset_url }}" defer></script>
        <script src="{{ 'quantity-constraints.js' | asset_url }}" defer></script>
        <script src="{{ 'events.js' | asset_url }}" defer></script>

        {% comment %} --- 3. Alpine component definitions (Depends on Utils) --- {% endcomment %}
        <script src="{{ 'alpine.components.js' | asset_url }}" defer></script>
        <script src="{{ 'alpine.components.ui.js' | asset_url }}" defer></script>
        <script src="{{ 'alpine.components.header.js' | asset_url }}" defer></script>
        <script src="{{ 'alpine.components.pagination.js' | asset_url }}" defer></script>
        <script src="{{ 'alpine.components.filters.js' | asset_url }}" defer></script>
        <script src="{{ 'alpine.components.product.js' | asset_url }}" defer></script>
        <script src="{{ 'alpine.components.product-media.js' | asset_url }}" defer></script>
        <script src="{{ 'alpine.components.product-cards.js' | asset_url }}" defer></script>
        <script src="{{ 'alpine.components.search.js' | asset_url }}" defer></script>
        <script src="{{ 'alpine.components.overlays.js' | asset_url }}" defer></script>
        <script src="{{ 'alpine.components.registry.js' | asset_url }}" defer></script>

        {% comment %} --- 3b. Performance monitoring (debug only, no dependencies) --- {% endcomment %}
        <script src="{{ 'performance.js' | asset_url }}" defer></script>

        {% comment %} --- 4. Unified HTTP + section rendering layer --- {% endcomment %}
        <script src="{{ 'https.js' | asset_url }}" defer></script>

        {% comment %} --- 5. Core dispatcher & entry point (Depends on Utils, AlpineComponents, and third-party libs) --- {% endcomment %}
        <script src="{{ 'base.js' | asset_url }}" defer></script>

        {% comment %} --- 5b. Alpine global stores -- must run before Alpine --- {% endcomment %}
        <script src="{{ 'alpine.store.js' | asset_url }}" defer></script>
        <script src="{{ 'alpine.store.toast.js' | asset_url }}" defer></script>
        <script src="{{ 'dialog-motion.js' | asset_url }}" defer></script>
        <script src="{{ 'drawer-motion.js' | asset_url }}" defer></script>
        <script src="{{ 'alpine.store.dialog.js' | asset_url }}" defer></script>
        <script src="{{ 'alpine.store.cart.js' | asset_url }}" defer></script>
        <script src="{{ 'alpine.store.registry.js' | asset_url }}" defer></script>

        {% comment %} --- 6. Alpine.js framework initialization (Must be loaded last) --- {% endcomment %}
        <script src="{{ 'vendor-alpine-intersect.min.js' | asset_url }}" defer></script>
        <script src="{{ 'vendor-alpine.min.js' | asset_url }}" defer></script>

        {{ content_for_header }}
    </head>

    <body
        class="color-{{ page_canvas_color_scheme }}"
        data-initial-cart="{{ cart | json | escape }}"
        data-cart-type="{{ settings.cart_type }}"
        {% if settings.motion_enabled == false %}
            data-motion-enabled="false"
        {% endif %}
        {% if settings.content_reveal_style != blank and settings.content_reveal_style != 'none' %}
            data-content-reveal-style="{{ settings.content_reveal_style }}"
        {% endif %}
        {% if settings.media_reveal_style != blank and settings.media_reveal_style != 'none' %}
            data-media-reveal-style="{{ settings.media_reveal_style }}"
        {% endif %}
        data-reveal-behavior="{{ settings.reveal_behavior | default: 'once' }}"
    >
        <a class="skip-link" href="#MainContent">
            {{- 'accessibility.skip_to_content' | t -}}
        </a>

        {% sections 'overlay-group' %}

        {% sections 'header-group' %}

        <main id="MainContent" class="relative shadow-none outline-none" role="main" tabindex="-1">
            {{ content_for_layout }}
        </main>

        {% sections 'footer-group' %}

        {% render 'ui-toast' %}
    </body>
</html>
