<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the CSS %} 
    {{ 'tailwind.output.css' | asset_url | stylesheet_tag: preload: true}}

    {% comment %} --- 1. Third-party animation/UI libraries (No external dependencies) --- {% endcomment %}
    <script src="{{ 'gsap.js' | asset_url }}" defer></script>
    <script src="{{ 'gsap-ScrollTrigger.js' | asset_url }}" defer></script>
    <script src="{{ 'swiper.js' | asset_url }}" defer></script>

    {% comment %} --- 2. Core utility classes (No external dependencies) --- {% endcomment %}
    <script src="{{ 'utils.js' | asset_url }}" defer></script>

    {% comment %} --- 3. Business component definitions (Depends on Utils) --- {% endcomment %}
    <script src="{{ 'alpine.components.js' | asset_url }}" defer></script>

    {% comment %} --- 3b. Performance monitoring (debug only, no dependencies) --- {% endcomment %}
    <script src="{{ 'performance.js' | asset_url }}" defer></script>

    {% comment %} --- 4. Core dispatcher & entry point (Depends on Utils, AlpineComponents, and third-party libs) --- {% endcomment %}
    <script src="{{ 'base.js' | asset_url }}" defer></script>

    {% comment %} --- 4b. Alpine global stores (dialog, cart) — must run before Alpine --- {% endcomment %}
    <script src="{{ 'alpine.store.js' | asset_url }}" defer></script>

    {% comment %} --- 5. Alpine.js framework initialization (Must be loaded last) --- {% endcomment %}
    <script src="{{ 'alpine-intersect.js' | asset_url }}" defer></script>
    <script src="{{ 'alpine.js' | asset_url }}" defer></script>
  
    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}

    <main id="MainContent" class="relative shadow-none outline-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'ui-toast' %}

    {% comment %} Global initial state hydration for Alpine stores {% endcomment %}
    <script>
      window.__Theme__ = window.__Theme__ || {};
      window.__Theme__.initialState = {
        cart: {{ cart | json }}
      };
    </script>
  </body>
</html>
