<!doctype html>
<html lang="{{ request.locale.iso_code }}">
    <head>
        {% # Inlined CSS Variables %}
        {% render 'css-variables' %}

        {% # Load and preload the critical CSS %}
        {{ 'tailwind.output.css' | asset_url | stylesheet_tag: preload: true }}

        {% # Social, title, etc. %}
        {% render 'meta-tags' %}

        {{ content_for_header }}
    </head>

    <body class="flex min-h-dvh flex-col">
        {{ content_for_layout }}
    </body>
</html>
