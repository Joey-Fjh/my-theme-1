{
    "name": "my-skeleton-theme",
    "version": "1.0.0",
    "description": "my skeleton theme is based on the [Skeleton](http://getskeleton.com/) framework.",
    "scripts": {
        "build:tw": "npx @tailwindcss/cli -i ./tailwind/tailwind.input.css -o ./assets/tailwind.output.css",
        "watch:tw": "npx @tailwindcss/cli -i ./tailwind/tailwind.input.css -o ./assets/tailwind.output.css --watch",
        "build:svg": "npx svgo -f icons -o assets --config=svgo.config.js",
        "test": "shopify theme check",
        "shopify:dev": "shopify theme dev -e development",
        "dev": "concurrently \"npm run shopify:dev\" \"npm run watch:tw\"",
        "format": "prettier . --write",
        "format:check": "prettier . --check"
    },
    "keywords": [],
    "author": "JoeyFan",
    "license": "ISC",
    "devDependencies": {
        "@shopify/prettier-plugin-liquid": "^1.10.2",
        "@tailwindcss/cli": "^4.1.18",
        "concurrently": "^9.2.1",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "svgo": "^4.0.0",
        "tailwindcss": "^4.1.18"
    }
}
