{
    "name": "my-skeleton-theme",
    "version": "1.0.0",
    "description": "my skeleton theme is based on the [Skeleton](http://getskeleton.com/) framework.",
    "scripts": {
        "build:tw": "npx @tailwindcss/cli -i ./tailwind/tailwind.input.css -o ./assets/tailwind.output.css",
        "watch:tw": "npx @tailwindcss/cli -i ./tailwind/tailwind.input.css -o ./assets/tailwind.output.css --watch",
        "build:svg": "npx svgo -f icons -o assets --config=.agents/skills/build-svg-icons/scripts/svgo.config.js",
        "lint": "npm run lint:css && npm run lint:i18n && npm run lint:theme && npm run format:check",
        "lint:css": "stylelint \"assets/base.css\" \"tailwind/**/*.css\" --config .agents/skills/check-css/scripts/stylelint.config.js",
        "lint:i18n": "node .agents/skills/check-i18n/scripts/lint-i18n.js",
        "lint:theme": "node .agents/skills/check-theme-architecture/scripts/lint-theme.js",
        "test": "shopify theme check",
        "shopify:dev": "shopify theme dev -e development",
        "dev": "concurrently \"npm run shopify:dev\" \"npm run watch:tw\"",
        "format": "prettier . --write",
        "format:check": "prettier . --check"
    },
    "keywords": [],
    "author": "JoeyFan",
    "license": "ISC",
    "devDependencies": {
        "@shopify/liquid-html-parser": "^2.9.2",
        "@shopify/prettier-plugin-liquid": "^1.10.2",
        "@tailwindcss/cli": "^4.1.18",
        "concurrently": "^9.2.1",
        "fast-glob": "^3.3.3",
        "jsonc-parser": "^3.3.1",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "stylelint": "^16.26.1",
        "stylelint-config-standard": "^39.0.1",
        "svgo": "^4.0.0",
        "tailwindcss": "^4.1.18"
    }
}
