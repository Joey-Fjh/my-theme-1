{
    "name": "my-theme-1",
    "version": "1.0.0",
    "private": true,
    "description": "Ceylune — custom Shopify Online Store 2.0 theme (Theme Store candidate). Liquid, Tailwind CSS v4, Alpine.js, and a lifecycle-aware JavaScript runtime.",
    "scripts": {
        "build:tw": "tailwindcss -i ./tailwind/tailwind.input.css -o ./assets/tailwind.output.css",
        "watch:tw": "tailwindcss -i ./tailwind/tailwind.input.css -o ./assets/tailwind.output.css --watch",
        "build:svg": "svgo -f icons -o assets --config=svgo.config.cjs",
        "lint": "npm run lint:liquid-syntax && npm run lint:i18n && npm run lint:theme && npm run lint:compat && npm run lint:doc-paths && npm run format:check",
        "lint:doc-paths": "node .agents/tools/lint-doc-paths.mjs",
        "lint:compat": "npm run lint:compat:css && npm run lint:compat:js && npm run lint:compat:embedded",
        "lint:compat:css": "stylelint \"tailwind/*.css\" assets/base.css assets/tailwind.output.css assets/gift-card.css",
        "lint:compat:embedded": "node .agents/skills/check-theme-architecture/scripts/lint-embedded-compat.cjs",
        "lint:compat:js": "eslint \"assets/*.js\"",
        "lint:i18n": "node .agents/skills/check-i18n/scripts/lint-i18n.js && node .agents/skills/check-i18n/scripts/lint-i18n-unused.js",
        "test:i18n": "node --test .agents/skills/check-i18n/scripts/lint-i18n.test.js .agents/skills/check-i18n/scripts/lint-i18n-unused.test.js",
        "test:theme-architecture": "node --test .agents/skills/check-theme-architecture/scripts/theme-architecture.test.js",
        "test:section-stylesheet-carry": "node --test .agents/skills/check-theme-architecture/scripts/section-stylesheet-carry.test.js",
        "test:validators": "npm run test:i18n && npm run test:theme-architecture && npm run test:section-stylesheet-carry && npm run test:doc-paths",
        "test:doc-paths": "node --test .agents/tools/lint-doc-paths.test.mjs",
        "lint:liquid-syntax": "node .agents/skills/check-theme-architecture/scripts/lint-liquid-syntax.js",
        "lint:theme": "node .agents/skills/check-theme-architecture/scripts/lint-theme.js",
        "scan:compat": "npm run build:tw && npm run lint:compat",
        "test": "npm run test:validators && npm run lint:liquid-syntax && npm run test:theme-check",
        "test:layout": "node .agents/tools/layout-check/layout-check.mjs",
        "test:layout-harness": "node --test .agents/tools/layout-check/layout-check.test.mjs",
        "test:theme-check": "shopify theme check",
        "shopify:dev": "shopify theme dev -e development",
        "dev": "concurrently \"npm run shopify:dev\" \"npm run watch:tw\"",
        "doctor:agent": "node .agents/tools/doctor-agent.mjs",
        "format": "prettier . --write",
        "format:check": "prettier . --check"
    },
    "keywords": [],
    "author": "JoeyFan",
    "license": "SEE LICENSE IN LICENSE.md",
    "engines": {
        "node": ">=22"
    },
    "devDependencies": {
        "@shopify/liquid-html-parser": "^2.9.2",
        "@shopify/prettier-plugin-liquid": "^1.10.2",
        "@tailwindcss/cli": "^4.1.18",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.5",
        "eslint-plugin-compat": "^7.0.2",
        "espree": "^10.4.0",
        "fast-glob": "^3.3.3",
        "globals": "^17.9.0",
        "jsonc-parser": "^3.3.1",
        "playwright-core": "^1.64.0",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "smol-toml": "^1.9.0",
        "stylelint": "^17.14.1",
        "stylelint-no-unsupported-browser-features": "^8.1.1",
        "svgo": "^4.0.0",
        "tailwindcss": "^4.1.18"
    }
}
