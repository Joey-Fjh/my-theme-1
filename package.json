{
    "name": "my-skeleton-theme",
    "version": "1.0.0",
    "description": "my skeleton theme is based on the [Skeleton](http://getskeleton.com/) framework.",
    "scripts": {
        "build:tw": "npx @tailwindcss/cli -i ./tailwind/tailwind.input.css -o ./assets/tailwind.output.css",
        "watch:tw": "npx @tailwindcss/cli -i ./tailwind/tailwind.input.css -o ./assets/tailwind.output.css --watch",
        "build:svg": "npx svgo -f icons -o assets --config=.agents/skills/build-svg-icons/scripts/svgo.config.js",
        "lint": "npm run lint:i18n && npm run lint:theme && npm run lint:compat && npm run lint:agents && npm run format:check",
        "lint:agents": "node .agents/skills/orchestrate-agents/scripts/lint-agent-system.js && node .agents/skills/orchestrate-agents/scripts/test-agent-result-hook.cjs",
        "lint:compat": "npm run lint:compat:css && npm run lint:compat:js && npm run lint:compat:embedded",
        "lint:compat:css": "stylelint \"tailwind/*.css\" assets/base.css assets/tailwind.output.css assets/gift-card.css",
        "lint:compat:embedded": "node .agents/skills/check-theme-architecture/scripts/lint-embedded-compat.cjs",
        "lint:compat:js": "eslint \"assets/*.js\"",
        "test:agent-hooks": "node .agents/skills/orchestrate-agents/scripts/test-agent-result-hook.cjs",
        "lint:i18n": "node .agents/skills/check-i18n/scripts/lint-i18n.js",
        "lint:theme": "node .agents/skills/check-theme-architecture/scripts/lint-theme.js",
        "scan:compat": "npm run build:tw && npm run lint:compat",
        "test": "shopify theme check",
        "shopify:dev": "shopify theme dev -e development",
        "dev": "concurrently \"npm run shopify:dev\" \"npm run watch:tw\"",
        "format": "prettier . --write",
        "format:check": "prettier . --check"
    },
    "keywords": [],
    "author": "JoeyFan",
    "license": "ISC",
    "engines": {
        "node": ">=22"
    },
    "devDependencies": {
        "@shopify/liquid-html-parser": "^2.9.2",
        "@shopify/prettier-plugin-liquid": "^1.10.2",
        "@tailwindcss/cli": "^4.1.18",
        "ajv": "^8.20.0",
        "browserslist": "^4.28.7",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.5",
        "eslint-plugin-compat": "^7.0.2",
        "fast-glob": "^3.3.3",
        "globals": "^17.9.0",
        "jsonc-parser": "^3.3.1",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "stylelint": "^17.14.1",
        "stylelint-no-unsupported-browser-features": "^8.1.1",
        "svgo": "^4.0.0",
        "tailwindcss": "^4.1.18"
    }
}
