{% doc %}
    Reusable stacked double-arrow icon used by progressive disclosure triggers.

    @param {string} [wrapper_class] - Optional wrapper classes.
{% enddoc %}

{%- assign wrapper_class = wrapper_class | default: 'inline-flex flex-col' -%}

<span class="{{ wrapper_class }}">
    {% render 'icons', icon: 'icon-arrow', size: 'xs', class: 'rotate-180' %}
    {% render 'icons', icon: 'icon-arrow', size: 'xs' %}
</span>
