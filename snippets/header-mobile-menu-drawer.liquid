{%- assign popup_id = popup_id | default: 'header-mobile-menu-drawer' -%}
{%- assign menu_handle = menu_handle | default: blank -%}
{%- assign menu_obj = linklists[menu_handle] -%}
{%- assign account_href = routes.account_login_url -%}
{%- if customer -%}
    {%- assign account_href = routes.account_url -%}
{%- endif -%}

{%- if menu_obj != blank and menu_obj.links != blank -%}
    {%- capture drawer_content -%}
        <div
            class="flex h-full flex-col bg-[#E9E9E9] text-[#263D29]"
            x-data="mobileMenuDrawer"
            @keydown.escape.window="$store.dialog.close()"
        >
            <div class="flex items-center justify-between px-6 pt-5 pb-4">
                <div class="flex items-center gap-4 text-[#263D29]">
                    <button
                        type="button"
                        class="inline-flex h-8 w-8 cursor-pointer items-center justify-center"
                        @click="$store.dialog.close(); $store.dialog.open('search-overlay-drawer')"
                        aria-label="Open search"
                    >
                        {% render 'icons', icon: 'icon-search', class: 'h-6 w-6', color: 'current' %}
                    </button>
                    <a
                        href="{{ account_href }}"
                        class="inline-flex h-8 w-8 items-center justify-center"
                        aria-label="Account"
                    >
                        {% render 'icons', icon: 'icon-account', class: 'h-6 w-6', color: 'current' %}
                    </a>
                </div>

                <button
                    type="button"
                    class="inline-flex h-8 w-8 cursor-pointer items-center justify-center text-[#263D29]/80"
                    @click="$store.dialog.close()"
                    aria-label="Close mobile menu"
                >
                    <span class="h3 leading-none">&times;</span>
                </button>
            </div>

            <div class="min-h-0 flex-1 overflow-y-auto px-6 pb-6">
                <template x-if="!thirdLevelLinks.length">
                    <div>
                        <ul x-ref="topMenu" class="space-y-4" role="list">
                            {%- for link in menu_obj.links -%}
                                <li data-has-children="{% if link.links != blank %}true{% else %}false{% endif %}">
                                    {%- if link.links == blank -%}
                                        {%- capture top_attributes -%}
                                            {%- if link.current -%}
                                                aria-current="page"
                                            {%- endif -%}
                                        {%- endcapture -%}
                                        {% render 'link',
                                            text: link.title | escape,
                                            href: link.url,
                                            variant: 'underline',
                                            class: 'inline-flex items-center text-lg text-[#263D29]/90',
                                            attributes: top_attributes,
                                            color: 'current'
                                        %}
                                    {%- else -%}
                                        <button
                                            type="button"
                                            class="inline-flex cursor-pointer items-center gap-2 text-lg text-[#263D29]/90"
                                            @click="openTop({{ forloop.index0 }})"
                                            :aria-expanded="activeTopIndex === {{ forloop.index0 }}"
                                        >
                                            <span>{{ link.title | escape }}</span>
                                            <span
                                                class="inline-flex transition-transform duration-200"
                                                :class="activeTopIndex === {{ forloop.index0 }} ? 'rotate-180' : ''"
                                            >
                                                {% render 'icons', icon: 'icon-arrow', class: 'h-4 w-4', color: 'current' %}
                                            </span>
                                        </button>

                                        <div x-show="activeTopIndex === {{ forloop.index0 }}" class="pt-4">
                                            <ul class="space-y-4" role="list">
                                                {%- for child in link.links -%}
                                                    <li class="text-[#263D29]/55">
                                                        {%- if child.links == blank -%}
                                                            {%- capture child_attributes -%}
                                                                {%- if child.current -%}
                                                                    aria-current="page"
                                                                {%- endif -%}
                                                            {%- endcapture -%}
                                                            {% render 'link',
                                                                text: child.title | escape,
                                                                href: child.url,
                                                                variant: 'underline',
                                                                class: 'inline-flex items-center text-[24px] leading-[1.2] font-light',
                                                                attributes: child_attributes,
                                                                color: 'current'
                                                            %}
                                                        {%- else -%}
                                                            {%- capture third_payload -%}
                                                                {
                                                                    "title": {{ child.title | json }},
                                                                    "links": [
                                                                        {%- for grandchild in child.links -%}
                                                                            { "title": {{ grandchild.title | json }}, "url": {{ grandchild.url | json }} }{% unless forloop.last %},{% endunless %}
                                                                        {%- endfor -%}
                                                                    ]
                                                                }
                                                            {%- endcapture -%}
                                                            <button
                                                                type="button"
                                                                class="inline-flex cursor-pointer items-end gap-1 text-[24px] leading-[1.2] font-light"
                                                                data-third-payload="{{ third_payload | strip | escape }}"
                                                                @click="openThirdLevelFromButton($el)"
                                                            >
                                                                <span class="underline decoration-1 underline-offset-3">
                                                                    {{ child.title | escape }}
                                                                </span>
                                                                <span class="text-sm opacity-70">({{ child.links.size }})</span>
                                                            </button>
                                                        {%- endif -%}
                                                    </li>
                                                {%- endfor -%}
                                            </ul>
                                        </div>
                                    {%- endif -%}
                                </li>
                            {%- endfor -%}
                        </ul>
                    </div>
                </template>

                <template x-if="thirdLevelLinks.length">
                    <div class="h-full">
                        <button
                            type="button"
                            class="mb-6 inline-flex cursor-pointer items-center gap-3 text-[#263D29]"
                            @click="backToSecondLevel()"
                            aria-label="Back to second level menu"
                        >
                            <span class="inline-flex rotate-90">
                                {% render 'icons', icon: 'icon-arrow', class: 'h-4 w-4', color: 'current' %}
                            </span>
                            <span class="h5" x-text="thirdLevelParentTitle"></span>
                        </button>

                        <ul class="space-y-4 text-[#263D29]/80" role="list">
                            <template x-for="item in thirdLevelLinks" :key="item.url + item.title">
                                <li>
                                    <a
                                        :href="item.url"
                                        class="inline-flex items-center text-lg leading-tight"
                                        x-text="item.title"
                                    ></a>
                                </li>
                            </template>
                        </ul>
                    </div>
                </template>
            </div>
        </div>
    {%- endcapture -%}

    {%- render 'ui-dialog',
        id: popup_id,
        type: 'drawer',
        position: 'left',
        overlay_class: 'bg-black/35',
        root_class: 'z-[10010] pc:hidden',
        drawer_wrapper_class: '!max-w-[23.5rem]',
        drawer_panel_class: 'overflow-hidden',
        content: drawer_content
    -%}
{%- endif -%}
