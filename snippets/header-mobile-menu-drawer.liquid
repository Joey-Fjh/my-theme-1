{%- assign popup_id = popup_id | default: 'header-mobile-menu-drawer' -%}
{%- assign menu_handle = menu_handle | default: blank -%}
{%- assign enable_country_selector = enable_country_selector | default: true, allow_false: true -%}
{%- assign enable_language_selector = enable_language_selector
    | default: true, allow_false: true
-%}
{%- liquid
    assign show_country_selector = false
    if enable_country_selector and localization.available_countries.size > 1
        assign show_country_selector = true
    endif
    assign show_language_selector = false
    if enable_language_selector and localization.available_languages.size > 1
        assign show_language_selector = true
    endif
    # Long lists get a filter field (Dawn and Horizon do the same for many countries).
    assign localization_filter_min = 10
    assign country_currencies = localization.available_countries | map: 'currency' | map: 'iso_code' | uniq
-%}
{%- assign menu_obj = linklists[menu_handle] -%}
{%- assign color_scheme = color_scheme | default: '' -%}
{%- assign account_href = routes.account_login_url -%}
{%- if customer -%}
    {%- assign account_href = routes.account_url -%}
{%- endif -%}

{%- if menu_obj != blank and menu_obj.links != blank -%}
    {%- capture drawer_content -%}
        <div
            class="flex h-full flex-col"
            x-data="mobileMenuDrawer"
            data-module-id="mobile-menu-drawer"
            @keydown.escape.window="$store.dialog.close()"
        >
            <div class="ui-dialog-overlay-header border-line-strong">
                <h2 id="dialog-title-{{ popup_id }}">
                    {{ 'accessibility.menu' | t }}
                </h2>

                <button
                    type="button"
                    class="close-button"
                    @click="$store.dialog.close()"
                    aria-label="{{ 'accessibility.close_mobile_menu' | t }}"
                >
                    {% render 'icons', icon: 'icon-close' %}
                </button>
            </div>

            <div class="ui-dialog-overlay-body">
                <div x-show="!localizationPanel">
                <template x-if="!thirdLevelLinks.length">
                    <nav aria-label="{{ 'accessibility.mobile_menu' | t }}">
                        <ul x-ref="topMenu" class="space-y-step-s" role="list">
                            {%- for link in menu_obj.links -%}
                                <li data-has-children="{% if link.links != blank %}true{% else %}false{% endif %}">
                                    {%- if link.links == blank -%}
                                        {%- capture top_attributes -%}
                                            {%- if link.current -%}
                                                aria-current="page"
                                            {%- endif -%}
                                        {%- endcapture -%}
                                        
                                        {%- assign link_text = link.title | escape -%}
                                        {% render 'link',
                                            text: link_text,
                                            href: link.url,
                                            variant: 'underline',
                                            class: 'inline-flex items-center',
                                            attributes: top_attributes
                                        %}
                                    {%- else -%}
                                        <button
                                            type="button"
                                            class="inline-flex cursor-pointer items-center gap-step-2xs"
                                            data-index="{{ forloop.index0 }}"
                                            aria-controls="mobile-sub-{{ forloop.index0 }}"
                                            @click="openTop(Number($el.dataset.index))"
                                            :aria-expanded="activeTopIndex === Number($el.dataset.index)"
                                        >
                                            <span>{{ link.title | escape }}</span>
                                            <span
                                                class="header-mobile-menu-drawer__chevron"
                                                data-index="{{ forloop.index0 }}"
                                                :class="activeTopIndex === Number($el.dataset.index) ? 'rotate-180' : ''"
                                            >
                                                {% render 'icons', icon: 'icon-arrow' %}
                                            </span>
                                        </button>

                                        <div
                                            id="mobile-sub-{{ forloop.index0 }}"
                                            x-show="activeTopIndex === Number($el.dataset.index)"
                                            data-index="{{ forloop.index0 }}"
                                            class="pt-step-s"
                                        >
                                            <ul class="space-y-step-s" role="list">
                                                {%- for child in link.links -%}
                                                    <li class="text-subtle">
                                                        {%- if child.links == blank -%}
                                                            {%- capture child_attributes -%}
                                                                {%- if child.current -%}
                                                                    aria-current="page"
                                                                {%- endif -%}
                                                            {%- endcapture -%}

                                                            {%- assign link_text = child.title | escape -%}
                                                            {% render 'link',
                                                                text: link_text,
                                                                href: child.url,
                                                                variant: 'underline',
                                                                class: 'inline-flex items-center copy-l',
                                                                attributes: child_attributes
                                                            %}
                                                        {%- else -%}
                                                            {%- capture third_payload -%}
                                                                {
                                                                    "title": {{ child.title | json }},
                                                                    "links": [
                                                                        {%- for grandchild in child.links -%}
                                                                            { "title": {{ grandchild.title | json }}, "url": {{ grandchild.url | json }} }{% unless forloop.last %},{% endunless %}
                                                                        {%- endfor -%}
                                                                    ]
                                                                }
                                                            {%- endcapture -%}

                                                            <button
                                                                type="button"
                                                                class="inline-flex cursor-pointer items-end gap-step-3xs copy-l"
                                                                data-third-payload="{{ third_payload | strip | escape }}"
                                                                @click="openThirdLevelFromButton($el)"
                                                            >
                                                                <span class="decoration-1 underline-offset-3">
                                                                    {{ child.title | escape }}
                                                                </span>
                                                            </button>
                                                        {%- endif -%}
                                                    </li>
                                                {%- endfor -%}
                                            </ul>
                                        </div>
                                    {%- endif -%}
                                </li>
                            {%- endfor -%}
                        </ul>
                    </nav>
                </template>

                <template x-if="thirdLevelLinks.length">
                    <div class="h-full">
                        <button
                            type="button"
                            class="mb-step-m inline-flex cursor-pointer items-center gap-step-xs"
                            @click="backToSecondLevel()"
                            aria-label="{{ 'accessibility.back_to_second_level' | t }}"
                        >
                            <span class="inline-flex rotate-90">
                                {% render 'icons', icon: 'icon-arrow' %}
                            </span>
                            <span x-text="thirdLevelParentTitle"></span>
                        </button>

                        <ul class="space-y-step-s" role="list">
                            <template x-for="item in thirdLevelLinks" :key="item.url + item.title">
                                <li>
                                    <a
                                        :href="item.url"
                                        class="inline-flex items-center"
                                        x-text="item.title"
                                    ></a>
                                </li>
                            </template>
                        </ul>
                    </div>
                </template>
                </div>

                {%- if show_country_selector -%}
                    {%- assign country_count = localization.available_countries.size -%}
                    <div
                        class="mobile-localization-panel"
                        data-localization-panel="country"
                        x-show="localizationPanel === 'country'"
                        x-cloak
                    >
                        <button
                            type="button"
                            class="mobile-localization-panel__back"
                            @click="closeLocalization()"
                            aria-label="{{ 'localization.back_to_menu' | t }}"
                        >
                            <span class="inline-flex rotate-90">
                                {% render 'icons', icon: 'icon-arrow' %}
                            </span>
                            <span>{{ 'localization.country_label' | t }}</span>
                        </button>

                        {%- if country_count > localization_filter_min -%}
                            <input
                                type="search"
                                class="mobile-localization-panel__filter"
                                placeholder="{{ 'localization.search_countries' | t }}"
                                aria-label="{{ 'localization.search_countries' | t }}"
                                autocomplete="off"
                                x-model="localizationQuery"
                            >
                        {%- endif -%}

                        {%- form 'localization', id: 'MobileMenuCountryForm', class: 'mobile-localization-panel__form' -%}
                            <ul class="mobile-localization-panel__list" role="list">
                                {%- for country in localization.available_countries -%}
                                    <li
                                        data-filter-text="{{ country.name | downcase | escape }} {{ country.iso_code | downcase }} {{ country.currency.iso_code | downcase }}"
                                        x-show="matchesLocalization($el)"
                                    >
                                        <button
                                            type="submit"
                                            name="country_code"
                                            value="{{ country.iso_code }}"
                                            class="mobile-localization-panel__option"
                                            {% if country.iso_code == localization.country.iso_code %}
                                                aria-current="true"
                                            {% endif %}
                                        >
                                            <span>{{ country.name }}</span>
                                            {%- if country_currencies.size > 1 -%}
                                                <span class="text-subtle">
                                                    {{- country.currency.iso_code }}
                                                    {{ country.currency.symbol -}}
                                                </span>
                                            {%- endif -%}
                                            {%- if country.iso_code == localization.country.iso_code -%}
                                                {%- render 'localization-selected-icon' -%}
                                            {%- endif -%}
                                        </button>
                                    </li>
                                {%- endfor -%}
                            </ul>
                        {%- endform -%}

                        {%- if country_count > localization_filter_min -%}
                            <p class="text-subtle" x-show="localizationEmpty" x-cloak role="status">
                                {{ 'localization.no_results' | t }}
                            </p>
                        {%- endif -%}
                    </div>
                {%- endif -%}

                {%- if show_language_selector -%}
                    {%- assign language_count = localization.available_languages.size -%}
                    <div
                        class="mobile-localization-panel"
                        data-localization-panel="language"
                        x-show="localizationPanel === 'language'"
                        x-cloak
                    >
                        <button
                            type="button"
                            class="mobile-localization-panel__back"
                            @click="closeLocalization()"
                            aria-label="{{ 'localization.back_to_menu' | t }}"
                        >
                            <span class="inline-flex rotate-90">
                                {% render 'icons', icon: 'icon-arrow' %}
                            </span>
                            <span>{{ 'localization.language_label' | t }}</span>
                        </button>

                        {%- if language_count > localization_filter_min -%}
                            <input
                                type="search"
                                class="mobile-localization-panel__filter"
                                placeholder="{{ 'localization.search_languages' | t }}"
                                aria-label="{{ 'localization.search_languages' | t }}"
                                autocomplete="off"
                                x-model="localizationQuery"
                            >
                        {%- endif -%}

                        {%- form 'localization', id: 'MobileMenuLanguageForm', class: 'mobile-localization-panel__form' -%}
                            <ul class="mobile-localization-panel__list" role="list">
                                {%- for language in localization.available_languages -%}
                                    <li
                                        data-filter-text="{{ language.endonym_name | downcase | escape }} {{ language.name | downcase | escape }} {{ language.iso_code | downcase }}"
                                        x-show="matchesLocalization($el)"
                                    >
                                        <button
                                            type="submit"
                                            name="locale_code"
                                            value="{{ language.iso_code }}"
                                            class="mobile-localization-panel__option"
                                            {% if language.iso_code == localization.language.iso_code %}
                                                aria-current="true"
                                            {% endif %}
                                        >
                                            <span>{{ language.endonym_name | capitalize }}</span>
                                            {%- if language.iso_code == localization.language.iso_code -%}
                                                {%- render 'localization-selected-icon' -%}
                                            {%- endif -%}
                                        </button>
                                    </li>
                                {%- endfor -%}
                            </ul>
                        {%- endform -%}

                        {%- if language_count > localization_filter_min -%}
                            <p class="text-subtle" x-show="localizationEmpty" x-cloak role="status">
                                {{ 'localization.no_results' | t }}
                            </p>
                        {%- endif -%}
                    </div>
                {%- endif -%}
            </div>

            <div class="ui-dialog-overlay-footer flex items-center gap-step-l border-line-strong">
                {%- capture search_content -%}
                    {% render 'icons', icon: 'icon-search' %}
                {%- endcapture -%}

                {%- assign search_aria_label = 'accessibility.search' | t -%}
                {%- render 'link',
                    href: routes.search_url,
                    aria_label: search_aria_label,
                    content: search_content,
                    variant: 'plain',
                    class: 'header-icon-button',
                    attributes: '@click="$store.dialog.close()"'
                -%}

                {%- capture cart_content -%}
                    {% render 'icons', icon: 'icon-cart' %}
                {%- endcapture -%}

                {%- assign cart_aria_label = 'accessibility.cart' | t -%}
                {%- render 'link',
                    href: routes.cart_url,
                    aria_label: cart_aria_label,
                    content: cart_content,
                    variant: 'plain',
                    class: 'header-icon-button',
                    attributes: '@click="$store.dialog.close()"'
                -%}

                {%- capture account_content -%}
                    {% render 'icons', icon: 'icon-account' %}
                {%- endcapture -%}

                {%- assign account_aria_label = 'accessibility.account' | t -%}
                {%- render 'link',
                    href: account_href,
                    aria_label: account_aria_label,
                    content: account_content,
                    variant: 'plain',
                    class: 'header-icon-button',
                    attributes: '@click="$store.dialog.close()"'
                -%}

                {%- if show_country_selector or show_language_selector -%}
                    <div class="ms-auto flex items-center gap-step-2xs">
                        {%- if show_country_selector -%}
                            {%- capture country_trigger_label -%}
                                {{- localization.country.name -}}
                                {%- if country_currencies.size > 1 %}, {{ localization.country.currency.iso_code }}{% endif -%}
                            {%- endcapture -%}
                            <button
                                type="button"
                                class="mobile-localization-trigger"
                                data-localization-trigger="country"
                                @click="openLocalization($el.dataset.localizationTrigger)"
                                :aria-expanded="localizationPanel === 'country'"
                                aria-label="{{ 'localization.current_country' | t: country: country_trigger_label }}"
                            >
                                {{ localization.country.iso_code }}
                                {%- if country_currencies.size > 1 %}
                                    | {{ localization.country.currency.iso_code }}
                                    {{ localization.country.currency.symbol }}
                                {%- endif -%}
                            </button>
                        {%- endif -%}

                        {%- if show_language_selector -%}
                            <button
                                type="button"
                                class="mobile-localization-trigger"
                                data-localization-trigger="language"
                                @click="openLocalization($el.dataset.localizationTrigger)"
                                :aria-expanded="localizationPanel === 'language'"
                                aria-label="{{ 'localization.current_language' | t: language: localization.language.endonym_name }}"
                            >
                                {{ localization.language.iso_code | upcase }}
                            </button>
                        {%- endif -%}
                    </div>
                {%- endif -%}
            </div>
        </div>
    {%- endcapture -%}

    {%- render 'ui-dialog',
        id: popup_id,
        type: 'drawer',
        layer: 'drawer',
        position: 'right',
        top_class: 'top-[var(--announcement-bar-height)]',
        color_scheme: color_scheme,
        drawer_motion_sheet: true,
        mobile_layout: 'inset',
        content: drawer_content
    -%}
{%- endif -%}

{% stylesheet %}
    .header-mobile-menu-drawer__chevron {
        transition: transform var(--motion-duration-base, 300ms) var(--motion-ease-default, ease);
    }

    :where(.header-mobile-menu-drawer__chevron) {
        display: inline-flex;
    }

    .mobile-localization-trigger {
        display: inline-flex;
        align-items: center;
        gap: var(--spacing-step-3xs);
        min-height: 4.4rem;
        padding-inline: var(--spacing-step-2xs);
        white-space: nowrap;
        cursor: pointer;
    }

    .mobile-localization-trigger[aria-expanded='true'] {
        text-decoration: underline;
        text-underline-offset: 0.3em;
    }

    .mobile-localization-panel {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-step-s);
    }

    .mobile-localization-panel__back {
        display: inline-flex;
        align-items: center;
        gap: var(--spacing-step-xs);
        align-self: flex-start;
        cursor: pointer;
    }

    .mobile-localization-panel__filter {
        width: 100%;
        min-height: 4.4rem;
        padding-inline: var(--spacing-step-xs);
        border: 1px solid var(--color-line-strong);
        background: transparent;
        color: inherit;
    }

    .mobile-localization-panel__option {
        display: flex;
        width: 100%;
        align-items: center;
        gap: var(--spacing-step-xs);
        min-height: 4.4rem;
        border-bottom: 1px solid var(--color-line);
        text-align: start;
        cursor: pointer;
    }

    .mobile-localization-panel__option > :first-child {
        flex: 1 1 auto;
    }
{% endstylesheet %}
