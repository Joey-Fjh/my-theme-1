<nav
    aria-label="{{ 'accessibility.main_menu' | t }}"
    class="header-dropdown-menu"
    x-data="dropdown"
    @mouseenter="onHeaderEnter()"
    @mouseleave="onHeaderLeave()"
    @focusin="onHeaderFocusIn()"
    @focusout="onHeaderFocusOut($event)"
    @click.outside="closeAndDeactivate()"
    @keydown.escape.window="closeAndDeactivate()"
>
    <ul class="flex items-center gap-6" role="list">
        {%- for link in section.settings.menu.links -%}
            <li class="relative">
                {%- if link.links != blank -%}
                    <details
                        class="dropdown"
                        data-dropdown
                        data-deep="1"
                    >
                        <summary
                            class="dropdown-trigger flex items-center gap-1"
                            id="HeaderMenu-{{ link.handle }}"
                            :aria-expanded="$el.parentElement.open"
                            @click.stop.prevent="toggle($el.parentElement)"
                        >
                            {% capture link_content %}
                                <span>
                                    {{ link.title | escape }}
                                </span>
                                {% render 'icons',
                                    icon: 'icon-arrow',
                                    class: 'dropdown-icon dropdown-icon--down'
                                %}
                            {% endcapture %}

                            {% render 'link',
                                content: link_content,
                                variant: 'underline',
                                class: 'flex items-center gap-3'
                            %}
                        </summary>

                        <ul
                            class="dropdown-panel dropdown-open color-{{ section.settings.menu_color_scheme }} mt-2 rounded-md bg-theme-bg p-3 text-theme-text"
                            role="list"
                            tabindex="-1"
                        >
                            {%- for childlink in link.links -%}
                                <li>
                                    {%- if childlink.links == blank -%}
                                        {% capture childlink_classes %}
                                            block px-4 py-2 text-theme-text
                                            {% if childlink.current %} font-medium {% endif %}
                                        {% endcapture %}

                                        {%- capture childlink_attributes -%}
                                            {%- if childlink.current -%}
                                                aria-current="page"
                                            {%- endif -%}
                                        {%- endcapture -%}

                                        {%- assign child_link_text = childlink.title | escape -%}
                                        {%- render 'link',
                                            text: child_link_text,
                                            class: childlink_classes,
                                            href: childlink.url,
                                            variant: 'underline',
                                            attributes: childlink_attributes
                                        -%}
                                    {%- else -%}
                                        <details
                                            class="dropdown"
                                            data-dropdown
                                            data-deep="2"
                                        >
                                            <summary
                                                class="dropdown-trigger flex items-center justify-between px-4 py-2"
                                                id="HeaderMenu-{{ childlink.handle }}"
                                                :aria-expanded="$el.parentElement.open"
                                                @click.stop.prevent="toggle($el.parentElement)"
                                            >
                                                {% capture link_content %}
                                                    <span>
                                                        {{ childlink.title | escape }}
                                                    </span>
                                                    {% render 'icons',
                                                        icon: 'icon-arrow1',
                                                        class: 'dropdown-icon dropdown-icon--tilt'
                                                    %}
                                                {% endcapture %}

                                                {% render 'link',
                                                    content: link_content,
                                                    variant: 'underline',
                                                    class: 'flex items-center gap-3'
                                                %}
                                            </summary>

                                            <ul
                                                class="dropdown-panel dropdown-open inset-s-full top-0 ms-2 mt-1 p-3 color-{{ section.settings.menu_color_scheme }} bg-theme-bg text-theme-text"
                                                role="list"
                                            >
                                                {%- for grandChildLink in childlink.links -%}
                                                    <li>
                                                        {%- capture grand_child_link_classes -%}
                                                            block px-4 py-2 text-theme-text
                                                            {% if grandChildLink.current %} font-medium {% endif %}
                                                        {%- endcapture -%}

                                                        {%- capture grand_child_link_attributes -%}
                                                            {%- if grandChildLink.current -%}
                                                                aria-current="page"
                                                            {%- endif -%}
                                                        {%- endcapture -%}

                                                        {%- assign grand_child_link_text = grandChildLink.title
                                                            | escape
                                                        -%}
                                                        {%- render 'link',
                                                            text: grand_child_link_text,
                                                            class: grand_child_link_classes,
                                                            href: grandChildLink.url,
                                                            variant: 'underline',
                                                            attributes: grand_child_link_attributes
                                                        -%}
                                                    </li>
                                                {%- endfor -%}
                                            </ul>
                                        </details>
                                    {%- endif -%}
                                </li>
                            {%- endfor -%}
                        </ul>
                    </details>
                {%- else -%}
                    {%- capture link_attributes -%}
                        {%- if link.current -%}
                            aria-current="page"
                        {%- endif -%}
                    {%- endcapture -%}

                    {%- assign nav_link_text = link.title | escape -%}
                    {%- render 'link',
                        text: nav_link_text,
                        href: link.url,
                        variant: 'underline',
                        attributes: link_attributes
                    -%}
                {%- endif -%}
            </li>
        {%- endfor -%}
    </ul>
</nav>
