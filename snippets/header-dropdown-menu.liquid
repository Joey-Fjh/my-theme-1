{%- liquid
    assign desktop_menu_trigger = section.settings.desktop_menu_trigger | default: 'hover'
    unless desktop_menu_trigger == 'click'
        assign desktop_menu_trigger = 'hover'
    endunless
-%}

<nav
    aria-label="{{ 'accessibility.main_menu' | t }}"
    class="header-dropdown-menu"
    data-desktop-menu-trigger="{{ desktop_menu_trigger }}"
    x-data="dropdown"
    data-module-id="dropdown"
    @mouseenter="onHeaderEnter()"
    @click.capture="onMenuTriggerClickEvent($event)"
    @mouseover="openOnHoverEvent($event)"
    @mouseleave="closeHoverAndDeactivate()"
    @focusin="onHeaderFocusIn()"
    @focusout="onHeaderFocusOut($event)"
    @click.outside="closeAndDeactivate()"
    @keydown.escape.window="onMenuKeydown($event)"
>
    <ul class="flex items-center gap-step-m" role="list">
        {%- for link in section.settings.menu.links -%}
            <li class="relative">
                {%- if link.links != blank -%}
                    <details
                        class="dropdown relative"
                        data-dropdown
                        data-deep="1"
                    >
                        <summary
                            class="dropdown-trigger flex items-center gap-step-3xs"
                            id="HeaderMenu-{{ link.handle }}"
                        >
                            <span class="link-with-icon-motion links-underline links flex items-center gap-step-xs">
                                <span>{{ link.title | escape }}</span>
                                {% render 'icons',
                                    icon: 'icon-arrow',
                                    class: 'dropdown-icon dropdown-icon--down'
                                %}
                            </span>
                        </summary>

                        <ul
                            class="dropdown-panel dropdown-open panel-motion panel-motion-scale color-{{ section.settings.menu_color_scheme }} surface-component"
                            role="list"
                            tabindex="-1"
                            @mouseenter="onDropdownPanelMouseEnter()"
                        >
                            {%- if link.url != blank -%}
                                <li class="mb-step-2xs border-b border-line pb-step-2xs">
                                    {%- render 'link',
                                        text: link.title,
                                        href: link.url,
                                        variant: 'underline',
                                        class: 'block w-full whitespace-nowrap px-step-s py-step-2xs text-theme-text'
                                    -%}
                                </li>
                            {%- endif -%}
                            {%- for childlink in link.links -%}
                                <li class="w-full{% if childlink.links != blank %} relative{% endif %}">
                                    {%- if childlink.links == blank -%}
                                        {% capture childlink_classes %}
                                            block w-full whitespace-nowrap px-step-s py-step-2xs text-theme-text
                                            {% if childlink.current %} font-normal {% endif %}
                                        {% endcapture %}

                                        {%- capture childlink_attributes -%}
                                            {%- if childlink.current -%}
                                                aria-current="page"
                                            {%- endif -%}
                                        {%- endcapture -%}

                                        {%- assign child_link_text = childlink.title | escape -%}
                                        {%- render 'link',
                                            text: child_link_text,
                                            class: childlink_classes,
                                            href: childlink.url,
                                            variant: 'underline',
                                            attributes: childlink_attributes
                                        -%}
                                    {%- else -%}
                                        <details
                                            class="dropdown relative w-full"
                                            data-dropdown
                                            data-deep="2"
                                        >
                                            <summary
                                                class="dropdown-trigger flex w-full items-center justify-between gap-step-m px-step-s py-step-2xs"
                                                id="HeaderMenu-{{ childlink.handle }}"
                                            >
                                                <span class="whitespace-nowrap text-theme-text{% if childlink.current %} font-normal{% endif %}">
                                                    {{ childlink.title | escape }}
                                                </span>
                                                {% render 'icons',
                                                    icon: 'icon-arrow1',
                                                    class: 'dropdown-icon dropdown-icon--tilt shrink-0'
                                                %}
                                            </summary>

                                            <ul
                                                class="dropdown-panel dropdown-open panel-motion panel-motion-flyout inset-s-full color-{{ section.settings.menu_color_scheme }} surface-component"
                                                role="list"
                                                @mouseenter="onNestedDropdownPanelMouseEnter()"
                                            >
                                                {%- for grandChildLink in childlink.links -%}
                                                    <li>
                                                        {%- capture grand_child_link_classes -%}
                                                            block w-full whitespace-nowrap px-step-s py-step-2xs text-theme-text
                                                            {% if grandChildLink.current %} font-normal {% endif %}
                                                        {%- endcapture -%}

                                                        {%- capture grand_child_link_attributes -%}
                                                            {%- if grandChildLink.current -%}
                                                                aria-current="page"
                                                            {%- endif -%}
                                                        {%- endcapture -%}

                                                        {%- assign grand_child_link_text = grandChildLink.title
                                                            | escape
                                                        -%}
                                                        {%- render 'link',
                                                            text: grand_child_link_text,
                                                            class: grand_child_link_classes,
                                                            href: grandChildLink.url,
                                                            variant: 'underline',
                                                            attributes: grand_child_link_attributes
                                                        -%}
                                                    </li>
                                                {%- endfor -%}
                                            </ul>
                                        </details>
                                    {%- endif -%}
                                </li>
                            {%- endfor -%}
                        </ul>
                    </details>
                {%- else -%}
                    {%- capture link_attributes -%}
                        {%- if link.current -%}
                            aria-current="page"
                        {%- endif -%}
                    {%- endcapture -%}

                    {%- assign nav_link_text = link.title | escape -%}
                    {%- render 'link',
                        text: nav_link_text,
                        href: link.url,
                        variant: 'underline',
                        attributes: link_attributes
                    -%}
                {%- endif -%}
            </li>
        {%- endfor -%}
    </ul>
</nav>

{% stylesheet %}
    .panel-motion-scale {
        --panel-motion-dur: var(--panel-motion-duration-scale);
    }
    .panel-motion-flyout {
        --panel-motion-dur: var(--panel-motion-duration-flyout);
        transform-origin: top inline-start;
    }
    [dir='rtl'] .panel-motion-flyout {
        transform-origin: top inline-end;
    }
    /* Open down-flyouts keep the components-layer origin (tailwind.components.css, directional flyout). */
    :is(details[open], [aria-expanded='true'], .is-open, [data-dropdown][open])
        > .panel-motion-flyout:not([class*='inset-s-full']) {
        transform-origin: top center;
    }
    details[open] > .panel-motion-flyout[class*='inset-s-full'],
    [data-dropdown][open] > .panel-motion-flyout[class*='inset-s-full'] {
        animation: panel-motion-flyout-in var(--panel-motion-dur) var(--panel-motion-ease-enter)
            both;
    }
    [dir='rtl'] details[open] > .panel-motion-flyout[class*='inset-s-full'],
    [dir='rtl'] [data-dropdown][open] > .panel-motion-flyout[class*='inset-s-full'] {
        animation-name: panel-motion-flyout-in-rtl;
    }
    details[open] > .panel-motion-flyout > li,
    [data-dropdown][open] > .panel-motion-flyout > li {
        animation: panel-motion-item-flyout-in var(--panel-motion-duration-item)
            var(--panel-motion-ease-enter) both;
    }
    [dir='rtl'] details[open] > .panel-motion-flyout > li,
    [dir='rtl'] [data-dropdown][open] > .panel-motion-flyout > li {
        animation-name: panel-motion-item-flyout-in-rtl;
    }

    :where(.panel-motion-scale) {
        inset-inline-start: 0;
        top: calc(100% + 1.5rem);
        margin-top: calc(var(--spacing) * 0);
        min-width: calc(var(--spacing) * 56);
        border-radius: var(--radius-md);
        padding: var(--spacing-step-xs);
    }

    :where(.panel-motion-flyout) {
        inset-inline-start: calc(100% + 1.5rem);
        top: calc(var(--spacing) * 0);
        margin-top: calc(var(--spacing) * 0);
        padding: var(--spacing-step-xs);
    }
{% endstylesheet %}
