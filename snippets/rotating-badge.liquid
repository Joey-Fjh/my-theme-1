{% doc %}
    Renders a rotating circular badge with animated text on scroll into view.

    @param {string} unique_id - Unique identifier for SVG IDs.
    @param {string} [classes] - Classes to add to the badge.
    @param {number} [size] - The size of the circle
    @param {string} [badge_text] - Text that rotates around the circle.
    @param {string} [badge_class] - class that rotates around the circle.
    @param {string} [center_text] - Bold text shown in the center.
    @param {string} [center_class] - class shown in the center.

    @example
    {% render 'rotating-badge',
        badge_text: 'ORGANIC · ETHICALLY SOURCED ·',
        center_text: '99%'
    %}
{% enddoc %}

{%- liquid
    assign badge_size = size | default: 100
    assign badge_text = badge_text | default: 'ORGANIC · ETHICALLY SOURCED ·'
    assign center_text = center_text | default: '100%'

    assign badge_class = badge_class | default: 'text-white'
    assign center_class = center_class | default: 'text-white'
-%}

<div
    x-data="{ inView: false }"
    x-intersect.once="inView = true"
    class="{{ classes }}"
    style="width: {{ badge_size }}px; height: {{ badge_size }}px;"
>
    <svg
        :class="inView && 'is-running'"
        class="absolute inset-0 h-full w-full {{ badge_class }} animate-spin-slow is-paused origin-center"
        viewBox="0 0 100 100"
    >
        <defs>
            <path
                id="circlePath-{{ unique_id }}"
                d="
                    M 50,50
                    m -45,0
                    a 45,45 0 1,1 90,0
                    a 45,45 0 1,1 -90,0
                "
            />
        </defs>

        <text
            xml:space="preserve"
            class="fill-current font-semibold uppercase tracking-widest"
            text-anchor="middle"
            dominant-baseline="central"
        >
            <textPath
                href="#circlePath-{{ unique_id }}"
                startOffset="50%"
            >
                {{ badge_text  }}
            </textPath>
        </text>
    </svg>

    <div class="absolute inset-0 flex items-center justify-center">
        <span class="{{ center_class }}">
            {{ center_text }}
        </span>
    </div>
</div>
