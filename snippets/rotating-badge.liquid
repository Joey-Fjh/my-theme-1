{% doc %}
    Renders a rotating circular badge with animated text on scroll into view.

    @param {string} unique_id - Unique identifier for SVG IDs.
    @param {string} [classes] - Classes to add to the badge.
    @param {number} [size] - The size of the circle on PC.
    @param {number} [size_mobile] - The size of the circle on mobile (defaults to size).
    @param {string} [badge_text] - Text that rotates around the circle.
    @param {string} [badge_class] - class that rotates around the circle.
    @param {string} [center_text] - Bold text shown in the center.
    @param {string} [center_class] - class shown in the center.

    @example
    {% render 'rotating-badge',
        size: 100,
        size_mobile: 80,
        badge_text: 'ORGANIC · ETHICALLY SOURCED ·',
        center_text: '99%'
    %}
{% enddoc %}

{%- liquid
    assign badge_size = size | default: 100
    assign badge_size_mobile = size_mobile | default: badge_size
    if badge_text == blank
        assign badge_text = 'components.rotating_badge.default_text' | t
    endif
    assign center_text = center_text | default: '100%'

    assign badge_class = badge_class | default: 'text-theme-text'
    assign center_class = center_class | default: 'text-theme-text'
-%}

<div
    x-data="{ inView: false }"
    x-intersect.once="inView = true"
    class="{{ classes }} h-(--badge-size-mb) w-(--badge-size-mb) pc:h-(--badge-size-pc) pc:w-(--badge-size-pc)"
    style="--badge-size-pc: {{ badge_size }}px; --badge-size-mb: {{ badge_size_mobile }}px;"
>
    <svg
        :class="inView && 'is-running'"
        class="absolute inset-0 h-full w-full {{ badge_class }} origin-center animate-spin-slow is-paused"
        viewBox="0 0 100 100"
    >
        <defs>
            <path
                id="circlePath-{{ unique_id }}"
                d="
                    M 50,50
                    m -45,0
                    a 45,45 0 1,1 90,0
                    a 45,45 0 1,1 -90,0
                "
            />
        </defs>

        <text
            xml:space="preserve"
            class="fill-current font-semibold uppercase"
            font-size="12"
            letter-spacing="0.15em"
            text-anchor="middle"
            dominant-baseline="central"
        >
            <textPath
                href="#circlePath-{{ unique_id }}"
                startOffset="50%"
            >
                {{ badge_text  }}
            </textPath>
        </text>
    </svg>

    <div class="absolute inset-0 flex items-center justify-center">
        <span
            class="{{ center_class }} translate-y-[2%] text-[calc(var(--badge-size-mb)*0.26)] font-bold pc:text-[calc(var(--badge-size-pc)*0.26)]"
        >
            {{ center_text }}
        </span>
    </div>
</div>
