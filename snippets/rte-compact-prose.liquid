{% doc %}
    Compact rich-text wrapper with the standard max-width prose constraint.

    @param {string} content - HTML or rich text rendered inside the wrapper.
    @param {string} [content_class] - Additional classes for typography, spacing, or alignment.

    @example
    {%- assign description_html = 'collections.description_html' | t -%}
    {%- render 'rte-compact-prose', content: section.settings.description | default: description_html -%}
{% enddoc %}

{%- liquid
    assign content_class = content_class | default: ''
-%}

<div class="rte rte--compact max-w-3xl{% if content_class != blank %} {{ content_class }}{% endif %}">
    {{ content }}
</div>
