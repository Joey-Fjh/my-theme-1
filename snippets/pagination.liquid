{% doc %}
    Global-style-based pagination snippet with style variants.

  Styles and behavior are controlled entirely by global theme settings
  (config/settings_schema.json):

    - settings.pagination_style          : 'default' | 'minimal' | 'outline'
    - settings.pagination_text_color     : text color for links and numbers
    - settings.pagination_current_bg     : background color for current page
    - settings.pagination_current_text   : text color for current page
    - settings.pagination_font_size      : font size in px
    - settings.pagination_border_radius  : border radius in px

  Usage (must pass a paginate object from within a `{% paginate %}` block):

    {% paginate collection.products by 24 %}
      <!-- your list -->
      {% render 'pagination', paginate_obj: paginate %}
    {% endpaginate %}

    @param {paginate} paginate_obj - Paginate object from a surrounding `{% paginate %}` tag.
{% enddoc %}

{%- liquid
    assign pagination_style = settings.pagination_style | default: 'default'
    assign pagination_text_color = settings.pagination_text_color | default: '#1a1a1a'
    assign pagination_current_bg = settings.pagination_current_bg | default: '#2d3a2e'
    assign pagination_current_text = settings.pagination_current_text | default: '#ffffff'
    assign pagination_font_size = settings.pagination_font_size | default: 13
    assign pagination_border_radius = settings.pagination_border_radius | default: 4

    assign pagination_data = paginate_obj
-%}

{%- if pagination_data and pagination_data.pages > 1 -%}
    <nav
        class="pagination py-10"
        role="navigation"
    >
        <div class="pagination__inner mx-auto flex w-fit max-w-full items-center gap-1">
            {%- comment -%} PREVIOUS {%- endcomment -%}
            {%- if pagination_data.previous -%}
                <a
                    href="{{ pagination_data.previous.url }}"
                    class="
                        pagination__prev
                        inline-flex h-10 items-center gap-1 rounded
                        px-2 transition-colors
                        {% case pagination_style %}
                        {% when 'minimal' %}
                            hover:underline
                        {% when 'outline' %}
                            border hover:bg-theme-text/5
                        {% else %}
                            hover:bg-theme-text/5
                        {% endcase %}
                    "
                    style="
                        color: {{ pagination_text_color }};
                        font-size: {{ pagination_font_size }}px;
                        border-radius: {{ pagination_border_radius }}px;
                        {% if pagination_style == 'outline' %}
                        border-color: rgba(0,0,0,0.12);
                        {% endif %}
                    "
                >
                    {%- render 'icons', icon: 'icon-chevron-left', size: 'xs', color: 'current' -%}
                    <span>{{ 'pagination.previous' | t }}</span>
                </a>
            {%- else -%}
                <span
                    class="
                        pagination__prev pagination__prev--disabled
                        pointer-events-none inline-flex h-10 items-center gap-1
                        rounded px-2 opacity-40
                        {% if pagination_style == 'outline' %}
                        border
                        {% endif %}
                    "
                    style="
                        color: {{ pagination_text_color }};
                        font-size: {{ pagination_font_size }}px;
                        border-radius: {{ pagination_border_radius }}px;
                        {% if pagination_style == 'outline' %}
                        border-color: rgba(0,0,0,0.06);
                        {% endif %}
                    "
                    aria-disabled="true"
                >
                    {%- render 'icons', icon: 'icon-chevron-left', size: 'xs', color: 'current' -%}
                </span>
            {%- endif -%}

            {%- comment -%} PAGES {%- endcomment -%}
            <div class="pagination__pages-wrap max-w-full min-w-0 overflow-x-auto">
                <div class="pagination__pages mx-auto inline-flex min-w-max items-center gap-1">
                    {%- for part in pagination_data.parts -%}
                        {%- if part.is_link -%}
                            <a
                                href="{{ part.url }}"
                                class="
                                    pagination__page
                                    inline-flex h-10 min-w-10 items-center justify-center rounded
                                    px-2 transition-colors
                                    {% case pagination_style %}
                                    {% when 'minimal' %}
                                        hover:underline
                                    {% when 'outline' %}
                                        border hover:bg-theme-text/5
                                    {% else %}
                                        hover:bg-theme-text/5
                                    {% endcase %}
                                "
                                style="
                                    color: {{ pagination_text_color }};
                                    font-size: {{ pagination_font_size }}px;
                                    border-radius: {{ pagination_border_radius }}px;
                                    {% if pagination_style == 'outline' %}
                                    border-color: rgba(0,0,0,0.12);
                                    {% endif %}
                                "
                            >
                                {{- part.title -}}
                            </a>
                        {%- else -%}
                            {%- if part.title == pagination_data.current_page -%}
                                <span
                                    class="
                                        pagination__page pagination__page--current
                                        inline-flex h-10 min-w-10 items-center justify-center rounded
                                        px-2
                                        {% if pagination_style == 'minimal' %}
                                        font-medium underline
                                        {% endif %}
                                    "
                                    style="
                                        {% if pagination_style == 'default' %}
                                        background-color: {{ pagination_current_bg }};
                                        color: {{ pagination_current_text }};
                                        {% elsif pagination_style == 'outline' %}
                                        border: 1px solid {{ pagination_current_bg }};
                                        color: {{ pagination_current_bg }};
                                        {% else %}
                                        color: {{ pagination_text_color }};
                                        {% endif %}
                                        font-size: {{ pagination_font_size }}px;
                                        border-radius: {{ pagination_border_radius }}px;
                                    "
                                    aria-current="page"
                                >
                                    {{- part.title -}}
                                </span>
                            {%- else -%}
                                <span
                                    class="
                                        pagination__page pagination__page--ellipsis
                                        inline-flex h-10 min-w-10 items-center justify-center px-2
                                    "
                                    style="
                                        color: {{ pagination_text_color }};
                                        font-size: {{ pagination_font_size }}px;
                                    "
                                >
                                    {{- part.title -}}
                                </span>
                            {%- endif -%}
                        {%- endif -%}
                    {%- endfor -%}
                </div>
            </div>

            {%- comment -%} NEXT {%- endcomment -%}
            {%- if pagination_data.next -%}
                <a
                    href="{{ pagination_data.next.url }}"
                    class="
                        pagination__next
                        inline-flex h-10 items-center gap-1 rounded
                        px-2 transition-colors
                        {% case pagination_style %}
                        {% when 'minimal' %}
                            hover:underline
                        {% when 'outline' %}
                            border hover:bg-theme-text/5
                        {% else %}
                            hover:bg-theme-text/5
                        {% endcase %}
                    "
                    style="
                        color: {{ pagination_text_color }};
                        font-size: {{ pagination_font_size }}px;
                        border-radius: {{ pagination_border_radius }}px;
                        {% if pagination_style == 'outline' %}
                        border-color: rgba(0,0,0,0.12);
                        {% endif %}
                    "
                >
                    <span>{{ 'pagination.next' | t }}</span>
                    {%- render 'icons', icon: 'icon-chevron-right', size: 'xs', color: 'current' -%}
                </a>
            {%- else -%}
                <span
                    class="
                        pagination__next pagination__next--disabled
                        pointer-events-none inline-flex h-10 items-center gap-1
                        rounded px-2 opacity-40
                        {% if pagination_style == 'outline' %}
                        border
                        {% endif %}
                    "
                    style="
                        color: {{ pagination_text_color }};
                        font-size: {{ pagination_font_size }}px;
                        border-radius: {{ pagination_border_radius }}px;
                        {% if pagination_style == 'outline' %}
                        border-color: rgba(0,0,0,0.06);
                        {% endif %}
                    "
                    aria-disabled="true"
                >
                    {%- render 'icons', icon: 'icon-chevron-right', size: 'xs', color: 'current' -%}
                </span>
            {%- endif -%}
        </div>
    </nav>
{%- endif -%}

{% stylesheet %}
    .pagination {
        list-style: none;
    }

    .pagination__prev,
    .pagination__next,
    .pagination__prev--disabled,
    .pagination__next--disabled {
        flex-shrink: 0;
        white-space: nowrap;
    }

    .pagination__pages-wrap {
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }

    .pagination__pages-wrap::-webkit-scrollbar {
        display: none;
    }

    .pagination__page--ellipsis {
        cursor: default;
    }

    .pagination__prev--disabled,
    .pagination__next--disabled {
        cursor: default;
    }
{% endstylesheet %}
