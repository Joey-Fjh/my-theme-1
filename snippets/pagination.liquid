{% doc %}
    Global-style-based pagination snippet with style variants.

  Styles and behavior are controlled entirely by global theme settings
  (config/settings_schema.json):

    - settings.pagination_style          : 'default' | 'minimal' | 'outline'
    - settings.pagination_font_size      : font size in px
    - settings.pagination_border_radius  : border radius in px

  Usage (must pass a paginate object from within a `{% paginate %}` block):

    {% paginate collection.products by 24 %}
      <!-- your list -->
      {% render 'pagination', paginate_obj: paginate %}
    {% endpaginate %}

    @param {paginate} paginate_obj - Paginate object from a surrounding `{% paginate %}` tag.
{% enddoc %}

{%- liquid
    assign pagination_style = settings.pagination_style | default: 'default'
    assign pagination_font_size = settings.pagination_font_size | default: 13
    assign pagination_border_radius = settings.pagination_border_radius | default: 4

    assign pagination_data = paginate_obj
-%}

{%- if pagination_data and pagination_data.pages > 1 -%}
    <nav
        class="pagination py-10"
        role="navigation"
    >
        <div class="pagination__inner mx-auto flex w-fit max-w-full items-center gap-1">
            {%- comment -%} PREVIOUS {%- endcomment -%}
            {%- if pagination_data.previous -%}
                <a
                    href="{{ pagination_data.previous.url }}"
                    class="
                        pagination__prev
                        inline-flex h-10 items-center gap-1 rounded
                        px-2 text-theme-text transition-colors
                        {% case pagination_style %}
                            {% when 'minimal' %}
                                hover:underline
                            {% when 'outline' %}
                                border border-theme-border-20 hover:bg-theme-text/50
                            {% else %}
                                hover:bg-theme-text/50
                        {% endcase %}
                    "
                    style="
                        font-size: {{ pagination_font_size }}px;
                        border-radius: {{ pagination_border_radius }}px;
                    "
                >
                    {%- render 'icons', icon: 'icon-chevron-left' -%}
                    <span>{{ 'pagination.previous' | t }}</span>
                </a>
            {%- else -%}
                <span
                    class="
                        pagination__prev pagination__prev--disabled
                        pointer-events-none inline-flex h-10 items-center gap-1
                        rounded px-2 text-theme-text opacity-40
                        {% if pagination_style == 'outline' %}
                            border border-theme-border-20
                        {% endif %}
                    "
                    style="
                        font-size: {{ pagination_font_size }}px;
                        border-radius: {{ pagination_border_radius }}px;
                    "
                    aria-disabled="true"
                >
                    {%- render 'icons', icon: 'icon-chevron-left' -%}
                </span>
            {%- endif -%}

            {%- comment -%} PAGES {%- endcomment -%}
            <div class="pagination__pages-wrap max-w-full min-w-0 overflow-x-auto">
                <div class="pagination__pages mx-auto inline-flex min-w-max items-center gap-1">
                    {%- for part in pagination_data.parts -%}
                        {%- if part.is_link -%}
                            <a
                                href="{{ part.url }}"
                                class="
                                    pagination__page
                                    inline-flex h-10 min-w-10 items-center justify-center rounded
                                    px-2 text-theme-text transition-colors
                                    {% case pagination_style %}
                                        {% when 'minimal' %}
                                            hover:underline
                                        {% when 'outline' %}
                                            border border-theme-border-20 hover:bg-theme-text/50
                                        {% else %}
                                            hover:bg-theme-text/50
                                    {% endcase %}
                                "
                                style="
                                    font-size: {{ pagination_font_size }}px;
                                    border-radius: {{ pagination_border_radius }}px;
                                "
                            >
                                {{- part.title -}}
                            </a>
                        {%- else -%}
                            {%- if part.title == pagination_data.current_page -%}
                                <span
                                    class="
                                        pagination__page pagination__page--current
                                        inline-flex h-10 min-w-10 items-center justify-center rounded
                                        px-2
                                        {% case pagination_style %}
                                            {% when 'default' %}
                                                bg-theme-text text-theme-bg
                                            {% when 'outline' %}
                                                border border-theme-text text-theme-text
                                            {% else %}
                                                text-theme-text underline
                                        {% endcase %}
                                    "
                                    style="
                                        font-size: {{ pagination_font_size }}px;
                                        border-radius: {{ pagination_border_radius }}px;
                                    "
                                    aria-current="page"
                                >
                                    {{- part.title -}}
                                </span>
                            {%- else -%}
                                <span
                                    class="pagination__page pagination__page--ellipsis inline-flex h-10 min-w-10 items-center justify-center px-2 text-theme-text"
                                    style="font-size: {{ pagination_font_size }}px;"
                                >
                                    {{- part.title -}}
                                </span>
                            {%- endif -%}
                        {%- endif -%}
                    {%- endfor -%}
                </div>
            </div>

            {%- comment -%} NEXT {%- endcomment -%}
            {%- if pagination_data.next -%}
                <a
                    href="{{ pagination_data.next.url }}"
                    class="
                        pagination__next
                        inline-flex h-10 items-center gap-1 rounded
                        px-2 text-theme-text transition-colors
                        {% case pagination_style %}
                            {% when 'minimal' %}
                                hover:underline
                            {% when 'outline' %}
                                border border-theme-border-20 hover:bg-theme-text/50
                            {% else %}
                                hover:bg-theme-text/50
                        {% endcase %}
                    "
                    style="
                        font-size: {{ pagination_font_size }}px;
                        border-radius: {{ pagination_border_radius }}px;
                    "
                >
                    <span>{{ 'pagination.next' | t }}</span>
                    {%- render 'icons', icon: 'icon-chevron-right' -%}
                </a>
            {%- else -%}
                <span
                    class="
                        pagination__next pagination__next--disabled
                        pointer-events-none inline-flex h-10 items-center gap-1
                        rounded px-2 text-theme-text opacity-40
                        {% if pagination_style == 'outline' %}
                            border border-theme-border-20
                        {% endif %}
                    "
                    style="
                        font-size: {{ pagination_font_size }}px;
                        border-radius: {{ pagination_border_radius }}px;
                    "
                    aria-disabled="true"
                >
                    {%- render 'icons', icon: 'icon-chevron-right' -%}
                </span>
            {%- endif -%}
        </div>
    </nav>
{%- endif -%}

{% stylesheet %}
    .pagination {
        list-style: none;
    }

    .pagination__prev,
    .pagination__next,
    .pagination__prev--disabled,
    .pagination__next--disabled {
        flex-shrink: 0;
        white-space: nowrap;
    }

    .pagination__pages-wrap {
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }

    .pagination__pages-wrap::-webkit-scrollbar {
        display: none;
    }

    .pagination__page--ellipsis {
        cursor: default;
    }

    .pagination__prev--disabled,
    .pagination__next--disabled {
        cursor: default;
    }
{% endstylesheet %}
