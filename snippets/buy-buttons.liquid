{% doc %}
    Renders product buy buttons (Tailwind + Alpine.js).
    Syncs with VariantPicker via variant:change events.
    Uses $store.cart.add() for AJAX add-to-cart with toast feedback.
    Supports Shopify dynamic checkout (Buy it now) via {{ form | payment_button }}.
    Supports pickup availability on PDP via a separate Alpine fetch component.

    @param {product} product - Product object
    @param [block] - Block object (for shopify_attributes + settings)
    @param {string} [section_id] - Section ID for Alpine sync and SRA refresh. Expected from caller.
    @param {string} [product_form_id] - Form ID. Defaults to 'product-form-' + section_id when omitted.
    @param {boolean} [show_quantity] - Show quantity selector (default: false)
    @param [quantity_block] - Optional quantity selector block rendered in the purchase row
    @param {string} [context] - Rendering context: 'product' or 'featured' (default: 'featured')
    @param {boolean} [show_buy_now] - Show "Buy it now" button; when true with context 'product', Add to Cart becomes secondary (default: false)
    @param {boolean} [show_dynamic_checkout] - Show Shopify dynamic checkout buttons; falls back to block.settings.show_dynamic_checkout (default: false)
    @param {boolean} [open_cart_on_add] - Open cart drawer on successful add (default: false)
    @param {string} [open_dialog_id] - Dialog ID to open on successful add (default: '')
    @param {string} [success_message] - Toast message on successful add (default: localized 'Added to cart!')
    @param [request_sections] - Section IDs to refresh via SRA after add; false to skip (default: standard SRA)
    @param {string} [cart_type] - Cart type override; defaults to settings.cart_type.
    @param {string} [quantity_wrapper_class] - Escape hatch: forwarded to quantity-selector wrapper_class.
    @param {string} [quantity_button_class] - Escape hatch: forwarded to quantity-selector button_class.
    @param {string} [quantity_input_class] - Escape hatch: forwarded to quantity-selector input_class.

    Usage: {% render 'buy-buttons', product: product, block: block, product_form_id:
    product_form_id, section_id: section_id %}
{% enddoc %}

{%- assign section_id = section_id | default: '' -%}
{%- assign product_form_id = product_form_id | default: 'product-form-' | append: section_id -%}
{%- assign context = context | default: 'featured' -%}
{%- assign open_cart_on_add = open_cart_on_add | default: false -%}
{%- assign open_dialog_id = open_dialog_id | default: '' -%}
{%- assign cart_type = cart_type | default: settings.cart_type -%}
{%- if success_message == null -%}
    {%- assign success_message = 'toast.added_to_cart' | t -%}
{%- endif -%}
{%- assign show_buy_now = show_buy_now | default: false -%}
{%- assign show_dynamic_checkout = show_dynamic_checkout
    | default: block.settings.show_dynamic_checkout
    | default: false
-%}
{%- assign show_quantity_control = false -%}
{%- if quantity_block != blank or show_quantity == true or show_quantity == 'true' -%}
    {%- assign show_quantity_control = true -%}
{%- endif -%}

{%- if product != blank -%}
    {%- assign current_variant = product.selected_or_first_available_variant -%}
    {%- comment -%}
        Gift card recipient validation does not support accelerated checkout.
        Hide Shopify payment buttons and custom Buy now whenever the recipient
        form is present so those paths cannot bypass recipient properties.
        See: https://shopify.dev/docs/storefronts/themes/product-merchandising/gift-cards
    {%- endcomment -%}
    {%- if product.gift_card? -%}
        {%- assign show_dynamic_checkout = false -%}
        {%- assign show_buy_now = false -%}
    {%- endif -%}
    {%- assign native_qty_blocked = false -%}
    {%- if current_variant != blank -%}
        {%- capture native_can_purchase -%}
            {%- render 'quantity-constraints',
                variant: current_variant,
                surface: 'product',
                output: 'can_purchase'
            -%}
        {%- endcapture -%}
        {%- assign native_can_purchase = native_can_purchase | strip -%}
        {%- if native_can_purchase == 'false' -%}
            {%- assign native_qty_blocked = true -%}
        {%- endif -%}
    {%- endif -%}
    {%- assign use_secondary_add_button = false -%}
    {%- if context == 'product' -%}
        {%- if show_buy_now == true or show_buy_now == 'true' -%}
            {%- assign use_secondary_add_button = true -%}
        {%- endif -%}
    {%- endif -%}

    {%- if use_secondary_add_button -%}
        {%- assign available_classes = 'btn-secondary' -%}
    {%- else -%}
        {%- assign available_classes = 'btn-primary' -%}
    {%- endif -%}
    {%- assign unavailable_classes = 'buy-buttons__submit--unavailable' -%}

    <div
        data-section-id="{{ section_id }}"
        data-product-form-id="{{ product_form_id }}"
        data-available="{{ current_variant.available | default: false }}"
        data-variant-id="{{ current_variant.id | default: '' }}"
        data-open-cart-on-add="{{ open_cart_on_add | json | escape }}"
        data-open-dialog-id="{{ open_dialog_id | escape }}"
        data-success-message="{{ success_message | escape }}"
        data-cart-type="{{ cart_type | escape }}"
        data-cart-url="{{ routes.cart_url | escape }}"
        data-show-buy-now="{{ show_buy_now | json | escape }}"
        data-add-to-cart-text="{{ 'products.product.add_to_cart' | t | escape }}"
        data-sold-out-text="{{ 'products.product.sold_out' | t | escape }}"
        data-maximum-in-cart-text="{{ 'products.product.maximum_in_cart' | t | escape }}"
        data-unavailable-text="{{ 'products.product.unavailable' | t | escape }}"
        data-request-sections="{% if request_sections == false or request_sections == 'false' %}{% else %}{{ request_sections | join: ',' | escape }}{% endif %}"
        x-data="BuyButtons()"
        {{ block.shopify_attributes }}
    >
        {%- form 'product',
            product,
            id: product_form_id,
            novalidate: 'novalidate',
            data-type: 'add-to-cart-form'
        -%}
            <input
                type="hidden"
                name="id"
                x-ref="variantInput"
                value="{{ current_variant.id | default: '' }}"
                :value="variantId"
                :disabled="!available"
            >

            {%- render 'selling-plan-picker',
                product: product,
                section_id: section_id,
                product_form_id: product_form_id
            -%}

            {%- if product.gift_card? -%}
                <div x-cloak>
                    {%- render 'gift-card-recipient-form',
                        product: product,
                        form: form,
                        section_id: section_id,
                        product_form_id: product_form_id
                    -%}
                </div>
            {%- endif -%}

            <div
                class="
                    buy-buttons__actions--purchase-group
                    {%- if show_quantity_control %} buy-buttons__actions--with-quantity{% endif -%}
                "
            >
                <div class="buy-buttons__primary-row">
                    {%- if show_quantity_control -%}
                        <div
                            class="buy-buttons__quantity"
                            {% if quantity_block != blank %}
                                {{ quantity_block.shopify_attributes }}
                            {% endif %}
                        >
                            {%- render 'quantity-selector',
                                variant: current_variant,
                                surface: 'product',
                                product_form_id: product_form_id,
                                section_id: section_id,
                                wrapper_class: quantity_wrapper_class,
                                button_class: quantity_button_class,
                                input_class: quantity_input_class
                            -%}
                        </div>
                    {%- endif -%}

                    <button
                        type="submit"
                        name="add"
                        class="btn relative w-full"
                        data-available-class="{{ available_classes | escape }}"
                        data-unavailable-class="{{ unavailable_classes | escape }}"
                        :class="
                            available && canPurchaseQuantity
                            ? $el.dataset.availableClass
                            : $el.dataset.unavailableClass
                        "
                        disabled
                        :disabled="!available || !canPurchaseQuantity || isLoading"
                        :aria-busy="isLoading"
                        @click.prevent="addToCart()"
                    >
                        <span
                            class="buy-buttons__label"
                            :class="{ 'is-loading': isLoading }"
                            x-text="buttonText"
                            data-add-to-cart-label
                        >
                            {%- if current_variant.available == false -%}
                                {{ 'products.product.sold_out' | t }}
                            {%- elsif native_qty_blocked -%}
                                {{ 'products.product.maximum_in_cart' | t }}
                            {%- else -%}
                                {{ 'products.product.add_to_cart' | t }}
                            {%- endif -%}
                        </span>
                        <span
                            x-show="isLoading"
                            x-cloak
                            class="absolute inset-0 flex items-center justify-center"
                            aria-hidden="true"
                        >
                            <span
                                class="h-5 w-5 animate-spin rounded-full border-2 border-current border-t-transparent"
                            ></span>
                        </span>
                    </button>
                </div>

                {%- if show_buy_now == true or show_buy_now == 'true' -%}
                    <button
                        type="button"
                        class="btn-primary relative w-full"
                        :disabled="!available || !canPurchaseQuantity || isLoading"
                        :aria-busy="isLoading"
                        @click.prevent="buyNow()"
                        x-show="available && canPurchaseQuantity"
                        x-cloak
                    >
                        {{ 'products.product.buy_it_now' | t }}
                    </button>
                {%- endif -%}

                {%- if show_dynamic_checkout -%}
                    <div
                        class="shopify-payment-button-wrapper"
                        hidden
                        :hidden="!available || !canPurchaseQuantity"
                        :class="{ 'hidden': !available || !canPurchaseQuantity }"
                    >
                        {{ form | payment_button }}
                    </div>
                {%- endif -%}
            </div>
        {%- endform -%}

        <div x-show="false">
            {%- if product.gift_card? -%}
                {%- assign fallback_option_count = 0 -%}
                <div class="flex flex-col gap-2">
                    {%- for variant in product.variants -%}
                        {%- unless variant.available -%}
                            {%- continue -%}
                        {%- endunless -%}
                        {%- capture gift_card_variant_can_purchase -%}
                            {%- render 'quantity-constraints',
                                variant: variant,
                                surface: 'product',
                                output: 'can_purchase'
                            -%}
                        {%- endcapture -%}
                        {%- assign gift_card_variant_can_purchase = gift_card_variant_can_purchase
                            | strip
                        -%}
                        {%- unless gift_card_variant_can_purchase == 'true' -%}
                            {%- continue -%}
                        {%- endunless -%}
                        {%- capture gift_card_variant_quantity -%}
                            {%- render 'quantity-constraints',
                                variant: variant,
                                surface: 'product',
                                output: 'min'
                            -%}
                        {%- endcapture -%}
                        {%- assign gift_card_variant_quantity = gift_card_variant_quantity
                            | strip
                        -%}
                        {%- assign fallback_option_count = fallback_option_count | plus: 1 -%}
                        {%- capture gift_card_fallback_form_id -%}
                            {{- product_form_id -}}-gift-card-fallback-{{- variant.id -}}
                        {%- endcapture -%}
                        {%- capture gift_card_fallback_section_id -%}
                            {{- section_id -}}-gift-card-fallback-{{- variant.id -}}
                        {%- endcapture -%}
                        <details
                            {% if variant.id == current_variant.id %}
                                open
                            {% endif %}
                        >
                            <summary
                                class="cursor-pointer list-none body-md font-medium text-theme-text [&::-webkit-details-marker]:hidden"
                            >
                                {%- if product.has_only_default_variant -%}
                                    {{ product.title | escape }}
                                {%- else -%}
                                    {{ variant.title | escape }}
                                {%- endif -%}
                            </summary>
                            {%- form 'product', product, id: gift_card_fallback_form_id -%}
                                <input type="hidden" name="id" value="{{ variant.id }}">
                                <input
                                    type="hidden"
                                    name="quantity"
                                    value="{{ gift_card_variant_quantity }}"
                                >
                                {%- render 'gift-card-recipient-form',
                                    product: product,
                                    form: form,
                                    section_id: gift_card_fallback_section_id,
                                    product_form_id: gift_card_fallback_form_id
                                -%}
                                <button type="submit" name="add" class="btn-primary w-full">
                                    {{ 'products.product.add_to_cart' | t }}
                                </button>
                            {%- endform -%}
                        </details>
                    {%- endfor -%}
                    {%- if fallback_option_count == 0 -%}
                        <button
                            type="button"
                            class="buy-buttons__submit--unavailable w-full"
                            disabled
                        >
                            {{ 'products.product.unavailable' | t }}
                        </button>
                    {%- endif -%}
                </div>
            {%- elsif product.requires_selling_plan -%}
                {%- assign fallback_option_count = 0 -%}
                <fieldset class="selling-plan-picker__fieldset m-0 border-0 p-0">
                    <legend class="mb-3 body-sm font-medium text-theme-text">
                        {{ 'products.product.selling_plan.purchase_options' | t }}
                    </legend>
                    <div class="flex flex-col gap-2">
                        {%- for variant in product.variants -%}
                            {%- unless variant.available -%}
                                {%- continue -%}
                            {%- endunless -%}
                            {%- capture fallback_can_purchase -%}
                                {%- render 'quantity-constraints',
                                    variant: variant,
                                    surface: 'product',
                                    output: 'can_purchase'
                                -%}
                            {%- endcapture -%}
                            {%- assign fallback_can_purchase = fallback_can_purchase | strip -%}
                            {%- unless fallback_can_purchase == 'true' -%}
                                {%- continue -%}
                            {%- endunless -%}
                            {%- capture fallback_quantity -%}
                                {%- render 'quantity-constraints',
                                    variant: variant,
                                    surface: 'product',
                                    output: 'min'
                                -%}
                            {%- endcapture -%}
                            {%- assign fallback_quantity = fallback_quantity | strip -%}
                            {%- for allocation in variant.selling_plan_allocations -%}
                                {%- assign fallback_option_count = fallback_option_count
                                    | plus: 1
                                -%}
                                {%- capture fallback_form_id -%}
                                    {{- product_form_id -}}-fallback-{{- variant.id -}}-{{- allocation.selling_plan.id -}}
                                {%- endcapture -%}
                                {%- form 'product', product, id: fallback_form_id -%}
                                    <input type="hidden" name="id" value="{{ variant.id }}">
                                    <input
                                        type="hidden"
                                        name="quantity"
                                        value="{{ fallback_quantity }}"
                                    >
                                    <input
                                        type="hidden"
                                        name="selling_plan"
                                        value="{{ allocation.selling_plan.id }}"
                                    >
                                    <button type="submit" name="add" class="btn-primary w-full">
                                        {{ variant.title | escape }} —
                                        {{ allocation.selling_plan.name | escape }} —
                                        {{ 'products.product.add_to_cart' | t }}
                                    </button>
                                {%- endform -%}
                            {%- endfor -%}
                        {%- endfor -%}
                        {%- if fallback_option_count == 0 -%}
                            <button
                                type="button"
                                class="buy-buttons__submit--unavailable w-full"
                                disabled
                            >
                                {{ 'products.product.unavailable' | t }}
                            </button>
                        {%- endif -%}
                    </div>
                </fieldset>
            {%- else -%}
                {%- assign fallback_option_count = 0 -%}
                <div class="flex flex-col gap-2">
                    {%- for variant in product.variants -%}
                        {%- unless variant.available -%}
                            {%- continue -%}
                        {%- endunless -%}
                        {%- capture fallback_can_purchase -%}
                            {%- render 'quantity-constraints',
                                variant: variant,
                                surface: 'product',
                                output: 'can_purchase'
                            -%}
                        {%- endcapture -%}
                        {%- assign fallback_can_purchase = fallback_can_purchase | strip -%}
                        {%- unless fallback_can_purchase == 'true' -%}
                            {%- continue -%}
                        {%- endunless -%}
                        {%- capture fallback_quantity -%}
                            {%- render 'quantity-constraints',
                                variant: variant,
                                surface: 'product',
                                output: 'min'
                            -%}
                        {%- endcapture -%}
                        {%- assign fallback_quantity = fallback_quantity | strip -%}
                        {%- assign fallback_option_count = fallback_option_count | plus: 1 -%}
                        {%- capture fallback_form_id -%}
                            {{- product_form_id -}}-fallback-{{- variant.id -}}
                        {%- endcapture -%}
                        {%- form 'product', product, id: fallback_form_id -%}
                            <input type="hidden" name="id" value="{{ variant.id }}">
                            <input type="hidden" name="quantity" value="{{ fallback_quantity }}">
                            <button type="submit" name="add" class="btn-primary w-full">
                                {{ variant.title | escape }} —
                                {{ 'products.product.add_to_cart' | t }}
                            </button>
                        {%- endform -%}
                    {%- endfor -%}
                    {%- if fallback_option_count == 0 -%}
                        <button
                            type="button"
                            class="buy-buttons__submit--unavailable w-full"
                            disabled
                        >
                            {{ 'products.product.unavailable' | t }}
                        </button>
                    {%- endif -%}
                </div>
            {%- endif -%}
        </div>

        {%- if context == 'product' and current_variant != blank -%}
            {%- render 'pickup-availability-inline',
                section_id: section_id,
                variant_id: current_variant.id
            -%}
        {%- endif -%}
    </div>

{%- elsif context == 'featured' -%}
    <div {{ block.shopify_attributes }}>
        <span class="sr-only">{{ 'products.product.unavailable' | t }}</span>
        <div class="buy-buttons__actions--purchase-group{% if show_quantity_control %} buy-buttons__actions--with-quantity{% endif %}">
            <div class="buy-buttons__primary-row">
                {%- if show_quantity_control -%}
                    <div class="buy-buttons__quantity">
                        {%- render 'quantity-selector', interactive: false -%}
                    </div>
                {%- endif -%}

                <span
                    class="{% if show_dynamic_checkout or show_buy_now == true or show_buy_now == 'true' %}btn-secondary{% else %}btn-primary{% endif %} pointer-events-none relative w-full cursor-default"
                    aria-hidden="true"
                >
                    {{ 'products.product.add_to_cart' | t }}
                </span>
            </div>

            {%- if show_dynamic_checkout or show_buy_now == true or show_buy_now == 'true' -%}
                <span
                    class="btn-primary pointer-events-none relative w-full cursor-default"
                    aria-hidden="true"
                >
                    {{ 'products.product.buy_it_now' | t }}
                </span>
            {%- endif -%}
        </div>
    </div>
{%- else -%}
    <div {{ block.shopify_attributes }}>
        <button type="button" class="btn-secondary relative w-full" disabled>
            {{ 'products.product.unavailable' | t }}
        </button>
    </div>
{%- endif -%}
