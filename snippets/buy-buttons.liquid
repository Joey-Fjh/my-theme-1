{% comment %}
    Renders product buy buttons (Tailwind + Alpine.js).
    Syncs with VariantPicker via variant:change events.
    Uses $store.cart.add() for AJAX add-to-cart with toast feedback.
    Supports Shopify dynamic checkout (Buy it now) via {{ form | payment_button }}.
    Supports pickup availability on PDP via a separate Alpine fetch component.

    @param {Object}  product                - Product object
    @param {Object}  [block]                - Block object (for shopify_attributes + settings)
    @param {string}  [product_form_id]      - Form ID (default: 'product-form-' + section.id)
    @param {string}  [section_id]           - Section ID for SRA refresh after add
    @param {string}  [layout]               - Button layout: 'stack' or 'purchase_group'
    @param {boolean} [show_quantity]        - Show quantity selector (default: false)
    @param {Object}  [quantity_block]       - Optional quantity selector block rendered in purchase_group layout
    @param {string}  [context]              - Rendering context: 'product' or 'featured' (default: 'featured')
    @param {boolean} [show_buy_now]         - Show "Buy it now" button; when true with context 'product', Add to Cart becomes secondary (default: false)
    @param {boolean} [show_dynamic_checkout] - Show Shopify dynamic checkout buttons; falls back to block.settings.show_dynamic_checkout (default: false)
    @param {boolean} [open_cart_on_add]     - Open cart drawer on successful add (default: false)
    @param {string}  [open_dialog_id]       - Dialog ID to open on successful add (default: '')
    @param {string}  [success_message]      - Toast message on successful add (default: 'Added to cart!')
    @param {Array}   [request_sections]     - Section IDs to refresh via SRA after add; false to skip (default: standard SRA)

    Usage:
    {% render 'buy-buttons', product: product, block: block, product_form_id: product_form_id, section_id: section.id %}
{% endcomment %}

{%- assign product_form_id = product_form_id | default: 'product-form-' | append: section.id -%}
{%- assign section_id = section_id | default: section.id -%}
{%- assign context = context | default: 'featured' -%}
{%- assign open_cart_on_add = open_cart_on_add | default: false -%}
{%- assign open_dialog_id = open_dialog_id | default: '' -%}
{%- assign success_message = success_message | default: 'Added to cart!' -%}
{%- assign show_buy_now = show_buy_now | default: false -%}
{%- assign layout = layout | default: 'stack' -%}
{%- assign show_quantity_control = false -%}
{%- if quantity_block != blank or show_quantity == true or show_quantity == 'true' -%}
    {%- assign show_quantity_control = true -%}
{%- endif -%}

{%- if product != blank -%}
    {%- assign current_variant = product.selected_or_first_available_variant -%}
    {%- assign show_dynamic_checkout = show_dynamic_checkout
        | default: block.settings.show_dynamic_checkout
        | default: false
    -%}

    {%- assign use_secondary_add_button = false -%}
    {%- if context == 'product' -%}
        {%- if show_buy_now == true or show_buy_now == 'true' -%}
            {%- assign use_secondary_add_button = true -%}
        {%- endif -%}
    {%- endif -%}

    {%- if use_secondary_add_button -%}
        {%- assign available_classes = 'btn-secondary' -%}
    {%- else -%}
        {%- assign available_classes = 'btn-primary' -%}
    {%- endif -%}
    {%- assign unavailable_classes = 'border-theme-border-20 bg-theme-border-soft text-theme-text/45 opacity-100' -%}

    <div
        data-section-id="{{ section_id }}"
        data-product-form-id="{{ product_form_id }}"
        data-available="{{ current_variant.available | default: false }}"
        data-variant-id="{{ current_variant.id | default: '' }}"
        data-open-cart-on-add="{{ open_cart_on_add | json | escape }}"
        data-open-dialog-id="{{ open_dialog_id | escape }}"
        data-success-message="{{ success_message | escape }}"
        data-show-buy-now="{{ show_buy_now | json | escape }}"
        data-request-sections="{% if request_sections == false or request_sections == 'false' %}{% else %}{{ request_sections | join: ',' | escape }}{% endif %}"
        x-data="BuyButtons()"
        {{ block.shopify_attributes }}
    >
        {%- form 'product',
            product,
            id: product_form_id,
            novalidate: 'novalidate',
            data-type: 'add-to-cart-form'
        -%}
            <input
                type="hidden"
                name="id"
                x-ref="variantInput"
                :value="variantId"
                :disabled="!available"
            >

            <div
                class="
                    {%- if layout == 'purchase_group' -%}
                        buy-buttons__actions buy-buttons__actions--purchase-group
                        {%- if show_quantity_control %} buy-buttons__actions--with-quantity{% else %} buy-buttons__actions--without-quantity{% endif -%}
                    {%- else -%}
                        flex flex-col gap-3
                    {%- endif -%}
                "
            >
                {%- if layout == 'purchase_group' -%}
                    <div class="buy-buttons__primary-row">
                        {%- if show_quantity_control -%}
                            <div
                                class="buy-buttons__quantity"
                                {% if quantity_block != blank %}
                                    {{ quantity_block.shopify_attributes }}
                                {% endif %}
                            >
                                {%- render 'quantity-selector',
                                    value: 1,
                                    min: 1,
                                    product_form_id: product_form_id,
                                    section_id: section_id,
                                    wrapper_class: quantity_wrapper_class,
                                    button_class: quantity_button_class,
                                    input_class: quantity_input_class
                                -%}
                            </div>
                        {%- endif -%}

                        <button
                            type="submit"
                            name="add"
                            class="btn relative w-full disabled:cursor-not-allowed"
                            :class="
                                available
                                ? '{{ available_classes }} disabled:opacity-70'
                                : '{{ unavailable_classes }}'
                            "
                            :disabled="!available || isLoading"
                            @click.prevent="addToCart()"
                        >
                            <span
                                class="inline-block transition-opacity"
                                :class="{ 'opacity-0': isLoading }"
                                x-text="buttonText"
                            >
                                {%- if current_variant.available -%}
                                    Add to cart
                                {%- else -%}
                                    Sold out
                                {%- endif -%}
                            </span>
                            <span
                                x-show="isLoading"
                                x-cloak
                                class="absolute inset-0 flex items-center justify-center"
                                aria-hidden="true"
                            >
                                <span
                                    class="h-5 w-5 animate-spin rounded-full border-2 border-current border-t-transparent"
                                ></span>
                            </span>
                        </button>
                    </div>
                {%- else -%}
                    <button
                        type="submit"
                        name="add"
                        class="btn relative w-full disabled:cursor-not-allowed"
                        :class="
                            available
                            ? '{{ available_classes }} disabled:opacity-70'
                            : '{{ unavailable_classes }}'
                        "
                        :disabled="!available || isLoading"
                        @click.prevent="addToCart()"
                    >
                        <span
                            class="inline-block transition-opacity"
                            :class="{ 'opacity-0': isLoading }"
                            x-text="buttonText"
                        >
                            {%- if current_variant.available -%}
                                Add to cart
                            {%- else -%}
                                Sold out
                            {%- endif -%}
                        </span>
                        <span
                            x-show="isLoading"
                            x-cloak
                            class="absolute inset-0 flex items-center justify-center"
                            aria-hidden="true"
                        >
                            <span
                                class="h-5 w-5 animate-spin rounded-full border-2 border-current border-t-transparent"
                            ></span>
                        </span>
                    </button>
                {%- endif -%}

                {%- if show_buy_now == true or show_buy_now == 'true' -%}
                    <button
                        type="button"
                        class="btn-primary btn relative w-full disabled:cursor-not-allowed disabled:opacity-50"
                        :disabled="!available || isLoading"
                        @click.prevent="buyNow()"
                        x-show="available"
                        x-cloak
                    >
                        {{ 'products.product.buy_it_now' | t }}
                    </button>
                {%- endif -%}

                {%- if show_dynamic_checkout -%}
                    <div class="shopify-payment-button-wrapper" :class="{ 'hidden': !available }">
                        {{ form | payment_button }}
                    </div>
                {%- endif -%}
            </div>
        {%- endform -%}

        {%- if context == 'product' and current_variant != blank -%}
            <div
                class="mt-4"
                data-pickup-availability-root="{{ section_id }}"
                data-section-id="{{ section_id }}"
                data-root-url="{{ routes.root_url }}"
                data-variant-id="{{ current_variant.id }}"
                data-loading-text="{{ 'products.product.pickup_availability.loading' | t | escape }}"
                data-error-text="{{ 'products.product.pickup_availability.error' | t | escape }}"
                data-retry-text="{{ 'products.product.pickup_availability.retry' | t | escape }}"
                x-data="PickupAvailability()"
            >
                <div
                    x-show="isLoading"
                    x-cloak
                    class="rounded-sm border border-theme-border-20 px-4 py-3 body-md text-theme-text/70"
                    role="status"
                    aria-live="polite"
                    x-text="loadingText"
                ></div>

                <div
                    x-show="showError"
                    x-cloak
                    class="flex flex-wrap items-center gap-3 rounded-sm border border-theme-border-20 px-4 py-3"
                >
                    <p
                        class="body-md text-theme-text/70"
                        role="status"
                        aria-live="polite"
                        x-text="errorText"
                    ></p>
                    <button
                        type="button"
                        class="body-md font-medium underline underline-offset-4 transition-opacity hover:opacity-70"
                        @click="retry()"
                        x-text="retryText"
                    ></button>
                </div>

                <div x-show="hasContent" x-cloak>
                    <div data-pickup-availability-content></div>
                </div>
            </div>
        {%- endif -%}
    </div>

{%- else -%}
    <div {{ block.shopify_attributes }}>
        <button
            type="button"
            class="btn-secondary btn relative w-full cursor-not-allowed opacity-50"
            disabled
        >
            {{ 'products.product.unavailable' | t }}
        </button>
    </div>
{%- endif -%}
