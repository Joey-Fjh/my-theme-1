{% doc %}
    Renders a product card item used in product grids and sliders.

    @param {product} product - The product object to render in the card
    @param {string} [class] - Optional extra CSS class names applied to the card
    @param {string} [image_ratio] - Optional image ratio or class used to control image aspect ratio
    @param {number} [pc_items] - Optional items on row for image size
    @param {number} [mobile_items] - Optional mobile items on row for image size
    @param {string} [card_mode] - Optional. 'full' | 'lite'. Defaults to 'full'.
    @param {boolean} [show_hover_actions] - Optional. Defaults to true. Disable Quick View / Add to Cart layer when false.
    @param {boolean} [show_image_navigation] - Optional. Defaults to true. Hide image navigation controls when false.
    @param {string} [hover_mode] - Optional. 'actions' | 'none' | 'variants'. Defaults to 'actions'.
    @param {string} [scope_id] - Optional stable scope used for nested dialog/form ids.
    @param {string} [color_scheme] - Optional color scheme passed to quick view modal content.
    @param {string} [primary_image_loading] - Optional loading attribute for the primary image only ('lazy' or 'eager'). Defaults to 'lazy'. Carousel/secondary images remain lazy.
    @param {string} [primary_image_fetchpriority] - Optional fetchpriority attribute for the primary image only ('high', 'low', or 'auto'). Defaults to blank. Carousel/secondary images do not get fetchpriority.

    @example
    {% render 'product-card', product: product, class: 'my-product-card' %}
{% enddoc %}

{%- liquid
    assign brand = product.type
    if brand == blank
        assign brand = product.vendor
    endif

    assign pc_items = pc_items | default: 4
    assign mobile_items = mobile_items | default: 2

    assign image_count = product.images.size
    if image_count == blank or image_count < 1
        assign image_count = 1
    endif

    assign card_mode = card_mode | default: 'full'
    assign hover_mode = hover_mode | default: 'actions'

    comment
        Image ratio: explicit param wins, then global setting.
        Named values map to fixed ratios; any other explicit value passes through as-is.
        Adapt mode (no explicit param + global setting) uses the product's natural image ratio.
        Missing image in adapt mode falls back to 1/1.
    endcomment
    if image_ratio != blank
        case image_ratio
            when 'square'
                assign aspect_ratio = '1/1'
            when 'portrait'
                assign aspect_ratio = '3/4'
            when 'landscape'
                assign aspect_ratio = '4/3'
            else
                assign aspect_ratio = image_ratio
        endcase
    else
        case settings.product_card_image_ratio
            when 'square'
                assign aspect_ratio = '1/1'
            when 'portrait'
                assign aspect_ratio = '3/4'
            when 'landscape'
                assign aspect_ratio = '4/3'
            else
                if product.featured_image != blank and product.featured_image.width and product.featured_image.height
                    assign aspect_ratio = product.featured_image.width | append: '/' | append: product.featured_image.height
                else
                    assign aspect_ratio = '1/1'
                endif
        endcase
    endif
    assign pc_media_ratio = aspect_ratio
    assign scope_id = scope_id | default: 'card'
    assign color_scheme = color_scheme | default: ''
    assign primary_image_loading = primary_image_loading | default: 'lazy'
    assign primary_image_fetchpriority = primary_image_fetchpriority | default: ''
    assign show_hover_actions_enabled = true
    assign show_image_navigation_enabled = true
    assign show_hover_actions_explicit = false
    assign show_image_navigation_explicit = false

    if show_hover_actions != null
        assign show_hover_actions_explicit = true
    endif

    if show_image_navigation != null
        assign show_image_navigation_explicit = true
    endif

    if card_mode == 'lite'
        assign hover_mode = 'none'
        assign show_hover_actions_enabled = false
        assign show_image_navigation_enabled = false
    endif

    if show_hover_actions_explicit
        if show_hover_actions == false or show_hover_actions == 'false'
            assign show_hover_actions_enabled = false
        else
            assign show_hover_actions_enabled = true
        endif
    endif

    if show_image_navigation_explicit
        if show_image_navigation == false or show_image_navigation == 'false'
            assign show_image_navigation_enabled = false
        else
            assign show_image_navigation_enabled = true
        endif
    endif

    if show_hover_actions_enabled == false and hover_mode == 'actions'
        assign hover_mode = 'none'
    endif

    if hover_mode == 'variants'
        assign show_hover_actions_enabled = false
    endif

    assign has_variant_panel = true
    if product.has_only_default_variant
        assign has_variant_panel = false
    endif

    assign selected_variant = product.selected_or_first_available_variant
    assign quick_view_dialog_id = scope_id | append: '-quick-view-' | append: product.id
-%}

<div
    class="product-card product-card-shell {{ class }}"
    data-card-mode="{{ card_mode | escape }}"
    data-image-count="{{ image_count }}"
    data-hover-mode="{{ hover_mode | escape }}"
    data-has-variant-panel="{{ has_variant_panel }}"
    data-enable-image-navigation="{{ show_image_navigation_enabled }}"
    data-quick-view-dialog-id="{{ quick_view_dialog_id | escape }}"
    data-cart-dialog-id="cart-overlay-drawer"
    data-cart-type="{{ settings.cart_type }}"
    data-cart-url="{{ routes.cart_url | escape }}"
    data-primary-variant-id="{{ selected_variant.id }}"
    data-primary-variant-available="{{ selected_variant.available }}"
    data-toast-added="{{ 'toast.added_to_cart' | t | escape }}"
    x-data="productCard"
    @mouseleave="setImageHover(false); setActionsHover(false)"
>
    <div
        class="product-card__category product-card-shell__meta"
        data-motion-reveal="content"
    >
        <div class="product-card__category-brand product-card-shell__brand" title="{{ brand }}">
            {{ brand }}
        </div>
        <div class="product-card__category-meta product-card-shell__meta-side">
            {%- if show_image_navigation_enabled and image_count > 1 -%}
                <div
                    class="product-card-shell__pagination"
                    aria-label="{{ 'accessibility.image_navigation' | t }}"
                >
                    {%- if image_count <= 3 -%}
                        {%- for image in product.images -%}
                            <button
                                type="button"
                                class="product-card-shell__pagination-dot"
                                data-index="{{ forloop.index0 }}"
                                :class="{ 'is-active': activeImageIndex === Number($el.dataset.index) }"
                                @click.prevent="setActiveImage(Number($el.dataset.index))"
                                aria-label="{{ 'accessibility.show_image' | t: index: forloop.index }}"
                            ></button>
                        {%- endfor -%}
                    {%- else -%}
                        <div class="product-card-shell__pagination-numeric">
                            <button
                                type="button"
                                class="product-card-shell__pagination-arrow"
                                @click.prevent="prevImage()"
                                aria-label="{{ 'accessibility.previous_image' | t }}"
                            >
                                {%- render 'icons', icon: 'icon-arrow2', class: 'rotate-180' -%}
                            </button>
                            <span
                                class="product-card-shell__pagination-text"
                                aria-live="polite"
                                x-text="`${activeImageIndex + 1}/${imageCount}`"
                                >1 / {{ image_count -}}
                            </span>
                            <button
                                type="button"
                                class="product-card-shell__pagination-arrow"
                                @click.prevent="nextImage()"
                                aria-label="{{ 'accessibility.next_image' | t }}"
                            >
                                {%- render 'icons', icon: 'icon-arrow2' -%}
                            </button>
                        </div>
                    {%- endif -%}
                </div>
            {%- endif -%}
        </div>
    </div>

    <div
        class="product-card__image product-card-shell__media"
        style="--pc-media-ratio: {{ pc_media_ratio }};"
        @mouseenter="setImageHover(true)"
        @mouseleave="setImageHover(false)"
    >
        {%- capture sizes -%}
            (min-width: 48rem) calc(100vw / {{ pc_items }}), calc(100vw / {{ mobile_items }})
        {%- endcapture -%}

        {%- capture widths -%}
            200,360,480,640,800,960
        {%- endcapture -%}

        <a href="{{ product.url }}" class="product-card__image-link product-card-shell__media-link">
            {%- for image in product.images -%}
                {%- if forloop.first -%}
                    {%- assign img_loading = primary_image_loading -%}
                    {%- assign img_fetchpriority = primary_image_fetchpriority -%}
                {%- else -%}
                    {%- assign img_loading = 'lazy' -%}
                    {%- assign img_fetchpriority = '' -%}
                {%- endif -%}
                <div
                    class="product-card__carousel-slide"
                    data-product-card-carousel-slide
                    data-index="{{ forloop.index0 }}"
                    x-show="activeImageIndex === Number($el.dataset.index)"
                >
                    {%- assign image_alt = image.alt | default: product.title -%}
                    {%- render 'image',
                        image: image,
                        alt: image_alt,
                        width: image.width,
                        sizes: sizes,
                        widths: widths,
                        aspect_ratio: aspect_ratio,
                        class: 'product-card-shell__media-frame',
                        img_class: 'product-card-shell__image',
                        loading: img_loading,
                        fetchpriority: img_fetchpriority
                    -%}
                </div>
            {%- else -%}
                <div class="product-card__carousel-slide" x-show="true">
                    {%- assign image_alt = product.featured_image.alt | default: product.title -%}
                    {%- render 'image',
                        image: product.featured_image,
                        alt: image_alt,
                        width: product.featured_image.width,
                        sizes: sizes,
                        widths: widths,
                        aspect_ratio: aspect_ratio,
                        class: 'product-card-shell__media-frame',
                        img_class: 'product-card-shell__image',
                        loading: primary_image_loading,
                        fetchpriority: primary_image_fetchpriority
                    -%}
                </div>
            {%- endfor -%}
        </a>

        {%- if hover_mode == 'variants' -%}
            <button
                type="button"
                class="product-card__quick-view-trigger"
                :class="imageHover && 'is-visible'"
                @click.prevent.stop="openQuickView()"
                aria-label="{{ 'accessibility.quick_view' | t: product: product.title | escape }}"
            >
                {% render 'icons', icon: 'icon-eye' %}
            </button>

            {%- if has_variant_panel -%}
                <div
                    class="product-card__variant-shell"
                    :class="showVariantPanel ? 'is-visible' : ''"
                    @mouseenter="setImageHover(true)"
                    @mouseleave="setImageHover(false)"
                >
                    <div class="product-card__variant-heading">
                        <div
                            class="product-card__variant-title product-card-shell__title"
                            title="{{ product.title }}"
                        >
                            {{ product.title }}
                        </div>
                        <div class="product-card__variant-price product-card-shell__price">
                            {{ product.price | money }}
                        </div>
                    </div>

                    <div class="product-card__variant-body" x-data="dragScroll({ axis: 'y' })">
                        {% render 'product-card-variant-panel', product: product, limit: 8 %}
                    </div>
                </div>
            {%- else -%}
                <div class="product-card__variant-shell product-card__variant-shell--static is-visible">
                    <div class="product-card__variant-heading">
                        <div
                            class="product-card__variant-title product-card-shell__title"
                            title="{{ product.title }}"
                        >
                            {{ product.title }}
                        </div>
                        <div class="product-card__variant-price product-card-shell__price">
                            {{ product.price | money }}
                        </div>
                    </div>
                </div>
            {%- endif -%}
        {%- endif -%}
    </div>

    {%- unless hover_mode == 'variants' -%}
        <div
            class="product-card__info product-card-shell__info"
            data-motion-reveal="content"
        >
            <div
                class="product-card__info-title product-card-shell__title"
                title="{{ product.title }}"
            >
                {{ product.title }}
            </div>
            <div class="product-card__info-price product-card-shell__price">
                {{ product.price | money }}
            </div>
        </div>
    {%- endunless -%}

    {%- if show_hover_actions_enabled -%}
        <div
            class="product-card__hover-actions"
            :class="showHoverActions && 'is-visible'"
            @mouseenter="setActionsHover(true)"
            @mouseleave="setActionsHover(false)"
        >
            <button
                class="product-card__btn-primary"
                data-product-handle="{{ product.handle }}"
                @click.prevent.stop="openQuickView()"
            >
                {{ 'products.product.quick_view' | t }}
            </button>
            <button
                class="product-card__btn-secondary"
                data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                :disabled="!primaryVariantAvailable || isAddingToCart"
                :class="{ 'is-disabled': !primaryVariantAvailable }"
                @click.prevent.stop="addPrimaryVariantToCart()"
            >
                <span x-show="!isAddingToCart && primaryVariantAvailable">
                    {{- 'products.product.add_to_cart' | t -}}
                </span>
                <span x-show="!isAddingToCart && !primaryVariantAvailable">
                    {{- 'products.product.sold_out' | t -}}
                </span>
                <span x-show="isAddingToCart" x-cloak>{{ 'products.product.adding' | t }}</span>
            </button>
        </div>
    {%- endif -%}
</div>

{%- capture quick_view_content -%}
    {%- render 'product-quick-view',
        product: product,
        dialog_id: quick_view_dialog_id,
        section_id: quick_view_dialog_id,
        color_scheme: color_scheme
    -%}
{%- endcapture -%}

<template x-teleport="body">
    {%-
        render 'ui-dialog',
        id: quick_view_dialog_id,
        type: 'modal',
        layer: 'modal-focus',
        color_scheme: color_scheme,
        modal_wrapper_class: 'items-center justify-center px-3 py-4 pc:px-[8vw] pc:py-[5vh]',
        modal_panel_class: 'h-full w-full !max-h-full !max-w-full overflow-hidden',
        show_close_button: true,
        close_label: 'accessibility.close_quick_view' | t,
        content: quick_view_content
    -%}
</template>
