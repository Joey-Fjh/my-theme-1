{% doc %}
    Reusable quick view modal content for product cards.

    @param {product} product - Product object to render.
    @param {string} dialog_id - Dialog id used by ui-dialog.
    @param {string} [section_id] - Unique runtime scope for Alpine variant/price sync.
    @param {string} [color_scheme] - Optional color scheme id applied to the content scope.
{% enddoc %}

{%- assign quick_view_section_id = section_id -%}
{%- if quick_view_section_id == blank -%}
    {%- assign quick_view_section_id = 'quick-view-' | append: product.id -%}
{%- endif -%}
{%- assign color_scheme = color_scheme | default: '' -%}
{%- assign product_form_id = 'product-form-' | append: quick_view_section_id -%}

<div class="product-quick-view{% if color_scheme != blank %} color-{{ color_scheme }}{% endif %}">
    <div class="product-quick-view__layout">
        <div class="product-quick-view__media">
            {%- assign gallery_id = 'product-gallery-quick-view-' | append: product.id -%}
            {%- render 'product-gallery',
                media: product.media,
                id: gallery_id,
                layout: 'thumbnails',
                thumb_position: 'left',
                thumbnail_visible_count: 4,
                aspect_ratio: '1/1'
            -%}
        </div>

        <div class="product-quick-view__info">
            {%- render 'product-purchase-stack',
                product: product,
                dialog_id: dialog_id,
                section_id: quick_view_section_id,
                product_form_id: product_form_id,
                details_href: product.url,
                show_brand: true,
                show_description: true,
                description_truncate: 120
            -%}
        </div>
    </div>
</div>
