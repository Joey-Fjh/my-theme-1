{% doc %}
    Renders a reusable badge element. Supports sale, sold-out, new, custom, and count types.

    @param {string} [type] - Badge type: 'sale' | 'sold-out' | 'new' | 'custom' | 'count'. Defaults to 'custom'.
    @param {string} [text] - Display text. Defaults vary by type.
    @param {string} [color_scheme] - Optional color scheme override.
    @param {string} [position] - Position override: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right'. Defaults to settings.badge_position.
    @param {string} [count] - Numeric value for count-type badges.
    @param {string} [class] - Optional extra CSS classes.

    @example
    {% render 'ui-badge', type: 'sale', color_scheme: settings.sale_badge_color_scheme %}
    {% render 'ui-badge', type: 'count', count: cart.item_count %}
{% enddoc %}

{%- liquid
    assign badge_type = type | default: 'custom'
    assign badge_position = position | default: settings.badge_position | default: 'top-left'
    assign badge_color_scheme = color_scheme | default: ''
    assign badge_extra_class = class | default: ''

    if badge_type == 'count'
        assign badge_utility = 'badge-cart'
    else
        assign badge_utility = 'badge-label'
    endif

    if text != blank
        assign badge_text = text
    elsif badge_type == 'sale'
        assign badge_text = 'products.product.badges.sale' | t
    elsif badge_type == 'sold-out'
        assign badge_text = 'products.product.badges.sold_out' | t
    elsif badge_type == 'new'
        assign badge_text = 'products.product.badges.new' | t
    elsif badge_type == 'count' and count != blank
        assign badge_text = count
    else
        assign badge_text = ''
    endif

    case badge_position
        when 'top-left'
            assign position_classes = 'top-2 left-2'
        when 'top-right'
            assign position_classes = 'top-2 right-2'
        when 'bottom-left'
            assign position_classes = 'bottom-2 left-2'
        when 'bottom-right'
            assign position_classes = 'bottom-2 right-2'
        else
            assign position_classes = 'top-2 left-2'
    endcase
-%}

{%- if badge_text != blank -%}
    <span
        class="pointer-events-none absolute {{ position_classes }} {{ badge_utility }}{% if badge_color_scheme != blank %} color-{{ badge_color_scheme }}{% endif %} {{ badge_extra_class }}"
        {%- if badge_type == 'count' %}
            x-show="{{ count }} > 0"
            x-text="{{ count }}"
        {%- endif -%}
    >
        {%- unless badge_type == 'count' -%}
            {{ badge_text }}
        {%- endunless -%}
    </span>
{%- endif -%}
