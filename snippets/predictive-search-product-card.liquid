{% doc %}
    Shared lightweight predictive-search product card.

    Expects an Alpine `product` object in scope with:
    - `title`
    - `vendor`
    - `priceFormatted`
    - `url`
    - `image`
    - `images`

    @param {string} [class] - Optional extra classes on the root card.
    @param {string} [frame_class] - Optional extra classes for the media frame.
{% enddoc %}

{%- assign predictive_card_class = class | default: '' -%}
{%- assign predictive_frame_class = frame_class | default: '' -%}

{%- assign global_ratio = settings.card_image_ratio | default: 'adapt' -%}
{%- if global_ratio == 'portrait' -%}
    {%- assign predictive_aspect = '3/4' -%}
{%- elsif global_ratio == 'landscape' -%}
    {%- assign predictive_aspect = '4/3' -%}
{%- elsif global_ratio == 'square' -%}
    {%- assign predictive_aspect = '1/1' -%}
{%- else -%}
    {%- assign predictive_aspect = '' -%}
{%- endif -%}

<div
    class="product-card-shell {{ predictive_card_class }}"
    x-data="cardGallery"
>
    <div class="product-card-shell__meta">
        {%- if settings.search_show_vendor -%}
            <span
                class="product-card-shell__brand"
                data-fallback-vendor-label="{{ 'products.product.fallback_vendor' | t | escape }}"
                x-text="product.vendor || $el.dataset.fallbackVendorLabel"
            ></span>
        {%- endif -%}

        <div
            class="product-card-shell__pagination"
            x-show="canNavigateImages"
            x-cloak
            aria-label="{{ 'accessibility.image_navigation' | t }}"
            data-show-image-label="{{ 'accessibility.show_image' | t: index: '__INDEX__' }}"
        >
            <template x-if="product.images && product.images.length <= 3">
                <div class="flex items-center gap-3">
                    <template
                        x-for="(image, imageIndex) in product.images"
                        :key="image.url || imageIndex"
                    >
                        <button
                            type="button"
                            class="product-card-shell__pagination-dot"
                            :class="{ 'is-active': activeImageIndex === imageIndex }"
                            @click.prevent="setActiveImage(imageIndex)"
                            :aria-label="$el.closest('.product-card-shell__pagination').dataset.showImageLabel.replace('__INDEX__', imageIndex + 1)"
                        ></button>
                    </template>
                </div>
            </template>

            <template x-if="product.images && product.images.length > 3">
                <div class="product-card-shell__pagination-numeric">
                    <button
                        type="button"
                        class="product-card-shell__pagination-arrow"
                        @click.prevent="prevImage()"
                        aria-label="{{ 'accessibility.previous_image' | t }}"
                    >
                        {%- render 'icons',
                            icon: 'icon-arrow2',
                            size: 'xl',
                            class: 'rotate-180',
                            color: 'current'
                        -%}
                    </button>
                    <span
                        class="product-card-shell__pagination-text"
                        x-text="imageNavigationLabel"
                    ></span>
                    <button
                        type="button"
                        class="product-card-shell__pagination-arrow"
                        @click.prevent="nextImage()"
                        aria-label="{{ 'accessibility.next_image' | t }}"
                    >
                        {%- render 'icons', icon: 'icon-arrow2', size: 'xl', color: 'current' -%}
                    </button>
                </div>
            </template>
        </div>
    </div>

    <a :href="product.url" class="product-card-shell__media-link">
        <div
            class="product-card-shell__media"
            {% if predictive_aspect != blank %}
                style="--card-media-aspect-ratio: {{ predictive_aspect }};"
            {% else %}
                :style="{ '--card-media-aspect-ratio': product.imageAspectRatio || '1 / 1' }"
            {% endif %}
        >
            <template x-if="product.images && product.images.length">
                <template
                    x-for="(image, imageIndex) in product.images"
                    :key="image.url || imageIndex"
                >
                    <div
                        class="absolute inset-0"
                        x-show="activeImageIndex === imageIndex"
                        {% render 'motion-transition', preset: 'image-fade' %}
                    >
                        <div class="product-card-shell__media-frame {{ predictive_frame_class }}">
                            <img
                                class="product-card-shell__image"
                                :src="image.url"
                                :alt="image.alt || product.title"
                                width="120"
                                height="120"
                            >
                        </div>
                    </div>
                </template>
            </template>

            <template x-if="!product.images || !product.images.length">
                <div class="product-card-shell__media-frame {{ predictive_frame_class }}">
                    <img
                        class="product-card-shell__image"
                        :src="product.image"
                        :alt="product.title"
                        width="120"
                        height="120"
                    >
                </div>
            </template>
        </div>
    </a>

    <div class="product-card-shell__info">
        <a
            class="product-card-shell__title"
            :href="product.url"
            x-text="product.title"
        ></a>
        {%- if settings.search_show_price -%}
            <p class="product-card-shell__price" x-text="product.priceFormatted"></p>
        {%- endif -%}
    </div>
</div>
