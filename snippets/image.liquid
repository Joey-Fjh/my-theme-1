{% doc %}
    Renders a responsive image that might be wrapped in a link.

  When `width`, `height` and `crop` are provided, the image will be rendered
  with a fixed aspect ratio.

  Serves as an example of how to use the `image_url` filter and `image_tag` filter
  as well as how you can use LiquidDoc to document your code.

  This is a component that defaults to assuming "full-width" layout.
  If the image is not actually displayed at full width in your layout, please be sure to override the sizes parameter when invoking it.

  ## Display contract (Phase Image-B)

  Two display modes control wrapper sizing and the default object-fit:
  - `frame` (default): the image fills a fixed container. Wrapper gets `height: 100%`; img defaults to `object-cover`.
  - `natural`: the image displays at its intrinsic ratio without forced fill. Wrapper gets `height: auto`; img defaults to `object-contain`.

  `fit` overrides the mode-derived default: `cover` | `contain` | `fill` | `none` | `scale-down`.

  Object-position precedence on the final img:
  1. Caller-provided valid `position` (whitelist only) — overrides Shopify focal point
  2. `image_tag` automatic focal-point `object-position` (X% Y%) when present
  3. `center`

  Do not default `position` before recording whether the caller passed it; a silent
  `center` default would incorrectly override every image focal point.
  Focal-point percentage strings must never enter the fixed `position` whitelist.

  ## Linked wrapper interaction

  When `url` is provided, the snippet renders an `<a>` wrapper and appends `media-interaction`
  unless `interactive: false`. Callers must not duplicate `media-interaction` in `wrapper_class`.
  Use `interactive: false` for logos and other linked images that should not breathe.

    @param {image} image - The image to be rendered
    @param {string} [url] - An optional destination URL for the image
    @param {boolean} [interactive] - When `url` is set, applies `media-interaction` on the linked wrapper by default. Pass `false` for linked images that should stay static (for example logos).
    @param {string} [wrapper] - An optional wrapper element, either 'a' or 'div'. If not provided, it will be 'a' if url is provided, otherwise 'div'.
    @param {string} [wrapper_class] - Optional class added to the image wrapper. Canonical name; `class` is a deprecated alias merged into this.
    @param {string} [class] - Deprecated alias for `wrapper_class`. If both are provided, they are merged.
    @param {string} [img_class] - Optional class to be added to the img tag. `image_img` is always applied.
    @param {string} [mode] - Display mode: 'frame' (default) or 'natural'. Controls wrapper height and default object-fit.
    @param {string} [fit] - Object-fit override: 'cover' | 'contain' | 'fill' | 'none' | 'scale-down'. Default derived from mode: 'cover' for frame, 'contain' for natural.
    @param {string} [position] - Explicit object-position whitelist value (`center`, `top`, `bottom`, `left`, `right`, or compounds like `top left`). When provided and valid, overrides `image_tag` focal point. When omitted, Shopify focal point is preserved; otherwise falls back to `center`.
    @param {number} [width] - The highest resolution width of the image to be rendered
    @param {number} [height] - The highest resolution height of the image to be rendered
    @param {string} [crop] - The crop position of the image
    @param {string} [widths] - Optional widths for srcset generation (comma-separated list of numbers)
    @param {string} [sizes] - Optional sizes attribute for responsive images
    @param {string} [loading] - Optional loading attribute for the img tag ('lazy' or 'eager')
    @param {string} [decoding] - Optional decoding attribute for the img tag ('async', 'sync' or 'auto')
    @param {string} [alt] - Alt text for the image (defaults to empty string for decorative images)
    @param {string} [aspect_ratio] - Optional aspect ratio for the image (e.g. '16:9')
    @param {string} [placeholder_key] - Optional placeholder key for nil image
    @param {string} [placeholder_class] - Optional extra class for the placeholder svg
    @param {string} [placeholder_aspect_ratio] - Optional fallback aspect ratio when image is nil (defaults to '4/3')
    @param {string} [extra_attributes] - Additional raw HTML attributes applied to the <img> element
    @param {string} [fetchpriority] - Optional fetchpriority attribute for the img tag ('high', 'low', or 'auto')
    @param {boolean} [motion_reveal] - Optional. Defaults to true. Pass false when a parent component owns the reveal target.

    @example
    {% render 'image', image: product.featured_image, url: product.url %}
    {% render 'image',
        image: product.featured_image,
        url: product.url,
        sizes: '(min-width: 1024px) 33vw,50vw',
        loading: 'eager'
    %}
{% enddoc %}

{%- liquid
    if width == blank
        assign width = 1440
    endif

    assign widths = widths | default: '165,360,535,750,1100,1500,2000'
    assign sizes = sizes | default: '100vw'

    assign loading = loading | default: 'lazy'
    assign decoding = decoding | default: 'async'
    assign fetchpriority = fetchpriority
    assign placeholder_aspect_ratio = placeholder_aspect_ratio | default: '4/3'
    assign aspect_ratio = aspect_ratio
    if aspect_ratio == blank and image != blank and image.width and image.height
        assign aspect_ratio = image.width | append: '/' | append: image.height
    elsif aspect_ratio == blank
        assign aspect_ratio = placeholder_aspect_ratio
    endif

    assign mode = mode | default: 'frame'
    assign explicit_wrapper_class = wrapper_class | default: ''
    assign legacy_wrapper_class = class | default: ''
    assign img_class = img_class | default: ''
    assign extra_attributes = extra_attributes | default: ''
    assign alt = alt | default: ''
    assign motion_reveal_enabled = true
    if motion_reveal == false
        assign motion_reveal_enabled = false
    endif

    if mode == 'natural'
        assign fit = fit | default: 'contain'
    else
        assign fit = fit | default: 'cover'
    endif

    assign position_explicit = false
    if position != blank
        assign position_explicit = true
    endif

    assign valid_modes = 'frame,natural'
    assign valid_fits = 'cover,contain,fill,none,scale-down'
    assign valid_positions = 'center,top,bottom,left,right,top left,top right,bottom left,bottom right'

    assign mode_allowed = false
    assign mode_tokens = valid_modes | split: ','
    for m in mode_tokens
        if m == mode
            assign mode_allowed = true
            break
        endif
    endfor
    unless mode_allowed
        assign mode = 'frame'
    endunless

    if fit != blank
        assign fit_allowed = false
        assign fit_tokens = valid_fits | split: ','
        for f in fit_tokens
            if f == fit
                assign fit_allowed = true
                break
            endif
        endfor
        unless fit_allowed
            if mode == 'natural'
                assign fit = 'contain'
            else
                assign fit = 'cover'
            endif
        endunless
    endif

    if position_explicit
        assign position_allowed = false
        assign position_tokens = valid_positions | split: ','
        for p in position_tokens
            if p == position
                assign position_allowed = true
                break
            endif
        endfor
        unless position_allowed
            assign position = 'center'
        endunless
    else
        assign position = blank
    endif

    if fetchpriority != blank
        assign extra_attributes = extra_attributes | append: ' fetchpriority="' | append: fetchpriority | append: '"'
    endif

    assign apply_media_interaction = false
    if url != blank
        assign apply_media_interaction = true
        if interactive == false or interactive == 'false'
            assign apply_media_interaction = false
        endif
    endif
-%}

{% liquid
    assign has_object_fit = false
    assign img_class_tokens = img_class | split: ' '
    for img_class_token in img_class_tokens
        if img_class_token == 'object-cover' or img_class_token == 'object-contain' or img_class_token == 'object-fill' or img_class_token == 'object-none' or img_class_token == 'object-scale-down'
            assign has_object_fit = true
            break
        endif
        if img_class_token contains ':object-cover' or img_class_token contains ':object-contain' or img_class_token contains ':object-fill' or img_class_token contains ':object-none' or img_class_token contains ':object-scale-down'
            assign has_object_fit = true
            break
        endif
    endfor

    unless has_object_fit
        assign img_class = img_class | append: ' object-' | append: fit
    endunless
    assign img_class = 'image_img ' | append: img_class
    assign img_class = img_class | strip

    unless height
        assign width = width | default: image.width
    endunless

    if url != blank
        assign wrapper = 'a'
    else
        assign wrapper = 'div'
    endif

    assign placeholder_key = placeholder_key | default: 'image'
    assign placeholder_class = 'svg-placeholder ' | append: placeholder_class
    assign placeholder_class = placeholder_class | strip

    assign wrapper_class = 'theme-image'
    if explicit_wrapper_class != blank
        assign wrapper_class = wrapper_class | append: ' ' | append: explicit_wrapper_class
    endif
    if legacy_wrapper_class != blank
        assign wrapper_class = wrapper_class | append: ' ' | append: legacy_wrapper_class
    endif
    if apply_media_interaction
        assign wrapper_class = wrapper_class | append: ' media-interaction'
    endif
%}

<{{ wrapper }}
    class="{{ wrapper_class }}"
    {% if url %}
        href="{{ url }}"
    {% endif %}
    {% if motion_reveal_enabled %}
        data-motion-reveal="media"
    {% endif %}
    data-image-mode="{{ mode }}"
    {%- if position_explicit -%}
        data-image-position="explicit"
    {%- endif -%}
    {%- if aspect_ratio and position_explicit -%}
        style="--aspect-ratio: {{ aspect_ratio }}; --image-object-position: {{ position }}"
    {%- elsif aspect_ratio -%}
        style="--aspect-ratio: {{ aspect_ratio }}"
    {%- elsif position_explicit -%}
        style="--image-object-position: {{ position }}"
    {%- endif -%}
>
    {%- if image != blank -%}
        {%- capture image_tag_html -%}
            {{ 
                image 
                | image_url: width: width, height: height, crop: crop 
                | image_tag:
                    class: img_class,
                    alt: alt,
                    widths: widths, 
                    sizes: sizes,
                    loading: loading,
                    decoding: decoding
            }}  
        {%- endcapture -%}

        {%- if extra_attributes != blank -%}
            {{ image_tag_html | replace_first: '>', ' ' | append: extra_attributes | append: '>' }}
        {%- else -%}
            {{ image_tag_html }}
        {%- endif -%}
    {%- else -%}
        {{ placeholder_key | placeholder_svg_tag: placeholder_class }}
    {%- endif -%}
</{{ wrapper }}>

{% stylesheet %}
    .theme-image {
        display: block;
        position: relative;
        overflow: hidden;
        width: 100%;
        aspect-ratio: var(--aspect-ratio);
    }

    .theme-image[data-image-mode='frame'] {
        height: 100%;
    }

    .theme-image[data-image-mode='natural'] {
        height: auto;
    }

    .theme-image > .image_img {
        width: 100%;
        height: 100%;
        display: block;
        object-position: center;
    }

    .theme-image[data-image-position='explicit'] > .image_img {
        object-position: var(--image-object-position) !important;
    }

    .svg-placeholder {
        width: 100%;
        height: 100%;
        display: block;
    }

    .svg-placeholder svg {
        width: 100%;
        height: 100%;
        display: block;
    }
{% endstylesheet %}
