{% doc %}
    Vertical inline filters for collection/search pages.

    @param {object} filter_source - Optional. Pass collection/search object.
    @param {string} [wrapper_class] - Optional wrapper class override.
{% enddoc %}

{%- assign filter_host = filter_source | default: collection | default: search -%}
{%- assign wrapper_class = wrapper_class | default: '' -%}

<div class="{{ wrapper_class }} flex flex-col gap-4">
    {%- for filter in filter_host.filters -%}
        {%- render 'filters-field', filter: filter, mode: 'vertical' -%}
    {%- endfor -%}
</div>
