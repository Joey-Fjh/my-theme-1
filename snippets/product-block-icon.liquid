{% doc %}
    Renders a configurable icon for product information blocks.

    @param {string} icon - Icon option value. Use 'none' to render nothing, 'custom' to render custom_svg, or an existing icon asset name.
    @param {string} [custom_svg] - Optional custom SVG markup used when icon is 'custom'.
    @param {number} [size_px] - Icon size in pixels.
    @param {string} [color] - Icon color.
    @param {string} [class] - Optional extra classes for the wrapper.
{% enddoc %}

{%- liquid
    assign icon_name = icon | default: 'none'
    assign icon_size_px = size_px | default: 20 | plus: 0
    assign icon_color = color | default: 'currentColor'
    assign extra_class = class | default: ''
-%}

{%- unless icon_name == 'none' or icon_name == blank -%}
    <span
        class="product-block-icon inline-flex shrink-0 items-center justify-center text-current {{ extra_class }}"
        style="--product-block-icon-size: {{ icon_size_px }}px; color: {{ icon_color }};"
        aria-hidden="true"
    >
        {%- if icon_name == 'custom' -%}
            {{ custom_svg }}
        {%- else -%}
            {%- render 'icons', icon: icon_name, class: '!h-full !w-full' -%}
        {%- endif -%}
    </span>
{%- endunless -%}
