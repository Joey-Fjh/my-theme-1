{% doc %}
    Search results tabs (products/articles/pages) for full search page.

    Purpose:
    - Keep `sections/search.liquid` focused on orchestration and query params.
    - Render tab header, panel, and pagination for server-side search results.

    Parameters:
    -

    @param {string} section_id - Current section id, used by `sectionPagination(...)`.

    -

    @param {number} active_tab_index - Initial active tab index derived from `request.params.type`.

    -

    @param {string} products_url - Search URL targeting product type.

    -

    @param {string} articles_url - Search URL targeting article type.

    -

    @param {string} pages_url - Search URL targeting page type.

    -

    @param {string} param_type - Active result type (`product`, `article`, `page`) for rendering result list.

    -

    @param {number} search_per_page - Pagination size.

    Dependencies: - Expects global `search` object and `sectionPagination` Alpine component to be
    available.
{% enddoc %}

<div
    class="w-full"
    data-pagination-section-id="{{ section_id }}"
    data-pagination-selectors='["[role=tablist]","[data-search-tabs-panel]"]'
    x-data="sectionPagination()"
>
    {% capture results_tab_header %}
        <span class="hidden" x-init="$nextTick(() => { setActive({{ active_tab_index }}) })"></span>

        <a
            href="{{ products_url }}"
            role="tab"
            x-data="{ index: null }"
            x-init="index = registerTab($el);"
            :id="`tab-${index}`"
            aria-controls="search-results-panel"
            @click.prevent="loadUrl($el.href); setActive(index)"
            @popstate.window="isUrlMatch($el.href) && setActive(index)"
            :tabindex="isActive(index) ? 0 : -1"
            :aria-selected="isActive(index)"
            class="search-results-tabs__tab tab-nav-item tab-nav-item--search whitespace-nowrap"
            :class="{ 'is-active': isActive(index) }"
        >
            {{ 'search.products' | t }}
        </a>

        <a
            href="{{ articles_url }}"
            role="tab"
            x-data="{ index: null }"
            x-init="index = registerTab($el);"
            :id="`tab-${index}`"
            aria-controls="search-results-panel"
            @click.prevent="loadUrl($el.href); setActive(index)"
            @popstate.window="isUrlMatch($el.href) && setActive(index)"
            :tabindex="isActive(index) ? 0 : -1"
            :aria-selected="isActive(index)"
            class="search-results-tabs__tab tab-nav-item tab-nav-item--search whitespace-nowrap"
            :class="{ 'is-active': isActive(index) }"
        >
            {{ 'search.articles' | t }}
        </a>

        <a
            href="{{ pages_url }}"
            role="tab"
            x-data="{ index: null }"
            x-init="index = registerTab($el);"
            :id="`tab-${index}`"
            aria-controls="search-results-panel"
            @click.prevent="loadUrl($el.href); setActive(index)"
            @popstate.window="isUrlMatch($el.href) && setActive(index)"
            :tabindex="isActive(index) ? 0 : -1"
            :aria-selected="isActive(index)"
            class="search-results-tabs__tab tab-nav-item tab-nav-item--search whitespace-nowrap"
            :class="{ 'is-active': isActive(index) }"
        >
            {{ 'search.pages' | t }}
        </a>
    {% endcapture %}

    {% capture results_tab_content %}
        <div
            role="tabpanel"
            id="search-results-panel"
            x-data="{ index: null }"
            x-init="index = registerPanel($el)"
            class="relative mt-6 w-full"
            data-search-tabs-panel
        >
            {% render 'loading', overlay: true, size: 'large' %}

            {% unless search.results_count == 0 %}
                <div class="mb-6 text-theme-text">
                    <p class="body-sm tracking-[0.16em] uppercase">
                        <span>
                            {{ 'search.search_for' | t }} <span class="truncate body-sm">"{{ search.terms | escape }}"</span> : {{ search.results_count }}
                        </span>
                    </p>
                </div>
            {% endunless %}

            {% paginate search.results by search_per_page %}
                {%- if search.results_count == 0 -%}
                    <div class="py-16 text-center text-theme-text">
                        <p>{{ 'search.no_results_for' | t }} "{{ search.terms | escape }}"</p>
                    </div>
                {%- else -%}
                    {%- case param_type -%}
                        {%- when 'product' -%}
                            <div class="grid grid-cols-2 gap-6 pc:grid-cols-4">
                                {%- for item in search.results -%}
                                    {%- if item.object_type == 'product' -%}
                                        {% render 'product-card',
                                            product: item
                                        %}
                                    {%- endif -%}
                                {%- endfor -%}
                            </div>

                        {%- when 'article' -%}
                            <ul class="space-y-4">
                                {%- for item in search.results -%}
                                    {%- if item.object_type == 'article' -%}
                                        <li class="border-b border-theme-border-20 pb-3">
                                            <a class="search-results-tabs__result-link interactive-link" href="{{ item.url }}">{{ item.title }}</a>
                                        </li>
                                    {%- endif -%}
                                {%- endfor -%}
                            </ul>

                        {%- when 'page' -%}
                            <ul class="space-y-4">
                                {%- for item in search.results -%}
                                    {%- if item.object_type == 'page' -%}
                                        <li class="border-b border-theme-border-20 pb-3">
                                            <a class="search-results-tabs__result-link interactive-link" href="{{ item.url }}">{{ item.title }}</a>
                                        </li>
                                    {%- endif -%}
                                {%- endfor -%}
                            </ul>
                    {%- endcase -%}

                    <div
                        class="mt-10"
                        @click="
                            let link = $event.target.closest('[data-pagination-nav] a');
                            if (link) {
                                $event.preventDefault();
                                loadUrl(link.href);
                            }
                        "
                    >
                        {% render 'pagination', paginate_obj: paginate %}
                    </div>
                {%- endif -%}
            {% endpaginate %}
        </div>
    {% endcapture %}

    {%- render 'tab-control',
        type: 'underlined',
        initialTabStrategy: 'first',
        header_outer_class: 'w-full',
        header_class: 'mx-auto max-w-3xl flex-wrap items-center justify-center gap-8 border-none tracking-[0.16em] text-theme-text uppercase',
        tab_header: results_tab_header,
        tab_content: results_tab_content
    -%}
</div>
