{%- comment -%}
    Renders social icons from theme settings.

    Accepts:
    - type: {String} 'icon' | 'name' (Optional, default: icon)
    - color: {String} 'theme' | 'current' | 'currentColor' (Optional, default: theme)
    - class: {String} Additional class for the <ul> (optional)
    - font_class: {String} Additional class for the <span> (optional)
    - size:  {String} 'small' | 'medium' | 'large' (optional, default: medium)

    Usage:
    {% render 'social-icons', class: 'my-class', size: 'small' %}
{%- endcomment -%}

{% assign type = type | default: 'icon' %}
{% assign social_color = color | default: 'theme' %}
{% assign social_list_color_class = 'text-theme-icon' %}
{% if social_color == 'current' or social_color == 'currentColor' %}
    {% assign social_list_color_class = 'text-current' %}
{% endif %}
{% assign social_link_class = 'inline-flex items-center justify-center icons-animate-breathe transition-all duration-200 ease-in-out' %}

{%- assign size_class = '' -%}
{%- case size -%}
    {%- when 'small' -%}
        {%- assign size_class = 'w-6 h-6' -%}
    {%- when 'large' -%}
        {%- assign size_class = 'w-10 h-10' -%}
    {%- else -%}
        {%- assign size_class = 'w-8 h-8' -%}
{%- endcase -%}

{%- assign social_platforms = 'facebook,instagram,youtube,tiktok,twitter,pinterest,snapchat,tumblr,vimeo'
    | split: ','
-%}
{%- assign has_any_social = false -%}
{%- for platform in social_platforms -%}
    {%- assign social_setting_key = 'social_' | append: platform | append: '_link' -%}
    {%- assign social_url = settings[social_setting_key] -%}
    {%- unless social_url == blank -%}
        {%- assign has_any_social = true -%}
        {%- break -%}
    {%- endunless -%}
{%- endfor -%}

{%- if has_any_social -%}
    <ul
        class="social-icons flex flex-wrap items-center gap-5 max-pc:hidden {{ social_list_color_class }} {% if class %} {{ class }}{% endif %}"
        role="list"
    >
        {%- for platform in social_platforms -%}
            {%- assign social_setting_key = 'social_' | append: platform | append: '_link' -%}
            {%- assign social_url = settings[social_setting_key] -%}
            {%- if social_url != blank -%}
                {%- assign social_icon_name = 'icon-' | append: platform -%}
                <li class="flex items-center" style="--i: {{ forloop.index0 }};">
                    {%- capture social_link_content -%}
                        {% if type == 'icon' %}
                            {% render 'icons',
                                icon: social_icon_name,
                                class: size_class,
                                color: 'current'
                            %}
                        {% else %}
                            <span class="{{ font_class }}">{{ platform }}</span>
                        {% endif %}
                    {%- endcapture -%}
                    {%- render 'link',
                        href: social_url,
                        class: social_link_class,
                        variant: 'plain',
                        content: social_link_content,
                        target: '_blank',
                        aria_label: platform,
                        attributes: 'rel="noopener"'
                    -%}
                </li>
            {%- endif -%}
        {%- endfor -%}
    </ul>
{%- endif -%}
