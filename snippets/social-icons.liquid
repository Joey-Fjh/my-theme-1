{%- comment -%}
    Renders social icons from theme settings.

    Accepts:
    - type: {String} 'icon' | 'name' (Optional, default: icon)
    - class: {String} Additional class for the <ul> (optional)
    - visibility_class: {String} Responsive visibility class for the <ul> (optional, default: '')

    Usage:
    {% render 'social-icons', class: 'my-class' %}
{%- endcomment -%}

{% assign type = type | default: 'icon' %}
{% assign visibility_class = visibility_class | default: '' %}
{% assign social_link_class = 'social-icons__link inline-flex items-center justify-center icons-animate-breathe' %}

{%- assign social_platforms = 'facebook,instagram,youtube,tiktok,twitter,pinterest,snapchat,tumblr,vimeo'
    | split: ','
-%}
{%- assign has_any_social = false -%}
{%- for platform in social_platforms -%}
    {%- assign social_setting_key = 'social_' | append: platform | append: '_link' -%}
    {%- assign social_url = settings[social_setting_key] -%}
    {%- unless social_url == blank -%}
        {%- assign has_any_social = true -%}
        {%- break -%}
    {%- endunless -%}
{%- endfor -%}

{%- if has_any_social -%}
    <ul
        class="social-icons flex flex-wrap items-center gap-5 {{ visibility_class }} {% if class %} {{ class }}{% endif %}"
        role="list"
    >
        {%- for platform in social_platforms -%}
            {%- assign social_setting_key = 'social_' | append: platform | append: '_link' -%}
            {%- assign social_url = settings[social_setting_key] -%}
            {%- if social_url != blank -%}
                {%- assign social_icon_name = 'icon-' | append: platform -%}
                <li class="flex items-center" style="--i: {{ forloop.index0 }};">
                    {%- capture social_link_content -%}
                        {% if type == 'icon' %}
                            {% render 'icons',
                                icon: social_icon_name
                            %}
                        {% else %}
                            <span>{{ platform }}</span>
                        {% endif %}
                    {%- endcapture -%}
                    {%- render 'link',
                        href: social_url,
                        class: social_link_class,
                        variant: 'plain',
                        content: social_link_content,
                        target: '_blank',
                        aria_label: platform,
                        attributes: 'rel="noopener"'
                    -%}
                </li>
            {%- endif -%}
        {%- endfor -%}
    </ul>
{%- endif -%}

{% stylesheet %}
    .social-icons__link {
        transition:
            opacity var(--motion-duration-fast, 250ms) var(--motion-ease-default, ease),
            color var(--motion-duration-fast, 250ms) var(--motion-ease-default, ease);
    }
{% endstylesheet %}
