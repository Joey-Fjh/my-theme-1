{%- comment -%}
    Renders social icons from theme settings.

    Accepts:
    - type: {String} 'icon' | 'name' (Optional, default: icon)
    - class: {String} Additional class for the <ul> (optional)
    - font_class: {String} Additional class for the <span> (optional)
    - size:  {String} 'small' | 'medium' | 'large' (optional, default: medium)

    Usage:
    {% render 'social-icons', class: 'my-class', size: 'small' %}
{%- endcomment -%}

{% assign type = type | default: 'icon' %}

{%- assign size_class = '' -%}
{%- case size -%}
    {%- when 'small' -%}
        {%- assign size_class = 'w-6 h-6' -%}
    {%- when 'large' -%}
        {%- assign size_class = 'w-10 h-10' -%}
    {%- else -%}
        {%- assign size_class = 'w-8 h-8' -%}
{%- endcase -%}

{%- assign has_any_social = false -%}
{%- unless settings.social_facebook_link == blank -%}
    {%- assign has_any_social = true -%}
{%- endunless -%}
{%- unless settings.social_instagram_link == blank -%}
    {%- assign has_any_social = true -%}
{%- endunless -%}
{%- unless settings.social_youtube_link == blank -%}
    {%- assign has_any_social = true -%}
{%- endunless -%}
{%- unless settings.social_tiktok_link == blank -%}
    {%- assign has_any_social = true -%}
{%- endunless -%}
{%- unless settings.social_twitter_link == blank -%}
    {%- assign has_any_social = true -%}
{%- endunless -%}
{%- unless settings.social_pinterest_link == blank -%}
    {%- assign has_any_social = true -%}
{%- endunless -%}
{%- unless settings.social_snapchat_link == blank -%}
    {%- assign has_any_social = true -%}
{%- endunless -%}
{%- unless settings.social_tumblr_link == blank -%}
    {%- assign has_any_social = true -%}
{%- endunless -%}
{%- unless settings.social_vimeo_link == blank -%}
    {%- assign has_any_social = true -%}
{%- endunless -%}

{%- if has_any_social -%}
    <ul
        class="social-icons max-pc:hidden flex flex-wrap items-center gap-5 {% if class %} {{ class }}{% endif %}"
        role="list"
    >
        {%- if settings.social_facebook_link != blank -%}
            <li class="flex items-center">
                <a
                    class="icons icons-animate-breathe inline-flex items-center justify-center"
                    href="{{ settings.social_facebook_link }}"
                    target="_blank"
                    rel="noopener"
                    aria-label="facebook"
                >
                    {% if type == 'icon' %}
                        {% render 'icons',
                            icon: 'icon-facebook',
                            class: size_class,
                            color: 'current'
                        %}
                    {% else %}
                        <span class="{{ font_class }}">facebook</span>
                    {% endif %}
                </a>
            </li>
        {%- endif -%}

        {%- if settings.social_instagram_link != blank -%}
            <li class="flex items-center">
                <a
                    class="icons icons-animate-breathe inline-flex items-center justify-center"
