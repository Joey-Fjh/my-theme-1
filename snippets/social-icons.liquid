{%- endif -%}

<style>
  .social-icons > li:nth-child(1) { --i: 0;}
  .social-icons > li:nth-child(2) { --i: 1;}
  .social-icons > li:nth-child(3) { --i: 2;}
  .social-icons > li:nth-child(4) { --i: 3;}
  .social-icons > li:nth-child(5) { --i: 4;}
  .social-icons > li:nth-child(6) { --i: 5;}
  .social-icons > li:nth-child(7) { --i: 6;}
  .social-icons > li:nth-child(8) { --i: 7;}
  .social-icons > li:nth-child(9) { --i: 8;}
</style>