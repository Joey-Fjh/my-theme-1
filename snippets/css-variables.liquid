{% style %}
    {% liquid
        assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
        assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
        assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'

        assign heading_font_bold = settings.type_header_font | font_modify: 'weight', 'bold'
        assign heading_font_italic = settings.type_header_font | font_modify: 'style', 'italic'
        assign heading_font_bold_italic = heading_font_bold | font_modify: 'style', 'italic'
    %}

    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {%- if body_font_bold -%}
        {{ body_font_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- if body_font_italic -%}
        {{ body_font_italic | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- if body_font_bold_italic -%}
        {{ body_font_bold_italic | font_face: font_display: 'swap' }}
    {%- endif -%}

    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    {%- if heading_font_bold -%}
        {{ heading_font_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- if heading_font_italic -%}
        {{ heading_font_italic | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- if heading_font_bold_italic -%}
        {{ heading_font_bold_italic | font_face: font_display: 'swap' }}
    {%- endif -%}

    {% comment %} color schemes (last result: :root, .color-scheme-1{} .color-scheme-2{} ...) {% endcomment %}
    {% assign scheme_classes = '' %}
    {% for scheme in settings.color_schemes %}
        {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
        {% if forloop.index == 1 %}
            :root,
        {% endif %}
        .color-{{ scheme.id }} {
            --color-background: {{ scheme.settings.background_color.red }}, {{ scheme.settings.background_color.green }}, {{ scheme.settings.background_color.blue }};
            {% if scheme.settings.background_gradient_color != empty %}
                --gradient-background: {{ scheme.settings.background_gradient_color }};
            {% else %}
                --gradient-background: {{ scheme.settings.background_color }};
            {% endif %}

            --color-foreground: {{ scheme.settings.text_color.red }}, {{ scheme.settings.text_color.green }}, {{ scheme.settings.text_color.blue }};

            --color-border: {{ scheme.settings.border_color.red }}, {{ scheme.settings.border_color.green }}, {{ scheme.settings.border_color.blue }};

            --color-focus-ring: {{ scheme.settings.focus_ring_color.red }}, {{ scheme.settings.focus_ring_color.green }}, {{ scheme.settings.focus_ring_color.blue }};

            --color-input-text: {{ scheme.settings.input_text_color.red }}, {{ scheme.settings.input_text_color.green }}, {{ scheme.settings.input_text_color.blue }};
            --color-input-background: {{ scheme.settings.input_background_color.red }}, {{ scheme.settings.input_background_color.green }}, {{ scheme.settings.input_background_color.blue }};
            --color-input-border: {{ scheme.settings.input_border_color.red }}, {{ scheme.settings.input_border_color.green }}, {{ scheme.settings.input_border_color.blue }};
            --color-input-placeholder: {{ scheme.settings.input_placeholder_color.red }}, {{ scheme.settings.input_placeholder_color.green }}, {{ scheme.settings.input_placeholder_color.blue }};

            --color-primary-button: {{ scheme.settings.primary_button_background_color.red }}, {{ scheme.settings.primary_button_background_color.green }}, {{ scheme.settings.primary_button_background_color.blue }};
            --color-primary-button-text: {{ scheme.settings.primary_button_label_color.red }}, {{ scheme.settings.primary_button_label_color.green }}, {{ scheme.settings.primary_button_label_color.blue }};
            --color-primary-button-border: {{ scheme.settings.primary_button_border_color.red }}, {{ scheme.settings.primary_button_border_color.green }}, {{ scheme.settings.primary_button_border_color.blue }};
            --color-secondary-button: {{ scheme.settings.secondary_button_background_color.red }}, {{ scheme.settings.secondary_button_background_color.green }}, {{ scheme.settings.secondary_button_background_color.blue }};
            --color-secondary-button-text: {{ scheme.settings.secondary_button_label_color.red }}, {{ scheme.settings.secondary_button_label_color.green }}, {{ scheme.settings.secondary_button_label_color.blue }};
            --color-secondary-button-border: {{ scheme.settings.secondary_button_border_color.red }}, {{ scheme.settings.secondary_button_border_color.green }}, {{ scheme.settings.secondary_button_border_color.blue }};

            --color-badge-background: {{ scheme.settings.badge_background_color.red }}, {{ scheme.settings.badge_background_color.green }}, {{ scheme.settings.badge_background_color.blue }};
            --color-badge-foreground: {{ scheme.settings.badge_label_color.red }}, {{ scheme.settings.badge_label_color.green }}, {{ scheme.settings.badge_label_color.blue }};
            --color-badge-border: {{ scheme.settings.badge_border_color.red }}, {{ scheme.settings.badge_border_color.green }}, {{ scheme.settings.badge_border_color.blue }};

            --color-accent: {{ scheme.settings.accent_color.red }}, {{ scheme.settings.accent_color.green }}, {{ scheme.settings.accent_color.blue }};

            --color-success-background: {{ scheme.settings.success_background_color.red }}, {{ scheme.settings.success_background_color.green }}, {{ scheme.settings.success_background_color.blue }};
            --color-success-foreground: {{ scheme.settings.success_foreground_color.red }}, {{ scheme.settings.success_foreground_color.green }}, {{ scheme.settings.success_foreground_color.blue }};
            --color-warning-background: {{ scheme.settings.warning_background_color.red }}, {{ scheme.settings.warning_background_color.green }}, {{ scheme.settings.warning_background_color.blue }};
            --color-warning-foreground: {{ scheme.settings.warning_foreground_color.red }}, {{ scheme.settings.warning_foreground_color.green }}, {{ scheme.settings.warning_foreground_color.blue }};
            --color-error-background: {{ scheme.settings.error_background_color.red }}, {{ scheme.settings.error_background_color.green }}, {{ scheme.settings.error_background_color.blue }};
            --color-error-foreground: {{ scheme.settings.error_foreground_color.red }}, {{ scheme.settings.error_foreground_color.green }}, {{ scheme.settings.error_foreground_color.blue }};
            --color-info-background: {{ scheme.settings.info_background_color.red }}, {{ scheme.settings.info_background_color.green }}, {{ scheme.settings.info_background_color.blue }};
            --color-info-foreground: {{ scheme.settings.info_foreground_color.red }}, {{ scheme.settings.info_foreground_color.green }}, {{ scheme.settings.info_foreground_color.blue }};

            {% comment %} Shadow steps rise on dark backgrounds; tint steps are one set on :root {% endcomment %}
            {%- assign scheme_brightness = scheme.settings.background_color | color_brightness -%}
            {%- if scheme_brightness < 128 -%}
                --alpha-shadow-sm: 0.28;
                --alpha-shadow-md: 0.45;
                --alpha-shadow-lg: 0.6;
            {%- else -%}
                --alpha-shadow-sm: 0.06;
                --alpha-shadow-md: 0.1;
                --alpha-shadow-lg: 0.16;
            {%- endif %}

            {% comment %} Scheme-dependent colour roles, re-declared here so var() consumers resolve against this scheme. Same values as tailwind.input.css (lint:theme colour-role-sync). {% endcomment %}
            --color-muted: rgba(var(--color-foreground), var(--alpha-80));
            --color-subtle: rgba(var(--color-foreground), var(--alpha-72));
            --color-faint: rgba(var(--color-foreground), var(--alpha-20));
            --color-line: rgba(var(--color-border), var(--alpha-20));
            --color-line-strong: rgba(var(--color-border), var(--alpha-35));
            --color-line-inverse: rgba(var(--color-background), var(--alpha-20));
            --color-surface-muted: rgba(var(--color-foreground), var(--alpha-5));
            --color-surface-strong: rgba(var(--color-foreground), var(--alpha-10));
            --color-indicator: rgba(var(--color-foreground), var(--alpha-35));
            --color-indicator-strong: rgba(var(--color-foreground), var(--alpha-50));
            --color-veil: rgba(var(--color-background), var(--alpha-80));
            --shadow-sm: 0 1px 3px rgba(0, 0, 0, var(--alpha-shadow-sm));
            --shadow-md: 0 8px 24px rgba(0, 0, 0, var(--alpha-shadow-md));
            --shadow-lg: 0 14px 36px rgba(0, 0, 0, var(--alpha-shadow-lg));
        }
    {% endfor %}

    {% comment %} last result: body, .color-sheme-1{}, .color-sheme-2{} ... {% endcomment %}
    {{ scheme_classes | prepend: 'body' }} {
        color: rgba(var(--color-foreground), var(--alpha-80));
        background-color: rgb(var(--color-background));
    }

    :root {
        {% comment %} Colour steps (layer 1); roles in tailwind.input.css consume them {% endcomment %}
        --alpha-5: 0.05;
        --alpha-10: 0.1;
        --alpha-20: 0.2;
        --alpha-35: 0.35;
        --alpha-50: 0.5;
        --alpha-72: 0.72;
        --alpha-80: 0.8;

        {%- comment -%} global Variables {%- endcomment -%}
        --announcement-bar-height: 0px;
        --header-height: 0px;

        {% comment %} layout Variables {% endcomment %}
        --page-width: {{ settings.page_width | divided_by: 10}}rem;
        --page-margin: {{ settings.page_margin | divided_by: 10 }}rem;

        {% comment %} font Variables {% endcomment %}
        --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-style: {{ settings.type_body_font.style }};
        --font-body-weight: {{ settings.type_body_font.weight }};
        {%- liquid
            assign theme_body_font_size = settings.body_font_size | default: 16
            assign theme_body_font_size_mobile = settings.body_font_size_mobile | default: 14
        -%}
        --font-body-size: {{ theme_body_font_size }}px;
        --font-body-size-mobile: {{ theme_body_font_size_mobile }}px;
        --font-body-line-height: {{ settings.body_line_height }};
        --font-body-letter-spacing: {{ settings.body_letter_spacing }};
        --font-body-text-transform: {{ settings.body_text_transform }};
        --font-body-scale: {{ settings.body_scale | default: 100 | divided_by: 100.0 }};

        --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
        --font-heading-style: {{ settings.type_header_font.style }};
        --font-heading-weight: {{ settings.heading_weight }};
        --font-heading-line-height: {{ settings.heading_line_height }};
        --font-heading-letter-spacing: {{ settings.heading_letter_spacing }};
        --font-heading-text-transform: {{ settings.heading_text_transform }};
        --font-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};

        {%- comment -%} Fluid type steps (6-C8): base × ratio^n, ratio 1.2→1.25 from 375px to 1280px {%- endcomment -%}
        {%- assign type_step_keys = '-2,-1,0,1,2,3,4,5,6,7,8' | split: ',' -%}
        {%- for step_key in type_step_keys -%}
            {%- liquid
                assign step_num = step_key | plus: 0
                assign mob_micro = theme_body_font_size_mobile | times: 10000
                assign desk_micro = theme_body_font_size | times: 10000
                if step_num < 0
                    assign abs_n = step_num | times: -1
                    for i in (1..abs_n)
                        assign mob_micro = mob_micro | times: 10 | divided_by: 12
                        assign desk_micro = desk_micro | times: 100 | divided_by: 125
                    endfor
                elsif step_num > 0
                    for i in (1..step_num)
                        assign mob_micro = mob_micro | times: 12 | divided_by: 10
                        assign desk_micro = desk_micro | times: 125 | divided_by: 100
                    endfor
                endif
                assign min_r = mob_micro | times: 1.0 | divided_by: 100000
                assign max_r = desk_micro | times: 1.0 | divided_by: 100000
                assign diff_r = max_r | minus: min_r
                assign b_vw = diff_r | divided_by: 0.905
                assign b_at_min = b_vw | times: 0.375
                assign a_rem = min_r | minus: b_at_min
                assign type_step_token = 'type-step-' | append: step_key
            -%}
        --{{ type_step_token }}: clamp({{ min_r | round: 4 }}rem, {{ a_rem | round: 4 }}rem + {{ b_vw | round: 4 }}vw, {{ max_r | round: 4 }}rem);
        {%- endfor -%}

        {% if settings.subtitle_font_source == 'body' %}
            --font-subtitle-family: var(--font-body-family);
            --font-subtitle-style: var(--font-body-style);
        {% else %}
            --font-subtitle-family: var(--font-heading-family);
            --font-subtitle-style: var(--font-heading-style);
        {% endif %}
        --font-subtitle-weight: {{ settings.subtitle_weight }};
        --font-subtitle-line-height: {{ settings.subtitle_line_height }};
        --font-subtitle-letter-spacing: {{ settings.subtitle_letter_spacing }};
        --font-subtitle-text-transform: {{ settings.subtitle_text_transform }};

        --font-pagination-size: calc(
            var(--font-body-size-mobile) * var(--font-body-scale) *
            {{ settings.pagination_font_size | default: 13 }} / {{ theme_body_font_size_mobile }}
        );

        {% comment %} input Variables {% endcomment %}
        --input-radius: {{ settings.input_radius }}px;
        --input-border-width: {{ settings.input_border_thickness }}px;
        --input-padding-x: {{ settings.input_padding_horizontal }}px;
        --input-padding-y: {{ settings.input_padding_vertical }}px;

        --input-shadow-opacity: {{ settings.input_shadow_opacity | divided_by: 100.0 }};
        --input-shadow-horizontal-offset: {{ settings.input_shadow_horizontal_offset }}px;
        --input-shadow-vertical-offset: {{ settings.input_shadow_vertical_offset }}px;
        --input-shadow-blur-radius: {{ settings.input_shadow_blur }}px;

        {% comment %} Button Variables {% endcomment %}
        --button-padding-x: {{ settings.button_padding_horizontal }}px;
        --button-padding-y: {{ settings.button_padding_vertical }}px;

        --button-radius: {{ settings.button_radius }}px;

        --button-border-width: {{ settings.button_border_thickness }}px;

        --button-shadow-opacity: {{ settings.button_shadow_opacity | divided_by: 100.0 }};
        --button-shadow-horizontal-offset: {{ settings.button_shadow_horizontal_offset }}px;
        --button-shadow-vertical-offset: {{ settings.button_shadow_vertical_offset }}px;
        --button-shadow-blur-radius: {{ settings.button_shadow_blur }}px;

        {% comment %} Dialog Variables {% endcomment %}
        --dialog-border-width: {{ settings.dialog_border_thickness }}px;
        --dialog-radius: {{ settings.dialog_radius }}px;

        --dialog-shadow-opacity: {{ settings.dialog_shadow_opacity | divided_by: 100.0 }};
        --dialog-shadow-horizontal-offset: {{ settings.dialog_shadow_horizontal_offset }}px;
        --dialog-shadow-vertical-offset: {{ settings.dialog_shadow_vertical_offset }}px;
        --dialog-shadow-blur-radius: {{ settings.dialog_shadow_blur }}px;

        {% comment %} Product card Variables {% endcomment %}
        --product-card-border-width: {{ settings.product_card_border_thickness }}px;
        --product-card-radius: {{ settings.product_card_radius }}px;

        --product-card-shadow-opacity: {{ settings.product_card_shadow_opacity | divided_by: 100.0 }};
        --product-card-shadow-horizontal-offset: {{ settings.product_card_shadow_horizontal_offset }}px;
        --product-card-shadow-vertical-offset: {{ settings.product_card_shadow_vertical_offset }}px;
        --product-card-shadow-blur-radius: {{ settings.product_card_shadow_blur }}px;

        {% comment %} Toast Variables {% endcomment %}
        --toast-radius: {{ settings.toast_radius }}px;

        --toast-shadow-opacity: {{ settings.toast_shadow_opacity | divided_by: 100.0 }};
        --toast-shadow-horizontal-offset: {{ settings.toast_shadow_horizontal_offset }}px;
        --toast-shadow-vertical-offset: {{ settings.toast_shadow_vertical_offset }}px;
        --toast-shadow-blur-radius: {{ settings.toast_shadow_blur }}px;

        {% comment %} Motion Variables {% endcomment %}
        --motion-duration-fast: 250ms;
        --motion-duration-base: 400ms;
        --motion-duration-slow: 500ms;

        --motion-reveal-duration-base: 1080ms;
        --motion-reveal-opacity-duration: 620ms;
        --motion-reveal-stagger: 170ms;
        --motion-reveal-rise-distance: clamp(40px, 5vw, 64px);
        --motion-reveal-cascade-scale: 0.97;
        --motion-reveal-ease: cubic-bezier(0.25, 0.4, 0.4, 1);

        --motion-ease: cubic-bezier(0.22, 1, 0.36, 1);
        --motion-ease-default: var(--motion-ease);
        --motion-ease-enter: cubic-bezier(0.22, 1, 0.36, 1);
        --motion-ease-exit: cubic-bezier(0.55, 0, 1, 0.45);

        {% comment %} Focus Ring {% endcomment %}
        --focus-ring-width: {{ settings.focus_ring_width | default: 2 }}px;
        --focus-ring-offset: {{ settings.focus_ring_offset | default: 2 }}px;
    }
{% endstyle %}
