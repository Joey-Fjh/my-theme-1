{%- comment -%}
    Maps a semantic motion preset name to Alpine x-transition:* phase attributes.
    CSS phase classes are defined in tailwind/tailwind.animates.css.

    Accepts:
      - preset: 'dropdown' | 'dropdown-slide' | 'drawer-left' | 'drawer-right' | 'fade' | 'image-fade' | 'lightbox-shell' | 'media-enter' | 'modal' | 'tab-content' | 'toast' (extensible)
{%- endcomment -%}

{%- case preset -%}
    {%- when 'fade' -%}
        x-transition:enter="motion-fade-enter" x-transition:enter-start="motion-fade-enter-start"
        x-transition:enter-end="motion-fade-enter-end" x-transition:leave="motion-fade-leave"
        x-transition:leave-start="motion-fade-leave-start"
        x-transition:leave-end="motion-fade-leave-end"

    {%- when 'image-fade' -%}
        x-transition:enter="motion-image-fade-enter"
        x-transition:enter-start="motion-image-fade-enter-start"
        x-transition:enter-end="motion-image-fade-enter-end"
        x-transition:leave="motion-image-fade-leave"
        x-transition:leave-start="motion-image-fade-leave-start"
        x-transition:leave-end="motion-image-fade-leave-end"

    {%- when 'dropdown' -%}
        x-transition:enter="motion-dropdown-enter"
        x-transition:enter-start="motion-dropdown-enter-start"
        x-transition:enter-end="motion-dropdown-enter-end"
        x-transition:leave="motion-dropdown-leave"
        x-transition:leave-start="motion-dropdown-leave-start"
        x-transition:leave-end="motion-dropdown-leave-end"

    {%- when 'dropdown-slide' -%}
        x-transition:enter="motion-dropdown-slide-enter"
        x-transition:enter-start="motion-dropdown-slide-enter-start"
        x-transition:enter-end="motion-dropdown-slide-enter-end"
        x-transition:leave="motion-dropdown-slide-leave"
        x-transition:leave-start="motion-dropdown-slide-leave-start"
        x-transition:leave-end="motion-dropdown-slide-leave-end"

    {%- when 'toast' -%}
        x-transition:enter="motion-toast-enter" x-transition:enter-start="motion-toast-enter-start"
        x-transition:enter-end="motion-toast-enter-end" x-transition:leave="motion-toast-leave"
        x-transition:leave-start="motion-toast-leave-start"
        x-transition:leave-end="motion-toast-leave-end"

    {%- when 'modal' -%}
        x-transition:enter="motion-modal-enter" x-transition:enter-start="motion-modal-enter-start"
        x-transition:enter-end="motion-modal-enter-end" x-transition:leave="motion-modal-leave"
        x-transition:leave-start="motion-modal-leave-start"
        x-transition:leave-end="motion-modal-leave-end"

    {%- when 'drawer-left' -%}
        x-transition:enter="motion-drawer-left-enter"
        x-transition:enter-start="motion-drawer-left-enter-start"
        x-transition:enter-end="motion-drawer-left-enter-end"
        x-transition:leave="motion-drawer-left-leave"
        x-transition:leave-start="motion-drawer-left-leave-start"
        x-transition:leave-end="motion-drawer-left-leave-end"

    {%- when 'drawer-right' -%}
        x-transition:enter="motion-drawer-right-enter"
        x-transition:enter-start="motion-drawer-right-enter-start"
        x-transition:enter-end="motion-drawer-right-enter-end"
        x-transition:leave="motion-drawer-right-leave"
        x-transition:leave-start="motion-drawer-right-leave-start"
        x-transition:leave-end="motion-drawer-right-leave-end"

    {%- when 'lightbox-shell' -%}
        x-transition:enter="motion-lightbox-shell-enter"
        x-transition:enter-start="motion-lightbox-shell-enter-start"
        x-transition:enter-end="motion-lightbox-shell-enter-end"
        x-transition:leave="motion-lightbox-shell-leave"
        x-transition:leave-start="motion-lightbox-shell-leave-start"
        x-transition:leave-end="motion-lightbox-shell-leave-end"

    {%- when 'media-enter' -%}
        x-transition:enter="motion-media-enter" x-transition:enter-start="motion-media-enter-start"
        x-transition:enter-end="motion-media-enter-end"

    {%- when 'magnifier-preview' -%}
        x-transition:enter="motion-magnifier-preview-enter"
        x-transition:enter-start="motion-magnifier-preview-enter-start"
        x-transition:enter-end="motion-magnifier-preview-enter-end"
        x-transition:leave="motion-magnifier-preview-leave"
        x-transition:leave-start="motion-magnifier-preview-leave-start"
        x-transition:leave-end="motion-magnifier-preview-leave-end"

    {%- when 'tab-content' -%}
        x-transition:enter="motion-tab-content-enter"
        x-transition:enter-start="motion-tab-content-enter-start"
        x-transition:enter-end="motion-tab-content-enter-end"
        x-transition:leave="motion-tab-content-leave"
        x-transition:leave-start="motion-tab-content-leave-start"
        x-transition:leave-end="motion-tab-content-leave-end"
{%- endcase -%}
