{% comment %}
    Reusable quantity selector (Tailwind + Alpine.js).
    All logic lives in the registered QuantitySelector Alpine component.

    @param {number}  [value]         - Initial quantity (default: 1)
    @param {number}  [min]           - Minimum allowed value (default: 1)
    @param {number}  [max]           - Maximum allowed value (optional, null = no cap)
    @param {number}  [step]          - Increment / decrement step (default: 1)
    @param {string}  [name]          - Input name attribute (default: 'quantity')
    @param {string}  [product_form_id] - Form id to bind via the form attribute (optional)
    @param {string}  [section_id]    - Section ID; when set, listens for variant:change to auto-update max from inventory
    @param {string}  [input_id]      - Unique id for the <input> (optional)
    @param {string}  [wrapper_class] - Override Tailwind classes on the outer container
    @param {string}  [label]         - Accessible label text (default: 'Quantity')

    Usage (product page):
    {% render 'quantity-selector', value: 1, min: 1, product_form_id: product_form_id, section_id: section.id %}

    Usage (cart — wrap with event listener):
    <div @quantity:change="$store.cart.change('{{ item.key }}', $event.detail.value, ['{{ section.id }}'])">
      {% render 'quantity-selector', value: item.quantity, min: 1, max: max_qty %}
    </div>
{% endcomment %}

<div
    x-data="
        QuantitySelector({
          value: {{ value | default: 1 }},
          min: {{ min | default: 1 }},
          max: {{ max | default: 'null' }},
          step: {{ step | default: 1 }}{% if section_id %},
          sectionId: '{{ section_id }}'{% endif %}
        })
    "
    class="{{ wrapper_class | default: 'flex items-center border border-theme-border-soft rounded-sm w-max' }}"
>
    <button
        type="button"
        class="{{ button_class | default: 'flex h-10 w-10 cursor-pointer items-center justify-center text-current transition-opacity hover:opacity-70 disabled:cursor-not-allowed disabled:opacity-30' }}"
        aria-label="Decrease quantity"
        @click="decrement()"
        :disabled="!canDecrement"
    >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19 13H5v-2h14z"/>
        </svg>
    </button>

    <input
        type="number"
        {% if input_id %}
            id="{{ input_id }}"
        {% endif %}
        name="{{ name | default: 'quantity' }}"
        class="{{ input_class | default: 'w-[4ch] appearance-none border-b border-current bg-transparent p-0 text-center h6 font-medium text-current [-moz-appearance:textfield] focus:ring-0 focus:outline-none [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none' }}"
        x-model.number="qty"
        :min="min"
        :max="max"
        :step="step"
        {% if product_form_id %}
            form="{{ product_form_id }}"
        {% endif %}
        @change="onInput()"
        aria-label="{{ label | default: 'Quantity' }}"
    >

    <button
        type="button"
        class="{{ button_class | default: 'flex h-10 w-10 cursor-pointer items-center justify-center text-current transition-opacity hover:opacity-70 disabled:cursor-not-allowed disabled:opacity-30' }}"
        aria-label="Increase quantity"
        @click="increment()"
        :disabled="!canIncrement"
    >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6z"/>
        </svg>
    </button>
</div>
