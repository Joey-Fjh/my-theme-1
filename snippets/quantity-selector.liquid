{% doc %}
    Reusable quantity selector (Tailwind + Alpine.js).
    All logic lives in the registered QuantitySelector Alpine component.

    @param {number} [value] - Initial quantity (default: 1)
    @param {number} [min] - Minimum allowed value (default: 1)
    @param {number} [max] - Maximum allowed value (optional, null = no cap)
    @param {number} [step] - Increment / decrement step (default: 1)
    @param {string} [name] - Input name attribute (default: 'quantity')
    @param {string} [product_form_id] - Form id to bind via the form attribute (optional)
    @param {string} [section_id] - Section ID; when set, listens for variant:change to auto-update max from inventory
    @param {string} [input_id] - Unique id for the <input> (optional)
    @param {string} [wrapper_class] - Override Tailwind classes on the outer container (escape hatch).
    @param {string} [button_class] - Override Tailwind classes on +/- buttons (escape hatch, forwarded by buy-buttons).
    @param {string} [input_class] - Override Tailwind classes on the input (escape hatch, forwarded by buy-buttons).
    @param {string} [label] - Accessible label text (default: 'Quantity')

    Usage (product page): {% render 'quantity-selector', value: 1, min: 1, product_form_id:
    product_form_id, section_id: section.id %}

    Usage (cart — wrap with event listener): <div
    @quantity:change="$store.cart.change('{{ item.key }}', $event.detail.value, ['{{ section.id
    }}'])"> {% render 'quantity-selector', value: item.quantity, min: 1, max: max_qty %} </div>
{% enddoc %}

<div
    data-qty-value="{{ value | default: 1 }}"
    data-qty-min="{{ min | default: 1 }}"
    data-qty-max="{{ max | default: 'null' }}"
    data-qty-step="{{ step | default: 1 }}"
    {% if section_id %}
        data-qty-section-id="{{ section_id }}"
    {% endif %}
    data-qty-msg-max="{{ 'toast.max_quantity' | t: max: '%%MAX%%' | escape }}"
    data-qty-msg-min="{{ 'toast.min_quantity' | t: min: '%%MIN%%' | escape }}"
    data-qty-msg-below-min="{{ 'toast.quantity_below_min' | t: min: '%%MIN%%' | escape }}"
    data-qty-msg-above-max="{{ 'toast.quantity_above_max' | t: max: '%%MAX%%' | escape }}"
    x-data="QuantitySelector()"
    class="quantity-selector {{ wrapper_class }}"
>
    <button
        type="button"
        class="quantity-selector__button {{ button_class }}"
        aria-label="{{ 'accessibility.decrease_quantity' | t }}"
        @click="decrement()"
        :disabled="!canDecrement"
    >
        {%- render 'icons', icon: 'icon-minus' -%}
    </button>

    <input
        type="number"
        {% if input_id %}
            id="{{ input_id }}"
        {% endif %}
        name="{{ name | default: 'quantity' }}"
        class="quantity-selector__input {{ input_class }}"
        x-model.number="qty"
        :min="min"
        :max="max"
        :step="step"
        {% if product_form_id %}
            form="{{ product_form_id }}"
        {% endif %}
        @change="onInput()"
        aria-label="{{ label | default: 'accessibility.quantity' | t }}"
    >

    <button
        type="button"
        class="quantity-selector__button {{ button_class }}"
        aria-label="{{ 'accessibility.increase_quantity' | t }}"
        @click="increment()"
        :disabled="!canIncrement"
    >
        {%- render 'icons', icon: 'icon-plus' -%}
    </button>
</div>
