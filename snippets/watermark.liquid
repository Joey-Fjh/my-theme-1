{% doc %}
    Renders a decorative background watermark text.

  Accessible only for visual decoration and hidden from assistive technologies.

    @param {string} [text] - The watermark text to render. Defaults to brand name.
    @param {string} [container_class] - Optional additional classes for the outer container.
    @param {string} [text_class] - Optional additional classes for the text element.
    @param {string} [html_attr] - Optional raw HTML attributes to forward to the text element (for example, data-gsap-* attributes).

    @example
    {% render 'background-watermark',
    text: 'Eccenova®',
    container_class: 'section-watermark',
    text_class: 'section-watermark__text',
    html_attr: 'data-gsap-trigger'
  %}
{% enddoc %}

<div
    class="{{ container_class }}"
    aria-hidden="true"
    {% if html_attr != blank %}
        {{- html_attr -}}
    {% endif %}
>
    <span class="{{ text_class }}">
        {{ text | default: 'Eccenova®' }}
    </span>
</div>
