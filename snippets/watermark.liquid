{% doc %}
    Renders a decorative background watermark text.

    Accessible only for visual decoration and hidden from assistive technologies.

    @param {string} [text] - The watermark text to render. Defaults to brand name. SVG output flattens rich text and promotes bold or italic formatting to the complete text node.
    @param {string} [variant] - Render mode: 'svg' (default) or 'marquee'.
    @param {string} [container_class] - Optional additional classes for the outer container.
    @param {string} [svg_class] - Optional additional classes for the SVG element (svg variant).
    @param {string} [text_class] - Optional additional classes for the text element.
    @param {string} [html_attr] - Optional raw HTML attributes to forward to the outer container (for example, data-motion-reveal="media").
    @param {string} [svg_attr] - Optional raw HTML attributes to forward to the SVG element.
    @param {string} [text_attr] - Optional raw HTML attributes to forward to the SVG text element.
    @param {number} [font_size] - Base font size for watermark text in SVG units.
    @param {number} [baseline_y] - Baseline Y position for text in SVG units.
    @param {number} [text_length] - Width target used by textLength.
    @param {number} [view_box_width] - SVG viewBox width. Defaults to 1200.
    @param {number} [view_box_height] - SVG viewBox height. Defaults to 200.
    @param {string} [length_adjust] - SVG length adjust mode. Defaults to spacing.
    @param {string} [preserve_aspect_ratio] - SVG preserveAspectRatio value. Defaults to xMinYMid meet.
    @param {number} [repeat_count] - Marquee item count per loop half. Defaults to 8.
    @param {string} [marquee_direction] - Marquee scroll direction: 'right_to_left' (default) or 'left_to_right'.
    @param {boolean} [marquee_pause_on_hover] - Pause marquee animation on hover-capable devices. Defaults to true.
    @param {string} [marquee_speed] - Marquee scroll speed: 'slow', 'normal' (default), or 'fast'.
    @param {number} [marquee_gap] - Horizontal gap between repeated items in px (outputs --wm-gap). Defaults to 64.
    @param {number} [marquee_height] - Container band height in px (outputs --wm-height; font scales via CSS). Marquee variant only.

    @example
    {% render 'watermark',
        text: shop.name,
        container_class: 'section-watermark',
        text_class: 'section-watermark__text',
        html_attr: 'data-motion-reveal="media"'
    %}
    @example
    {% render 'watermark',
        variant: 'marquee',
        text: section.settings.brand_name,
        container_class: 'featured-products__brand-watermark'
    %}
{% enddoc %}
{%- liquid
    assign watermark_variant = variant | default: 'svg'
    assign watermark_text_plain = text | strip_html | strip

    if watermark_text_plain == blank
        assign watermark_text_source = shop.name
    else
        assign watermark_text_source = text
    endif

    assign watermark_text_plain = watermark_text_source | strip_html | strip

    if watermark_variant == 'marquee'
        assign watermark_text_markup = watermark_text_source
        assign watermark_text_markup = watermark_text_markup | replace: '<strong>', '[[WATERMARK_STRONG_OPEN]]'
        assign watermark_text_markup = watermark_text_markup | replace: '</strong>', '[[WATERMARK_STRONG_CLOSE]]'
        assign watermark_text_markup = watermark_text_markup | replace: '<b>', '[[WATERMARK_STRONG_OPEN]]'
        assign watermark_text_markup = watermark_text_markup | replace: '</b>', '[[WATERMARK_STRONG_CLOSE]]'
        assign watermark_text_markup = watermark_text_markup | replace: '<em>', '[[WATERMARK_EM_OPEN]]'
        assign watermark_text_markup = watermark_text_markup | replace: '</em>', '[[WATERMARK_EM_CLOSE]]'
        assign watermark_text_markup = watermark_text_markup | replace: '<i>', '[[WATERMARK_EM_OPEN]]'
        assign watermark_text_markup = watermark_text_markup | replace: '</i>', '[[WATERMARK_EM_CLOSE]]'
        assign watermark_text_markup = watermark_text_markup | strip_html | escape
        assign watermark_text_markup = watermark_text_markup | replace: '[[WATERMARK_STRONG_OPEN]]', '<span class="font-bold">'
        assign watermark_text_markup = watermark_text_markup | replace: '[[WATERMARK_STRONG_CLOSE]]', '</span>'
        assign watermark_text_markup = watermark_text_markup | replace: '[[WATERMARK_EM_OPEN]]', '<span class="italic">'
        assign watermark_text_markup = watermark_text_markup | replace: '[[WATERMARK_EM_CLOSE]]', '</span>'
        assign watermark_repeat_count = repeat_count | default: 8

        assign watermark_marquee_direction = marquee_direction | default: 'right_to_left'
        unless watermark_marquee_direction == 'right_to_left' or watermark_marquee_direction == 'left_to_right'
            assign watermark_marquee_direction = 'right_to_left'
        endunless

        assign watermark_marquee_pause_on_hover = true
        if marquee_pause_on_hover == false
            assign watermark_marquee_pause_on_hover = false
        endif

        if watermark_marquee_pause_on_hover
            assign watermark_marquee_pause_on_hover_attr = 'true'
        else
            assign watermark_marquee_pause_on_hover_attr = 'false'
        endif

        assign watermark_marquee_speed = marquee_speed | default: 'normal'
        unless watermark_marquee_speed == 'slow' or watermark_marquee_speed == 'normal' or watermark_marquee_speed == 'fast'
            assign watermark_marquee_speed = 'normal'
        endunless

        if marquee_gap == blank
            assign watermark_marquee_gap = 64
        else
            assign watermark_marquee_gap = marquee_gap
        endif

        assign watermark_marquee_style = ''
        if marquee_height != blank
            assign watermark_marquee_style = '--wm-height: ' | append: marquee_height | append: 'px;'
        endif
        if watermark_marquee_gap != blank
            assign watermark_marquee_style = watermark_marquee_style | append: ' --wm-gap: ' | append: watermark_marquee_gap | append: 'px;'
        endif
        assign watermark_marquee_style = watermark_marquee_style | strip
    else
        assign watermark_text_markup = watermark_text_plain | escape
        assign watermark_svg_font_weight = ''
        assign watermark_svg_font_style = ''

        if watermark_text_source contains '<strong>' or watermark_text_source contains '<b>'
            assign watermark_svg_font_weight = '700'
        endif
        if watermark_text_source contains '<em>' or watermark_text_source contains '<i>'
            assign watermark_svg_font_style = 'italic'
        endif

        assign watermark_view_box_width = view_box_width | default: 1200
        assign watermark_view_box_height = view_box_height | default: 200

        if font_size == blank
            assign watermark_font_size = watermark_view_box_height | times: 9 | divided_by: 10
        else
            assign watermark_font_size = font_size
        endif

        if baseline_y == blank
            assign watermark_baseline_y = watermark_view_box_height | times: 33 | divided_by: 40
        else
            assign watermark_baseline_y = baseline_y
        endif

        if text_length == blank
            assign watermark_text_length = watermark_view_box_width
        else
            assign watermark_text_length = text_length
        endif

        assign watermark_length_adjust = length_adjust | default: 'spacing'
        assign watermark_preserve_aspect_ratio = preserve_aspect_ratio | default: 'xMinYMid meet'
    endif
-%}

{%- if watermark_variant == 'marquee' -%}
    <div
        class="watermark-marquee {{ container_class }}"
        data-marquee-direction="{{ watermark_marquee_direction }}"
        data-marquee-pause-on-hover="{{ watermark_marquee_pause_on_hover_attr }}"
        data-marquee-speed="{{ watermark_marquee_speed }}"
        aria-hidden="true"
        {% if watermark_marquee_style != blank %}
            style="{{ watermark_marquee_style }}"
        {% endif %}
        {% if html_attr != blank %}
            {{- html_attr -}}
        {% endif %}
    >
        <div class="watermark-marquee__track">
            {%- for pass in (1..2) -%}
                {%- for i in (1..watermark_repeat_count) -%}
                    {%- assign watermark_phase = i | minus: 1 | modulo: 4 -%}
                    <span
                        class="watermark-marquee__item {{ text_class }}"
                        style="--wm-phase: {{ watermark_phase }};"
                    >
                        <span class="watermark-marquee__item-inner">
                            {{ watermark_text_markup }}
                        </span>
                    </span>
                {%- endfor -%}
            {%- endfor -%}
        </div>
    </div>
{%- else -%}
    <div
        class="{{ container_class }}"
        aria-hidden="true"
        {% if html_attr != blank %}
            {{- html_attr -}}
        {% endif %}
    >
        <svg
            class="block h-auto w-full {{ svg_class }}"
            viewBox="0 0 {{ watermark_view_box_width }} {{ watermark_view_box_height }}"
            preserveAspectRatio="{{ watermark_preserve_aspect_ratio }}"
            role="presentation"
            focusable="false"
            {% if svg_attr != blank %}
                {{- svg_attr -}}
            {% endif %}
        >
            <text
                x="0"
                y="{{ watermark_baseline_y }}"
                font-size="{{ watermark_font_size }}"
                textLength="{{ watermark_text_length }}"
                lengthAdjust="{{ watermark_length_adjust }}"
                {% if watermark_svg_font_weight != blank %}
                    font-weight="{{ watermark_svg_font_weight }}"
                {% endif %}
                {% if watermark_svg_font_style != blank %}
                    font-style="{{ watermark_svg_font_style }}"
                {% endif %}
                class="fill-current font-heading opacity-20 {{ text_class }}"
                {% if text_attr != blank %}
                    {{- text_attr -}}
                {% endif %}
            >
                {{ watermark_text_markup }}
            </text>
        </svg>
    </div>
{%- endif -%}
