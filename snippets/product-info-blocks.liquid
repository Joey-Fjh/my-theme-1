{% doc %}
    Renders product info blocks shared between featured-product (home) and product (PDP).

    @param {product} product - Product object (from section.settings.product or product)
    @param {section} section - Section object (for blocks and id)
    @param {string} [context] - Rendering context, e.g. 'main' (PDP) or 'featured' (home)
    @param {string} [container_class] - Optional extra classes for the root container (merged with defaults)
    @param {string} [product_form_id] - Shared form ID for variant picker, quantity, and buy buttons
{% enddoc %}

{%- assign product = product | default: section.settings.product -%}
{%- assign context = context | default: 'main' -%}
{%- assign container_class = container_class | default: '' -%}
{%- assign product_form_id = product_form_id | default: 'product-form-' | append: section.id -%}
{%- assign context_modifier = 'product-info-blocks--' | append: context -%}

<div
    class="product-info-blocks {{ context_modifier }} {{ container_class }}"
    id="ProductInfo-{{ section.id }}"
>
    {%- for block in section.blocks -%}
        {%- case block.type -%}
            {%- when '@app' -%}
                <div {{ block.shopify_attributes }}>
                    {%- render block -%}
                </div>

            {%- when 'title' -%}
                <div {{ block.shopify_attributes }}>
                    {%- if product != blank -%}
                        {%- if context == 'main' -%}
                            <h1 class="product-info-blocks__title">
                                {{ product.title }}
                            </h1>
                        {%- else -%}
                            <h2 class="product-info-blocks__title">
                                {{ product.title }}
                            </h2>
                        {%- endif -%}
                    {%- else -%}
                        <h2 class="product-info-blocks__title">Example Product Title</h2>
                    {%- endif -%}
                </div>

            {%- when 'price' -%}
                <div {{ block.shopify_attributes }}>
                    {%- if product != blank -%}
                        {%- assign current_variant = product.selected_or_first_available_variant -%}
                        <div
                            class="product-info-blocks__price"
                            x-data="
                                ProductPrice({
                                  sectionId: '{{ section.id }}',
                                  price: {{ current_variant.price | default: 0 }},
                                  comparePrice: {{ current_variant.compare_at_price | default: 0 }},
                                  currency: '{{ shop.currency }}'
                                })
                            "
                        >
                            <span
                                class="product-info-blocks__price-main h4"
                                x-text="formattedPrice"
                            >
                                {{- current_variant.price | money -}}
                            </span>
                            <s
                                class="product-info-blocks__price-compare"
                                x-show="hasComparePrice"
                                x-text="formattedComparePrice"
                            >
                                {%- if current_variant.compare_at_price > current_variant.price -%}
                                    {{- current_variant.compare_at_price | money -}}
                                {%- endif -%}
                            </s>
                        </div>
                    {%- else -%}
                        <p class="product-info-blocks__price-main h4">$99.00</p>
                    {%- endif -%}
                </div>

            {%- when 'description' -%}
                <div {{ block.shopify_attributes }}>
                    {%- if product != blank and product.description != blank -%}
                        <div class="product-info-blocks__description body-md">
                            {%- if context == 'featured' -%}
                                {{ product.description | strip_html | truncate: 150 }}
                            {%- else -%}
                                {{ product.description }}
                            {%- endif -%}
                        </div>
                    {%- else -%}
                        <div class="product-info-blocks__description body-md">
                            Discover our innovative skincare serum pack, infused with advanced AI
                            insights to tailor your beauty routine. Each serum is designed to meet
                            your unique skin needs, ensuring a personalized experience that enhances
                            your natural glow.
                        </div>
                    {%- endif -%}
                </div>

            {%- when 'variant_picker' -%}
                {%- render 'product-variant-picker',
                    product: product,
                    block: block,
                    product_form_id: product_form_id,
                    context: context
                -%}

            {%- when 'quantity_selector' -%}
                <div {{ block.shopify_attributes }}>
                    {%- liquid
                        assign quantity_wrapper_class = 'flex items-center border border-theme-border-soft rounded-sm w-max'
                        assign quantity_button_class = 'flex h-10 w-10 cursor-pointer items-center justify-center text-current transition-opacity hover:opacity-70 disabled:cursor-not-allowed disabled:opacity-30'
                        assign quantity_input_class = 'w-[4ch] appearance-none border-b border-current bg-transparent p-0 text-center h6 font-medium text-current [-moz-appearance:textfield] focus:ring-0 focus:outline-none [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none'

                        if context == 'product'
                            assign quantity_wrapper_class = 'inline-flex items-center gap-3 w-max text-theme-text'
                            assign quantity_button_class = 'flex h-8 w-8 cursor-pointer items-center justify-center text-current transition-opacity hover:opacity-70 disabled:cursor-not-allowed disabled:opacity-30'
                            assign quantity_input_class = 'w-[3ch] appearance-none border-b border-current bg-transparent p-0 text-center body-md text-current [-moz-appearance:textfield] focus:ring-0 focus:outline-none [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none'
                        endif
                    -%}
                    {%- render 'quantity-selector',
                        value: 1,
                        min: 1,
                        product_form_id: product_form_id,
                        section_id: section.id,
                        wrapper_class: quantity_wrapper_class,
                        button_class: quantity_button_class,
                        input_class: quantity_input_class
                    -%}
                </div>

            {%- when 'buy_buttons' -%}
                <div class="buy-buttons-block product-info-blocks__buy-buttons">
                    {%- render 'buy-buttons',
                        product: product,
                        block: block,
                        product_form_id: product_form_id,
                        section_id: section.id,
                        context: context
                    -%}
                </div>

            {%- when 'inventory_status' -%}
                <div
                    class="inventory-status-placeholder product-info-blocks__inventory h6"
                    {{ block.shopify_attributes }}
                >
                    Inventory Status: In Stock
                </div>

            {%- else -%}
                <div {{ block.shopify_attributes }}>
                    {%- render block -%}
                </div>
        {%- endcase -%}
    {%- endfor -%}
</div>
