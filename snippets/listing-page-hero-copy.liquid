{% doc %}
    Listing page hero copy with shared header and description fallback resolution.

    Resolution order for the heading:
    1. native Shopify object title (collection.title / blog.title)
    2. section setting header

    Description uses the native Shopify object description when available, then the section
    setting. Neither falls back to locale copy (defaults live in the schema).

    @param {string} setting_header - Section header setting value.
    @param {string} object_title - Native title from the listing Shopify object.
    @param {string} header_locale_key - Legacy locale key passed by listing sections (defaults live in schema).
    @param {string} setting_description - Section description setting (HTML).
    @param {string} [object_description] - Native description from the listing Shopify object.
    @param {string} description_locale_key - Legacy locale key passed by listing sections (defaults live in schema).
    @param {string} [heading_class] - Optional heading tier class for the page title.
    @param {string} [description_class] - Optional body tier class for the description wrapper.
{% enddoc %}

{%- liquid
    assign _listing_hero_locale_keys = header_locale_key | append: description_locale_key
    assign resolved_heading = object_title
    if resolved_heading == blank
        assign resolved_heading = setting_header
    endif

    assign resolved_description = object_description
    if resolved_description == blank
        assign resolved_description = setting_description
    endif
    assign hero_heading_class = heading_class | default: 'title-l'
    assign hero_description_class = 'typo-subtitle'
    if description_class != blank
        assign hero_description_class = hero_description_class | append: ' ' | append: description_class
    endif
-%}

{%- if setting_header != blank and object_title != blank and setting_header != object_title -%}
    <p class="mb-step-xs typo-subtitle">
        {{ setting_header }}
    </p>
{%- endif -%}

{%- if resolved_heading != blank -%}
    <h1 class="mb-step-xl {{ hero_heading_class }}">
        {{ resolved_heading }}
    </h1>
{%- endif -%}
{%- if resolved_description != blank -%}
    {%- render 'rte-compact-prose',
        content: resolved_description,
        content_class: hero_description_class
    -%}
{%- endif -%}
