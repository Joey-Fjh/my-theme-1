{% doc %}
    Listing page hero copy with shared header and description fallback resolution.

    Resolution order for the heading:
    1. section setting header
    2. native Shopify object title (collection.title / blog.title)
    3. locale fallback key

    Description uses section setting with locale HTML fallback.

    @param {string} setting_header - Section header setting value.
    @param {string} object_title - Native title from the listing Shopify object.
    @param {string} header_locale_key - Translation key when header and object title are blank.
    @param {string} setting_description - Section description setting (HTML).
    @param {string} description_locale_key - Translation key for description HTML fallback.
    @param {string} [heading_class] - Optional heading tier class for the page title.
    @param {string} [description_class] - Optional body tier class for the description wrapper.
{% enddoc %}

{%- liquid
    assign resolved_heading = setting_header
    if resolved_heading == blank
        assign resolved_heading = object_title
    endif
    if resolved_heading == blank
        assign resolved_heading = header_locale_key | t
    endif

    assign description_fallback = description_locale_key | t
    assign resolved_description = setting_description | default: description_fallback
    assign hero_heading_class = heading_class | default: 'heading-4xl'
-%}

<h1 class="mb-10 {{ hero_heading_class }}">
    {{ resolved_heading }}
</h1>
<div class="rte rte--compact max-w-3xl{% if description_class != blank %} {{ description_class }}{% endif %}">
    {{ resolved_description }}
</div>
