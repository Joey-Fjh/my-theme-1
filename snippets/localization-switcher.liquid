{% doc %}
    Shared Alpine shell and localization form wrapper for language/country pickers.

    @param {string} localPosition - Form id and unique suffix for related controls.
    @param {string} content - Toggle button and menu markup (pass via capture in parent).

    @example
    {%- capture localization_content -%}
        ...
    {%- endcapture -%}
    {%- render 'localization-switcher',
        localPosition: localPosition,
        content: localization_content
    -%}
{% enddoc %}

<div
    x-data="localizationSwitcher"
    @click.away="close()"
    @keydown.escape.window="if (open) { close(); $nextTick(() => $refs.localizationTrigger?.focus()) }"
    class="localization-switcher"
>
    {% form 'localization', id: localPosition %}
        {{ content }}
    {% endform %}
</div>
