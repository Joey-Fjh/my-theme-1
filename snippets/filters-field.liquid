{% doc %}
    Shared single-filter field renderer for drawer/inline variants.

    @param {object} filter - Required. One filter item from `filter_host.filters`.
    @param {string} [mode] - Optional. 'horizontal' | 'vertical' | 'drawer'. Default: 'horizontal'.
    @param {string} [ui_variant] - Optional. 'popover' | 'panel'. Default: popover for horizontal, panel otherwise.
    @param {string} [filter_index] - Optional index used by horizontal Alpine toggle state.
    @param {boolean} [is_first] - Optional. Adds left offset class to the first horizontal item.
    @param {string} [divider_class] - Optional divider class token.
    @param {string} [muted_text_class] - Optional helper text classes.
    @param {string} [filter_label_class] - Optional label text classes.
    @param {string} [count_text_class] - Optional count text classes.
    @param {number} [show_more_limit] - Optional visible item count before progressive expansion. Default: 6.
    @param {number} [show_more_step] - Optional items added per click. Default: show_more_limit.
{% enddoc %}

{%- assign render_mode = mode | default: 'horizontal' -%}
{%- assign field_index = filter_index | default: 0 -%}
{%- assign field_is_first = is_first | default: false -%}
{%- assign effective_ui_variant = ui_variant -%}

{%- if effective_ui_variant == blank -%}
    {%- if render_mode == 'horizontal' -%}
        {%- assign effective_ui_variant = 'panel' -%}
    {%- else -%}
        {%- assign effective_ui_variant = 'panel' -%}
    {%- endif -%}
{%- endif -%}

{%- assign divider_class = divider_class | default: 'border-theme-border-20' -%}
{%- assign muted_text_class = muted_text_class | default: 'body-lg' -%}
{%- assign filter_label_class = filter_label_class | default: 'body-lg' -%}
{%- assign count_text_class = count_text_class | default: 'body-lg' -%}
{%- assign show_more_limit = show_more_limit | default: 6 -%}
{%- assign show_more_step = show_more_step | default: show_more_limit -%}
{%- assign active_filter_count = filter.active_values.size -%}
{%- if filter.type == 'price_range' -%}
    {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
        {%- assign active_filter_count = 1 -%}
    {%- endif -%}
{%- endif -%}

{%- capture field_content -%}
    {%- case filter.type -%}
        {%- when 'boolean', 'list' -%}
            {%- assign active_values = filter.values | where: 'active', true -%}
            {%- assign inactive_values = filter.values | where: 'active', false -%}
            {%- assign sorted_values = active_values | concat: inactive_values -%}

            {%- if effective_ui_variant == 'panel' -%}
                <div
                    x-data="progressiveList()"
                    data-visible-count="{{ show_more_limit }}"
                    data-step-count="{{ show_more_step }}"
                    class="flex flex-col gap-3 pt-1"
                >
                    {%- for value in sorted_values -%}
                        {%- assign is_disabled = false -%}
                        {%- if value.count == 0 and value.active == false -%}
                            {%- assign is_disabled = true -%}
                        {%- endif -%}

                        <label
                            x-show="isVisible({{ forloop.index0 }})"
                            class="flex items-center gap-3 {% if is_disabled %}cursor-not-allowed opacity-50{% endif %}"
                            :class="{ 'hidden': !isVisible({{ forloop.index0 }}) }"
                            {% if is_disabled %}
                                aria-disabled="true"
                            {% endif %}
                        >
                            <input
                                type="checkbox"
                                class="filter-checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                form="CollectionFiltersForm"
                                {% if value.active %}checked{% endif %}
                                {% if is_disabled %}disabled{% endif %}
                                @change="onChange()"
                            >
                            <span class="{{ filter_label_class }}">
                                {{ value.label }}
                            </span>
                            <span class="ml-auto {{ count_text_class }}">
                                ({{ value.count | default: 0 }})
                            </span>
                        </label>
                    {%- endfor -%}

                    {%- if sorted_values.size > show_more_limit -%}
                        <button
                            type="button"
                            @click.stop="canShowMore({{ sorted_values.size }}) ? showMore({{ sorted_values.size }}) : showLess()"
                            class="inline-flex cursor-pointer items-center gap-3 pt-1 transition-opacity hover:opacity-80"
                        >
                            {% render 'show-more-icon' %}
                            <span x-text="canShowMore({{ sorted_values.size }}) ? '{{ 'collections.filters.show_more' | t }}' : '{{ 'collections.filters.show_less' | t }}'"></span>
                        </button>
                    {%- endif -%}
                </div>
            {%- else -%}
                <div
                    x-data="progressiveList()"
                    data-visible-count="{{ show_more_limit }}"
                    data-step-count="{{ show_more_step }}"
                    class="flex flex-col gap-2"
                >
                    {%- for value in sorted_values -%}
                        {%- assign is_disabled = false -%}
                        {%- if value.count == 0 and value.active == false -%}
                            {%- assign is_disabled = true -%}
                        {%- endif -%}

                        <label
                            x-show="isVisible({{ forloop.index0 }})"
                            class="flex items-center gap-2"
                            :class="{ 'hidden': !isVisible({{ forloop.index0 }}) }"
                            {% if is_disabled %}
                                aria-disabled="true"
                            {% endif %}
                        >
                            <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                form="CollectionFiltersForm"
                                {% if value.active %}checked{% endif %}
                                {% if is_disabled %}disabled{% endif %}
                                @change="onChange()"
                                class="filter-checkbox"
                            >
                            <span>
                                {{ value.label }}
                            </span>
                            <span>
                                ({{ value.count | default: 0 }})
                            </span>
                        </label>
                    {%- endfor -%}

                    {%- if sorted_values.size > show_more_limit -%}
                        <button
                            type="button"
                            @click.stop="canShowMore({{ sorted_values.size }}) ? showMore({{ sorted_values.size }}) : showLess()"
                            class="inline-flex cursor-pointer items-center gap-3 pt-2 transition-opacity hover:opacity-80"
                        >
                            {% render 'show-more-icon' %}
                            <span x-text="canShowMore({{ sorted_values.size }}) ? '{{ 'collections.filters.show_more' | t }}' : '{{ 'collections.filters.show_less' | t }}'"></span>
                        </button>
                    {%- endif -%}
                </div>
            {%- endif -%}

        {%- when 'price_range' -%}
            {%- assign range_max = filter.range_max | money_without_currency | plus: 0 -%}

            {%- if effective_ui_variant == 'panel' -%}
                {%- assign current_min = filter.min_value.value | default: 0 | plus: 0 -%}
                {%- assign current_max = filter.max_value.value | default: range_max | plus: 0 -%}

                <div
                    class="flex flex-col gap-3 pt-1"
                    data-filter-min="{{ current_min }}"
                    data-filter-max="{{ current_max }}"
                    data-filter-ceil="{{ range_max }}"
                    x-data="collectionFilterField()"
                >
                    <div
                        class="relative flex h-8 w-full items-center transition-opacity"
                        :class="{ 'opacity-50 cursor-not-allowed': isLoading }"
                    >
                        <div class="absolute inset-x-0 h-px rounded-full bg-theme-border"></div>
                        <div
                            class="absolute h-px rounded-full bg-theme-text"
                            :style="`left:${minPct()}%;right:${maxPct()}%`"
                        ></div>
                        <input
                            type="range"
                            min="0"
                            :max="ceil"
                            x-model.number="min"
                            @input="clampMin()"
                            @change.debounce.500ms="$refs.inputMin.value = min; onChange()"
                            :disabled="isLoading"
                            :class="(min === max && max === ceil) ? 'z-30' : 'z-10'"
                            class="price-range-thumb pointer-events-none absolute inset-x-0 w-full appearance-none bg-transparent"
                        >
                        <input
                            type="range"
                            min="0"
                            :max="ceil"
                            x-model.number="max"
                            @input="clampMax()"
                            @change.debounce.500ms="$refs.inputMax.value = max; onChange()"
                            :disabled="isLoading"
                            :class="(min === max && min === 0) ? 'z-30' : 'z-20'"
                            class="price-range-thumb pointer-events-none absolute inset-x-0 w-full appearance-none bg-transparent"
                        >
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="mb-1 block {{ muted_text_class }}" for="Filter-{{ filter.label | handleize }}-GTE">{{ 'collections.filters.from' | t }}</label>
                            <div class="flex items-center border-b {{ divider_class }} bg-theme-border-20 px-3 py-2">
                                <span class="mr-1">$</span>
                                <input
                                    x-ref="inputMin"
                                    id="Filter-{{ filter.label | handleize }}-GTE"
                                    type="number"
                                    name="{{ filter.min_value.param_name }}"
                                    :value="min"
                                    min="0"
                                    max="{{ range_max }}"
                                    placeholder="0"
                                    form="CollectionFiltersForm"
                                    @input.debounce.500ms="setMinFromInput($el.value); $el.value = min; onChange()"
                                    :disabled="isLoading"
                                    :class="{ 'cursor-not-allowed opacity-80': isLoading }"
                                    class="w-full appearance-none bg-transparent outline-none [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
                                >
                            </div>
                        </div>
                        <div>
                            <label class="mb-1 block {{ muted_text_class }}" for="Filter-{{ filter.label | handleize }}-LTE">{{ 'collections.filters.to' | t }}</label>
                            <div class="flex items-center border-b {{ divider_class }} bg-theme-border-20 px-3 py-2">
                                <span class="mr-1">$</span>
                                <input
                                    x-ref="inputMax"
                                    id="Filter-{{ filter.label | handleize }}-LTE"
                                    type="number"
                                    name="{{ filter.max_value.param_name }}"
                                    :value="max"
                                    min="0"
                                    max="{{ range_max }}"
                                    placeholder="{{ range_max }}"
                                    form="CollectionFiltersForm"
                                    @input.debounce.500ms="setMaxFromInput($el.value); $el.value = max; onChange()"
                                    :disabled="isLoading"
                                    :class="{ 'cursor-not-allowed opacity-80': isLoading }"
                                    class="w-full appearance-none bg-transparent outline-none [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
                                >
                            </div>
                        </div>
                    </div>
                </div>
            {%- else -%}
                <div class="grid grid-cols-2 gap-3">
                    <label class="flex flex-col gap-1">
                        <span>{{ 'collections.filters.min' | t }}</span>
                        <input
                            type="number"
                            name="{{ filter.min_value.param_name }}"
                            value="{{ filter.min_value.value | default: '' }}"
                            min="0"
                            max="{{ range_max }}"
                            placeholder="0"
                            form="CollectionFiltersForm"
                            @change="onChange()"
                            class="field"
                        >
                    </label>
                    <label class="flex flex-col gap-1">
                        <span>{{ 'collections.filters.max' | t }}</span>
                        <input
                            type="number"
                            name="{{ filter.max_value.param_name }}"
                            value="{{ filter.max_value.value | default: '' }}"
                            min="0"
                            max="{{ range_max }}"
                            placeholder="{{ range_max }}"
                            form="CollectionFiltersForm"
                            @change="onChange()"
                            class="field"
                        >
                    </label>
                </div>
            {%- endif -%}
    {%- endcase -%}
{%- endcapture -%}

{%- if render_mode == 'drawer' -%}
    {{ field_content }}
{%- else -%}
    <details
        {% if render_mode == 'horizontal' %}
            :open="activeFilter === '{{ field_index }}'"
            @toggle="
                if ($el.open) {
                    activeFilter = '{{ field_index }}';
                } else if (activeFilter === '{{ field_index }}') {
                    activeFilter = null;
                }
            "
            @click.outside="activeFilter = null"
        {% endif %}
        class="group {% if render_mode == 'horizontal' %}relative{% endif %}"
    >
        <summary
            class="
                flex cursor-pointer list-none items-center gap-3 marker:content-none
                {% if render_mode == 'horizontal' %}
                    w-fit min-w-0 justify-between rounded-full border border-theme-border-20 bg-theme-bg px-5 py-3 transition-colors duration-300 hover:border-theme-text group-open:border-theme-text
                {% else %}
                    h2
                {% endif %}
            "
        >
            <span class="inline-flex items-center gap-3">
                <span>{{ filter.label }}</span>
                {%- if render_mode == 'horizontal' and active_filter_count > 0 -%}
                    <span class="inline-flex h-8 min-w-8 items-center justify-center rounded-full bg-theme-text px-2">
                        {{ active_filter_count }}
                    </span>
                {%- endif -%}
            </span>
            {% render 'icons',
                icon: 'icon-arrow',
                class: 'transition-transform group-open:rotate-180'
            %}
        </summary>

        <div
            class="
                mt-3
                {% if render_mode == 'horizontal' %}
                    absolute top-full left-0 z-20 rounded-lg border border-theme-border-20 bg-theme-bg p-5
                    {% if filter.type == 'price_range' %}
                        min-w-[24rem] pc:max-w-[36rem]
                    {% else %}
                        min-w-[24rem]
                    {% endif %}
                {% else %}
                    rounded-lg border border-theme-border-20 p-4
                {% endif %}
            "
        >
            {{ field_content }}
        </div>
    </details>
{%- endif -%}
