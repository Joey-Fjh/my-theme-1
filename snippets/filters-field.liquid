{% doc %}
    Shared single-filter field renderer for drawer/inline variants.

    @param {object} filter - Required. One filter item from `filter_host.filters`.
    @param {string} [mode] - Optional. 'horizontal' | 'vertical' | 'drawer'. Default: 'horizontal'.
    @param {string} [ui_variant] - Optional. 'popover' | 'panel'. Default: popover for horizontal, panel otherwise.
    @param {string} [filter_index] - Optional index used by horizontal Alpine toggle state.
    @param {string} [scope_id] - Optional unique scope used to generate form control IDs.
    @param {string} [form_id] - Optional external form id for filter controls. Default: CollectionFiltersForm.
    @param {boolean} [is_first] - Optional. Adds left offset class to the first horizontal item.
    @param {string} [divider_class] - Optional divider class token.
    @param {string} [muted_text_class] - Optional helper text classes.
    @param {string} [filter_label_class] - Optional label text classes.
    @param {string} [count_text_class] - Optional count text classes.
    @param {number} [show_more_limit] - Optional visible item count before progressive expansion. Default: 6.
    @param {number} [show_more_step] - Optional items added per click. Default: show_more_limit.
{% enddoc %}

{%- assign render_mode = mode | default: 'horizontal' -%}
{%- assign field_index = filter_index | default: 0 -%}
{%- assign field_scope_id = scope_id | default: render_mode -%}
{%- assign filters_form_id = form_id | default: 'CollectionFiltersForm' -%}
{%- assign field_is_first = is_first | default: false -%}
{%- assign effective_ui_variant = ui_variant -%}

{%- if effective_ui_variant == blank -%}
    {%- if render_mode == 'horizontal' -%}
        {%- assign effective_ui_variant = 'panel' -%}
    {%- else -%}
        {%- assign effective_ui_variant = 'panel' -%}
    {%- endif -%}
{%- endif -%}

{%- assign divider_class = divider_class | default: 'border-theme-border/20' -%}
{%- assign muted_text_class = muted_text_class | default: 'body-lg' -%}
{%- assign filter_label_class = filter_label_class | default: 'body-lg' -%}
{%- assign count_text_class = count_text_class | default: 'body-lg' -%}
{%- assign show_more_limit = show_more_limit | default: 6 -%}
{%- assign show_more_step = show_more_step | default: show_more_limit -%}
{%- assign active_filter_count = filter.active_values.size -%}
{%- if filter.type == 'price_range' -%}
    {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
        {%- assign active_filter_count = 1 -%}
    {%- endif -%}
{%- endif -%}

{%- capture field_content -%}
    {%- case filter.type -%}
        {%- when 'boolean', 'list' -%}
            {%- assign active_values = filter.values | where: 'active', true -%}
            {%- assign inactive_values = filter.values | where: 'active', false -%}
            {%- assign sorted_values = active_values | concat: inactive_values -%}

            {%- if effective_ui_variant == 'panel' -%}
                <div
                    x-data="progressiveList()"
                    data-visible-count="{{ show_more_limit }}"
                    data-step-count="{{ show_more_step }}"
                    class="flex flex-col gap-3 pt-1"
                >
                    {%- for value in sorted_values -%}
                        {%- assign is_disabled = false -%}
                        {%- if value.count == 0 and value.active == false -%}
                            {%- assign is_disabled = true -%}
                        {%- endif -%}
                        {%- capture option_id -%}Filter-{{ field_scope_id }}-{{ field_index }}-{{ forloop.index0 }}{%- endcapture -%}

                        <label
                            for="{{ option_id }}"
                            x-show="isVisible({{ forloop.index0 }})"
                            class="flex items-center gap-3 {% if is_disabled %}filters-field__option--disabled{% endif %}"
                            :class="{ 'hidden': !isVisible({{ forloop.index0 }}) }"
                            {% if is_disabled %}
                                aria-disabled="true"
                            {% endif %}
                        >
                            <input
                                id="{{ option_id }}"
                                type="checkbox"
                                class="filter-checkbox focus-ring focus-visible:relative focus-visible:z-1"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                form="{{ filters_form_id }}"
                                {% if value.active %}checked{% endif %}
                                {% if is_disabled %}disabled{% endif %}
                                @change="onChange($event)"
                            >
                            <span class="{{ filter_label_class }}">
                                {{ value.label }}
                            </span>
                            <span class="ms-auto {{ count_text_class }}">
                                ({{ value.count | default: 0 }})
                            </span>
                        </label>
                    {%- endfor -%}

                    {%- if sorted_values.size > show_more_limit -%}
                        <button
                            type="button"
                            @click.stop="canShowMore({{ sorted_values.size }}) ? showMore({{ sorted_values.size }}) : showLess()"
                            data-show-more-label="{{ 'collections.filters.show_more' | t | escape }}"
                            data-show-less-label="{{ 'collections.filters.show_less' | t | escape }}"
                            class="filters-field__show-more filters-field__show-more--panel"
                        >
                            {% render 'show-more-icon' %}
                            <span x-text="canShowMore({{ sorted_values.size }}) ? $el.parentElement.dataset.showMoreLabel : $el.parentElement.dataset.showLessLabel"></span>
                        </button>
                    {%- endif -%}
                </div>
            {%- else -%}
                <div
                    x-data="progressiveList()"
                    data-visible-count="{{ show_more_limit }}"
                    data-step-count="{{ show_more_step }}"
                    class="flex flex-col gap-2"
                >
                    {%- for value in sorted_values -%}
                        {%- assign is_disabled = false -%}
                        {%- if value.count == 0 and value.active == false -%}
                            {%- assign is_disabled = true -%}
                        {%- endif -%}
                        {%- capture option_id -%}Filter-{{ field_scope_id }}-{{ field_index }}-{{ forloop.index0 }}{%- endcapture -%}

                        <label
                            for="{{ option_id }}"
                            x-show="isVisible({{ forloop.index0 }})"
                            class="flex items-center gap-2"
                            :class="{ 'hidden': !isVisible({{ forloop.index0 }}) }"
                            {% if is_disabled %}
                                aria-disabled="true"
                            {% endif %}
                        >
                            <input
                                id="{{ option_id }}"
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                form="{{ filters_form_id }}"
                                {% if value.active %}checked{% endif %}
                                {% if is_disabled %}disabled{% endif %}
                                @change="onChange($event)"
                                class="filter-checkbox focus-ring focus-visible:relative focus-visible:z-1"
                            >
                            <span>
                                {{ value.label }}
                            </span>
                            <span>
                                ({{ value.count | default: 0 }})
                            </span>
                        </label>
                    {%- endfor -%}

                    {%- if sorted_values.size > show_more_limit -%}
                        <button
                            type="button"
                            @click.stop="canShowMore({{ sorted_values.size }}) ? showMore({{ sorted_values.size }}) : showLess()"
                            data-show-more-label="{{ 'collections.filters.show_more' | t | escape }}"
                            data-show-less-label="{{ 'collections.filters.show_less' | t | escape }}"
                            class="filters-field__show-more filters-field__show-more--horizontal"
                        >
                            {% render 'show-more-icon' %}
                            <span x-text="canShowMore({{ sorted_values.size }}) ? $el.parentElement.dataset.showMoreLabel : $el.parentElement.dataset.showLessLabel"></span>
                        </button>
                    {%- endif -%}
                </div>
            {%- endif -%}

        {%- when 'price_range' -%}
            {%- assign range_max = filter.range_max | money_without_currency | plus: 0 -%}

            {%- if effective_ui_variant == 'panel' -%}
                {%- assign current_min = filter.min_value.value | default: 0 | plus: 0 -%}
                {%- assign current_max = filter.max_value.value | default: range_max | plus: 0 -%}
                {%- capture range_min_id -%}Filter-{{ field_scope_id }}-{{ field_index }}-Range-GTE{%- endcapture -%}
                {%- capture range_max_id -%}Filter-{{ field_scope_id }}-{{ field_index }}-Range-LTE{%- endcapture -%}
                {%- capture number_min_id -%}Filter-{{ field_scope_id }}-{{ field_index }}-GTE{%- endcapture -%}
                {%- capture number_max_id -%}Filter-{{ field_scope_id }}-{{ field_index }}-LTE{%- endcapture -%}

                <div
                    class="flex flex-col gap-3 pt-1"
                    data-filter-min="{{ current_min }}"
                    data-filter-max="{{ current_max }}"
                    data-filter-ceil="{{ range_max }}"
                    x-data="collectionFilterField()"
                >
                    <div
                        class="filters-field__range-wrapper"
                        :class="{ 'is-loading': isLoading }"
                    >
                        <div class="absolute inset-x-0 h-px rounded-full bg-theme-border"></div>
                        <div
                            class="absolute h-px rounded-full bg-theme-text"
                            :style="`left:${minPct()}%;right:${maxPct()}%`"
                        ></div>
                        <label class="sr-only" for="{{ range_min_id }}">
                            {{ 'collections.filters.min' | t }}
                        </label>
                        <input
                            id="{{ range_min_id }}"
                            type="range"
                            min="0"
                            :max="ceil"
                            x-model.number="min"
                            @input="clampMin()"
                            @change.debounce.500ms="$refs.inputMin.value = min; onChange($refs.inputMin)"
                            :disabled="isLoading"
                            :class="(min === max && max === ceil) ? 'z-30' : 'z-10'"
                            class="price-range-thumb pointer-events-none absolute inset-x-0 w-full appearance-none bg-transparent"
                        >
                        <label class="sr-only" for="{{ range_max_id }}">
                            {{ 'collections.filters.max' | t }}
                        </label>
                        <input
                            id="{{ range_max_id }}"
                            type="range"
                            min="0"
                            :max="ceil"
                            x-model.number="max"
                            @input="clampMax()"
                            @change.debounce.500ms="$refs.inputMax.value = max; onChange($refs.inputMax)"
                            :disabled="isLoading"
                            :class="(min === max && min === 0) ? 'z-30' : 'z-20'"
                            class="price-range-thumb pointer-events-none absolute inset-x-0 w-full appearance-none bg-transparent"
                        >
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="mb-1 block {{ muted_text_class }}" for="{{ number_min_id }}">{{ 'collections.filters.from' | t }}</label>
                            <div class="filters-field__range-input-wrapper {{ divider_class }}" :class="{ 'is-loading': isLoading }">
                                <span class="me-1">$</span>
                                <input
                                    x-ref="inputMin"
                                    id="{{ number_min_id }}"
                                    type="number"
                                    name="{{ filter.min_value.param_name }}"
                                    :value="min"
                                    min="0"
                                    max="{{ range_max }}"
                                    placeholder="0"
                                    form="{{ filters_form_id }}"
                                    @input.debounce.500ms="setMinFromInput($el.value); $el.value = min; onChange($el)"
                                    :disabled="isLoading"
                                    class="w-full appearance-none bg-transparent focus-ring outline-none [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
                                >
                            </div>
                        </div>
                        <div>
                            <label class="mb-1 block {{ muted_text_class }}" for="{{ number_max_id }}">{{ 'collections.filters.to' | t }}</label>
                            <div class="filters-field__range-input-wrapper {{ divider_class }}" :class="{ 'is-loading': isLoading }">
                                <span class="me-1">$</span>
                                <input
                                    x-ref="inputMax"
                                    id="{{ number_max_id }}"
                                    type="number"
                                    name="{{ filter.max_value.param_name }}"
                                    :value="max"
                                    min="0"
                                    max="{{ range_max }}"
                                    placeholder="{{ range_max }}"
                                    form="{{ filters_form_id }}"
                                    @input.debounce.500ms="setMaxFromInput($el.value); $el.value = max; onChange($el)"
                                    :disabled="isLoading"
                                    class="w-full appearance-none bg-transparent focus-ring outline-none [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
                                >
                            </div>
                        </div>
                    </div>
                </div>
            {%- else -%}
                {%- capture fallback_min_id -%}Filter-{{ field_scope_id }}-{{ field_index }}-Fallback-GTE{%- endcapture -%}
                {%- capture fallback_max_id -%}Filter-{{ field_scope_id }}-{{ field_index }}-Fallback-LTE{%- endcapture -%}
                <div class="grid grid-cols-2 gap-3">
                    <label class="flex flex-col gap-1" for="{{ fallback_min_id }}">
                        <span>{{ 'collections.filters.min' | t }}</span>
                        <input
                            id="{{ fallback_min_id }}"
                            type="number"
                            name="{{ filter.min_value.param_name }}"
                            value="{{ filter.min_value.value | default: '' }}"
                            min="0"
                            max="{{ range_max }}"
                            placeholder="0"
                            form="{{ filters_form_id }}"
                            @change="onChange($event)"
                            class="field"
                        >
                    </label>
                    <label class="flex flex-col gap-1" for="{{ fallback_max_id }}">
                        <span>{{ 'collections.filters.max' | t }}</span>
                        <input
                            id="{{ fallback_max_id }}"
                            type="number"
                            name="{{ filter.max_value.param_name }}"
                            value="{{ filter.max_value.value | default: '' }}"
                            min="0"
                            max="{{ range_max }}"
                            placeholder="{{ range_max }}"
                            form="{{ filters_form_id }}"
                            @change="onChange($event)"
                            class="field"
                        >
                    </label>
                </div>
            {%- endif -%}
    {%- endcase -%}
{%- endcapture -%}

{%- if render_mode == 'drawer' -%}
    {{ field_content }}
{%- else -%}
    <details
        {% if render_mode == 'horizontal' %}
            data-filter-dropdown
            @click.outside="
                activeFilter = null;
                $el.open = false;
            "
        {% endif %}
        class="group {% if render_mode == 'horizontal' %}relative{% endif %}"
    >
        <summary
            data-field-index="{{ field_index }}"
            class="
                filters-field__summary
                {% if render_mode == 'horizontal' %}
                    w-fit min-w-0 justify-between rounded-full border border-theme-border/20 bg-theme-bg px-5 py-3
                {% else %}
                    h2
                {% endif %}
            "
            {% if render_mode == 'horizontal' %}
                @click.prevent="
                    const details = $el.parentElement;
                    const shouldOpen = !details.open;
                    activeFilter = shouldOpen ? $el.dataset.fieldIndex : null;
                    $root.querySelectorAll('[data-filter-dropdown]').forEach((dropdown) => {
                        dropdown.open = dropdown === details && shouldOpen;
                    });
                "
            {% endif %}
        >
            <span class="inline-flex items-center gap-3">
                <span>{{ filter.label }}</span>
                {%- if render_mode == 'horizontal' and active_filter_count > 0 -%}
                    <span class="filter-count-badge">
                        {{ active_filter_count }}
                    </span>
                {%- endif -%}
            </span>
            {% render 'icons', icon: 'icon-arrow', class: 'filters-field__summary-icon' %}
        </summary>

        <div
            class="
                mt-3
                {% if render_mode == 'horizontal' %}
                    absolute top-full left-0 z-layer-popover panel-motion panel-motion-compact rounded-lg border border-theme-border/20 bg-theme-bg p-5
                    {% if filter.type == 'price_range' %}
                        min-w-[24rem] pc:max-w-[36rem]
                    {% else %}
                        min-w-[24rem]
                    {% endif %}
                {% else %}
                    rounded-lg border border-theme-border/20 p-4
                {% endif %}
            "
        >
            {{ field_content }}
        </div>
    </details>
{%- endif -%}
