<div
    x-data
    class="pointer-events-none fixed right-5 bottom-5 z-100 flex flex-col-reverse items-end gap-3"
>
    <template x-for="msg in $store.toast.messages" :key="msg.id">
        <div
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 translate-y-2 scale-95"
            x-transition:enter-end="opacity-100 translate-y-0 scale-100"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100 translate-y-0 scale-100"
            x-transition:leave-end="opacity-0 translate-y-2 scale-95"
            role="status"
            aria-live="polite"
            class="pointer-events-auto flex max-w-95 min-w-65 items-start gap-3 rounded-lg px-4 py-3 shadow-lg ring-1 ring-black/5 backdrop-blur-sm"
            :class="
                {
                  'bg-red-50 text-red-900':     msg.type === 'error',
                  'bg-emerald-50 text-emerald-900': msg.type === 'success',
                  'bg-zinc-800 text-white':     msg.type === 'info' || (msg.type !== 'error' && msg.type !== 'success')
                }
            "
        >
            <span
                class="mt-0.5 h-5 w-5 shrink-0"
                :class="
                    {
                      'text-red-500':     msg.type === 'error',
                      'text-emerald-500': msg.type === 'success',
                      'text-zinc-400':    msg.type === 'info' || (msg.type !== 'error' && msg.type !== 'success')
                    }
                "
            >
                <template x-if="msg.type === 'error'">
                    <svg viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"/>
                    </svg>
                </template>
                <template x-if="msg.type === 'success'">
                    <svg viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/>
                    </svg>
                </template>
                <template x-if="msg.type !== 'error' && msg.type !== 'success'">
                    <svg viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd"/>
                    </svg>
                </template>
            </span>

            <p class="flex-1 text-sm leading-snug" x-text="msg.message"></p>

            <button
                type="button"
                class="-mt-0.5 -mr-1 shrink-0 cursor-pointer rounded p-0.5 opacity-60 transition-opacity hover:opacity-100"
                @click="$store.toast.remove(msg.id)"
                aria-label="Dismiss"
            >
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"/>
                </svg>
            </button>
        </div>
    </template>
</div>
