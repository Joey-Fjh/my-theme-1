<div
    x-data
    class="pointer-events-none fixed right-5 bottom-5 z-100 flex flex-col-reverse items-end gap-3"
>
    <template x-for="msg in $store.toast.messages" :key="msg.id">
        <div
            {%- render 'motion-transition', preset: 'toast' -%}
            role="status"
            aria-live="polite"
            class="pointer-events-auto flex max-w-95 min-w-65 items-start gap-3 rounded-toast px-4 py-3 shadow-toast ring-1 ring-black/5 backdrop-blur-sm"
            :class="
                {
                  'bg-error text-error-text':     msg.type === 'error',
                  'bg-success text-success-text': msg.type === 'success',
                  'bg-warning text-warning-text': msg.type === 'warning',
                  'bg-info text-info-text':       msg.type === 'info' || !['error', 'success', 'warning'].includes(msg.type)
                }
            "
        >
            <span
                class="mt-0.5 h-5 w-5 shrink-0"
                :class="
                    {
                      'text-error-text':     msg.type === 'error',
                      'text-success-text':   msg.type === 'success',
                      'text-warning-text':   msg.type === 'warning',
                      'text-info-text':      msg.type === 'info' || !['error', 'success', 'warning'].includes(msg.type)
                    }
                "
            >
                <template x-if="msg.type === 'error'">
                    {%- render 'icons', icon: 'icon-x-circle', size: 'sm', color: 'current' -%}
                </template>
                <template x-if="msg.type === 'success'">
                    {%- render 'icons', icon: 'icon-check-circle', size: 'sm', color: 'current' -%}
                </template>
                <template x-if="msg.type === 'warning'">
                    {%- render 'icons', icon: 'icon-info-circle', size: 'sm', color: 'current' -%}
                </template>
                <template x-if="!['error', 'success', 'warning'].includes(msg.type)">
                    {%- render 'icons', icon: 'icon-info-circle', size: 'sm', color: 'current' -%}
                </template>
            </span>

            <p class="flex-1 text-sm leading-snug" x-text="msg.message"></p>

            <button
                type="button"
                class="-mt-0.5 -mr-1 shrink-0 cursor-pointer rounded p-0.5 opacity-60 transition-opacity hover:opacity-100"
                @click="$store.toast.remove(msg.id)"
                aria-label="{{ 'accessibility.dismiss' | t }}"
            >
                {%- render 'icons', icon: 'icon-close', size: 'sm', color: 'current' -%}
            </button>
        </div>
    </template>
</div>
