{% doc %}
    Filters drawer content, typically rendered inside `ui-dialog` as a left drawer.
  Global reuse: works for both Collection and Search via `filter_host`.
  No `<form>` lives in this snippet. All inputs bind to the external
  `CollectionFiltersForm` via the `form` attribute, and all controls auto-submit via
  `

    @change="onChange"` resolved through the surrounding Alpine scope.
    Supports Shopify filter types: - `boolean` - `list` - `price_range`

    Expected parent integration: - A form with id `CollectionFiltersForm` - An Alpine scope exposing
    `onChange` - A dialog wrapper that handles open / close state

    Example: {% render 'filters-drawer', filter_source: collection %}

    @param {object} filter_source - Optional. Pass search or collection to drive filters.
    @param {string} [drawer_class] - Optional root drawer class override.
    @param {string} [divider_class] - Optional border color class for section dividers.
    @param {string} [muted_text_class] - Optional muted text style for helper labels.
    @param {string} [filter_label_class] - Optional filter label typography classes.
    @param {string} [count_text_class] - Optional result count text classes.
    @param {string} [chip_bg_class] - Optional chip background classes for boolean filters.
    @param {string} [track_bg_class] - Optional inactive range/toggle track background classes.
    @param {string} [active_bg_class] - Optional active range/toggle background classes.
    @param {string} [input_shell_class] - Optional wrapper classes for price inputs.
    @param {string} [footer_button_class] - Optional footer CTA button classes.
    @param {number} [show_more_limit] - Optional visible item count before progressive expansion. Default: 6.
    @param {number} [show_more_step] - Optional items added per click. Default: show_more_limit.
    @param {string} [scope_id] - Optional. Unique section ID for accordion aria-controls scoping.

    @default collection | search (Liquid default when snippet included from section)
{% enddoc %}

{%- assign filter_host = filter_source | default: collection | default: search -%}
{%- assign result_count = filter_host.products_count
    | default: filter_host.results_count
    | default: 0
-%}
{%- assign drawer_class = drawer_class
    | default: 'flex h-full flex-col bg-theme-bg text-theme-text'
-%}
{%- assign divider_class = divider_class | default: 'border-theme-border-soft' -%}
{%- assign muted_text_class = muted_text_class | default: 'body-sm opacity-60' -%}
{%- assign filter_label_class = filter_label_class | default: 'body-md leading-snug' -%}
{%- assign count_text_class = count_text_class | default: 'body-sm opacity-60' -%}
{%- assign show_more_limit = show_more_limit | default: 6 -%}
{%- assign show_more_step = show_more_step | default: show_more_limit -%}
{%- assign footer_button_class = footer_button_class
    | default: 'w-full cursor-pointer rounded-none bg-theme-text px-4 py-4 text-center body-md font-medium text-theme-bg transition-opacity hover:opacity-90'
-%}

<div class="{{ drawer_class }}">
    <div class="flex items-center justify-between border-b px-4 py-4 pc:px-6 {{ divider_class }}">
        <h2 id="dialog-title-collection-filters">{{ 'collections.filters.filters' | t }}</h2>
        <button
            type="button"
            @click="$store.dialog.close()"
            class="-mr-2 flex h-9 w-9 cursor-pointer items-center justify-center text-current"
            aria-label="{{ 'accessibility.close' | t }}"
        >
            {% render 'icons', icon: 'icon-close', size: 'md', color: 'current' %}
        </button>
    </div>

    <div class="flex-1 overflow-y-auto px-4 py-2 pc:px-6">
        {% render 'filters-groups',
            filter_source: filter_host,
            layout: 'drawer',
            show_more_limit: show_more_limit,
            show_more_step: show_more_step,
            divider_class: divider_class,
            muted_text_class: muted_text_class,
            filter_label_class: filter_label_class,
            count_text_class: count_text_class,
            scope_id: scope_id
        %}
    </div>

    <div class="sticky bottom-0 border-t bg-theme-bg px-4 py-4 pc:px-6 {{ divider_class }}">
        <button
            type="button"
            @click="$store.dialog.close()"
            class="{{ footer_button_class }}"
        >
            {{ 'collections.filters.view_result' | t }}
            <sup class="opacity-60">({{ result_count }})</sup>
        </button>
    </div>
</div>
