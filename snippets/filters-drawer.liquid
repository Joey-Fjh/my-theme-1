{% doc %}
  Filters drawer — rendered inside ui-dialog (drawer, left).
  Global reuse: works for both Collection and Search via filter_host.
  No <form> here; all inputs bind to the external form via form="CollectionFiltersForm".
  All controls auto-submit via @change="onChange" (resolved through Alpine scope chain).

  @param {object} filter_source - Optional. Pass search or collection to drive filters.
  @default collection | search (Liquid default when snippet included from section)
{% enddoc %}

{%- assign filter_host = filter_source | default: collection | default: search -%}
{%- assign result_count = filter_host.products_count | default: filter_host.results_count -%}

<div class="flex flex-col h-full text-[#263D29]">
  {%- comment -%} Header {%- endcomment -%}
  <div class="flex items-center justify-between px-6 py-5 border-b border-[#e5e5e5]">
    <h2 id="dialog-title-collection-filters" class="h3 font-bold">Filters</h2>
    <button
      type="button"
      @click="$store.dialog.close()"
      class="flex items-center justify-center w-10 h-10 -mr-2 rotate-45 cursor-pointer text-[#263D29]"
      aria-label="Close"
    >
      <span class="w-5 h-5 block">
        {{- 'icon-plus.svg' | inline_asset_content -}}
      </span>
    </button>
  </div>

  {%- comment -%} Scrollable filter body {%- endcomment -%}
  <div class="flex-1 overflow-y-auto px-6 py-4">
    {%- for filter in filter_host.filters -%}
      {%- capture filter_content -%}
        {%- case filter.type -%}

          {%- when 'boolean' -%}
            <div class="flex flex-col gap-1">
              {%- for value in filter.values -%}
                <label class="flex items-center justify-between px-4 py-3.5 bg-[#f5f5f5] rounded-lg cursor-pointer">
                  <span class="leading-snug">{{ value.label }}</span>
                  <span class="relative inline-flex items-center w-12 h-7">
                    <input
                      type="checkbox"
                      class="peer sr-only"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      form="CollectionFiltersForm"
                      {% if value.active %}checked{% endif %}
                      @change="onChange"
                    >
                    <span class="absolute inset-0 rounded-full bg-[#d4d4d4] peer-checked:bg-[#263D29] transition-colors"></span>
                    <span class="absolute left-1 top-1 w-5 h-5 rounded-full bg-white shadow-sm transition-transform peer-checked:translate-x-5"></span>
                  </span>
                </label>
              {%- endfor -%}
            </div>

          {%- when 'list' -%}
            <div class="flex flex-col">
              {%- for value in filter.values -%}
                <label class="flex items-center gap-3 py-3 cursor-pointer {% unless forloop.last %}border-b border-[#e5e5e5]{% endunless %}">
                  <input
                    type="checkbox"
                    class="filter-checkbox"
                    name="{{ value.param_name }}"
                    value="{{ value.value }}"
                    form="CollectionFiltersForm"
                    {% if value.active %}checked{% endif %}
                    @change="onChange"
                  >
                  <span class="leading-snug">{{ value.label }}</span>
                  <span class="ml-auto text-sm opacity-50">({{ value.count }})</span>
                </label>
              {%- endfor -%}
            </div>

          {%- when 'price_range' -%}
            {%- assign range_max = filter.range_max | money_without_currency | plus: 0 -%}
            {%- assign current_min = filter.min_value.value | default: 0 | plus: 0 -%}
            {%- assign current_max = filter.max_value.value | default: range_max | plus: 0 -%}

            <div
              class="flex flex-col gap-5 py-3"
              x-data="{
                min: {{ current_min }},
                max: {{ current_max }},
                ceil: {{ range_max }},
                minPct() { return this.ceil ? (this.min / this.ceil) * 100 : 0 },
                maxPct() { return this.ceil ? 100 - (this.max / this.ceil) * 100 : 0 },
                clampMin() { this.min = Math.max(0, Math.min(this.min, this.max)) },
                clampMax() { this.max = Math.min(this.ceil, Math.max(this.max, this.min)) }
              }"
            >
              {%- comment -%} Dual-thumb range slider {%- endcomment -%}
              <div class="relative w-full h-10 flex items-center">
                <div class="absolute inset-x-0 h-0.5 bg-[#d4d4d4] rounded-full"></div>
                <div
                  class="absolute h-0.5 bg-[#263D29] rounded-full"
                  :style="`left:${minPct()}%;right:${maxPct()}%`"
                ></div>
                <input
                  type="range"
                  min="0"
                  :max="ceil"
                  x-model.number="min"
                  @input="clampMin()"
                  @change.debounce.500ms="$refs.inputMin.value = min; onChange"
                  class="price-range-thumb absolute inset-x-0 w-full appearance-none bg-transparent pointer-events-none z-10"
                >
                <input
                  type="range"
                  min="0"
                  :max="ceil"
                  x-model.number="max"
                  @input="clampMax()"
                  @change.debounce.500ms="$refs.inputMax.value = max; onChange"
                  class="price-range-thumb absolute inset-x-0 w-full appearance-none bg-transparent pointer-events-none z-20"
                >
              </div>

              {%- comment -%} From / To number inputs {%- endcomment -%}
              <div class="flex items-center gap-4">
                <div class="flex-1">
                  <label class="block text-sm mb-1 opacity-60" for="Filter-{{ filter.label | handleize }}-GTE">From</label>
                  <div class="flex items-center border border-[#d4d4d4] rounded px-3 py-2">
                    <span class="opacity-50 mr-1">$</span>
                    <input
                      x-ref="inputMin"
                      id="Filter-{{ filter.label | handleize }}-GTE"
                      type="number"
                      name="{{ filter.min_value.param_name }}"
                      :value="min"
                      min="0"
                      max="{{ range_max }}"
                      placeholder="0"
                      form="CollectionFiltersForm"
                      @input.debounce.500ms="min = +$el.value; clampMin(); $el.value = min; onChange"
                      class="w-full bg-transparent outline-none appearance-none [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
                    >
                  </div>
                </div>
                <div class="flex-1">
                  <label class="block text-sm mb-1 opacity-60" for="Filter-{{ filter.label | handleize }}-LTE">To</label>
                  <div class="flex items-center border border-[#d4d4d4] rounded px-3 py-2">
                    <span class="opacity-50 mr-1">$</span>
                    <input
                      x-ref="inputMax"
                      id="Filter-{{ filter.label | handleize }}-LTE"
                      type="number"
                      name="{{ filter.max_value.param_name }}"
                      :value="max"
                      min="0"
                      max="{{ range_max }}"
                      placeholder="{{ range_max }}"
                      form="CollectionFiltersForm"
                      @input.debounce.500ms="max = +$el.value; clampMax(); $el.value = max; onChange"
                      class="w-full bg-transparent outline-none appearance-none [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
                    >
                  </div>
                </div>
              </div>
            </div>

        {%- endcase -%}
      {%- endcapture -%}

      {%- render 'accordion',
        titles: filter.label,
        contents: filter_content,
        initial_active: 0,
        icon_type: 'plus',
        wrapper_class: 'flex flex-col',
        item_class: 'border-t border-[#d4d4d4] first:border-t-0',
        content_class: 'pb-2'
      -%}
    {%- endfor -%}
  </div>

  {%- comment -%} Sticky footer — close only, filters auto-submit on change {%- endcomment -%}
  <div class="sticky bottom-0 px-6 py-5 bg-white border-t border-[#e5e5e5]">
    <button
      type="button"
      @click="$store.dialog.close()"
      class="w-full py-4 rounded-sm text-center font-medium cursor-pointer bg-[#263D29] text-white transition-opacity hover:opacity-90"
    >
      View Result <sup class="opacity-60">({{ result_count }})</sup>
    </button>
  </div>
</div>
