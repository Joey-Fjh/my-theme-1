{% doc %}
    Filters drawer content, typically rendered inside `ui-dialog` as a left drawer.
  Global reuse: works for both Collection and Search via `filter_host`.
  No `<form>` lives in this snippet. All inputs bind to the external
  `CollectionFiltersForm` via the `form` attribute, and all controls auto-submit via
  `

    @change="onChange"` resolved through the surrounding Alpine scope.
    Supports Shopify filter types: - `boolean` - `list` - `price_range`

    Expected parent integration: - A form with id `CollectionFiltersForm` - An Alpine scope exposing
    `onChange` - A dialog wrapper that handles open / close state

    Example: {% render 'filters-drawer', filter_source: collection %}

    @param {object} filter_source - Optional. Pass search or collection to drive filters.
    @param {string} [drawer_class] - Optional root drawer class override.
    @param {string} [divider_class] - Optional border color class for section dividers.
    @param {string} [muted_text_class] - Optional muted text style for helper labels.
    @param {string} [filter_label_class] - Optional filter label typography classes.
    @param {string} [count_text_class] - Optional result count text classes.
    @param {string} [footer_button_class] - Optional footer CTA button classes.
    @param {number} [show_more_limit] - Optional visible item count before progressive expansion. Default: 6.
    @param {number} [show_more_step] - Optional items added per click. Default: show_more_limit.
    @param {string} [scope_id] - Optional. Unique section ID for accordion aria-controls scoping.
    @param {string} [form_id] - Optional external form id for filter controls.
    @param {string} [dialog_title_id] - Optional id for the drawer heading (aria labelling).

    @default collection | search (Liquid default when snippet included from section)
{% enddoc %}

{%- assign filter_host = filter_source | default: collection | default: search -%}
{%- assign result_count = filter_host.products_count
    | default: filter_host.results_count
    | default: 0
-%}
{%- assign drawer_class = drawer_class | default: 'flex h-full flex-col' -%}
{%- assign divider_class = divider_class | default: 'border-theme-border/20' -%}
{%- assign muted_text_class = muted_text_class | default: 'body-sm opacity-80' -%}
{%- assign filter_label_class = filter_label_class | default: '' -%}
{%- assign count_text_class = count_text_class | default: 'body-sm opacity-80' -%}
{%- assign show_more_limit = show_more_limit | default: 6 -%}
{%- assign show_more_step = show_more_step | default: show_more_limit -%}
{%- assign footer_button_class = footer_button_class | default: 'filters-drawer__footer-button' -%}
{%- assign drawer_scope_id = scope_id | default: 'filters' | append: '-drawer' -%}
{%- assign filters_form_id = form_id | default: 'CollectionFiltersForm' -%}
{%- assign filters_dialog_title_id = dialog_title_id
    | default: 'dialog-title-collection-filters'
-%}

<div class="{{ drawer_class }}">
    <div class="ui-dialog-overlay-header">
        <h2 id="{{ filters_dialog_title_id }}">{{ 'collections.filters.filters' | t }}</h2>
        <button
            type="button"
            @click="$store.dialog.close()"
            class="close-button"
            aria-label="{{ 'accessibility.close' | t }}"
        >
            {% render 'icons', icon: 'icon-close' %}
        </button>
    </div>

    <div class="ui-dialog-overlay-body">
        {% render 'filters-groups',
            filter_source: filter_host,
            layout: 'drawer',
            show_more_limit: show_more_limit,
            show_more_step: show_more_step,
            divider_class: divider_class,
            muted_text_class: muted_text_class,
            filter_label_class: filter_label_class,
            count_text_class: count_text_class,
            scope_id: drawer_scope_id,
            form_id: filters_form_id
        %}
    </div>

    <div class="ui-dialog-overlay-footer">
        <button
            type="button"
            @click="$store.dialog.close()"
            class="{{ footer_button_class }} w-full"
        >
            {{ 'collections.filters.view_result' | t }}
            <sup class="opacity-60">({{ result_count }})</sup>
        </button>
    </div>
</div>

{% stylesheet %}
    @layer snippets {
        .filters-drawer__footer-button {
            display: inline-flex;
            cursor: pointer;
            align-items: center;
            justify-content: center;
            gap: calc(var(--spacing) * 2);
            border-style: var(--tw-border-style);
            border-width: 1px;
            font-family: var(--font-body-family);
            --tw-outline-style: none;
            outline-style: none;
            --btn-reverse-fill-pct: 0%;
            --btn-reverse-text-pct: 0%;
            --btn-reverse-border-pct: 0%;
            --btn-reverse-fill-rest: 10%;
            --btn-reverse-text-rest: 10%;
            --btn-reverse-cycle: 2.5s;
            --btn-reverse-ease: ease-in-out;
            --btn-ui-transition-duration: 200ms;
            --btn-ui-transition-ease: ease;
            --btn-hover-filter: none;
            --btn-active-filter: brightness(0.95);
            --btn-hover-y: -1px;
            --btn-active-scale: 0.98;
            --btn-hover-shadow-opacity: 1.35;
            --btn-shadow-hover-y: calc(
                var(--button-shadow-vertical-offset) + var(--btn-reverse-lift-y)
            );
            --btn-shadow-hover-blur: calc(var(--button-shadow-blur-radius) * 1.12);
            --btn-shadow-hover-opacity: calc(
                var(--button-shadow-opacity) * var(--btn-hover-shadow-opacity)
            );
            transition:
                color var(--btn-ui-transition-duration) var(--btn-ui-transition-ease),
                background-color var(--btn-ui-transition-duration) var(--btn-ui-transition-ease),
                border-color var(--btn-ui-transition-duration) var(--btn-ui-transition-ease),
                box-shadow var(--btn-ui-transition-duration) var(--btn-ui-transition-ease),
                filter var(--btn-ui-transition-duration) var(--btn-ui-transition-ease),
                opacity var(--btn-ui-transition-duration) var(--btn-ui-transition-ease),
                transform var(--btn-ui-transition-duration) var(--btn-ui-transition-ease);
            padding: var(--button-padding-y) var(--button-padding-x);
            border-radius: var(--button-radius);
            border-width: var(--button-border-width);
            border-style: solid;
            box-shadow: var(--button-shadow-horizontal-offset) var(--button-shadow-vertical-offset)
                var(--button-shadow-blur-radius)
                rgba(var(--color-foreground), var(--button-shadow-opacity));
            line-height: var(--font-body-line-height);
            text-align: center;
            text-decoration: none;
            white-space: nowrap;
            user-select: none;
            &:focus-visible {
                outline: var(--focus-ring-width) solid
                    rgba(var(--color-focus-ring), var(--focus-ring-opacity, 0.4));
                outline-offset: var(--focus-ring-offset);
            }
            border-color: rgb(var(--btn-border-rgb));
            background-color: rgb(var(--btn-bg-rgb));
            color: rgb(var(--btn-text-rgb));
            @supports (background-color: color-mix(in srgb, black, white)) {
                transition:
                    --btn-reverse-fill-pct var(--motion-duration-fast, 250ms)
                        var(--motion-ease-enter, ease),
                    --btn-reverse-text-pct var(--motion-duration-fast, 250ms)
                        var(--motion-ease-enter, ease),
                    --btn-reverse-border-pct var(--motion-duration-fast, 250ms)
                        var(--motion-ease-enter, ease),
                    background-color var(--motion-duration-fast, 250ms)
                        var(--motion-ease-enter, ease),
                    color var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease),
                    border-color var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease),
                    box-shadow var(--btn-ui-transition-duration) var(--btn-ui-transition-ease),
                    opacity var(--btn-ui-transition-duration) var(--btn-ui-transition-ease),
                    filter var(--btn-ui-transition-duration) var(--btn-ui-transition-ease),
                    transform var(--btn-ui-transition-duration) var(--btn-ui-transition-ease);
                background-color: rgb(var(--btn-bg-rgb));
                @supports (color: color-mix(in lab, red, red)) {
                    background-color: color-mix(
                        in srgb,
                        rgb(var(--btn-bg-rgb)) calc(100% - var(--btn-reverse-fill-pct)),
                        rgb(var(--btn-text-rgb)) var(--btn-reverse-fill-pct)
                    );
                }
                color: rgb(var(--btn-text-rgb));
                @supports (color: color-mix(in lab, red, red)) {
                    color: color-mix(
                        in srgb,
                        rgb(var(--btn-text-rgb)) calc(100% - var(--btn-reverse-text-pct)),
                        rgb(var(--btn-bg-rgb)) var(--btn-reverse-text-pct)
                    );
                }
                border-color: rgb(var(--btn-border-rgb));
                @supports (color: color-mix(in lab, red, red)) {
                    border-color: color-mix(
                        in srgb,
                        rgb(var(--btn-border-rgb)) calc(100% - var(--btn-reverse-border-pct)),
                        rgb(var(--btn-bg-rgb)) var(--btn-reverse-border-pct)
                    );
                }
                @media (hover: hover) and (pointer: fine) {
                    &:hover:not(:active):not(:disabled):not([aria-disabled='true']):not(
                            [aria-busy='true']
                        ) {
                        animation: btn-soft-reverse-breath var(--btn-reverse-cycle)
                            var(--btn-reverse-ease) infinite;
                        box-shadow: var(--button-shadow-horizontal-offset) var(--btn-shadow-hover-y)
                            var(--btn-shadow-hover-blur)
                            rgba(var(--color-foreground), var(--btn-shadow-hover-opacity));
                    }
                }
                &:active:not(:disabled):not([aria-disabled='true']):not([aria-busy='true']) {
                    animation: none;
                    transform: scale(var(--btn-active-scale));
                    --btn-reverse-fill-pct: 6%;
                    --btn-reverse-text-pct: 4%;
                    --btn-reverse-border-pct: 5%;
                    filter: var(--btn-active-filter);
                }
                @media (prefers-reduced-motion: reduce) {
                    @media (hover: hover) and (pointer: fine) {
                        &:hover:not(:active):not(:disabled):not([aria-disabled='true']):not(
                                [aria-busy='true']
                            ) {
                            animation: none;
                            --btn-reverse-fill-pct: var(--btn-reverse-fill-hover);
                            --btn-reverse-text-pct: var(--btn-reverse-text-hover);
                            --btn-reverse-border-pct: var(--btn-reverse-border-hover);
                            transform: none;
                        }
                    }
                    &:active:not(:disabled):not([aria-disabled='true']):not([aria-busy='true']) {
                        transform: scale(var(--btn-active-scale));
                    }
                }
            }
            @supports not (background-color: color-mix(in srgb, black, white)) {
                @media (hover: hover) and (pointer: fine) {
                    &:hover:not(:disabled):not([aria-disabled='true']):not([aria-busy='true']) {
                        transform: translateY(var(--btn-hover-y));
                        filter: var(--btn-hover-filter);
                        box-shadow: var(--button-shadow-horizontal-offset) var(--btn-shadow-hover-y)
                            var(--btn-shadow-hover-blur)
                            rgba(var(--color-foreground), var(--btn-shadow-hover-opacity));
                    }
                }
                &:active:not(:disabled):not([aria-disabled='true']):not([aria-busy='true']) {
                    transform: scale(var(--btn-active-scale));
                    filter: var(--btn-active-filter);
                }
            }
            &:disabled,
            &[aria-disabled='true'] {
                cursor: not-allowed;
                opacity: 0.5;
                pointer-events: none;
            }
            &[aria-busy='true'] {
                cursor: wait;
                opacity: 0.82;
                pointer-events: none;
            }
            --btn-bg-rgb: var(--color-primary-button);
            --btn-text-rgb: var(--color-primary-button-text);
            --btn-border-rgb: var(--color-primary-button-border);
            --btn-reverse-fill-rest: 12%;
            --btn-reverse-text-rest: 12%;
            --btn-reverse-border-rest: 100%;
            --btn-reverse-fill-hover: 88%;
            --btn-reverse-text-hover: 90%;
            --btn-reverse-border-hover: 100%;
            --btn-reverse-fill-breath: 4%;
            --btn-reverse-border-breath: 3%;
            --btn-reverse-scale-peak: 1.02;
            --btn-reverse-lift-y: -2.5px;
            --btn-hover-filter: brightness(1.06);
            --btn-active-filter: brightness(0.94);
            --btn-hover-shadow-opacity: 1.45;
            width: 100%;
            background-color: rgb(var(--color-foreground));
            color: rgb(var(--color-background));
            &:hover {
                @media (hover: hover) {
                    opacity: 90%;
                }
            }
        }
    }
{% endstylesheet %}
