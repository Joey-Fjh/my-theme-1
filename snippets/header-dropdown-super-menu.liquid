<nav
    aria-label="{{ 'accessibility.main_menu' | t }}"
    class="header-dropdown-super-menu"
    x-data="dropdown"
    @mouseenter="onHeaderEnter()"
    @mouseleave="onHeaderLeave()"
    @focusin="onHeaderFocusIn()"
    @focusout="onHeaderFocusOut($event)"
    @click.outside="closeAndDeactivate()"
    @keydown.escape.window="closeAndDeactivate()"
>
    {%- assign super_menu_series_layout = section.settings.super_menu_series_layout
        | default: 'left-right'
    -%}

    <ul class="flex items-center gap-6" role="list">
        {%- for link in section.settings.menu.links -%}
            <li class="relative">
                {%- if link.links != blank -%}
                    <details
                        class="dropdown"
                        data-dropdown
                        data-deep="1"
                    >
                        <summary
                            class="dropdown-trigger flex items-center gap-1"
                            id="HeaderSuperMenu-{{ link.handle }}"
                            :aria-expanded="$el.parentElement.open"
                            @click.stop.prevent="toggle($el.parentElement)"
                        >
                            {% capture link_content %}
                                <span>{{ link.title | escape }}</span>
                                {% render 'icons',
                                    icon: 'icon-arrow',
                                    class: 'dropdown-icon dropdown-icon--down'
                                %}
                            {% endcapture %}

                            {% render 'link',
                                content: link_content,
                                variant: 'underline',
                                class: 'flex items-center gap-3'
                            %}
                        </summary>

                        <div
                            class="
                                dropdown-panel dropdown-open
                                fixed top-[calc(var(--announcement-bar-height)+var(--header-height))] right-0 left-0
                                max-w-none min-w-auto rounded-none px-8 py-5
                                color-{{ section.settings.menu_color_scheme }}
                                bg-theme-bg text-theme-text
                            "
                        >
                            {%- liquid
                                assign super_menu_column_count = link.links.size
                                if super_menu_column_count < 1
                                    assign super_menu_column_count = 1
                                endif
                            -%}

                            <div
                                class="header-super-menu-panel relative"
                                style="--super-menu-primary-width: {{ section.settings.super_menu_primary_width }}%; --super-menu-secondary-width: {{ 100 | minus: section.settings.super_menu_primary_width }}%; --super-menu-column-count: {{ super_menu_column_count }};"
                            >
                                <div class="header-super-menu-layout{% if section.settings.enable_super_menu_series %} header-super-menu-layout--with-series header-super-menu-layout--series-{{ super_menu_series_layout }}{% else %} header-super-menu-layout--full{% endif %}">
                                    <div class="header-super-menu-main">
                                        <div class="header-super-menu-columns">
                                            {%- for childlink in link.links -%}
                                                <div class="header-super-menu-column">
                                                    {%- capture child_link_attributes -%}
                                                        {%- if childlink.current -%}
                                                            aria-current="page"
                                                        {%- endif -%}
                                                    {%- endcapture -%}

                                                    {%- capture child_link_class -%}
                                                        block header-super-menu-child-link text-theme-text
                                                        {%- if childlink.links != blank -%}
                                                            header-super-menu-child-link--has-children
                                                        {%- endif -%}
                                                    {%- endcapture -%}

                                                    <div class="header-super-menu-child-item">
                                                        {%-
                                                            render 'link',
                                                            text: childlink.title | escape,
                                                            href: childlink.url,
                                                            variant: 'underline',
                                                            class: child_link_class | strip,
                                                            attributes: child_link_attributes
                                                        -%}
                                                    </div>

                                                    {%- if childlink.links != blank -%}
                                                        <div class="header-super-menu-grandchildren-links">
                                                            {%- for grandchild in childlink.links -%}
                                                                {%- if grandchild.title
                                                                        == childlink.title
                                                                    and grandchild.url
                                                                        == childlink.url
                                                                -%}
                                                                    {%- continue -%}
                                                                {%- endif -%}

                                                                {%- capture grand_link_attributes -%}
                                                                    {%- if grandchild.current -%}
                                                                        aria-current="page"
                                                                    {%- endif -%}
                                                                {%- endcapture -%}

                                                                {%-
                                                                    render 'link',
                                                                    text: grandchild.title | escape,
                                                                    href: grandchild.url,
                                                                    variant: 'underline',
                                                                    class: 'text-theme-text',
                                                                    attributes: grand_link_attributes
                                                                -%}
                                                            {%- endfor -%}
                                                        </div>
                                                    {%- endif -%}
                                                </div>
                                            {%- endfor -%}
                                        </div>
                                    </div>

                                    {%- if section.settings.enable_super_menu_series -%}
                                        <div
                                            class="header-super-menu-series color-{{ section.settings.menu_color_scheme }} text-theme-text"
                                        >
                                            {%- capture super_tab_header -%}
                                                {%- for i in (1..3) -%}
                                                    {%- assign collection_key = 'super_collection_' | append: i -%}
                                                    {%- assign collection_item = section.settings[collection_key] -%}

                                                    {%- if collection_item != blank -%}
                                                        <button
                                                            type="button"
                                                            role="tab"
                                                            id="super-tab-{{ section.id }}-{{ i }}"
                                                            aria-controls="super-panel-{{ section.id }}-{{ i }}"
                                                            x-data="{ index: null }"
                                                            x-init="index = registerTab($el)"
                                                            @click="setActive(index)"
                                                            :aria-selected="isActive(index)"
                                                            class="border-b-2 pb-2 text-current transition-colors"
                                                            :class="isActive(index)
                                                                ? 'border-current opacity-100'
                                                                : 'border-transparent opacity-60 hover:opacity-100'
                                                            "
                                                        >
                                                            {{ collection_item.title | escape }}
                                                        </button>
                                                    {%- endif -%}
                                                {%- endfor -%}
                                            {%- endcapture -%}

                                            {%- capture super_tab_content -%}
                                                {%- for i in (1..3) -%}
                                                    {%- assign collection_key = 'super_collection_' | append: i -%}
                                                    {%- assign collection_item = section.settings[collection_key] -%}

                                                    {%- if collection_item != blank -%}
                                                        <div
                                                            role="tabpanel"
                                                            id="super-panel-{{ section.id }}-{{ i }}"
                                                            aria-labelledby="super-tab-{{ section.id }}-{{ i }}"
                                                            x-data="{ index: null }"
                                                            x-init="index = registerPanel($el)"
                                                            x-show="isActive(index)"
                                                            x-cloak
                                                        >
                                                            <div
                                                                class="no-scrollbar flex gap-3 overflow-x-auto"
                                                                x-data="dragScroll({ axis: 'x' })"
                                                            >
                                                                {% # theme-check-disable-next-line LiquidHTMLSyntaxError %}
                                                                {%- for product in collection_item.products limit: section.settings.super_series_products_limit -%}
                                                                    {%- if product != blank -%}
                                                                        {% render 'product-card',
                                                                            product: product,
                                                                            class: 'w-100 shrink-0',
                                                                            card_mode: 'lite',
                                                                            show_image_navigation: true,
                                                                            scope_id: section.id,
                                                                            color_scheme: section.settings.menu_color_scheme
                                                                        %}
                                                                    {%- else -%}
                                                                        <p class="opacity-60">{{ 'search.no_products_in_collection' | t }}</p>
                                                                    {%- endif -%}
                                                                {%- endfor -%}
                                                            </div>
                                                        </div>
                                                    {%- endif -%}
                                                {%- endfor -%}
                                            {%- endcapture -%}

                                            {%- if super_tab_header != blank -%}
                                                {%- render 'tab-control',
                                                    custom_class: 'header-super-menu-series-tabs',
                                                    initialTabStrategy: 'first',
                                                    tab_header: super_tab_header,
                                                    tab_content: super_tab_content,
                                                    header_class: 'gap-6'
                                                -%}
                                            {%- endif -%}
                                        </div>
                                    {%- endif -%}
                                </div>

                                {% render 'watermark',
                                    container_class: 'absolute -bottom-20 w-full overflow-hidden pointer-events-none select-none -z-1',
                                    text_class: 'font-bold opacity-12',
                                    text: section.settings.super_menu_watermark_text
                                %}
                            </div>
                        </div>
                    </details>
                {%- else -%}
                    {%- capture link_attributes -%}
                        {%- if link.current -%}
                            aria-current="page"
                        {%- endif -%}
                    {%- endcapture -%}

                    {%-
                        render 'link',
                        text: link.title | escape,
                        href: link.url,
                        variant: 'underline',
                        attributes: link_attributes
                    -%}
                {%- endif -%}
            </li>
        {%- endfor -%}
    </ul>
</nav>
