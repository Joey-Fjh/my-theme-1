{%- liquid
    assign desktop_menu_trigger = section.settings.desktop_menu_trigger | default: 'hover'
    unless desktop_menu_trigger == 'click'
        assign desktop_menu_trigger = 'hover'
    endunless
-%}

<nav
    aria-label="{{ 'accessibility.main_menu' | t }}"
    class="header-dropdown-super-menu"
    data-desktop-menu-trigger="{{ desktop_menu_trigger }}"
    x-data="dropdown"
    data-module-id="dropdown"
    @mouseenter="onHeaderEnter()"
    @click.capture="onMenuTriggerClickEvent($event)"
    @mouseover="openOnHoverEvent($event)"
    @mouseleave="closeHoverAndDeactivate()"
    @focusin="onHeaderFocusIn()"
    @focusout="onHeaderFocusOut($event)"
    @click.outside="closeAndDeactivate()"
    @keydown.escape.window="onMenuKeydown($event)"
>
    {%- assign super_menu_series_layout = section.settings.super_menu_series_layout
        | default: 'left-right'
    -%}

    <ul class="flex items-center gap-6" role="list">
        {%- for link in section.settings.menu.links -%}
            <li class="relative">
                {%- if link.links != blank -%}
                    <details
                        class="dropdown"
                        data-dropdown
                        data-deep="1"
                    >
                        <summary
                            class="dropdown-trigger flex items-center gap-1"
                            id="HeaderSuperMenu-{{ link.handle }}"
                            :aria-expanded="$el.parentElement.open"
                        >
                            <span class="link-with-icon-motion links-underline links flex items-center gap-3">
                                <span>{{ link.title | escape }}</span>
                                {% render 'icons',
                                    icon: 'icon-arrow',
                                    class: 'dropdown-icon dropdown-icon--down'
                                %}
                            </span>
                        </summary>

                        <div
                            class="
                                dropdown-panel dropdown-open panel-motion panel-motion-layered
                                header-super-menu-panel-motion no-scrollbar
                                fixed inset-x-0 top-[calc(var(--announcement-bar-height)+var(--header-height))]
                                max-w-none min-w-auto rounded-none px-8 py-5
                                color-{{ section.settings.menu_color_scheme }}
                                surface-component
                            "
                            @mouseenter="onSuperMenuPanelMouseEnter()"
                        >
                            <div class="panel-motion-shell">
                                <div class="panel-motion-content">
                                    {%- if link.url != blank -%}
                                        <div class="mb-4 px-1">
                                            {%- render 'link',
                                                text: link.title,
                                                href: link.url,
                                                variant: 'underline',
                                                class: 'body-md'
                                            -%}
                                        </div>
                                    {%- endif -%}
                                    {%- liquid
                                        assign super_menu_column_count = link.links.size
                                        if super_menu_column_count < 1
                                            assign super_menu_column_count = 1
                                        endif
                                    -%}

                                    <div
                                        class="header-super-menu-panel relative"
                                        style="--super-menu-primary-width: {{ section.settings.super_menu_primary_width }}%; --super-menu-secondary-width: {{ 100 | minus: section.settings.super_menu_primary_width }}%; --super-menu-column-count: {{ super_menu_column_count }};"
                                    >
                                        <div class="header-super-menu-layout{% if section.settings.enable_super_menu_series %} header-super-menu-layout--with-series header-super-menu-layout--series-{{ super_menu_series_layout }}{% else %} header-super-menu-layout--full{% endif %}">
                                            <div class="header-super-menu-main">
                                                <div class="header-super-menu-columns">
                                                    {%- for childlink in link.links -%}
                                                        <div class="header-super-menu-column">
                                                            {%- capture child_link_attributes -%}
                                                        {%- if childlink.current -%}
                                                            aria-current="page"
                                                        {%- endif -%}
                                                    {%- endcapture -%}

                                                            {%- capture child_link_class -%}
                                                        block header-super-menu-child-link text-theme-text
                                                        {%- if childlink.links != blank -%}
                                                            header-super-menu-child-link--has-children
                                                        {%- endif -%}
                                                    {%- endcapture -%}

                                                            <div class="header-super-menu-child-item">
                                                                {%- assign super_child_link_text = childlink.title
                                                                    | escape
                                                                -%}
                                                                {%- assign super_child_link_class = child_link_class
                                                                    | strip
                                                                -%}
                                                                {%- render 'link',
                                                                    text: super_child_link_text,
                                                                    href: childlink.url,
                                                                    variant: 'underline',
                                                                    class: super_child_link_class,
                                                                    attributes: child_link_attributes
                                                                -%}
                                                            </div>

                                                            {%- if childlink.links != blank -%}
                                                                <div class="header-super-menu-grandchildren-links">
                                                                    {%- for grandchild in childlink.links -%}
                                                                        {%- if grandchild.title
                                                                                == childlink.title
                                                                            and grandchild.url
                                                                                == childlink.url
                                                                        -%}
                                                                            {%- continue -%}
                                                                        {%- endif -%}

                                                                        {%- capture grand_link_attributes -%}
                                                                    {%- if grandchild.current -%}
                                                                        aria-current="page"
                                                                    {%- endif -%}
                                                                {%- endcapture -%}

                                                                        {%- assign super_grandchild_text = grandchild.title
                                                                            | escape
                                                                        -%}
                                                                        {%- render 'link',
                                                                            text: super_grandchild_text,
                                                                            href: grandchild.url,
                                                                            variant: 'underline',
                                                                            class: 'text-theme-text',
                                                                            attributes: grand_link_attributes
                                                                        -%}
                                                                    {%- endfor -%}
                                                                </div>
                                                            {%- endif -%}
                                                        </div>
                                                    {%- endfor -%}
                                                </div>
                                            </div>

                                            {%- if section.settings.enable_super_menu_series -%}
                                                <div
                                                    class="header-super-menu-series color-{{ section.settings.menu_color_scheme }} text-theme-text"
                                                >
                                                    {%- capture super_tab_header -%}
                                                {%- for i in (1..3) -%}
                                                    {%- assign collection_key = 'super_collection_' | append: i -%}
                                                    {%- assign collection_item = section.settings[collection_key] -%}

                                                    {%- if collection_item != blank -%}
                                                        <button
                                                            type="button"
                                                            role="tab"
                                                            id="super-tab-{{ section.id }}-{{ link.handle }}-{{ i }}"
                                                            aria-controls="super-panel-{{ section.id }}-{{ link.handle }}-{{ i }}"
                                                            x-init="registerTab($el)"
                                                            @click="setActive(tabIndexFor($el))"
                                                            :aria-selected="isActive(tabIndexFor($el))"
                                                            :tabindex="isFocusable(tabIndexFor($el)) ? 0 : -1"
                                                            class="header-dropdown-super-menu__tab tab-nav-item tab-nav-item--underline-opacity"
                                                            :class="{ 'is-active': isActive(tabIndexFor($el)) }"
                                                        >
                                                            {{ collection_item.title | escape }}
                                                        </button>
                                                    {%- endif -%}
                                                {%- endfor -%}
                                            {%- endcapture -%}

                                                    {%- capture super_tab_content -%}
                                                {%- for i in (1..3) -%}
                                                    {%- assign collection_key = 'super_collection_' | append: i -%}
                                                    {%- assign collection_item = section.settings[collection_key] -%}

                                                    {%- if collection_item != blank -%}
                                                        <div
                                                            role="tabpanel"
                                                            id="super-panel-{{ section.id }}-{{ link.handle }}-{{ i }}"
                                                            aria-labelledby="super-tab-{{ section.id }}-{{ link.handle }}-{{ i }}"
                                                            x-init="registerPanel($el)"
                                                            x-show="isActive(panelIndexFor($el))"
                                                            x-cloak
                                                        >
                                                            <div
                                                                class="no-scrollbar flex items-start gap-3 overflow-x-auto"
                                                                x-data="dragScroll({ axis: 'x' })"
                                                                data-module-id="drag-scroll"
                                                            >
                                                                {% # theme-check-disable-next-line LiquidHTMLSyntaxError %}
                                                                {%- for product in collection_item.products limit: section.settings.super_series_products_limit -%}
                                                                    {%- if product != blank -%}
                                                                        {%- capture super_card_scope_id -%}
                                                                            {{- section.id -}}-{{- link.handle -}}-series-{{- i -}}
                                                                        {%- endcapture -%}
                                                                        {% render 'product-card',
                                                                            product: product,
                                                                            class: 'w-100 shrink-0',
                                                                            card_mode: 'lite',
                                                                            show_image_navigation: true,
                                                                            scope_id: super_card_scope_id,
                                                                            color_scheme: section.settings.menu_color_scheme
                                                                        %}
                                                                    {%- else -%}
                                                                        <p class="opacity-60">{{ 'search.no_products_in_collection' | t }}</p>
                                                                    {%- endif -%}
                                                                {%- endfor -%}
                                                            </div>
                                                        </div>
                                                    {%- endif -%}
                                                {%- endfor -%}
                                            {%- endcapture -%}

                                                    {%- if super_tab_header != blank -%}
                                                        {%- render 'tab-control',
                                                            custom_class: 'header-super-menu-series-tabs',
                                                            initialTabStrategy: 'first',
                                                            tab_header: super_tab_header,
                                                            tab_content: super_tab_content,
                                                            header_class: 'gap-6'
                                                        -%}
                                                    {%- endif -%}
                                                </div>
                                            {%- endif -%}
                                        </div>

                                        {% render 'watermark',
                                            container_class: 'absolute -bottom-20 w-full overflow-hidden pointer-events-none select-none -z-1',
                                            text_class: 'opacity-12',
                                            text: section.settings.super_menu_watermark_text
                                        %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </details>
                {%- else -%}
                    {%- capture link_attributes -%}
                        {%- if link.current -%}
                            aria-current="page"
                        {%- endif -%}
                    {%- endcapture -%}

                    {%- assign super_nav_link_text = link.title | escape -%}
                    {%- render 'link',
                        text: super_nav_link_text,
                        href: link.url,
                        variant: 'underline',
                        attributes: link_attributes
                    -%}
                {%- endif -%}
            </li>
        {%- endfor -%}
    </ul>
</nav>

{% stylesheet %}
    @layer components {
        .panel-motion-layered {
            --panel-motion-dur: var(--panel-motion-duration-layered);
            --panel-motion-shell-dur: calc(var(--panel-motion-dur) * 0.85);
            --panel-motion-layered-shell-scale: 0.45;
            --panel-motion-layered-content-offset: 12px;
            padding: 0;
            overflow: hidden;
            background: transparent;
            border-color: transparent;
            box-shadow: none;
        }
        .panel-motion-layered .panel-motion-shell {
            overflow: hidden;
            transform: scaleY(1);
            transform-origin: top center;
            animation: none;
        }
        .panel-motion-layered .panel-motion-content > * {
            opacity: 1;
            transform: translateY(0);
            animation: none;
        }
        details:not([open]) > .panel-motion-layered .panel-motion-shell,
        [data-dropdown]:not([open]) > .panel-motion-layered .panel-motion-shell {
            transform: scaleY(var(--panel-motion-layered-shell-scale));
            animation: none;
        }
        details:not([open]) .panel-motion-layered .panel-motion-content > *,
        [data-dropdown]:not([open]) .panel-motion-layered .panel-motion-content > * {
            animation: none;
            opacity: 0;
            transform: translateY(var(--panel-motion-layered-content-offset));
        }
        details[open] > .panel-motion-layered[data-panel-motion='enter'] .panel-motion-shell,
        [data-dropdown][open]
            > .panel-motion-layered[data-panel-motion='enter']
            .panel-motion-shell {
            animation: panel-motion-layered-shell-in var(--panel-motion-shell-dur)
                var(--panel-motion-ease-enter) both;
        }
        details[open] > .panel-motion-layered[data-panel-motion='enter'],
        [data-dropdown][open] > .panel-motion-layered[data-panel-motion='enter'] {
            animation: panel-motion-layered-panel-in var(--panel-motion-dur)
                var(--panel-motion-ease-enter) both;
        }
        details[open] .panel-motion-layered[data-panel-motion='enter'] .panel-motion-content > *,
        [data-dropdown][open]
            .panel-motion-layered[data-panel-motion='enter']
            .panel-motion-content
            > * {
            animation: panel-motion-content-in var(--panel-motion-duration-item)
                var(--panel-motion-ease-enter) both;
        }
        details[open]
            .panel-motion-layered[data-panel-motion='enter']
            .panel-motion-content
            > *:nth-child(1),
        [data-dropdown][open]
            .panel-motion-layered[data-panel-motion='enter']
            .panel-motion-content
            > *:nth-child(1) {
            animation-delay: var(--panel-motion-content-delay-layered);
        }
        details[open]
            .panel-motion-layered[data-panel-motion='enter']
            .panel-motion-content
            > *:nth-child(2),
        [data-dropdown][open]
            .panel-motion-layered[data-panel-motion='enter']
            .panel-motion-content
            > *:nth-child(2) {
            animation-delay: calc(
                var(--panel-motion-content-delay-layered) + var(--panel-motion-stagger-step, 32ms)
            );
        }
        details[open]
            .panel-motion-layered[data-panel-motion='enter']
            .panel-motion-content
            > *:nth-child(3),
        [data-dropdown][open]
            .panel-motion-layered[data-panel-motion='enter']
            .panel-motion-content
            > *:nth-child(3) {
            animation-delay: calc(
                var(--panel-motion-content-delay-layered) + var(--panel-motion-stagger-step, 32ms) *
                    2
            );
        }
        details[open]
            .panel-motion-layered[data-panel-motion='enter']
            .panel-motion-content
            > *:nth-child(4),
        [data-dropdown][open]
            .panel-motion-layered[data-panel-motion='enter']
            .panel-motion-content
            > *:nth-child(4) {
            animation-delay: calc(
                var(--panel-motion-content-delay-layered) + var(--panel-motion-stagger-step, 32ms) *
                    3
            );
        }
    }
    @layer snippets {
        .header-dropdown-super-menu__tab {
            padding-bottom: calc(var(--spacing) * 2);
            color: currentcolor;
            opacity: 0.6;
        }
    }
{% endstylesheet %}
