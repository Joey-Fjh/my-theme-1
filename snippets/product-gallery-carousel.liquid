{% comment %}
  Gallery layout: carousel — Swiper slider with pagination dots.
  Internal sub-snippet; always rendered inside product-gallery.liquid's x-data scope.

  @param {array}   images       - Image objects
  @param {boolean} zoom         - Enable click on slides
  @param {string}  aspect_ratio - Optional CSS aspect-ratio
{% endcomment %}

<div
  class="swiper overflow-hidden rounded-sm"
  data-gallery-swiper
  {% if aspect_ratio %}style="aspect-ratio: {{ aspect_ratio }}"{% endif %}
>
  <div class="swiper-wrapper">
    {%- for image in images -%}
      {%- assign media_image = image.preview_image | default: image -%}
      <div
        class="swiper-slide"
        {% if zoom %}@click="openZoom({{ forloop.index0 }})"{% endif %}
        {% if zoom %}style="cursor: zoom-in"{% endif %}
      >
        {%- render 'image',
          image: media_image,
          width: 1200,
          img_class: 'w-full h-full object-cover',
          alt: media_image.alt,
          sizes: '100vw',
          widths: '400,600,800,1200',
          loading: 'lazy'
        -%}
      </div>
    {%- endfor -%}
  </div>
  <div class="swiper-pagination mt-4"></div>
</div>
