{% doc %}
    Localized tax-inclusion notice driven by cart.taxes_included.

    Inclusive and exclusive copy use different locale keys. Exclusive cart copy
    keeps the existing cart.taxes_note semantics.

    @param {string} [class] - Optional extra CSS classes
{% enddoc %}

{%- if cart.taxes_included -%}
    <p class="product-tax-note{% if class != blank %} {{ class }}{% endif %}">
        {{ 'cart.taxes_included_note' | t }}
    </p>
{%- else -%}
    <p class="product-tax-note{% if class != blank %} {{ class }}{% endif %}">
        {{ 'cart.taxes_note' | t }}
    </p>
{%- endif -%}
