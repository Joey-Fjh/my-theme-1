{% comment %}
    Usage:

      <div x-data>
        {% render 'flip-digit', value: hours, length: hours.toString().length, unit: 'hour' %}
      </div>
{% endcomment %}

<template x-for="(digit, i) in $data.getValue('{{ value }}').split('')" :key="`{{ unit }}-${i}`">
    <div
        class="relative h-20 w-12 perspective-[1000px] md:h-32 md:w-20 lg:h-36 lg:w-24"
        x-data="{ prev: digit, oldDigit: digit }"
        x-effect="if (digit !== oldDigit) { prev = oldDigit; oldDigit = digit; }"
    >
        <!-- upper half -->
        <div
            class="
                absolute inset-x-0 top-0 h-1/2 origin-bottom overflow-hidden
                rounded-t-sm border-b border-[#1a231a]
                bg-[#2d3b2d] transition-transform duration-500
            "
            :class="{ '-rotate-x-90': prev !== digit }"
            style="transform-style: preserve-3d;"
        >
            <span
                class="
                    absolute inset-0 flex items-center justify-center
                    text-4xl font-bold text-[#c8e650] md:text-6xl lg:text-7xl
                "
                x-text="prev"
            ></span>
        </div>

        <!-- lower half -->
        <div
            class="
                absolute inset-x-0 bottom-0 h-1/2 origin-top overflow-hidden
                rounded-b-sm
                bg-[#354435] transition-transform delay-150 duration-500
            "
        >
            <span
                class="
                    absolute inset-0 flex items-center justify-center
                    text-4xl font-bold text-[#c8e650] md:text-6xl lg:text-7xl
                "
                x-text="digit"
            ></span>
        </div>

        <!-- center line -->
        <div class="absolute top-1/2 right-0 left-0 h-px bg-[#1a231a]"></div>

        <!-- Border decoration -->
        <div
            class="absolute top-1/2 left-0 h-2 w-1 -translate-y-1/2 rounded-r-sm bg-[#1a231a]"
        ></div>
        <div
            class="absolute top-1/2 right-0 h-2 w-1 -translate-y-1/2 rounded-l-sm bg-[#1a231a]"
        ></div>
    </div>
</template>
