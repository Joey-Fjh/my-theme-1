{% comment %}
    Usage:

      <div x-data>
        {% render 'flip-digit', value: hours, length: hours.toString().length, unit: 'hour' %}
      </div>
{% endcomment %}

<template
    x-for="(digit, i) in $data.getValue($el.dataset.flipValue).split('')"
    :key="`${$el.dataset.flipUnit}-${i}`"
    data-flip-value="{{ value }}"
    data-flip-unit="{{ unit | escape }}"
>
    <div
        class="relative h-24 w-14 rounded-sm bg-theme-text perspective-[1000px] pc:h-36 pc:w-24 fw:h-40 fw:w-28"
        x-data="flipDigit"
        x-effect="updateDigit(digit)"
    >
        <!-- Background Top (shows NEW digit) -->
        <div class="absolute inset-x-0 top-0 h-1/2 overflow-hidden rounded-t-sm border-b border-theme-bg/20 bg-theme-text brightness-95">
            <span
                class="flip-digit__value absolute inset-x-0 top-0 flex h-[200%] items-center justify-center"
                x-text="current"
            ></span>
        </div>

        <!-- Background Bottom (shows OLD digit until flip completes) -->
        <div class="absolute inset-x-0 bottom-0 h-1/2 overflow-hidden rounded-b-sm bg-theme-text">
            <span
                class="flip-digit__value absolute inset-x-0 bottom-0 flex h-[200%] items-center justify-center"
                x-text="prev"
            ></span>
        </div>

        <!-- Flipping Top (shows OLD digit, flips down) -->
        <div
            class="absolute inset-x-0 top-0 z-10 h-1/2 origin-bottom overflow-hidden rounded-t-sm border-b border-theme-bg/20 bg-theme-text brightness-95 backface-hidden"
            :class="flipping ? 'transition-transform duration-300 ease-in [transform:rotateX(-90deg)]' : '[transform:rotateX(0deg)]'"
        >
            <span
                class="flip-digit__value absolute inset-x-0 top-0 flex h-[200%] items-center justify-center"
                x-text="prev"
            ></span>
        </div>

        <!-- Flipping Bottom (shows NEW digit, flips down from 90deg) -->
        <div
            class="absolute inset-x-0 bottom-0 z-10 h-1/2 origin-top overflow-hidden rounded-b-sm bg-theme-text backface-hidden"
            :class="flipping ? 'transition-transform duration-300 ease-out delay-300 [transform:rotateX(0deg)]' : '[transform:rotateX(90deg)]'"
        >
            <span
                class="flip-digit__value absolute inset-x-0 bottom-0 flex h-[200%] items-center justify-center"
                x-text="current"
            ></span>
        </div>

        <!-- center line -->
        <div class="absolute top-1/2 right-0 left-0 z-20 h-px bg-theme-bg/20"></div>

        <!-- Border decoration -->
        <div
            class="absolute top-1/2 left-0 z-20 h-2 w-1 -translate-y-1/2 rounded-r-sm bg-theme-bg/20"
        ></div>
        <div
            class="absolute top-1/2 right-0 z-20 h-2 w-1 -translate-y-1/2 rounded-l-sm bg-theme-bg/20"
        ></div>
    </div>
</template>
