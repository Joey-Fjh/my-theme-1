{% comment %}
    Accordion Component
    --------------------------------------------------
    Accepts:
    - blocks:               {Array} Optional. Array of blocks with 'title' and 'text' settings.
    - titles:               {String} Optional. '|'-delimited titles (used when blocks is not provided).
    - contents:             {String} Optional. '|'-delimited HTML content strings (used when blocks is not provided).
    - initial_active:       {Number|String} Optional. Index of initially expanded item. Pass string 'null' to close all (Default: 0).
    - icon_type:            {String} Optional. Icon style for all items: 'chevron' | 'plus' (Default: 'chevron').
    - icon_size:            {String} Optional. Tailwind size classes for the icon (Default: 'w-5 h-5').
    - wrapper_class:        {String} Optional. CSS class for the outermost container.
    - item_class:           {String} Optional. CSS class for each accordion item.
    - title_active_class:   {String} Optional. CSS class for the title when active.
    - title_inactive_class: {String} Optional. CSS class for the title when inactive.
    - content_class:        {String} Optional. CSS class for the content wrapper.
    - icon_color_class:     {String} Optional. CSS class for icon color.
{% endcomment %}

{%- assign init_state = initial_active | default: 0 -%}
{%- assign icon_style = icon_type | default: 'chevron' -%}
{%- assign icon_dim = icon_size | default: 'w-5 h-5' -%}
{%- assign icon_color_class = icon_color_class | default: 'text-[#5a5a5a]' -%}
{%- assign icon_rotate = 'rotate-180' -%}
{%- if icon_style == 'plus' -%}{%- assign icon_rotate = 'rotate-45' -%}{%- endif -%}

<div
    x-data="{ active: {{ init_state }} }"
    class="{{ wrapper_class | default: 'flex flex-col gap-8' }}"
>
    {%- if blocks -%}
        {%- for block in blocks -%}
            <div
                class="{{ item_class | default: 'border-t border-[#d4d4d4] first:border-t-0' }}"
                {{ block.shopify_attributes }}
            >
                <button
                    type="button"
                    @click="active = active === {{ forloop.index0 }} ? null : {{ forloop.index0 }}"
                    class="group flex w-full cursor-pointer items-center justify-between py-5 text-left"
                >
                    <h2
                        class="font-bold transition-colors duration-300"
                        :class="
                            {
                                '{{ title_active_class | default: 'text-[#2d3a2e]' }}': active === {{ forloop.index0 }},
                                '{{ title_inactive_class | default: 'text-[#5a5a5a]' }}': active !== {{ forloop.index0 }}
                            }
                        "
                    >
                        {{ block.settings.title }}
                    </h2>

                    <span
                        class="ml-4 inline-block shrink-0 {{ icon_dim }} {{ icon_color_class }} transition-transform duration-300"
                        :class="{ '{{ icon_rotate }}': active === {{ forloop.index0 }} }"
                    >
                        {%- if icon_style == 'chevron' -%}
                            {% render 'icons',
                                icon: 'icon-arrow',
                                class: icon_dim,
                                color: 'current'
                            %}
                        {%- elsif icon_style == 'plus' -%}
                            {% render 'icons',
                                icon: 'icon-plus',
                                class: icon_dim,
                                color: 'current'
                            %}
                        {%- endif -%}
                    </span>
                </button>

                <div
                    class="grid transition-all duration-300 ease-in-out"
                    :class="active === {{ forloop.index0 }} ? 'grid-rows-[1fr] opacity-100' : 'grid-rows-[0fr] opacity-0'"
                >
                    <div class="-m-1 overflow-hidden p-1">
                        <div class="{{ content_class | default: 'pb-5 text-[#6b6b6b] leading-relaxed pr-8' }}">
                            {{ block.settings.text }}
                        </div>
                    </div>
                </div>
            </div>
        {%- endfor -%}
    {%- else -%}
        {%- assign title_array = titles | split: '|' -%}
        {%- assign content_array = contents | split: '|' -%}

        {%- for title in title_array -%}
            <div class="{{ item_class | default: 'border-t border-[#d4d4d4] first:border-t-0' }}">
                <button
                    type="button"
                    @click="active = active === {{ forloop.index0 }} ? null : {{ forloop.index0 }}"
                    class="group flex w-full cursor-pointer items-center justify-between py-5 text-left"
                >
                    <h2
                        class="font-bold transition-colors duration-300"
                        :class="
                            {
                                '{{ title_active_class | default: 'text-[#2d3a2e]' }}': active === {{ forloop.index0 }},
                                '{{ title_inactive_class | default: 'text-[#5a5a5a]' }}': active !== {{ forloop.index0 }}
                            }
                        "
                    >
                        {{ title }}
                    </h2>

                    <span
                        class="ml-4 inline-block shrink-0 {{ icon_dim }} {{ icon_color_class }} transition-transform duration-300"
                        :class="{ '{{ icon_rotate }}': active === {{ forloop.index0 }} }"
                    >
                        {%- if icon_style == 'chevron' -%}
                            {% render 'icons',
                                icon: 'icon-arrow',
                                class: icon_dim,
                                color: 'current'
                            %}
                        {%- elsif icon_style == 'plus' -%}
                            {% render 'icons',
                                icon: 'icon-plus',
                                class: icon_dim,
                                color: 'current'
                            %}
                        {%- endif -%}
                    </span>
                </button>

                <div
                    class="grid transition-all duration-300 ease-in-out"
                    :class="active === {{ forloop.index0 }} ? 'grid-rows-[1fr] opacity-100' : 'grid-rows-[0fr] opacity-0'"
                >
                    <div class="-m-1 overflow-hidden p-1">
                        <div class="{{ content_class | default: 'pb-5 text-[#6b6b6b] leading-relaxed pr-8' }}">
                            {{ content_array[forloop.index0] }}
                        </div>
                    </div>
                </div>
            </div>
        {%- endfor -%}
    {%- endif -%}
</div>
