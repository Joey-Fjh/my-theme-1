{% comment %}
    Accordion Component
    --------------------------------------------------
    Accepts:
    - blocks:               {Array} Required. Array of blocks containing accordion data (must include 'title' and 'text' settings).
    - initial_active:       {Number|String} Optional. The index of the initially expanded item. Pass 'null' to close all (Default: 0).
    - icon_type:            {String} Optional. The icon style, 'chevron' or 'plus' (Default: 'chevron').
    - wrapper_class:        {String} Optional. Custom CSS class for the outermost container.
    - item_class:           {String} Optional. Custom CSS class for each accordion item.
    - title_active_class:   {String} Optional. Custom CSS class for the title when active/expanded.
    - title_inactive_class: {String} Optional. Custom CSS class for the title when inactive/collapsed.
    - content_class:        {String} Optional. Custom CSS class for the expanded content wrapper.
{% endcomment %}

{%- assign init_state = initial_active | default: 0 -%}
{%- assign icon_style = icon_type | default: 'chevron' -%}

<div
    x-data="{ active: {{ init_state }} }"
    class="{{ wrapper_class | default: 'flex flex-col gap-8' }}"
>
    {%- for block in blocks -%}
        <div class="{{ item_class | default: 'border-t border-[#d4d4d4] first:border-t-0' }}" {{ block.shopify_attributes }}>
            <button
                type="button"
                @click="active = active === {{ forloop.index0 }} ? null : {{ forloop.index0 }}"
                class="flex w-full items-center justify-between py-5 text-left cursor-pointer group"
            >
                <h2
                    class="font-bold transition-colors duration-300"
                    :class="{ 
                        '{{ title_active_class | default: 'text-[#2d3a2e]' }}': active === {{ forloop.index0 }}, 
                        '{{ title_inactive_class | default: 'text-[#5a5a5a]' }}': active !== {{ forloop.index0 }} 
                    }"
                >
                    {{ block.settings.title }}
                </h2>

                {% comment %} Icon Render {% endcomment %}
                <div class="shrink-0 ml-4 text-[#5a5a5a]">
                    {%- if icon_style == 'chevron' -%}
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20" height="20" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                            class="transition-transform duration-300"
                            :class="{ 'rotate-180': active === {{ forloop.index0 }} }"
                        >
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    {%- elsif icon_style == 'plus' -%}
                        <div class="relative w-5 h-5 flex items-center justify-center">
                            <span class="absolute w-full h-[1.5px] bg-currentColor transition-transform duration-300" :class="{ 'rotate-180': active === {{ forloop.index0 }} }"></span>
                            <span class="absolute w-[1.5px] h-full bg-currentColor transition-transform duration-300" :class="{ 'rotate-90': active === {{ forloop.index0 }} }"></span>
                        </div>
                    {%- endif -%}
                </div>
            </button>
            
            {% comment %} Smooth Height Transition using CSS Grid {% endcomment %}
            <div 
                class="grid transition-all duration-300 ease-in-out"
                :class="active === {{ forloop.index0 }} ? 'grid-rows-[1fr] opacity-100' : 'grid-rows-[0fr] opacity-0'"
            >
                <div class="overflow-hidden">
                    <div class="{{ content_class | default: 'pb-5 text-[#6b6b6b] leading-relaxed pr-8' }}">
                        {{ block.settings.text }}
                    </div>
                </div>
            </div>
        </div>
    {%- endfor -%}
</div>