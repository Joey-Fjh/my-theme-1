{% comment %}
    Accordion Component
    --------------------------------------------------
    Accepts:
    - blocks:               {Array} Optional. Array of blocks with 'title' and 'text' settings.
    - titles:               {String} Optional. '|'-delimited titles (used when blocks is not provided).
    - contents:             {String} Optional. '|'-delimited HTML content strings (used when blocks is not provided).
    - initial_active:       {Number|String} Optional. Index of initially expanded item. Pass string 'null' to close all (Default: 0).
    - icon_type:            {String} Optional. Icon style for all items: 'chevron' | 'plus' (Default: 'chevron').
    - icon_size:            {String} Optional. Tailwind size classes for the icon (Default: 'w-5 h-5').
    - wrapper_class:        {String} Optional. CSS class for the outermost container.
    - item_class:           {String} Optional. CSS class for each accordion item.
    - title_active_class:   {String} Optional. CSS class for the title when active.
    - title_inactive_class: {String} Optional. CSS class for the title when inactive.
    - content_class:        {String} Optional. CSS class for the content wrapper.
    - icon_color_class:     {String} Optional. CSS class for icon color.
{% endcomment %}

{%- assign init_state = initial_active | default: 0 -%}
{%- assign icon_style = icon_type | default: 'chevron' -%}
{%- assign icon_dim = icon_size | default: 'w-5 h-5' -%}
{%- assign icon_color_class = icon_color_class | default: 'text-current' -%}
{%- assign icon_rotate = 'rotate-180' -%}
{%- if icon_style == 'plus' -%}{%- assign icon_rotate = 'rotate-45' -%}{%- endif -%}
{%- assign has_single_item = false -%}
{%- if item_title != blank -%}
    {%- assign has_single_item = true -%}
{%- endif -%}

<div
    x-data="{ active: {% if has_single_item %}{% if init_state == 'null' %}null{% else %}0{% endif %}{% else %}{{ init_state }}{% endif %} }"
    class="{{ wrapper_class | default: 'flex flex-col gap-8' }}"
>
    {%- if has_single_item -%}
        <div class="{{ item_class | default: 'border-t border-theme-border-soft first:border-t-0' }}">
            <button
                type="button"
                @click="active = active === 0 ? null : 0"
                class="group flex w-full cursor-pointer items-center justify-between py-5 text-left"
            >
                <div class="flex min-w-0 flex-1 items-center gap-3">
                    <h3
                        class="h4 transition-colors duration-300"
                        :class="
                            {
                                '{{ title_active_class | default: 'text-current' }}': active === 0,
                                '{{ title_inactive_class | default: 'text-current opacity-70' }}': active !== 0
                            }
                        "
                    >
                        {{ item_title }}
                    </h3>

                    {%- if show_clear and clear_url != blank -%}
                        <a
                            href="{{ clear_url }}"
                            class="inline-flex h-5 w-5 items-center justify-center opacity-65 transition-opacity hover:opacity-100"
                            aria-label="Clear {{ clear_label | default: item_title }}"
                            @click.stop
                        >
                            {% render 'icons', icon: 'icon-close', size: 'xs', color: 'current' %}
                        </a>
                    {%- endif -%}
                </div>

                <span
                    class="ml-4 inline-block shrink-0 {{ icon_dim }} {{ icon_color_class }} transition-transform duration-300"
                    :class="{ '{{ icon_rotate }}': active === 0 }"
                >
                    {%- if icon_style == 'chevron' -%}
                        {% render 'icons', icon: 'icon-arrow', class: icon_dim, color: 'current' %}
                    {%- elsif icon_style == 'plus' -%}
                        {% render 'icons', icon: 'icon-plus', class: icon_dim, color: 'current' %}
                    {%- endif -%}
                </span>
            </button>

            <div
                class="grid transition-all duration-300 ease-in-out"
                :class="active === 0 ? 'grid-rows-[1fr] opacity-100' : 'grid-rows-[0fr] opacity-0'"
            >
                <div class="-m-1 overflow-hidden p-1">
                    <div class="{{ content_class | default: 'body-md pb-5 pr-8 leading-relaxed text-current opacity-75' }}">
                        {{ item_content }}
                    </div>
                </div>
            </div>
        </div>
    {%- elsif blocks -%}
        {%- for block in blocks -%}
            <div
                class="{{ item_class | default: 'border-t border-theme-border-soft first:border-t-0' }}"
                {{ block.shopify_attributes }}
            >
                <button
                    type="button"
                    @click="active = active === {{ forloop.index0 }} ? null : {{ forloop.index0 }}"
                    class="group flex w-full cursor-pointer items-center justify-between py-5 text-left"
                >
                    <h2
                        class="h4 transition-colors duration-300"
                        :class="
                            {
                                '{{ title_active_class | default: 'text-current' }}': active === {{ forloop.index0 }},
                                '{{ title_inactive_class | default: 'text-current opacity-70' }}': active !== {{ forloop.index0 }}
                            }
                        "
                    >
                        {{ block.settings.title }}
                    </h2>

                    <span
                        class="ml-4 inline-block shrink-0 {{ icon_dim }} {{ icon_color_class }} transition-transform duration-300"
                        :class="{ '{{ icon_rotate }}': active === {{ forloop.index0 }} }"
                    >
                        {%- if icon_style == 'chevron' -%}
                            {% render 'icons',
                                icon: 'icon-arrow',
                                class: icon_dim,
                                color: 'current'
                            %}
                        {%- elsif icon_style == 'plus' -%}
                            {% render 'icons',
                                icon: 'icon-plus',
                                class: icon_dim,
                                color: 'current'
                            %}
                        {%- endif -%}
                    </span>
                </button>

                <div
                    class="grid transition-all duration-300 ease-in-out"
                    :class="active === {{ forloop.index0 }} ? 'grid-rows-[1fr] opacity-100' : 'grid-rows-[0fr] opacity-0'"
                >
                    <div class="-m-1 overflow-hidden p-1">
                        <div class="{{ content_class | default: 'body-md pb-5 pr-8 leading-relaxed text-current opacity-75' }}">
                            {{ block.settings.text }}
                        </div>
                    </div>
                </div>
            </div>
        {%- endfor -%}
    {%- else -%}
        {%- assign title_array = titles | split: '|' -%}
        {%- assign content_array = contents | split: '|' -%}

        {%- for title in title_array -%}
            <div class="{{ item_class | default: 'border-t border-theme-border-soft first:border-t-0' }}">
                <button
                    type="button"
                    @click="active = active === {{ forloop.index0 }} ? null : {{ forloop.index0 }}"
                    class="group flex w-full cursor-pointer items-center justify-between py-5 text-left"
                >
                    <h2
                        class="h4 transition-colors duration-300"
                        :class="
                            {
                                '{{ title_active_class | default: 'text-current' }}': active === {{ forloop.index0 }},
                                '{{ title_inactive_class | default: 'text-current opacity-70' }}': active !== {{ forloop.index0 }}
                            }
                        "
                    >
                        {{ title }}
                    </h2>

                    <span
                        class="ml-4 inline-block shrink-0 {{ icon_dim }} {{ icon_color_class }} transition-transform duration-300"
                        :class="{ '{{ icon_rotate }}': active === {{ forloop.index0 }} }"
                    >
                        {%- if icon_style == 'chevron' -%}
                            {% render 'icons',
                                icon: 'icon-arrow',
                                class: icon_dim,
                                color: 'current'
                            %}
                        {%- elsif icon_style == 'plus' -%}
                            {% render 'icons',
                                icon: 'icon-plus',
                                class: icon_dim,
                                color: 'current'
                            %}
                        {%- endif -%}
                    </span>
                </button>

                <div
                    class="grid transition-all duration-300 ease-in-out"
                    :class="active === {{ forloop.index0 }} ? 'grid-rows-[1fr] opacity-100' : 'grid-rows-[0fr] opacity-0'"
                >
                    <div class="-m-1 overflow-hidden p-1">
                        <div class="{{ content_class | default: 'body-md pb-5 pr-8 leading-relaxed text-current opacity-75' }}">
                            {{ content_array[forloop.index0] }}
                        </div>
                    </div>
                </div>
            </div>
        {%- endfor -%}
    {%- endif -%}
</div>
