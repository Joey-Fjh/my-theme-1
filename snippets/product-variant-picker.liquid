{% comment %}
    Renders product variant picker (Tailwind + Alpine.js).
    Supports Schema-driven picker_type (dropdown / button) and swatch_shape (circle / square / none).

    Accepts:
    - product: {Object} product object.
    - block: {Object} passing the block information (expects block.settings.picker_type, block.settings.swatch_shape).
    - product_form_id: {String} Id of the product form to which the variant picker is associated.

    Usage:
    {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}

{%- assign context = context | default: 'featured' -%}
{%- assign section_id = section_id | default: section.id -%}

{%- unless product.has_only_default_variant -%}
    {%- assign product_form_id = product_form_id | default: 'product-form-' | append: section_id -%}

    <div
        id="VariantPicker-{{ section_id }}"
        class="flex flex-col gap-4 pc:gap-5"
        data-section-id="{{ section_id }}"
        data-product-id="{{ product.id }}"
        data-product-form-id="{{ product_form_id }}"
        data-variants="{{ product.variants | json | escape }}"
        x-data="VariantPicker()"
        {{ block.shopify_attributes }}
    >
        {%- for option in product.options_with_values -%}
            {%- liquid
                assign picker_type = block.settings.picker_type | default: 'button'
                assign swatch_shape = block.settings.swatch_shape | default: 'circle'

                assign is_color = false
                assign downcase_option = option.name | downcase
                if downcase_option contains 'color' or downcase_option contains 'colour'
                    assign is_color = true
                endif

                assign option_name_escaped = option.name | escape
            -%}

            {%- if picker_type == 'dropdown' -%}
                {%- comment -%} ═══ Dropdown mode ═══ {%- endcomment -%}
                <div class="flex flex-col">
                    <label
                        class="body-md text-theme-text/80"
                        for="OptionDropdown-{{ section_id }}-{{ forloop.index0 }}"
                    >
                        {{ option.name }}:
                        <span
                            x-text="selectedOptions['{{ option_name_escaped }}']"
                            class="ml-1 font-medium text-theme-text"
                        >
                            {{- option.selected_value -}}
                        </span>
                    </label>

                    <div class="relative mt-5 p-0.5">
                        <select
                            id="OptionDropdown-{{ section_id }}-{{ forloop.index0 }}"
                            class="w-full cursor-pointer appearance-none rounded-sm border border-theme-border px-4 py-3 body-md text-theme-text focus:border-theme-border-strong focus:outline-none"
                            name="options[{{ option_name_escaped }}]"
                            form="{{ product_form_id }}"
                            x-model="selectedOptions['{{ option_name_escaped }}']"
                            @change="onVariantChange()"
                        >
                            {%- for value in option.values -%}
                                <option
                                    class="bg-theme-bg text-theme-text"
                                    value="{{ value | escape }}"
                                    {% unless value.available %}
                                        disabled
                                    {% endunless %}
                                    data-option-value-id="{{ value.id }}"
                                >
                                    {%- if value.available -%}
                                        {{- value -}}
                                    {%- else -%}
                                        {{- value }} — {{ 'products.product.sold_out' | t }}
                                    {%- endif -%}
                                </option>
                            {%- endfor -%}
                        </select>
                        <span
                            class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-theme-text/60"
                            aria-hidden="true"
                        >
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z"/>
                            </svg>
                        </span>
                    </div>
                </div>

            {%- else -%}
                {%- comment -%} ═══ Button mode (pills + swatches) ═══ {%- endcomment -%}
                <fieldset
                    class="flex flex-col"
                    role="radiogroup"
                    aria-label="{{ option.name }}"
                >
                    <legend class="body-md text-theme-text/80">
                        {{ option.name }}:
                        <span
                            x-text="selectedOptions['{{ option_name_escaped }}']"
                            class="ml-1 font-medium text-theme-text"
                        >
                            {{- option.selected_value -}}
                        </span>
                    </legend>

                    <div class="mt-5 flex flex-wrap gap-5 p-0.5">
                        {%- for value in option.values -%}
                            {%- liquid
                                assign swatch_bg = null
                                if value.swatch.image
                                    assign image_url = value.swatch.image | image_url: width: 50
                                    assign swatch_bg = 'url(' | append: image_url | append: ')'
                                elsif value.swatch.color
                                    assign swatch_bg = 'rgb(' | append: value.swatch.color.rgb | append: ')'
                                endif

                                assign escaped_value = value | escape
                                assign render_swatch = false
                                if swatch_bg or is_color
                                    if swatch_shape != 'none'
                                        assign render_swatch = true
                                    endif
                                endif

                                assign shape_class = 'rounded-full'
                                if swatch_shape == 'square'
                                    assign shape_class = 'rounded-sm'
                                endif
                            -%}

                            {%- capture input_id -%}VariantOption-{{ section_id }}-{{ option.position }}-{{ forloop.index0 }}{%- endcapture -%}

                            {%- if render_swatch -%}
                                {%- comment -%} ——— Swatch ——— {%- endcomment -%}
                                <label class="relative cursor-pointer" for="{{ input_id }}">
                                    <input
                                        type="radio"
                                        id="{{ input_id }}"
                                        class="peer sr-only"
                                        name="{{ option_name_escaped }}"
                                        value="{{ escaped_value }}"
                                        form="{{ product_form_id }}"
                                        x-model="selectedOptions['{{ option_name_escaped }}']"
                                        @change="onVariantChange()"
                                        data-option-value-id="{{ value.id }}"
                                    >
                                    <span
                                        class="block h-8 w-8 border transition-all {{ shape_class }} border-theme-border"
                                        :class="
                                            selectedOptions['{{ option_name_escaped }}'] === '{{ escaped_value }}'
                                            ? 'ring-2 ring-theme-text ring-offset-2 ring-offset-theme-bg'
                                            : 'hover:border-theme-border-strong'
                                        "
                                        {%- if swatch_bg %}
                                            style="background: {{ swatch_bg }}; background-size: cover;"
                                        {%- elsif is_color %}
                                            style="background-color: {{ value | handle }};"
                                        {%- endif %}
                                    ></span>
                                    {%- unless value.available -%}
                                        <span class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-60">
                                            <span
                                                class="block h-10 w-1 -translate-y-1 rotate-45 bg-theme-text/70"
                                            ></span>
                                        </span>
                                    {%- endunless -%}
                                    <span class="sr-only">
                                        {{ escaped_value }}
                                        {%- unless value.available %} - {{ 'products.product.sold_out' | t }}{%- endunless -%}
                                    </span>
                                </label>

                            {%- else -%}
                                {%- comment -%} ——— Pill ——— {%- endcomment -%}
                                <label class="relative cursor-pointer" for="{{ input_id }}">
                                    <input
                                        type="radio"
                                        id="{{ input_id }}"
                                        class="peer sr-only"
                                        name="{{ option_name_escaped }}"
                                        value="{{ escaped_value }}"
                                        form="{{ product_form_id }}"
                                        x-model="selectedOptions['{{ option_name_escaped }}']"
                                        @change="onVariantChange()"
                                        data-option-value-id="{{ value.id }}"
                                    >
                                    <span
                                        class="block rounded-sm border px-4 py-2 body-md transition-colors"
                                        :class="
                                            [
                                              selectedOptions['{{ option_name_escaped }}'] === '{{ escaped_value }}'
                                                ? 'border-theme-border-strong text-theme-text'
                                                : 'border-theme-border text-theme-text/70 hover:border-theme-border-strong hover:text-theme-text',
                                              !isValueAvailable('{{ option_name_escaped }}', '{{ escaped_value }}') && 'opacity-40 line-through'
                                            ]
                                        "
                                    >
                                        {{ value }}
                                    </span>
                                    {%- unless value.available -%}
                                        <span class="sr-only">{{ 'products.product.sold_out' | t }}</span>
                                    {%- endunless -%}
                                </label>
                            {%- endif -%}
                        {%- endfor -%}
                    </div>
                </fieldset>
            {%- endif -%}
        {%- endfor -%}
    </div>
{%- endunless -%}
