{% doc %}
    Renders product variant picker (Tailwind + Alpine.js).
    Supports Schema-driven picker_type (dropdown / button) and swatch_shape (circle / square / none).

    @param {product} product - Product object.
    @param [block] - Block object for shopify_attributes and settings (picker_type, swatch_shape). Optional when rendered outside section blocks (e.g. quick-view).
    @param {string} [product_form_id] - Form ID to associate inputs with. Defaults to 'product-form-' + section_id.
    @param {string} [context] - Rendering context: 'product' (PDP) or 'featured' (home/quick-view). Default: 'featured'.
    @param {string} [section_id] - Section ID for Alpine sync and element IDs. Expected from caller.
    @param {string} [gallery_id] - Optional product gallery element id for scoped slide-to requests.
    @param {boolean} [update_url] - When true, sync selected variant into the page URL. Defaults true only for context 'product'.

    Usage: {% render 'product-variant-picker', product: product, block: block, product_form_id:
    product_form_id, section_id: section_id %}
{% enddoc %}

{%- assign context = context | default: 'featured' -%}
{%- assign section_id = section_id | default: '' -%}
{%- assign gallery_id = gallery_id | default: '' -%}
{%- if update_url == null -%}
    {%- if context == 'product' -%}
        {%- assign update_url_enabled = true -%}
    {%- else -%}
        {%- assign update_url_enabled = false -%}
    {%- endif -%}
{%- elsif update_url == true or update_url == 'true' -%}
    {%- assign update_url_enabled = true -%}
{%- else -%}
    {%- assign update_url_enabled = false -%}
{%- endif -%}

{%- unless product.has_only_default_variant -%}
    {%- assign product_form_id = product_form_id | default: 'product-form-' | append: section_id -%}

    {%- capture variants_quantity_meta_json -%}
        {%- render 'product-variants-quantity-json', product: product -%}
    {%- endcapture -%}
    <div
        id="VariantPicker-{{ section_id }}"
        class="flex flex-col gap-4 pc:gap-5"
        data-section-id="{{ section_id }}"
        data-product-id="{{ product.id }}"
        data-product-form-id="{{ product_form_id }}"
        data-gallery-id="{{ gallery_id | escape }}"
        data-update-url="{% if update_url_enabled %}true{% else %}false{% endif %}"
        data-variants="{{ product.variants | json | escape }}"
        data-selected-variant-id="{{ product.selected_or_first_available_variant.id }}"
        data-variants-quantity-meta="{{ variants_quantity_meta_json | strip | escape }}"
        x-data="VariantPicker()"
        data-module-id="variant-picker"
        {% if block %}
            {{- block.shopify_attributes -}}
        {% endif %}
    >
        {%- for option in product.options_with_values -%}
            {%- liquid
                assign picker_type = block.settings.picker_type | default: 'button'
                assign swatch_shape = block.settings.swatch_shape | default: 'circle'

                assign is_color = false
                assign downcase_option = option.name | downcase
                if downcase_option contains 'color' or downcase_option contains 'colour'
                    assign is_color = true
                endif

                assign option_name_escaped = option.name | escape
            -%}

            {%- if picker_type == 'dropdown' -%}
                {%- comment -%} ═══ Dropdown mode ═══ {%- endcomment -%}
                <div class="flex flex-col">
                    <label
                        for="OptionDropdown-{{ section_id }}-{{ forloop.index0 }}"
                    >
                        {{ option.name }}:
                        <span
                            data-option-name="{{ option_name_escaped }}"
                            x-text="selectedOptions[$el.dataset.optionName]"
                            class="ms-1 body-md text-theme-text"
                        >
                            {{- option.selected_value -}}
                        </span>
                    </label>

                    <div class="relative mt-5 p-0.5">
                        <select
                            id="OptionDropdown-{{ section_id }}-{{ forloop.index0 }}"
                            class="field-select"
                            name="options[{{ option_name_escaped }}]"
                            form="{{ product_form_id }}"
                            data-option-name="{{ option_name_escaped }}"
                            x-model="selectedOptions[$el.dataset.optionName]"
                            @change="onVariantChange()"
                        >
                            {%- for value in option.values -%}
                                {%- assign escaped_value = value | escape -%}
                                <option
                                    class="bg-theme-bg text-theme-text"
                                    value="{{ escaped_value }}"
                                    data-option-name="{{ option_name_escaped }}"
                                    data-option-value="{{ escaped_value }}"
                                    data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
                                    data-option-value-id="{{ value.id }}"
                                    {% unless value.available %}
                                        disabled
                                    {% endunless %}
                                    :disabled="!isValueAvailable($el.dataset.optionName, $el.dataset.optionValue)"
                                    x-text="isValueAvailable($el.dataset.optionName, $el.dataset.optionValue) ? $el.dataset.optionValue : ($el.dataset.optionValue + ' — ' + $el.dataset.soldOutLabel)"
                                >
                                    {%- if value.available -%}
                                        {{- value -}}
                                    {%- else -%}
                                        {{- value }} — {{ 'products.product.sold_out' | t }}
                                    {%- endif -%}
                                </option>
                            {%- endfor -%}
                        </select>
                        <span
                            class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-theme-text/60"
                            aria-hidden="true"
                        >
                            {%- render 'icons', icon: 'icon-chevron-down' -%}
                        </span>
                    </div>
                </div>

            {%- else -%}
                {%- comment -%} ═══ Button mode (rectangular option buttons) ═══ {%- endcomment -%}
                <fieldset
                    class="variant-picker__fieldset flex flex-col"
                    role="radiogroup"
                    aria-label="{{ option.name | escape }}"
                >
                    <legend class="variant-picker__legend body-xs tracking-wide text-theme-text uppercase">
                        {{ option.name }}
                    </legend>

                    <div class="variant-picker__options mt-5 flex flex-wrap gap-3 p-0.5">
                        {%- for value in option.values -%}
                            {%- liquid
                                assign swatch_bg = null
                                if value.swatch.image
                                    assign image_url = value.swatch.image | image_url: width: 50
                                    assign swatch_bg = 'url(' | append: image_url | append: ')'
                                elsif value.swatch.color
                                    assign swatch_bg = 'rgb(' | append: value.swatch.color.rgb | append: ')'
                                endif

                                assign escaped_value = value | escape
                                assign render_swatch_dot = false
                                if swatch_bg or is_color
                                    if swatch_shape != 'none'
                                        assign render_swatch_dot = true
                                    endif
                                endif
                            -%}

                            {%- capture input_id -%}VariantOption-{{ section_id }}-{{ option.position }}-{{ forloop.index0 }}{%- endcapture -%}

                            <label class="relative cursor-pointer" for="{{ input_id }}">
                                <input
                                    type="radio"
                                    id="{{ input_id }}"
                                    class="peer sr-only"
                                    name="{{ option_name_escaped }}"
                                    value="{{ escaped_value }}"
                                    form="{{ product_form_id }}"
                                    data-option-name="{{ option_name_escaped }}"
                                    x-model="selectedOptions[$el.dataset.optionName]"
                                    @change="onVariantChange()"
                                    data-option-value-id="{{ value.id }}"
                                    {% if value == option.selected_value %}
                                        checked
                                    {% endif %}
                                >
                                <span
                                    class="variant-picker__option-button{% unless value.available %} is-unavailable{% endunless %}"
                                    data-option-name="{{ option_name_escaped }}"
                                    data-option-value="{{ escaped_value }}"
                                    :class="
                                        {
                                            'is-selected': selectedOptions[$el.dataset.optionName] === $el.dataset.optionValue,
                                            'is-unavailable': !isValueAvailable($el.dataset.optionName, $el.dataset.optionValue)
                                        }
                                    "
                                >
                                    {%- if render_swatch_dot -%}
                                        <span
                                            class="variant-picker__option-swatch variant-picker__option-swatch--{{ swatch_shape }}"
                                            aria-hidden="true"
                                            {%- if swatch_bg %}
                                                style="background: {{ swatch_bg }}; background-size: cover;"
                                            {%- elsif is_color %}
                                                style="background-color: {{ value | handle }};"
                                            {%- endif %}
                                        ></span>
                                    {%- endif -%}
                                    <span class="variant-picker__option-label body-md">
                                        {{- value -}}
                                    </span>
                                </span>
                                <span
                                    class="sr-only"
                                    data-option-name="{{ option_name_escaped }}"
                                    data-option-value="{{ escaped_value }}"
                                    {% if value.available %}
                                        hidden
                                    {% endif %}
                                    :hidden="isValueAvailable($el.dataset.optionName, $el.dataset.optionValue)"
                                >
                                    {{- 'products.product.sold_out' | t -}}
                                </span>
                            </label>
                        {%- endfor -%}
                    </div>
                </fieldset>
            {%- endif -%}
        {%- endfor -%}
    </div>
{%- endunless -%}

{% stylesheet %}
    @layer snippets {
        .variant-picker__option-button {
            display: inline-flex;
            min-height: calc(var(--spacing) * 10);
            cursor: pointer;
            align-items: center;
            gap: 0.5em;
            border-radius: var(--radius-sm);
            border-style: solid;
            border-width: 1px;
            padding-inline: 1.5em;
            padding-block: 0.75em;
            color: rgb(var(--color-foreground));
            border-color: rgba(var(--color-foreground), 0.16);
            background-color: transparent;
            transition:
                border-color var(--motion-duration-fast, 250ms) var(--motion-ease-default, ease),
                color var(--motion-duration-fast, 250ms) var(--motion-ease-default, ease),
                transform var(--motion-duration-fast, 250ms) var(--motion-ease-default, ease);
            @media (hover: hover) and (pointer: fine) {
                &:hover {
                    border-color: rgba(var(--color-foreground), 0.35);
                }
            }
            &.is-selected {
                border-color: rgb(var(--color-foreground));
            }
            &.is-unavailable {
                opacity: 0.45;
                text-decoration: line-through;
            }
        }

        .variant-picker__option-swatch {
            display: block;
            height: 0.75em;
            width: 0.75em;
            flex-shrink: 0;
            border-style: solid;
            border-width: 1px;
            border-color: rgba(var(--color-border), 0.35);
        }

        .variant-picker__option-swatch--circle {
            border-radius: calc(infinity * 1px);
        }

        .variant-picker__option-swatch--square {
            border-radius: var(--radius-sm);
        }

        .variant-picker__option-label {
            min-width: 0;
        }

        .peer:focus-visible + .variant-picker__option-button {
            outline: var(--focus-ring-width) solid
                rgba(var(--color-focus-ring), var(--focus-ring-opacity, 0.4));
            outline-offset: var(--focus-ring-offset);
        }

        .peer:active + .variant-picker__option-button:not(.is-unavailable) {
            transform: scale(0.98);
        }
    }
    @layer snippets {
        @media (prefers-reduced-motion: reduce) {
            .peer:active + .variant-picker__option-button:not(.is-unavailable) {
                transform: none;
            }
        }
    }
{% endstylesheet %}
