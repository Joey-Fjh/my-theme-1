{% doc %}
    Quick view-specific wrapper around buy-buttons.

    Keeps scene-specific parameters out of the shared buy-buttons API while
    preserving the existing quick view behavior.

    @param {product} product - Product object to purchase.
    @param {string} product_form_id - Bound product form id.
    @param {string} section_id - Runtime section scope for Alpine sync.
{% enddoc %}

{%- if settings.cart_type == 'drawer' -%}
    {%- assign qv_open_cart = true -%}
    {%- assign qv_dialog_id = 'cart-overlay-drawer' -%}
    {%- assign qv_success_msg = '' -%}
{%- else -%}
    {%- assign qv_open_cart = false -%}
    {%- assign qv_dialog_id = '' -%}
    {%- assign qv_success_msg = 'toast.added_to_cart' | t -%}
{%- endif -%}

{%- render 'buy-buttons',
    product: product,
    product_form_id: product_form_id,
    section_id: section_id,
    show_quantity: true,
    context: 'product',
    show_dynamic_checkout: false,
    show_buy_now: true,
    open_cart_on_add: qv_open_cart,
    open_dialog_id: qv_dialog_id,
    success_message: qv_success_msg,
    request_sections: false,
    cart_type: settings.cart_type
-%}
