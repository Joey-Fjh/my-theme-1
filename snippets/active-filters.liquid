{% doc %}
    Active filter chips / clear-all renderer for collection filter layouts.

    @param {object} filter_source - Optional. Pass collection/search object.
    @param {string} [layout] - Optional. 'drawer' | 'vertical' | 'horizontal'. Default: 'vertical'.
    @param {boolean} [show_label] - Optional. Whether to render the leading "Filter:" label. Default: true.
    @param {string} [clear_url] - Optional clear-all URL override. Search should pass a URL that keeps q/type/options[prefix].
{% enddoc %}

{%- assign filter_host = filter_source | default: collection | default: search -%}
{%- assign active_layout = layout | default: 'vertical' -%}
{%- assign show_label = show_label | default: true, allow_false: true -%}
{%- assign active_filter_count = 0 -%}

{%- for filter in filter_host.filters -%}
    {%- assign active_filter_count = active_filter_count | plus: filter.active_values.size -%}
    {%- if filter.type == 'price_range' -%}
        {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
            {%- assign active_filter_count = active_filter_count | plus: 1 -%}
        {%- endif -%}
    {%- endif -%}
{%- endfor -%}

{%- if active_filter_count > 0 -%}
    {%- liquid
        if clear_url != blank
            assign clear_all_url = clear_url
        elsif filter_host.url != blank
            assign clear_all_url = filter_host.url
        elsif filter_host.terms != blank
            assign clear_q = filter_host.terms | url_encode
            assign clear_all_url = routes.search_url | append: '?q=' | append: clear_q | append: '&options%5Bprefix%5D=last&type=product'
        else
            assign clear_all_url = request.path
        endif
    -%}

    {%- if active_layout == 'horizontal' -%}
        <div class="flex flex-wrap items-center gap-3">
            {%- if show_label -%}
                <span class="shrink-0">{{ 'collections.filters.active_label' | t }}</span>
            {%- endif -%}

            {%- for filter in filter_host.filters -%}
                {%- for value in filter.active_values -%}
                    <a
                        href="{{ value.url_to_remove }}"
                        class="active-filter-chip"
                        aria-label="{{ 'collections.filters.remove_filter' | t: filter: filter.label | escape }}"
                        @click.prevent="loadFilterAction($event)"
                    >
                        <span>{{ value.label }}</span>
                        {% render 'icons', icon: 'icon-close' %}
                    </a>
                {%- endfor -%}

                {%- if filter.type == 'price_range' -%}
                    {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
                        <a
                            href="{{ filter.url_to_remove }}"
                            class="active-filter-chip"
                            aria-label="{{ 'collections.filters.remove_filter' | t: filter: filter.label | escape }}"
                            @click.prevent="loadFilterAction($event)"
                        >
                            <span>
                                {{ filter.min_value.value | default: 0 | money }} -
                                {{ filter.max_value.value | default: filter.range_max | money }}
                            </span>
                            {% render 'icons', icon: 'icon-close' %}
                        </a>
                    {%- endif -%}
                {%- endif -%}
            {%- endfor -%}

            <a
                href="{{ clear_all_url }}"
                class="active-filters__clear-action shrink-0"
                @click.prevent="loadFilterAction($event)"
            >
                {{ 'collections.filters.clear_all' | t }}
            </a>
        </div>
    {%- else -%}
        <div class="flex flex-col gap-4 border-b border-line pb-6">
            <div class="flex items-center justify-between gap-4">
                {%- if show_label -%}
                    <span class="shrink-0">
                        {{- 'collections.filters.active_label' | t -}}
                    </span>
                {%- endif -%}

                <a
                    href="{{ clear_all_url }}"
                    class="active-filters__clear-action"
                    @click.prevent="loadFilterAction($event)"
                >
                    {{ 'collections.filters.clear_all' | t }}
                </a>
            </div>

            <div class="flex flex-wrap gap-3">
                {%- for filter in filter_host.filters -%}
                    {%- for value in filter.active_values -%}
                        <a
                            href="{{ value.url_to_remove }}"
                            class="active-filter-chip"
                            aria-label="{{ 'collections.filters.remove_filter' | t: filter: filter.label | escape }}"
                            @click.prevent="loadFilterAction($event)"
                        >
                            <span>{{ filter.label }}: {{ value.label }}</span>
                            {% render 'icons', icon: 'icon-close' %}
                        </a>
                    {%- endfor -%}

                    {%- if filter.type == 'price_range' -%}
                        {%- if filter.min_value.value != blank
                            or filter.max_value.value != blank
                        -%}
                            <a
                                href="{{ filter.url_to_remove }}"
                                class="active-filter-chip"
                                aria-label="{{ 'collections.filters.remove_filter' | t: filter: filter.label | escape }}"
                                @click.prevent="loadFilterAction($event)"
                            >
                                <span>
                                    {{ filter.min_value.value | default: 0 | money }} -
                                    {{ filter.max_value.value | default: filter.range_max | money }}
                                </span>
                                {% render 'icons', icon: 'icon-close' %}
                            </a>
                        {%- endif -%}
                    {%- endif -%}
                {%- endfor -%}
            </div>
        </div>
    {%- endif -%}
{%- endif -%}

{% stylesheet %}
    .active-filter-chip {
        display: inline-flex;
        min-height: calc(var(--spacing) * 10);
        align-items: center;
        gap: calc(var(--spacing) * 2);
        border-radius: calc(infinity * 1px);
        border-style: solid;
        border-width: 1px;
        border-color: var(--color-line);
        padding-inline: calc(var(--spacing) * 4);
        padding-block: calc(var(--spacing) * 2);
        transition-property:
            color, background-color, border-color, outline-color, text-decoration-color, fill,
            stroke, --tw-gradient-from, --tw-gradient-via, --tw-gradient-to;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        transition-duration: 150ms;
        &:hover {
            border-color: rgb(var(--color-foreground));
        }
    }
    .active-filters__clear-action {
        text-decoration: underline;
        text-underline-offset: 4px;
        &:focus-visible {
            outline: var(--focus-ring-width) solid
                rgba(var(--color-focus-ring), var(--focus-ring-opacity, 0.4));
            outline-offset: var(--focus-ring-offset);
        }
        transition: opacity var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease);
        &:hover {
            opacity: 0.8;
        }
    }
{% endstylesheet %}
