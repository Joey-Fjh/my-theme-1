{% doc %}
    Predictive search dropdown panel.

    Purpose:
    - Keep `sections/search.liquid` concise by moving dropdown panel markup here.
    - Render recommendation list + tabbed predictive results without changing Alpine behavior.

    Required parent scope (from `x-data="predictiveSearch"`):
    - State: `isOpen`, `isLoading`, `query`, `hasSearched`, `hasEmptyState`, `suggestions`, `products`, `articles`, `pages`
    - Methods: `onSuggestionClick`, `highlightSuggestion`, `performSearch`
    - Tab-control bindings exposed in parent scope: `registerTab`, `registerPanel`, `setActive`, `isActive`, `activeTab`

    @param {string} [mobile_card_columns] - Mobile product grid columns (`1` or `2`). Default: `2`.
{% enddoc %}

{%- liquid
    assign mobile_card_columns = mobile_card_columns | default: '2'
    assign mobile_grid_class = 'grid-cols-2'

    if mobile_card_columns == '1'
        assign mobile_grid_class = 'grid-cols-1'
    endif
-%}

<div
    x-cloak
    x-show="isOpen"
    class="panel-motion panel-motion-popover z-layer-popover absolute left-0 w-full overflow-hidden border border-theme-border/20 bg-theme-bg"
>
    <div class="flex max-h-[min(80dvh,44rem)] min-h-100 flex-col pc:flex-row">
        <aside class="w-full shrink-0 border-b border-theme-border/20 px-6 py-6 pc:w-62.5 pc:border-e pc:border-b-0">
            <h3 class="tracking-[0.16em] text-theme-text/60 uppercase">
                {{ 'search.recommendation' | t }}
            </h3>

            <template x-if="isLoading">
                <div class="space-y-4">
                    <div class="h-4 w-full animate-pulse bg-theme-border/20"></div>
                    <div class="h-4 w-2/3 animate-pulse bg-theme-border/20"></div>
                </div>
            </template>

            <template x-if="!isLoading && suggestions.length">
                <ul class="space-y-4">
                    <template x-for="(item, index) in suggestions" :key="item.text">
                        <li class="border-b border-theme-border/20 pb-2">
                            <button
                                type="button"
                                class="w-full text-start body-md text-theme-text transition-opacity hover:opacity-70"
                                @click="onSuggestionClick(item)"
                                x-html="highlightSuggestion(item.text)"
                            ></button>
                        </li>
                    </template>
                </ul>
            </template>

            <template x-if="!isLoading && hasSearched && !suggestions.length && query && !hasEmptyState">
                <p class="text-theme-text/60 italic">{{ 'search.no_suggestions' | t }}</p>
            </template>
        </aside>

        <div class="relative flex min-w-0 flex-1 flex-col overflow-y-auto px-6 py-6">
            <div
                x-show="isLoading"
                class="absolute inset-0 z-10 flex items-center justify-center bg-theme-bg/90"
            >
                {% render 'loading' %}
            </div>

            <div
                x-show="!isLoading && hasEmptyState && query"
                class="mt-10 flex h-full flex-col items-center justify-center text-center"
            >
                <p class="font-medium text-theme-text">
                    {{ 'search.not_found' | t }} "<span x-text="query"></span>"
                </p>
            </div>

            <div
                x-show="!isLoading && hasSearched && !hasEmptyState"
                class="flex w-full flex-1 flex-col"
            >
                {% capture tab_header %}
                    <div class="flex w-full gap-8 tracking-[0.16em] uppercase">
                        <button
                            type="button"
                            role="tab"
                            x-data="{ index: null }"
                            x-init="index = registerTab($el)"
                            @click="setActive(index); activeTab = 'products'"
                            class="search-predictive-panel__tab tab-nav-item tab-nav-item--search"
                            :class="{ 'is-active': isActive(index) }"
                        >
                            {{ 'search.products' | t }}
                        </button>

                        <button
                            type="button"
                            role="tab"
                            x-data="{ index: null }"
                            x-init="index = registerTab($el)"
                            @click="setActive(index); activeTab = 'articles'"
                            class="search-predictive-panel__tab tab-nav-item tab-nav-item--search"
                            :class="{ 'is-active': isActive(index) }"
                        >
                            {{ 'search.articles' | t }}
                        </button>

                        <button
                            type="button"
                            role="tab"
                            x-data="{ index: null }"
                            x-init="index = registerTab($el)"
                            @click="setActive(index); activeTab = 'pages'"
                            class="search-predictive-panel__tab tab-nav-item tab-nav-item--search"
                            :class="{ 'is-active': isActive(index) }"
                        >
                            {{ 'search.pages' | t }}
                        </button>
                    </div>
                {% endcapture %}

                {% capture tab_content %}
                    <div
                        role="tabpanel"
                        x-data="{ index: null }"
                        x-init="index = registerPanel($el)"
                        x-show="activeTab === 'products'"
                    >
                        <div class="grid {{ mobile_grid_class }} gap-6 pc:grid-cols-2">
                            <template x-for="product in products" :key="product.id">
                                {%- render 'predictive-search-product-card' -%}
                            </template>
                        </div>
                    </div>

                    <div
                        role="tabpanel"
                        x-data="{ index: null }"
                        x-init="index = registerPanel($el)"
                        x-show="activeTab === 'articles'"
                    >
                        <ul class="space-y-4">
                            <template x-for="article in articles" :key="article.id">
                                <li>
                                    <a
                                        class="search-predictive-panel__result-link interactive-link"
                                        :href="article.url"
                                        x-text="article.title"
                                    ></a>
                                </li>
                            </template>
                        </ul>

                        <p x-show="!articles.length" class="text-theme-text/60">{{ 'search.no_articles' | t }}</p>
                    </div>

                    <div
                        role="tabpanel"
                        x-data="{ index: null }"
                        x-init="index = registerPanel($el)"
                        x-show="activeTab === 'pages'"
                    >
                        <ul class="space-y-4">
                            <template x-for="page in pages" :key="page.id">
                                <li>
                                    <a
                                        class="search-predictive-panel__result-link interactive-link"
                                        :href="page.url"
                                        x-text="page.title"
                                    ></a>
                                </li>
                            </template>
                        </ul>

                        <p x-show="!pages.length" class="text-theme-text/60">{{ 'search.no_pages' | t }}</p>
                    </div>
                {% endcapture %}

                {%- render 'tab-control',
                    initialTabStrategy: 'first',
                    tab_header: tab_header,
                    tab_content: tab_content,
                    custom_class: 'w-full flex-1'
                -%}
            </div>

            <button
                type="button"
                class="mt-auto flex w-full items-center justify-between border-t border-theme-border/20 pt-4 text-theme-text hover:opacity-70"
                @click="performSearch()"
                x-show="query && hasSearched && !hasEmptyState"
            >
                <span>
                    {{ 'search.search_for' | t }} "<span class="font-medium" x-text="query"></span>"
                </span>
                {%- render 'icons', icon: 'icon-arrow2' -%}
            </button>
        </div>
    </div>
</div>
