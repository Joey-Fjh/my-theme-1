{% doc %}
    Product media gallery - reusable across sections and pages.
    Supports multiple layout modes, an optional lightbox overlay, and rich media types.

    @param {object} media - Product media list (preferred). Falls back to `images`.
    @param {object} [images] - Image list (legacy). Used when `media` is not provided.
    @param {string} [layout] - 'thumbnails' | 'carousel' | 'stacked' | 'grid' (default: thumbnails)
    @param {string} [thumb_position] - 'left' | 'bottom' (default: left, only for thumbnails layout)
    @param {string} [thumbnail_size] - Shared thumbnail size: 'compact' | 'standard' | 'large' (default: standard)
    @param {boolean} [zoom] - Enable click-to-zoom lightbox for images (default: false)
    @param {boolean} [magnifier] - Enable desktop hover magnifier on gallery images (default: false)
    @param {number} [magnifier_zoom_scale] - Background scale multiplier for magnifier (default: 2)
    @param {number} [magnifier_preview_width] - Optional fixed magnifier preview width in pixels
    @param {number} [magnifier_preview_height] - Optional fixed magnifier preview height in pixels
    @param {number} [magnifier_preview_max_width] - Maximum magnifier preview width in pixels
    @param {number} [zoom_overlay_opacity] - Lightbox overlay opacity in percent 0-100 (default: 90)
    @param {string} [aspect_ratio] - CSS aspect-ratio for main images (e.g. '1/1', '4/3'; default: natural)
    @param {string} [max_height] - Optional desktop max height for the main gallery media box
    @param {string} [class] - Optional CSS classes for the outermost wrapper
    @param {string} [id] - Optional HTML id for event-targeting (variant mapping)
    @param {string} [pagination] - Carousel pagination mode; pass `vertical` for left-stacked dots (default: horizontal below)
{% enddoc %}

{%- assign layout = layout | default: 'thumbnails' -%}
{%- assign gallery_pagination = pagination | default: '' -%}
{%- assign thumb_position = thumb_position | default: 'left' -%}
{%- assign thumbnail_size = thumbnail_size | default: 'standard' -%}
{%- assign zoom_enabled = false -%}
{%- if zoom == true or zoom == 'true' -%}
    {%- assign zoom_enabled = true -%}
{%- endif -%}
{%- assign magnifier_enabled = false -%}
{%- if magnifier == true or magnifier == 'true' -%}
    {%- assign magnifier_enabled = true -%}
{%- endif -%}
{%- assign magnifier_zoom_scale = magnifier_zoom_scale | default: 2 -%}
{%- assign magnifier_preview_width = magnifier_preview_width | default: 0 -%}
{%- assign magnifier_preview_height = magnifier_preview_height | default: 0 -%}
{%- assign magnifier_preview_max_width = magnifier_preview_max_width | default: 560 -%}
{%- assign zoom_overlay_opacity = zoom_overlay_opacity | default: 90 -%}
{%- assign gallery_aspect_mode = 'fixed' -%}
{%- if aspect_ratio == 'adapt' -%}
    {%- assign gallery_aspect_mode = 'adapt' -%}
{%- endif -%}

{%- comment -%} Determine gallery items: prefer media, fall back to images {%- endcomment -%}
{%- assign gallery_items = media -%}
{%- if gallery_items == blank -%}
    {%- assign gallery_items = images -%}
{%- endif -%}
{%- assign image_count = gallery_items | size -%}

{%- comment -%} Build image-only list for lightbox and count image-only items {%- endcomment -%}
{%- assign lightbox_images = gallery_items | where: 'media_type', 'image' -%}
{%- assign lightbox_image_count = lightbox_images.size | default: 0 -%}
{%- if lightbox_image_count == 0 -%}
    {%- assign lightbox_images = gallery_items -%}
    {%- assign lightbox_image_count = gallery_items.size -%}
{%- endif -%}

{%- comment -%} Check if we have non-image media types {%- endcomment -%}
{%- assign has_rich_media = false -%}
{%- assign media_dialog_id = '' -%}
{%- if media != blank -%}
    {%- for media_item in gallery_items -%}
        {%- if media_item.media_type != 'image' -%}
            {%- assign has_rich_media = true -%}
            {%- break -%}
        {%- endif -%}
    {%- endfor -%}
    {%- if has_rich_media and id != blank -%}
        {%- assign media_dialog_id = 'product-media-modal-' | append: id -%}
    {%- endif -%}
{%- endif -%}

<div
    x-data="productGallery"
    data-module-id="product-gallery"
    data-media-count="{{ image_count }}"
    class="product-gallery{% if class %} {{ class }}{% endif %}"
    data-gallery-aspect-mode="{{ gallery_aspect_mode }}"
    {% if id %}
        id="{{ id }}"
    {% endif %}
    {% if layout == 'carousel' %}
        data-swiper-src="{{ 'vendor-swiper.min.js' | asset_url }}"
    {% endif %}
    {% if media_dialog_id != blank %}
        data-media-modal-id="{{ media_dialog_id }}"
    {% endif %}
>
    <div
        class="h-full w-full"
        {% if zoom_enabled %}
            data-lightbox-image-count="{{ lightbox_image_count }}"
            x-data="imageLightbox()"
            data-module-id="image-lightbox"
            @keydown.escape.window="lightboxOpen && closeLightbox()"
            @keydown.right.window="lightboxOpen && nextLightbox()"
            @keydown.left.window="lightboxOpen && prevLightbox()"
        {% endif %}
    >
        {%- liquid
            case layout
                when 'thumbnails'
                    render 'product-gallery-thumbnails', images: gallery_items, gallery_id: id, thumb_position: thumb_position, thumbnail_size: thumbnail_size, zoom: zoom_enabled, magnifier: magnifier_enabled, magnifier_zoom_scale: magnifier_zoom_scale, magnifier_preview_width: magnifier_preview_width, magnifier_preview_height: magnifier_preview_height, magnifier_preview_max_width: magnifier_preview_max_width, aspect_ratio: aspect_ratio, max_height: max_height
                when 'carousel'
                    render 'product-gallery-carousel', images: gallery_items, zoom: zoom_enabled, magnifier: magnifier_enabled, magnifier_zoom_scale: magnifier_zoom_scale, magnifier_preview_width: magnifier_preview_width, magnifier_preview_height: magnifier_preview_height, magnifier_preview_max_width: magnifier_preview_max_width, aspect_ratio: aspect_ratio, max_height: max_height, pagination: gallery_pagination
                when 'stacked'
                    render 'product-gallery-stacked', images: gallery_items, zoom: zoom_enabled, magnifier: magnifier_enabled, magnifier_zoom_scale: magnifier_zoom_scale, magnifier_preview_width: magnifier_preview_width, magnifier_preview_height: magnifier_preview_height, magnifier_preview_max_width: magnifier_preview_max_width, aspect_ratio: aspect_ratio, max_height: max_height
                when 'grid'
                    render 'product-gallery-grid', images: gallery_items, zoom: zoom_enabled, magnifier: magnifier_enabled, magnifier_zoom_scale: magnifier_zoom_scale, magnifier_preview_width: magnifier_preview_width, magnifier_preview_height: magnifier_preview_height, magnifier_preview_max_width: magnifier_preview_max_width, aspect_ratio: aspect_ratio, max_height: max_height
            endcase
        -%}

        {%- if zoom_enabled -%}
            {%- render 'image-lightbox',
                images: lightbox_images,
                render_trigger: false,
                overlay_opacity: zoom_overlay_opacity
            -%}
        {%- endif -%}

        {%- if has_rich_media and media_dialog_id != blank -%}
            {%- render 'product-media-modal', id: media_dialog_id, media: gallery_items -%}
        {%- endif -%}
    </div>
</div>

{% stylesheet %}
    :where(.product-gallery) {
        height: 100%;
        width: 100%;
        min-width: 0;
    }

    .product-gallery[data-gallery-aspect-mode='adapt'] [role='tabpanel'] {
        aspect-ratio: auto;
        height: auto;
    }

    .product-gallery[data-gallery-aspect-mode='adapt'] .product-gallery__zoom-button {
        position: absolute;
        inset: 0;
        height: 100%;
    }

    .product-gallery[data-gallery-aspect-mode='adapt'] .product-gallery__zoom-button.is-active {
        position: relative;
        inset: auto;
        height: auto;
    }

    .product-gallery[data-gallery-aspect-mode='adapt']
        .product-gallery__zoom-button
        .theme-image[data-image-mode='natural'] {
        height: auto;
    }

    .product-gallery[data-gallery-aspect-mode='adapt'] [data-gallery-swiper] {
        aspect-ratio: auto;
        height: auto;
    }

    /* Adapt never crops: under the desktop height cap each main media box (frame or natural, magnifier and video poster
       included) narrows to cap × its own ratio instead of overflowing the panel. Stacked and grid mark their item list
       with [data-gallery-items]. Thumbnails, the lightbox and the media modal sit outside these containers. */
    @media (width >= 48rem) {
        .product-gallery[data-gallery-aspect-mode='adapt']
            :is([role='tabpanel'], [data-gallery-swiper], [data-gallery-items])
            .theme-image {
            width: min(
                100%,
                calc(var(--product-gallery-max-height, 1000vh) * (var(--aspect-ratio)))
            );
            height: auto;
            max-height: var(--product-gallery-max-height, none);
            margin-inline: auto;
        }

        .product-gallery[data-gallery-aspect-mode='adapt']
            :is([role='tabpanel'], [data-gallery-swiper], [data-gallery-items])
            .theme-image
            > .image_img {
            width: 100%;
            height: 100%;
        }
    }

    /* Grid rows stretch each item to its tallest neighbour at every width; a frame box (magnifier) keeps its own ratio. */
    .product-gallery[data-gallery-aspect-mode='adapt'] [data-gallery-items] .theme-image {
        height: auto;
    }

    /* The vertical-pagination carousel otherwise fills its column (min-height: 100%), which outranks the height cap. */
    @media (width >= 64rem) {
        .product-gallery[data-gallery-aspect-mode='adapt']
            .product-gallery-carousel--pagination-vertical {
            height: auto;
            min-height: 0;
        }
    }

    .product-gallery [role='tabpanel'] > .product-gallery__zoom-button:first-child {
        opacity: 1;
        z-index: 10;
        pointer-events: auto;
    }

    .product-gallery[data-gallery-hydrated]
        [role='tabpanel']
        > .product-gallery__zoom-button:first-child:not(.is-active) {
        opacity: 0;
        z-index: 0;
        pointer-events: none;
    }

    @keyframes product-gallery-media-fade-in {
        from {
            opacity: 0.35;
        }
        to {
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        body:not([data-motion-enabled='false'])
            .product-gallery[data-gallery-hydrated]
            .swiper-slide-active
            .theme-image
            img,
        body:not([data-motion-enabled='false'])
            .product-gallery[data-gallery-hydrated]
            [role='tabpanel']
            > .product-gallery__zoom-button.is-active
            .theme-image
            img {
            animation: product-gallery-media-fade-in 300ms var(--motion-ease-default, ease);
        }
    }
{% endstylesheet %}
