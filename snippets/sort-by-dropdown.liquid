{% comment %}
    Sort by dropdown — global reusable snippet.
    Uses the registered dropdown() Alpine component for toggle/close.

    @param {object} results  - Object with sort_options and sort_by (e.g. collection, search, blog).
    @param {string} form_id  - Optional. External form ID; triggers form change on select. Without it, dispatches 'sort-change' event.
    @param {string} class    - Optional. CSS classes for the outermost wrapper (positioning, sizing, etc.).
{% endcomment %}

{%- assign sort_options = results.sort_options -%}
{%- assign current_sort = results.sort_by | default: results.default_sort_by -%}
{%- capture q -%}"{%- endcapture -%}

<div
    x-data="dropdown"
    @click.outside="close(0)"
    @keydown.escape.window="close(0)"
    {% if class %}
        class="{{ class }}"
    {% endif %}
>
    <div
        x-data="{ sortBy: {{ current_sort | json | replace: q, '&quot;' }} }"
        class="relative"
        data-dropdown
        data-deep="0"
    >
        <input
            type="hidden"
            name="sort_by"
            :value="sortBy"
            {% if form_id %}
                form="{{ form_id }}"
            {% endif %}
        >

        <button
            type="button"
            class="flex cursor-pointer items-center gap-3 focus:outline-none"
            aria-haspopup="listbox"
            aria-label="Sort by"
            @click.stop.prevent="toggle($el.parentElement)"
        >
            <span>Sort by</span>
            {% render 'icons', icon: 'icon-sortby', class: 'h-10 w-10 shrink-0', color: 'current' %}
        </button>

        <div
            role="listbox"
            aria-label="Sort options"
            class="h3 absolute top-full right-0 z-20 min-w-100 rounded-md border border-[#e5e5e5] bg-white shadow-md"
            x-show="openEls[0]"
            x-cloak
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 -translate-y-3 scale-98"
            x-transition:enter-end="opacity-100 translate-y-0 scale-100"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 translate-y-0 scale-100"
            x-transition:leave-end="opacity-0 -translate-y-3 scale-98"
        >
            {%- for option in sort_options -%}
                <div
                    class="px-4 py-2"
                    role="option"
                    :aria-selected="sortBy === {{ option.value | json | replace: q, '&quot;' }}"
                >
                    <button
                        type="button"
                        class="block w-full text-left transition-opacity duration-150"
                        :class="sortBy === {{ option.value | json | replace: q, '&quot;' }} ? 'font-bold underline text-[#263D29]' : 'opacity-60 hover:opacity-100 text-[#263D29]'"
                        @click="
                            sortBy = {{ option.value | json | replace: q, '&quot;' }};
                            close(0);
                            {% if form_id %}
                              $nextTick(() => document.getElementById({{ form_id | json | replace: q, '&quot;' }})?.dispatchEvent(new Event('change', { bubbles: true })));
                            {% else %}
                              $dispatch('sort-change', sortBy);
                            {% endif %}
                        "
                    >
                        {{ option.name | escape }}
                    </button>
                </div>
            {%- endfor -%}
        </div>
    </div>
</div>
