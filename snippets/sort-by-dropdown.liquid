{% comment %}
    Sort by dropdown — global reusable snippet.
    Uses the registered dropdown() Alpine component for toggle/close.

    @param {object} results  - Object with sort_options and sort_by (e.g. collection, search, blog).
    @param {string} form_id  - Optional. External form ID; triggers form change on select. Without it, dispatches 'sort-change' event.
    @param {string} class    - Optional. CSS classes for the outermost wrapper (positioning, sizing, etc.).
{% endcomment %}

{%- assign sort_options = results.sort_options -%}
{%- assign current_sort = results.sort_by | default: results.default_sort_by -%}
{%- capture q -%}"{%- endcapture -%}
{%- assign wrapper_class = class | default: '' -%}
{%- assign trigger_class = trigger_class
    | default: 'flex cursor-pointer items-center gap-3 text-theme-text focus:outline-none'
-%}
{%- assign panel_class = panel_class
    | default: 'absolute top-full right-0 z-20 min-w-100 rounded-input border border-theme-border-soft bg-theme-bg shadow-surface'
-%}
{%- assign option_class = option_class
    | default: 'block w-full text-left body-md transition-opacity duration-150'
-%}
{%- assign option_active_class = option_active_class
    | default: 'font-bold underline text-current'
-%}
{%- assign option_inactive_class = option_inactive_class
    | default: 'opacity-60 hover:opacity-100 text-current'
-%}

<div
    x-data="dropdown"
    @click.outside="close(0)"
    @keydown.escape.window="close(0)"
    {% if wrapper_class != blank %}
        class="{{ wrapper_class }}"
    {% endif %}
>
    <div
        x-data="{ sortBy: {{ current_sort | json | replace: q, '&quot;' }} }"
        class="relative"
        data-dropdown
        data-deep="0"
    >
        <input
            type="hidden"
            name="sort_by"
            :value="sortBy"
            {% if form_id %}
                form="{{ form_id }}"
            {% endif %}
        >

        <button
            type="button"
            class="{{ trigger_class }}"
            aria-haspopup="listbox"
            aria-label="{{ 'accessibility.sort_by' | t }}"
            @click.stop.prevent="toggle($el.parentElement)"
        >
            <span>{{ 'collections.sort_by' | t }}</span>
            {% render 'icons',
                icon: 'icon-sortby',
                class: 'h-10 w-10 shrink-0',
                color: 'currentColor'
            %}
        </button>

        <div
            role="listbox"
            aria-label="{{ 'accessibility.sort_options' | t }}"
            class="{{ panel_class }}"
            x-show="openEls[0]"
            x-cloak
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 -translate-y-3 scale-98"
            x-transition:enter-end="opacity-100 translate-y-0 scale-100"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 translate-y-0 scale-100"
            x-transition:leave-end="opacity-0 -translate-y-3 scale-98"
        >
            {%- for option in sort_options -%}
                <div
                    class="px-4 py-2"
                    role="option"
                    :aria-selected="sortBy === {{ option.value | json | replace: q, '&quot;' }}"
                >
                    <button
                        type="button"
                        class="{{ option_class }}"
                        :class="sortBy === {{ option.value | json | replace: q, '&quot;' }} ? '{{ option_active_class }}' : '{{ option_inactive_class }}'"
                        @click="
                            sortBy = {{ option.value | json | replace: q, '&quot;' }};
                            close(0);
                            {% if form_id %}
                                $nextTick(() => document.getElementById({{ form_id | json | replace: q, '&quot;' }})?.dispatchEvent(new Event('change', { bubbles: true })));
                            {% else %}
                                $dispatch('sort-change', sortBy);
                            {% endif %}
                        "
                    >
                        {{ option.name | escape }}
                    </button>
                </div>
            {%- endfor -%}
        </div>
    </div>
</div>
