{% doc %}
    Generic loading indicator. Parent must provide Alpine scope with `isLoading`.
    x-cloak keeps it hidden until Alpine runs, so content stays visible without JavaScript.
    The spinner is decorative; a sibling role="status" region, always in the DOM, announces the loading text.

    @param {boolean} [overlay] - If true, render semi-transparent overlay and center spinner.
    @param {string} [overlay_class] - Tailwind background class for overlay.
    @param {string} [spinner_color] - Tailwind text color class for spinner (e.g. 'text-theme-text'); the spinner draws in currentColor.
    @param {string} [size] - 'small' | 'medium' | 'large' for spinner size.
{% enddoc %}
{%- liquid
    assign use_overlay = overlay | default: false
    assign overlay_class = overlay_class | default: 'bg-veil backdrop-blur-sm'
    assign color_class = spinner_color | default: 'text-theme-text'
    assign size_key = size | default: 'medium'

    case size_key
        when 'small'
            assign size_class = 'w-6 h-6'
        when 'large'
            assign size_class = 'w-12 h-12'
        else
            assign size_class = 'w-10 h-10'
    endcase
-%}
<div
    x-show="isLoading"
    x-cloak
    class="{% if use_overlay %}absolute inset-0 z-20 flex items-center justify-center {{ overlay_class }} {% else %}inline-flex items-center justify-center{% endif %}"
    aria-hidden="true"
>
    <div class="spinner {{ size_class }} {{ color_class }}"></div>
</div>
<div role="status" class="sr-only">
    <span x-show="isLoading" x-cloak>{{ 'accessibility.loading' | t }}</span>
</div>
