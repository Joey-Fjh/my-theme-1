{% comment %}
  Gallery layout: thumbnails — thumb strip + single active main image.
  Internal sub-snippet; always rendered inside product-gallery.liquid's x-data scope.

  @param {array}   images          - Image objects
  @param {string}  thumb_position  - 'left' | 'bottom'
  @param {boolean} zoom            - Enable click on main image
  @param {string}  aspect_ratio    - Optional CSS aspect-ratio
{% endcomment %}

{%- assign is_left = true -%}
{%- if thumb_position == 'bottom' -%}
  {%- assign is_left = false -%}
{%- endif -%}

<div 
  class="
    {% if is_left %}
      flex gap-4
    {% else %}
      flex flex-col gap-3
    {% endif %}
  "
>
  <div class="
    relative z-20
    {% if is_left %}
      grid gap-2 shrink-0 overflow-y-auto order-first [&::-webkit-scrollbar]:hidden
    {% else %}
      flex gap-2 overflow-x-auto order-last [&::-webkit-scrollbar]:hidden
    {% endif %}
  "
  {% if is_left %}
    style="grid-auto-rows:1fr"
  {% endif %}
  role="tablist" 
  aria-label="Product thumbnails"
>
    {%- for image in images -%}
      {%- assign media_image = image.preview_image | default: image -%}

      {%- liquid
        if is_left
          assign thumb_sizes = '80px'
          assign thumb_widths = '80,160,240'
        else
          assign thumb_sizes = '(min-width: 1024px) 150px, (min-width: 768px) 20vw, 25vw'
          assign thumb_widths = '100,150,200,300,400'
        endif
      -%}

      <button
        type="button"
        role="tab"
        :aria-selected="activeIndex === {{ forloop.index0 }}"
        @click="setActive({{ forloop.index0 }})"
        class="block overflow-hidden rounded-sm border-2 transition-all duration-200 cursor-pointer
          {% if is_left %}
            w-full min-h-0
          {% else %}
            w-20 h-20 shrink-0
          {% endif %}
        "
        :class="activeIndex === {{ forloop.index0 }}
          ? 'border-[#C5E147]'
          : 'border-transparent hover:border-gray-200'"
      >
        {%- render 'image',
          image: media_image,
          width: 400,
          img_class: 'w-full h-full object-cover',
          alt: media_image.alt,
          sizes: thumb_sizes,
          widths: thumb_widths,
          loading: 'lazy'
        -%}
      </button>
    {%- endfor -%}
  </div>

  <div
    class="flex-1 overflow-hidden rounded-sm grid grid-rows-1 grid-cols-1 bg-[#F3F3F3] 
    {% unless aspect_ratio %}
      aspect-square
    {% endunless %}"
    {% if aspect_ratio %}
      style="aspect-ratio: {{ aspect_ratio }}
    "{% endif %}
    role="tabpanel"
  >
    {%- for image in images -%}
      {%- assign media_image = image.preview_image | default: image -%}

      <div
        class="col-start-1 row-start-1 transition-opacity duration-300 ease-out w-full h-full min-h-0"
        :class="activeIndex === {{ forloop.index0 }} 
          ? 'opacity-100 z-10' 
          : 'opacity-0 z-0 pointer-events-none'
        "
        {% if zoom %}
          @click="openZoom({{ forloop.index0 }})"
          style="cursor: zoom-in"
        {% endif %}
      >
        {%- render 'image',
          image: media_image,
          width: 1200,
          img_class: 'w-full h-full object-cover',
          alt: media_image.alt,
          sizes: '(min-width: 48rem) 50vw, 100vw',
          widths: '400,600,800,1200',
          loading: 'lazy'
        -%}
      </div>
    {%- endfor -%}
  </div>
</div>
