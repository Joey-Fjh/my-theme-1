{% comment %}
    Gallery layout: thumbnails — thumb strip + single active main image.
    Internal sub-snippet; always rendered inside product-gallery.liquid's x-data scope.

    @param {array}   images          - Image objects
    @param {string}  thumb_position  - 'left' | 'bottom'
    @param {number}  thumbnail_visible_count - Number of visible thumbnails in left layout
    @param {boolean} zoom            - Enable click on main image
    @param {string}  aspect_ratio    - Optional CSS aspect-ratio (fallback when first image has no ratio)
{% endcomment %}

{%- assign is_left = true -%}
{%- if thumb_position == 'bottom' -%}
    {%- assign is_left = false -%}
{%- endif -%}

{%- comment -%} Dynamic gallery aspect from first image; fallback to passed aspect_ratio or 3/4 {%- endcomment -%}
{%- assign first_img = images.first -%}
{%- assign thumbnail_visible_count = thumbnail_visible_count | default: 4 | plus: 0 -%}
{%- if thumbnail_visible_count < 3 -%}
    {%- assign thumbnail_visible_count = 3 -%}
{%- elsif thumbnail_visible_count > 6 -%}
    {%- assign thumbnail_visible_count = 6 -%}
{%- endif -%}
{%- if first_img.width != blank and first_img.height != blank -%}
    {%- assign gallery_aspect = first_img.width | append: '/' | append: first_img.height -%}
{%- else -%}
    {%- assign gallery_aspect = images.first.aspect_ratio
        | default: aspect_ratio
        | default: '3/4'
    -%}
{%- endif -%}

<div
    class="
        {% if is_left %}
          flex flex-col pc:flex-row gap-4 pc:gap-2 min-w-0 w-full h-full
        {% else %}
          flex flex-col gap-3 min-w-0 w-full
        {% endif %}
    "
>
    <div
        style="--thumbnail-visible-count: {{ thumbnail_visible_count }};"
        class="
            relative z-0 shrink-0
            {% if is_left %}
              no-scrollbar order-last w-full flex flex-nowrap gap-2 overflow-x-auto pc:order-first pc:w-[clamp(6.25rem,16%,7rem)] pc:self-stretch pc:flex-col pc:overflow-y-auto pc:overflow-x-hidden
            {% else %}
              no-scrollbar order-last w-full min-w-0 flex flex-nowrap gap-2 overflow-x-auto
            {% endif %}
        "
        role="tablist"
        aria-label="Product thumbnails"
    >
        {%- if is_left -%}
            {%- for image in images -%}
                {%- assign media_image = image.preview_image | default: image -%}
                {%- assign thumb_sizes = '(min-width: 48rem) clamp(104px, 10vw, 136px), 80px' -%}
                {%- assign thumb_widths = '80,160,240,320,400' -%}
                <button
                    type="button"
                    role="tab"
                    :aria-selected="activeIndex === {{ forloop.index0 }}"
                    @click="setActive({{ forloop.index0 }})"
                    class="
                                                                                                                        block h-20 w-20 shrink-0 cursor-pointer overflow-hidden rounded-sm border-2 transition-all duration-200 pc:h-[calc((100%-((var(--thumbnail-visible-count)-1)*0.25rem))/var(--thumbnail-visible-count))] pc:w-full
                    "
                    :class="
                        activeIndex === {{ forloop.index0 }}
                        ? 'border-focus'
                        : 'border-transparent hover:border-theme-border'
                    "
                >
                    {%- render 'image',
                        image: media_image,
                        width: 400,
                        img_class: 'w-full h-full object-cover',
                        alt: media_image.alt,
                        sizes: thumb_sizes,
                        widths: thumb_widths,
                        loading: 'lazy',
                        aspect_ratio: '1/1'
                    -%}
                </button>
            {%- endfor -%}
        {%- else -%}
            {%- for image in images -%}
                {%- assign media_image = image.preview_image | default: image -%}
                {%- assign thumb_sizes = '(min-width: 1024px) 80px, (min-width: 768px) 72px, 64px' -%}
                {%- assign thumb_widths = '80,160,240' -%}
                <button
                    type="button"
                    role="tab"
                    :aria-selected="activeIndex === {{ forloop.index0 }}"
                    @click="setActive({{ forloop.index0 }})"
                    class="block h-20 w-20 shrink-0 cursor-pointer overflow-hidden rounded-sm border-2 transition-all duration-200"
                    :class="
                        activeIndex === {{ forloop.index0 }}
                        ? 'border-focus'
                        : 'border-transparent hover:border-theme-border'
                    "
                >
                    {%- render 'image',
                        image: media_image,
                        width: 400,
                        img_class: 'w-full h-full object-cover',
                        alt: media_image.alt,
                        sizes: thumb_sizes,
                        widths: thumb_widths,
                        loading: 'lazy',
                        aspect_ratio: '1/1'
                    -%}
                </button>
            {%- endfor -%}
        {%- endif -%}
    </div>

    <div
        class="relative min-w-0 flex-1 overflow-hidden rounded-sm bg-theme-bg"
        style="aspect-ratio: {{ gallery_aspect }};"
        role="tabpanel"
    >
        {%- for image in images -%}
            {%- assign media_image = image.preview_image | default: image -%}

            <div
                class="absolute inset-0 h-full w-full transition-opacity duration-300 ease-out"
                :class="
                    activeIndex === {{ forloop.index0 }}
                    ? 'opacity-100 z-10'
                    : 'opacity-0 z-0 pointer-events-none'
                "
                {% if zoom %}
                    @click="openZoom({{ forloop.index0 }})"
                    style="cursor: zoom-in"
                {% endif %}
            >
                {%- render 'image',
                    image: media_image,
                    width: 1200,
                    img_class: 'w-full h-full object-cover',
                    alt: media_image.alt,
                    sizes: '(min-width: 48rem) 50vw, 100vw',
                    widths: '400,600,800,1200',
                    loading: 'lazy'
                -%}
            </div>
        {%- endfor -%}
    </div>
</div>
