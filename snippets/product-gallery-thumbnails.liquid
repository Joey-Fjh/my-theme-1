{% comment %}
    Gallery layout: thumbnails - thumb strip + single active main image.
    Internal sub-snippet; always rendered inside product-gallery.liquid's x-data scope.

    @param {array}   images          - Image or media objects
    @param {string}  gallery_id      - Unique gallery id used to associate tabs and the active panel
    @param {string}  thumb_position  - 'left' | 'bottom'
    @param {number}  thumbnail_visible_count - Number of visible thumbnails in bottom thumbnail layout
    @param {boolean} zoom            - Enable click on main image
    @param {boolean} magnifier       - Enable desktop hover magnifier on main image
    @param {number}  magnifier_zoom_scale - Background scale multiplier for magnifier
    @param {number}  magnifier_preview_width - Optional fixed magnifier preview width in pixels
    @param {number}  magnifier_preview_height - Optional fixed magnifier preview height in pixels
    @param {number}  magnifier_preview_max_width - Maximum magnifier preview width in pixels
    @param {string}  aspect_ratio    - Optional CSS aspect-ratio (fallback when first image has no ratio)
    @param {string}  max_height      - Optional desktop max height for the main gallery media box
    @param {boolean} motion_reveal   - Allow nested image reveal hooks
{% endcomment %}

{%- assign is_left = true -%}
{%- if thumb_position == 'bottom' -%}
    {%- assign is_left = false -%}
{%- endif -%}

{%- comment -%} Product pages pass a design ratio so uploaded image orientation cannot resize the gallery. {%- endcomment -%}
{%- assign first_img = images.first -%}
{%- assign gallery_scope_id = gallery_id | default: first_img.id | default: 'product-gallery' -%}
{%- assign thumbnail_visible_count = thumbnail_visible_count | default: 4 | plus: 0 -%}
{%- if thumbnail_visible_count < 3 -%}
    {%- assign thumbnail_visible_count = 3 -%}
{%- elsif thumbnail_visible_count > 6 -%}
    {%- assign thumbnail_visible_count = 6 -%}
{%- endif -%}
{%- assign gallery_aspect = aspect_ratio -%}
{%- if gallery_aspect == blank and first_img.width != blank and first_img.height != blank -%}
    {%- assign gallery_aspect = first_img.width | append: '/' | append: first_img.height -%}
{%- elsif gallery_aspect == blank -%}
    {%- assign gallery_aspect = images.first.aspect_ratio | default: '3/4' -%}
{%- endif -%}
<div
    class="
        {% if is_left %}
          flex flex-col pc:grid pc:grid-cols-[minmax(auto,10%)_minmax(0,1fr)] gap-4 pc:gap-2 min-w-0 w-full h-full
        {% else %}
          flex flex-col gap-3 min-w-0 w-full
        {% endif %}
    "
>
    <div
        style="--thumbnail-visible-count: {{ thumbnail_visible_count }};"
        {% unless is_left %}
            x-data="dragScroll({ axis: 'x' })"
        {% endunless %}
        class="
            relative z-0 shrink-0
            {% if is_left %}
              no-scrollbar order-last w-full flex flex-nowrap gap-2 overflow-x-auto pc:order-first pc:w-full pc:self-stretch pc:flex-col pc:overflow-y-auto pc:overflow-x-hidden
            {% else %}
              no-scrollbar order-last w-full min-w-0 flex flex-nowrap gap-2 overflow-x-auto pc:min-h-0 pc:flex-[1_0_0%]
            {% endif %}
        "
        role="tablist"
        aria-label="{{ 'accessibility.product_thumbnails' | t }}"
        aria-orientation="{% if is_left %}vertical{% else %}horizontal{% endif %}"
        data-orientation="{% if is_left %}vertical{% else %}horizontal{% endif %}"
        @keydown="_handleThumbnailKeydown($event)"
    >
        {%- if is_left -%}
            {%- for image in images -%}
                {%- assign media_image = image.preview_image | default: image -%}
                {%- assign media_type = image.media_type | default: 'image' -%}
                {%- assign thumb_sizes = '(min-width: 48rem) clamp(104px, 10vw, 136px), 80px' -%}
                {%- assign thumb_widths = '80,160,240,320,400' -%}
                <button
                    type="button"
                    role="tab"
                    id="{{ gallery_scope_id | escape }}-thumbnail-{{ forloop.index0 }}"
                    aria-controls="{{ gallery_scope_id | escape }}-panel"
                    aria-label="{{ 'accessibility.show_media' | t: index: forloop.index | escape }}"
                    data-gallery-thumbnail="{{ forloop.index0 }}"
                    :tabindex="activeIndex === {{ forloop.index0 }} ? 0 : -1"
                    :aria-selected="activeIndex === {{ forloop.index0 }}"
                    @click="setActive({{ forloop.index0 }})"
                    class="product-gallery__thumbnail media-interaction-subtle relative block w-20 shrink-0 pc:w-full"
                    style="aspect-ratio: {{ gallery_aspect }};"
                    :class="activeIndex === {{ forloop.index0 }} && 'is-active'"
                >
                    {%- render 'image',
                        image: media_image,
                        width: 400,
                        img_class: 'w-full h-full object-cover overflow-hidden rounded-[inherit]',
                        alt: media_image.alt,
                        sizes: thumb_sizes,
                        widths: thumb_widths,
                        loading: 'lazy',
                        aspect_ratio: gallery_aspect,
                        motion_reveal: false
                    -%}
                    {%- if media_type != 'image' -%}
                        <span class="pointer-events-none absolute inset-0 flex items-center justify-center">
                            {%- if media_type == 'video' or media_type == 'external_video' -%}
                                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-theme-bg/80 text-theme-text shadow backdrop-blur-sm">
                                    {%- render 'icons',
                                        icon: 'icon-play',
                                        class: 'ms-0.5',
                                        size: 'xs'
                                    -%}
                                </span>
                            {%- elsif media_type == 'model' -%}
                                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-theme-bg/80 text-theme-text shadow backdrop-blur-sm">
                                    {%- render 'icons', icon: 'icon-3d-model', size: 'xs' -%}
                                </span>
                            {%- endif -%}
                        </span>
                    {%- endif -%}
                </button>
            {%- endfor -%}
        {%- else -%}
            {%- for image in images -%}
                {%- assign media_image = image.preview_image | default: image -%}
                {%- assign media_type = image.media_type | default: 'image' -%}
                {%- assign thumb_sizes = '(min-width: 1024px) 80px, (min-width: 768px) 72px, 64px' -%}
                {%- assign thumb_widths = '80,160,240' -%}
                <button
                    type="button"
                    role="tab"
                    id="{{ gallery_scope_id | escape }}-thumbnail-{{ forloop.index0 }}"
                    aria-controls="{{ gallery_scope_id | escape }}-panel"
                    aria-label="{{ 'accessibility.show_media' | t: index: forloop.index | escape }}"
                    data-gallery-thumbnail="{{ forloop.index0 }}"
                    :tabindex="activeIndex === {{ forloop.index0 }} ? 0 : -1"
                    :aria-selected="activeIndex === {{ forloop.index0 }}"
                    @click="setActive({{ forloop.index0 }})"
                    class="product-gallery__thumbnail media-interaction-subtle relative block w-20 shrink-0 pc:w-[calc((100%-((var(--thumbnail-visible-count)-1)*0.5rem))/var(--thumbnail-visible-count))]"
                    style="aspect-ratio: {{ gallery_aspect }};"
                    :class="activeIndex === {{ forloop.index0 }} && 'is-active'"
                >
                    {%- render 'image',
                        image: media_image,
                        width: 400,
                        img_class: 'w-full h-full object-cover overflow-hidden rounded-[inherit]',
                        alt: media_image.alt,
                        sizes: thumb_sizes,
                        widths: thumb_widths,
                        loading: 'lazy',
                        aspect_ratio: gallery_aspect,
                        motion_reveal: false
                    -%}
                    {%- if media_type != 'image' -%}
                        <span class="pointer-events-none absolute inset-0 flex items-center justify-center">
                            {%- if media_type == 'video' or media_type == 'external_video' -%}
                                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-theme-bg/80 text-theme-text shadow backdrop-blur-sm">
                                    {%- render 'icons',
                                        icon: 'icon-play',
                                        class: 'ms-0.5',
                                        size: 'xs'
                                    -%}
                                </span>
                            {%- elsif media_type == 'model' -%}
                                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-theme-bg/80 text-theme-text shadow backdrop-blur-sm">
                                    {%- render 'icons', icon: 'icon-3d-model', size: 'xs' -%}
                                </span>
                            {%- endif -%}
                        </span>
                    {%- endif -%}
                </button>
            {%- endfor -%}
        {%- endif -%}
    </div>

    <div
        class="
            relative min-w-0 flex-1 overflow-hidden rounded-sm bg-theme-bg
            pc:w-full
            {% if max_height != blank %}
              pc:max-h-(--product-gallery-max-height)
            {% endif %}
            {% unless is_left %}
              pc:min-h-0 pc:flex-[4_1_0%]
            {% endunless %}
        "
        style="
            aspect-ratio: {{ gallery_aspect }};
            {% if max_height != blank %}
                --product-gallery-max-height: {{ max_height }};
            {% endif %}
        "
        role="tabpanel"
        id="{{ gallery_scope_id | escape }}-panel"
        data-label-prefix="{{ gallery_scope_id | escape }}-thumbnail-"
        :aria-labelledby="$el.dataset.labelPrefix + activeIndex"
    >
        {%- assign image_only_index = 0 -%}
        {%- for image in images -%}
            {%- assign media_image = image.preview_image | default: image -%}
            {%- assign media_type = image.media_type | default: 'image' -%}

            {%- if zoom and media_type == 'image' -%}
                <button
                    type="button"
                    aria-label="{{ 'accessibility.open_image_zoom' | t }}"
                    class="product-gallery__zoom-button"
                    :class="activeIndex === {{ forloop.index0 }} && 'is-active'"
                    :tabindex="activeIndex === {{ forloop.index0 }} ? 0 : -1"
                    :aria-hidden="(activeIndex !== {{ forloop.index0 }}).toString()"
                    :inert="activeIndex !== {{ forloop.index0 }}"
                    @click="openLightbox({{ image_only_index }})"
                >
                    {%- assign image_only_index = image_only_index | plus: 1 -%}
            {%- elsif media_type != 'image' -%}
                <button
                    type="button"
                    class="product-gallery__zoom-button"
                    :class="activeIndex === {{ forloop.index0 }} && 'is-active'"
                    :tabindex="activeIndex === {{ forloop.index0 }} ? 0 : -1"
                    :aria-hidden="(activeIndex !== {{ forloop.index0 }}).toString()"
                    :inert="activeIndex !== {{ forloop.index0 }}"
                    @click="activateMediaById({{ image.id }})"
                    data-media-id="{{ image.id }}"
                    data-media-type="{{ media_type }}"
                    {% if media_type == 'model' %}
                        aria-label="{{ 'accessibility.view_3d_model' | t }}"
                    {% elsif media_type == 'video' or media_type == 'external_video' %}
                        aria-label="{{ 'accessibility.play_video' | t }}"
                    {% endif %}
                >
            {%- else -%}
                <div
                    class="product-gallery__zoom-button"
                    :class="activeIndex === {{ forloop.index0 }} && 'is-active'"
                    :aria-hidden="(activeIndex !== {{ forloop.index0 }}).toString()"
                    :inert="activeIndex !== {{ forloop.index0 }}"
                >
            {%- endif -%}
            {%- assign gallery_loading = 'lazy' -%}
            {%- assign gallery_fetchpriority = 'auto' -%}
            {%- if forloop.first -%}
                {%- assign gallery_loading = 'eager' -%}
                {%- assign gallery_fetchpriority = 'high' -%}
            {%- endif -%}

            {%- if media_type == 'image' -%}
                {%- if magnifier -%}
                    {%- render 'image-magnifier',
                        image: media_image,
                        width: 1200,
                        img_class: 'w-full h-full object-cover',
                        alt: media_image.alt,
                        sizes: '(min-width: 48rem) 50vw, 100vw',
                        widths: '400,600,800,1200',
                        loading: gallery_loading,
                        fetchpriority: gallery_fetchpriority,
                        zoom_scale: magnifier_zoom_scale,
                        preview_width: magnifier_preview_width,
                        preview_height: magnifier_preview_height,
                        preview_max_width: magnifier_preview_max_width,
                        motion_reveal: motion_reveal
                    -%}
                {%- else -%}
                    {%- render 'image',
                        image: media_image,
                        width: 1200,
                        img_class: 'w-full h-full object-cover',
                        alt: media_image.alt,
                        sizes: '(min-width: 48rem) 50vw, 100vw',
                        widths: '400,600,800,1200',
                        loading: gallery_loading,
                        fetchpriority: gallery_fetchpriority,
                        motion_reveal: motion_reveal
                    -%}
                {%- endif -%}
            {%- else -%}
                {%- render 'product-media',
                    media: image,
                    aspect_ratio: gallery_aspect,
                    sizes: '(min-width: 48rem) 50vw, 100vw',
                    widths: '400,600,800,1200',
                    loading: gallery_loading,
                    fetchpriority: gallery_fetchpriority,
                    motion_reveal: motion_reveal
                -%}
            {%- endif -%}

            {%- if zoom and media_type == 'image' -%}
                </button>
            {%- elsif media_type != 'image' -%}
                </button>
            {%- else -%}
                </div>
            {%- endif -%}
        {%- endfor -%}
    </div>
</div>
