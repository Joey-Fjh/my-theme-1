{% doc %}
    Renders an image with a desktop hover magnifier preview.

    @param {image} image - The image to render
    @param {string} [class] - Optional class for the magnifier wrapper
    @param {string} [img_class] - Optional class for the image
    @param {number} [width] - Image render width
    @param {number} [height] - Image render height
    @param {string} [crop] - Image crop position
    @param {string} [widths] - Responsive image widths
    @param {string} [sizes] - Responsive image sizes
    @param {string} [loading] - Image loading mode
    @param {string} [fetchpriority] - Optional fetchpriority attribute ('high', 'low', or 'auto')
    @param {string} [alt] - Image alt text
    @param {string} [aspect_ratio] - Optional image aspect ratio
    @param {number} [zoom_width] - Source width for the magnified preview image
    @param {number} [zoom_scale] - Background scale multiplier
    @param {string} [preview_mode] - Preview mode: 'magnify' follows pointer, 'contain' shows the full image
    @param {number} [preview_width] - Optional fixed preview width in pixels
    @param {number} [preview_height] - Optional fixed preview height in pixels
    @param {number} [preview_max_width] - Maximum preview width in pixels
    @param {number} [preview_gap] - Gap between image and preview in pixels
{% enddoc %}

{%- liquid
    assign width = width | default: 1200
    assign loading = loading | default: 'lazy'
    assign fetchpriority = fetchpriority
    assign img_class = img_class | default: 'w-full h-full object-cover'
    assign zoom_width = zoom_width | default: 2400
    assign zoom_scale = zoom_scale | default: 2
    assign preview_mode = preview_mode | default: 'magnify'
    assign preview_width = preview_width | default: 0
    assign preview_height = preview_height | default: 0
    assign preview_max_width = preview_max_width | default: 560
    assign preview_gap = preview_gap | default: 12
    assign alt = alt | default: ''
    assign zoom_image_url = image | image_url: width: zoom_width
-%}

<div
    x-data="imageMagnifier()"
    data-zoom-image="{{ zoom_image_url }}"
    data-zoom-scale="{{ zoom_scale }}"
    data-preview-mode="{{ preview_mode }}"
    data-preview-width="{{ preview_width }}"
    data-preview-height="{{ preview_height }}"
    data-preview-max-width="{{ preview_max_width }}"
    data-preview-gap="{{ preview_gap }}"
    class="image-magnifier h-full w-full {{ class }}"
    @pointerenter="openMagnifier($event)"
    @pointermove="moveMagnifier($event)"
    @pointerleave="closeMagnifier()"
>
    {%- render 'image',
        image: image,
        width: width,
        height: height,
        crop: crop,
        img_class: img_class,
        alt: alt,
        sizes: sizes,
        widths: widths,
        loading: loading,
        fetchpriority: fetchpriority,
        aspect_ratio: aspect_ratio
    -%}

    <template x-teleport="body">
        <div
            x-show="active"
            x-cloak
            :style="previewFrameStyle"
            class="z-layer-magnifier pointer-events-none hidden origin-top-left overflow-hidden rounded-sm bg-theme-bg shadow-2xl will-change-transform pc:block"
            aria-hidden="true"
        >
            <div
                class="absolute inset-0 transition-opacity duration-200 ease-out"
                :class="imageReady ? 'opacity-100' : 'opacity-0'"
                :style="previewImageStyle"
            ></div>
        </div>
    </template>
</div>
