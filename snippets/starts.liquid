{% doc %}
    Renders a row of star icons for a rating value.

    @param {number} rating - The numeric rating value (for example, 4.5). If omitted, defaults to `max`.
    @param {number} [max] - The maximum number of stars to display. Defaults to 5.
    @param {string} [wrapper_class] - Optional extra CSS classes for the outer wrapper.
    @param {string} [size] - Size preset for icons: 'sm', 'md', or 'lg'. Defaults to 'md'.

    @example
    {% render 'stars', rating: 4 %}
  {% render 'stars', rating: 4.5, size: 'sm' %}
  {% render 'stars', rating: 5, max: 10, size: 'lg', wrapper_class: 'justify-center' %}
{% enddoc %}

{% liquid
    assign max = max | default: 5
    assign rating = rating | default: max

    if max <= 0
        assign max = 5
    endif

    assign size = size | default: 'md'

    case size
        when 'sm'
            assign size_class = 'stars__icon--sm'
        when 'lg'
            assign size_class = 'stars__icon--lg'
        else
            assign size_class = 'stars__icon--md'
    endcase
%}

<div
    class="mb-6 inline-flex items-center gap-1 {{ wrapper_class }}"
    role="img"
    aria-label="{{ 'components.stars.rating_aria_label' | t: rating: rating, max: max }}"
>
    {% comment %}
        <span class="visually-hidden">
          {{ 'components.stars.rating_visually_hidden' | t: rating: rating, max: max }}
        </span>
    {% endcomment %}

    {% for i in (1..max) %}
        {% liquid
            if i <= rating
                assign is_filled = true
            else
                assign is_filled = false
            endif

            if is_filled
                assign fill_class = 'text-theme-text'
            else
                assign fill_class = 'text-theme-text/20'
            endif
        %}

        {%- render 'icons', icon: 'icon-star', size: 'md', class: 'stars__icon ' | append: size_class | append: ' ' | append: fill_class, color: 'current' -%}
    {% endfor %}
</div>

{% stylesheet %}
    .stars__icon {
        width: 1.25rem;
        height: 1.25rem;
        transition:
            transform 150ms ease-out,
            fill 150ms ease-out;
    }

    .stars__icon--sm {
        width: 0.875rem;
        height: 0.875rem;
    }

    .stars__icon--md {
        width: 1.25rem;
        height: 1.25rem;
    }

    .stars__icon--lg {
        width: 1.75rem;
        height: 1.75rem;
    }

    .stars__icon:hover {
        transform: scale(1.05);
    }
{% endstylesheet %}
