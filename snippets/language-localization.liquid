{%- comment -%}
    Renders the language picker for the localization form

    Accepts:
      - localPosition: pass in the position in which the form is coming up to create specific IDs
{%- endcomment -%}

{%- assign current_locale = localization.language.iso_code -%}
{%- assign available_locales = localization.available_languages -%}

{%- capture localization_content -%}
    <button
        type="button"
        x-ref="localizationTrigger"
        @click="open = !open"
        :aria-expanded="open"
        aria-haspopup="true"
        aria-controls="language-list-{{ localPosition }}"
        class="localization-toggle"
    >
        {{ localization.language.endonym_name | capitalize }}
    </button>

    <div
        id="language-list-{{ localPosition }}"
        x-show="open"
        x-cloak
        class="localization-menu panel-motion panel-motion-compact"
    >
        {%- for locale in available_locales -%}
            {%- assign is_current_locale = false -%}
            {%- if locale.iso_code == current_locale -%}
                {%- assign is_current_locale = true -%}
            {%- endif -%}
            {%- render 'localization-option',
                submit_name: 'locale_code',
                submit_value: locale.iso_code,
                is_current: is_current_locale,
                label: locale.endonym_name
            -%}
        {%- endfor -%}
    </div>
{%- endcapture -%}

{%- render 'localization-switcher', localPosition: localPosition, content: localization_content -%}
