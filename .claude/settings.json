{
  "enabledMcpjsonServers": [
    "shopify-dev-mcp",
    "context7"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.agents/tools/doctor-agent.mjs\" --hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/claude-hook.mjs\" prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/claude-hook.mjs\" pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/claude-hook.mjs\" post"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/claude-hook.mjs\" stop"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
        "PowerShell(npm.cmd run lint:theme)",
        "PowerShell(npm.cmd run lint:liquid-syntax)",
        "PowerShell(npm.cmd run lint:i18n)",
        "PowerShell(npm.cmd run lint:compat)",
        "PowerShell(npm.cmd run lint:doc-paths)",
        "PowerShell(npm.cmd run lint:records)",
        "PowerShell(npm.cmd run lint:merchant)",
        "PowerShell(npm.cmd run doctor:agent)",
        "PowerShell(npm.cmd run test:harness)",
        "PowerShell(npm.cmd run test:merchant)",
        "Bash(npm.cmd run lint:theme)",
        "Bash(npm.cmd run lint:liquid-syntax)",
        "Bash(npm.cmd run lint:i18n)",
        "Bash(npm.cmd run lint:compat)",
        "Bash(npm.cmd run lint:doc-paths)",
        "Bash(npm.cmd run lint:records)",
        "Bash(npm.cmd run lint:merchant)",
        "Bash(npm.cmd run doctor:agent)",
        "Bash(npm.cmd run test:harness)",
        "Bash(npm.cmd run test:merchant)"
    ]
  }
}
