{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
    <head>
        {% render 'css-variables' %}
        {{ 'tailwind.output.css' | asset_url | stylesheet_tag: preload: true }}
        {{ 'gift-card.css' | asset_url | stylesheet_tag }}
        {% render 'meta-tags' %}
        <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
        <script src="{{ 'gift-card.js' | asset_url }}" defer></script>
        {{ content_for_header }}
    </head>

    <body class="gift-card-page">
        <main class="gift-card-page__main">
            <header class="gift-card-page__brand">
                {% if settings.logo %}
                    {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
                    {{
                        settings.logo
                        | image_url: width: 320
                        | image_tag: alt: logo_alt, class: 'gift-card-page__logo', loading: 'eager'
                    }}
                {% else %}
                    <a class="gift-card-page__shop-name" href="{{ routes.root_url }}">
                        {{ shop.name }}
                    </a>
                {% endif %}
            </header>

            <article class="gift-card-page__card">
                <div class="gift-card-page__intro">
                    <p class="gift-card-page__eyebrow">{{ 'gift_card.card' | t }}</p>
                    <h1 class="heading-xl">{{ 'gift_card.title' | t }}</h1>
                    <p class="gift-card-page__balance">
                        {{ gift_card.balance | money_with_currency }}
                    </p>
                </div>

                <div class="gift-card-page__visual">
                    <img
                        src="{{ 'gift-card/card.svg' | shopify_asset_url }}"
                        alt=""
                        width="300"
                        height="200"
                    >
                </div>

                {% if gift_card.enabled == false or gift_card.expired %}
                    <p class="gift-card-page__status" role="status">
                        {{ 'gift_card.expired' | t }}
                    </p>
                {% endif %}

                {% if gift_card.expires_on %}
                    {% assign expires_on = gift_card.expires_on | date: '%B %e, %Y' %}
                    <p class="gift-card-page__meta">
                        {{ 'gift_card.expires_on' | t: expires_on: expires_on }}
                    </p>
                {% endif %}

                <div class="gift-card-page__redeem">
                    <p class="gift-card-page__instructions">
                        {{ 'gift_card.use_at_checkout' | t }}
                    </p>

                    <div
                        class="gift-card-page__qr"
                        data-gift-card-qr
                        data-identifier="{{ gift_card.qr_identifier | escape }}"
                        aria-hidden="true"
                    ></div>

                    <div class="gift-card-page__code-group">
                        <p class="gift-card-page__code-label">{{ 'gift_card.code_label' | t }}</p>
                        <code class="gift-card-page__code" data-gift-card-code>
                            {{- gift_card.code | format_code -}}
                        </code>
                        <button
                            class="gift-card-page__copy"
                            type="button"
                            data-gift-card-copy
                            data-code="{{ gift_card.code | escape }}"
                            data-success-message="{{ 'gift_card.code_copied' | t | escape }}"
                        >
                            {{ 'gift_card.copy_code' | t }}
                        </button>
                        <span
                            class="sr-only"
                            role="status"
                            aria-live="polite"
                            data-gift-card-copy-status
                        ></span>
                    </div>
                </div>

                <div class="gift-card-page__actions">
                    <a class="btn-primary btn w-full" href="{{ routes.root_url }}">
                        {{ 'gift_card.continue_shopping' | t }}
                    </a>

                    {% if gift_card.pass_url %}
                        <a class="gift-card-page__wallet-link" href="{{ gift_card.pass_url }}">
                            <img
                                src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                                alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
                                width="200"
                                height="60"
                            >
                        </a>
                    {% endif %}
                </div>
            </article>
        </main>
    </body>
</html>
