                "unit": "%",
                "label": "t:config.button.shadow_opacity",
                "default": 0
            },
            {
                "type": "range",
                "id": "button_shadow_horizontal_offset",
                "min": -12,
                "max": 12,
                "step": 2,
                "unit": "px",
                "label": "t:config.button.shadow_horizontal_offset",
                "default": 0
            },
            {
                "type": "range",
                "id": "button_shadow_vertical_offset",
                "min": -12,
                "max": 12,
                "step": 2,
                "unit": "px",
                "label": "t:config.button.shadow_vertical_offset",
                "default": 0
