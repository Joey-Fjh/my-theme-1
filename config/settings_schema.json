            {
                "type": "range",
                "id": "button_shadow_blur",
                "min": 0,
                "max": 20,
                "step": 2,
                "unit": "px",
                "label": "t:config.button.shadow_blur",
                "default": 0
            }
        ]
    },
    {
        "name": "t:config.surface.name",
        "settings": [
            {
                "type": "header",
                "content": "t:config.surface.border"
            },
            {
                "type": "range",
                "id": "surface_border_thickness",
                "min": 0,
                "max": 10,
                "step": 1,
                "unit": "px",
                "label": "t:config.surface.border_thickness",
                "default": 1
            },
            {
                "type": "range",
                "id": "surface_radius",
                "min": 0,
                "max": 48,
                "step": 2,
                "unit": "px",
                "label": "t:config.surface.radius",
                "default": 12
            },
            {
                "type": "header",
                "content": "t:config.surface.shadow"
            },
            {
                "type": "range",
                "id": "surface_shadow_opacity",
                "min": 0,
                "max": 100,
                "step": 5,
                "unit": "%",
                "label": "t:config.surface.shadow_opacity",
                "default": 0
            },
            {
                "type": "range",
                "id": "surface_shadow_horizontal_offset",
                "min": -20,
                "max": 20,
                "step": 2,
                "unit": "px",
                "label": "t:config.surface.shadow_horizontal_offset",
                "default": 0
            },
            {
                "type": "range",
                "id": "surface_shadow_vertical_offset",
                "min": -20,
                "max": 20,
                "step": 2,
                "unit": "px",
                "label": "t:config.surface.shadow_vertical_offset",
                "default": 0
            },
            {
                "type": "range",
                "id": "surface_shadow_blur",
                "min": 0,
                "max": 40,
                "step": 2,
                "unit": "px",
                "label": "t:config.surface.shadow_blur",
                "default": 0
            }
        ]
    },
    {
        "name": "t:config.focus.name",
        "settings": [
            {
                "type": "range",
                "id": "focus_ring_width",
                "min": 1,
                "max": 6,
                "step": 1,
                "unit": "px",
                "label": "t:config.focus.ring_width",
                "default": 2
            },
            {
                "type": "range",
                "id": "focus_ring_offset",
                "min": 0,
                "max": 8,
                "step": 1,
                "unit": "px",
                "label": "t:config.focus.ring_offset",
                "default": 2
            }
        ]
    },
    {
        "name": "t:config.social_icon.name",
        "settings": [
            {
                "type": "text",
                "id": "social_facebook_link",
                "label": "t:config.social_icon.facebook",
