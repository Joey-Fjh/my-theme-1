                "id": "button_border_thickness",
                "min": 0,
                "max": 10,
                "step": 1,
                "unit": "px",
                "label": "t:config.button.border_thickness",
                "default": 1
            },
            {
                "type": "range",
                "id": "button_radius",
                "min": 0,
                "max": 40,
