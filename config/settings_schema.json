[
    {
        "name": "theme_info",
        "theme_name": "Skeleton",
        "theme_version": "0.1.0",
        "theme_author": "Shopify",
        "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
        "theme_support_url": "https://support.shopify.com/"
    },
    {
        "name": "t:config.logo.name",
        "settings": [
            {
                "type": "image_picker",
                "id": "logo",
                "label": "t:config.logo.logo_label"
            },
            {
                "type": "range",
                "id": "logo_width",
                "min": 50,
                "max": 300,
                "step": 10,
                "default": 100,
                "unit": "px",
                "label": "t:config.logo.logo_width"
            },
            {
                "type": "image_picker",
                "id": "favicon",
                "label": "t:config.logo.favicon",
                "info": "t:config.logo.favicon_info"
            }
        ]
    },
    {
        "name": "t:general.typography",
        "settings": [
            {
                "type": "paragraph",
                "content": "t:config.typography.custom_font_info"
            },
            {
                "type": "header",
                "content": "t:config.typography.header"
            },
            {
                "type": "checkbox",
                "id": "use_custom_heading_font",
                "label": "t:config.typography.use_custom_heading_font",
                "default": false
            },
            {
                "type": "text",
                "id": "custom_heading_font_family",
                "label": "t:config.typography.custom_heading_font_family",
                "default": "Neue Montreal"
            },
            {
                "type": "text",
                "id": "custom_heading_font_url",
                "label": "t:config.typography.custom_heading_font_url",
                "default": "https://cdn.shopify.com/s/files/1/0000/0000/files/custom-heading-font.woff2"
            },
            {
                "type": "font_picker",
                "id": "type_header_font",
                "default": "mono",
                "label": "t:config.typography.heading_font"
            },
            {
                "type": "range",
                "id": "heading_scale",
                "min": 100,
                "max": 150,
                "unit": "%",
                "label": "t:config.typography.heading_scale",
                "default": 100
            },
            {
                "type": "header",
                "content": "t:config.typography.body"
            },
            {
                "type": "checkbox",
                "id": "use_custom_body_font",
                "label": "t:config.typography.use_custom_body_font",
                "default": false
            },
            {
                "type": "text",
                "id": "custom_body_font_family",
                "label": "t:config.typography.custom_body_font_family",
                "default": "Neue Montreal"
            },
            {
                "type": "text",
                "id": "custom_body_font_url",
                "label": "t:config.typography.custom_body_font_url",
                "default": "https://cdn.shopify.com/s/files/1/0000/0000/files/custom-heading-font.woff2"
            },
            {
                "type": "font_picker",
                "id": "type_body_font",
                "default": "mono",
                "label": "t:config.typography.body_font"
            },
            {
                "type": "range",
                "id": "body_scale",
                "min": 100,
                "max": 150,
                "unit": "%",
                "label": "t:config.typography.body_scale",
                "default": 100
            }
        ]
    },
    {
        "name": "t:general.layout",
        "settings": [
            {
                "type": "header",
                "content": "t:config.layout.page_settings"
            },
            {
                "type": "range",
                "id": "page_width",
                "min": 1000,
                "max": 1600,
                "step": 100,
                "default": 1200,
                "unit": "px",
                "label": "t:labels.page_width"
            },
            {
                "type": "range",
                "id": "page_margin",
                "min": 10,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "t:labels.page_margin",
                "default": 20
            },
            {
                "type": "header",
                "content": "t:config.layout.section_settings"
            },
            {
                "type": "range",
                "id": "section_padding_top",
                "min": 0,
                "max": 100,
                "step": 4,
                "unit": "px",
                "label": "t:config.layout.padding_top",
                "default": 0
            },
            {
                "type": "range",
                "id": "section_padding_bottom",
                "min": 0,
                "max": 100,
                "step": 4,
                "unit": "px",
                "label": "t:config.layout.padding_bottom",
                "default": 0
            }
        ]
    },
    {
        "name": "t:general.colors",
        "settings": [
            {
                "type": "color_scheme_group",
                "id": "color_schemes",
                "definition": [
                    {
                        "type": "color",
                        "id": "background_color",
                        "label": "t:labels.background",
                        "default": "#FFFFFF"
                    },
                    {
                        "type": "color_background",
                        "id": "background_gradient_color",
                        "label": "t:config.colors.background_gradient",
                        "info": "t:config.colors.background_gradient_info"
                    },
                    {
                        "type": "color",
                        "id": "icons_color",
                        "label": "t:config.colors.icons_color",
                        "default": "#111827"
                    },
                    {
                        "type": "color",
                        "id": "links_color",
                        "label": "t:config.colors.links_color",
                        "default": "#1D4ED8"
                    },
                    {
                        "type": "color",
                        "id": "border_color",
                        "label": "t:config.colors.border_color",
                        "default": "#111827"
                    },
                    {
                        "type": "color",
                        "id": "border_strong_color",
                        "label": "t:config.colors.strong_border_color",
                        "default": "#111827"
                    },
                    {
                        "type": "color",
                        "id": "focus_ring_color",
                        "label": "t:config.colors.focus_ring_color",
                        "default": "#1D4ED8"
                    },
                    {
                        "type": "color",
                        "id": "primary_button_label_color",
                        "label": "t:config.colors.primary_button_label_color",
                        "default": "#FFFFFF"
                    },
                    {
                        "type": "color",
                        "id": "secondary_button_label_color",
                        "label": "t:config.colors.secondary_button_label_color",
                        "default": "#1D4ED8"
                    },
                    {
                        "type": "color",
                        "id": "primary_button_background_color",
                        "label": "t:config.colors.primary_button_background_color",
                        "default": "#1D4ED8"
                    },
                    {
                        "type": "color",
                        "id": "primary_button_border_color",
                        "label": "t:config.colors.primary_button_border_color",
                        "default": "#1D4ED8"
                    },
                    {
                        "type": "color",
                        "id": "secondary_button_background_color",
                        "label": "t:config.colors.secondary_button_background_color",
                        "default": "#FFFFFF"
                    },
                    {
                        "type": "color",
                        "id": "secondary_button_border_color",
                        "label": "t:config.colors.secondary_button_border_color",
                        "default": "#1D4ED8"
                    },
                    {
                        "type": "color",
                        "id": "text_color",
                        "label": "t:config.colors.text_color",
                        "default": "#111827"
                    },
                    {
                        "type": "color",
                        "id": "badge_background_color",
                        "label": "t:config.colors.badge_background_color",
                        "default": "#1D4ED8"
                    },
                    {
                        "type": "color",
                        "id": "badge_label_color",
                        "label": "t:config.colors.badge_label_color",
                        "default": "#FFFFFF"
                    },
                    {
                        "type": "color",
                        "id": "badge_border_color",
                        "label": "t:config.colors.badge_border_color",
                        "default": "#1D4ED8"
                    }
                ],
                "role": {
                    "background": {
                        "solid": "background_color",
                        "gradient": "background_gradient_color"
                    },
                    "icons": "icons_color",
                    "links": "links_color",
                    "on_primary_button": "primary_button_label_color",
                    "on_secondary_button": "secondary_button_label_color",
                    "primary_button": "primary_button_background_color",
                    "primary_button_border": "primary_button_border_color",
                    "secondary_button": "secondary_button_background_color",
                    "secondary_button_border": "secondary_button_border_color",
                    "text": "text_color"
                }
            }
        ]
    },
    {
        "name": "t:config.input.name",
        "settings": [
            {
                "type": "header",
                "content": "t:config.input.border"
            },
            {
                "type": "range",
                "id": "input_border_thickness",
                "min": 0,
                "max": 10,
                "step": 1,
                "unit": "px",
                "label": "t:config.input.border_thickness",
                "default": 1
            },
            {
                "type": "range",
                "id": "input_radius",
                "min": 0,
                "max": 40,
                "step": 2,
                "unit": "px",
                "label": "t:config.input.radius",
                "default": 8
            },
            {
                "type": "header",
                "content": "t:config.input.shadow"
            },
            {
                "type": "range",
                "id": "input_shadow_opacity",
                "min": 0,
                "max": 100,
                "step": 5,
                "unit": "%",
                "label": "t:config.input.shadow_opacity",
                "default": 0
            },
            {
                "type": "range",
                "id": "input_shadow_horizontal_offset",
                "min": -12,
                "max": 12,
                "step": 2,
                "unit": "px",
                "label": "t:config.input.shadow_horizontal_offset",
                "default": 0
            },
            {
                "type": "range",
                "id": "input_shadow_vertical_offset",
                "min": -12,
                "max": 12,
                "step": 2,
                "unit": "px",
                "label": "t:config.input.shadow_vertical_offset",
                "default": 0
            },
            {
                "type": "range",
                "id": "input_shadow_blur",
                "min": 0,
                "max": 20,
                "step": 5,
                "unit": "px",
                "label": "t:config.input.shadow_blur",
                "default": 0
            }
        ]
    },
