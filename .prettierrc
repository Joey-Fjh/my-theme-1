{
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "singleQuote": true,
    "plugins": ["@shopify/prettier-plugin-liquid", "prettier-plugin-tailwindcss"],
    "tailwindStylesheet": "./assets/tailwind.input.css",
    "overrides": [
        {
            "files": ["*.liquid"],
            "options": {
                "singleQuote": false,
                "liquidSingleQuote": true
            }
        }
    ]
}
