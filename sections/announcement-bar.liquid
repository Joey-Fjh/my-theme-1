{%- liquid
    assign social_icons = true
    if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
        assign social_icons = false
    endif
    if section.settings.enable_country_selector or section.settings.enable_language_selector
        assign language_country_selector = true
    endif
    if section.blocks.size > 0
        assign announcement_bar = true
    endif
-%}

<div
    data-section-id="{{ section.id }}"
    class="announcement-bar-section full-width color-{{ section.settings.color_scheme }}"
    data-component-kind="section"
    data-component-type="announcement-bar"
    data-component-id="{{ section.id }}"
>
    <div class="container-page">
        <div
            class="
                grid grid-cols-1 py-3
                {% if announcement_bar and language_country_selector or section.settings.show_social and social_icons %}
                  pc:grid-cols-3 announcement-bar__cols-3
                {% elsif language_country_selector or section.settings.show_social and social_icons %}
                  pc:grid-cols-2 announcement-bar__cols-2
                {% endif %}
            "
        >
            {%- if section.settings.show_social -%}
                {%- render 'social-icons', visibility_class: 'max-pc:hidden' -%}
            {%- endif -%}

            {%- if announcement_bar -%}
                <div
                    class="flex items-center gap-2 overflow-hidden break-all"
                    style="grid-area: announcements"
                >
                    {%- if section.blocks.size > 0 -%}
                        <div
                            class="swiper h-full w-full min-w-0"
                            role="region"
                            aria-label="{{ 'accessibility.announcements' | t }}"
                            aria-roledescription="{{ 'accessibility.carousel' | t }}"
                        >
                            <div class="swiper-wrapper">
                                {%- for block in section.blocks -%}
                                    <div
                                        class="swiper-slide flex flex-wrap gap-6"
                                        {{ block.shopify_attributes }}
                                    >
                                        <span>
                                            {{- block.settings.announcement_text -}}
                                        </span>

                                        {%- if section.settings.link != blank -%}
                                            {%- capture link_content -%}
                                              <span>{{ section.settings.text }}</span>
                                              {%- render 'icons',icon: 'icon-arrow2', class:"ml-3" -%}
                                            {%- endcapture -%}

                                            {%- render 'link',
                                                href: section.settings.link,
                                                content: link_content,
                                                variant: 'underline'
                                            -%}
                                        {%- endif -%}
                                    </div>
                                {%- endfor -%}
                            </div>
                        </div>
                    {%- endif -%}
                </div>
            {%- endif -%}

            <div
                class=" flex items-center justify-end gap-3 max-pc:hidden"
                style="grid-area: language-currency"
            >
                {%- if section.settings.enable_country_selector -%}
                    {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
                {%- endif -%}

                {%- if section.settings.enable_language_selector -%}
                    {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
                {%- endif -%}
            </div>
        </div>
    </div>
</div>

{% javascript %}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components) return;

        Components.register(
            'announcement-bar',
            {
                init(el) {
                    const swiperContainer = el.querySelector('.swiper');
                    if (!swiperContainer || typeof Swiper === 'undefined') return null;

                    const slides = el.querySelectorAll('.swiper-slide');

                    const swiper = new Swiper(swiperContainer, {
                        loop: slides.length > 1,
                        slidesPerView: 1,
                        allowTouchMove: false,
                        effect: 'fade',
                        fadeEffect: {
                            crossFade: true,
                        },
                        pagination: false,
                        navigation: false,
                    });

                    return { swiper };
                },

                destroy(el, state) {
                    if (!state) return;

                    if (state.swiper && typeof state.swiper.destroy === 'function') {
                        state.swiper.destroy(true, true);
                    }
                },
            },
            { lazy: true },
        );
    })();
{% endjavascript %}

{% stylesheet %}
    .announcement-bar {
        position: absolute;
        z-index: 9999;
    }

    .announcement-bar-section {
        .announcement-bar__cols-3 {
            grid-template-areas: 'social-icons announcements language-currency';
        }

        .announcement-bar__cols-2 {
            grid-template-areas: 'social-icons language-currency';
        }

        .swiper-slide {
            display: flex;
            align-items: center;
            justify-content: center;
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.announcement-bar.name",
    "tag": "section",
    "class": "section announcement-bar",
    "limit": 1,
    "max_blocks": 6,
    "enabled_on": {
        "groups": ["header"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.announcement-bar.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "inline_richtext",
            "id": "text",
            "default": "t:sections.announcement-bar.defaults.text",
            "label": "t:sections.announcement-bar.settings.text"
        },
        {
            "type": "url",
            "id": "link",
            "label": "t:sections.announcement-bar.settings.link"
        },
        {
            "type": "header",
            "content": "t:sections.announcement-bar.content.public_settings"
        },
        {
            "type": "paragraph",
            "content": "t:sections.announcement-bar.content.only_displayed_on_large_screens"
        },
        {
            "type": "checkbox",
            "id": "show_social",
            "default": false,
            "label": "t:sections.announcement-bar.settings.social_icon",
            "info": "t:sections.announcement-bar.info.manage_social_accounts_editor_context_th"
        },
        {
            "type": "checkbox",
            "id": "enable_country_selector",
            "default": false,
            "label": "t:sections.announcement-bar.settings.country_region_selector",
            "info": "t:sections.announcement-bar.info.manage_countries_regions_admin_settings_"
        },
        {
            "type": "checkbox",
            "id": "enable_language_selector",
            "default": false,
            "label": "t:sections.announcement-bar.settings.language_selector",
            "info": "t:sections.announcement-bar.info.manage_languages_admin_settings_language"
        }
    ],
    "blocks": [
        {
            "type": "announcement",
            "name": "t:sections.announcement-bar.blocks.announcement",
            "settings": [
                {
                    "type": "inline_richtext",
                    "id": "announcement_text",
                    "default": "t:sections.announcement-bar.defaults.announcement_text",
                    "label": "t:sections.announcement-bar.block_settings.text"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.announcement-bar.presets.announcement_bar",
            "blocks": [
                {
                    "type": "announcement"
                },
                {
                    "type": "announcement"
                },
                {
                    "type": "announcement"
                }
            ]
        }
    ]
}
{% endschema %}
