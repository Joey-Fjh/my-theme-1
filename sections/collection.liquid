<div
    data-section-id="{{ section.id }}"
    class="collection-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-pagination-section-id="{{ section.id }}"
    data-pagination-selectors='["[data-collection-dynamic-content]","[data-collection-drawer-shell]"]'
    x-data="collectionFilters()"
>
    {%- liquid
        assign collection_heading_class = section.settings.heading_size | default: 'heading-4xl'
        assign collection_subtitle_class = section.settings.subtitle_size | default: 'body-xl'
    -%}
    <div class="layout layout-no-pb container-page pb-0">
        {%- comment -%} Hero {%- endcomment -%}
        <div
            class="relative py-20 pc:py-40"
            x-data="motionRevealSection()"
            data-motion-section
        >
            <div class="flex items-start justify-between">
                <div data-motion-reveal="content">
                    {%- render 'listing-page-hero-copy',
                        setting_header: section.settings.header,
                        object_title: collection.title,
                        header_locale_key: 'collections.products',
                        setting_description: section.settings.description,
                        description_locale_key: 'collections.description_html',
                        heading_class: collection_heading_class,
                        description_class: collection_subtitle_class
                    -%}
                </div>

                <div data-motion-reveal="media">
                    {%- render 'rotating-badge',
                        classes: 'relative justify-self-center',
                        badge_class: 'text-theme-text',
                        center_class: 'text-theme-text',
                        unique_id: section.id,
                        size: 100,
                        badge_text: section.settings.rotate_badge_text,
                        center_text: section.settings.rotate_badge_percent
                    -%}
                </div>
            </div>
        </div>
    </div>

    <div class="layout layout-no-pt container-page">
        {%- liquid
            assign mobile_grid_class = 'grid-cols-1'
            if section.settings.mobile_card_columns == '2'
                assign mobile_grid_class = 'grid-cols-2'
            endif

            assign desktop_grid_class = 'pc:grid-cols-4'
            if section.settings.desktop_card_columns == '3'
                assign desktop_grid_class = 'pc:grid-cols-3'
            endif

            assign enable_filtering = section.settings.enable_filtering
            assign enable_sorting = section.settings.enable_sorting
            assign filter_type = section.settings.filter_type | default: 'drawer'

            assign is_drawer_filter = false
            assign is_horizontal_filter = false
            assign is_vertical_filter = false

            if filter_type == 'horizontal'
                assign is_horizontal_filter = true
            elsif filter_type == 'vertical'
                assign is_vertical_filter = true
            else
                assign is_drawer_filter = true
            endif
        -%}

        <div data-collection-dynamic-content class="flex flex-col gap-6 pc:gap-6">
            {%- comment -%} Hidden form all filter/sort controls {%- endcomment -%}
            <form id="CollectionFiltersForm" class="hidden" @change="onChange()"></form>

            {%- comment -%}
                Mobile-only (pc:hidden)
            {%- endcomment -%}
            {%- if enable_filtering or enable_sorting -%}
                <div class="flex items-center justify-between gap-4 pc:hidden">
                    {%- if enable_filtering -%}
                        <button
                            type="button"
                            @click="$store.dialog.open('collection-filters')"
                            class="collection-toolbar__action flex shrink-0 cursor-pointer items-center gap-3"
                        >
                            {% render 'icons', icon: 'icon-filter' %}
                            <span>{{ 'collections.filter' | t }}</span>
                        </button>
                    {%- endif -%}

                    {%- if enable_sorting -%}
                        {%- capture sort_id_prefix_mobile -%}{{ section.id }}-mobile{%- endcapture -%}

                        {%- render 'sort-by-dropdown',
                            results: collection,
                            form_id: 'CollectionFiltersForm',
                            class: 'shrink-0',
                            id_prefix: sort_id_prefix_mobile
                        -%}
                    {%- endif -%}
                </div>
            {%- endif -%}

            {%- comment -%}
                Desktop horizontal (max-pc:hidden)
            {%- endcomment -%}
            {%- if is_horizontal_filter -%}
                {%- if enable_filtering or enable_sorting -%}
                    <div class="hidden pc:flex pc:flex-col pc:gap-4">
                        <div class="flex items-center justify-between gap-6">
                            {%- if enable_filtering -%}
                                {%- render 'filter-horizontal',
                                    filter_source: collection,
                                    show_more_limit: section.settings.filter_visible_values_limit,
                                    wrapper_class: 'min-w-0 flex-1'
                                -%}
                            {%- else -%}
                                <div></div>
                            {%- endif -%}

                            {%- if enable_sorting -%}
                                {%- capture sort_id_prefix_desktop_h -%}{{ section.id }}-desktop-h{%- endcapture -%}
                                {%- render 'sort-by-dropdown',
                                    results: collection,
                                    form_id: 'CollectionFiltersForm',
                                    class: 'shrink-0 self-start',
                                    id_prefix: sort_id_prefix_desktop_h
                                -%}
                            {%- endif -%}
                        </div>
                    </div>
                {%- endif -%}
            {%- endif -%}

            {%- comment -%}
                Desktop vertical (max-pc:hidden)
            {%- endcomment -%}
            <div
                class="
                    {% if enable_filtering and is_vertical_filter %}
                        pc:grid pc:grid-cols-[30rem_minmax(0,1fr)] pc:gap-10
                    {% endif %}
                "
            >
                {%- if enable_filtering and is_vertical_filter -%}
                    <aside class="hidden pc:block">
                        <div class="sticky top-20 border-e border-theme-border/20 pe-6">
                            {%- render 'filter-vertical',
                                filter_source: collection,
                                show_more_limit: section.settings.filter_visible_values_limit,
                                scope_id: section.id
                            -%}
                        </div>
                    </aside>
                {%- endif -%}

                <div class="min-w-0">
                    {% comment %} Tab Control {% endcomment %}
                    {%- liquid
                        assign active_tab_index = 0
                        assign all_products_collection = collections.all

                        if all_products_collection != blank and collection.handle == all_products_collection.handle
                            assign active_tab_index = 0
                        else
                            assign rendered_tab_index = 0
                            assign rendered_tab_index = 1

                            for tab_collection in collections
                                if tab_collection == blank or tab_collection.handle == 'all'
                                    continue
                                endif

                                if tab_collection.handle == collection.handle
                                    assign active_tab_index = rendered_tab_index
                                    break
                                endif

                                assign rendered_tab_index = rendered_tab_index | plus: 1
                            endfor
                        endif
                    -%}

                    {% capture desktop_filter %}
                        {%- comment -%} Tab header left slot: desktop Filter button when filter_type Drawer and enable_filtering; else spacer (grid column still reserved). {%- endcomment -%}
                        {%- if enable_filtering and is_drawer_filter -%}
                            <div class="hidden pc:flex pc:items-center pc:pb-3">
                                <button
                                    type="button"
                                    @click="$store.dialog.open('collection-filters')"
                                    class="collection-toolbar__action flex shrink-0 cursor-pointer items-center gap-2.5"
                                >
                                    {% render 'icons', icon: 'icon-filter' %}
                                    <span>{{ 'collections.filter' | t }}</span>
                                </button>
                            </div>
                        {%- else -%}
                            <div class="hidden pc:block"></div>
                        {%- endif -%}
                    {% endcapture %}

                    {% capture desktop_sort %}
                        {%- comment -%} Tab header right slot: sort when enable_sorting and desktop is not Horizontal (horizontal row above already renders sort). Vertical/Drawer use this slot. {%- endcomment -%}
                        {%- if enable_sorting -%}
                            {%- if is_horizontal_filter == false -%}
                                {%- capture sort_id_prefix_desktop_v -%}{{ section.id }}-desktop-v{%- endcapture -%}
                                <div class="hidden pc:flex pc:items-center pc:justify-end pc:pb-3">
                                    {%- render 'sort-by-dropdown',
                                        results: collection,
                                        form_id: 'CollectionFiltersForm',
                                        class: 'shrink-0',
                                        id_prefix: sort_id_prefix_desktop_v
                                    -%}
                                </div>
                            {%- else -%}
                                <div class="hidden pc:block"></div>
                            {%- endif -%}
                        {%- else -%}
                            <div class="hidden pc:block"></div>
                        {%- endif -%}
                    {% endcapture %}

                    {% capture tab_header %}
                        <span class="hidden" x-init="$nextTick(() => { setActive({{ active_tab_index }}) })"></span>

                        <a
                            href="{{ all_products_collection.url | default: routes.all_products_collection_url }}"
                            role="tab"
                            x-data="{ index: null }"
                            x-init="index = registerTab($el);"
                            :id="`tab-${index}`"
                            aria-controls="collection-panel"
                            @click.prevent="window.location.assign(buildCollectionTabUrl($el.href))"
                            :tabindex="isActive(index) ? 0 : -1"
                            :aria-selected="isActive(index)"
                            :class="isActive(index) && 'is-active'"
                            class="collection__tab tab-nav-item tab-nav-item--underline-opacity"
                        >
                            {{ 'collections.all' | t }}
                            <sup class="sup-badge">({{ all_products_collection.all_products_count | default: 0 }})</sup>
                        </a>

                        {%- for tab_collection in collections -%}
                            {%- if tab_collection == blank or tab_collection.handle == 'all' -%}
                                {%- continue -%}
                            {%- endif -%}

                            <a
                                href="{{ tab_collection.url }}"
                                role="tab"
                                x-data="{ index: null }"
                                x-init="index = registerTab($el);"
                                :id="`tab-${index}`"
                                aria-controls="collection-panel"
                                @click.prevent="window.location.assign(buildCollectionTabUrl($el.href))"
                                :tabindex="isActive(index) ? 0 : -1"
                                :aria-selected="isActive(index)"
                                :class="isActive(index) && 'is-active'"
                                class="collection__tab tab-nav-item tab-nav-item--underline-opacity"
                            >
                                {{ tab_collection.title }}
                                <sup class="sup-badge">({{ tab_collection.all_products_count | default: 0 }})</sup>
                            </a>
                        {%- endfor -%}
                    {% endcapture %}

                    {% capture tab_content %}
                        <div 
                            role="tabpanel"
                            id="collection-panel"
                            x-data="{ index: null }"
                            x-init="index = registerPanel($el)"
                            class="relative w-full"
                        >
                            {% render 'loading', overlay: true, size: 'large' %}

                            {%- liquid
                                assign first_row_count = section.settings.mobile_card_columns | default: '2' | plus: 0
                            -%}
                            {% paginate collection.products by section.settings.products_per_page %}
                                <div
                                    class="grid {{ mobile_grid_class }} {{ desktop_grid_class }} gap-x-4 gap-y-8 pb-10"
                                    x-data="motionRevealSection()"
                                    data-motion-section
                                    data-motion-cascade
                                    style="
                                        --motion-reveal-stagger: 150ms;
                                        --motion-reveal-distance: 3rem;
                                    "
                                >
                                    {%- for product in collection.products -%}
                                        {%- if forloop.index <= first_row_count -%}
                                            {%- if forloop.index == 1 -%}
                                                {%- assign row_fetchpriority = 'high' -%}
                                            {%- else -%}
                                                {%- assign row_fetchpriority = '' -%}
                                            {%- endif -%}
                                            <div class="group">
                                                {%- render 'product-card',
                                                    product: product,
                                                    hover_mode: 'variants',
                                                    scope_id: section.id,
                                                    color_scheme: section.settings.color_scheme,
                                                    primary_image_loading: 'eager',
                                                    primary_image_fetchpriority: row_fetchpriority
                                                -%}
                                            </div>
                                        {%- else -%}
                                            <div class="group">
                                                {%- render 'product-card',
                                                    product: product,
                                                    hover_mode: 'variants',
                                                    scope_id: section.id,
                                                    color_scheme: section.settings.color_scheme
                                                %}
                                            </div>
                                        {%- endif -%}
                                    {%- else -%}
                                        <div class="col-span-full py-20 text-center body-lg">
                                            {{ 'collections.no_products' | t }}
                                        </div>
                                    {%- endfor -%}
                                </div>

                                <div
                                    class="collection-pagination-wrapper mt-8"
                                    @click="onPaginate($event)"
                                >
                                    {% render 'pagination', paginate_obj: paginate %}
                                </div>
                            {% endpaginate %}
                        </div>
                    {% endcapture %}

                    {%- comment -%} Tab strip chrome: full-width bottom border on desktop when filter_type is not Horizontal (horizontal filters live in their own row); horizontal mode removes pc border from the tab row. {%- endcomment -%}
                    {%- liquid
                        assign header_outer_class_value = 'w-full pc:grid pc:grid-cols-[max-content_minmax(0,1fr)_max-content] pc:items-end pc:gap-12'
                        assign header_class_value = 'body-3xl gap-6 pc:gap-12 max-pc:border-b max-pc:border-theme-border/20'
                        if is_horizontal_filter == false
                            assign header_outer_class_value = header_outer_class_value | append: ' pc:border-b pc:border-theme-border/20'
                        else
                            assign header_class_value = header_class_value | append: ' pc:border-0'
                        endif
                    -%}

                    {%- render 'tab-control',
                        custom_class: 'items-start gap-6 pc:gap-6',
                        header_outer_class: header_outer_class_value,
                        header_before: desktop_filter,
                        tab_header: tab_header,
                        header_class: header_class_value,
                        header_after: desktop_sort,
                        tab_content: tab_content
                    -%}
                </div>
            </div>
        </div>
    </div>

    {%- comment -%} Filters drawer dialog: only when enable_filtering {%- endcomment -%}
    {%- if enable_filtering -%}
        {%- capture drawer_content -%}
            {%- render 'filters-drawer',
                filter_source: collection,
                show_more_limit: section.settings.filter_visible_values_limit,
                scope_id: section.id
            -%}
        {%- endcapture -%}

        <div data-collection-drawer-shell>
            {%- assign close_label = 'accessibility.close_filters_drawer' | t -%}
            {%- render 'ui-dialog',
                id: 'collection-filters',
                type: 'drawer',
                layer: 'drawer',
                position: 'left',
                top_class: 'top-[var(--announcement-bar-height)] pc:top-0',
                color_scheme: section.settings.color_scheme,
                drawer_motion_sheet: true,
                mobile_layout: 'inset',
                drawer_desktop_layout: true,
                show_close_button: false,
                close_label: close_label,
                content: drawer_content
            -%}
        </div>
    {%- endif -%}
</div>

{% stylesheet %}
    .price-range-thumb {
        -webkit-appearance: none;
        appearance: none;
        background: transparent;
        pointer-events: none;
        height: 0;
    }
    .price-range-thumb::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 2px solid rgb(var(--color-foreground));
        background: rgb(var(--color-background));
        cursor: pointer;
        pointer-events: auto;
    }
    .price-range-thumb::-moz-range-thumb {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 2px solid rgb(var(--color-foreground));
        background: rgb(var(--color-background));
        cursor: pointer;
        pointer-events: auto;
    }

    .filter-checkbox {
        appearance: none;
        width: 1.25rem;
        height: 1.25rem;
        border: 1.5px solid color-mix(in srgb, rgb(var(--color-foreground)) 30%, transparent);
        border-radius: 0.2rem;
        flex-shrink: 0;
        cursor: pointer;
        transition:
            background-color 0.15s,
            border-color 0.15s;
    }
    .filter-checkbox:checked {
        background-color: rgb(var(--color-foreground));
        border-color: rgb(var(--color-foreground));
        background-image: url("data:image/svg+xml,%3csvg viewBox='0 0 16 16' fill='white' xmlns='http://www.w3.org/2000/svg'%3e%3cpath d='M12.207 4.793a1 1 0 010 1.414l-5 5a1 1 0 01-1.414 0l-2-2a1 1 0 011.414-1.414L6.5 9.086l4.293-4.293a1 1 0 011.414 0z'/%3e%3c/svg%3e");
        background-size: 100% 100%;
        background-position: center;
        background-repeat: no-repeat;
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:general.collection",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["collection"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.collection.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.font"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "heading-4xl",
                    "label": "t:sections.slides-show.options.heading_4xl"
                },
                {
                    "value": "heading-3xl",
                    "label": "t:sections.slides-show.options.heading_3xl"
                },
                {
                    "value": "heading-2xl",
                    "label": "t:sections.slides-show.options.heading_2xl"
                },
                {
                    "value": "heading-xl",
                    "label": "t:sections.slides-show.options.heading_xl"
                },
                {
                    "value": "heading-h1",
                    "label": "t:sections.slides-show.options.heading_h1"
                },
                {
                    "value": "heading-h2",
                    "label": "t:sections.slides-show.options.heading_h2"
                },
                {
                    "value": "heading-h3",
                    "label": "t:sections.slides-show.options.heading_h3"
                },
                {
                    "value": "heading-h4",
                    "label": "t:sections.slides-show.options.heading_h4"
                },
                {
                    "value": "heading-h5",
                    "label": "t:sections.slides-show.options.heading_h5"
                },
                {
                    "value": "heading-h6",
                    "label": "t:sections.slides-show.options.heading_h6"
                }
            ],
            "default": "heading-4xl"
        },
        {
            "type": "inline_richtext",
            "id": "header",
            "default": "t:sections.collection.defaults.header",
            "label": "t:sections.collection.settings.header"
        },
        {
            "type": "richtext",
            "id": "description",
            "default": "t:sections.collection.defaults.description",
            "label": "t:sections.collection.settings.description"
        },
        {
            "type": "header",
            "content": "t:sections.scroll-categories.content.subtitle"
        },
        {
            "type": "select",
            "id": "subtitle_size",
            "label": "t:sections.scroll-categories.settings.subtitle_size",
            "options": [
                {
                    "value": "body-3xl",
                    "label": "t:sections.scroll-categories.options.body_3xl"
                },
                {
                    "value": "body-2xl",
                    "label": "t:sections.scroll-categories.options.body_2xl"
                },
                {
                    "value": "body-xl",
                    "label": "t:sections.scroll-categories.options.body_xl"
                },
                {
                    "value": "body-lg",
                    "label": "t:sections.scroll-categories.options.body_lg"
                },
                {
                    "value": "body-md",
                    "label": "t:sections.scroll-categories.options.body_md"
                },
                {
                    "value": "body-sm",
                    "label": "t:sections.scroll-categories.options.body_sm"
                },
                {
                    "value": "body-xs",
                    "label": "t:sections.scroll-categories.options.body_xs"
                }
            ],
            "default": "body-xl"
        },
        {
            "type": "text",
            "id": "rotate_badge_text",
            "label": "t:sections.collection.settings.rotate_badge_text",
            "default": "t:sections.collection.defaults.rotate_badge_text"
        },
        {
            "type": "text",
            "id": "rotate_badge_percent",
            "label": "t:sections.collection.settings.rotate_badge_percent",
            "default": "100%"
        },
        {
            "type": "range",
            "id": "products_per_page",
            "min": 3,
            "max": 24,
            "step": 3,
            "default": 12,
            "label": "t:sections.collection.settings.products_per_page"
        },
        {
            "type": "checkbox",
            "id": "enable_filtering",
            "default": true,
            "label": "t:sections.collection.settings.enable_filtering",
            "info": "t:sections.collection.info.customize_filters_with_the_search_discov"
        },
        {
            "type": "select",
            "id": "filter_type",
            "label": "t:sections.collection.settings.desktop_filter_layout",
            "default": "horizontal",
            "options": [
                {
                    "value": "horizontal",
                    "label": "t:sections.collection.options.horizontal"
                },
                {
                    "value": "vertical",
                    "label": "t:sections.collection.options.vertical"
                },
                {
                    "value": "drawer",
                    "label": "t:sections.collection.options.drawer"
                }
            ]
        },
        {
            "type": "range",
            "id": "filter_visible_values_limit",
            "min": 3,
            "max": 12,
            "step": 1,
            "default": 6,
            "label": "t:sections.collection.settings.visible_filter_values_before_show_more"
        },
        {
            "type": "checkbox",
            "id": "enable_sorting",
            "default": true,
            "label": "t:sections.collection.settings.enable_sorting"
        },
        {
            "type": "select",
            "id": "desktop_card_columns",
            "label": "t:sections.collection.settings.desktop_product_card_columns",
            "default": "4",
            "options": [
                {
                    "value": "3",
                    "label": "t:sections.collection.options.3_columns"
                },
                {
                    "value": "4",
                    "label": "t:sections.collection.options.4_columns"
                }
            ]
        },
        {
            "type": "select",
            "id": "mobile_card_columns",
            "label": "t:sections.collection.settings.mobile_product_card_columns",
            "default": "2",
            "options": [
                {
                    "value": "1",
                    "label": "t:sections.collection.options.1_column"
                },
                {
                    "value": "2",
                    "label": "t:sections.collection.options.2_columns"
                }
            ]
        },
        {
            "type": "header",
            "content": "t:sections.collection.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.collection.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.collection.settings.padding_bottom",
            "default": 0
        }
    ]
}
{% endschema %}
