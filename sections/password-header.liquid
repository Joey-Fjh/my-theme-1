{%- capture password_header_children -%}
    <div class="flex items-center justify-between gap-step-m">
        <div class="flex min-h-10 items-center">
            <a
                href="{{ routes.root_url }}"
                class="inline-flex min-h-10 items-center text-theme-text"
            >
                {%- if settings.logo != blank -%}
                    {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
                    {{
                        settings.logo
                        | image_url: width: 500
                        | image_tag:
                            class: 'max-h-12 w-auto',
                            widths: '160, 240, 320, 500',
                            sizes: '(max-width: 767px) 160px, 240px',
                            alt: logo_alt,
                            loading: 'eager'
                    }}
                {%- else -%}
                    <span class="copy-l">{{ shop.name }}</span>
                {%- endif -%}
            </a>
        </div>

        {% form 'storefront_password', class: 'relative' %}
            <details
                class="password-header-section__access"
                {% if form.errors %}
                    open
                {% endif %}
            >
                <summary class="links-default links cursor-pointer list-none copy-s">
                    {{ 'password.enter_using_password' | t }}
                </summary>

                <div class="panel-motion panel-motion-popover absolute top-[calc(100%+1rem)] right-0 z-10 flex w-[min(36rem,calc(100vw-2rem))] flex-col gap-step-m border border-line bg-theme-bg px-step-l py-step-m shadow-md">
                    <p class="copy-l text-theme-text">
                        {{ 'password.enter_using_password' | t }}
                    </p>

                    {%- if form.errors -%}
                        <div
                            class="password-header-section__errors copy-s"
                            role="alert"
                        >
                            {{ form.errors | default_errors }}
                        </div>
                    {%- endif -%}

                    <label class="sr-only" for="password-input">
                        {{ 'password.password' | t }}
                    </label>

                    <div class="flex flex-col gap-step-xs tablet:flex-row tablet:items-center tablet:gap-step-s">
                        <input
                            class="field min-w-0 flex-1"
                            type="password"
                            name="password"
                            id="password-input"
                            placeholder="{{ 'password.password' | t | escape }}"
                            autocomplete="current-password"
                            required
                        >

                        <button
                            class="btn-primary shrink-0 copy-s whitespace-nowrap"
                            type="submit"
                        >
                            {{ 'password.enter' | t }}
                        </button>
                    </div>
                </div>
            </details>
        {% endform %}
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    element: 'header',
    section_class: 'password-header-section',
    width: 'page',
    height_kind: 'content',
    surface_section: false,
    clip: false,
    padding_mode: 'overlay',
    safe_top: false,
    inner_class: 'section-frame__overlay-padding-top overflow-visible! border-b border-line pb-step-m',
    children: password_header_children
%}

{% stylesheet %}
    .password-header-section__access summary::-webkit-details-marker {
        display: none;
    }

    .password-header-section__access > div,
    .password-header-section__errors {
        border-radius: var(--dialog-radius);
    }

    .password-header-section__errors ul {
        list-style: disc;
        padding-inline-start: 1.25rem;
    }

    :where(.password-header-section__errors) {
        border-style: var(--tw-border-style);
        border-width: 1px;
        border-color: var(--color-line);
        padding-inline: var(--spacing-step-s);
        padding-block: var(--spacing-step-xs);
        color: rgb(var(--color-foreground));
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.password_header.name",
    "tag": "section",
    "class": "section",
    "limit": 1,
    "enabled_on": {
        "templates": ["password"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.password_header.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "header",
            "content": "t:sections.password_header.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.password_header.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.password_header.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
