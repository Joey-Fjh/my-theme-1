<header
    class="password-header-section full-width color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <div class="layout container-page overflow-visible! border-b border-theme-border/20 pb-6">
        <div class="flex items-center justify-between gap-6">
            <div class="flex min-h-10 items-center">
                {%- if settings.logo != blank -%}
                    {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
                    {{
                        settings.logo
                        | image_url: width: 500
                        | image_tag:
                            class: 'max-h-12 w-auto',
                            widths: '160, 240, 320, 500',
                            sizes: '(max-width: 767px) 160px, 240px',
                            alt: logo_alt,
                            loading: 'eager'
                    }}
                {%- else -%}
                    <span class="body-lg font-medium text-theme-text">{{ shop.name }}</span>
                {%- endif -%}
            </div>

            {% form 'storefront_password', class: 'relative' %}
                <details
                    class="password-header-section__access"
                    {% if form.errors %}
                        open
                    {% endif %}
                >
                    <summary class="links-default links cursor-pointer list-none body-sm">
                        {{ 'password.enter_using_password' | t }}
                    </summary>

                    <div class="absolute top-[calc(100%+1rem)] right-0 z-10 flex w-[min(28rem,calc(100vw-2rem))] flex-col gap-4 border border-theme-border/20 bg-theme-bg p-5 shadow-lg">
                        <p class="body-lg font-medium text-theme-text">
                            {{ 'password.enter_using_password' | t }}
                        </p>

                        {%- if form.errors -%}
                            <div
                                class="password-header-section__errors border border-theme-border/20 px-4 py-3 body-sm text-theme-text"
                                role="alert"
                            >
                                {{ form.errors | default_errors }}
                            </div>
                        {%- endif -%}

                        <label class="sr-only" for="password-input">
                            {{ 'password.password' | t }}
                        </label>

                        <div class="flex flex-col gap-3 pc:flex-row">
                            <input
                                class="field min-w-0 flex-1 body-md"
                                type="password"
                                name="password"
                                id="password-input"
                                placeholder="{{ 'password.password' | t | escape }}"
                                autocomplete="current-password"
                                required
                            >

                            <button class="btn-primary body-sm" type="submit">
                                {{ 'password.enter' | t }}
                            </button>
                        </div>
                    </div>
                </details>
            {% endform %}
        </div>
    </div>
</header>

{% stylesheet %}
    .password-header-section__access summary::-webkit-details-marker {
        display: none;
    }

    .password-header-section__access > div,
    .password-header-section__errors {
        border-radius: var(--dialog-radius);
    }

    .password-header-section__errors ul {
        list-style: disc;
        padding-left: 1.25rem;
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.password_header.name",
    "tag": "section",
    "class": "section",
    "limit": 1,
    "enabled_on": {
        "templates": ["password"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.password_header.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "header",
            "content": "t:sections.password_header.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.password_header.settings.padding_top",
            "default": 20
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.password_header.settings.padding_bottom",
            "default": 20
        }
    ]
}
{% endschema %}
