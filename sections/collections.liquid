<div
    data-section-id="{{ section.id }}"
    class="collections-section full-width h-full color-{{ section.settings.color_scheme }} bg-scheme-surface"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="collections"
    data-component-id="{{ section.id }}"
>
    <div class="layout container-page">
        <div class="relative mb-8 pt-14 text-center pc:mb-10 pc:pt-25">
            <div class="mx-auto flex flex-col gap-3 pc:gap-6">
                <h1 class="heading-2xl">{{ 'collections.latest_brand' | t }}</h1>
                <p>
                    {{ 'collections.latest_brand_description' | t }}
                </p>
            </div>

            {%- if section.settings.show_badge -%}
                {%- render 'rotating-badge',
                    classes: 'absolute right-0 top-0 z-10',
                    badge_class: 'text-theme-text opacity-80',
                    center_class: 'text-theme-text',
                    unique_id: section.id,
                    size: 100,
                    size_mobile: 60,
                    badge_text: section.settings.badge_text,
                    center_text: section.settings.badge_value
                -%}
            {%- endif -%}
        </div>

        {%- paginate collections by section.settings.collections_per_page -%}
            <div>
                {% comment %} Collection Grid {% endcomment %}
                <div
                    class="grid grid-cols-2 gap-1.5 pb-8 pc:grid-cols-3 pc:gap-2 pc:pb-10 fw:grid-cols-4"
                    data-collection-grid
                >
                    {%- for collection in collections -%}
                        <a
                            href="{{ collection.url }}"
                            class="
                                group block translate-y-7.5 overflow-hidden
                                bg-theme-bg opacity-0 transition-shadow duration-300
                                hover:shadow-[0_8px_30px_rgba(0,0,0,0.08)]
                                max-pc:shadow-[0_8px_30px_rgba(0,0,0,0.08)]
                            "
                            data-gsap-card
                        >
                            {%- comment -%} Image {%- endcomment -%}
                            <div class="relative aspect-square overflow-hidden bg-theme-bg">
                                {%- capture sizes -%}
                                    (max-width: 640px) 100vw, (max-width: 1024px) 50vw, (max-width: 1280px) 33vw, 25vw
                                {%- endcapture -%}

                                {%- capture widths -%}
                                    300,450,600
                                {%- endcapture -%}

                                {%- assign image_loading = 'lazy' -%}
                                {%- if forloop.index <= 4 -%}
                                    {%- assign image_loading = 'eager' -%}
                                {%- endif -%}

                                {%- assign image_alt = collection.image.alt
                                    | default: shop.name
                                    | escape
                                -%}
                                {%- render 'image',
                                    image: collection.image,
                                    alt: image_alt,
                                    width: collection.image.width,
                                    sizes: sizes,
                                    widths: widths,
                                    loading: image_loading,
                                    class: 'w-full h-full object-cover
                                        transition-transform duration-[600ms] ease-[cubic-bezier(0.25,0.46,0.45,0.94)] group-hover:scale-105'
                                -%}
                            </div>

                            {%- comment -%} Info {%- endcomment -%}
                            <div class="flex items-center justify-between gap-2 px-2 py-1.5 pc:px-3 pc:py-2">
                                <span class="line-clamp-1">
                                    {{- collection.title -}}
                                </span>

                                {% render 'icons',
                                    icon: 'icon-arrow2',
                                    class: 'transition-transform duration-300 group-hover:translate-x-1'
                                %}
                            </div>
                        </a>
                    {%- endfor -%}
                </div>

                {% comment %} Pagination {% endcomment %}
                {%- render 'pagination', paginate_obj: paginate -%}
            </div>
        {% endpaginate %}
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        const Motion = window.__Theme__?.Motion;
        if (!Components) return;

        Components.register(
            'collections',
            {
                init(el) {
                    if (!Motion) return;

                    const { ctx } = Motion.scrollReveal(el, {
                        selector: '[data-gsap-card]',
                        duration: 0.5,
                        stagger: 0.1,
                        scrollTriggerStart: 'top 85%',
                    });

                    return { ctx };
                },

                destroy(el, state) {
                    if (state?.ctx) {
                        state.ctx.revert();
                    }
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{% schema %}
{
    "name": "t:general.collections_grid",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["list-collections"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.collections.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "range",
            "id": "collections_per_page",
            "min": 4,
            "max": 24,
            "step": 4,
            "default": 12,
            "label": "t:sections.collections.settings.collections_per_page"
        },
        {
            "type": "checkbox",
            "id": "show_badge",
            "label": "t:sections.collections.settings.show_badge",
            "default": true
        },
        {
            "type": "text",
            "id": "badge_text",
            "label": "t:sections.collections.settings.badge_text",
            "default": "t:sections.collections.defaults.badge_text"
        },
        {
            "type": "text",
            "id": "badge_value",
            "label": "t:sections.collections.settings.badge_value",
            "default": "100%"
        },
        {
            "type": "header",
            "content": "t:sections.collections.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.collections.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.collections.settings.padding_bottom",
            "default": 0
        }
    ]
}
{% endschema %}
