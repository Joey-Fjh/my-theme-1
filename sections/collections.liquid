{%- liquid
    assign collections_heading_class = section.settings.heading_size | default: 'title-2xl'
    assign collections_subtitle_size = section.settings.subtitle_size | default: 'copy-l'
    assign collections_heading = section.settings.heading
    if collections_heading == blank
        assign collections_heading = 'collections.latest_brand' | t
    endif
    assign collections_description = section.settings.description
    if collections_description == blank
        assign collections_description = 'collections.latest_brand_description' | t
    endif
-%}
{%- capture collections_children -%}
        <div
            class="relative mb-step-l pt-step-2xl text-center tablet:mb-step-xl tablet:pt-step-3xl"
        >
            <div class="mx-auto flex flex-col gap-step-xs tablet:gap-step-m">
                {% render 'heading',
                    level: '1',
                    tier: collections_heading_class,
                    align: 'center',
                    content: collections_heading,
                %}
                {%- if collections_description != blank -%}
                    {% render 'text',
                        tier: collections_subtitle_size,
                        subtitle: true,
                        align: 'center',
                        content: collections_description,
                    %}
                {%- endif -%}
            </div>

            {%- if section.settings.show_badge -%}
                {%- render 'rotating-badge',
                    classes: 'absolute right-0 top-0 z-10',
                    badge_class: 'text-theme-text opacity-80',
                    center_class: 'text-theme-text',
                    unique_id: section.id,
                    size: 100,
                    size_mobile: 60,
                    badge_text: section.settings.badge_text,
                    center_text: section.settings.badge_value
                -%}
            {%- endif -%}
        </div>

        {%- paginate collections by section.settings.collections_per_page -%}
            <div>
                {% comment %} Collection Grid {% endcomment %}
                <div
                    class="grid grid-cols-2 gap-step-2xs pb-step-l tablet:grid-cols-3 tablet:gap-step-2xs tablet:pb-step-xl wide:grid-cols-4"
                    data-collection-grid
                    data-motion-cascade
                >
                    {%- for collection in collections -%}
                        <a
                            href="{{ collection.url }}"
                            class="collections-section__card group media-interaction"
                            data-motion-bound
                        >
                            <div>
                                {%- comment -%} Image {%- endcomment -%}
                                <div class="relative aspect-square overflow-hidden bg-theme-bg">
                                    {%- capture sizes -%}
                                        (min-width: 80rem) 600px, (min-width: 64rem) 56vw, (min-width: 48rem) 50vw, 100vw
                                    {%- endcapture -%}

                                    {%- capture widths -%}
                                        400,600,800,1000,1200
                                    {%- endcapture -%}

                                    {%- assign image_loading = 'lazy' -%}
                                    {%- if forloop.index <= 4 -%}
                                        {%- assign image_loading = 'eager' -%}
                                    {%- endif -%}

                                    {%- assign collection_card_image = collection.featured_image -%}
                                    {%- assign collection_placeholder_index = forloop.index0
                                        | modulo: 6
                                        | plus: 1
                                    -%}
                                    {%- assign collection_placeholder_key = 'collection-'
                                        | append: collection_placeholder_index
                                    -%}
                                    {%- assign image_alt = collection_card_image.alt
                                        | default: collection.title
                                        | escape
                                    -%}
                                    {%- render 'image',
                                        image: collection_card_image,
                                        placeholder_key: collection_placeholder_key,
                                        alt: image_alt,
                                        width: collection_card_image.width,
                                        sizes: sizes,
                                        widths: widths,
                                        loading: image_loading,
                                        wrapper_class: 'h-full w-full',
                                    -%}
                                </div>

                                {%- comment -%} Info {%- endcomment -%}
                                <div>
                                    <div
                                        class="flex items-center justify-between gap-step-2xs px-step-2xs py-step-2xs tablet:px-step-xs tablet:py-step-2xs"
                                    >
                                        <span class="min-w-0 copy-l break-words">
                                            {{- collection.title -}}
                                        </span>

                                        {% render 'icons',
                                            icon: 'icon-arrow2',
                                            class: 'shrink-0 transition-transform duration-300 group-hover:translate-x-1'
                                        %}
                                    </div>
                                </div>
                            </div>
                        </a>
                    {%- endfor -%}
                </div>

                {% comment %} Pagination {% endcomment %}
                {%- render 'pagination', paginate_obj: paginate -%}
            </div>
        {% endpaginate %}
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: 'collections-section',
    root_class: 'h-full',
    width: 'page',
    height_kind: 'content',
    motion: true,
    children: collections_children
%}

{% stylesheet %}
    .collections-section__card {
        transition: box-shadow var(--motion-duration-base, 300ms) var(--motion-ease-default, ease);
    }

    :where(.collections-section__card) {
        display: block;
        overflow: hidden;
        background-color: rgb(var(--color-background));
    }

    @media (width < 48rem) {
        :where(.collections-section__card) {
            box-shadow: var(--shadow-md);
        }
    }

    @media (hover: hover) and (pointer: fine) {
        :where(.collections-section__card):hover {
            box-shadow: var(--shadow-md);
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:general.collections_grid",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["list-collections"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.collections.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.font"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "t:sections.collections.settings.heading",
            "default": "t:sections.collections.defaults.heading"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "title-4xl",
                    "label": "t:settings.type_size.title_4xl"
                },
                {
                    "value": "title-3xl",
                    "label": "t:settings.type_size.title_3xl"
                },
                {
                    "value": "title-2xl",
                    "label": "t:settings.type_size.title_2xl"
                },
                {
                    "value": "title-xl",
                    "label": "t:settings.type_size.title_xl"
                },
                {
                    "value": "title-l",
                    "label": "t:settings.type_size.title_l"
                },
                {
                    "value": "title-m",
                    "label": "t:settings.type_size.title_m"
                },
                {
                    "value": "title-s",
                    "label": "t:settings.type_size.title_s"
                },
                {
                    "value": "title-xs",
                    "label": "t:settings.type_size.title_xs"
                }
            ],
            "default": "title-2xl"
        },
        {
            "type": "inline_richtext",
            "id": "description",
            "label": "t:sections.collections.settings.description",
            "default": "t:sections.collections.defaults.description"
        },
        {
            "type": "header",
            "content": "t:sections.scroll-categories.content.subtitle"
        },
        {
            "type": "select",
            "id": "subtitle_size",
            "label": "t:sections.scroll-categories.settings.subtitle_size",
            "options": [
                {
                    "value": "copy-xl",
                    "label": "t:settings.type_size.copy_xl"
                },
                {
                    "value": "copy-l",
                    "label": "t:settings.type_size.copy_l"
                },
                {
                    "value": "copy-m",
                    "label": "t:settings.type_size.copy_m"
                },
                {
                    "value": "copy-s",
                    "label": "t:settings.type_size.copy_s"
                }
            ],
            "default": "copy-l"
        },
        {
            "type": "range",
            "id": "collections_per_page",
            "min": 4,
            "max": 24,
            "step": 4,
            "default": 12,
            "label": "t:sections.collections.settings.collections_per_page"
        },
        {
            "type": "checkbox",
            "id": "show_badge",
            "label": "t:sections.collections.settings.show_badge",
            "default": true
        },
        {
            "type": "text",
            "id": "badge_text",
            "label": "t:sections.collections.settings.badge_text",
            "default": "t:sections.collections.defaults.badge_text"
        },
        {
            "type": "text",
            "id": "badge_value",
            "label": "t:sections.collections.settings.badge_value",
            "default": "t:sections.collections.defaults.badge_value"
        },
        {
            "type": "header",
            "content": "t:sections.collections.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.collections.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.collections.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
