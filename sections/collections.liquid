<div
    data-section-id="{{ section.id }}"
    class="collections-section full-width h-full color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="motionRevealSection()"
    data-motion-section
>
    {%- liquid
        assign collections_heading_class = section.settings.heading_size | default: 'heading-2xl'
        assign collections_subtitle_size = section.settings.subtitle_size | default: 'body-xl'
        assign collections_subtitle_class = 'typo-subtitle ' | append: collections_subtitle_size
        assign collections_heading = section.settings.heading
        if collections_heading == blank
            assign collections_heading = 'collections.latest_brand' | t
        endif
        assign collections_description = section.settings.description
        if collections_description == blank
            assign collections_description = 'collections.latest_brand_description' | t
        endif
    -%}
    <div class="layout container-page">
        <div
            class="relative mb-8 pt-14 text-center pc:mb-10 pc:pt-25"
            data-motion-reveal="content"
        >
            <div class="mx-auto flex flex-col gap-3 pc:gap-6">
                <h1 class="{{ collections_heading_class }}">
                    {{ collections_heading }}
                </h1>
                {%- if collections_description != blank -%}
                    <p class="{{ collections_subtitle_class }}">
                        {{ collections_description }}
                    </p>
                {%- endif -%}
            </div>

            {%- if section.settings.show_badge -%}
                {%- render 'rotating-badge',
                    classes: 'absolute right-0 top-0 z-10',
                    badge_class: 'text-theme-text opacity-80',
                    center_class: 'text-theme-text',
                    unique_id: section.id,
                    size: 100,
                    size_mobile: 60,
                    badge_text: section.settings.badge_text,
                    center_text: section.settings.badge_value
                -%}
            {%- endif -%}
        </div>

        {%- paginate collections by section.settings.collections_per_page -%}
            <div>
                {% comment %} Collection Grid {% endcomment %}
                <div
                    class="grid grid-cols-2 gap-1.5 pb-8 pc:grid-cols-3 pc:gap-2 pc:pb-10 fw:grid-cols-4"
                    data-collection-grid
                    data-motion-cascade
                    style="
                        --motion-reveal-stagger: 150ms;
                        --motion-reveal-distance: 3rem;
                    "
                >
                    {%- for collection in collections -%}
                        <a
                            href="{{ collection.url }}"
                            class="
                                collections-section__card group media-interaction block overflow-hidden
                                bg-theme-bg
                                hover:shadow-[0_8px_30px_rgba(0,0,0,0.08)]
                                max-pc:shadow-[0_8px_30px_rgba(0,0,0,0.08)]
                            "
                            data-motion-reveal="content"
                        >
                            {%- comment -%} Image {%- endcomment -%}
                            <div class="relative aspect-square overflow-hidden bg-theme-bg">
                                {%- capture sizes -%}
                                    (max-width: 640px) 100vw, (max-width: 1024px) 50vw, (max-width: 1280px) 33vw, 25vw
                                {%- endcapture -%}

                                {%- capture widths -%}
                                    300,450,600
                                {%- endcapture -%}

                                {%- assign image_loading = 'lazy' -%}
                                {%- if forloop.index <= 4 -%}
                                    {%- assign image_loading = 'eager' -%}
                                {%- endif -%}

                                {%- assign collection_card_image = collection.featured_image -%}
                                {%- assign image_alt = collection_card_image.alt
                                    | default: collection.title
                                    | escape
                                -%}
                                {%- render 'image',
                                    image: collection_card_image,
                                    alt: image_alt,
                                    width: collection_card_image.width,
                                    sizes: sizes,
                                    widths: widths,
                                    loading: image_loading,
                                    wrapper_class: 'h-full w-full',
                                    motion_reveal: false
                                -%}
                            </div>

                            {%- comment -%} Info {%- endcomment -%}
                            <div class="flex items-center justify-between gap-2 px-2 py-1.5 pc:px-3 pc:py-2">
                                <span class="line-clamp-1 body-lg">
                                    {{- collection.title -}}
                                </span>

                                {% render 'icons',
                                    icon: 'icon-arrow2',
                                    class: 'transition-transform duration-300 group-hover:translate-x-1'
                                %}
                            </div>
                        </a>
                    {%- endfor -%}
                </div>

                {% comment %} Pagination {% endcomment %}
                {%- render 'pagination', paginate_obj: paginate -%}
            </div>
        {% endpaginate %}
    </div>
</div>

{% schema %}
{
    "name": "t:general.collections_grid",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["list-collections"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.collections.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.font"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "t:sections.collections.settings.heading",
            "default": "t:sections.collections.defaults.heading"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "heading-4xl",
                    "label": "t:sections.slides-show.options.heading_4xl"
                },
                {
                    "value": "heading-3xl",
                    "label": "t:sections.slides-show.options.heading_3xl"
                },
                {
                    "value": "heading-2xl",
                    "label": "t:sections.slides-show.options.heading_2xl"
                },
                {
                    "value": "heading-xl",
                    "label": "t:sections.slides-show.options.heading_xl"
                },
                {
                    "value": "heading-h1",
                    "label": "t:sections.slides-show.options.heading_h1"
                },
                {
                    "value": "heading-h2",
                    "label": "t:sections.slides-show.options.heading_h2"
                },
                {
                    "value": "heading-h3",
                    "label": "t:sections.slides-show.options.heading_h3"
                },
                {
                    "value": "heading-h4",
                    "label": "t:sections.slides-show.options.heading_h4"
                },
                {
                    "value": "heading-h5",
                    "label": "t:sections.slides-show.options.heading_h5"
                },
                {
                    "value": "heading-h6",
                    "label": "t:sections.slides-show.options.heading_h6"
                }
            ],
            "default": "heading-2xl"
        },
        {
            "type": "inline_richtext",
            "id": "description",
            "label": "t:sections.collections.settings.description",
            "default": "t:sections.collections.defaults.description"
        },
        {
            "type": "header",
            "content": "t:sections.scroll-categories.content.subtitle"
        },
        {
            "type": "select",
            "id": "subtitle_size",
            "label": "t:sections.scroll-categories.settings.subtitle_size",
            "options": [
                {
                    "value": "body-3xl",
                    "label": "t:sections.scroll-categories.options.body_3xl"
                },
                {
                    "value": "body-2xl",
                    "label": "t:sections.scroll-categories.options.body_2xl"
                },
                {
                    "value": "body-xl",
                    "label": "t:sections.scroll-categories.options.body_xl"
                },
                {
                    "value": "body-lg",
                    "label": "t:sections.scroll-categories.options.body_lg"
                },
                {
                    "value": "body-md",
                    "label": "t:sections.scroll-categories.options.body_md"
                },
                {
                    "value": "body-sm",
                    "label": "t:sections.scroll-categories.options.body_sm"
                },
                {
                    "value": "body-xs",
                    "label": "t:sections.scroll-categories.options.body_xs"
                }
            ],
            "default": "body-xl"
        },
        {
            "type": "range",
            "id": "collections_per_page",
            "min": 4,
            "max": 24,
            "step": 4,
            "default": 12,
            "label": "t:sections.collections.settings.collections_per_page"
        },
        {
            "type": "checkbox",
            "id": "show_badge",
            "label": "t:sections.collections.settings.show_badge",
            "default": true
        },
        {
            "type": "text",
            "id": "badge_text",
            "label": "t:sections.collections.settings.badge_text",
            "default": "t:sections.collections.defaults.badge_text"
        },
        {
            "type": "text",
            "id": "badge_value",
            "label": "t:sections.collections.settings.badge_value",
            "default": "100%"
        },
        {
            "type": "header",
            "content": "t:sections.collections.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.collections.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.collections.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
