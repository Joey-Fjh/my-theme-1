<div class="full-width layout h-screen"
    data-section-id="{{ section.id }}"
    data-init="false"
>

</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const routineShowcase = document.querySelector('[data-section-id="{{ section.id }}"]');

        if(!routineShowcase || routineShowcase.dataset.init === 'true') return;

        routineShowcase.dataset.init = 'true';
    });
</script>

<style>
    [data-section-id="{{ section.id }}"] {
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
</style>

{% schema %}
  {
    "name": "Routine Showcase",
    "tag": "section",
    "class": "section",
    "settings": [
      
    ],
    "presets": [
      {
        "name": "Routine Showcase",
        "settings": {
        }
      }
    ]
  }
{% endschema %}