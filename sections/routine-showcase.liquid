<div
    data-section-id="{{ section.id }}"
    class="routine-showcase-section full-width"
    data-component-kind="section"
    data-component-type="routine-showcase"
    data-component-id="{{ section.id }}"
>
    <div class="relative h-screen overflow-hidden">
        {%- capture sizes -%}
            (min-width: 80rem) 100vw, (min-width: 48rem) 1280px, 100vw
        {%- endcapture -%}

        {%- capture widths -%}
            400,480,768,1280,1440,1536,2560
        {%- endcapture -%}

        <div class="absolute inset-0">
            {%-
                render 'image',
                image: section.settings.bg_img,
                alt: section.settings.bg_img.alt | default: section.settings.heading | escape,
                width: section.settings.bg_img.width,
                sizes: sizes,
                widths: widths,
                loading: 'lazy'
            -%}
        </div>

        <div class="layout container-page relative h-full color-{{ section.settings.color_scheme }} bg-transparent!">
            <div class="grid h-full grid-cols-1 grid-rows-[auto_1fr_auto] py-3 pc:grid-cols-2 pc:grid-rows-[1fr_auto]">
                <div class="flex flex-row gap-3 max-pc:h-full pc:w-fit pc:flex-col pc:justify-between">
                    <button
                        type="button"
                        class="swiper-button-prev self-center"
                        aria-label="{{ 'accessibility.previous_slide' | t }}"
                    ></button>
                    <div
                        class="swiper ml-0 min-w-0 flex-1"
                        role="region"
                        aria-label="{{ 'accessibility.routine_carousel' | t }}"
                        aria-roledescription="{{ 'accessibility.carousel' | t }}"
                    >
                        <div class="swiper-wrapper">
                            {%- assign products = section.settings.collection.products -%}

                            {%- for product in products -%}
                                <div class="swiper-slide w-auto pc:w-136">
                                    <a
                                        class="relative block h-full"
                                        href="{{ product.url }}"
                                        x-data="{ hover: false }"
                                        @mouseenter="hover = true"
                                        @mouseleave="hover = false"
                                    >
                                        {%-
                                            render 'image',
                                            aspect_ratio: '342/198',
                                            image: product.featured_image,
                                            alt: product.title | escape,
                                            width: product.featured_image.width
                                        -%}

                                        <div
                                            class="
                                                absolute right-0 bottom-0 left-0
                                                flex items-center justify-between p-2 transition-colors pc:p-4
                                            "
                                            :class=" hover ? 'bg-theme-text text-theme-bg' : 'bg-theme-bg text-theme-text' "
                                        >
                                            <h3 class="truncate h4">{{ product.title }}</h3>
                                            <div class="body-xs text-nowrap opacity-20 pc:body-md">
                                                {% if forloop.index < 10 %}
                                                    {% assign display_index = forloop.index
                                                        | prepend: '0'
                                                    %}
                                                {% else %}
                                                    {% assign display_index = forloop.index %}
                                                {% endif %}
                                                {{ display_index }}
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            {%- endfor -%}
                        </div>
                    </div>
                    <button
                        type="button"
                        class="swiper-button-next left-0 self-center"
                        aria-label="{{ 'accessibility.next_slide' | t }}"
                    ></button>
                </div>

                <div class="flex w-auto flex-col gap-12 self-center justify-self-end p-6 fw:w-3/5">
                    <div>{{ section.settings.eyebrow }}</div>

                    <div class="gap-2">
                        <h3>{{ section.settings.heading }}</h3>
                        <div class="opacity-60">{{ section.settings.description }}</div>
                    </div>

                    {%- capture link_content -%}
                        <span>{{ section.settings.cta_text }}</span>
                        {% render 'icons', icon: 'icon-arrow2', size: 'lg', class: 'ml-3',color:'current' %}
                    {%- endcapture -%}

                    {%- render 'link',
                        href: section.settings.cta_link,
                        content: link_content,
                        variant: 'underline',
                        color: 'current'
                    -%}
                </div>

                <div class="opacity-80">
                    {{ section.settings.badge_counter }}
                </div>

                {%- render 'rotating-badge',
                    classes: 'relative justify-self-center max-pc:hidden',
                    unique_id: section.id,
                    size: 100,
                    badge_text: section.settings.rotate_badge_text,
                    center_text: section.settings.rotate_badge_percent
                -%}
            </div>
        </div>
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components) return;

        Components.register(
            'routine-showcase',
            {
                init(el) {
                    const swiperContainer = el.querySelector('.swiper');

                    if (!swiperContainer || typeof Swiper === 'undefined') return;

                    const mql = window.matchMedia('(min-width: 768px)');
                    const state = { swiper: null, mql: mql, handler: null };

                    function createSwiper() {
                        if (state.swiper) state.swiper.destroy(true, true);

                        const isDesktop = mql.matches;

                        state.swiper = new Swiper(swiperContainer, {
                            direction: isDesktop ? 'vertical' : 'horizontal',
                            slidesPerView: isDesktop ? 4 : 2,
                            grid: isDesktop ? { rows: 1 } : { rows: 2, fill: 'row' },
                            autoHeight: isDesktop,
                            spaceBetween: 8,
                            speed: 300,
                            loop: false,
                            allowTouchMove: true,
                            navigation: {
                                nextEl: el.querySelector('.swiper-button-next'),
                                prevEl: el.querySelector('.swiper-button-prev'),
                            },
                        });
                    }

                    state.handler = () => createSwiper();

                    createSwiper();
                    mql.addEventListener('change', state.handler);

                    return state;
                },

                destroy(el, state) {
                    if (!state) return;

                    if (state.mql && state.handler) {
                        state.mql.removeEventListener('change', state.handler);
                    }

                    if (state.swiper?.destroy) {
                        state.swiper.destroy(true, true);
                    }
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{% stylesheet %}
    .routine-showcase-section {
        .swiper-button-prev,
        .swiper-button-next {
            --swiper-navigation-size: 18px;
            --swiper-navigation-color: currentColor;
            position: relative;
            top: 0;
            margin-top: 0;
            border: 0;
            padding: 0;
            background: none;
            cursor: pointer;
        }

        @media (min-width: 768px) {
            .swiper-button-prev {
                transform: rotate(90deg);
            }
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.routine-showcase.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.routine-showcase.settings.color_scheme",
            "default": "color-scheme-1"
        },
        {
            "type": "image_picker",
            "id": "bg_img",
            "label": "t:sections.routine-showcase.settings.background_image"
        },
        {
            "type": "collection",
            "id": "collection",
            "label": "t:sections.routine-showcase.settings.select_collection"
        },
        {
            "type": "inline_richtext",
            "id": "eyebrow",
            "label": "t:sections.routine-showcase.settings.eyebrow",
            "default": "2026©"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "t:sections.routine-showcase.settings.heading",
            "default": "t:sections.routine-showcase.defaults.heading"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "t:sections.routine-showcase.settings.description",
            "default": "t:sections.routine-showcase.defaults.description_html"
        },
        {
            "type": "inline_richtext",
            "id": "cta_text",
            "label": "t:sections.routine-showcase.settings.call_to_action_text",
            "default": "t:sections.routine-showcase.defaults.cta_text"
        },
        {
            "type": "url",
            "id": "cta_link",
            "label": "t:sections.routine-showcase.settings.link_url",
            "default": "/collections"
        },
        {
            "type": "text",
            "id": "badge_counter",
            "label": "t:sections.routine-showcase.settings.counter_number",
            "default": "002/12"
        },
        {
            "type": "text",
            "id": "rotate_badge_text",
            "label": "t:sections.routine-showcase.settings.rotate_badge_text",
            "default": "t:sections.routine-showcase.defaults.rotate_badge_text"
        },
        {
            "type": "text",
            "id": "rotate_badge_percent",
            "label": "t:sections.routine-showcase.settings.rotate_badge_percent",
            "default": "100%"
        }
    ],
    "presets": [
        {
            "name": "t:sections.routine-showcase.presets.routine_showcase",
            "settings": {}
        }
    ]
}
{% endschema %}
