{%- liquid
    assign product_position = section.settings.product_position | default: 'left'
    assign product_position_class = 'pc:left-0'
    case product_position
        when 'center'
            assign product_position_class = 'pc:left-1/2 pc:-translate-x-1/2'
        when 'right'
            assign product_position_class = 'pc:right-0'
    endcase

    assign content_position = section.settings.content_position | default: 'place-center-right'

    assign badge_position = section.settings.badge_position | default: 'place-bottom-right'

    assign routine_showcase_heading_class = section.settings.heading_size | default: 'heading-h4'
-%}

<div
    data-section-id="{{ section.id }}"
    class="routine-showcase-section full-width"
    data-component-kind="section"
    data-component-type="routine-showcase"
    data-component-id="{{ section.id }}"
    x-data="motionRevealSection()"
    data-motion-section
>
    <div class="relative h-screen overflow-hidden">
        {%- capture sizes -%}
            (min-width: 80rem) 100vw, (min-width: 48rem) 1280px, 100vw
        {%- endcapture -%}

        {%- capture widths -%}
            400,480,768,1280,1440,1536,2560
        {%- endcapture -%}

        <div class="absolute inset-0" data-motion-reveal="media" data-motion-index="0">
            {%- assign image_alt = section.settings.bg_img.alt
                | default: section.settings.heading
                | escape
            -%}
            {%- render 'image',
                image: section.settings.bg_img,
                alt: image_alt,
                width: section.settings.bg_img.width,
                sizes: sizes,
                widths: widths,
                loading: 'lazy',
                motion_reveal: false
            -%}
        </div>

        <div class="layout container-page relative h-full color-{{ section.settings.color_scheme }} bg-transparent!">
            <div class="relative flex h-full flex-col gap-8 py-3 pc:block">
                <div class="{{ product_position_class }} z-20 flex min-w-0 flex-col gap-5 pc:absolute pc:top-3 pc:bottom-3 pc:w-fit">
                    <div
                        class="routine-showcase__swiper-wrap flex min-h-0 flex-row gap-3 max-pc:h-full pc:h-full pc:w-fit pc:flex-col pc:justify-between"
                        data-motion-reveal="media"
                    >
                        <button
                            type="button"
                            class="swiper-button-prev self-center max-pc:hidden"
                            aria-label="{{ 'accessibility.previous_slide' | t }}"
                        ></button>
                        <div
                            class="swiper ms-0 min-w-0 flex-1 pc:h-full pc:min-h-0"
                            role="region"
                            aria-label="{{ 'accessibility.routine_carousel' | t }}"
                            aria-roledescription="{{ 'accessibility.carousel' | t }}"
                        >
                            <div class="swiper-wrapper">
                                {%- assign products = section.settings.collection.products -%}

                                {%- for product in products -%}
                                    <div class="swiper-slide pc:w-136">
                                        <a
                                            class="routine-showcase__product-link media-interaction relative block h-full overflow-hidden bg-theme-bg max-pc:rounded-sm"
                                            href="{{ product.url }}"
                                            x-data="{ hover: false }"
                                            @mouseenter="hover = true"
                                            @mouseleave="hover = false"
                                            @focus="hover = true"
                                            @blur="hover = false"
                                        >
                                            {%- assign image_alt = product.title | escape -%}
                                            {%- render 'image',
                                                aspect_ratio: '342/198',
                                                image: product.featured_image,
                                                alt: image_alt,
                                                width: product.featured_image.width,
                                                motion_reveal: false
                                            -%}

                                            <div
                                                class="
                                                    routine-showcase__product-info
                                                    absolute right-0 bottom-0 left-0
                                                    flex items-center justify-between p-2 pc:p-4
                                                "
                                                :class="{ 'is-hovered': hover }"
                                            >
                                                <p class="truncate body-lg text-theme-text">
                                                    {{ product.title }}
                                                </p>
                                                <div class="text-nowrap">
                                                    {% if forloop.index < 10 %}
                                                        {% assign display_index = forloop.index
                                                            | prepend: '0'
                                                        %}
                                                    {% else %}
                                                        {% assign display_index = forloop.index %}
                                                    {% endif %}
                                                    {{ display_index }}
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                {%- endfor -%}
                            </div>
                        </div>
                        <button
                            type="button"
                            class="swiper-button-next left-0 self-center max-pc:hidden"
                            aria-label="{{ 'accessibility.next_slide' | t }}"
                        ></button>
                    </div>
                </div>

                <div class="grid flex-1 grid-cols-1 grid-rows-3 pc:absolute pc:inset-0 pc:grid-cols-3">
                    <div
                        class="{{ content_position }} flex w-full flex-col gap-12 bg-theme-bg p-6 pc:p-8"
                        data-motion-reveal="content"
                        data-motion-index="1"
                    >
                        <p class="body-3xl typo-subtitle text-theme-text/80">
                            {{ section.settings.eyebrow }}
                        </p>

                        <div class="flex flex-col gap-4">
                            <h2 class="{{ routine_showcase_heading_class }}">
                                {{ section.settings.heading }}
                            </h2>
                            <div class="rte rte--compact text-theme-text/60">
                                {{ section.settings.description }}
                            </div>
                        </div>

                        {%- capture link_content -%}
                            <span>{{ section.settings.cta_text }}</span>
                            {% render 'icons', icon: 'icon-arrow2', class: 'ms-3' %}
                        {%- endcapture -%}

                        {%- render 'link',
                            href: section.settings.cta_link,
                            variant: 'underline',
                            class: 'body-xl text-theme-text',
                            content: link_content
                        -%}
                    </div>

                    <div class="{{ badge_position }} flex h-full w-full items-center justify-center max-pc:hidden">
                        {%- render 'rotating-badge',
                            classes: 'relative',
                            unique_id: section.id,
                            size: 100,
                            badge_text: section.settings.rotate_badge_text,
                            center_text: section.settings.rotate_badge_percent
                        -%}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components) return;

        Components.register(
            'routine-showcase',
            {
                init(el) {
                    const swiperContainer = el.querySelector('.swiper');

                    if (!swiperContainer || typeof Swiper === 'undefined') return;

                    const mql = window.matchMedia('(min-width: 768px)');
                    const state = { swiper: null, mql: mql, handler: null };

                    function createSwiper() {
                        if (state.swiper) state.swiper.destroy(true, true);

                        const isDesktop = mql.matches;

                        state.swiper = new Swiper(swiperContainer, {
                            direction: isDesktop ? 'vertical' : 'horizontal',
                            slidesPerView: isDesktop ? 4 : 2,
                            grid: isDesktop ? { rows: 1 } : { rows: 2, fill: 'row' },
                            autoHeight: false,
                            spaceBetween: 8,
                            speed: 300,
                            loop: false,
                            allowTouchMove: true,
                            navigation: {
                                nextEl: el.querySelector('.swiper-button-next'),
                                prevEl: el.querySelector('.swiper-button-prev'),
                            },
                        });
                    }

                    state.handler = () => createSwiper();

                    const swiperWrap = el.querySelector('.routine-showcase__swiper-wrap');

                    createSwiper();
                    if (swiperWrap) swiperWrap.classList.add('is-ready');
                    mql.addEventListener('change', state.handler);

                    return state;
                },

                destroy(el, state) {
                    if (!state) return;

                    if (state.mql && state.handler) {
                        state.mql.removeEventListener('change', state.handler);
                    }

                    if (state.swiper?.destroy) {
                        state.swiper.destroy(true, true);
                    }
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{% stylesheet %}
    .routine-showcase-section {
        .swiper-button-prev,
        .swiper-button-next {
            --swiper-navigation-size: 18px;
            --swiper-navigation-color: currentColor;
            position: relative;
            top: 0;
            margin-top: 0;
            border: 0;
            padding: 0;
            background: none;
            cursor: pointer;
        }

        @media (min-width: 768px) {
            .swiper-button-prev {
                transform: rotate(90deg);
            }
        }

        .routine-showcase__swiper-wrap {
            visibility: hidden;

            &.is-ready {
                visibility: visible;
            }
        }
    }

    .routine-showcase__product-info {
        background-color: rgb(var(--color-background));
        color: rgb(var(--color-foreground));
        transition:
            background-color var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease),
            color var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease);
    }

    .routine-showcase__product-info.is-hovered {
        background-color: rgb(var(--color-foreground));
        color: rgb(var(--color-background));
    }

    .routine-showcase__product-info :where(h1, h2, h3, h4, h5, h6) {
        color: currentColor;
    }

    .routine-showcase__product-info :where(p) {
        color: inherit;
    }
{% endstylesheet %}

