{%- liquid
    assign routine_heading_size = section.settings.heading_size | default: 'heading-h4'
    case routine_heading_size
        when 'heading-4xl'
            assign routine_heading_class = 'heading-h2 pc:heading-4xl'
        when 'heading-3xl'
            assign routine_heading_class = 'heading-h2 pc:heading-3xl'
        when 'heading-2xl'
            assign routine_heading_class = 'heading-h2 pc:heading-2xl'
        when 'heading-xl'
            assign routine_heading_class = 'heading-h3 pc:heading-xl'
        when 'heading-h1'
            assign routine_heading_class = 'heading-h2 pc:heading-h1'
        when 'heading-h2'
            assign routine_heading_class = 'heading-h3 pc:heading-h2'
        when 'heading-h3'
            assign routine_heading_class = 'heading-h4 pc:heading-h3'
        when 'heading-h4'
            assign routine_heading_class = 'heading-h5 pc:heading-h4'
        when 'heading-h5'
            assign routine_heading_class = 'heading-h6 pc:heading-h5'
        when 'heading-h6'
            assign routine_heading_class = 'body-xl pc:heading-h6'
        else
            assign routine_heading_class = 'heading-h3 pc:heading-h4'
    endcase

    assign routine_eyebrow = section.settings.eyebrow
    assign routine_heading = section.settings.heading
    if routine_heading == blank
        assign routine_heading = 'sections.routine-showcase.defaults.heading' | t
    endif
    assign routine_description = section.settings.description
    assign routine_cta_text = section.settings.cta_text
    if routine_cta_text == blank
        assign routine_cta_text = 'sections.routine-showcase.defaults.cta_text' | t
    endif
    assign routine_cta_link = section.settings.cta_link | default: routes.collections_url

    assign routine_autoplay = true
    if section.settings.autoplay == false
        assign routine_autoplay = false
    endif
    assign routine_autoplay_speed = section.settings.autoplay_speed | default: 5

    assign routine_step_count = 0
    for routine_block in section.blocks
        if routine_block.type == 'step'
            assign routine_step_count = routine_step_count | plus: 1
        endif
    endfor

    if routine_autoplay
        assign routine_autoplay_attr = 'true'
    else
        assign routine_autoplay_attr = 'false'
    endif

    assign routine_bg_sizes = '(min-width: 64rem) 100vw, 100vw'
    assign routine_bg_widths = '768,1280,1536,1920,2560'
-%}

{%- assign routine_showcase_root_attrs = 'data-component-kind="section" data-component-type="routine-showcase" data-component-id="'
    | append: section.id
    | append: '"'
-%}

{%- capture routine_cta_content -%}
    <span class="uppercase">{{ routine_cta_text }}</span>
    {%- render 'icons', icon: 'icon-arrow2', class: 'ms-2', size: 'sm' -%}
{%- endcapture -%}

{%- capture routine_showcase_children -%}
    <div
        class="routine-showcase__root color-{{ section.settings.color_scheme }}"
        data-module-id="routine-showcase"
        x-data="routineShowcase()"
        data-initial-active="0"
        data-autoplay="{{ routine_autoplay_attr }}"
        data-autoplay-speed="{{ routine_autoplay_speed }}"
        style="--routine-autoplay-duration: {{ routine_autoplay_speed }}s;"
    >
        {%- if section.settings.bg_img != blank -%}
            <div class="routine-showcase__bg" aria-hidden="true">
                {%- render 'image',
                    image: section.settings.bg_img,
                    alt: '',
                    mode: 'frame',
                    fit: 'cover',
                    loading: 'lazy',
                    sizes: routine_bg_sizes,
                    widths: routine_bg_widths,
                    wrapper_class: 'h-full w-full',
                    img_class: 'h-full w-full object-cover'
                -%}
            </div>
        {%- endif -%}

        <div class="routine-showcase__inner section-frame__overlay-padding">
            {%- if routine_step_count > 0 -%}
                <ul class="card-rail routine-showcase__mobile-rail" data-routine-mobile-rail role="list">
                    {%- assign routine_step_index = 0 -%}
                    {%- for block in section.blocks -%}
                        {%- if block.type != 'step' -%}
                            {%- continue -%}
                        {%- endif -%}
                        {%- liquid
                            assign routine_step_index = routine_step_index | plus: 1
                            assign routine_step_label = block.settings.label
                            if routine_step_label == blank
                                assign routine_step_label = 'sections.routine-showcase.defaults.step_label' | t
                            endif
                            assign routine_step_number = routine_step_index
                            if routine_step_number < 10
                                assign routine_step_number_label = routine_step_number | prepend: '0'
                            else
                                assign routine_step_number_label = routine_step_number
                            endif
                            assign routine_product = block.settings.product
                            assign routine_is_placeholder = false
                            if routine_product == blank
                                assign routine_is_placeholder = true
                            endif
                            assign routine_product_title = routine_product.title
                            if routine_is_placeholder
                                assign routine_product_title = 'sections.routine-showcase.placeholder_product_title' | t: index: routine_step_index
                                assign routine_product_url = routes.all_products_collection_url
                            else
                                assign routine_product_url = routine_product.url
                            endif
                            if routine_is_placeholder
                                assign routine_product_description = 'sections.routine-showcase.placeholder_description' | t
                            else
                                assign routine_product_description = routine_product.description | strip_html | strip | truncatewords: 28
                            endif
                            assign routine_product_image_alt = routine_product.title | escape
                            if routine_product.featured_image.alt != blank
                                assign routine_product_image_alt = routine_product.featured_image.alt | escape
                            endif
                            assign routine_placeholder_index = routine_step_index | minus: 1 | modulo: 6 | plus: 1
                            assign routine_placeholder_key = 'product-' | append: routine_placeholder_index
                            assign routine_float_image = block.settings.product_image
                            if routine_float_image == blank and routine_is_placeholder == false
                                assign routine_float_image = routine_product.featured_image
                            endif
                            if routine_float_image.alt != blank
                                assign routine_product_image_alt = routine_float_image.alt | escape
                            endif
                            assign routine_scene_image = block.settings.image
                            assign routine_lifestyle_index = routine_step_index | modulo: 2 | plus: 1
                            assign routine_lifestyle_key = 'lifestyle-' | append: routine_lifestyle_index
                        -%}
                        <li
                            class="card-rail__slot routine-showcase__mobile-card-slot"
                            data-routine-mobile-slot
                            data-card-rail-index="{{ routine_step_index | minus: 1 }}"
                            {{ block.shopify_attributes }}
                        >
                            <article
                                class="routine-showcase__mobile-card"
                                data-routine-mobile-card
                                data-card-rail-index="{{ routine_step_index | minus: 1 }}"
                            >
                                <div class="routine-showcase__mobile-product">
                                    {%- if routine_float_image == blank -%}
                                        <a
                                            class="routine-showcase__mobile-product-link block"
                                            href="{{ routine_product_url }}"
                                            tabindex="-1"
                                            aria-hidden="true"
                                        >
                                            {{ routine_placeholder_key | placeholder_svg_tag: 'routine-showcase__placeholder-svg routine-showcase__placeholder-svg--product' }}
                                        </a>
                                    {%- else -%}
                                        <a
                                            class="routine-showcase__mobile-product-link block"
                                            href="{{ routine_product_url }}"
                                            tabindex="-1"
                                            aria-hidden="true"
                                        >
                                            {%- render 'image',
                                                image: routine_float_image,
                                                placeholder_key: routine_placeholder_key,
                                                alt: routine_product_image_alt,
                                                mode: 'frame',
                                                fit: 'contain',
                                                loading: 'lazy',
                                                sizes: '78vw',
                                                widths: '240,360,480,640',
                                                wrapper_class: 'h-full w-full',
                                                img_class: 'h-full w-full object-contain'
                                            -%}
                                        </a>
                                    {%- endif -%}
                                </div>
                                <p class="routine-showcase__mobile-eyebrow body-xs text-muted uppercase" aria-hidden="true">
                                    {{ routine_eyebrow }}
                                </p>
                                <p class="routine-showcase__mobile-heading body-2xl text-theme-text uppercase max-pc:body-3xl" aria-hidden="true">
                                    {{ routine_heading }}
                                </p>
                                <p class="routine-showcase__mobile-badge body-xs uppercase">
                                    {{ routine_step_number_label }}
                                    {{ routine_step_label }}
                                </p>
                                <p class="routine-showcase__mobile-product-title body-lg text-theme-text uppercase">
                                    <a class="text-theme-text" href="{{ routine_product_url }}">{{ routine_product_title }}</a>
                                </p>
                                <p class="routine-showcase__mobile-description body-sm text-muted">
                                    {{ routine_product_description }}
                                </p>
                                <p class="routine-showcase__mobile-price body-md text-theme-text">
                                    {%- if routine_is_placeholder -%}
                                        {{ 1999 | money }}
                                    {%- else -%}
                                        {{ routine_product.price | money }}
                                    {%- endif -%}
                                </p>
                                <div class="routine-showcase__mobile-footer">
                                    {%- render 'link',
                                        href: routine_cta_link,
                                        variant: 'default',
                                        class: 'link-with-icon-motion body-sm uppercase text-theme-text self-start',
                                        content: routine_cta_content
                                    -%}
                                </div>
                            </article>
                        </li>
                    {%- endfor -%}
                </ul>

                <div
                    class="card-rail__dots routine-showcase__mobile-dots"
                    role="group"
                    aria-label="{{ 'accessibility.card_rail_dots' | t }}"
                >
                    {%- assign routine_step_index = 0 -%}
                    {%- for block in section.blocks -%}
                        {%- if block.type != 'step' -%}
                            {%- continue -%}
                        {%- endif -%}
                        {%- liquid
                            assign routine_step_index = routine_step_index | plus: 1
                            assign routine_dot_idx = routine_step_index | minus: 1
                        -%}
                        <button
                            type="button"
                            class="card-rail__dot routine-showcase__mobile-dot focus-ring"
                            data-routine-mobile-dot
                            data-card-rail-index="{{ routine_dot_idx }}"
                            :class="mobileDotClassFromEl($el)"
                            :aria-current="mobileDotAriaCurrentFromEl($el)"
                            aria-label="{{ 'accessibility.go_to_slide' | t: index: routine_step_index }}"
                        >
                            <span class="card-rail__dot-visual" aria-hidden="true"></span>
                        </button>
                    {%- endfor -%}
                </div>

                <div class="container-page">
                <div class="routine-showcase__desktop">
                    <div class="routine-showcase__desktop-grid">
                        <div class="routine-showcase__col routine-showcase__col--left">
                            <div class="routine-showcase__intro">
                                {%- if routine_eyebrow != blank -%}
                                    <p class="routine-showcase__eyebrow body-sm text-muted uppercase pc:body-lg">
                                        {{ routine_eyebrow }}
                                    </p>
                                {%- endif -%}
                                <h2 class="routine-showcase__heading {{ routine_heading_class }} text-theme-text">
                                    {{ routine_heading }}
                                </h2>
                                {%- if routine_description != blank -%}
                                    <div class="routine-showcase__description rte body-lg text-muted">
                                        {{ routine_description }}
                                    </div>
                                {%- endif -%}
                                {%- render 'link',
                                    href: routine_cta_link,
                                    variant: 'default',
                                    class: 'link-with-icon-motion body-md pc:body-lg uppercase text-theme-text self-start',
                                    content: routine_cta_content
                                -%}
                            </div>
                            <div class="routine-showcase__info-stack">
                                {%- assign routine_step_index = 0 -%}
                                {%- for block in section.blocks -%}
                                    {%- if block.type != 'step' -%}
                                        {%- continue -%}
                                    {%- endif -%}
                                    {%- liquid
                                        assign routine_step_index = routine_step_index | plus: 1
                                        assign routine_info_index = routine_step_index | minus: 1
                                        assign routine_product = block.settings.product
                                        assign routine_is_placeholder = false
                                        if routine_product == blank
                                            assign routine_is_placeholder = true
                                        endif
                                        assign routine_product_title = routine_product.title
                                        if routine_is_placeholder
                                            assign routine_product_title = 'sections.routine-showcase.placeholder_product_title' | t: index: routine_step_index
                                            assign routine_product_url = routes.all_products_collection_url
                                        else
                                            assign routine_product_url = routine_product.url
                                        endif
                                        if routine_is_placeholder
                                            assign routine_product_description = 'sections.routine-showcase.placeholder_description' | t
                                        else
                                            assign routine_product_description = routine_product.description | strip_html | strip | truncatewords: 28
                                        endif
                                        assign routine_info_active = false
                                        if routine_info_index == 0
                                            assign routine_info_active = true
                                        endif
                                    -%}
                                    <div
                                        class="routine-showcase__info{% unless routine_info_active %} routine-showcase__info--inactive{% endunless %}{% if routine_info_active %} is-active{% endif %}"
                                        data-routine-info
                                        data-item-index="{{ routine_info_index }}"
                                        id="routine-showcase-{{ section.id }}-info-{{ routine_info_index }}"
                                        :class="infoClassFromEl($el)"
                                        {{ block.shopify_attributes }}
                                    >
                                        <p class="routine-showcase__product-title body-2xl leading-tight text-theme-text uppercase pc:body-3xl">
                                            <a class="text-theme-text" href="{{ routine_product_url }}">
                                                {{- routine_product_title -}}
                                            </a>
                                        </p>
                                        <p class="routine-showcase__product-price body-2xl leading-tight text-theme-text pc:body-3xl">
                                            {%- if routine_is_placeholder -%}
                                                {{ 1999 | money }}
                                            {%- else -%}
                                                {{ routine_product.price | money }}
                                            {%- endif -%}
                                        </p>
                                        <hr class="routine-showcase__product-divider border-line" />
                                        <p class="routine-showcase__product-description body-lg text-muted">
                                            {{ routine_product_description }}
                                        </p>
                                    </div>
                                {%- endfor -%}
                            </div>
                        </div>

                        <div class="routine-showcase__col routine-showcase__col--center">
                            <div class="routine-showcase__stage">
                                {%- assign routine_step_index = 0 -%}
                                {%- for block in section.blocks -%}
                                    {%- if block.type != 'step' -%}
                                        {%- continue -%}
                                    {%- endif -%}
                                    {%- liquid
                                        assign routine_step_index = routine_step_index | plus: 1
                                        assign routine_panel_index = routine_step_index | minus: 1
                                        assign routine_product = block.settings.product
                                        assign routine_is_placeholder = false
                                        if routine_product == blank
                                            assign routine_is_placeholder = true
                                        endif
                                        if routine_is_placeholder
                                            assign routine_product_url = routes.all_products_collection_url
                                        else
                                            assign routine_product_url = routine_product.url
                                        endif
                                        assign routine_placeholder_index = routine_step_index | minus: 1 | modulo: 6 | plus: 1
                                        assign routine_placeholder_key = 'product-' | append: routine_placeholder_index
                                        assign routine_product_image_alt = routine_product.title | escape
                                        if routine_product.featured_image.alt != blank
                                            assign routine_product_image_alt = routine_product.featured_image.alt | escape
                                        endif
                                        assign routine_float_image = block.settings.product_image
                                        if routine_float_image == blank and routine_is_placeholder == false
                                            assign routine_float_image = routine_product.featured_image
                                        endif
                                        if routine_float_image.alt != blank
                                            assign routine_product_image_alt = routine_float_image.alt | escape
                                        endif
                                        assign routine_scene_image = block.settings.image
                                        assign routine_scene_fallback_image = blank
                                        unless routine_is_placeholder
                                            if routine_scene_image == blank
                                                if routine_product.images.size > 1
                                                    assign routine_scene_fallback_image = routine_product.images[1]
                                                endif
                                            endif
                                        endunless
                                        assign routine_lifestyle_index = routine_step_index | modulo: 2 | plus: 1
                                        assign routine_lifestyle_key = 'lifestyle-' | append: routine_lifestyle_index
                                        assign routine_scene_alt = 'sections.routine-showcase.placeholder_scene_alt' | t
                                        if routine_scene_image != blank and routine_scene_image.alt != blank
                                            assign routine_scene_alt = routine_scene_image.alt
                                        elsif routine_scene_fallback_image != blank and routine_scene_fallback_image.alt != blank
                                            assign routine_scene_alt = routine_scene_fallback_image.alt
                                        endif
                                        assign routine_panel_active = false
                                        if routine_panel_index == 0
                                            assign routine_panel_active = true
                                        endif
                                    -%}
                                    <div
                                        class="routine-showcase__panel{% unless routine_panel_active %} routine-showcase__panel--inactive{% endunless %}{% if routine_panel_active %} is-active{% endif %}"
                                        role="tabpanel"
                                        id="routine-showcase-{{ section.id }}-panel-{{ routine_panel_index }}"
                                        aria-labelledby="routine-showcase-{{ section.id }}-tab-{{ routine_panel_index }}"
                                        data-item-index="{{ routine_panel_index }}"
                                        x-init="registerPanel($el)"
                                        :class="panelClassFromEl($el)"
                                    >
                                        <div class="routine-showcase__arch-compose">
                                            <div class="routine-showcase__arch">
                                                {%- if routine_scene_image != blank -%}
                                                    {%- render 'image',
                                                        image: routine_scene_image,
                                                        alt: routine_scene_alt,
                                                        mode: 'frame',
                                                        fit: 'cover',
                                                        loading: 'lazy',
                                                        sizes: '(min-width: 64rem) 27vw, 70vw',
                                                        widths: '400,600,800,1000,1200',
                                                        wrapper_class: 'routine-showcase__scene routine-showcase__scene-img h-full w-full',
                                                        img_class: 'h-full w-full object-cover'
                                                    -%}
                                                {%- elsif routine_scene_fallback_image != blank -%}
                                                    {%- render 'image',
                                                        image: routine_scene_fallback_image,
                                                        alt: routine_scene_alt,
                                                        mode: 'frame',
                                                        fit: 'cover',
                                                        loading: 'lazy',
                                                        sizes: '(min-width: 64rem) 27vw, 70vw',
                                                        widths: '400,600,800,1000,1200',
                                                        wrapper_class: 'routine-showcase__scene routine-showcase__scene-img h-full w-full',
                                                        img_class: 'h-full w-full object-cover'
                                                    -%}
                                                {%- else -%}
                                                    <div class="routine-showcase__scene routine-showcase__scene-img routine-showcase__scene--placeholder">
                                                        {{ routine_lifestyle_key | placeholder_svg_tag: 'routine-showcase__placeholder-svg routine-showcase__placeholder-svg--scene' }}
                                                    </div>
                                                {%- endif -%}
                                            </div>
                                            <div class="routine-showcase__product-float">
                                                {%- if routine_float_image == blank -%}
                                                    <a
                                                        class="routine-showcase__product-link block"
                                                        href="{{ routine_product_url }}"
                                                        tabindex="-1"
                                                        aria-hidden="true"
                                                    >
                                                        {{ routine_placeholder_key | placeholder_svg_tag: 'routine-showcase__placeholder-svg routine-showcase__placeholder-svg--product' }}
                                                    </a>
                                                {%- else -%}
                                                    <a
                                                        class="routine-showcase__product-link block"
                                                        href="{{ routine_product_url }}"
                                                        tabindex="-1"
                                                        aria-hidden="true"
                                                    >
                                                        {%- render 'image',
                                                            image: routine_float_image,
                                                            placeholder_key: routine_placeholder_key,
                                                            alt: routine_product_image_alt,
                                                            mode: 'frame',
                                                            fit: 'contain',
                                                            position: 'bottom',
                                                            loading: 'lazy',
                                                            sizes: '(min-width: 64rem) 11vw, 40vw',
                                                            widths: '240,360,480,640,800',
                                                            wrapper_class: 'routine-showcase__product-img h-full w-full',
                                                            img_class: 'h-full w-full object-contain object-bottom'
                                                        -%}
                                                    </a>
                                                {%- endif -%}
                                            </div>
                                        </div>
                                    </div>
                                {%- endfor -%}
                            </div>
                        </div>

                        <div class="routine-showcase__col routine-showcase__col--right">
                            <div class="routine-showcase__controls">
                                <div class="routine-showcase__counter-row">
                                    <p class="routine-showcase__counter body-md tracking-wide text-theme-text">
                                        <span x-text="counterCurrent()">{{ '01' }}</span>
                                        <span aria-hidden="true"> / </span>
                                        <span x-text="counterTotal()">
                                            {%- if routine_step_count < 10 -%}
                                                {{- routine_step_count | prepend: '0' -}}
                                            {%- else -%}
                                                {{- routine_step_count -}}
                                            {%- endif -%}
                                        </span>
                                    </p>
                                </div>
                                <div class="routine-showcase__bars" aria-hidden="true">
                                    {%- assign routine_step_index = 0 -%}
                                    {%- for block in section.blocks -%}
                                        {%- if block.type != 'step' -%}
                                            {%- continue -%}
                                        {%- endif -%}
                                        {%- assign routine_step_index = routine_step_index | plus: 1 -%}
                                        {%- assign routine_bar_index = routine_step_index | minus: 1 -%}
                                        <div
                                            class="routine-showcase__bar{% if routine_bar_index == 0 %} is-active{% endif %}"
                                            data-item-index="{{ routine_bar_index }}"
                                            :class="barClassFromEl($el)"
                                        >
                                            <div
                                                class="routine-showcase__bar-fill"
                                                data-routine-bar-fill
                                                data-item-index="{{ routine_bar_index }}"
                                            ></div>
                                        </div>
                                    {%- endfor -%}
                                </div>
                            </div>

                            <div class="routine-showcase__side-labels">
                                {%- assign routine_step_index = 0 -%}
                                {%- for block in section.blocks -%}
                                    {%- if block.type != 'step' -%}
                                        {%- continue -%}
                                    {%- endif -%}
                                    {%- liquid
                                        assign routine_step_index = routine_step_index | plus: 1
                                        assign routine_label_index = routine_step_index | minus: 1
                                        assign routine_step_label = block.settings.label
                                        if routine_step_label == blank
                                            assign routine_step_label = 'sections.routine-showcase.defaults.step_label' | t
                                        endif
                                        assign routine_label_active = false
                                        if routine_label_index == 0
                                            assign routine_label_active = true
                                        endif
                                    -%}
                                    <p
                                        class="routine-showcase__side-label body-sm uppercase pc:body-md text-theme-text{% unless routine_label_active %} routine-showcase__side-label--inactive{% endunless %}{% if routine_label_active %} is-active{% endif %}"
                                        data-routine-side-label
                                        data-item-index="{{ routine_label_index }}"
                                        :class="sideLabelClassFromEl($el)"
                                    >
                                        {{ routine_step_label }}
                                    </p>
                                {%- endfor -%}
                            </div>

                            <div
                                class="routine-showcase__tabs"
                                role="tablist"
                                aria-label="{{ 'sections.routine-showcase.accessibility.step_tabs' | t }}"
                                @keydown="onTabKeydown($event)"
                            >
                                {%- assign routine_step_index = 0 -%}
                                {%- for block in section.blocks -%}
                                    {%- if block.type != 'step' -%}
                                        {%- continue -%}
                                    {%- endif -%}
                                    {%- liquid
                                        assign routine_step_index = routine_step_index | plus: 1
                                        assign routine_tab_index = routine_step_index | minus: 1
                                        assign routine_step_label = block.settings.label
                                        if routine_step_label == blank
                                            assign routine_step_label = 'sections.routine-showcase.defaults.step_label' | t
                                        endif
                                        assign routine_product = block.settings.product
                                        assign routine_tab_product_title = routine_product.title
                                        if routine_product == blank
                                            assign routine_tab_product_title = 'sections.routine-showcase.placeholder_product_title' | t: index: routine_step_index
                                        endif
                                        assign routine_tab_aria = 'sections.routine-showcase.accessibility.step_tab' | t: step: routine_step_index, label: routine_step_label, product: routine_tab_product_title
                                        assign routine_tab_selected = false
                                        if routine_tab_index == 0
                                            assign routine_tab_selected = true
                                        endif
                                        assign routine_placeholder_index = routine_step_index | minus: 1 | modulo: 6 | plus: 1
                                        assign routine_placeholder_key = 'product-' | append: routine_placeholder_index
                                    -%}
                                    <button
                                        type="button"
                                        role="tab"
                                        class="routine-showcase__tab"
                                        id="routine-showcase-{{ section.id }}-tab-{{ routine_tab_index }}"
                                        aria-controls="routine-showcase-{{ section.id }}-panel-{{ routine_tab_index }}"
                                        aria-selected="{% if routine_tab_selected %}true{% else %}false{% endif %}"
                                        tabindex="{% if routine_tab_selected %}0{% else %}-1{% endif %}"
                                        data-item-index="{{ routine_tab_index }}"
                                        x-init="registerTab($el)"
                                        @click="selectTabFromEl($el)"
                                        :tabindex="tabTabindexFromEl($el)"
                                        :aria-selected="tabAriaSelectedFromEl($el)"
                                        :class="tabActiveClassFromEl($el)"
                                    >
                                        <span class="routine-showcase__tab-thumb">
                                            {%- if routine_product != blank and routine_product.featured_image != blank -%}
                                                {%- render 'image',
                                                    image: routine_product.featured_image,
                                                    alt: '',
                                                    mode: 'frame',
                                                    fit: 'contain',
                                                    loading: 'lazy',
                                                    sizes: '80px',
                                                    widths: '80,120,160',
                                                    wrapper_class: 'h-full w-full',
                                                    img_class: 'h-full w-full object-contain'
                                                -%}
                                            {%- else -%}
                                                {{ routine_placeholder_key | placeholder_svg_tag: 'h-full w-full object-cover' }}
                                            {%- endif -%}
                                        </span>
                                        <span class="routine-showcase__tab-caption text-center body-sm text-muted">
                                            {{ routine_step_label }}
                                        </span>
                                        <span class="sr-only">{{ routine_tab_aria }}</span>
                                    </button>
                                {%- endfor -%}
                            </div>
                        </div>
                    </div>
                </div>
                </div>
            {%- endif -%}
        </div>
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: 'routine-showcase-section',
    scheme_target: 'none',
    surface_section: false,
    width: 'full',
    height_kind: 'content',
    padding_mode: 'overlay',
    motion: false,
    safe_top: false,
    root_attrs: routine_showcase_root_attrs,
    children: routine_showcase_children
%}

{% stylesheet %}
    .routine-showcase-section {
        overflow: hidden;
    }

    .routine-showcase__root {
        position: relative;
        color: rgb(var(--color-foreground));
    }

    .routine-showcase__bg {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
    }

    .routine-showcase__inner {
        position: relative;
        z-index: 1;
        box-sizing: border-box;
        width: 100%;
        container-type: inline-size;
        container-name: routine-showcase;
    }

    .routine-showcase__mobile-card {
        display: flex;
        flex-direction: column;
        gap: 0.875rem;
        padding: 1.25rem;
        border-radius: 0.5rem;
        /* lint-allow raw-colour: owner 6-C9, dedicated white card surface role */
        background-color: #fff;
        box-shadow: 0 0 0 1px var(--color-line);
        box-sizing: border-box;
    }

    .routine-showcase__mobile-product {
        position: relative;
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .routine-showcase__mobile-product::before {
        content: '';
        position: absolute;
        inset: 8%;
        border-radius: 50%;
        /* lint-allow raw-colour: owner 6-C9, sage product halo gradient */
        background: radial-gradient(
            circle at center,
            rgba(154, 171, 138, 0.45) 0%,
            rgba(154, 171, 138, 0.12) 55%,
            transparent 72%
        );
        pointer-events: none;
        z-index: 0;
    }

    .routine-showcase__mobile-product-link {
        position: relative;
        z-index: 1;
        width: 72%;
        height: 72%;
        margin-inline: auto;
    }

    .routine-showcase__mobile-badge {
        align-self: flex-start;
        padding: 0.35rem 0.65rem;
        border-radius: 0.375rem;
        background-color: rgb(var(--color-foreground));
        color: rgb(var(--color-background));
    }

    .routine-showcase__mobile-footer {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.75rem 1.25rem;
    }

    .routine-showcase__heading {
        font-weight: 400;
    }

    .routine-showcase__desktop {
        display: none;
    }

    .routine-showcase__placeholder-svg {
        display: block;
        width: 100%;
        height: 100%;
    }

    .routine-showcase__placeholder-svg--scene {
        object-fit: cover;
    }

    .routine-showcase__placeholder-svg--product {
        object-fit: contain;
    }

    @media (width >= 64rem) {
        .routine-showcase__mobile-rail,
        .routine-showcase__mobile-dots {
            display: none;
        }

        .routine-showcase__desktop {
            display: block;
        }

        .routine-showcase__desktop-grid {
            display: flex;
            align-items: stretch;
            justify-content: space-between;
            gap: clamp(1.25rem, 3vw, 3.5rem);
            --routine-stage-height: clamp(40rem, 58cqi, calc(var(--screen-height) - 4rem));
            --routine-arch-ratio: 0.5;
            min-height: var(--routine-stage-height);
            height: var(--routine-stage-height);
        }

        .routine-showcase__col {
            display: flex;
            flex-direction: column;
            min-height: 0;
            height: 100%;
        }

        .routine-showcase__col--left {
            flex: 1 1 33%;
            min-width: 0;
            max-width: 38%;
            justify-content: space-between;
            gap: 2.5rem;
        }

        .routine-showcase__col--center {
            flex: 0 0 auto;
            width: calc(var(--routine-stage-height) * 0.9 * var(--routine-arch-ratio));
            align-items: center;
            justify-content: flex-end;
        }

        .routine-showcase__col--right {
            flex: 0 1 20%;
            min-width: 0;
            max-width: 22%;
            align-items: flex-end;
            text-align: right;
            justify-content: space-between;
            gap: 2rem;
        }

        .routine-showcase__intro {
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
            max-width: 100%;
        }

        .routine-showcase__info-stack {
            position: relative;
            min-height: 12rem;
            max-width: min(100%, 26.75rem);
        }

        .routine-showcase__info {
            transition:
                opacity var(--motion-duration-base, 300ms) ease,
                transform var(--motion-duration-base, 300ms) ease;
        }

        .routine-showcase__info--inactive {
            visibility: hidden;
            position: absolute;
            inset: 0;
            opacity: 0;
            transform: translateY(0.75rem);
            pointer-events: none;
        }

        .routine-showcase__info.is-active {
            visibility: visible;
            position: relative;
            opacity: 1;
            transform: translateY(0);
            pointer-events: auto;
        }

        .routine-showcase__product-divider {
            width: 5.5rem;
            max-width: 100%;
            margin: 1rem 0;
            border: 0;
            border-top: 1px solid var(--color-line);
        }

        .routine-showcase__stage {
            position: relative;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: flex-end;
            justify-content: center;
        }

        .routine-showcase__panel {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: flex-end;
            justify-content: center;
        }

        .routine-showcase__panel--inactive {
            visibility: hidden;
            pointer-events: none;
        }

        .routine-showcase__panel.is-active {
            visibility: visible;
            pointer-events: auto;
        }

        .routine-showcase__arch-compose {
            position: relative;
            width: 100%;
            height: 90%;
            overflow: visible;
        }

        .routine-showcase__arch {
            box-sizing: border-box;
            width: 100%;
            height: 100%;
            border: 1px solid var(--color-line);
            border-radius: 9999px;
            overflow: hidden;
        }

        .routine-showcase__scene--placeholder {
            display: flex;
            width: 100%;
            height: 100%;
            background-color: rgb(var(--color-background));

            @supports (background-color: color-mix(in oklab, white, black)) {
                background-color: var(--color-surface-muted);
            }
        }

        .routine-showcase__scene-img {
            opacity: 0;
            transition: opacity var(--motion-duration-base, 300ms) ease;
        }

        .routine-showcase__panel.is-active .routine-showcase__scene-img {
            opacity: 1;
        }

        .routine-showcase__product-float {
            position: absolute;
            left: 50%;
            top: 34%;
            z-index: 2;
            width: 46%;
            height: 74%;
            transform: translateX(-50%);
            pointer-events: none;
        }

        .routine-showcase__product-link {
            display: block;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        .routine-showcase__product-link .routine-showcase__placeholder-svg--product,
        .routine-showcase__product-link img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain;
            object-position: bottom center;
        }

        .routine-showcase__product-img {
            opacity: 0;
            transform: translateY(1rem);
            transition:
                opacity var(--motion-duration-base, 300ms) ease 100ms,
                transform var(--motion-duration-base, 300ms) ease 100ms;
        }

        .routine-showcase__panel.is-active .routine-showcase__product-img,
        .routine-showcase__panel.is-active .routine-showcase__product-link {
            opacity: 1;
            transform: translateY(0);
        }

        .routine-showcase__controls {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            width: 100%;
        }

        .routine-showcase__counter-row {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 0.75rem;
            width: 100%;
        }

        .routine-showcase__bars {
            display: inline-flex;
            gap: 0.625rem;
            margin-top: 0.75rem;
            justify-content: flex-end;
        }

        .routine-showcase__bar {
            flex: 0 0 auto;
            width: 3.125rem;
            height: 0.25rem;
            border-radius: 9999px;
            background: var(--color-surface-strong);
            overflow: hidden;
        }

        .routine-showcase__bar-fill {
            display: block;
            width: 100%;
            height: 100%;
            transform: scaleX(0);
            transform-origin: left center;
            background: rgb(var(--color-foreground));
        }

        .routine-showcase__bar.is-active .routine-showcase__bar-fill.is-static-full {
            transform: scaleX(1);
        }

        .routine-showcase__bar.is-active .routine-showcase__bar-fill.is-animating {
            animation: routine-showcase-progress var(--routine-autoplay-duration, 5s) linear
                forwards;
        }

        .routine-showcase__root.is-autoplay-paused
            .routine-showcase__bar.is-active
            .routine-showcase__bar-fill.is-animating {
            animation-play-state: paused;
        }

        @keyframes routine-showcase-progress {
            from {
                transform: scaleX(0);
            }

            to {
                transform: scaleX(1);
            }
        }

        .routine-showcase__side-labels {
            position: relative;
            flex: 1 1 auto;
            display: flex;
            align-items: center;
            justify-content: flex-end;
        }

        .routine-showcase__side-label {
            position: absolute;
            right: 0;
            writing-mode: vertical-rl;
            transform: rotate(180deg);
            letter-spacing: 0.12em;
            transition: opacity var(--motion-duration-base, 300ms) ease;
        }

        .routine-showcase__side-label--inactive {
            visibility: hidden;
            opacity: 0;
        }

        .routine-showcase__side-label.is-active {
            visibility: visible;
            opacity: 1;
        }

        .routine-showcase__tabs {
            display: flex;
            gap: clamp(0.5rem, 1.5cqi, 0.9375rem);
            flex-wrap: nowrap;
            justify-content: flex-end;
            width: 100%;
            max-width: 100%;
        }

        .routine-showcase__tab {
            display: flex;
            flex: 1 1 0;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            min-width: 0;
            max-width: 5rem;
            padding: 0;
            border: 0;
            background: none;
            cursor: pointer;
            opacity: 0.5;
        }

        .routine-showcase__tab.is-active {
            opacity: 1;
        }

        .routine-showcase__tab-thumb {
            display: block;
            width: 100%;
            min-width: 0;
            aspect-ratio: 2 / 3;
            border-radius: 0.5rem;
            overflow: hidden;
            border: 1.5px solid transparent;
            background-color: var(--color-surface-muted);
        }

        .routine-showcase__tab.is-active .routine-showcase__tab-thumb {
            border-color: rgb(var(--color-foreground));
        }

        .routine-showcase__tab-caption {
            display: -webkit-box;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
            overflow: hidden;
            overflow-wrap: normal;
            word-break: normal;
            hyphens: none;
        }
    }

    body[data-motion-enabled='false'] .routine-showcase__info,
    body[data-motion-enabled='false'] .routine-showcase__scene-img,
    body[data-motion-enabled='false'] .routine-showcase__product-img {
        transition: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .routine-showcase__info,
        .routine-showcase__scene-img,
        .routine-showcase__product-img {
            transition: none;
        }

        .routine-showcase__bar.is-active .routine-showcase__bar-fill.is-animating {
            animation: none;
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.routine-showcase.name",
    "tag": "section",
    "class": "section",
    "max_blocks": 5,
    "disabled_on": {
        "groups": ["header", "footer", "custom.overlay"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.routine-showcase.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.font"
        },
        {
            "type": "header",
            "content": "t:sections.routine-showcase.content.section_heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "heading-4xl",
                    "label": "t:sections.slides-show.options.heading_4xl"
                },
                {
                    "value": "heading-3xl",
                    "label": "t:sections.slides-show.options.heading_3xl"
                },
                {
                    "value": "heading-2xl",
                    "label": "t:sections.slides-show.options.heading_2xl"
                },
                {
                    "value": "heading-xl",
                    "label": "t:sections.slides-show.options.heading_xl"
                },
                {
                    "value": "heading-h1",
                    "label": "t:sections.slides-show.options.heading_h1"
                },
                {
                    "value": "heading-h2",
                    "label": "t:sections.slides-show.options.heading_h2"
                },
                {
                    "value": "heading-h3",
                    "label": "t:sections.slides-show.options.heading_h3"
                },
                {
                    "value": "heading-h4",
                    "label": "t:sections.slides-show.options.heading_h4"
                },
                {
                    "value": "heading-h5",
                    "label": "t:sections.slides-show.options.heading_h5"
                },
                {
                    "value": "heading-h6",
                    "label": "t:sections.slides-show.options.heading_h6"
                }
            ],
            "default": "heading-h4"
        },
        {
            "type": "image_picker",
            "id": "bg_img",
            "label": "t:sections.routine-showcase.settings.background_image"
        },
        {
            "type": "inline_richtext",
            "id": "eyebrow",
            "label": "t:sections.routine-showcase.settings.eyebrow",
            "default": "2026©"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "t:sections.routine-showcase.settings.heading",
            "default": "t:sections.routine-showcase.defaults.heading"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "t:sections.routine-showcase.settings.description",
            "default": "t:sections.routine-showcase.defaults.description_html"
        },
        {
            "type": "inline_richtext",
            "id": "cta_text",
            "label": "t:sections.routine-showcase.settings.call_to_action_text",
            "default": "t:sections.routine-showcase.defaults.cta_text"
        },
        {
            "type": "url",
            "id": "cta_link",
            "label": "t:sections.routine-showcase.settings.link_url",
            "default": "/collections"
        },
        {
            "type": "checkbox",
            "id": "autoplay",
            "label": "t:sections.routine-showcase.settings.autoplay",
            "default": true
        },
        {
            "type": "range",
            "id": "autoplay_speed",
            "min": 3,
            "max": 10,
            "step": 1,
            "unit": "s",
            "label": "t:sections.routine-showcase.settings.autoplay_speed",
            "default": 5
        },
        {
            "type": "header",
            "content": "t:sections.routine-showcase.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.routine-showcase.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.routine-showcase.settings.padding_bottom",
            "default": 32
        }
    ],
    "blocks": [
        {
            "type": "step",
            "name": "t:sections.routine-showcase.blocks.step.name",
            "settings": [
                {
                    "type": "product",
                    "id": "product",
                    "label": "t:sections.routine-showcase.blocks.step.settings.product"
                },
                {
                    "type": "text",
                    "id": "label",
                    "label": "t:sections.routine-showcase.blocks.step.settings.label",
                    "default": "t:sections.routine-showcase.defaults.step_label"
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:sections.routine-showcase.blocks.step.settings.image"
                },
                {
                    "type": "image_picker",
                    "id": "product_image",
                    "label": "t:sections.routine-showcase.blocks.step.settings.product_image",
                    "info": "t:sections.routine-showcase.blocks.step.settings.product_image_info"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.routine-showcase.presets.routine_showcase",
            "blocks": [
                {
                    "type": "step",
                    "settings": {
                        "label": "Cleanse"
                    }
                },
                {
                    "type": "step",
                    "settings": {
                        "label": "Treat"
                    }
                },
                {
                    "type": "step",
                    "settings": {
                        "label": "Protect"
                    }
                }
            ]
        }
    ]
}
{% endschema %}
