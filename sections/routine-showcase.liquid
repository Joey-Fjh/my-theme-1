{%- liquid
    assign product_position = section.settings.product_position | default: 'left'
    assign product_position_class = 'pc:left-0'
    case product_position
        when 'center'
            assign product_position_class = 'pc:left-1/2 pc:-translate-x-1/2'
        when 'right'
            assign product_position_class = 'pc:right-0'
    endcase

    assign content_position = section.settings.content_position | default: 'place-center-right'

    assign badge_position = section.settings.badge_position | default: 'place-bottom-right'
-%}

<div
    data-section-id="{{ section.id }}"
    class="routine-showcase-section full-width"
    data-component-kind="section"
    data-component-type="routine-showcase"
    data-component-id="{{ section.id }}"
>
    <div class="relative h-screen overflow-hidden">
        {%- capture sizes -%}
            (min-width: 80rem) 100vw, (min-width: 48rem) 1280px, 100vw
        {%- endcapture -%}

        {%- capture widths -%}
            400,480,768,1280,1440,1536,2560
        {%- endcapture -%}

        <div class="absolute inset-0">
            {%-
                render 'image',
                image: section.settings.bg_img,
                alt: section.settings.bg_img.alt | default: section.settings.heading | escape,
                width: section.settings.bg_img.width,
                sizes: sizes,
                widths: widths,
                loading: 'lazy'
            -%}
        </div>

        <div class="layout container-page relative h-full color-{{ section.settings.color_scheme }} bg-transparent!">
            <div class="relative flex h-full flex-col gap-8 py-3 pc:block">
                <div class="{{ product_position_class }} z-20 flex min-w-0 flex-col gap-5 pc:absolute pc:top-3 pc:bottom-3 pc:w-fit">
                    <div class="routine-showcase__swiper-wrap flex min-h-0 flex-row gap-3 max-pc:h-full pc:h-full pc:w-fit pc:flex-col pc:justify-between">
                        <button
                            type="button"
                            class="swiper-button-prev self-center"
                            aria-label="{{ 'accessibility.previous_slide' | t }}"
                        ></button>
                        <div
                            class="swiper ml-0 min-w-0 flex-1 pc:h-full pc:min-h-0"
                            role="region"
                            aria-label="{{ 'accessibility.routine_carousel' | t }}"
                            aria-roledescription="{{ 'accessibility.carousel' | t }}"
                        >
                            <div class="swiper-wrapper">
                                {%- assign products = section.settings.collection.products -%}

                                {%- for product in products -%}
                                    <div class="swiper-slide w-auto pc:w-136">
                                        <a
                                            class="relative block h-full"
                                            href="{{ product.url }}"
                                            x-data="{ hover: false }"
                                            @mouseenter="hover = true"
                                            @mouseleave="hover = false"
                                        >
                                            {%-
                                                render 'image',
                                                aspect_ratio: '342/198',
                                                image: product.featured_image,
                                                alt: product.title | escape,
                                                width: product.featured_image.width
                                            -%}

                                            <div
                                                class="
                                                    absolute right-0 bottom-0 left-0
                                                    flex items-center justify-between p-2 transition-colors pc:p-4
                                                "
                                                :class=" hover ? 'bg-theme-text text-theme-bg' : 'bg-theme-bg text-theme-text' "
                                            >
                                                <h3 class="truncate h4">{{ product.title }}</h3>
                                                <div class="body-xs text-nowrap opacity-20 pc:body-md">
                                                    {% if forloop.index < 10 %}
                                                        {% assign display_index = forloop.index
                                                            | prepend: '0'
                                                        %}
                                                    {% else %}
                                                        {% assign display_index = forloop.index %}
                                                    {% endif %}
                                                    {{ display_index }}
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                {%- endfor -%}
                            </div>
                        </div>
                        <button
                            type="button"
                            class="swiper-button-next left-0 self-center"
                            aria-label="{{ 'accessibility.next_slide' | t }}"
                        ></button>
                    </div>

                    <div class="opacity-80">
                        {{ section.settings.badge_counter }}
                    </div>
                </div>

                <div class="grid flex-1 grid-cols-1 grid-rows-3 pc:absolute pc:inset-0 pc:grid-cols-3">
                    <div class="{{ content_position }} flex w-auto flex-col gap-12 p-6 fw:w-3/5">
                        <div>{{ section.settings.eyebrow }}</div>

                        <div class="gap-2">
                            <h3>{{ section.settings.heading }}</h3>
                            <div class="opacity-60">{{ section.settings.description }}</div>
                        </div>

                        {%- capture link_content -%}
                            <span>{{ section.settings.cta_text }}</span>
                            {% render 'icons', icon: 'icon-arrow2', size: 'lg', class: 'ml-3',color:'current' %}
                        {%- endcapture -%}

                        {%- render 'link',
                            href: section.settings.cta_link,
                            content: link_content,
                            variant: 'underline',
                            color: 'current'
                        -%}
                    </div>

                    <div class="{{ badge_position }} flex h-full w-full items-center justify-center max-pc:hidden">
                        {%- render 'rotating-badge',
                            classes: 'relative',
                            unique_id: section.id,
                            size: 100,
                            badge_text: section.settings.rotate_badge_text,
                            center_text: section.settings.rotate_badge_percent
                        -%}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components) return;

        Components.register(
            'routine-showcase',
            {
                init(el) {
                    const swiperContainer = el.querySelector('.swiper');

                    if (!swiperContainer || typeof Swiper === 'undefined') return;

                    const mql = window.matchMedia('(min-width: 768px)');
                    const state = { swiper: null, mql: mql, handler: null };

                    function createSwiper() {
                        if (state.swiper) state.swiper.destroy(true, true);

                        const isDesktop = mql.matches;

                        state.swiper = new Swiper(swiperContainer, {
                            direction: isDesktop ? 'vertical' : 'horizontal',
                            slidesPerView: isDesktop ? 4 : 2,
                            grid: isDesktop ? { rows: 1 } : { rows: 2, fill: 'row' },
                            autoHeight: false,
                            spaceBetween: 8,
                            speed: 300,
                            loop: false,
                            allowTouchMove: true,
                            navigation: {
                                nextEl: el.querySelector('.swiper-button-next'),
                                prevEl: el.querySelector('.swiper-button-prev'),
                            },
                        });
                    }

                    state.handler = () => createSwiper();

                    const swiperWrap = el.querySelector('.routine-showcase__swiper-wrap');

                    createSwiper();
                    if (swiperWrap) swiperWrap.classList.add('is-ready');
                    mql.addEventListener('change', state.handler);

                    return state;
                },

                destroy(el, state) {
                    if (!state) return;

                    if (state.mql && state.handler) {
                        state.mql.removeEventListener('change', state.handler);
                    }

                    if (state.swiper?.destroy) {
                        state.swiper.destroy(true, true);
                    }
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{% stylesheet %}
    .routine-showcase-section {
        .swiper-button-prev,
        .swiper-button-next {
            --swiper-navigation-size: 18px;
            --swiper-navigation-color: currentColor;
            position: relative;
            top: 0;
            margin-top: 0;
            border: 0;
            padding: 0;
            background: none;
            cursor: pointer;
        }

        @media (min-width: 768px) {
            .swiper-button-prev {
                transform: rotate(90deg);
            }
        }

        .routine-showcase__swiper-wrap {
            visibility: hidden;

            &.is-ready {
                visibility: visible;
            }
        }
    }
{% endstylesheet %}

