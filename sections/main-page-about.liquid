{%- liquid
    assign about_heading_class = section.settings.heading_size | default: 'title-2xl'
    assign about_subtitle_size = section.settings.subtitle_size | default: 'copy-l'
    assign about_subtitle_class = 'typo-subtitle ' | append: about_subtitle_size
    assign about_ratio = section.settings.image.aspect_ratio | default: 1.778
    assign about_ratio_style = '--main-page-about-ratio: ' | append: about_ratio | append: ';'
-%}
{%- capture about_children -%}
    <div class="absolute inset-0">
        {%- capture sizes -%}
            (min-width: 80rem) 100vw, (min-width: 48rem) 1280px, 768px
        {%- endcapture -%}

        {%- capture widths -%}
            400,768,1280,1536,2560
        {%- endcapture -%}

        {%- assign image_alt_fallback = 'sections.main-page-about.defaults.image_alt' | t -%}
        {%- assign image_alt = section.settings.image_alt | default: image_alt_fallback | escape -%}
        {%- render 'image',
            image: section.settings.image,
            alt: image_alt,
            width: section.settings.image.width,
            sizes: sizes,
            widths: widths,
            class: 'h-full w-full',
            img_class: 'h-full w-full object-cover object-center',
            placeholder_key: 'lifestyle-1',
            placeholder_style: 'plain',
        -%}
    </div>

    <div class="section-frame__overlay-padding container-page content-center">
        <div
            class="mx-auto flex w-full max-w-3xl flex-col items-center gap-step-xs px-step-m text-center tablet:max-w-1/2 tablet:gap-step-m"
        >
            <p
                class="{{ about_subtitle_class }}"
            >
                {{ section.settings.eyebrow }}
            </p>
            <h1
                class="{{ about_heading_class }}"
            >
                {{ section.settings.heading }}
            </h1>
            <div
                class="rte rte--compact"
            >
                {{ section.settings.description }}
            </div>
        </div>
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: 'main-page-about-section',
    width: 'full',
    height_kind: 'content',
    padding_mode: 'overlay',
    surface_section: false,
    motion: false,
    root_style: about_ratio_style,
    inner_class: 'main-page-about__stage grid min-h-200',
    root_attrs: '',
    children: about_children
%}

{% stylesheet %}
    /* The fixed header covers the top of the page, so the image starts below it. */
    main > .shopify-section:first-child > .main-page-about-section {
        padding-top: calc(
            var(--announcement-bar-offset, var(--announcement-bar-height, 0px)) +
                var(--header-height, 0px)
        );
    }

    /* Image ratio up to 80svh; taller copy still grows the stage. */
    @media (width >= 48rem) {
        .main-page-about__stage {
            min-height: min(calc(100vw / var(--main-page-about-ratio)), 80svh);
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.main-page-about.name",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["page"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.main-page-about.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:sections.main-page-about.settings.image"
        },
        {
            "type": "inline_richtext",
            "id": "eyebrow",
            "default": "t:sections.main-page-about.defaults.eyebrow",
            "label": "t:sections.main-page-about.settings.eyebrow_text"
        },
        {
            "type": "header",
            "content": "t:sections.scroll-categories.content.subtitle"
        },
        {
            "type": "select",
            "id": "subtitle_size",
            "label": "t:sections.scroll-categories.settings.subtitle_size",
            "options": [
                {
                    "value": "copy-xl",
                    "label": "t:settings.type_size.copy_xl"
                },
                {
                    "value": "copy-l",
                    "label": "t:settings.type_size.copy_l"
                },
                {
                    "value": "copy-m",
                    "label": "t:settings.type_size.copy_m"
                },
                {
                    "value": "copy-s",
                    "label": "t:settings.type_size.copy_s"
                }
            ],
            "default": "copy-l"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "default": "t:sections.main-page-about.defaults.heading",
            "label": "t:sections.main-page-about.settings.heading"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "title-4xl",
                    "label": "t:settings.type_size.title_4xl"
                },
                {
                    "value": "title-3xl",
                    "label": "t:settings.type_size.title_3xl"
                },
                {
                    "value": "title-2xl",
                    "label": "t:settings.type_size.title_2xl"
                },
                {
                    "value": "title-xl",
                    "label": "t:settings.type_size.title_xl"
                },
                {
                    "value": "title-l",
                    "label": "t:settings.type_size.title_l"
                },
                {
                    "value": "title-m",
                    "label": "t:settings.type_size.title_m"
                },
                {
                    "value": "title-s",
                    "label": "t:settings.type_size.title_s"
                },
                {
                    "value": "title-xs",
                    "label": "t:settings.type_size.title_xs"
                }
            ],
            "default": "title-2xl"
        },
        {
            "type": "richtext",
            "id": "description",
            "default": "t:sections.main-page-about.defaults.description",
            "label": "t:sections.main-page-about.settings.description"
        },
        {
            "type": "text",
            "id": "image_alt",
            "default": "t:sections.main-page-about.defaults.image_alt",
            "label": "t:sections.main-page-about.settings.image_alt_text"
        },
        {
            "type": "header",
            "content": "t:sections.main-page-about.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.main-page-about.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.main-page-about.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
