<div
    data-section-id="{{ section.id }}"
    class="main-page-about-section full-width"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="main-page-about"
    data-component-id="{{ section.id }}"
>
    <div data-gsap-image>
        {%- capture sizes -%}
            (min-width: 80rem) 100vw, (min-width: 48rem) 1280px, 768px
        {%- endcapture -%}

        {%- capture widths -%}
            400,768,1280,1536,2560
        {%- endcapture -%}

        {%-
            render 'image',
            image: section.settings.image,
            alt: section.settings.image_alt | default: 'About Us' | escape,
            width: section.settings.image.width,
            sizes: sizes,
            widths: widths
        -%}
    </div>

    <div class="layout container-page absolute inset-0">
        <div class="mx-auto flex max-w-1/2 flex-col items-center justify-center gap-5 text-center text-white">
            <h3
                data-gsap-item
                class="text-[#D5FF83]"
            >
                About Eccenova
            </h3>
            <h1
                data-gsap-item
                class="hxl font-bold"
            >
                A Gentle Approach to Better Skin
            </h1>
            <h3
                data-gsap-item
                class="opacity-80"
            >
                Because your skin deserves more than promises.
            </h3>
        </div>
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components || typeof gsap === 'undefined') return;

        Components.register(
            'main-page-about',
            {
                init(el) {
                    const ctx = gsap.context(() => {
                        const imageWrapper = el.querySelector('[data-gsap-image]');
                        const image = imageWrapper?.querySelector('img');
                        const items = el.querySelectorAll('[data-gsap-item]');

                        if (!image || !items.length) return;

                        gsap.set(image, { scale: 1.1, opacity: 0 });
                        gsap.set(items, { y: 40, opacity: 0 });

                        const tl = gsap.timeline({
                            defaults: { ease: 'power2.out' },
                            scrollTrigger: {
                                trigger: el,
                                start: 'top 80%',
                                once: true,
                            },
                        });

                        tl.to(image, {
                            scale: 1,
                            opacity: 1,
                            duration: 1.3,
                        });

                        tl.to(
                            items,
                            {
                                y: 0,
                                opacity: 1,
                                duration: 0.9,
                                stagger: 0.2,
                            },
                            '-=0.8',
                        );
                    }, el);

                    return { ctx };
                },

                destroy(el, state) {
                    if (state?.ctx) {
                        state.ctx.revert();
                    }
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{%- stylesheet -%}
{%- endstylesheet -%}

{% schema %}
{
    "name": "About Us",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["page"]
    },
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "image_alt",
            "default": "About Us",
            "label": "Image alt text"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "About Us",
            "settings": {}
        }
    ]
}
{% endschema %}
