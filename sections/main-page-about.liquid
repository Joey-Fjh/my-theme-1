<div
    data-section-id="{{ section.id }}"
    class="
        main-page-about-section full-width relative overflow-hidden color-{{ section.settings.color_scheme }}
        min-h-200 pc:min-h-0
    "
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="motionRevealSection()"
    data-motion-section
>
    {%- liquid
        assign about_heading_class = section.settings.heading_size | default: 'heading-2xl'
        assign about_subtitle_size = section.settings.subtitle_size | default: 'body-xl'
        assign about_subtitle_class = 'typo-subtitle ' | append: about_subtitle_size
    -%}
    <div
        class="absolute inset-0 h-full w-full pc:static pc:h-auto"
    >
        {%- capture sizes -%}
            (min-width: 80rem) 100vw, (min-width: 48rem) 1280px, 768px
        {%- endcapture -%}

        {%- capture widths -%}
            400,768,1280,1536,2560
        {%- endcapture -%}

        {%- assign image_alt_fallback = 'sections.main-page-about.defaults.image_alt' | t -%}
        {%- assign image_alt = section.settings.image_alt | default: image_alt_fallback | escape -%}
        {%- render 'image',
            image: section.settings.image,
            alt: image_alt,
            width: section.settings.image.width,
            sizes: sizes,
            widths: widths,
            class: 'h-full w-full pc:h-auto',
            img_class: 'h-full w-full object-cover object-center'
        -%}
    </div>

    <div class="layout container-page absolute inset-0">
        <div class="mx-auto flex h-full w-full max-w-3xl flex-col items-center justify-start gap-3 px-6 pt-28 text-center pc:max-w-1/2 pc:justify-center pc:gap-5 pc:pt-0">
            <p
                class="{{ about_subtitle_class }}"
                data-motion-reveal="content"
            >
                {{ section.settings.eyebrow }}
            </p>
            <h1
                data-motion-reveal="content"
                class="{{ about_heading_class }}"
            >
                {{ section.settings.heading }}
            </h1>
            <div
                data-motion-reveal="content"
                class="rte rte--compact"
            >
                {{ section.settings.description }}
            </div>
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:sections.main-page-about.name",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["page"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.main-page-about.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:sections.main-page-about.settings.image"
        },
        {
            "type": "inline_richtext",
            "id": "eyebrow",
            "default": "t:sections.main-page-about.defaults.eyebrow",
            "label": "t:sections.main-page-about.settings.eyebrow_text"
        },
        {
            "type": "header",
            "content": "t:sections.scroll-categories.content.subtitle"
        },
        {
            "type": "select",
            "id": "subtitle_size",
            "label": "t:sections.scroll-categories.settings.subtitle_size",
            "options": [
                {
                    "value": "body-3xl",
                    "label": "t:sections.scroll-categories.options.body_3xl"
                },
                {
                    "value": "body-2xl",
                    "label": "t:sections.scroll-categories.options.body_2xl"
                },
                {
                    "value": "body-xl",
                    "label": "t:sections.scroll-categories.options.body_xl"
                },
                {
                    "value": "body-lg",
                    "label": "t:sections.scroll-categories.options.body_lg"
                },
                {
                    "value": "body-md",
                    "label": "t:sections.scroll-categories.options.body_md"
                },
                {
                    "value": "body-sm",
                    "label": "t:sections.scroll-categories.options.body_sm"
                },
                {
                    "value": "body-xs",
                    "label": "t:sections.scroll-categories.options.body_xs"
                }
            ],
            "default": "body-xl"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "default": "t:sections.main-page-about.defaults.heading",
            "label": "t:sections.main-page-about.settings.heading"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "heading-4xl",
                    "label": "t:sections.slides-show.options.heading_4xl"
                },
                {
                    "value": "heading-3xl",
                    "label": "t:sections.slides-show.options.heading_3xl"
                },
                {
                    "value": "heading-2xl",
                    "label": "t:sections.slides-show.options.heading_2xl"
                },
                {
                    "value": "heading-xl",
                    "label": "t:sections.slides-show.options.heading_xl"
                },
                {
                    "value": "heading-h1",
                    "label": "t:sections.slides-show.options.heading_h1"
                },
                {
                    "value": "heading-h2",
                    "label": "t:sections.slides-show.options.heading_h2"
                },
                {
                    "value": "heading-h3",
                    "label": "t:sections.slides-show.options.heading_h3"
                },
                {
                    "value": "heading-h4",
                    "label": "t:sections.slides-show.options.heading_h4"
                },
                {
                    "value": "heading-h5",
                    "label": "t:sections.slides-show.options.heading_h5"
                },
                {
                    "value": "heading-h6",
                    "label": "t:sections.slides-show.options.heading_h6"
                }
            ],
            "default": "heading-2xl"
        },
        {
            "type": "richtext",
            "id": "description",
            "default": "t:sections.main-page-about.defaults.description",
            "label": "t:sections.main-page-about.settings.description"
        },
        {
            "type": "text",
            "id": "image_alt",
            "default": "t:sections.main-page-about.defaults.image_alt",
            "label": "t:sections.main-page-about.settings.image_alt_text"
        },
        {
            "type": "header",
            "content": "t:sections.main-page-about.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.main-page-about.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.main-page-about.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
