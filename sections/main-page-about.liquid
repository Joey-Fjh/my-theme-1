<div
    data-section-id="{{ section.id }}"
    class="
        main-page-about-section full-width relative overflow-hidden color-{{ section.settings.color_scheme }}
        min-h-200 pc:min-h-0
    "
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="main-page-about"
    data-component-id="{{ section.id }}"
>
    <div
        data-gsap-image
        class="absolute inset-0 h-full w-full pc:static pc:h-auto"
    >
        {%- capture sizes -%}
            (min-width: 80rem) 100vw, (min-width: 48rem) 1280px, 768px
        {%- endcapture -%}

        {%- capture widths -%}
            400,768,1280,1536,2560
        {%- endcapture -%}

        {%- assign image_alt_fallback = 'sections.main-page-about.defaults.image_alt' | t -%}
        {%- assign image_alt = section.settings.image_alt | default: image_alt_fallback | escape -%}
        {%- render 'image',
            image: section.settings.image,
            alt: image_alt,
            width: section.settings.image.width,
            sizes: sizes,
            widths: widths,
            class: 'h-full w-full pc:h-auto',
            img_class: 'h-full w-full object-cover object-center'
        -%}
    </div>

    <div class="layout container-page absolute inset-0">
        <div class="mx-auto flex h-full w-full max-w-3xl flex-col items-center justify-start gap-3 px-6 pt-28 text-center pc:max-w-1/2 pc:justify-center pc:gap-5 pc:pt-0">
            <p
                class="sub-heading"
                data-gsap-item
            >
                {{ section.settings.eyebrow }}
            </p>
            <h1
                data-gsap-item
                class="pc:heading-2xl"
            >
                {{ section.settings.heading }}
            </h1>
            <div
                data-gsap-item
                class="rte rte--compact"
            >
                {{ section.settings.description }}
            </div>
        </div>
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components || typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined')
            return;

        gsap.registerPlugin(ScrollTrigger);

        Components.register(
            'main-page-about',
            {
                init(el) {
                    const ctx = gsap.context(() => {
                        const imageWrapper = el.querySelector('[data-gsap-image]');
                        const image = imageWrapper?.querySelector('img');
                        const items = el.querySelectorAll('[data-gsap-item]');

                        if (!image || !items.length) return;

                        gsap.set(image, { scale: 1.1, opacity: 0 });
                        gsap.set(items, { y: 40, opacity: 0 });

                        const tl = gsap.timeline({
                            defaults: { ease: 'power2.out' },
                            scrollTrigger: {
                                trigger: el,
                                start: 'top 80%',
                                once: true,
                            },
                        });

                        tl.to(image, {
                            scale: 1,
                            opacity: 1,
                            duration: 1.3,
                        });

                        tl.to(
                            items,
                            {
                                y: 0,
                                opacity: 1,
                                duration: 0.9,
                                stagger: 0.2,
                            },
                            '-=0.8',
                        );
                    }, el);

                    return { ctx };
                },

                destroy(el, state) {
                    if (state?.ctx) {
                        state.ctx.revert();
                    }
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{% schema %}
{
    "name": "t:sections.main-page-about.name",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["page"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.main-page-about.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:sections.main-page-about.settings.image"
        },
        {
            "type": "inline_richtext",
            "id": "eyebrow",
            "default": "t:sections.main-page-about.defaults.eyebrow",
            "label": "t:sections.main-page-about.settings.eyebrow_text"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "default": "t:sections.main-page-about.defaults.heading",
            "label": "t:sections.main-page-about.settings.heading"
        },
        {
            "type": "richtext",
            "id": "description",
            "default": "t:sections.main-page-about.defaults.description",
            "label": "t:sections.main-page-about.settings.description"
        },
        {
            "type": "text",
            "id": "image_alt",
            "default": "t:sections.main-page-about.defaults.image_alt",
            "label": "t:sections.main-page-about.settings.image_alt_text"
        },
        {
            "type": "header",
            "content": "t:sections.main-page-about.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.main-page-about.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.main-page-about.settings.padding_bottom",
            "default": 0
        }
    ]
}
{% endschema %}
