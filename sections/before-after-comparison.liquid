{%- liquid
    assign aspect_ratio = section.settings.image_ratio
    if aspect_ratio == 'auto'
        if section.settings.after_img != blank
            assign aspect_ratio = section.settings.after_img.aspect_ratio
        elsif section.settings.before_img != blank
            assign aspect_ratio = section.settings.before_img.aspect_ratio
        else
            assign aspect_ratio = '16/9'
        endif
    endif

    assign before_after_heading_class = section.settings.heading_size | default: 'heading-2xl'
    assign before_after_subtitle_size = section.settings.subtitle_size | default: 'body-3xl'
    assign before_after_subtitle_class = 'typo-subtitle ' | append: before_after_subtitle_size
-%}

<div
    data-section-id="{{ section.id }}"
    class="before-after-comparison-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="motionRevealSection()"
    data-motion-section
>
    <div class="layout container-page">
        <div class="flex flex-col gap-6 text-center" data-motion-sequence>
            <p
                class="{{ before_after_subtitle_class }}"
                data-motion-reveal="content"
            >
                {{ section.settings.sub_heading }}
            </p>
            <h2
                class="{{ before_after_heading_class }}"
                data-motion-reveal="content"
            >
                {{ section.settings.heading }}
            </h2>
        </div>

        {% comment %} Mobile Layout (Stacked) {% endcomment %}
        <div class="mt-10 flex flex-col gap-6 pc:hidden">
            <div data-motion-bound>
                <div class="relative overflow-hidden rounded-lg" data-motion-reveal="media">
                    {%- assign image_alt = section.settings.before_img.alt
                        | default: section.settings.before_label
                        | escape
                    -%}
                    {%- render 'image',
                        image: section.settings.before_img,
                        alt: image_alt,
                        width: section.settings.before_img.width,
                        aspect_ratio: aspect_ratio,
                        motion_reveal: false
                    -%}
                    <div class="absolute bottom-4 left-4 z-10 rounded border-2 border-theme-text px-3 py-2 body-xl backdrop-blur-sm">
                        {{ section.settings.before_label }}
                    </div>
                </div>
            </div>

            <div data-motion-bound>
                <div class="relative overflow-hidden rounded-lg" data-motion-reveal="media">
                    {%- assign image_alt = section.settings.after_img.alt
                        | default: section.settings.after_label
                        | escape
                    -%}
                    {%- render 'image',
                        image: section.settings.after_img,
                        alt: image_alt,
                        width: section.settings.after_img.width,
                        aspect_ratio: aspect_ratio,
                        motion_reveal: false
                    -%}
                    <div class="absolute right-4 bottom-4 z-10 rounded border-2 border-theme-text px-3 py-2 body-xl backdrop-blur-sm">
                        {{ section.settings.after_label }}
                    </div>
                </div>
            </div>
        </div>

        {% comment %} Desktop Layout (Slider) {% endcomment %}
        <div
            class="mt-25 hidden pc:block"
            x-data="beforeAfterComparison()"
        >
            <div
                class="relative cursor-ew-resize overflow-hidden rounded-lg select-none"
                style="aspect-ratio: {{ aspect_ratio }};"
                x-ref="container"
                @mousedown="startDrag($event)"
                @touchstart.passive="startDrag($event)"
                @mousemove="onDrag($event)"
                @touchmove.passive="onDrag($event)"
                @mouseup="endDrag()"
                @touchend="endDrag()"
                @mouseleave="endDrag()"
                x-intersect:enter.once="animateToCenter()"
            >
                {% comment %} After Image (Background) {% endcomment %}
                <div class="absolute inset-0 h-full w-full">
                    {%- assign image_alt = section.settings.after_img.alt
                        | default: section.settings.after_label
                        | escape
                    -%}
                    {%- render 'image',
                        image: section.settings.after_img,
                        alt: image_alt,
                        width: section.settings.after_img.width,
                        extra_attributes: 'draggable="false"',
                        motion_reveal: false
                    -%}
                </div>

                {% comment %} Before Image (Clipped) {% endcomment %}
                <div
                    class="absolute inset-0 h-full w-full"
                    style="clip-path: inset(0 50% 0 0);"
                    :style="`clip-path: inset(0 ${100 - position}% 0 0)`"
                >
                    {%- assign image_alt = section.settings.before_img.alt
                        | default: section.settings.before_label
                        | escape
                    -%}
                    {%- render 'image',
                        image: section.settings.before_img,
                        alt: image_alt,
                        width: section.settings.before_img.width,
                        extra_attributes: 'draggable="false"',
                        motion_reveal: false
                    -%}
                </div>

                {% comment %} Silder Line {% endcomment %}
                <div
                    class="absolute top-0 bottom-0 z-10 w-2 -translate-x-1/2 bg-theme-bg/80 transition-[left] duration-75 ease-out"
                    style="left: 50%;"
                    :class="{'transition-none' : isDragging }"
                    :style="`left: ${position}%`"
                >
                    {% comment %} Handle {% endcomment %}
                    <button
                        type="button"
                        class="
                            absolute top-1/2 left-1/2 flex h-24 w-24 -translate-x-1/2 -translate-y-1/2 cursor-grab items-center justify-center gap-0 rounded-full bg-theme-bg focus-ring
                            transition-transform duration-200 hover:scale-110 focus:outline-none active:cursor-grabbing
                        "
                        @mousedown.stop="startDrag($event)"
                        @touchstart.stop.passive="startDrag($event)"
                        @keydown="handleKeydown($event)"
                        role="slider"
                        aria-valuemin="0"
                        aria-valuemax="100"
                        :aria-valuenow="Math.round(position)"
                        aria-label="{{ 'accessibility.drag_to_compare' | t }}"
                    >
                        {%- render 'icons', icon: 'icon-chevron-left' -%}
                        {%- render 'icons', icon: 'icon-chevron-right', class: '-ms-2' -%}
                    </button>
                </div>

                {% comment %} Before Label {% endcomment %}
                <div class="absolute bottom-10 left-10 z-10 rounded border-2 border-theme-text p-4 body-xl backdrop-blur-sm">
                    {{ section.settings.before_label }}
                </div>

                {% comment %} After Label {% endcomment %}
                <div class="absolute right-10 bottom-10 z-10 rounded border-2 border-theme-text p-4 body-xl backdrop-blur-sm">
                    {{ section.settings.after_label }}
                </div>
            </div>
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:sections.before-after-comparison.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.before-after-comparison.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.font"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "heading-4xl",
                    "label": "t:sections.slides-show.options.heading_4xl"
                },
                {
                    "value": "heading-3xl",
                    "label": "t:sections.slides-show.options.heading_3xl"
                },
                {
                    "value": "heading-2xl",
                    "label": "t:sections.slides-show.options.heading_2xl"
                },
                {
                    "value": "heading-xl",
                    "label": "t:sections.slides-show.options.heading_xl"
                },
                {
                    "value": "heading-h1",
                    "label": "t:sections.slides-show.options.heading_h1"
                },
                {
                    "value": "heading-h2",
                    "label": "t:sections.slides-show.options.heading_h2"
                },
                {
                    "value": "heading-h3",
                    "label": "t:sections.slides-show.options.heading_h3"
                },
                {
                    "value": "heading-h4",
                    "label": "t:sections.slides-show.options.heading_h4"
                },
                {
                    "value": "heading-h5",
                    "label": "t:sections.slides-show.options.heading_h5"
                },
                {
                    "value": "heading-h6",
                    "label": "t:sections.slides-show.options.heading_h6"
                }
            ],
            "default": "heading-2xl"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "t:sections.before-after-comparison.settings.heading",
            "default": "t:sections.before-after-comparison.defaults.heading"
        },
        {
            "type": "header",
            "content": "t:sections.scroll-categories.content.subtitle"
        },
        {
            "type": "select",
            "id": "subtitle_size",
            "label": "t:sections.scroll-categories.settings.subtitle_size",
            "options": [
                {
                    "value": "body-3xl",
                    "label": "t:sections.scroll-categories.options.body_3xl"
                },
                {
                    "value": "body-2xl",
                    "label": "t:sections.scroll-categories.options.body_2xl"
                },
                {
                    "value": "body-xl",
                    "label": "t:sections.scroll-categories.options.body_xl"
                },
                {
                    "value": "body-lg",
                    "label": "t:sections.scroll-categories.options.body_lg"
                },
                {
                    "value": "body-md",
                    "label": "t:sections.scroll-categories.options.body_md"
                },
                {
                    "value": "body-sm",
                    "label": "t:sections.scroll-categories.options.body_sm"
                }
            ],
            "default": "body-3xl"
        },
        {
            "type": "inline_richtext",
            "id": "sub_heading",
            "label": "t:sections.before-after-comparison.settings.sub_heading",
            "default": "t:sections.before-after-comparison.defaults.sub_heading"
        },
        {
            "type": "select",
            "id": "image_ratio",
            "label": "t:sections.before-after-comparison.settings.image_ratio",
            "options": [
                {
                    "value": "auto",
                    "label": "t:sections.before-after-comparison.options.adapt_to_image"
                },
                {
                    "value": "16/9",
                    "label": "t:sections.before-after-comparison.options.wide_16_9"
                },
                {
                    "value": "4/3",
                    "label": "t:sections.before-after-comparison.options.landscape_4_3"
                },
                {
                    "value": "1/1",
                    "label": "t:sections.before-after-comparison.options.square_1_1"
                }
            ],
            "default": "16/9"
        },
        {
            "type": "image_picker",
            "id": "before_img",
            "label": "t:sections.before-after-comparison.settings.before_image"
        },
        {
            "type": "image_picker",
            "id": "after_img",
            "label": "t:sections.before-after-comparison.settings.after_image"
        },
        {
            "type": "text",
            "id": "before_label",
            "label": "t:sections.before-after-comparison.settings.before_label",
            "default": "BEFORE"
        },
        {
            "type": "text",
            "id": "after_label",
            "label": "t:sections.before-after-comparison.settings.after_label",
            "default": "AFTER"
        },
        {
            "type": "header",
            "content": "t:sections.before-after-comparison.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.before-after-comparison.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.before-after-comparison.settings.padding_bottom",
            "default": 32
        }
    ],
    "presets": [
        {
            "name": "t:sections.before-after-comparison.presets.before_after_comparison",
            "settings": {}
        }
    ]
}
{% endschema %}
