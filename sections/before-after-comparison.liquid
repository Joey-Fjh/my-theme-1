{%- liquid
    assign aspect_ratio = section.settings.image_ratio
    if aspect_ratio == 'auto'
        if section.settings.after_img != blank
            assign aspect_ratio = section.settings.after_img.aspect_ratio
        elsif section.settings.before_img != blank
            assign aspect_ratio = section.settings.before_img.aspect_ratio
        else
            assign aspect_ratio = '16/9'
        endif
    endif
-%}

<div
    data-section-id="{{ section.id }}"
    class="
        before-after-comparison-section full-width
        color-{{ section.settings.color_scheme }}
    "
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <div class="layout container-page">
        <div class="flex flex-col gap-6 text-center text-theme-text">
            <h3 class="opacity-80">
                {{ section.settings.sub_heading }}
            </h3>
            <h1 class="font-bold">
                {{ section.settings.heading }}
            </h1>
        </div>

        {% comment %} Mobile Layout (Stacked) {% endcomment %}
        <div class="mt-10 flex flex-col gap-6 pc:hidden">
            <div class="relative overflow-hidden rounded-lg">
                {%- render 'image',
                    image: section.settings.before_img,
                    alt: section.settings.before_img.alt,
                    width: section.settings.before_img.width,
                    aspect_ratio: aspect_ratio
                -%}
                <div class="absolute bottom-4 left-4 z-10 rounded border-2 border-theme-text px-3 py-2 body-sm tracking-wider text-theme-text backdrop-blur-sm">
                    {{ section.settings.before_label }}
                </div>
            </div>

            <div class="relative overflow-hidden rounded-lg">
                {%- render 'image',
                    image: section.settings.after_img,
                    alt: section.settings.after_img.alt,
                    width: section.settings.after_img.width,
                    aspect_ratio: aspect_ratio
                -%}
                <div class="absolute right-4 bottom-4 z-10 rounded border-2 border-theme-text px-3 py-2 body-sm tracking-wider text-theme-text backdrop-blur-sm">
                    {{ section.settings.after_label }}
                </div>
            </div>
        </div>

        {% comment %} Desktop Layout (Slider) {% endcomment %}
        <div
            class="mt-25 hidden pc:block"
            x-data="beforeAfterComparison()"
        >
            <div
                class="relative cursor-ew-resize overflow-hidden rounded-lg select-none"
                style="aspect-ratio: {{ aspect_ratio }};"
                x-ref="container"
                @mousedown="startDrag($event)"
                @touchstart.passive="startDrag($event)"
                @mousemove="onDrag($event)"
                @touchmove.passive="onDrag($event)"
                @mouseup="endDrag()"
                @touchend="endDrag()"
                @mouseleave="endDrag()"
                x-intersect:enter.once="animateToCenter()"
            >
                {% comment %} After Image (Background) {% endcomment %}
                <div class="absolute inset-0 h-full w-full">
                    {%- render 'image',
                        image: section.settings.after_img,
                        alt: section.settings.after_img.alt,
                        width: section.settings.after_img.width,
                        extra_attributes: 'draggable="false"'
                    -%}
                </div>

                {% comment %} Before Image (Clipped) {% endcomment %}
                <div
                    class="absolute inset-0 h-full w-full"
                    :style="`clip-path: inset(0 ${100 - position}% 0 0)`"
                >
                    {%- render 'image',
                        image: section.settings.before_img,
                        alt: section.settings.before_img.alt,
                        width: section.settings.before_img.width,
                        extra_attributes: 'draggable="false"'
                    -%}
                </div>

                {% comment %} Silder Line {% endcomment %}
                <div
                    class="absolute top-0 bottom-0 z-10 w-2 -translate-x-1/2 bg-theme-bg/90 transition-[left] duration-75 ease-out"
                    :class="{'transition-none' : isDragging }"
                    :style="`left: ${position}%`"
                >
                    {% comment %} Handle {% endcomment %}
                    <div
                        class="
                            absolute top-1/2 left-1/2 flex h-24 w-24 -translate-x-1/2 -translate-y-1/2 cursor-grab items-center justify-center gap-0 rounded-full bg-theme-bg shadow-surface
                            transition-transform duration-200 hover:scale-110 focus:ring-2 focus:ring-focus focus:outline-none active:cursor-grabbing
                        "
                        @mousedown.stop="startDrag($event)"
                        @touchstart.stop.passive="startDrag($event)"
                        aria-label="{{ 'accessibility.drag_to_compare' | t }}"
                    >
                        <svg
                            class="h-12 w-12 text-theme-text"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M15 18L9 12L15 6"/>
                        </svg>
                        <svg
                            class="-ml-2 h-12 w-12 text-theme-text"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M9 18L15 12L9 6"/>
                        </svg>
                    </div>
                </div>

                {% comment %} Before Label {% endcomment %}
                <div class="absolute bottom-10 left-10 z-10 rounded border-2 border-theme-text p-4 body-lg tracking-wider text-theme-text backdrop-blur-sm">
                    {{ section.settings.before_label }}
                </div>

                {% comment %} After Label {% endcomment %}
                <div class="absolute right-10 bottom-10 z-10 rounded border-2 border-theme-text p-4 body-lg tracking-wider text-theme-text backdrop-blur-sm">
                    {{ section.settings.after_label }}
                </div>
            </div>
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:sections.before-after-comparison.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": [
            "header",
            "footer"
        ]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.before-after-comparison.settings.color_scheme",
            "default": "color-scheme-1"
        },
        {
            "type": "inline_richtext",
            "id": "sub_heading",
            "label": "t:sections.before-after-comparison.settings.sub_heading",
            "default": "Lorem Ipsum"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "t:sections.before-after-comparison.settings.heading",
            "default": "Up To 50% Off Everything"
        },
        {
            "type": "select",
            "id": "image_ratio",
            "label": "t:sections.before-after-comparison.settings.image_ratio",
            "options": [
                {
                    "value": "auto",
                    "label": "t:sections.before-after-comparison.options.adapt_to_image"
                },
                {
                    "value": "16/9",
                    "label": "t:sections.before-after-comparison.options.wide_16_9"
                },
                {
                    "value": "4/3",
                    "label": "t:sections.before-after-comparison.options.landscape_4_3"
                },
                {
                    "value": "1/1",
                    "label": "t:sections.before-after-comparison.options.square_1_1"
                }
            ],
            "default": "16/9"
        },
        {
            "type": "image_picker",
            "id": "before_img",
            "label": "t:sections.before-after-comparison.settings.before_image"
        },
        {
            "type": "image_picker",
            "id": "after_img",
            "label": "t:sections.before-after-comparison.settings.after_image"
        },
        {
            "type": "text",
            "id": "before_label",
            "label": "t:sections.before-after-comparison.settings.before_label",
            "default": "BEFORE"
        },
        {
            "type": "text",
            "id": "after_label",
            "label": "t:sections.before-after-comparison.settings.after_label",
            "default": "AFTER"
        },
        {
            "type": "header",
            "content": "t:sections.before-after-comparison.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.before-after-comparison.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.before-after-comparison.settings.padding_bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "t:sections.before-after-comparison.presets.before_after_comparison",
            "settings": {}
        }
    ]
}
    {% endschema %}
