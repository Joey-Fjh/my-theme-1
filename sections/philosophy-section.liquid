                {
                    "type": "richtext",
                    "id": "text",
                    "label": "t:sections.philosophy-section.block_settings.description",
                    "default": "t:sections.philosophy-section.blocks_defaults.text"
                },
                {
                    "type": "header",
                    "content": "t:sections.philosophy-section.link"
