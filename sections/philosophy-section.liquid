<div
    data-section-id="{{ section.id }}"
    class="philosophy-section full-width color-{{ section.settings.color_scheme }} section-color-apply"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="philosophy-section"
    data-component-id="{{ section.id }}"
>
    <div class="layout container-page">
        {%- comment -%} Header {%- endcomment -%}
        <div class="mx-auto mb-12 text-center pc:mb-20">
            <h3
                data-gsap-item
                class="sub-heading"
            >
                {{ section.settings.subtitle }}
            </h3>
            <h1
                data-gsap-item
                class="mt-3"
            >
                {{ section.settings.heading }}
            </h1>
            <div
                data-gsap-item
                class="rte rte--compact mx-auto mt-4 max-w-prose"
            >
                {{ section.settings.description }}
            </div>
        </div>

        {%- comment -%} Cards / link blocks {%- endcomment -%}
        <div class="grid grid-cols-1 gap-6 pc:grid-cols-3 pc:gap-8">
            {%- for block in section.blocks -%}
                {%- case block.type -%}
                    {%- when 'card' -%}
                        <div
                            data-gsap-card
                            {{ block.shopify_attributes }}
                        >
                            {%- liquid
                                assign card_link = block.settings.link
                            -%}

                            {%- capture philosophy_card_media -%}
                                <div class="group aspect-4/3 overflow-hidden rounded-sm">
                                    {%- assign image_alt = block.settings.image.alt | default: block.settings.title | escape -%}
                                    {%-
                                        render 'image',
                                        wrapper: 'div',
                                        image: block.settings.image,
                                        alt: image_alt,
                                        width: block.settings.image.width,
                                        img_class: 'image_img transition-transform duration-300 ease-out will-change-transform pc:group-hover:scale-105'
                                    -%}
                                </div>
                            {%- endcapture -%}

                            {%- if card_link != blank -%}
                                {%- render 'link',
                                    href: card_link,
                                    variant: 'plain',
                                    class: 'block rounded-sm',
                                    content: philosophy_card_media,
                                    aria_label: block.settings.title
                                -%}
                            {%- else -%}
                                {{ philosophy_card_media }}
                            {%- endif -%}

                            <h3 class="mt-5">
                                {{ block.settings.title }}
                            </h3>

                            <div class="rte rte--compact mt-2">
                                {{ block.settings.text }}
                            </div>

                            {%- if card_link != blank and block.settings.link_text != blank -%}
                                <div class="mt-4">
                                    {%- capture card_cta_content -%}
                                        <span>{{ block.settings.link_text }}</span>
                                        {% render 'icons', icon: 'icon-arrow2', class: 'ml-3' %}
                                    {%- endcapture -%}

                                    {%- render 'link',
                                        href: card_link,
                                        content: card_cta_content,
                                        variant: 'underline'
                                    -%}
                                </div>
                            {%- endif -%}
                        </div>
                {%- endcase -%}
            {%- endfor -%}
        </div>
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components || typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined')
            return;

        gsap.registerPlugin(ScrollTrigger);

        Components.register(
            'philosophy-section',
            {
                init(el) {
                    const ctx = gsap.context(() => {
                        const items = el.querySelectorAll('[data-gsap-item]');
                        const cards = el.querySelectorAll('[data-gsap-card]');

                        if (!items.length) return;

                        gsap.set(items, { y: 30, opacity: 0 });
                        gsap.set(cards, { y: 40, opacity: 0 });

                        const tl = gsap.timeline({
                            defaults: { ease: 'power2.out' },
                            scrollTrigger: {
                                trigger: el,
                                start: 'top 80%',
                                once: true,
                            },
                        });

                        tl.to(items, {
                            y: 0,
                            opacity: 1,
                            duration: 0.8,
                            stagger: 0.2,
                        });

                        tl.to(
                            cards,
                            {
                                y: 0,
                                opacity: 1,
                                duration: 0.9,
                                stagger: 0.15,
                            },
                            '-=0.4',
                        );
                    }, el);

                    return { ctx };
                },

                destroy(el, state) {
                    if (state?.ctx) {
                        state.ctx.revert();
                    }
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{% schema %}
{
    "name": "t:sections.philosophy-section.name",
    "tag": "section",
    "class": "section",
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.philosophy-section.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "inline_richtext",
            "id": "subtitle",
            "default": "t:sections.philosophy-section.defaults.subtitle",
            "label": "t:sections.philosophy-section.settings.subtitle"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "default": "t:sections.philosophy-section.defaults.heading",
            "label": "t:sections.philosophy-section.settings.heading"
        },
        {
            "type": "richtext",
            "id": "description",
            "default": "t:sections.philosophy-section.defaults.description",
            "label": "t:sections.philosophy-section.settings.description"
        },
        {
            "type": "header",
            "content": "t:sections.philosophy-section.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.philosophy-section.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.philosophy-section.settings.padding_bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "card",
            "name": "t:sections.philosophy-section.blocks.philosophy_card",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:sections.philosophy-section.block_settings.image"
                },
                {
                    "type": "inline_richtext",
                    "id": "title",
                    "label": "t:sections.philosophy-section.block_settings.title"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "t:sections.philosophy-section.block_settings.description",
                    "default": "t:sections.philosophy-section.blocks_defaults.text"
                },
                {
                    "type": "header",
                    "content": "t:sections.philosophy-section.link"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "t:sections.philosophy-section.block_settings.link"
                },
                {
                    "type": "text",
                    "id": "link_text",
                    "label": "t:sections.philosophy-section.block_settings.link_label",
                    "default": "t:sections.philosophy-section.blocks_defaults.link_text",
                    "info": "t:sections.philosophy-section.block_info.shown_under_the_description_when_a_link_"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.philosophy-section.presets.philosophy_section",
            "blocks": [
                {
                    "type": "card"
                },
                {
                    "type": "card"
                },
                {
                    "type": "card"
                }
            ]
        }
    ]
}
{% endschema %}
