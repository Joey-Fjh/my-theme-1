                        {
                            "value": "heading-h3",
                            "label": "t:sections.slides-show.options.heading_h3"
                        },
                        {
                            "value": "heading-h4",
                            "label": "t:sections.slides-show.options.heading_h4"
                        },
                        {
                            "value": "heading-h5",
                            "label": "t:sections.slides-show.options.heading_h5"
                        },
                        {
                            "value": "heading-h6",
                            "label": "t:sections.slides-show.options.heading_h6"
                        }
                    ],
                    "default": "heading-h2"
                },
                {
                    "type": "inline_richtext",
                    "id": "title",
                    "label": "t:sections.philosophy-section.block_settings.title"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "t:sections.philosophy-section.block_settings.description",
                    "default": "t:sections.philosophy-section.blocks_defaults.text"
                },
                {
                    "type": "header",
                    "content": "t:sections.philosophy-section.link"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "t:sections.philosophy-section.block_settings.link"
                },
                {
                    "type": "text",
                    "id": "link_text",
                    "label": "t:sections.philosophy-section.block_settings.link_label",
                    "default": "t:sections.philosophy-section.blocks_defaults.link_text",
                    "info": "t:sections.philosophy-section.block_info.shown_under_the_description_when_a_link_"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.philosophy-section.presets.philosophy_section",
            "blocks": [
                {
                    "type": "card"
