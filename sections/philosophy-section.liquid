<div
    data-section-id="{{ section.id }}"
    class="philosophy-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="motionRevealSection()"
    data-motion-section
>
    {%- liquid
        assign philosophy_heading_class = section.settings.heading_size | default: 'heading-2xl'
        assign philosophy_subtitle_size = section.settings.subtitle_size | default: 'body-xl'
        assign philosophy_subtitle_class = 'typo-subtitle ' | append: philosophy_subtitle_size
    -%}
    <div class="layout container-page">
        {%- comment -%} Header {%- endcomment -%}
        <div class="mx-auto mb-12 text-center pc:mb-20" data-motion-sequence>
            <p
                data-motion-reveal="content"
                class="{{ philosophy_subtitle_class }}"
            >
                {{ section.settings.subtitle }}
            </p>
            <h1
                data-motion-reveal="content"
                class="{{ philosophy_heading_class }} mt-3"
            >
                {{ section.settings.heading }}
            </h1>
            <div
                data-motion-reveal="content"
                class="rte rte--compact mx-auto mt-4 max-w-prose"
            >
                {{ section.settings.description }}
            </div>
        </div>

        {%- comment -%} Cards / link blocks {%- endcomment -%}
        <div class="grid grid-cols-1 gap-6 pc:grid-cols-3 pc:gap-8" data-motion-cascade>
            {%- for block in section.blocks -%}
                {%- case block.type -%}
                    {%- when 'card' -%}
                        <div
                            data-motion-bound
                            {{ block.shopify_attributes }}
                        >
                            {%- liquid
                                assign card_link = block.settings.link
                                assign card_title_class = block.settings.title_size | default: 'heading-h2'
                                assign philosophy_placeholder_index = forloop.index0 | modulo: 2 | plus: 1
                                assign philosophy_placeholder_key = 'lifestyle-' | append: philosophy_placeholder_index
                            -%}

                            <div data-motion-reveal="content">
                                {%- capture philosophy_card_media -%}
                                    <div class="group aspect-4/3 overflow-hidden rounded-sm">
                                        {%- assign image_alt = block.settings.image.alt | default: block.settings.title | escape -%}
                                        {%- render 'image',
                                            wrapper: 'div',
                                            image: block.settings.image,
                                            placeholder_key: philosophy_placeholder_key,
                                            alt: image_alt,
                                            width: block.settings.image.width,
                                            motion_reveal: false
                                        -%}
                                    </div>
                                {%- endcapture -%}

                                {%- if card_link != blank -%}
                                    {%- render 'link',
                                        href: card_link,
                                        variant: 'plain',
                                        class: 'media-interaction block rounded-sm',
                                        content: philosophy_card_media,
                                        aria_label: block.settings.title
                                    -%}
                                {%- else -%}
                                    {{ philosophy_card_media }}
                                {%- endif -%}

                                <div data-motion-copy-bound>
                                    <div data-motion-copy>
                                        <h3 class="{{ card_title_class }} mt-5">
                                            {{ block.settings.title }}
                                        </h3>

                                        <div class="rte rte--compact mt-2">
                                            {{ block.settings.text }}
                                        </div>

                                        {%- if card_link != blank
                                            and block.settings.link_text != blank
                                        -%}
                                            <div class="mt-4">
                                                {%- capture card_cta_content -%}
                                                    <span>{{ block.settings.link_text }}</span>
                                                    {% render 'icons', icon: 'icon-arrow2', class: 'ms-3' %}
                                                {%- endcapture -%}

                                                {%- render 'link',
                                                    href: card_link,
                                                    content: card_cta_content,
                                                    variant: 'underline'
                                                -%}
                                            </div>
                                        {%- endif -%}
                                    </div>
                                </div>
                            </div>
                        </div>
                {%- endcase -%}
            {%- endfor -%}
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:sections.philosophy-section.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer", "custom.overlay"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.philosophy-section.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "inline_richtext",
            "id": "subtitle",
            "default": "t:sections.philosophy-section.defaults.subtitle",
            "label": "t:sections.philosophy-section.settings.subtitle"
        },
        {
            "type": "header",
            "content": "t:sections.scroll-categories.content.subtitle"
        },
        {
            "type": "select",
            "id": "subtitle_size",
            "label": "t:sections.scroll-categories.settings.subtitle_size",
            "options": [
                {
                    "value": "body-3xl",
                    "label": "t:sections.scroll-categories.options.body_3xl"
                },
                {
                    "value": "body-2xl",
                    "label": "t:sections.scroll-categories.options.body_2xl"
                },
                {
                    "value": "body-xl",
                    "label": "t:sections.scroll-categories.options.body_xl"
                },
                {
                    "value": "body-lg",
                    "label": "t:sections.scroll-categories.options.body_lg"
                },
                {
                    "value": "body-md",
                    "label": "t:sections.scroll-categories.options.body_md"
                },
                {
                    "value": "body-sm",
                    "label": "t:sections.scroll-categories.options.body_sm"
                },
                {
                    "value": "body-xs",
                    "label": "t:sections.scroll-categories.options.body_xs"
                }
            ],
            "default": "body-xl"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "default": "t:sections.philosophy-section.defaults.heading",
            "label": "t:sections.philosophy-section.settings.heading"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "heading-4xl",
                    "label": "t:sections.slides-show.options.heading_4xl"
                },
                {
                    "value": "heading-3xl",
                    "label": "t:sections.slides-show.options.heading_3xl"
                },
                {
                    "value": "heading-2xl",
                    "label": "t:sections.slides-show.options.heading_2xl"
                },
                {
                    "value": "heading-xl",
                    "label": "t:sections.slides-show.options.heading_xl"
                },
                {
                    "value": "heading-h1",
                    "label": "t:sections.slides-show.options.heading_h1"
                },
                {
                    "value": "heading-h2",
                    "label": "t:sections.slides-show.options.heading_h2"
                },
                {
                    "value": "heading-h3",
                    "label": "t:sections.slides-show.options.heading_h3"
                },
                {
                    "value": "heading-h4",
                    "label": "t:sections.slides-show.options.heading_h4"
                },
                {
                    "value": "heading-h5",
                    "label": "t:sections.slides-show.options.heading_h5"
                },
                {
                    "value": "heading-h6",
                    "label": "t:sections.slides-show.options.heading_h6"
                }
            ],
            "default": "heading-2xl"
        },
        {
            "type": "richtext",
            "id": "description",
            "default": "t:sections.philosophy-section.defaults.description",
            "label": "t:sections.philosophy-section.settings.description"
        },
        {
            "type": "header",
            "content": "t:sections.philosophy-section.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.philosophy-section.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.philosophy-section.settings.padding_bottom",
            "default": 32
        }
    ],
    "blocks": [
        {
            "type": "card",
            "name": "t:sections.philosophy-section.blocks.philosophy_card",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:sections.philosophy-section.block_settings.image"
                },
                {
                    "type": "header",
                    "content": "t:sections.blog-stories.content.card_title"
                },
                {
                    "type": "select",
                    "id": "title_size",
                    "label": "t:sections.slides-show.settings.heading_size",
                    "options": [
                        {
                            "value": "heading-h1",
                            "label": "t:sections.slides-show.options.heading_h1"
                        },
                        {
                            "value": "heading-h2",
