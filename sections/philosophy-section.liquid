{%- liquid
    assign philosophy_heading_class = section.settings.heading_size | default: 'title-2xl'
    assign philosophy_subtitle_size = section.settings.subtitle_size | default: 'copy-l'
-%}
{%- capture philosophy_header_copy -%}
    {% render 'text',
        tier: philosophy_subtitle_size,
        subtitle: true,
        align: 'center',
        content: section.settings.subtitle
    %}
    {% render 'heading',
        level: '1',
        tier: philosophy_heading_class,
        align: 'center',
        content: section.settings.heading
    %}
    {% render 'text',
        element: 'div',
        rte: true,
        align: 'center',
        measure: 'prose',
        class: 'mx-auto',
        content: section.settings.description
    %}
{%- endcapture -%}
{%- capture philosophy_children -%}
    <div class="flex flex-col gap-12 pc:gap-20">
        {%- comment -%} Header {%- endcomment -%}
        {% render 'content-group',
            align: 'center',
            gap: 'related',
            class: 'mx-auto',
            children: philosophy_header_copy
        %}

        {%- comment -%} Cards / link blocks {%- endcomment -%}
        <div class="grid grid-cols-1 gap-6 pc:grid-cols-3 pc:gap-8" data-motion-cascade>
        {%- for block in section.blocks -%}
            {%- case block.type -%}
                {%- when 'card' -%}
                    <div data-motion-bound {{ block.shopify_attributes }}>
                        {%- liquid
                            assign card_link = block.settings.link
                            assign card_title_class = block.settings.title_size | default: 'title-m'
                            assign philosophy_placeholder_index = forloop.index0 | modulo: 2 | plus: 1
                            assign philosophy_placeholder_key = 'lifestyle-' | append: philosophy_placeholder_index
                        -%}

                        <div class="flex flex-col gap-related">
                            {%- capture philosophy_card_media -%}
                                <div class="group aspect-4/3 overflow-hidden rounded-sm">
                                    {%- assign image_alt = block.settings.image.alt | default: block.settings.title | escape -%}
                                    {%- render 'image',
                                        wrapper: 'div',
                                        image: block.settings.image,
                                        placeholder_key: philosophy_placeholder_key,
                                        alt: image_alt,
                                        width: block.settings.image.width,
                                    -%}
                                </div>
                            {%- endcapture -%}

                            {%- if card_link != blank -%}
                                {%- render 'link',
                                    href: card_link,
                                    variant: 'plain',
                                    class: 'media-interaction block rounded-sm',
                                    content: philosophy_card_media,
                                    aria_label: block.settings.title
                                -%}
                            {%- else -%}
                                {{ philosophy_card_media }}
                            {%- endif -%}

                            <div>
                                {%- capture philosophy_card_copy -%}
                                    {% render 'heading',
                                        level: '3',
                                        tier: card_title_class,
                                        content: block.settings.title,
                                    %}

                                    {% render 'text',
                                        element: 'div',
                                        rte: true,
                                        content: block.settings.text,
                                    %}

                                    {%- if card_link != blank
                                        and block.settings.link_text != blank
                                    -%}
                                        {%- capture card_cta_content -%}
                                            <span>{{ block.settings.link_text }}</span>
                                            {% render 'icons', icon: 'icon-arrow2', class: 'ms-3' %}
                                        {%- endcapture -%}

                                        {%- render 'link',
                                            href: card_link,
                                            content: card_cta_content,
                                            variant: 'underline'
                                        -%}
                                    {%- endif -%}
                                {%- endcapture -%}
                                <div>
                                    {% render 'content-group',
                                        gap: 'related',
                                        children: philosophy_card_copy
                                    %}
                                </div>
                            </div>
                        </div>
                    </div>
            {%- endcase -%}
        {%- endfor -%}
        </div>
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: 'philosophy-section',
    motion: true,
    children: philosophy_children
%}

{% schema %}
