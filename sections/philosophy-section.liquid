<div
    data-section-id="{{ section.id }}"
    class="philosophy-section full-width"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="philosophy-section"
    data-component-id="{{ section.id }}"
>
    <div class="layout container-page text-[#263D29]">
        {%- comment -%} Header {%- endcomment -%}
        <div class="pc:mb-20 mx-auto mb-12 max-w-1/2 text-center">
            <h3
                data-gsap-item
                class="mb-4 opacity-80"
            >
                {{ section.settings.subtitle }}
            </h3>
            <hxl
                data-gsap-item
                class="leading-tight font-bold"
            >
                {{ section.settings.heading }}
            </hxl>
            <p
                data-gsap-item
                class="mt-4 leading-relaxed text-[#1B2608] opacity-80"
            >
                {{ section.settings.description }}
            </p>
        </div>

        {%- comment -%} Cards Grid {%- endcomment -%}
        <div class="pc:grid-cols-3 pc:gap-8 grid grid-cols-1 gap-6">
            {%- for block in section.blocks -%}
                <div
                    data-gsap-card
                    {{ block.shopify_attributes }}
                >
                    <div class="aspect-4/3 overflow-hidden rounded-sm">
                        {%-
                            render 'image',
                            image: block.settings.image,
                            alt: block.settings.image.alt | default: block.settings.title | escape,
                            width: block.settings.image.width
                        -%}
                    </div>

                    <h3 class="mt-5 leading-snug font-bold">
                        {{ block.settings.title }}
                    </h3>

                    <p class="mt-2 leading-relaxed opacity-80">
                        {{ block.settings.text }}
                    </p>
                </div>
            {%- endfor -%}
        </div>
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components || typeof gsap === 'undefined') return;

        Components.register(
            'philosophy-section',
            {
                init(el) {
                    const ctx = gsap.context(() => {
                        const items = el.querySelectorAll('[data-gsap-item]');
                        const cards = el.querySelectorAll('[data-gsap-card]');

                        if (!items.length) return;

                        gsap.set(items, { y: 30, opacity: 0 });
                        gsap.set(cards, { y: 40, opacity: 0 });

                        const tl = gsap.timeline({
                            defaults: { ease: 'power2.out' },
                            scrollTrigger: {
                                trigger: el,
                                start: 'top 80%',
                                once: true,
                            },
                        });

                        tl.to(items, {
                            y: 0,
                            opacity: 1,
                            duration: 0.8,
                            stagger: 0.2,
                        });

                        tl.to(
                            cards,
                            {
                                y: 0,
                                opacity: 1,
                                duration: 0.9,
                                stagger: 0.15,
                            },
                            '-=0.4',
                        );
                    }, el);

                    return { ctx };
                },

                destroy(el, state) {
                    if (state?.ctx) {
                        state.ctx.revert();
                    }
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{%- stylesheet -%}
{%- endstylesheet -%}

{% schema %}
{
    "name": "Philosophy Section",
    "tag": "section",
    "class": "section",
    "settings": [
        {
            "type": "text",
            "id": "subtitle",
            "default": "Our Philosophy",
            "label": "Subtitle"
        },
        {
            "type": "text",
            "id": "heading",
            "default": "Created with Intention",
            "label": "Heading"
        },
        {
            "type": "textarea",
            "id": "description",
            "default": "Our skincare is crafted with precision, integrity, and respect for the skin.",
            "label": "Description"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "card",
            "name": "Philosophy Card",
            "settings": [
                { "type": "image_picker", "id": "image", "label": "Image" },
                { "type": "text", "id": "title", "label": "Title" },
                { "type": "textarea", "id": "text", "label": "Description" }
            ]
        }
    ],
    "presets": [
        {
            "name": "Philosophy Section",
            "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }]
        }
    ]
}
{% endschema %}
