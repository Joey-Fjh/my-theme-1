                {
                    "value": "title-4xl",
                    "label": "t:settings.type_size.title_4xl"
                },
                {
                    "value": "title-3xl",
                    "label": "t:settings.type_size.title_3xl"
                },
                {
                    "value": "title-2xl",
                    "label": "t:settings.type_size.title_2xl"
                },
                {
                    "value": "title-xl",
                    "label": "t:settings.type_size.title_xl"
                },
                {
                    "value": "title-l",
                    "label": "t:settings.type_size.title_l"
                },
                {
                    "value": "title-m",
                    "label": "t:settings.type_size.title_m"
                },
                {
                    "value": "title-s",
                    "label": "t:settings.type_size.title_s"
                },
                {
                    "value": "title-xs",
                    "label": "t:settings.type_size.title_xs"
                }
            ],
            "default": "title-2xl"
        },
        {
            "type": "richtext",
            "id": "description",
            "default": "t:sections.philosophy-section.defaults.description",
            "label": "t:sections.philosophy-section.settings.description"
        },
        {
            "type": "header",
            "content": "t:sections.philosophy-section.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.philosophy-section.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
