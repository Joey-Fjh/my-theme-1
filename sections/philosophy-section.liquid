<div
    data-section-id="{{ section.id }}"
    class="philosophy-section full-width color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="philosophy-section"
    data-component-id="{{ section.id }}"
>
    <div class="layout container-page bg-theme-bg text-theme-text">
        {%- comment -%} Header {%- endcomment -%}
        <div class="mx-auto mb-12 text-center pc:mb-20">
            <p
                data-gsap-item
                class="body-sm text-theme-text/70"
            >
                {{ section.settings.subtitle }}
            </p>
            <h2
                data-gsap-item
                class="mt-3 h1 leading-tight font-bold text-theme-text"
            >
                {{ section.settings.heading }}
            </h2>
            <p
                data-gsap-item
                class="mx-auto mt-4 max-w-prose body-md leading-relaxed text-theme-text/80"
            >
                {{ section.settings.description }}
            </p>
        </div>

        {%- comment -%} Cards / link blocks {%- endcomment -%}
        <div class="grid grid-cols-1 gap-6 pc:grid-cols-3 pc:gap-8">
            {%- for block in section.blocks -%}
                {%- case block.type -%}
                    {%- when 'card' -%}
                        <div
                            data-gsap-card
                            {{ block.shopify_attributes }}
                        >
                            {%- liquid
                                assign card_link = block.settings.link
                            -%}

                            {%- capture philosophy_card_media -%}
                                <div class="group aspect-4/3 overflow-hidden rounded-sm">
                                    {%-
                                        render 'image',
                                        wrapper: 'div',
                                        image: block.settings.image,
                                        alt: block.settings.image.alt | default: block.settings.title | escape,
                                        width: block.settings.image.width,
                                        img_class: 'image_img transition-transform duration-300 ease-out will-change-transform pc:group-hover:scale-105'
                                    -%}
                                </div>
                            {%- endcapture -%}

                            {%- if card_link != blank -%}
                                {%- render 'link',
                                    href: card_link,
                                    variant: 'plain',
                                    class: 'block rounded-sm',
                                    content: philosophy_card_media,
                                    aria_label: block.settings.title,
                                    color: 'current'
                                -%}
                            {%- else -%}
                                {{ philosophy_card_media }}
                            {%- endif -%}

                            <h3 class="mt-5 h4 leading-snug font-bold text-theme-text">
                                {{ block.settings.title }}
                            </h3>

                            <p class="mt-2 body-sm leading-relaxed text-theme-text/80">
                                {{ block.settings.text }}
                            </p>

                            {%- if card_link != blank and block.settings.link_text != blank -%}
                                <div class="mt-4">
                                    {%- capture card_cta_content -%}
                                        <span class="body-sm">{{ block.settings.link_text }}</span>
                                        {% render 'icons', icon: 'icon-arrow2', size: 'lg', class: 'ml-3', color: 'current' %}
                                    {%- endcapture -%}
                                    {%- render 'link',
                                        href: card_link,
                                        content: card_cta_content,
                                        variant: 'underline',
                                        color: 'current'
                                    -%}
                                </div>
                            {%- endif -%}
                        </div>
                {%- endcase -%}
            {%- endfor -%}
        </div>
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components || typeof gsap === 'undefined') return;

        Components.register(
            'philosophy-section',
            {
                init(el) {
                    const ctx = gsap.context(() => {
                        const items = el.querySelectorAll('[data-gsap-item]');
                        const cards = el.querySelectorAll('[data-gsap-card]');

                        if (!items.length) return;

                        gsap.set(items, { y: 30, opacity: 0 });
                        gsap.set(cards, { y: 40, opacity: 0 });

                        const tl = gsap.timeline({
                            defaults: { ease: 'power2.out' },
                            scrollTrigger: {
                                trigger: el,
                                start: 'top 80%',
                                once: true,
                            },
                        });

                        tl.to(items, {
                            y: 0,
                            opacity: 1,
                            duration: 0.8,
                            stagger: 0.2,
                        });

                        tl.to(
                            cards,
                            {
                                y: 0,
                                opacity: 1,
                                duration: 0.9,
                                stagger: 0.15,
                            },
                            '-=0.4',
                        );
                    }, el);

                    return { ctx };
                },

                destroy(el, state) {
                    if (state?.ctx) {
                        state.ctx.revert();
                    }
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{%- stylesheet -%}
{%- endstylesheet -%}

{% schema %}
{
    "name": "Philosophy Section",
    "tag": "section",
    "class": "section",
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "scheme-1"
        },
        {
            "type": "text",
            "id": "subtitle",
            "default": "Our Philosophy",
            "label": "Subtitle"
        },
        {
            "type": "text",
            "id": "heading",
            "default": "Created with Intention",
            "label": "Heading"
        },
        {
            "type": "textarea",
            "id": "description",
            "default": "Our skincare is crafted with precision, integrity, and respect for the skin.",
            "label": "Description"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "card",
            "name": "Philosophy Card",
            "settings": [
                { "type": "image_picker", "id": "image", "label": "Image" },
                { "type": "text", "id": "title", "label": "Title" },
                { "type": "textarea", "id": "text", "label": "Description" },
                {
                    "type": "header",
                    "content": "Link"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Link"
                },
                {
                    "type": "text",
                    "id": "link_text",
                    "label": "Link label",
                    "default": "Learn more",
                    "info": "Shown under the description when a link is set. Leave blank to use the image link only."
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Philosophy Section",
            "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }]
        }
    ]
}
{% endschema %}
