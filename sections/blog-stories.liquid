<div
    data-section-id="{{ section.id }}"
    class="
        blog-stories-section full-width
        color-{{ section.settings.color_scheme }}
    "
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <div class="layout container-page">
        {% comment %} Header {% endcomment %}
        <div class="mb-12 flex flex-col justify-between gap-8 pc:flex-row pc:items-start">
            <h1 class="pc:w-1/2">
                {{ section.settings.heading }}
            </h1>
            <div class="flex items-start gap-4 pc:w-1/3">
                <div class="body-base opacity-80">
                    {{ section.settings.description }}
                </div>
                <span class="mt-2 h-3 w-3 shrink-0 rounded-full bg-current"></span>
            </div>
        </div>

        {% comment %} Article Grid {% endcomment %}
        <div class="grid gap-6 pc:grid-cols-3">
            {%- if section.settings.blog != blank -%}
                {%- for article in section.settings.blog.articles
                    limit: section.settings.articles_limit
                -%}
                    <article class="group">
                        <div class="relative mb-4 aspect-4/3 overflow-hidden">
                            {%- render 'image',
                                class: 'transition-transform duration-300 group-hover:scale-105',
                                image: article.image,
                                alt: article.title,
                                width: article.image.width
                            -%}
                        </div>

                        <h4 class="mb-3 opacity-80">
                            {{ article.tags | first }}
                        </h4>
                        <h3 class="mb-3">
                            {{ article.title }}
                        </h3>
                        {%- if article.url != blank -%}
                            {%- capture link_content -%}
                                <span class="body-base">{{ section.settings.link_text }}</span>
                                {% render 'icons', icon: 'icon-arrow2', size: 'lg', class: 'ml-3', color: 'current' %}
                            {%- endcapture -%}
                            {%- render 'link',
                                class: 'opacity-80 hover:opacity-100 transition-opacity',
                                href: article.url,
                                content: link_content,
                                variant: 'underline',
                                color: 'current'
                            -%}
                        {%- endif -%}
                    </article>
                {%- endfor -%}
            {%- else -%}
                {%- for block in section.blocks -%}
                    <article
                        class="group"
                        {{ block.shopify_attributes }}
                    >
                        <div class="relative mb-4 aspect-4/3 overflow-hidden">
                            {%- render 'image',
                                class: 'transition-transform duration-300 group-hover:scale-105',
                                image: block.settings.image,
                                alt: block.settings.image.alt,
                                width: block.settings.image.width
                            -%}
                        </div>

                        <h4 class="mb-3 opacity-80">
                            {{ block.settings.subtitle }}
                        </h4>
                        <h3 class="mb-3">
                            {{ block.settings.title }}
                        </h3>
                        {%- if block.settings.link != blank -%}
                            {%- capture link_content -%}
                                <span class="body-base">{{ block.settings.link_text }}</span>
                                {% render 'icons', icon: 'icon-arrow2', size: 'lg', class: 'ml-3', color: 'current' %}
                            {%- endcapture -%}
                            {%- render 'link',
                                class: 'opacity-80 hover:opacity-100 transition-opacity',
                                href: block.settings.link,
                                content: link_content,
                                variant: 'underline',
                                color: 'current'
                            -%}
                        {%- endif -%}
                    </article>
                {%- endfor -%}
            {%- endif -%}
        </div>
    </div>
</div>

{% schema %}
{
    "name": "Blog Stories",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color Scheme",
            "default": "color-scheme-1"
        },
        {
            "type": "blog",
            "id": "blog",
            "label": "Blog"
        },
        {
            "type": "range",
            "id": "articles_limit",
            "min": 1,
            "max": 12,
            "step": 1,
            "default": 3,
            "label": "Articles to show",
            "visible_if": "{{ section.settings.blog }}"
        },
        {
            "type": "text",
            "id": "link_text",
            "label": "Link text",
            "default": "Read More",
            "visible_if": "{{ section.settings.blog }}"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "Heading",
            "default": "Product stories, updates, and useful insights."
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description",
            "default": "<p>Personalized with AI insight. Personalized with AI insight. Personalized with AI insight.</p>"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "article",
            "name": "Article",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "inline_richtext",
                    "id": "subtitle",
                    "label": "Subtitle",
                    "default": "Lorem Ipsum"
                },
                {
                    "type": "inline_richtext",
                    "id": "title",
                    "label": "Title",
                    "default": "Lorem Ipsum"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Link"
                },
                {
                    "type": "text",
                    "id": "link_text",
                    "label": "Link Text",
                    "default": "Read More"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Blog Stories",
            "settings": {}
        }
    ]
}
{% endschema %}
