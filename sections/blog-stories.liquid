<div
    data-section-id="{{ section.id }}"
    class="blog-stories-section full-width 
        text-[#263D29]
    "
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <div class="layout container-page">
        {% comment %} Header {% endcomment %}
        <div class="mb-12 flex flex-col justify-between gap-8 pc:flex-row pc:items-start">
            <h1 class="leading-tight font-bold">
                {{ section.settings.heading }}
            </h1>
            <div class="flex items-start gap-4">
                <div class="leading-relaxed opacity-80">
                    {{ section.settings.description }}
                </div>
                <span class="mt-1 h-3 w-3 shrink-0 rounded-full bg-emerald-900"></span>
            </div>
        </div>

        {% comment %} Article Grid {% endcomment %}
        <div class="grid gap-6 pc:grid-cols-3">
            {%- for block in section.blocks -%}
                <article
                    class="group"
                    {{ block.shopify_attributes }}
                >
                    <div class="relative mb-4 aspect-4/3 overflow-hidden">
                        {%- render 'image', 
                            class: 'transition-transform duration-300 group-hover:scale-105'
                            image: block.settings.image,
                            alt: block.settings.image.alt,
                            width: block.settings.image.width
                        -%}
                    </div>

                    <h4 class="mb-3 opacity-80">
                        {{ block.settings.subtitle }}
                    </h4>
                    <h3 class="mb-3">
                        {{ block.settings.title }}
                    </h3>
                    {%- if block.settings.link != blank -%}
                        {%- capture link_content -%}
                            <span>{{ block.settings.link_text }}</span>
                            <span class="inline-block w-6 h-6 ml-3">
                                {{- 'icon-arrow2.svg' | inline_asset_content -}}
                            </span>
                        {%- endcapture -%}
                        {%- render 'link', class: 'opacity-80', href: block.settings.link, content: link_content, variant: "underline" -%}
                    {%- endif -%}
                </article>
            {%- endfor -%}
        </div>
    </div>
</div>

{% schema %}
  {
    "name": "Blog Stories",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header","footer"]
    },
    "settings": [
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "Heading",
            "default": "Product stories, updates, and useful insights."
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description",
            "default": "<p>Personalized with AI insight. Personalized with AI insight. Personalized with AI insight.</p>"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "article",
            "name": "Article",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "inline_richtext",
                    "id": "subtitle",
                    "label": "Subtitle",
                    "default": "Lorem Ipsum"
                },
                {
                    "type": "inline_richtext",
                    "id": "title",
                    "label": "Title",
                    "default": "Lorem Ipsum"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Link"
                },
                {
                    "type": "text",
                    "id": "link_text",
                    "label": "Link Text",
                    "default": "Read More"
                }
            ]
        }
    ],
    "presets": [
      {
        "name": "Blog Stories",
        "settings": {
        }
      }
    ]
  }
{% endschema %}