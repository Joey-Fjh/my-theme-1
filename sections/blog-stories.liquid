{%- liquid
    assign blog_stories_heading_class = section.settings.heading_size | default: 'heading-2xl'
    assign blog_stories_subtitle_size = section.settings.subtitle_size | default: 'body-lg'
    assign blog_stories_subtitle_class = 'typo-subtitle ' | append: blog_stories_subtitle_size
    assign blog_stories_card_title_class = 'heading-h2'
    assign blog_stories_card_subtitle_class = 'typo-subtitle body-lg'
-%}

<div
    data-section-id="{{ section.id }}"
    class="blog-stories-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="motionRevealSection()"
    data-motion-section
>
    <div class="layout container-page">
        {% comment %} Header {% endcomment %}
        <div
            class="mb-12 flex flex-col justify-between gap-8 pc:flex-row pc:items-start"
            data-motion-sequence
        >
            <h2
                class="pc:w-1/2 {{ blog_stories_heading_class }}"
                data-motion-reveal="content"
            >
                {{ section.settings.heading }}
            </h2>

            <div
                class="flex items-start gap-4 pc:w-1/3"
                data-motion-reveal="content"
            >
                <div class="rte rte--compact {{ blog_stories_subtitle_class }}">
                    {{ section.settings.description }}
                </div>
                <span class="mt-2 h-3 w-3 shrink-0 rounded-full bg-theme-text"></span>
            </div>
        </div>

        {% comment %} Article Grid {% endcomment %}
        <div class="grid gap-6 pc:grid-cols-3" data-motion-cascade>
            {%- if section.settings.blog != blank -%}
                {%- for article in section.settings.blog.articles
                    limit: section.settings.articles_limit
                -%}
                    <article
                        class="group"
                        data-motion-reveal="content"
                    >
                        <div class="relative mb-4 aspect-4/3 overflow-hidden">
                            {%- assign image_alt = article.title | escape -%}
                            {%- assign card_image_url = article.url -%}
                            {%- render 'image',
                                url: card_image_url,
                                wrapper_class: 'block h-full w-full',
                                image: article.image,
                                alt: image_alt,
                                width: article.image.width,
                                img_class: 'h-full w-full object-cover',
                                motion_reveal: false
                            -%}
                        </div>

                        <div data-motion-copy-bound>
                            <div data-motion-copy>
                                <p class="mb-3 {{ blog_stories_card_subtitle_class }}">
                                    {{ article.tags | first }}
                                </p>
                                <h3
                                    class="mb-3 line-clamp-1 min-w-0 {{ blog_stories_card_title_class }}"
                                    title="{{ article.title | escape }}"
                                >
                                    {{ article.title }}
                                </h3>

                                {%- if article.url != blank -%}
                                    {%- liquid
                                        assign link_label = section.settings.link_text | strip
                                        if link_label == blank
                                            assign link_label = 'sections.blog-stories.defaults.link_text' | t
                                        endif
                                        assign read_more_aria = 'accessibility.read_more_about' | t: title: article.title
                                    -%}

                                    {%- capture link_content -%}
                                        <span>{{ link_label }}</span>
                                        {% render 'icons', icon: 'icon-arrow2', class: 'ms-3' %}
                                    {%- endcapture -%}

                                    {%- render 'link',
                                        class: 'body-xl hover:opacity-100 transition-opacity',
                                        href: article.url,
                                        content: link_content,
                                        aria_label: read_more_aria,
                                        variant: 'underline'
                                    -%}
                                {%- endif -%}
                            </div>
                        </div>
                    </article>
                {%- endfor -%}
            {%- else -%}
                {%- for block in section.blocks -%}
                    {%- liquid
                        assign block_subtitle_size = block.settings.card_subtitle_size | default: 'body-lg'
                        assign block_subtitle_class = 'typo-subtitle ' | append: block_subtitle_size
                        assign block_title_class = block.settings.card_title_size | default: 'heading-h2'
                    -%}
                    <article
                        class="group"
                        data-motion-reveal="content"
                        {{ block.shopify_attributes }}
                    >
                        <div class="relative mb-4 aspect-4/3 overflow-hidden">
                            {%- assign image_alt = block.settings.image.alt
                                | default: block.settings.title
                                | escape
                            -%}
                            {%- assign card_image_url = block.settings.link -%}
                            {%- render 'image',
                                url: card_image_url,
                                wrapper_class: 'block h-full w-full',
                                image: block.settings.image,
                                alt: image_alt,
                                width: block.settings.image.width,
                                img_class: 'h-full w-full object-cover',
                                motion_reveal: false
                            -%}
                        </div>

                        <div data-motion-copy-bound>
                            <div data-motion-copy>
                                <p class="mb-3 {{ block_subtitle_class }}">
                                    {{ block.settings.subtitle }}
                                </p>

                                <h3
                                    class="mb-3 line-clamp-1 min-w-0 {{ block_title_class }}"
                                    title="{{ block.settings.title | strip_html | strip | escape }}"
                                >
                                    {{ block.settings.title }}
                                </h3>

                                {%- if block.settings.link != blank -%}
                                    {%- liquid
                                        assign link_label = block.settings.article_link_text | strip
                                        if link_label == blank
                                            assign link_label = 'sections.blog-stories.defaults.link_text' | t
                                        endif
                                        assign block_title_plain = block.settings.title | strip_html | strip
                                        if block_title_plain != blank
                                            assign read_more_aria = 'accessibility.read_more_about' | t: title: block_title_plain
                                        else
                                            assign read_more_aria = link_label
                                        endif
                                    -%}

                                    {%- capture link_content -%}
                                        <span>{{ link_label }}</span>
                                        {% render 'icons', icon: 'icon-arrow2', class: 'ms-3' %}
                                    {%- endcapture -%}

                                    {%- render 'link',
                                        class: 'body-xl hover:opacity-100 transition-opacity',
                                        href: block.settings.link,
                                        content: link_content,
                                        aria_label: read_more_aria,
                                        variant: 'underline'
                                    -%}
                                {%- endif -%}
                            </div>
                        </div>
                    </article>
                {%- endfor -%}
            {%- endif -%}
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:sections.blog-stories.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.blog-stories.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.font"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "heading-4xl",
                    "label": "t:sections.slides-show.options.heading_4xl"
                },
                {
                    "value": "heading-3xl",
                    "label": "t:sections.slides-show.options.heading_3xl"
                },
                {
                    "value": "heading-2xl",
                    "label": "t:sections.slides-show.options.heading_2xl"
                },
                {
                    "value": "heading-xl",
                    "label": "t:sections.slides-show.options.heading_xl"
                },
                {
                    "value": "heading-h1",
                    "label": "t:sections.slides-show.options.heading_h1"
                },
                {
                    "value": "heading-h2",
                    "label": "t:sections.slides-show.options.heading_h2"
                },
                {
                    "value": "heading-h3",
                    "label": "t:sections.slides-show.options.heading_h3"
                },
                {
                    "value": "heading-h4",
                    "label": "t:sections.slides-show.options.heading_h4"
                },
                {
                    "value": "heading-h5",
                    "label": "t:sections.slides-show.options.heading_h5"
                },
                {
                    "value": "heading-h6",
                    "label": "t:sections.slides-show.options.heading_h6"
                }
            ],
            "default": "heading-2xl"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "t:sections.blog-stories.settings.heading",
            "default": "t:sections.blog-stories.defaults.heading"
        },
        {
            "type": "header",
            "content": "t:sections.scroll-categories.content.subtitle"
        },
        {
            "type": "select",
            "id": "subtitle_size",
            "label": "t:sections.scroll-categories.settings.subtitle_size",
            "options": [
                {
                    "value": "body-3xl",
                    "label": "t:sections.scroll-categories.options.body_3xl"
                },
                {
                    "value": "body-2xl",
                    "label": "t:sections.scroll-categories.options.body_2xl"
                },
                {
                    "value": "body-xl",
                    "label": "t:sections.scroll-categories.options.body_xl"
                },
                {
                    "value": "body-lg",
                    "label": "t:sections.scroll-categories.options.body_lg"
                },
                {
                    "value": "body-md",
                    "label": "t:sections.scroll-categories.options.body_md"
                },
                {
                    "value": "body-sm",
                    "label": "t:sections.scroll-categories.options.body_sm"
                }
            ],
            "default": "body-lg"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "t:sections.blog-stories.settings.description",
            "default": "t:sections.blog-stories.defaults.description"
        },
        {
            "type": "blog",
            "id": "blog",
            "label": "t:sections.blog-stories.settings.blog"
        },
        {
            "type": "range",
            "id": "articles_limit",
            "min": 1,
            "max": 12,
            "step": 1,
            "default": 3,
            "label": "t:sections.blog-stories.settings.articles_to_show",
            "visible_if": "{{ section.settings.blog }}"
        },
        {
            "type": "text",
            "id": "link_text",
            "label": "t:sections.blog-stories.settings.link_text",
            "default": "t:sections.blog-stories.defaults.link_text",
            "visible_if": "{{ section.settings.blog }}"
        },
        {
            "type": "header",
            "content": "t:sections.blog-stories.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.blog-stories.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.blog-stories.settings.padding_bottom",
            "default": 32
        }
    ],
    "blocks": [
        {
            "type": "article",
            "name": "t:sections.blog-stories.blocks.article",
            "settings": [
                {
                    "type": "header",
                    "content": "t:sections.slides-show.content.font"
                },
                {
                    "type": "header",
                    "content": "t:sections.blog-stories.content.card_title"
                },
                {
                    "type": "select",
                    "id": "card_title_size",
                    "label": "t:sections.slides-show.settings.heading_size",
                    "options": [
                        {
                            "value": "heading-h1",
                            "label": "t:sections.slides-show.options.heading_h1"
                        },
                        {
                            "value": "heading-h2",
                            "label": "t:sections.slides-show.options.heading_h2"
                        },
                        {
                            "value": "heading-h3",
                            "label": "t:sections.slides-show.options.heading_h3"
                        },
                        {
                            "value": "heading-h4",
                            "label": "t:sections.slides-show.options.heading_h4"
                        },
                        {
                            "value": "heading-h5",
                            "label": "t:sections.slides-show.options.heading_h5"
                        },
                        {
                            "value": "heading-h6",
                            "label": "t:sections.slides-show.options.heading_h6"
                        }
                    ],
                    "default": "heading-h2"
                },
                {
                    "type": "header",
                    "content": "t:sections.blog-stories.content.card_subtitle"
                },
                {
                    "type": "select",
                    "id": "card_subtitle_size",
                    "label": "t:sections.scroll-categories.settings.subtitle_size",
                    "options": [
                        {
                            "value": "body-3xl",
                            "label": "t:sections.scroll-categories.options.body_3xl"
                        },
                        {
                            "value": "body-2xl",
                            "label": "t:sections.scroll-categories.options.body_2xl"
                        },
                        {
                            "value": "body-xl",
                            "label": "t:sections.scroll-categories.options.body_xl"
                        },
                        {
                            "value": "body-lg",
                            "label": "t:sections.scroll-categories.options.body_lg"
                        },
                        {
                            "value": "body-md",
                            "label": "t:sections.scroll-categories.options.body_md"
                        },
                        {
                            "value": "body-sm",
                            "label": "t:sections.scroll-categories.options.body_sm"
                        }
                    ],
                    "default": "body-lg"
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:sections.blog-stories.block_settings.image"
                },
                {
                    "type": "inline_richtext",
                    "id": "subtitle",
                    "label": "t:sections.blog-stories.block_settings.subtitle",
                    "default": "t:sections.blog-stories.blocks.defaults.subtitle"
                },
                {
                    "type": "inline_richtext",
                    "id": "title",
                    "label": "t:sections.blog-stories.block_settings.title",
                    "default": "t:sections.blog-stories.blocks.defaults.title"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "t:sections.blog-stories.block_settings.link"
                },
                {
                    "type": "text",
                    "id": "article_link_text",
                    "label": "t:sections.blog-stories.block_settings.link_text",
                    "default": "t:sections.blog-stories.blocks.defaults.link_text"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.blog-stories.presets.blog_stories",
            "settings": {}
        }
    ]
}
{% endschema %}
