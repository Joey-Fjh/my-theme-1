{%- assign popup_id = 'search-overlay-drawer' -%}

<div
    data-section-id="{{ section.id }}"
    class="search-overlay-section"
>
    {%- capture drawer_content -%}
        <div
            class="flex h-full flex-col"
            data-search-limit="{{ section.settings.search_result_limit | json }}"
            x-data="predictiveSearch()"
            data-predictive-search-enabled="{{ settings.predictive_search_enabled }}"
            data-search-url="{{ routes.search_url | escape }}"
            data-predictive-search-url="{{ routes.predictive_search_url | escape }}"
            data-toast-search-failed="{{ 'toast.search_failed' | t | escape }}"
            @keydown.escape.window="$store.dialog.close()"
        >
            <div class="p-6">
                <div class="mb-5 flex items-center justify-between gap-4">
                    <h1 id="dialog-title-{{ popup_id }}">{{ 'search.title' | t }}</h1>
                    
                    <button
                        type="button"
                        class="close-button"
                        @click="$store.dialog.close()"
                        aria-label="{{ 'accessibility.close_search_drawer' | t }}"
                    >
                        {% render 'icons', icon: 'icon-close' %}
                    </button>
                </div>

                <form @submit.prevent="performSearch()" role="search" class="w-full">
                    <div class="flex items-center gap-2 border-b border-theme-border pb-2">
                        {% render 'icons', icon: 'icon-search', class: 'shrink-0 opacity-80' %}
                        <input
                            id="SearchOverlayInput-{{ section.id }}"
                            type="search"
                            name="q"
                            class="w-full min-w-0 border-none bg-transparent focus-ring outline-none placeholder:text-theme-text/50"
                            autocomplete="off"
                            placeholder="{{ 'search.placeholder' | t }}"
                            x-model="query"
                            @input="onInput($event.target.value)"
                            @compositionend="onInput($event.target.value)"
                            @focus="openPanel()"
                            @keydown.enter.prevent="performSearch()"
                        >
                    </div>
                </form>

                <div x-show="isLoading" class="mt-4">
                    {% render 'loading', size: 'small' %}
                </div>

                <template x-if="!isLoading && suggestions.length">
                    <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-2">
                        <template x-for="item in suggestions" :key="item.text">
                            <li>
                                <button
                                    type="button"
                                    class="border-b border-theme-border-20 transition-colors hover:border-theme-border"
                                    @click="onSuggestionClick(item)"
                                    x-html="highlightSuggestion(item.text)"
                                ></button>
                            </li>
                        </template>
                    </ul>
                </template>
            </div>

            <div class="flex min-h-0 flex-1 flex-col px-5 py-4 pc:px-6">
                <div x-show="!isLoading && hasEmptyState && query" class="py-6 text-center">
                    <p>{{ 'search.no_results_for' | t }} "<span x-text="query"></span>"</p>
                </div>

                <div x-show="!isLoading && hasSearched && !hasEmptyState" class="flex min-h-0 flex-1 flex-col">
                    {% capture tab_header %}
                        <button
                            type="button"
                            role="tab"
                            id="search-tab-products-{{ section.id }}"
                            aria-controls="search-panel-products-{{ section.id }}"
                            x-data="{ index: null }"
                            x-init="index = registerTab($el)"
                            @click="setActive(index); activeTab = 'products'"
                            :aria-selected="isActive(index)"
                            class="search-overlay__tab"
                            :class="{ 'is-active': isActive(index) }"
                        >
                            {{ 'search.products' | t }}
                        </button>

                        <button
                            type="button"
                            role="tab"
                            id="search-tab-articles-{{ section.id }}"
                            aria-controls="search-panel-articles-{{ section.id }}"
                            x-data="{ index: null }"
                            x-init="index = registerTab($el)"
                            @click="setActive(index); activeTab = 'articles'"
                            :aria-selected="isActive(index)"
                            class="search-overlay__tab"
                            :class="{ 'is-active': isActive(index) }"
                        >
                            {{ 'search.articles' | t }}
                        </button>

                        <button
                            type="button"
                            role="tab"
                            id="search-tab-pages-{{ section.id }}"
                            aria-controls="search-panel-pages-{{ section.id }}"
                            x-data="{ index: null }"
                            x-init="index = registerTab($el)"
                            @click="setActive(index); activeTab = 'pages'"
                            :aria-selected="isActive(index)"
                            class="search-overlay__tab"
                            :class="{ 'is-active': isActive(index) }"
                        >
                            {{ 'search.pages' | t }}
                        </button>
                    {% endcapture %}

                    {% capture tab_content %}
                        <div
                            role="tabpanel"
                            id="search-panel-products-{{ section.id }}"
                            aria-labelledby="search-tab-products-{{ section.id }}"
                            x-data="{ index: null }"
                            x-init="index = registerPanel($el)"
                            x-show="activeTab === 'products'"
                            class="h-full overflow-y-auto pr-1"
                        >
                            <div class="grid grid-cols-2 gap-3">
                                <template x-for="product in products" :key="product.id">
                                    {%- render 'predictive-search-product-card' -%}
                                </template>
                            </div>
                            <p x-show="!products.length" class="py-4">{{ 'search.no_products' | t }}</p>
                        </div>

                        <div
                            role="tabpanel"
                            id="search-panel-articles-{{ section.id }}"
                            aria-labelledby="search-tab-articles-{{ section.id }}"
                            x-data="{ index: null }"
                            x-init="index = registerPanel($el)"
                            x-show="activeTab === 'articles'"
                            class="h-full overflow-y-auto pr-1"
                        >
                            <ul class="space-y-3">
                                <template x-for="article in articles" :key="article.id">
                                    <li class="border-b border-theme-border-20 pb-2">
                                        <a class="hover:underline" :href="article.url" x-text="article.title"></a>
                                    </li>
                                </template>
                            </ul>
                            <p x-show="!articles.length" class="py-4">{{ 'search.no_articles' | t }}</p>
                        </div>

                        <div
                            role="tabpanel"
                            id="search-panel-pages-{{ section.id }}"
                            aria-labelledby="search-tab-pages-{{ section.id }}"
                            x-data="{ index: null }"
                            x-init="index = registerPanel($el)"
                            x-show="activeTab === 'pages'"
                            class="h-full overflow-y-auto pr-1"
                        >
                            <ul class="space-y-3">
                                <template x-for="page in pages" :key="page.id">
                                    <li class="border-b border-theme-border-20 pb-2">
                                        <a class="hover:underline" :href="page.url" x-text="page.title"></a>
                                    </li>
                                </template>
                            </ul>
                            <p x-show="!pages.length" class="py-4">{{ 'search.no_pages' | t }}</p>
                        </div>
                    {% endcapture %}

                    {%- render 'tab-control',
                        type: 'underlined',
                        initialTabStrategy: 'first',
                        tab_header: tab_header,
                        tab_content: tab_content,
                        header_class: 'mb-4 gap-x-5 gap-y-2',
                        content_class: 'flex-1 min-h-0',
                        custom_class: 'flex-1 min-h-0 flex flex-col'
                    -%}
                </div>
            </div>
        </div>
    {%- endcapture -%}

    {%- render 'ui-dialog',
        id: popup_id,
        type: 'drawer',
        layer: 'drawer',
        position: section.settings.drawer_position,
        top_class: 'top-[var(--announcement-bar-height)] pc:top-0',
        color_scheme: section.settings.color_scheme,
        drawer_wrapper_class: '!max-w-none pc:!max-w-[33vw]',
        drawer_panel_class: 'overflow-hidden',
        content: drawer_content
    -%}
</div>

{% stylesheet %}
    .search-overlay__tab {
        border-bottom: 1px solid transparent;
        padding-bottom: 0.5rem;
        color: rgb(var(--color-foreground) / 0.5);
        letter-spacing: 0.16em;
        text-transform: uppercase;
        transition:
            color var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease),
            border-color var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease);
    }

    .search-overlay__tab:hover,
    .search-overlay__tab:focus-visible {
        color: rgb(var(--color-foreground));
    }

    .search-overlay__tab:focus-visible {
        outline: var(--focus-ring-width) solid
            rgba(var(--color-focus-ring), var(--focus-ring-opacity, 0.4));
        outline-offset: var(--focus-ring-offset);
    }

    .search-overlay__tab.is-active {
        border-color: rgb(var(--color-border));
        color: rgb(var(--color-foreground));
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.search-overlay.name",
    "tag": "section",
    "class": "section",
    "limit": 1,
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.search-overlay.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "select",
            "id": "drawer_position",
            "label": "t:sections.search-overlay.settings.drawer_position",
            "default": "right",
            "options": [
                {
                    "value": "left",
                    "label": "t:sections.search-overlay.options.left"
                },
                {
                    "value": "right",
                    "label": "t:sections.search-overlay.options.right"
                }
            ]
        },
        {
            "type": "range",
            "id": "search_result_limit",
            "min": 2,
            "max": 20,
            "step": 1,
            "default": 8,
            "label": "t:sections.search-overlay.settings.predictive_search_result_limit"
        }
    ],
    "presets": [
        {
            "name": "t:sections.search-overlay.presets.search_overlay"
        }
    ]
}
{% endschema %}
