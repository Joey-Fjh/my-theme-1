{%- assign popup_id = 'search-overlay-drawer' -%}

<div
  data-section-id="{{ section.id }}"
  class="search-overlay-section"
  data-component-kind="section"
  data-component-type="search-overlay"
  data-component-id="{{ section.id }}"
>
  {%- capture drawer_content -%}
    <div
      class="h-full bg-white text-[#263D29] flex flex-col"
      x-data="predictiveSearch({ limit: {{ section.settings.search_result_limit | json }} })"
      x-init='searchUrl = {{ routes.search_url | json }}'
      @keydown.escape.window="$store.dialog.close()"
    >
      <div class="px-5 pc:px-6 pt-5 pb-4 border-b border-[#D5D9D6]">
        <div class="flex items-center justify-between gap-4 mb-5">
          <h2 id="dialog-title-{{ popup_id }}" class="h3">Search</h2>
          <button
            type="button"
            class="inline-flex h-8 w-8 items-center justify-center text-[#263D29]/75 transition hover:text-[#263D29] cursor-pointer"
            @click="$store.dialog.close()"
            aria-label="Close search drawer"
          >
            <span class="w-4 h-4">{{ 'icon-trash.svg' | inline_asset_content }}</span>
          </button>
        </div>

        <form @submit.prevent="performSearch()" role="search" class="w-full">
          <div class="flex items-center gap-2 border-b border-[#263D29] pb-2">
            <span class="w-4 h-4 shrink-0 opacity-70">{{ 'icon-search.svg' | inline_asset_content }}</span>
            <input
              id="SearchOverlayInput-{{ section.id }}"
              type="search"
              name="q"
              class="w-full min-w-0 bg-transparent border-none outline-none text-base placeholder:text-[#A0A5A1]"
              autocomplete="off"
              placeholder="Search"
              x-model="query"
              @input="onInput($event.target.value)"
              @compositionend="onInput($event.target.value)"
              @focus="openPanel()"
              @keydown.enter.prevent="performSearch()"
            >
          </div>
        </form>

        <div x-show="isLoading" class="mt-4">
          {% render 'loading', size: 'small' %}
        </div>

        <template x-if="!isLoading && suggestions.length">
          <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-2">
            <template x-for="item in suggestions" :key="item.text">
              <li>
                <button
                  type="button"
                  class="text-sm border-b border-[#D5D9D6] hover:border-[#263D29] transition-colors"
                  @click="onSuggestionClick(item)"
                  x-html="highlightSuggestion(item.text)"
                ></button>
              </li>
            </template>
          </ul>
        </template>
      </div>

      <div class="flex-1 min-h-0 px-5 pc:px-6 py-4 flex flex-col">
        <div x-show="!isLoading && hasEmptyState && query" class="py-6 text-center">
          <p class="h5">No results found for "<span x-text="query"></span>"</p>
        </div>

        <div x-show="!isLoading && !hasEmptyState" class="flex-1 min-h-0 flex flex-col">
          {% capture tab_header %}
            <button
              type="button"
              role="tab"
              x-data="{ index: null }"
              x-init="index = registerTab($el)"
              @click="setActive(index); activeTab = 'products'"
              class="pb-2 border-b h6 uppercase tracking-[0.16em] transition-colors"
              :class="isActive(index) ? 'text-[#263D29] border-[#263D29]' : 'text-[#A0A5A1] border-transparent hover:text-[#263D29]'"
            >
              Products
            </button>

            <button
              type="button"
              role="tab"
              x-data="{ index: null }"
              x-init="index = registerTab($el)"
              @click="setActive(index); activeTab = 'articles'"
              class="pb-2 border-b h6 uppercase tracking-[0.16em] transition-colors"
              :class="isActive(index) ? 'text-[#263D29] border-[#263D29]' : 'text-[#A0A5A1] border-transparent hover:text-[#263D29]'"
            >
              Articles
            </button>

            <button
              type="button"
              role="tab"
              x-data="{ index: null }"
              x-init="index = registerTab($el)"
              @click="setActive(index); activeTab = 'pages'"
              class="pb-2 border-b h6 uppercase tracking-[0.16em] transition-colors"
              :class="isActive(index) ? 'text-[#263D29] border-[#263D29]' : 'text-[#A0A5A1] border-transparent hover:text-[#263D29]'"
            >
              Pages
            </button>
          {% endcapture %}

          {% capture tab_content %}
            <div
              role="tabpanel"
              x-data="{ index: null }"
              x-init="index = registerPanel($el)"
              x-show="activeTab === 'products'"
              class="h-full overflow-y-auto pr-1"
            >
              <div class="grid grid-cols-2 gap-3">
                <template x-for="product in products" :key="product.id">
                  <a
                    class="group block border border-[#E7EAE8] p-3 hover:shadow-sm transition-shadow"
                    :href="product.url"
                  >
                    <div class="aspect-square bg-[#F4F5F3] mb-3 overflow-hidden">
                      <img
                        class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
                        :src="product.image"
                        :alt="product.title"
                        width="120"
                        height="120"
                      >
                    </div>
                    <p class="text-sm line-clamp-2" x-text="product.title"></p>
                    <p class="text-sm mt-1 opacity-80" x-text="product.priceFormatted"></p>
                  </a>
                </template>
              </div>
              <p x-show="!products.length" class="text-sm text-[#A0A5A1] py-4">No products found.</p>
            </div>

            <div
              role="tabpanel"
              x-data="{ index: null }"
              x-init="index = registerPanel($el)"
              x-show="activeTab === 'articles'"
              class="h-full overflow-y-auto pr-1"
            >
              <ul class="space-y-3">
                <template x-for="article in articles" :key="article.id">
                  <li class="border-b border-[#E7EAE8] pb-2">
                    <a class="text-sm hover:underline" :href="article.url" x-text="article.title"></a>
                  </li>
                </template>
              </ul>
              <p x-show="!articles.length" class="text-sm text-[#A0A5A1] py-4">No articles found.</p>
            </div>

            <div
              role="tabpanel"
              x-data="{ index: null }"
              x-init="index = registerPanel($el)"
              x-show="activeTab === 'pages'"
              class="h-full overflow-y-auto pr-1"
            >
              <ul class="space-y-3">
                <template x-for="page in pages" :key="page.id">
                  <li class="border-b border-[#E7EAE8] pb-2">
                    <a class="text-sm hover:underline" :href="page.url" x-text="page.title"></a>
                  </li>
                </template>
              </ul>
              <p x-show="!pages.length" class="text-sm text-[#A0A5A1] py-4">No pages found.</p>
            </div>
          {% endcapture %}

          {%- render 'tab-control',
            initialTabStrategy: 'first',
            tab_header: tab_header,
            tab_content: tab_content,
            header_class: 'flex flex-wrap gap-x-5 gap-y-2 border-b border-[#D5D9D6] mb-4',
            content_class: 'flex-1 min-h-0',
            custom_class: 'flex-1 min-h-0 flex flex-col'
          -%}
        </div>
      </div>
    </div>
  {%- endcapture -%}

  {%- render 'ui-dialog',
    id: popup_id,
    type: 'drawer',
    position: 'right',
    overlay_class: 'bg-black/35',
    root_class: 'z-[10010]',
    drawer_wrapper_class: '!max-w-[40rem] fw:!max-w-[33vw]',
    drawer_panel_class: 'overflow-hidden',
    content: drawer_content
  -%}
</div>

{%- javascript -%}
  (function() {
    const Components = window.__Theme__?.Components;
    if (!Components) return;

    Components.register('search-overlay', {
      init() {
        return {};
      },
      destroy() {}
    }, { lazy: false });
  })();
{%- endjavascript -%}

{% schema %}
{
  "name": "Search Overlay",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "groups": ["custom.overlay"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "range",
      "id": "search_result_limit",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8,
      "label": "Predictive search result limit"
    }
  ],
  "presets": [
    {
      "name": "Search Overlay"
    }
  ]
}
{% endschema %}
