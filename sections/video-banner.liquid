{%- comment -%}
    Video banner section — Shopify-hosted video or YouTube/Vimeo embed.
    Consumes snippets/media-video.liquid for hosted video. Product media video
    remains handled by product-media snippets.
{%- endcomment -%}

{%- liquid
    assign hosted_video = section.settings.video
    assign hosted_video_mobile = section.settings.video_mobile
    assign external_video_url = section.settings.external_video_url
    assign poster_image = section.settings.poster

    assign has_hosted_video = false
    if hosted_video != blank
        assign has_hosted_video = true
    endif

    assign has_external_video = false
    if external_video_url != blank and external_video_url.id != blank
        assign external_video_type_check = external_video_url.type
        if external_video_type_check == 'youtube' or external_video_type_check == 'vimeo'
            assign has_external_video = true
        endif
    endif

    assign autoplay = section.settings.autoplay
    assign muted = section.settings.muted
    if autoplay
        assign muted = true
    endif

    assign aspect_ratio = section.settings.aspect_ratio | default: '16/9'
    assign container_width = section.settings.container_width | default: 'page'

    assign external_video_type = ''
    assign external_video_id = ''
    assign external_embed_src = ''
    assign external_autoplay_src = ''
    assign external_video_title_value = 'sections.video-banner.external_video_title' | t

    if has_external_video
        assign external_video_type = external_video_url.type
        assign external_video_id = external_video_url.id

        if external_video_type == 'youtube'
            assign external_embed_src = 'https://www.youtube.com/embed/' | append: external_video_id | append: '?playsinline=1&rel=0'
            assign external_autoplay_src = external_embed_src | append: '&autoplay=1'
        elsif external_video_type == 'vimeo'
            assign external_embed_src = 'https://player.vimeo.com/video/' | append: external_video_id
            assign external_autoplay_src = external_embed_src | append: '?autoplay=1'
        endif
    endif
-%}

<div
    data-section-id="{{ section.id }}"
    class="video-banner-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="motionRevealSection()"
    data-motion-section
>
    <div class="layout {% if container_width == 'page' %}container-page{% endif %}">
        <div class="video-banner__frame" style="aspect-ratio: {{ aspect_ratio }};">
            {%- if has_hosted_video -%}
                {%- render 'media-video',
                    video: hosted_video,
                    video_mobile: hosted_video_mobile,
                    poster: poster_image,
                    autoplay: autoplay,
                    loop: section.settings.loop,
                    muted: muted,
                    controls: section.settings.controls,
                    show_play_button: section.settings.show_play_button,
                    show_mute_button: section.settings.show_mute_button,
                    aspect_ratio: aspect_ratio,
                    class: 'h-full'
                -%}
            {%- elsif has_external_video -%}
                {%- comment -%} External video (YouTube/Vimeo) with click-to-play. {%- endcomment -%}
                <div
                    x-data="{ playing: false }"
                    class="video-banner__external relative h-full w-full bg-theme-bg/20"
                >
                    <div x-show="!playing" class="absolute inset-0 z-10">
                        {%- render 'image',
                            image: poster_image,
                            width: 1600,
                            aspect_ratio: aspect_ratio,
                            mode: 'frame',
                            fit: 'cover',
                            sizes: '100vw',
                            loading: 'lazy',
                            motion_reveal: false,
                            placeholder_key: 'image',
                            wrapper_class: 'h-full w-full',
                            alt: ''
                        -%}

                        <button
                            type="button"
                            class="video-banner__play-button"
                            @click="playing = true"
                            aria-label="{{ 'accessibility.play_video' | t }}"
                        >
                            <span class="video-banner__play-icon">
                                {%- render 'icons',
                                    icon: 'icon-play',
                                    class: 'ms-1.5 h-8 w-8 pc:h-10 pc:w-10'
                                -%}
                            </span>
                        </button>
                    </div>

                    <template x-if="playing">
                        <iframe
                            src="{{ external_autoplay_src | escape }}"
                            class="h-full w-full"
                            allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen
                            title="{{ external_video_title_value | escape }}"
                        ></iframe>
                    </template>
                </div>
            {%- else -%}
                {%- render 'image',
                    image: poster_image,
                    width: 1600,
                    aspect_ratio: aspect_ratio,
                    mode: 'frame',
                    fit: 'cover',
                    sizes: '100vw',
                    loading: 'lazy',
                    motion_reveal: false,
                    placeholder_key: 'image',
                    wrapper_class: 'h-full w-full',
                    alt: ''
                -%}
            {%- endif -%}
        </div>
    </div>
</div>

{% stylesheet %}
    .video-banner__frame {
        position: relative;
        width: 100%;
        overflow: hidden;
        border-radius: var(--container-radius, 0.75rem);
        background: rgb(var(--color-background) / 0.15);
    }

    .video-banner__play-button {
        position: absolute;
        inset: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        background: transparent;
        border: none;
        padding: 0;
    }

    .video-banner__play-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 5rem;
        height: 5rem;
        border-radius: 9999px;
        background: rgb(var(--color-background));
        color: rgb(var(--color-foreground));
        box-shadow: 0 4px 16px rgb(0 0 0 / 0.12);
        transition:
            transform var(--motion-duration-fast) var(--motion-ease-default),
            box-shadow var(--motion-duration-fast) var(--motion-ease-default);
    }

    @media (min-width: 48rem) {
        .video-banner__play-icon {
            width: 6rem;
            height: 6rem;
        }
    }

    .video-banner__play-button:hover .video-banner__play-icon {
        transform: scale(1.08);
        box-shadow: 0 6px 24px rgb(0 0 0 / 0.18);
    }

    .video-banner__play-button:focus-visible .video-banner__play-icon {
        outline: 2px solid rgb(var(--color-focus-ring));
        outline-offset: 3px;
    }

    .video-banner__external iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: none;
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.video-banner.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.video-banner.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.video-banner.content.video"
        },
        {
            "type": "video",
            "id": "video",
            "label": "t:sections.video-banner.settings.video"
        },
        {
            "type": "video",
            "id": "video_mobile",
            "label": "t:sections.video-banner.settings.video_mobile",
            "info": "t:sections.video-banner.info.video_mobile"
        },
        {
            "type": "video_url",
            "id": "external_video_url",
            "label": "t:sections.video-banner.settings.external_video_url",
            "accept": ["youtube", "vimeo"],
            "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
            "info": "t:sections.video-banner.info.external_video_url"
        },
        {
            "type": "image_picker",
            "id": "poster",
            "label": "t:sections.video-banner.settings.poster"
        },
        {
            "type": "select",
            "id": "aspect_ratio",
            "label": "t:sections.video-banner.settings.aspect_ratio",
            "options": [
                {
                    "value": "16/9",
                    "label": "16:9"
                },
                {
                    "value": "4/3",
                    "label": "4:3"
                },
                {
                    "value": "1/1",
                    "label": "1:1"
                }
            ],
            "default": "16/9"
        },
        {
            "type": "select",
            "id": "container_width",
            "label": "t:sections.video-banner.settings.container_width",
            "options": [
                {
                    "value": "page",
                    "label": "t:sections.video-banner.options.page_width"
                },
                {
                    "value": "full",
                    "label": "t:sections.video-banner.options.full_width"
                }
            ],
            "default": "page"
        },
        {
            "type": "header",
            "content": "t:sections.video-banner.content.playback"
        },
        {
            "type": "checkbox",
            "id": "autoplay",
            "label": "t:sections.video-banner.settings.autoplay",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "loop",
            "label": "t:sections.video-banner.settings.loop",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "muted",
            "label": "t:sections.video-banner.settings.muted",
            "default": true,
            "info": "t:sections.video-banner.info.muted"
        },
        {
            "type": "checkbox",
            "id": "controls",
            "label": "t:sections.video-banner.settings.controls",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "show_play_button",
            "label": "t:sections.video-banner.settings.show_play_button",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "show_mute_button",
            "label": "t:sections.video-banner.settings.show_mute_button",
            "default": false
        },
        {
            "type": "header",
            "content": "t:sections.video-banner.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.video-banner.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.video-banner.settings.padding_bottom",
            "default": 32
        }
    ],
    "presets": [
        {
            "name": "t:sections.video-banner.presets.video_banner"
        }
    ]
}
{% endschema %}
