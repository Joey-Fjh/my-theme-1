<div
    data-section-id="{{ section.id }}"
    class="main-page-contact-section full-width color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="main-page-contact"
    data-component-id="{{ section.id }}"
>
    <div class="layout container-page">
        {%- comment -%} Main Content: Image + Form {%- endcomment -%}
        <div class="relative z-1 mx-auto w-full max-w-full pc:max-w-5/6">
            <div class="grid grid-cols-1 gap-0 overflow-hidden pc:grid-cols-2">
                {%- comment -%} Left: Image {%- endcomment -%}
                <div
                    class="relative hidden aspect-528/582 -translate-x-7.5 overflow-hidden opacity-0 pc:block pc:aspect-auto"
                    data-gsap-image
                >
                    {% capture sizes %}
                        (max-width: 768px) 100vw, 50vw    
                    {% endcapture %}

                    {% capture widths %}
                        400,600,800
                    {% endcapture %}

                    {%- assign image_alt_fallback = 'sections.main-page-contact.defaults.image_alt'
                        | t
                    -%}
                    {%- assign image_alt = section.settings.image.image_alt
                        | default: image_alt_fallback
                        | escape
                    -%}
                    {% render 'image',
                        image: section.settings.image,
                        alt: image_alt,
                        width: section.settings.image.width,
                        sizes: sizes,
                        widths: widths,
                        loading: 'eager'
                    %}

                    {%- comment -%} hCaptcha Notice {%- endcomment -%}
                    <p class="absolute right-4 bottom-4 left-4">
                        {{ 'contact.hcaptcha_notice' | t -}}
                        <br>

                        {%- assign link_text = 'contact.privacy_policy' | t -%}
                        {% render 'link',
                            text: link_text,
                            href: 'https://www.hcaptcha.com/privacy',
                            class: 'underline',
                            target: '_blank',
                            attributes: 'rel="noopener"'
                        %}
                        {{ 'general.and' | t }}
                        {%- assign link_text = 'contact.terms_of_service' | t -%}
                        {% render 'link',
                            text: link_text,
                            href: 'https://www.hcaptcha.com/terms',
                            class: 'underline',
                            target: '_blank',
                            attributes: 'rel="noopener"'
                        %}
                        {{ 'contact.apply' | t }}
                    </p>
                </div>
                {%- comment -%} Right: Form {%- endcomment -%}
                <div
                    class="flex translate-x-7.5 flex-col justify-center px-6 py-8 opacity-0 pc:px-10 pc:py-10 fw:px-12"
                    style="background-color: {{ section.settings.form_background_color }};"
                    data-gsap-form
                >
                    {%- assign heading_fallback = 'sections.main-page-contact.defaults.heading'
                        | t
                    -%}
                    <h1 class="text-center text-primary">
                        {{ section.settings.heading | default: heading_fallback }}
                    </h1>
                    <div class="rte rte--compact mt-3 text-center text-primary/80">
                        {%- assign contact_description_fallback = 'contact.description_html' | t -%}
                        {{ section.settings.description | default: contact_description_fallback }}
                    </div>

                    {%- form 'contact', class: 'mt-6 flex flex-col gap-5 pc:mt-8 pc:gap-6' -%}
                        {%- assign success_message_fallback = 'sections.main-page-contact.defaults.success_message'
                            | t
                        -%}
                        {%- if form.posted_successfully? -%}
                            <div class="rounded p-4 text-center">
                                {{
                                    section.settings.success_message
                                    | default: success_message_fallback
                                }}
                            </div>
                        {%- endif -%}

                        {%- if form.errors -%}
                            <div class="rounded p-4">
                                {{ form.errors | default_errors }}
                            </div>
                        {%- endif -%}

                        {%- comment -%} First name & Last name {%- endcomment -%}
                        <div class="grid grid-cols-1 gap-4 pc:grid-cols-2 pc:gap-5">
                            <div class="flex flex-col gap-1.5">
                                <label
                                    for="ContactFirstName"
                                >
                                    {{- 'contact.first_name' | t -}}
                                </label>
                                <input
                                    type="text"
                                    id="ContactFirstName"
                                    name="contact[first_name]"
                                    placeholder="{{ 'contact.first_name_placeholder' | t }}"
                                    autocomplete="given-name"
                                    class="h-12 field border-theme-border-20 shadow-none placeholder:text-theme-text/50 pc:h-14"
                                >
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <label
                                    for="ContactLastName"
                                >
                                    {{- 'contact.last_name' | t -}}
                                </label>
                                <input
                                    type="text"
                                    id="ContactLastName"
                                    name="contact[last_name]"
                                    placeholder="{{ 'contact.last_name_placeholder' | t }}"
                                    autocomplete="family-name"
                                    class="h-12 field border-theme-border-20 shadow-none placeholder:text-theme-text/50 pc:h-14"
                                >
                            </div>
                        </div>

                        {%- comment -%} Email & Phone {%- endcomment -%}
                        <div class="grid grid-cols-1 gap-4 pc:grid-cols-2 pc:gap-5">
                            <div class="flex flex-col gap-1.5">
                                <label
                                    for="ContactEmail"
                                >
                                    {{- 'contact.email' | t -}}
                                </label>
                                <input
                                    type="email"
                                    id="ContactEmail"
                                    name="contact[email]"
                                    placeholder="{{ 'contact.email_placeholder' | t }}"
                                    autocomplete="email"
                                    required
                                    class="h-12 field border-theme-border-20 shadow-none placeholder:text-theme-text/50 pc:h-14"
                                >
                            </div>
                            <div class="hidden flex-col gap-1.5 pc:flex">
                                <label
                                    for="ContactPhone"
                                >
                                    {{- 'contact.phone' | t -}}
                                </label>
                                <input
                                    type="tel"
                                    id="ContactPhone"
                                    name="contact[phone]"
                                    placeholder="{{ 'contact.phone_placeholder' | t }}"
                                    autocomplete="tel"
                                    class="h-12 field border-theme-border-20 shadow-none placeholder:text-theme-text/50 pc:h-14"
                                >
                            </div>
                        </div>

                        {%- comment -%} Message {%- endcomment -%}
                        <div class="flex flex-col gap-1.5">
                            <label for="ContactMessage">
                                {{- 'contact.message' | t -}}
                            </label>
                            <textarea
                                id="ContactMessage"
                                name="contact[body]"
                                placeholder="{{ 'contact.message_placeholder' | t }}"
                                rows="4"
                                class="min-h-24 field w-full resize-none border-theme-border-20 py-3 shadow-none placeholder:text-theme-text/50 pc:min-h-28"
                            ></textarea>
                        </div>

                        {%- assign button_text_fallback = 'sections.main-page-contact.defaults.button_text'
                            | t
                        -%}
                        {%- comment -%} Submit {%- endcomment -%}
                        <button
                            type="submit"
                            class="btn-primary btn h-12 w-full border-primary-border shadow-none hover:brightness-110 pc:h-14"
                        >
                            {{ section.settings.button_text | default: button_text_fallback }}
                        </button>
                    {%- endform -%}
                </div>
            </div>
        </div>

        {%- comment -%} Brand Watermark {%- endcomment -%}
        {% render 'watermark',
            container_class: 'absolute left-0 bottom-0 right-0 z-0 overflow-hidden pointer-events-none select-none',
            text_class: 'tracking-wide font-bold text-theme-text opacity-20',
            html_attr: 'data-gsap-watermark',
            text: section.settings.watermark_text
        %}
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components || typeof gsap === 'undefined') return;

        Components.register(
            'main-page-contact',
            {
                init(el) {
                    const ctx = gsap.context(() => {
                        const tl = gsap.timeline({
                            defaults: { ease: 'power2.out' },
                        });

                        tl.to(el.querySelector('[data-gsap-image]'), {
                            opacity: 1,
                            x: 0,
                            duration: 0.7,
                        })
                            .to(
                                el.querySelector('[data-gsap-form]'),
                                {
                                    opacity: 1,
                                    x: 0,
                                    duration: 0.7,
                                },
                                '-=0.4',
                            )
                            .fromTo(
                                el.querySelector('[data-gsap-watermark]'),
                                {
                                    opacity: 0,
                                    x: 60,
                                },
                                {
                                    opacity: 1,
                                    x: 0,
                                    duration: 1,
                                    ease: 'power3.out',
                                },
                                '-=0.3',
                            );
                    }, el);

                    return { ctx };
                },

                destroy(el, state) {
                    if (state?.ctx) {
                        state.ctx.revert();
                    }
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{% schema %}
{
    "name": "t:sections.main-page-contact.name",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["page"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.main-page-contact.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "color",
            "id": "form_background_color",
            "label": "t:sections.main-page-contact.settings.form_background_color",
            "default": "#ffffff"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:sections.main-page-contact.settings.image"
        },
        {
            "type": "text",
            "id": "image_alt",
            "default": "t:sections.main-page-contact.defaults.image_alt",
            "label": "t:sections.main-page-contact.settings.image_alt_text"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "default": "t:sections.main-page-contact.defaults.heading",
            "label": "t:sections.main-page-contact.settings.heading"
        },
        {
            "type": "richtext",
            "id": "description",
            "default": "t:sections.main-page-contact.defaults.description",
            "label": "t:sections.main-page-contact.settings.description"
        },
        {
            "type": "text",
            "id": "button_text",
            "default": "t:sections.main-page-contact.defaults.button_text",
            "label": "t:sections.main-page-contact.settings.button_text"
        },
        {
            "type": "textarea",
            "id": "success_message",
            "default": "t:sections.main-page-contact.defaults.success_message",
            "label": "t:sections.main-page-contact.settings.success_message"
        },
        {
            "type": "text",
            "id": "watermark_text",
            "default": "t:sections.main-page-contact.defaults.watermark_text",
            "label": "t:sections.main-page-contact.settings.watermark_text"
        },
        {
            "type": "header",
            "content": "t:sections.main-page-contact.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.main-page-contact.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.main-page-contact.settings.padding_bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "t:sections.main-page-contact.presets.contact_us",
            "settings": {}
        }
    ]
}
{% endschema %}
