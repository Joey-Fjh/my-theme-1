<div
    data-section-id="{{ section.id }}"
    class="main-page-contact-section full-width"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="main-page-contact"
    data-component-id="{{ section.id }}"
>
    <div class="layout container-page bg-[#F3F3F3] text-[#263D29]">
        {%- comment -%} Main Content: Image + Form {%- endcomment -%}
        <div class="relative z-10 max-w-5xl mx-auto px-6 md:px-10">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0 bg-white rounded-lg overflow-hidden shadow-[0_4px_40px_rgba(0,0,0,0.06)]">
                {%- comment -%} Left: Image {%- endcomment -%}
                <div class="relative aspect-4/5 md:aspect-auto overflow-hidden opacity-0 -translate-x-7.5" data-gsap-image>
                    {% comment %} {%- if section.settings.image != blank -%}
                    <img
                        src="{{ section.settings.image | image_url: width: 800 }}"
                        srcset="
                        {{ section.settings.image | image_url: width: 400 }} 400w,
                        {{ section.settings.image | image_url: width: 600 }} 600w,
                        {{ section.settings.image | image_url: width: 800 }} 800w
                        "
                        sizes="(max-width: 768px) 100vw, 50vw"
                        alt="{{ section.settings.image_alt | default: 'Contact us' | escape }}"
                        loading="eager"
                        class="w-full h-full object-cover"
                    >
                    {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
                    {%- endif -%} {% endcomment %}

                    {%- comment -%} hCaptcha Notice {%- endcomment -%}
                    <p class="absolute bottom-4 left-4 right-4 text-[11px] leading-snug text-white/80">
                        This site is protected by hCaptcha and the hCaptcha<br>
                        <a href="https://www.hcaptcha.com/privacy" class="underline hover:text-white" target="_blank" rel="noopener">Privacy Policy</a>
                        and <a href="https://www.hcaptcha.com/terms" class="underline hover:text-white" target="_blank" rel="noopener">Terms of Service</a> apply.
                    </p>
                </div>
                {%- comment -%} Right: Form {%- endcomment -%}
                <div class="flex flex-col justify-center px-6 py-10 md:px-10 lg:px-12 opacity-0 translate-x-7.5" data-gsap-form>
                    <h1 class="text-[clamp(1.75rem,4vw,2.5rem)] font-bold italic text-[#2d3a2e] text-center leading-tight">
                        {{ section.settings.heading | default: 'Reach Us For Radiance' }}
                    </h1>
                    <p class="mt-3 text-sm text-[#5a5a5a] text-center leading-relaxed max-w-sm mx-auto">
                        {{ section.settings.description | default: 'Unlock personalized experiences with our AI technology. Get insights that evolve with your preferences.' }}
                    </p>

                    {%- form 'contact', class: 'mt-8 flex flex-col gap-5' -%}
                        {%- if form.posted_successfully? -%}
                            <div class="p-4 rounded bg-green-50 text-green-800 text-sm text-center">
                                {{ section.settings.success_message | default: 'Thank you for your message. We will get back to you soon.' }}
                            </div>
                        {%- endif -%}

                        {%- if form.errors -%}
                            <div class="p-4 rounded bg-red-50 text-red-700 text-sm">
                                {{ form.errors | default_errors }}
                            </div>
                        {%- endif -%}

                        {%- comment -%} First name & Last name {%- endcomment -%}
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div class="flex flex-col gap-1.5">
                                <label for="ContactFirstName" class="text-sm font-medium text-[#1a1a1a]">First name</label>
                                <input
                                    type="text"
                                    id="ContactFirstName"
                                    name="contact[first_name]"
                                    placeholder="Enter your first name"
                                    autocomplete="given-name"
                                    class="w-full h-11 px-4 text-sm text-[#1a1a1a] placeholder-[#9a9a9a] bg-[#f5f4f0] border border-[#e5e4e0] rounded outline-none transition-colors focus:border-[#2d3a2e] focus:ring-1 focus:ring-[#2d3a2e]"
                                >
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <label for="ContactLastName" class="text-sm font-medium text-[#1a1a1a]">Last name</label>
                                <input
                                    type="text"
                                    id="ContactLastName"
                                    name="contact[last_name]"
                                    placeholder="Enter your last name"
                                    autocomplete="family-name"
                                    class="w-full h-11 px-4 text-sm text-[#1a1a1a] placeholder-[#9a9a9a] bg-[#f5f4f0] border border-[#e5e4e0] rounded outline-none transition-colors focus:border-[#2d3a2e] focus:ring-1 focus:ring-[#2d3a2e]"
                                >
                            </div>
                        </div>

                        {%- comment -%} Email & Phone {%- endcomment -%}
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div class="flex flex-col gap-1.5">
                                <label for="ContactEmail" class="text-sm font-medium text-[#1a1a1a]">Email</label>
                                <input
                                    type="email"
                                    id="ContactEmail"
                                    name="contact[email]"
                                    placeholder="Enter your email address"
                                    autocomplete="email"
                                    required
                                    class="w-full h-11 px-4 text-sm text-[#1a1a1a] placeholder-[#9a9a9a] bg-[#f5f4f0] border border-[#e5e4e0] rounded outline-none transition-colors focus:border-[#2d3a2e] focus:ring-1 focus:ring-[#2d3a2e]"
                                >
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <label for="ContactPhone" class="text-sm font-medium text-[#1a1a1a]">Phone</label>
                                <input
                                    type="tel"
                                    id="ContactPhone"
                                    name="contact[phone]"
                                    placeholder="Enter your phone number"
                                    autocomplete="tel"
                                    class="w-full h-11 px-4 text-sm text-[#1a1a1a] placeholder-[#9a9a9a] bg-[#f5f4f0] border border-[#e5e4e0] rounded outline-none transition-colors focus:border-[#2d3a2e] focus:ring-1 focus:ring-[#2d3a2e]"
                                >
                            </div>
                        </div>

                        {%- comment -%} Message {%- endcomment -%}
                        <div class="flex flex-col gap-1.5">
                            <label for="ContactMessage" class="text-sm font-medium text-[#1a1a1a]">Message</label>
                            <textarea
                                id="ContactMessage"
                                name="contact[body]"
                                placeholder="Enter your message"
                                rows="4"
                                class="w-full px-4 py-3 text-sm text-[#1a1a1a] placeholder-[#9a9a9a] bg-[#f5f4f0] border border-[#e5e4e0] rounded outline-none resize-none transition-colors focus:border-[#2d3a2e] focus:ring-1 focus:ring-[#2d3a2e]"
                            ></textarea>
                        </div>

                        {%- comment -%} Submit {%- endcomment -%}
                        <button
                            type="submit"
                            class="w-full h-12 text-sm font-medium text-white bg-[#2d3a2e] rounded transition-colors hover:bg-[#3d4d3f] active:bg-[#222c23] cursor-pointer"
                        >
                            {{ section.settings.button_text | default: 'Send' }}
                        </button>
                    {%- endform -%}
                </div>
            </div>
        </div>

        {%- comment -%} Brand Watermark {%- endcomment -%}
        <div class="absolute bottom-0 right-0 z-0 overflow-hidden pointer-events-none select-none" aria-hidden="true">
            <span
                class="block text-[clamp(6rem,18vw,16rem)] font-bold leading-none text-[#e4e3df] translate-x-[5%] translate-y-[20%]"
                data-gsap-watermark
            >
                {{ section.settings.watermark_text | default: 'Eccenova®' }}
            </span>
        </div>
    </div>
</div>

{%- javascript -%}
  (function(){
    if (!window.$components || typeof gsap === 'undefined') return;

    $components.register(
        'main-page-contact',   
        {
            init(el){
                const ctx = gsap.context(() => {
                    const tl = gsap.timeline({
                        defaults: { ease: 'power2.out' }
                    });

                    tl.to(el.querySelector('[data-gsap-image]'), {
                        opacity: 1,
                        x: 0,
                        duration: 0.7
                    })
                    .to(el.querySelector('[data-gsap-form]'), {
                        opacity: 1,
                        x: 0,
                        duration: 0.7
                    }, '-=0.4')
                    .fromTo(el.querySelector('[data-gsap-watermark]'), {
                        opacity: 0,
                        x: 60
                    }, {
                        opacity: 1,
                        x: 0,
                        duration: 1,
                        ease: 'power3.out'
                    }, '-=0.3');
                }, el);

                return { ctx };
            },

            destroy(el, state){
                if (state?.ctx) {
                    state.ctx.revert();
                }
            }
        },{ lazy: true }
    );
  })();
{%- endjavascript -%}

{%- stylesheet -%}
{%- endstylesheet -%}

{% schema %}
  {
    "name": "Contact Us",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header","footer"]
    },
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "image_alt",
            "default": "Contact us",
            "label": "Image alt text"
        },
        {
            "type": "text",
            "id": "heading",
            "default": "Reach Us For Radiance",
            "label": "Heading"
        },
        {
            "type": "textarea",
            "id": "description",
            "default": "Unlock personalized experiences with our AI technology. Get insights that evolve with your preferences.",
            "label": "Description"
        },
        {
            "type": "text",
            "id": "button_text",
            "default": "Send",
            "label": "Button text"
        },
        {
            "type": "textarea",
            "id": "success_message",
            "default": "Thank you for your message. We will get back to you soon.",
            "label": "Success message"
        },
        {
            "type": "text",
            "id": "watermark_text",
            "default": "Eccenova®",
            "label": "Watermark text"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "presets": [
      {
        "name": "Contact Us",
        "settings": {
        }
      }
    ]
  }
{% endschema %}