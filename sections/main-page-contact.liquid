<div
    data-section-id="{{ section.id }}"
    class="main-page-contact-section full-width color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="main-page-contact"
    data-component-id="{{ section.id }}"
>
    <div class="layout container-page bg-theme-bg text-theme-text">
        {%- comment -%} Main Content: Image + Form {%- endcomment -%}
        <div class="relative z-1 mx-auto w-full max-w-full pc:max-w-5/6">
            <div class="grid grid-cols-1 gap-0 overflow-hidden bg-theme-bg shadow-surface pc:grid-cols-2">
                {%- comment -%} Left: Image {%- endcomment -%}
                <div
                    class="relative hidden aspect-528/582 -translate-x-7.5 overflow-hidden opacity-0 pc:block pc:aspect-auto"
                    data-gsap-image
                >
                    {% capture sizes %}
                        (max-width: 768px) 100vw, 50vw    
                    {% endcapture %}

                    {% capture widths %}
                        400,600,800
                    {% endcapture %}

                    {%
                        render 'image',
                        image: section.settings.image,
                        alt: section.settings.image.image_alt | default: 'Contact us' | escape,
                        width: section.settings.image.width,
                        sizes: sizes,
                        widths: widths,
                        loading: 'eager'
                    %}

                    {%- comment -%} hCaptcha Notice {%- endcomment -%}
                    <p class="absolute right-4 bottom-4 left-4 body-sm leading-snug text-white/80">
                        This site is protected by hCaptcha and the hCaptcha<br>
                        {% render 'link',
                            text: 'Privacy Policy',
                            href: 'https://www.hcaptcha.com/privacy',
                            class: 'underline',
                            target: '_blank',
                            attributes: 'rel="noopener"',
                            color: 'current'
                        %}
                        and
                        {% render 'link',
                            text: 'Terms of Service',
                            href: 'https://www.hcaptcha.com/terms',
                            class: 'underline',
                            target: '_blank',
                            attributes: 'rel="noopener"',
                            color: 'current'
                        %}
                        apply.
                    </p>
                </div>
                {%- comment -%} Right: Form {%- endcomment -%}
                <div
                    class="flex translate-x-7.5 flex-col justify-center px-6 py-8 opacity-0 pc:px-10 pc:py-10 fw:px-12"
                    style="background-color: {{ section.settings.form_background_color }};"
                    data-gsap-form
                >
                    <h1 class="text-center h2 text-primary">
                        {{ section.settings.heading | default: 'Reach Us For Radiance' }}
                    </h1>
                    <p class="mt-3 text-center body-md text-primary/70">
                        {{
                            section.settings.description
                            | default: 'Unlock personalized experiences with our AI technology. Get insights that evolve with your preferences.'
                        }}
                    </p>

                    {%- form 'contact', class: 'mt-6 flex flex-col gap-5 pc:mt-8 pc:gap-6' -%}
                        {%- if form.posted_successfully? -%}
                            <div class="rounded bg-green-50 p-4 text-center body-md text-green-800">
                                {{
                                    section.settings.success_message
                                    | default: 'Thank you for your message. We will get back to you soon.'
                                }}
                            </div>
                        {%- endif -%}

                        {%- if form.errors -%}
                            <div class="rounded bg-red-50 p-4 body-md text-red-700">
                                {{ form.errors | default_errors }}
                            </div>
                        {%- endif -%}

                        {%- comment -%} First name & Last name {%- endcomment -%}
                        <div class="grid grid-cols-1 gap-4 pc:grid-cols-2 pc:gap-5">
                            <div class="flex flex-col gap-1.5">
                                <label
                                    for="ContactFirstName"
                                    class="body-md font-medium text-primary/80"
                                    >First name</label
                                >
                                <input
                                    type="text"
                                    id="ContactFirstName"
                                    name="contact[first_name]"
                                    placeholder="Enter your first name"
                                    autocomplete="given-name"
                                    class="h-12 field border-theme-border-soft bg-theme-bg body-md text-theme-text shadow-none placeholder:text-theme-text/50 pc:h-14"
                                >
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <label
                                    for="ContactLastName"
                                    class="body-md font-medium text-primary/80"
                                    >Last name</label
                                >
                                <input
                                    type="text"
                                    id="ContactLastName"
                                    name="contact[last_name]"
                                    placeholder="Enter your last name"
                                    autocomplete="family-name"
                                    class="h-12 field border-theme-border-soft bg-theme-bg body-md text-theme-text shadow-none placeholder:text-theme-text/50 pc:h-14"
                                >
                            </div>
                        </div>

                        {%- comment -%} Email & Phone {%- endcomment -%}
                        <div class="grid grid-cols-1 gap-4 pc:grid-cols-2 pc:gap-5">
                            <div class="flex flex-col gap-1.5">
                                <label
                                    for="ContactEmail"
                                    class="body-md font-medium text-primary/80"
                                    >Email</label
                                >
                                <input
                                    type="email"
                                    id="ContactEmail"
                                    name="contact[email]"
                                    placeholder="Enter your email address"
                                    autocomplete="email"
                                    required
                                    class="h-12 field border-theme-border-soft bg-theme-bg body-md text-theme-text shadow-none placeholder:text-theme-text/50 pc:h-14"
                                >
                            </div>
                            <div class="hidden flex-col gap-1.5 pc:flex">
                                <label
                                    for="ContactPhone"
                                    class="body-md font-medium text-primary/80"
                                    >Phone</label
                                >
                                <input
                                    type="tel"
                                    id="ContactPhone"
                                    name="contact[phone]"
                                    placeholder="Enter your phone number"
                                    autocomplete="tel"
                                    class="h-12 field border-theme-border-soft bg-theme-bg body-md text-theme-text shadow-none placeholder:text-theme-text/50 pc:h-14"
                                >
                            </div>
                        </div>

                        {%- comment -%} Message {%- endcomment -%}
                        <div class="flex flex-col gap-1.5">
                            <label for="ContactMessage" class="body-md font-medium text-primary/80"
                                >Message</label
                            >
                            <textarea
                                id="ContactMessage"
                                name="contact[body]"
                                placeholder="Enter your message"
                                rows="4"
                                class="min-h-24 field w-full resize-none border-theme-border-soft bg-theme-bg py-3 body-md text-theme-text shadow-none placeholder:text-theme-text/50 pc:min-h-28"
                            ></textarea>
                        </div>

                        {%- comment -%} Submit {%- endcomment -%}
                        <button
                            type="submit"
                            class="btn h-12 w-full border-primary-border bg-primary body-md text-primary-text shadow-none hover:brightness-110 pc:h-14"
                        >
                            {{ section.settings.button_text | default: 'Send' }}
                        </button>
                    {%- endform -%}
                </div>
            </div>
        </div>

        {%- comment -%} Brand Watermark {%- endcomment -%}
        {% render 'watermark',
            container_class: 'absolute left-0 bottom-0 right-0 z-0 overflow-hidden pointer-events-none select-none',
            text_class: 'tracking-wide font-bold text-theme-text opacity-10',
            html_attr: 'data-gsap-watermark',
            text: section.settings.watermark_text
        %}
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components || typeof gsap === 'undefined') return;

        Components.register(
            'main-page-contact',
            {
                init(el) {
                    const ctx = gsap.context(() => {
                        const tl = gsap.timeline({
                            defaults: { ease: 'power2.out' },
                        });

                        tl.to(el.querySelector('[data-gsap-image]'), {
                            opacity: 1,
                            x: 0,
                            duration: 0.7,
                        })
                            .to(
                                el.querySelector('[data-gsap-form]'),
                                {
                                    opacity: 1,
                                    x: 0,
                                    duration: 0.7,
                                },
                                '-=0.4',
                            )
                            .fromTo(
                                el.querySelector('[data-gsap-watermark]'),
                                {
                                    opacity: 0,
                                    x: 60,
                                },
                                {
                                    opacity: 1,
                                    x: 0,
                                    duration: 1,
                                    ease: 'power3.out',
                                },
                                '-=0.3',
                            );
                    }, el);

                    return { ctx };
                },

                destroy(el, state) {
                    if (state?.ctx) {
                        state.ctx.revert();
                    }
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{%- stylesheet -%}
{%- endstylesheet -%}

{% schema %}
{
    "name": "Contact Us",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["page"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "scheme-1"
        },
        {
            "type": "color",
            "id": "form_background_color",
            "label": "Form background color",
            "default": "#ffffff"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "image_alt",
            "default": "Contact us",
            "label": "Image alt text"
        },
        {
            "type": "text",
            "id": "heading",
            "default": "Reach Us For Radiance",
            "label": "Heading"
        },
        {
            "type": "textarea",
            "id": "description",
            "default": "Unlock personalized experiences with our AI technology. Get insights that evolve with your preferences.",
            "label": "Description"
        },
        {
            "type": "text",
            "id": "button_text",
            "default": "Send",
            "label": "Button text"
        },
        {
            "type": "textarea",
            "id": "success_message",
            "default": "Thank you for your message. We will get back to you soon.",
            "label": "Success message"
        },
        {
            "type": "text",
            "id": "watermark_text",
            "default": "Eccenova®",
            "label": "Watermark text"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "Contact Us",
            "settings": {}
        }
    ]
}
{% endschema %}
