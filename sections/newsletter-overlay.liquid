{%- liquid
    assign popup_id = 'newsletter-overlay-' | append: section.id
    assign is_home_template = false
    if template.name == 'index'
        assign is_home_template = true
    endif

    assign is_visitor = true
    if customer
        assign is_visitor = false
    endif
-%}

<div
    data-section-id="{{ section.id }}"
    class="newsletter-overlay-section"
>
    {%- capture dialog_content -%}
    <div
      class="relative h-full"
      data-newsletter-dialog-id="{{ popup_id }}"
      data-newsletter-display-mode="{{ section.settings.display_mode }}"
      data-newsletter-show-in-home="{{ section.settings.show_in_home | json }}"
      data-newsletter-show-for-visitor="{{ section.settings.show_for_visitor | json }}"
      data-newsletter-is-home-template="{{ is_home_template | json }}"
      data-newsletter-is-visitor="{{ is_visitor | json }}"
      data-newsletter-delay="{{ section.settings.delay | json }}"
      data-newsletter-expired="{{ section.settings.expired | json }}"
      data-newsletter-success-message="{{ section.settings.success_message | escape }}"
      data-newsletter-error-message="{{ section.settings.error_message | escape }}"
      x-data="newsletterOverlay()"
      @keydown.escape.window="hide()"
    >
      <button
        type="button"
        class="close-button close-button-corner close-button-subtle"
        @click="hide()"
        aria-label="{{ 'accessibility.close_newsletter_popup' | t }}"
      >
        {% render 'icons', icon: 'icon-close' %}
      </button>

      <div class="grid h-full min-h-0 grid-cols-1 grid-rows-[minmax(0,3fr)_minmax(0,2fr)] pc:min-h-[320px] pc:grid-cols-[36%_minmax(0,1fr)] pc:grid-rows-1">
        <div class="min-h-0 overflow-hidden pc:h-full">
          {%- render 'image',
            class: 'w-full h-full',
            img_class: 'w-full h-full object-cover',
            image: section.settings.image,
            alt: section.settings.image.alt,
            width: section.settings.image.width
          -%}
        </div>

        <div class="flex min-h-0 w-full flex-col justify-between gap-3 overflow-y-auto px-6 pt-5 pb-5 pc:justify-around pc:gap-0 pc:px-6 pc:py-10 text-{{ section.settings.alignment }}">
        {%- for block in section.blocks -%}
            {%- case block.type -%}
                {%- when 'text' -%}
                    {%- liquid
                        assign overlay_text_class = block.settings.body_text_size | default: 'body-lg'
                    -%}
                    <div
                        class="rte rte--compact mb-0 pc:mb-2 {{ overlay_text_class }}"
                        {{ block.shopify_attributes }}
                    >
                        {{ block.settings.text }}
                    </div>

                {%- when 'heading' -%}
                    {%- liquid
                        assign overlay_heading_class = block.settings.heading_text_size | default: 'heading-h2'
                    -%}
                    <h2
                        id="dialog-title-{{ popup_id }}"
                        class="mb-0 pc:mb-3 {{ overlay_heading_class }}"
                        {{ block.shopify_attributes }}
                    >
                        {{ block.settings.heading }}
                    </h2>

                {%- when 'form' -%}
                    <form
                        class="newsletter-form"
                        action="{{ routes.root_url }}contact#newsletter_form_{{ section.id }}"
                        method="post"
                        accept-charset="UTF-8"
                        @submit.prevent="submit($event)"
                        {{ block.shopify_attributes }}
                    >
                        <input type="hidden" name="form_type" value="customer">
                        <input type="hidden" name="utf8" value="✓">
                        <input type="hidden" name="contact[tags]" value="newsletter">

                        <label for="newsletter-email-{{ section.id }}" class="sr-only">
                            {{ 'newsletter.email_address' | t }}
                        </label>

                        <div class="inline-submit-field">
                            <input
                                id="newsletter-email-{{ section.id }}"
                                type="email"
                                name="contact[email]"
                                class="inline-submit-field__input"
                                placeholder="{{ section.settings.placeholder }}"
                                required
                            >

                            <button
                                type="submit"
                                class="inline-submit-field__button inline-submit-field__button--icon"
                                :disabled="isLoading"
                                aria-label="{{ 'accessibility.submit_newsletter_form' | t }}"
                            >
                                <span x-show="!isLoading">
                                    {%- render 'icons', icon: 'icon-arrow2' -%}
                                </span>

                                {% render 'loading', size: 'small', spinner_color: 'border-current' %}
                            </button>
                        </div>
                    </form>
            {%- endcase -%}
        {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endcapture -%}

    {%- render 'ui-dialog',
        id: popup_id,
        type: 'modal',
        layer: 'modal',
        color_scheme: section.settings.color_scheme,
        modal_placement: section.settings.modal_placement,
        overlay_class: 'bg-black/60',
        mobile_layout: 'inset',
        modal_wrapper_class: 'pc:p-8 fw:p-10',
        modal_panel_class: 'h-full w-full max-w-full pc:h-auto pc:max-w-[600px] fw:max-w-[680px]',
        content: dialog_content
    -%}
</div>

{% schema %}
{
    "name": "t:sections.newsletter-overlay.name",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "groups": ["custom.overlay"]
    },
    "limit": 1,
    "settings": [
        {
            "type": "header",
            "content": "t:sections.newsletter-overlay.content.display_settings"
        },
        {
            "type": "select",
            "id": "display_mode",
            "label": "t:sections.newsletter-overlay.settings.display_mode",
            "options": [
                {
                    "value": "enable",
                    "label": "t:sections.newsletter-overlay.options.enable"
                },
                {
                    "value": "test",
                    "label": "t:sections.newsletter-overlay.options.test"
                }
            ],
            "default": "enable",
            "info": "t:sections.newsletter-overlay.info.test_mode_always_opens_the_popup"
        },
        {
            "type": "checkbox",
            "id": "show_in_home",
            "label": "t:sections.newsletter-overlay.settings.show_on_home_page",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "show_for_visitor",
            "label": "t:sections.newsletter-overlay.settings.show_for_visitors",
            "default": true
        },
        {
            "type": "range",
            "id": "delay",
            "label": "t:sections.newsletter-overlay.settings.delay",
            "unit": "s",
            "min": 0,
            "max": 60,
            "step": 1,
            "default": 3
        },
        {
            "type": "range",
            "id": "expired",
            "label": "t:sections.newsletter-overlay.settings.expire_after",
            "unit": "t:sections.newsletter-overlay.defaults.unit",
            "min": 1,
            "max": 30,
            "step": 1,
            "default": 7
        },
        {
            "type": "select",
            "id": "modal_placement",
            "label": "t:sections.newsletter-overlay.settings.popup_placement",
            "default": "bottom-right",
            "options": [
                {
                    "value": "bottom-left",
                    "label": "t:sections.newsletter-overlay.options.bottom_left"
                },
                {
                    "value": "bottom-right",
                    "label": "t:sections.newsletter-overlay.options.bottom_right"
                },
                {
                    "value": "center",
                    "label": "t:sections.newsletter-overlay.options.center"
                }
            ]
        },
        {
            "type": "header",
            "content": "t:sections.newsletter-overlay.content.text_style"
        },
        {
            "type": "text",
            "id": "alignment",
            "label": "t:sections.newsletter-overlay.settings.text_alignment",
            "default": "left"
        },
        {
            "type": "text",
            "id": "placeholder",
            "label": "t:sections.newsletter-overlay.settings.email_placeholder",
            "default": "t:sections.newsletter-overlay.defaults.email_placeholder"
        },
        {
            "type": "text",
            "id": "success_message",
            "label": "t:sections.newsletter-overlay.settings.success_toast",
            "default": "t:sections.newsletter-overlay.defaults.success_toast"
        },
        {
            "type": "text",
            "id": "error_message",
            "label": "t:sections.newsletter-overlay.settings.error_toast",
            "default": "t:sections.newsletter-overlay.defaults.error_toast"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:sections.newsletter-overlay.settings.left_image"
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.newsletter-overlay.settings.color_scheme",
            "default": "scheme-2"
        }
    ],
    "blocks": [
        {
            "type": "text",
            "name": "t:sections.newsletter-overlay.blocks.text",
            "settings": [
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "t:sections.newsletter-overlay.block_settings.text",
                    "default": "t:sections.newsletter-overlay.blocks.defaults.text"
                },
                {
                    "type": "select",
                    "id": "body_text_size",
                    "label": "t:sections.newsletter-overlay.block_settings.text_size",
                    "options": [
                        {
                            "value": "body-3xl",
                            "label": "t:sections.scroll-categories.options.body_3xl"
                        },
                        {
                            "value": "body-2xl",
                            "label": "t:sections.scroll-categories.options.body_2xl"
                        },
                        {
                            "value": "body-xl",
                            "label": "t:sections.scroll-categories.options.body_xl"
                        },
                        {
                            "value": "body-lg",
                            "label": "t:sections.scroll-categories.options.body_lg"
                        },
                        {
                            "value": "body-md",
                            "label": "t:sections.scroll-categories.options.body_md"
                        },
                        {
                            "value": "body-sm",
                            "label": "t:sections.scroll-categories.options.body_sm"
                        },
                        {
                            "value": "body-xs",
                            "label": "t:sections.scroll-categories.options.body_xs"
                        }
                    ],
                    "default": "body-lg"
                }
            ]
        },
        {
            "type": "heading",
            "name": "t:sections.newsletter-overlay.blocks.heading",
            "settings": [
                {
                    "type": "inline_richtext",
                    "id": "heading",
                    "label": "t:sections.newsletter-overlay.block_settings.heading",
                    "default": "t:sections.newsletter-overlay.blocks.defaults.heading"
                },
                {
                    "type": "select",
                    "id": "heading_text_size",
                    "label": "t:sections.slides-show.settings.heading_size",
                    "options": [
                        {
                            "value": "heading-4xl",
                            "label": "t:sections.slides-show.options.heading_4xl"
                        },
                        {
                            "value": "heading-3xl",
                            "label": "t:sections.slides-show.options.heading_3xl"
                        },
                        {
                            "value": "heading-2xl",
                            "label": "t:sections.slides-show.options.heading_2xl"
                        },
                        {
                            "value": "heading-xl",
                            "label": "t:sections.slides-show.options.heading_xl"
                        },
                        {
                            "value": "heading-h1",
                            "label": "t:sections.slides-show.options.heading_h1"
                        },
                        {
                            "value": "heading-h2",
                            "label": "t:sections.slides-show.options.heading_h2"
                        },
                        {
                            "value": "heading-h3",
                            "label": "t:sections.slides-show.options.heading_h3"
                        },
                        {
                            "value": "heading-h4",
                            "label": "t:sections.slides-show.options.heading_h4"
                        },
                        {
                            "value": "heading-h5",
                            "label": "t:sections.slides-show.options.heading_h5"
                        },
                        {
                            "value": "heading-h6",
                            "label": "t:sections.slides-show.options.heading_h6"
                        }
                    ],
                    "default": "heading-h2"
                }
            ]
        },
        {
            "type": "form",
            "name": "t:sections.newsletter-overlay.blocks.form",
            "limit": 1
        }
    ],
    "presets": [
        {
            "name": "t:sections.newsletter-overlay.presets.newsletter_overlay",
            "blocks": [
                {
                    "type": "text"
                },
                {
                    "type": "heading"
                },
                {
                    "type": "form"
                }
            ]
        }
    ]
}
{% endschema %}
