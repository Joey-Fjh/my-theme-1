{%- liquid
    assign popup_id = 'newsletter-overlay-' | append: section.id
    assign is_home_template = false
    if template.name == 'index'
        assign is_home_template = true
    endif

    assign is_visitor = true
    if customer
        assign is_visitor = false
    endif
-%}

<div
    data-section-id="{{ section.id }}"
    class="newsletter-overlay-section"
    data-component-kind="section"
    data-component-type="newsletter-overlay"
    data-component-id="{{ section.id }}"
>
    {%- capture dialog_content -%}
    <div
      class="relative overflow-hidden bg-(--newsletter-bg) text-(--newsletter-text)"
      style="
        --newsletter-bg: {{ section.settings.background_color }};
        --newsletter-text: {{ section.settings.foreground_color }};
        --newsletter-button-bg: {{ section.settings.button_background_color }};
        --newsletter-button-text: {{ section.settings.button_color }};
      "
      x-data='newsletterOverlay({
        dialogId: {{ popup_id | json }},
        displayMode: {{ section.settings.display_mode | json }},
        showInHome: {{ section.settings.show_in_home | json }},
        showForVisitor: {{ section.settings.show_for_visitor | json }},
        isHomeTemplate: {{ is_home_template | json }},
        isVisitor: {{ is_visitor | json }},
        delay: {{ section.settings.delay | json }},
        expired: {{ section.settings.expired | json }},
        successMessage: {{ section.settings.success_message | json }},
        errorMessage: {{ section.settings.error_message | json }}
      })'
      @keydown.escape.window="hide()"
    >
      <button
        type="button"
        class="absolute top-3 right-3 z-10 inline-flex h-8 w-8 cursor-pointer items-center justify-center text-(--newsletter-text)/75 transition hover:text-(--newsletter-text) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--newsletter-text)"
        @click="hide()"
        aria-label="Close newsletter popup"
      >
        {% render 'icons', icon: 'icon-trash', size: 'sm', color: 'current' %}
      </button>

      <div class="pc:grid-cols-[15rem_minmax(0,1fr)] grid grid-cols-1">  
        <div class="pc:h-full h-52">
          {%- render 'image',
            class: 'w-full h-full',
            img_class: 'w-full h-full object-cover',
            image: section.settings.image,
            alt: section.settings.image.alt,
            width: section.settings.image.width
          -%}
        </div>
        
        <div class="flex items-center">
          <div class="pc:px-6 pc:py-6 w-full px-5 py-6 text-{{ section.settings.alignment }}">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'text' -%}
                  <div
                    class="mb-2 opacity-75 {{ block.settings.text_size }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.text }}
                  </div>

                {%- when 'heading' -%}
                  <h2
                    id="dialog-title-{{ popup_id }}"
                    class="mb-3 {{ block.settings.text_size }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.heading }}
                  </h2>

                {%- when 'form' -%}
                  <form
                    class="newsletter-form"
                    action="{{ routes.root_url }}contact#newsletter_form_{{ section.id }}"
                    method="post"
                    accept-charset="UTF-8"
                    @submit.prevent="submit($event)"
                    {{ block.shopify_attributes }}
                  >
                    <input type="hidden" name="form_type" value="customer">
                    <input type="hidden" name="utf8" value="✓">
                    <input type="hidden" name="contact[tags]" value="newsletter">

                    <label for="newsletter-email-{{ section.id }}" class="sr-only">
                      Email address
                    </label>

                    <div class="flex items-center border border-current/25">
                      <input
                        id="newsletter-email-{{ section.id }}"
                        type="email"
                        name="contact[email]"
                        class="min-w-0 flex-1 bg-transparent px-4 py-3 text-sm outline-none placeholder:opacity-60"
                        placeholder="{{ section.settings.placeholder }}"
                        required
                      >

                      <button
                        type="submit"
                        class="inline-flex h-12 w-12 cursor-pointer items-center justify-center bg-(--newsletter-button-bg) text-(--newsletter-button-text) transition-opacity disabled:opacity-50"
                        :disabled="isLoading"
                        aria-label="Submit newsletter form"
                      >
                        <svg
                          x-show="!isLoading"
                          class="h-5 w-5"
                          viewBox="0 0 20 20"
                          fill="none"
                          aria-hidden="true"
                        >
                          <path
                            d="M4 10H16M16 10L11 5M16 10L11 15"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>

                        {% render 'loading', size: 'small', spinner_color: 'border-current' %}
                      </button>
                    </div>
                  </form>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  {%- endcapture -%}

    {%- render 'ui-dialog',
        id: popup_id,
        type: 'modal',
        modal_placement: section.settings.modal_placement,
        overlay_class: 'bg-black/60',
        modal_wrapper_class: 'p-4 pc:p-8 fw:p-10',
        modal_panel_class: 'w-full max-w-[24rem] pc:max-w-[36rem] fw:max-w-[42rem] overflow-hidden rounded-sm shadow-xl',
        content: dialog_content
    -%}
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components) return;

        Components.register(
            'newsletter-overlay',
            {
                init() {
                    return {};
                },
                destroy() {},
            },
            { lazy: false },
        );
    })();
{%- endjavascript -%}

{% schema %}
{
    "name": "Newsletter Overlay",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "groups": ["custom.overlay"]
    },
    "limit": 1,
    "settings": [
        {
            "type": "header",
            "content": "Display Settings"
        },
        {
            "type": "select",
            "id": "display_mode",
            "label": "Display mode",
            "options": [
                { "value": "enable", "label": "Enable" },
                { "value": "test", "label": "Test" }
            ],
            "default": "enable",
            "info": "Test mode always opens the popup."
        },
        {
            "type": "checkbox",
            "id": "show_in_home",
            "label": "Show on home page",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "show_for_visitor",
            "label": "Show for visitors",
            "default": true
        },
        {
            "type": "range",
            "id": "delay",
            "label": "Delay",
            "unit": "s",
            "min": 0,
            "max": 60,
            "step": 1,
            "default": 3
        },
        {
            "type": "range",
            "id": "expired",
            "label": "Expire after",
            "unit": "day",
            "min": 1,
            "max": 30,
            "step": 1,
            "default": 7
        },
        {
            "type": "select",
            "id": "modal_placement",
            "label": "Popup placement",
            "default": "bottom-right",
            "options": [
                { "value": "bottom-left", "label": "Bottom left" },
                { "value": "bottom-right", "label": "Bottom right" },
                { "value": "center", "label": "Center" }
            ]
        },
        {
            "type": "header",
            "content": "Text & Style"
        },
        {
            "type": "text_alignment",
            "id": "alignment",
            "label": "Text alignment",
            "default": "left"
        },
        {
            "type": "text",
            "id": "placeholder",
            "label": "Email placeholder",
            "default": "Enter your email address"
        },
        {
            "type": "text",
            "id": "success_message",
            "label": "Success toast",
            "default": "Thanks for subscribing."
        },
        {
            "type": "text",
            "id": "error_message",
            "label": "Error toast",
            "default": "Subscription failed. Please try again."
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Left image"
        },
        {
            "type": "color",
            "id": "background_color",
            "label": "Background color",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "foreground_color",
            "label": "Foreground color",
            "default": "#263D29"
        },
        {
            "type": "color",
            "id": "button_background_color",
            "label": "Button background",
            "default": "#263D29"
        },
        {
            "type": "color",
            "id": "button_color",
            "label": "Button text color",
            "default": "#ffffff"
        }
    ],
    "blocks": [
        {
            "type": "text",
            "name": "Text",
            "settings": [
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "Text",
                    "default": "<p>First timer?</p>"
                },
                {
                    "type": "select",
                    "id": "text_size",
                    "label": "Text size",
                    "options": [
                        { "value": "h5", "label": "Small" },
                        { "value": "h4", "label": "Medium" },
                        { "value": "h3", "label": "Large" }
                    ],
                    "default": "h5"
                }
            ]
        },
        {
            "type": "heading",
            "name": "Heading",
            "settings": [
                {
                    "type": "inline_richtext",
                    "id": "heading",
                    "label": "Heading",
                    "default": "Sign up and get 20% off your first order"
                },
                {
                    "type": "select",
                    "id": "text_size",
                    "label": "Text size",
                    "options": [
                        { "value": "h3", "label": "Small" },
                        { "value": "h2", "label": "Medium" },
                        { "value": "h1", "label": "Large" }
                    ],
                    "default": "h2"
                }
            ]
        },
        {
            "type": "form",
            "name": "Form",
            "limit": 1
        }
    ],
    "presets": [
        {
            "name": "Newsletter Overlay",
            "blocks": [{ "type": "text" }, { "type": "heading" }, { "type": "form" }]
        }
    ]
}
{% endschema %}
