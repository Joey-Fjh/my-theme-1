{%- liquid
    assign popup_id = 'newsletter-overlay-' | append: section.id
    assign is_home_template = false
    if template.name == 'index'
        assign is_home_template = true
    endif

    assign is_visitor = true
    if customer
        assign is_visitor = false
    endif
-%}

<div
    data-section-id="{{ section.id }}"
    class="newsletter-overlay-section"
    data-component-kind="section"
    data-component-type="newsletter-overlay"
    data-component-id="{{ section.id }}"
>
    {%- capture dialog_content -%}
    <div
      class="relative overflow-hidden bg-(--newsletter-bg) text-(--newsletter-text)"
      style="
        --newsletter-bg: {{ section.settings.background_color }};
        --newsletter-text: {{ section.settings.foreground_color }};
        --newsletter-button-bg: {{ section.settings.button_background_color }};
        --newsletter-button-text: {{ section.settings.button_color }};
      "
      data-newsletter-dialog-id="{{ popup_id | json }}"
      data-newsletter-display-mode="{{ section.settings.display_mode | json }}"
      data-newsletter-show-in-home="{{ section.settings.show_in_home | json }}"
      data-newsletter-show-for-visitor="{{ section.settings.show_for_visitor | json }}"
      data-newsletter-is-home-template="{{ is_home_template | json }}"
      data-newsletter-is-visitor="{{ is_visitor | json }}"
      data-newsletter-delay="{{ section.settings.delay | json }}"
      data-newsletter-expired="{{ section.settings.expired | json }}"
      data-newsletter-success-message="{{ section.settings.success_message | json }}"
      data-newsletter-error-message="{{ section.settings.error_message | json }}"
      x-data="newsletterOverlay()"
      @keydown.escape.window="hide()"
    >
      <button
        type="button"
        class="absolute top-3 right-3 z-10 inline-flex h-8 w-8 cursor-pointer items-center justify-center text-(--newsletter-text)/75 transition hover:text-(--newsletter-text) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--newsletter-text)"
        @click="hide()"
        aria-label="{{ 'accessibility.close_newsletter_popup' | t }}"
      >
        {% render 'icons', icon: 'icon-close', size: 'sm', color: 'current' %}
      </button>

      <div class="grid grid-cols-1 pc:grid-cols-[15rem_minmax(0,1fr)]">  
        <div class="h-52 pc:h-full">
          {%- render 'image',
            class: 'w-full h-full',
            img_class: 'w-full h-full object-cover',
            image: section.settings.image,
            alt: section.settings.image.alt,
            width: section.settings.image.width
          -%}
        </div>
        
        <div class="flex items-center">
          <div class="w-full px-5 py-6 pc:px-6 pc:py-6 text-{{ section.settings.alignment }}">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'text' -%}
                  <div
                    class="mb-2 opacity-75 {{ block.settings.body_text_size }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.text }}
                  </div>

                {%- when 'heading' -%}
                  <h2
                    id="dialog-title-{{ popup_id }}"
                    class="mb-3 {{ block.settings.heading_text_size }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.heading }}
                  </h2>

                {%- when 'form' -%}
                  <form
                    class="newsletter-form"
                    action="{{ routes.root_url }}contact#newsletter_form_{{ section.id }}"
                    method="post"
                    accept-charset="UTF-8"
                    @submit.prevent="submit($event)"
                    {{ block.shopify_attributes }}
                  >
                    <input type="hidden" name="form_type" value="customer">
                    <input type="hidden" name="utf8" value="✓">
                    <input type="hidden" name="contact[tags]" value="newsletter">

                    <label for="newsletter-email-{{ section.id }}" class="sr-only">
                      {{ 'newsletter.email_address' | t }}
                    </label>

                    <div class="flex items-center border border-current/25">
                      <input
                        id="newsletter-email-{{ section.id }}"
                        type="email"
                        name="contact[email]"
                        class="min-w-0 flex-1 bg-transparent px-4 py-3 text-sm outline-none placeholder:opacity-60"
                        placeholder="{{ section.settings.placeholder }}"
                        required
                      >

                      <button
                        type="submit"
                        class="inline-flex h-12 w-12 cursor-pointer items-center justify-center bg-(--newsletter-button-bg) text-(--newsletter-button-text) transition-opacity disabled:opacity-50"
                        :disabled="isLoading"
                        aria-label="{{ 'accessibility.submit_newsletter_form' | t }}"
                      >
                        <span x-show="!isLoading">
                          {%- render 'icons', icon: 'icon-arrow2', size: 'md', color: 'current' -%}
                        </span>

                        {% render 'loading', size: 'small', spinner_color: 'border-current' %}
                      </button>
                    </div>
                  </form>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  {%- endcapture -%}

    {%- render 'ui-dialog',
        id: popup_id,
        type: 'modal',
        modal_placement: section.settings.modal_placement,
        overlay_class: 'bg-black/60',
        modal_wrapper_class: 'p-4 pc:p-8 fw:p-10',
        modal_panel_class: 'w-full max-w-[24rem] pc:max-w-[36rem] fw:max-w-[42rem] overflow-hidden rounded-sm shadow-xl',
        content: dialog_content
    -%}
</div>

{% schema %}
{
    "name": "t:sections.newsletter-overlay.name",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "groups": ["custom.overlay"]
    },
    "limit": 1,
    "settings": [
        {
            "type": "header",
            "content": "t:sections.newsletter-overlay.content.display_settings"
        },
        {
            "type": "select",
            "id": "display_mode",
            "label": "t:sections.newsletter-overlay.settings.display_mode",
            "options": [
                {
                    "value": "enable",
                    "label": "t:sections.newsletter-overlay.options.enable"
                },
                {
                    "value": "test",
                    "label": "t:sections.newsletter-overlay.options.test"
                }
            ],
            "default": "enable",
            "info": "t:sections.newsletter-overlay.info.test_mode_always_opens_the_popup"
        },
        {
            "type": "checkbox",
            "id": "show_in_home",
            "label": "t:sections.newsletter-overlay.settings.show_on_home_page",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "show_for_visitor",
            "label": "t:sections.newsletter-overlay.settings.show_for_visitors",
            "default": true
        },
        {
            "type": "range",
            "id": "delay",
            "label": "t:sections.newsletter-overlay.settings.delay",
            "unit": "s",
            "min": 0,
            "max": 60,
            "step": 1,
            "default": 3
        },
        {
            "type": "range",
            "id": "expired",
            "label": "t:sections.newsletter-overlay.settings.expire_after",
            "unit": "t:sections.newsletter-overlay.defaults.unit",
            "min": 1,
            "max": 30,
            "step": 1,
            "default": 7
        },
        {
            "type": "select",
            "id": "modal_placement",
            "label": "t:sections.newsletter-overlay.settings.popup_placement",
            "default": "bottom-right",
            "options": [
                {
                    "value": "bottom-left",
                    "label": "t:sections.newsletter-overlay.options.bottom_left"
                },
                {
                    "value": "bottom-right",
                    "label": "t:sections.newsletter-overlay.options.bottom_right"
                },
                {
                    "value": "center",
                    "label": "t:sections.newsletter-overlay.options.center"
                }
            ]
        },
        {
            "type": "header",
            "content": "t:sections.newsletter-overlay.content.text_style"
        },
        {
            "type": "text_alignment",
            "id": "alignment",
            "label": "t:sections.newsletter-overlay.settings.text_alignment",
            "default": "left"
        },
        {
            "type": "text",
            "id": "placeholder",
            "label": "t:sections.newsletter-overlay.settings.email_placeholder",
            "default": "t:sections.newsletter-overlay.defaults.email_placeholder"
        },
        {
            "type": "text",
            "id": "success_message",
            "label": "t:sections.newsletter-overlay.settings.success_toast",
            "default": "t:sections.newsletter-overlay.defaults.success_toast"
        },
        {
            "type": "text",
            "id": "error_message",
            "label": "t:sections.newsletter-overlay.settings.error_toast",
            "default": "t:sections.newsletter-overlay.defaults.error_toast"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:sections.newsletter-overlay.settings.left_image"
        },
        {
            "type": "color",
            "id": "background_color",
            "label": "t:sections.newsletter-overlay.settings.background_color",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "foreground_color",
            "label": "t:sections.newsletter-overlay.settings.foreground_color",
            "default": "#263D29"
        },
        {
            "type": "color",
            "id": "button_background_color",
            "label": "t:sections.newsletter-overlay.settings.button_background",
            "default": "#263D29"
        },
        {
            "type": "color",
            "id": "button_color",
            "label": "t:sections.newsletter-overlay.settings.button_text_color",
            "default": "#ffffff"
        }
    ],
    "blocks": [
        {
            "type": "text",
            "name": "t:sections.newsletter-overlay.blocks.text",
            "settings": [
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "t:sections.newsletter-overlay.block_settings.text",
                    "default": "t:sections.newsletter-overlay.blocks.defaults.text"
                },
                {
                    "type": "select",
                    "id": "body_text_size",
                    "label": "t:sections.newsletter-overlay.block_settings.text_size",
                    "options": [
                        {
                            "value": "h5",
                            "label": "t:sections.newsletter-overlay.options.small"
                        },
                        {
                            "value": "h4",
                            "label": "t:sections.newsletter-overlay.options.medium"
                        },
                        {
                            "value": "h3",
                            "label": "t:sections.newsletter-overlay.options.large"
                        }
                    ],
                    "default": "h5"
                }
            ]
        },
        {
            "type": "heading",
            "name": "t:sections.newsletter-overlay.blocks.heading",
            "settings": [
                {
                    "type": "inline_richtext",
                    "id": "heading",
                    "label": "t:sections.newsletter-overlay.block_settings.heading",
                    "default": "t:sections.newsletter-overlay.blocks.defaults.heading"
                },
                {
                    "type": "select",
                    "id": "heading_text_size",
                    "label": "t:sections.newsletter-overlay.block_settings.text_size",
                    "options": [
                        {
                            "value": "h3",
                            "label": "t:sections.newsletter-overlay.options.small"
                        },
                        {
                            "value": "h2",
                            "label": "t:sections.newsletter-overlay.options.medium"
                        },
                        {
                            "value": "h1",
                            "label": "t:sections.newsletter-overlay.options.large"
                        }
                    ],
                    "default": "h2"
                }
            ]
        },
        {
            "type": "form",
            "name": "t:sections.newsletter-overlay.blocks.form",
            "limit": 1
        }
    ],
    "presets": [
        {
            "name": "t:sections.newsletter-overlay.presets.newsletter_overlay",
            "blocks": [
                {
                    "type": "text"
                },
                {
                    "type": "heading"
                },
                {
                    "type": "form"
                }
            ]
        }
    ]
}
{% endschema %}
