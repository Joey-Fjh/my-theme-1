<div
    data-component-kind="section"
    data-component-type="featured-products"
    data-component-id="{{ section.id }}"
    data-section-id="{{ section.id }}"
    class="featured-products-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="motionRevealSection()"
    data-motion-section
>
    <div class="layout container-page">
        {%- liquid
            assign featured_products_heading_class = section.settings.heading_size | default: 'heading-2xl'
            assign pc_tab_header_behavior = section.settings.pc_tab_header_behavior | default: 'wrap'
            assign tab_header_class = 'featured-products__tab-header pc:justify-center'
            assign tab_scroll_mode = 'mobile'
            if pc_tab_header_behavior != 'wrap'
                assign tab_header_class = 'featured-products__tab-header pc:flex-nowrap pc:justify-center pc:overflow-x-auto pc:whitespace-nowrap'
                assign tab_scroll_mode = 'always'
            endif
        -%}

        {%- capture tab_header -%}
            {%- for block in section.blocks -%}
                <button
                    type="button"
                    role="tab"
                    x-data="{ index: null }"
                    x-init="index = registerTab($el)"
                    :id="`featured-products-{{ section.id }}-tab-${index}`"
                    :aria-controls="`featured-products-{{ section.id }}-panel-${index}`"
                    @click="setActive(index)"
                    :tabindex="isFocusable(index) ? 0 : -1"
                    :aria-selected="isActive(index)"
                    :class="isActive(index) && 'is-active'"
                    class="featured-products__tab tab-nav-item tab-nav-item--opacity border-0 bg-transparent px-0 text-start text-theme-text"
                    {{ block.shopify_attributes }}
                >
                    <div>
                        {%- if block.settings.collection_heading != blank -%}
                            <span class="{{ featured_products_heading_class }}">
                                {{- block.settings.collection_heading -}}
                            </span>
                        {%- else -%}
                            <span class="{{ featured_products_heading_class }}">
                                {{- block.settings.collection.title -}}
                            </span>
                        {%- endif -%}
                        <sup class="sup-badge">
                            ({{ block.settings.collection.products_count | default: 0 }})
                        </sup>
                    </div>
                </button>
            {%- endfor -%}
        {%- endcapture -%}

        {%- capture tab_content -%}
            {%- for block in section.blocks -%}
                <div
                    role="tabpanel"
                    x-data="{ index: null }"
                    x-init="index = registerPanel($el)"
                    :id="`featured-products-{{ section.id }}-panel-${index}`"
                    :aria-labelledby="`featured-products-{{ section.id }}-tab-${index}`"
                    x-show="isActive(index)"
                    x-cloak
                    class="flex flex-col items-center gap-8"
                    {{ block.shopify_attributes }}
                >
                    {%- if block.settings.collection_content != blank -%}
                        <p data-motion-reveal="content">
                            {{ block.settings.collection_content }}
                        </p>
                    {%- endif -%}
                    
                    {%- liquid
                        assign products = block.settings.collection.products
                        assign max_items = section.settings.max_items
                        assign use_slider = false
                        if section.settings.show_navigation or section.settings.show_pagination or section.settings.show_all
                            assign use_slider = true
                        endif
                    -%}

                    <div
                        class="{% if use_slider %}w-full relative{% else %}product-grid{% endif %}"
                        data-motion-cascade
                        style="
                            --product-grid-columns: {{ section.settings.pc_items }};
                            --product-grid-columns-mobile: {{ section.settings.mobile_items }};
                        "
                    >
                        {% if use_slider %}
                            <div
                                class="swiper w-full"
                                data-mobile-items="{{ section.settings.mobile_items }}"
                                data-pc-items="{{ section.settings.pc_items }}"
                                role="region"
                                aria-label="{{ 'accessibility.featured_products_carousel' | t }}"
                                aria-roledescription="{{ 'accessibility.carousel' | t }}"
                            >
                                <div class="swiper-wrapper">
                        {% endif %}
                                    {%- comment -%}
                                      Scope each tab block separately so the same product in multiple
                                      tabs gets unique Quick View dialog/form ids (all panels stay mounted).
                                    {%- endcomment -%}
                                    {%- capture product_card_scope_id -%}
                                        {{- section.id -}}-{{- block.id -}}
                                    {%- endcapture -%}
                                    {%- for product in products limit: max_items -%}
                                        <div
                                            class="{% if use_slider %}swiper-slide h-auto{% else %}group{% endif %}"
                                            data-motion-bound
                                        >
                                            {%- render 'product-card',
                                                product: product,
                                                pc_items: section.settings.pc_items,
                                                mobile_items: section.settings.mobile_items,
                                                scope_id: product_card_scope_id,
                                                color_scheme: section.settings.color_scheme
                                            -%}
                                        </div>
                                    {%- else -%}
                                        {%- for placeholder_index in (1..max_items) -%}
                                            <div
                                                class="{% if use_slider %}swiper-slide h-auto{% else %}group{% endif %}"
                                                data-motion-bound
                                            >
                                                {%- render 'product-card',
                                                    product: blank,
                                                    placeholder_index: placeholder_index,
                                                    pc_items: section.settings.pc_items,
                                                    mobile_items: section.settings.mobile_items,
                                                    scope_id: product_card_scope_id,
                                                    color_scheme: section.settings.color_scheme
                                                -%}
                                            </div>
                                        {%- endfor -%}
                                    {%- endfor -%}
                        {% if use_slider %}
                                </div>
                            </div>
                        {% endif %}
                    </div>

                    {%- if use_slider -%}
                        <div class="mt-4 flex w-full items-center justify-between pc:mt-6">
                            <div class="flex items-center gap-4">
                                {%- if section.settings.show_navigation -%}
                                    <button
                                        type="button"
                                        class="swiper-button-prev featured-products__nav-button"
                                        aria-label="{{ 'accessibility.previous_slide' | t }}"
                                    >
                                        {%- render 'icons', icon: 'icon-arrow2', class: 'rotate-180' -%}
                                    </button>
                                {%- endif -%}

                                {%- if section.settings.show_pagination -%}
                                    <div class="swiper-pagination"></div>
                                {%- endif -%}

                                {%- if section.settings.show_navigation -%}
                                    <button
                                        type="button"
                                        class="swiper-button-next featured-products__nav-button"
                                        aria-label="{{ 'accessibility.next_slide' | t }}"
                                    >
                                        {%- render 'icons', icon: 'icon-arrow2' -%}
                                    </button>
                                {%- endif -%}
                            </div>

                            {%- if section.settings.show_all and block.settings.collection != blank -%}
                                <a href="{{ block.settings.collection.url }}" class="featured-products__view-all-link">
                                    {{ 'collections.view_all' | t }}
                                </a>
                            {%- endif -%}
                        </div>
                    {%- endif -%}
                </div>
            {% endfor %}
        {%- endcapture -%}

        {%- render 'tab-control',
            initialTabStrategy: 'middle',
            scroll_mode: tab_scroll_mode,
            tab_header: tab_header,
            header_class: tab_header_class,
            tab_content: tab_content
        %}

        {%- if section.settings.brand_name != blank -%}
            {% render 'watermark',
                variant: 'marquee',
                text: section.settings.brand_name,
                marquee_direction: section.settings.brand_marquee_direction,
                marquee_pause_on_hover: section.settings.brand_marquee_pause_on_hover,
                marquee_speed: section.settings.brand_marquee_speed,
                marquee_gap: section.settings.brand_marquee_gap,
                marquee_height: section.settings.brand_marquee_height,
                container_class: 'featured-products__brand-watermark'
            %}
        {%- endif -%}
    </div>
</div>

{% stylesheet %}
    .featured-products-section {
        .product-grid {
            width: 100%;
            display: grid;
            grid-template-columns: repeat(var(--product-grid-columns-mobile), minmax(0, 1fr));
            gap: 3px;

            @media (min-width: 768px) {
                grid-template-columns: repeat(var(--product-grid-columns), minmax(0, 1fr));
                gap: 8px;
            }
        }

        .swiper {
            width: 100%;
            overflow: hidden;
        }
        .swiper-wrapper {
            display: flex;
        }
        .swiper-slide {
            flex-shrink: 0;
            width: calc(
                (100% - (var(--product-grid-columns-mobile) - 1) * 3px) /
                    var(--product-grid-columns-mobile)
            );
            margin-right: 3px;
        }
        @media (min-width: 768px) {
            .swiper-slide {
                width: calc(
                    (100% - (var(--product-grid-columns) - 1) * 8px) / var(--product-grid-columns)
                );
                margin-right: 8px;
            }
        }

        .swiper-pagination-bullet {
            background-color: currentColor;
            opacity: 0.2;
        }
        .swiper-pagination-bullet-active {
            opacity: 1;
        }
        .swiper-button-disabled {
            opacity: 0.35;
            cursor: not-allowed;
        }

        .featured-products__nav-button {
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9999px;
            border: 1px solid;
            transition:
                opacity var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease),
                border-color var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease);
        }

        .featured-products__nav-button:focus-visible {
            outline: var(--focus-ring-width) solid
                rgba(var(--color-focus-ring), var(--focus-ring-opacity, 0.4));
            outline-offset: var(--focus-ring-offset);
        }

        .featured-products__view-all-link {
            text-decoration: underline;
            text-underline-offset: 4px;
            transition: opacity var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease);
        }

        .featured-products__view-all-link:hover {
            opacity: 1;
        }

        .featured-products__view-all-link:focus-visible {
            outline: var(--focus-ring-width) solid
                rgba(var(--color-focus-ring), var(--focus-ring-opacity, 0.4));
            outline-offset: var(--focus-ring-offset);
        }
    }
{% endstylesheet %}

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components) return;

        Components.register(
            'featured-products',
            {
                init(el) {
                    const swipers = [];
                    const swiperEls = el.querySelectorAll('.swiper');

                    if (swiperEls.length > 0 && typeof Swiper !== 'undefined') {
                        swiperEls.forEach((swiperEl) => {
                            const mobileItems =
                                parseInt(swiperEl.getAttribute('data-mobile-items')) || 2;
                            const pcItems = parseInt(swiperEl.getAttribute('data-pc-items')) || 4;

                            const options = {
                                slidesPerView: mobileItems,
                                spaceBetween: 3,
                                observer: true,
                                observeParents: true,
                                breakpoints: {
                                    768: {
                                        slidesPerView: pcItems,
                                        spaceBetween: 8,
                                    },
                                },
                            };

                            // Link navigation and pagination to the panel's DOM controls
                            const panel = swiperEl.closest('[role="tabpanel"]');
                            const nextEl = panel?.querySelector('.swiper-button-next');
                            const prevEl = panel?.querySelector('.swiper-button-prev');
                            const paginationEl = panel?.querySelector('.swiper-pagination');

                            if (nextEl && prevEl) {
                                options.navigation = { nextEl, prevEl };
                            }
                            if (paginationEl) {
                                options.pagination = { el: paginationEl, clickable: true };
                            }

                            swipers.push(new Swiper(swiperEl, options));
                        });
                    }

                    return { swipers };
                },
                destroy(el, state) {
                    if (state?.swipers) {
                        state.swipers.forEach((s) => s.destroy(true, true));
                    }
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{% schema %}
{
    "name": "t:sections.featured-products.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer", "custom.overlay"]
