{%- assign featured_products_root_attrs = 'data-component-kind="section" data-component-type="featured-products" data-component-id="'
    | append: section.id
    | append: '"'
-%}
{%- capture featured_products_children -%}
        {%- liquid
            assign featured_products_heading_class = section.settings.heading_size | default: 'title-2xl'
            assign pc_tab_header_behavior = section.settings.pc_tab_header_behavior | default: 'wrap'
            assign tab_header_class = 'featured-products__tab-header pc:justify-center'
            assign tab_scroll_mode = 'mobile'
            if pc_tab_header_behavior != 'wrap'
                assign tab_header_class = 'featured-products__tab-header pc:flex-nowrap pc:justify-center pc:overflow-x-auto pc:whitespace-nowrap'
                assign tab_scroll_mode = 'always'
            endif
        -%}

        {%- capture tab_header -%}
            {%- for block in section.blocks -%}
                <button
                    type="button"
                    role="tab"
                    id="featured-products-{{ section.id }}-tab-{{ forloop.index0 }}"
                    aria-controls="featured-products-{{ section.id }}-panel-{{ forloop.index0 }}"
                    x-init="registerTab($el)"
                    @click="setActive(tabIndexFor($el))"
                    :tabindex="isFocusable(tabIndexFor($el)) ? 0 : -1"
                    :aria-selected="isActive(tabIndexFor($el))"
                    :class="isActive(tabIndexFor($el)) && 'is-active'"
                    class="featured-products__tab tab-nav-item tab-nav-item--opacity border-0 bg-transparent px-0 text-start text-theme-text"
                    {{ block.shopify_attributes }}
                >
                    <div>
                        {%- if block.settings.collection_heading != blank -%}
                            <span class="{{ featured_products_heading_class }}">
                                {{- block.settings.collection_heading -}}
                            </span>
                        {%- else -%}
                            <span class="{{ featured_products_heading_class }}">
                                {{- block.settings.collection.title -}}
                            </span>
                        {%- endif -%}
                        <sup class="sup-badge">
                            ({{ block.settings.collection.products_count | default: 0 }})
                        </sup>
                    </div>
                </button>
            {%- endfor -%}
        {%- endcapture -%}

        {%- capture tab_content -%}
            {%- for block in section.blocks -%}
                <div
                    role="tabpanel"
                    id="featured-products-{{ section.id }}-panel-{{ forloop.index0 }}"
                    aria-labelledby="featured-products-{{ section.id }}-tab-{{ forloop.index0 }}"
                    x-init="registerPanel($el)"
                    x-show="isActive(panelIndexFor($el))"
                    x-cloak
                    class="flex flex-col items-center gap-8"
                    {{ block.shopify_attributes }}
                >
                    {%- if block.settings.collection_content != blank -%}
                        <p>
                            {{ block.settings.collection_content }}
                        </p>
                    {%- endif -%}
                    
                    {%- liquid
                        assign products = block.settings.collection.products
                        assign max_items = section.settings.max_items
                        assign use_slider = false
                        if section.settings.show_navigation or section.settings.show_pagination or section.settings.show_all
                            assign use_slider = true
                        endif
                    -%}

                    <div
                        class="{% if use_slider %}w-full relative{% else %}product-grid{% endif %}"
                        data-motion-cascade
                        style="
                            --product-grid-columns: {{ section.settings.pc_items }};
                            --product-grid-columns-mobile: {{ section.settings.mobile_items }};
                        "
                    >
                        {% if use_slider %}
                            <div
                                class="swiper w-full"
                                data-mobile-items="{{ section.settings.mobile_items }}"
                                data-pc-items="{{ section.settings.pc_items }}"
                                role="region"
                                aria-label="{{ 'accessibility.featured_products_carousel' | t }}"
                                aria-roledescription="{{ 'accessibility.carousel' | t }}"
                            >
                                <div class="swiper-wrapper">
                        {% endif %}
                                    {%- comment -%}
                                      Scope each tab block separately so the same product in multiple
                                      tabs gets unique Quick View dialog/form ids (all panels stay mounted).
                                    {%- endcomment -%}
                                    {%- capture product_card_scope_id -%}
                                        {{- section.id -}}-{{- block.id -}}
                                    {%- endcapture -%}
                                    {%- for product in products limit: max_items -%}
                                        <div
                                            class="{% if use_slider %}swiper-slide h-auto{% else %}group{% endif %}"
                                            data-motion-bound
                                        >
                                            {%- render 'product-card',
                                                product: product,
                                                pc_items: section.settings.pc_items,
                                                mobile_items: section.settings.mobile_items,
                                                scope_id: product_card_scope_id,
                                                color_scheme: section.settings.color_scheme
                                            -%}
                                        </div>
                                    {%- else -%}
                                        {%- for placeholder_index in (1..max_items) -%}
                                            <div
                                                class="{% if use_slider %}swiper-slide h-auto{% else %}group{% endif %}"
                                                data-motion-bound
                                            >
                                                {%- render 'product-card',
                                                    product: blank,
                                                    placeholder_index: placeholder_index,
                                                    pc_items: section.settings.pc_items,
                                                    mobile_items: section.settings.mobile_items,
                                                    scope_id: product_card_scope_id,
                                                    color_scheme: section.settings.color_scheme
                                                -%}
                                            </div>
                                        {%- endfor -%}
                                    {%- endfor -%}
                        {% if use_slider %}
                                </div>
                            </div>
                        {% endif %}
                    </div>

                    {%- liquid
                        assign featured_products_show_carousel_controls = false
                        if use_slider
                            if section.settings.show_navigation or section.settings.show_pagination
                                assign featured_products_show_carousel_controls = true
                            endif
                        endif
                    -%}
                    {%- if featured_products_show_carousel_controls -%}
                        <div class="mt-4 flex w-full items-center justify-center pc:mt-6">
                            <div class="flex items-center gap-4">
                                {%- if section.settings.show_navigation -%}
                                    <button
                                        type="button"
                                        class="swiper-button-prev featured-products__nav-button"
                                        aria-label="{{ 'accessibility.previous_slide' | t }}"
                                    >
                                        {%- render 'icons', icon: 'icon-arrow2', class: 'rotate-180' -%}
                                    </button>
                                {%- endif -%}

                                {%- if section.settings.show_pagination -%}
                                    <div class="swiper-pagination"></div>
                                {%- endif -%}

                                {%- if section.settings.show_navigation -%}
                                    <button
                                        type="button"
                                        class="swiper-button-next featured-products__nav-button"
                                        aria-label="{{ 'accessibility.next_slide' | t }}"
                                    >
                                        {%- render 'icons', icon: 'icon-arrow2' -%}
                                    </button>
                                {%- endif -%}
                            </div>
                        </div>
                    {%- endif -%}

                    {%- if section.settings.show_all -%}
                        {%- liquid
                            if block.settings.collection != blank
                                assign featured_products_shop_all_href = block.settings.collection.url
                            else
                                assign featured_products_shop_all_href = routes.all_products_collection_url
                            endif
                        -%}
                        <div class="featured-products__shop-all flex w-full justify-center">
                            {%- capture featured_products_shop_all_content -%}
                                <span class="uppercase">{{ 'collections.shop_all' | t }}</span>
                                {%- render 'icons',
                                    icon: 'icon-arrow2',
                                    class: 'ms-2',
                                    size: 'sm'
                                -%}
                            {%- endcapture -%}
                            {%- render 'link',
                                href: featured_products_shop_all_href,
                                variant: 'default',
                                class: 'link-with-icon-motion body-lg uppercase text-theme-text pc:body-xl',
                                content: featured_products_shop_all_content
                            -%}
                        </div>
                    {%- endif -%}
                </div>
            {% endfor %}
        {%- endcapture -%}

        <div
            data-module-id="featured-products"
            x-data="featuredProducts()"
            data-swiper-src="{{ 'vendor-swiper.min.js' | asset_url }}"
        >
            {%- render 'tab-control',
                initialTabStrategy: 'middle',
                scroll_mode: tab_scroll_mode,
                tab_header: tab_header,
                header_class: tab_header_class,
                tab_content: tab_content
            %}
        </div>

        {%- if section.settings.brand_name != blank -%}
            {% render 'watermark',
                variant: 'marquee',
                text: section.settings.brand_name,
                marquee_direction: section.settings.brand_marquee_direction,
                marquee_pause_on_hover: section.settings.brand_marquee_pause_on_hover,
                marquee_speed: section.settings.brand_marquee_speed,
                marquee_gap: section.settings.brand_marquee_gap,
                marquee_height: section.settings.brand_marquee_height,
                container_class: 'featured-products__brand-watermark'
            %}
        {%- endif -%}
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: 'featured-products-section',
    width: 'page',
    height_kind: 'content',
    motion: true,
    root_attrs: featured_products_root_attrs,
    children: featured_products_children
%}

{% stylesheet %}
    .featured-products-section {
        .product-grid {
            width: 100%;
            display: grid;
            grid-template-columns: repeat(var(--product-grid-columns-mobile), minmax(0, 1fr));
            gap: 3px;

            @media (width >= 48rem) {
                grid-template-columns: repeat(var(--product-grid-columns), minmax(0, 1fr));
                gap: 8px;
            }
        }

        .swiper {
            width: 100%;
            overflow: hidden;
        }
        .swiper-wrapper {
            display: flex;
        }
        .swiper-slide {
            flex-shrink: 0;
            width: calc(
                (100% - (var(--product-grid-columns-mobile) - 1) * 3px) /
                    var(--product-grid-columns-mobile)
            );
            margin-right: 3px;
        }
        @media (width >= 48rem) {
            .swiper-slide {
                width: calc(
                    (100% - (var(--product-grid-columns) - 1) * 8px) / var(--product-grid-columns)
                );
                margin-right: 8px;
            }
        }

        .swiper-pagination-bullet {
            background-color: currentColor;
            opacity: 0.2;
        }
        .swiper-pagination-bullet-active {
            opacity: 1;
        }
        .swiper-button-disabled {
            opacity: 0.35;
            cursor: not-allowed;
        }

        .featured-products__nav-button {
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9999px;
            border: 1px solid;
            transition:
                opacity var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease),
                border-color var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease);
        }

        .featured-products__nav-button:focus-visible {
            outline: var(--focus-ring-width) solid
                rgba(var(--color-focus-ring), var(--focus-ring-opacity, 0.4));
            outline-offset: var(--focus-ring-offset);
        }

        .featured-products__shop-all {
            padding-block-end: calc(2px + var(--focus-ring-width) + var(--focus-ring-offset));
        }
    }

    .tab-nav-item--opacity {
        opacity: 0.4;
        transition: opacity var(--motion-duration-fast, 250ms) var(--motion-ease-default, ease);
        &:hover,
        &:focus-visible,
        &.is-active {
            opacity: 1;
        }
    }

    .featured-products__tab-header {
        align-items: flex-start;
        padding-block: 0.6rem;
    }
    .featured-products__tab {
        padding-block: 0.12em;
        --sup-badge-font-size: 1em;
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.featured-products.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer", "custom.overlay"]
    },
    "settings": [
        {
            "type": "header",
            "content": "t:sections.featured-products.content.general"
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.featured-products.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.font"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "title-4xl",
                    "label": "t:settings.type_size.title_4xl"
                },
                {
                    "value": "title-3xl",
                    "label": "t:settings.type_size.title_3xl"
                },
                {
                    "value": "title-2xl",
                    "label": "t:settings.type_size.title_2xl"
                },
                {
                    "value": "title-xl",
                    "label": "t:settings.type_size.title_xl"
                },
                {
                    "value": "title-l",
                    "label": "t:settings.type_size.title_l"
                },
                {
                    "value": "title-m",
                    "label": "t:settings.type_size.title_m"
                },
                {
                    "value": "title-s",
                    "label": "t:settings.type_size.title_s"
                },
                {
                    "value": "title-xs",
                    "label": "t:settings.type_size.title_xs"
                }
            ],
            "default": "title-2xl"
        },
        {
            "type": "header",
            "content": "t:sections.featured-products.content.products_settings"
        },
        {
            "type": "range",
            "id": "max_items",
            "min": 2,
            "max": 12,
            "step": 1,
            "default": 8,
            "label": "t:sections.featured-products.settings.maximum_items"
        },
        {
            "type": "range",
            "id": "pc_items",
            "label": "t:sections.featured-products.settings.items_per_row_on_desktop",
            "min": 2,
            "max": 4,
            "step": 1,
            "default": 4
        },
        {
            "type": "select",
            "id": "mobile_items",
            "label": "t:sections.featured-products.settings.items_per_row_on_mobile",
            "options": [
                {
                    "value": "1",
                    "label": "t:sections.featured-products.options.1"
                },
                {
                    "value": "2",
                    "label": "t:sections.featured-products.options.2"
                }
            ],
            "default": "2"
        },
        {
            "type": "checkbox",
            "id": "show_navigation",
            "label": "t:sections.featured-products.settings.show_navigation",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "show_pagination",
            "label": "t:sections.featured-products.settings.show_pagination",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "show_all",
            "label": "t:sections.featured-products.settings.show_view_all_button",
            "default": false
        },
        {
            "type": "select",
            "id": "pc_tab_header_behavior",
            "label": "t:sections.featured-products.settings.desktop_tab_header_behavior",
            "options": [
                {
                    "value": "wrap",
                    "label": "t:sections.featured-products.options.wrap_to_multiple_lines"
                },
                {
                    "value": "scroll",
                    "label": "t:sections.featured-products.options.horizontal_drag_scroll"
                }
            ],
            "default": "wrap"
        },
        {
            "type": "header",
            "content": "t:sections.featured-products.content.brand"
        },
        {
            "type": "inline_richtext",
            "id": "brand_name",
            "label": "t:sections.featured-products.settings.brand_name",
            "default": "t:sections.featured-products.defaults.brand_name"
        },
        {
            "type": "select",
            "id": "brand_marquee_direction",
            "label": "t:sections.featured-products.settings.brand_marquee_direction",
            "options": [
                {
                    "value": "right_to_left",
                    "label": "t:sections.featured-products.options.right_to_left"
                },
                {
                    "value": "left_to_right",
                    "label": "t:sections.featured-products.options.left_to_right"
                }
            ],
            "default": "right_to_left"
        },
        {
            "type": "checkbox",
            "id": "brand_marquee_pause_on_hover",
            "label": "t:sections.featured-products.settings.brand_marquee_pause_on_hover",
            "info": "t:sections.featured-products.info.brand_marquee_pause_on_hover",
            "default": true
        },
        {
            "type": "select",
            "id": "brand_marquee_speed",
            "label": "t:sections.featured-products.settings.brand_marquee_speed",
            "options": [
                {
                    "value": "slow",
                    "label": "t:sections.featured-products.options.slow"
                },
                {
                    "value": "normal",
                    "label": "t:sections.featured-products.options.normal"
                },
                {
                    "value": "fast",
                    "label": "t:sections.featured-products.options.fast"
                }
            ],
            "default": "normal"
        },
        {
            "type": "range",
            "id": "brand_marquee_gap",
            "min": 24,
            "max": 160,
            "step": 4,
            "unit": "px",
            "label": "t:sections.featured-products.settings.brand_marquee_gap",
            "default": 64
        },
        {
            "type": "range",
            "id": "brand_marquee_height",
            "min": 120,
            "max": 420,
            "step": 10,
            "unit": "px",
            "label": "t:sections.featured-products.settings.brand_marquee_height",
            "info": "t:sections.featured-products.info.brand_marquee_height",
            "default": 380
        },
        {
            "type": "header",
            "content": "t:sections.featured-products.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.featured-products.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.featured-products.settings.padding_bottom",
            "default": 32
        }
    ],
    "blocks": [
        {
            "type": "collection",
            "name": "t:sections.featured-products.blocks.collection",
            "settings": [
                {
                    "type": "collection",
                    "id": "collection",
                    "label": "t:sections.featured-products.block_settings.select_collection"
                },
                {
                    "type": "inline_richtext",
                    "id": "collection_heading",
                    "label": "t:sections.featured-products.block_settings.collection_heading",
                    "default": "t:sections.featured-products.defaults.collection_heading"
                },
                {
                    "type": "inline_richtext",
                    "id": "collection_content",
                    "label": "t:sections.featured-products.block_settings.collection_content",
                    "default": "t:sections.featured-products.defaults.collection_content"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.featured-products.presets.featured_products",
            "blocks": [
                {
                    "type": "collection"
                },
                {
                    "type": "collection"
                },
                {
                    "type": "collection"
                }
            ]
        }
    ]
}
{% endschema %}
