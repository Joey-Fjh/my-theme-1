<div
    data-component-kind="section"
    data-component-type="featured-products"
    data-component-id="{{ section.id }}"
    data-section-id="{{ section.id }}"
    class="
        featured-products-section full-width
        color-{{ section.settings.color_scheme }}
    "
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <div class="layout container-page">
        {%- liquid
            assign pc_tab_header_behavior = section.settings.pc_tab_header_behavior | default: 'wrap'
            assign tab_header_class = 'featured-products__tab-header pc:justify-center'
            assign tab_scroll_mode = 'mobile'
            if pc_tab_header_behavior != 'wrap'
                assign tab_header_class = 'featured-products__tab-header pc:flex-nowrap pc:justify-center pc:overflow-x-auto pc:whitespace-nowrap'
                assign tab_scroll_mode = 'always'
            endif
        -%}

        {%- capture tab_header -%}
            {%- for block in section.blocks -%}
                <div 
                    role="tab" 
                    x-data="{ index: null }"
                    x-init="index = registerTab($el)"
                    :id="`tab-${index}`"
                    :aria-controls="`panel-${index}`"
                    @click="setActive(index)"
                    :tabindex="isActive(index) ? 0 : -1"
                    :aria-selected="isActive(index)"
                    :class="isActive(index)
                        ? 'opacity-100'
                        : 'opacity-20 hover:opacity-60 focus:opacity-60'"
                    class="cursor-pointer h1 transition-opacity focus:outline-none"
                    {{ block.shopify_attributes }}
                >
                    <div>                        
                        {%- if block.settings.collection_heading != blank -%}
                            {{ block.settings.collection_heading }}
                        {%- else -%}
                            {{ block.settings.collection.title }}
                        {%- endif -%}
                        <sup class="sup-badge">
                            ({{ block.settings.collection.products_count | default: 0 }})
                        </sup>
                    </div>
                </div>
            {%- endfor -%}
        {%- endcapture -%}

        {%- capture tab_content -%}
            {%- for block in section.blocks -%}
                <div
                    role="tabpanel"
                    x-data="{ index: null }"
                    x-init="index = registerPanel($el)"
                    :id="`panel-${index}`"
                    :aria-labelledby="`tab-${index}`"
                    x-show="isActive(index)"
                    x-cloak
                    x-transition:enter="tab-enter"
                    x-transition:enter-start="tab-enter-start"
                    x-transition:enter-end="tab-enter-end"
                    x-transition:leave="tab-leave"
                    x-transition:leave-start="tab-leave-start"
                    x-transition:leave-end="tab-leave-end"
                    class="flex flex-col items-center gap-8"
                    {{ block.shopify_attributes }}
                >
                    {%- if block.settings.collection_content != blank -%}
                        <p class="body-md">{{ block.settings.collection_content }}</p>
                    {%- endif -%}
                    
                    {%- liquid
                        assign products = block.settings.collection.products
                        assign max_items = section.settings.max_items
                        assign use_slider = false
                        if section.settings.show_navigation or section.settings.show_pagination or section.settings.show_all
                            assign use_slider = true
                        endif
                    -%}

                    <div 
                        class="{% if use_slider %}w-full relative{% else %}product-grid{% endif %}"
                        style="
                            --product-grid-columns: {{ section.settings.pc_items }};
                            --product-grid-columns-mobile: {{ section.settings.mobile_items }};
                        "
                    >
                        {% if use_slider %}
                            <div 
                                class="swiper w-full"
                                data-mobile-items="{{ section.settings.mobile_items }}"
                                data-pc-items="{{ section.settings.pc_items }}"
                            >
                                <div class="swiper-wrapper">
                        {% endif %}
                                    {% # theme-check-disable-next-line LiquidHTMLSyntaxError %}
                                    {%- for product in products limit: max_items -%}
                                        {%- if use_slider -%}
                                            <div class="swiper-slide h-auto">
                                        {%- endif -%}
                                            {%- render 'product-card', 
                                                product: product,
                                                pc_items: section.settings.pc_items,
                                                mobile_items: section.settings.mobile_items,
                                                class: 'h-full',
                                                scope_id: section.id,
                                                color_scheme: section.settings.color_scheme
                                            -%}
                                        {%- if use_slider -%}
                                            </div>
                                        {%- endif -%}
                                    {%- endfor -%}
                        {% if use_slider %}
                                </div>
                            </div>
                        {% endif %}
                    </div>

                    {%- if use_slider -%}
                        <div class="mt-4 flex w-full items-center justify-between pc:mt-6">
                            <div class="flex items-center gap-4">
                                {%- if section.settings.show_navigation -%}
                                    <button class="swiper-button-prev flex items-center justify-center rounded-full border text-theme-text" aria-label="Previous slide">
                                        {%- render 'icons', icon: 'icon-arrow2', size: 'xl', class: 'rotate-180', color: 'current' -%}
                                    </button>
                                {%- endif -%}
                                
                                {%- if section.settings.show_pagination -%}
                                    <div class="swiper-pagination text-theme-text"></div>
                                {%- endif -%}

                                {%- if section.settings.show_navigation -%}
                                    <button class="swiper-button-next flex items-center justify-center rounded-full border text-theme-text" aria-label="Next slide">
                                        {%- render 'icons', icon: 'icon-arrow2', size: 'xl', color: 'current' -%}
                                    </button>
                                {%- endif -%}
                            </div>

                            {%- if section.settings.show_all and block.settings.collection != blank -%}
                                <a href="{{ block.settings.collection.url }}" class="body-md font-medium underline underline-offset-4 transition-opacity hover:opacity-70">
                                    View All
                                </a>
                            {%- endif -%}
                        </div>
                    {%- endif -%}
                </div>
            {% endfor %}
        {%- endcapture -%}

        {%- render 'tab-control',
            initialTabStrategy: 'middle',
            scroll_mode: tab_scroll_mode,
            tab_header: tab_header,
            header_class: tab_header_class,
            tab_content: tab_content
        %}

        {%- render 'image',
            image: section.settings.image,
            alt: section.settings.image.alt,
            width: section.settings.image.width,
            sizes: '(min-width: 48rem) 28rem, 18rem',
            loading: 'lazy',
            placeholder_aspect_ratio: '16/5'
        -%}
    </div>
</div>

{% stylesheet %}
    .featured-products-section {
        .product-grid {
            width: 100%;
            display: grid;
            grid-template-columns: repeat(var(--product-grid-columns-mobile), minmax(0, 1fr));
            gap: 3px;

            @media (min-width: 768px) {
                grid-template-columns: repeat(var(--product-grid-columns), minmax(0, 1fr));
                gap: 8px;
            }
        }

        .swiper {
            width: 100%;
            overflow: hidden;
        }
        .swiper-wrapper {
            display: flex;
        }
        .swiper-slide {
            flex-shrink: 0;
            width: calc(
                (100% - (var(--product-grid-columns-mobile) - 1) * 3px) /
                    var(--product-grid-columns-mobile)
            );
            margin-right: 3px;
        }
        @media (min-width: 768px) {
            .swiper-slide {
                width: calc(
                    (100% - (var(--product-grid-columns) - 1) * 8px) / var(--product-grid-columns)
                );
                margin-right: 8px;
            }
        }

        .swiper-pagination-bullet {
            background-color: currentColor;
            opacity: 0.2;
        }
        .swiper-pagination-bullet-active {
            opacity: 1;
        }
        .swiper-button-disabled {
            opacity: 0.35;
            cursor: not-allowed;
        }
    }
{% endstylesheet %}

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components) return;

        Components.register(
            'featured-products',
            {
                init(el) {
                    const swipers = [];
                    const swiperEls = el.querySelectorAll('.swiper');

                    if (swiperEls.length > 0 && typeof Swiper !== 'undefined') {
                        swiperEls.forEach((swiperEl) => {
                            const mobileItems =
                                parseInt(swiperEl.getAttribute('data-mobile-items')) || 2;
                            const pcItems = parseInt(swiperEl.getAttribute('data-pc-items')) || 4;

                            const options = {
                                slidesPerView: mobileItems,
                                spaceBetween: 3,
                                observer: true,
                                observeParents: true,
                                breakpoints: {
                                    768: {
                                        slidesPerView: pcItems,
                                        spaceBetween: 8,
                                    },
                                },
                            };

                            // Link navigation and pagination to the panel's DOM controls
                            const panel = swiperEl.closest('[role="tabpanel"]');
                            const nextEl = panel?.querySelector('.swiper-button-next');
                            const prevEl = panel?.querySelector('.swiper-button-prev');
                            const paginationEl = panel?.querySelector('.swiper-pagination');

                            if (nextEl && prevEl) {
                                options.navigation = { nextEl, prevEl };
                            }
                            if (paginationEl) {
                                options.pagination = { el: paginationEl, clickable: true };
                            }

                            swipers.push(new Swiper(swiperEl, options));
                        });
                    }

                    return { swipers };
                },
                destroy(el, state) {
                    if (state?.swipers) {
                        state.swipers.forEach((s) => s.destroy(true, true));
                    }
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{% schema %}
{
    "name": "Featured Products",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "header",
            "content": "General"
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color Scheme",
            "default": "color-scheme-1"
        },
        {
            "type": "header",
            "content": "Products Settings"
        },
        {
            "type": "range",
            "id": "max_items",
            "min": 2,
            "max": 12,
            "step": 1,
            "default": 8,
            "label": "Maximum items"
        },
        {
            "type": "range",
            "id": "pc_items",
            "label": "Items per row on desktop",
            "min": 2,
            "max": 4,
            "step": 1,
            "default": 4
        },
        {
            "type": "select",
            "id": "mobile_items",
            "label": "Items per row on mobile",
            "options": [
                { "value": "1", "label": "1" },
                { "value": "2", "label": "2" }
            ],
            "default": "2"
        },
        {
            "type": "checkbox",
            "id": "show_navigation",
            "label": "Show Navigation",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "show_pagination",
            "label": "Show Pagination",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "show_all",
            "label": "Show View All Button",
            "default": false
        },
        {
            "type": "select",
            "id": "pc_tab_header_behavior",
            "label": "Desktop tab header behavior",
            "options": [
                { "value": "wrap", "label": "Wrap to multiple lines" },
                { "value": "scroll", "label": "Horizontal drag/scroll" }
            ],
            "default": "wrap"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "collection",
            "name": "Collection",
            "settings": [
                {
                    "type": "collection",
                    "id": "collection",
                    "label": "Select Collection"
                },
                {
                    "type": "inline_richtext",
                    "id": "collection_heading",
                    "label": "Collection Heading",
                    "default": "Featured Collection"
                },
                {
                    "type": "inline_richtext",
                    "id": "collection_content",
                    "label": "Collection Content",
                    "default": "Featured collection description goes here."
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Featured Products",
            "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
        }
    ]
}
{% endschema %}
