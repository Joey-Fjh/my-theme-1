<div
    data-section-id="{{ section.id }}"
    class="scroll-categories-section full-width"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="motionRevealSection()"
    data-motion-section
>
    <div class="layout container-page color-{{ section.settings.color_scheme }}">
        {%- liquid
            assign selected_collection = section.settings.collection
            assign scroll_categories_heading_class = section.settings.heading_size | default: 'heading-2xl'
            assign scroll_categories_collection_heading_class = section.settings.collection_heading_size | default: 'heading-3xl'
            assign scroll_categories_subtitle_size = section.settings.subtitle_size | default: 'body-xl'
            assign scroll_categories_subtitle_class = 'typo-subtitle text-theme-text ' | append: scroll_categories_subtitle_size
        -%}

        <div class="flex flex-col gap-16">
            <div
                class="flex flex-col gap-3 pc:flex-row pc:items-center pc:justify-between"
                data-motion-sequence
            >
                {%- capture link_content -%}
                    <h1 class="{{ scroll_categories_heading_class }}">
                        {%- if section.settings.heading != blank -%}
                            {{ section.settings.heading }}
                        {%- else -%}
                            {{ selected_collection.title }}
                        {%- endif -%}

                        {%- if selected_collection != nil and selected_collection.products_count > 0 -%}
                            <sup class="sup-badge">({{ selected_collection.products_count }})</sup>
                        {%- endif -%}
                    </h1>
                {%- endcapture -%}

                <div data-motion-reveal="content">
                    {%- if selected_collection != blank -%}
                        {%- render 'link',
                            href: selected_collection.url,
                            content: link_content,
                            variant: 'underline'
                        -%}
                    {%- else -%}
                        {{- link_content -}}
                    {%- endif -%}
                </div>

                <div
                    class="rte rte--compact {{ scroll_categories_subtitle_class }}"
                    data-motion-reveal="content"
                >
                    {{ section.settings.description }}
                </div>
            </div>

            <div data-motion-cascade>
                {%- assign max_items = section.settings.max_items -%}

                {% # theme-check-disable-next-line LiquidHTMLSyntaxError %}
                {%- for product in selected_collection.products limit: max_items -%}
                    <a
                        class="scroll-categories__item block py-8 text-theme-text/80 pc:p-8"
                        href="{{ product.url }}"
                        title="{{ product.title | escape }}"
                        data-motion-bound
                        x-data="{hover:false}"
                        @mouseenter="hover = true"
                        @mouseleave="hover = false"
                        @focus="hover = true"
                        @blur="hover = false"
                        :class="{ 'is-hovered': hover }"
                    >
                        <div
                            class="flex w-full flex-col gap-3 pc:flex-row pc:items-center pc:justify-between"
                            data-motion-reveal="content"
                        >
                            <span class="scroll-categories__item-side shrink-0 body-lg text-theme-text">
                                {%- if product.type != blank -%}
                                    {{ product.type }}
                                {%- else -%}
                                    {{ 'products.product.fallback_vendor' | t }}
                                {%- endif -%}
                            </span>

                            <div class="relative flex min-w-0 items-center gap-4 pc:pe-44">
                                <h2 class="scroll-categories__product-title min-w-0 truncate {{ scroll_categories_collection_heading_class }}">
                                    {{ product.title }}
                                </h2>

                                <div
                                    class="
                                        scroll-categories__preview
                                        absolute
                                        end-0
                                        top-1/2
                                        hidden
                                        aspect-100/72 h-30
                                        -translate-y-1/2 scale-95
                                        opacity-0
                                        pc:block
                                    "
                                    :class="hover ? 'opacity-100 scale-100' : ''"
                                >
                                    {%- if product.featured_image != blank -%}
                                        {%- assign alt = product.featured_image.alt
                                            | default: product.title
                                            | escape
                                        -%}
                                        {%- render 'image-magnifier',
                                            class: 'h-full w-full',
                                            image: product.featured_image,
                                            alt: alt,
                                            width: 220,
                                            sizes: '220px',
                                            zoom_width: 1200,
                                            preview_mode: 'contain',
                                            preview_width: 280,
                                            preview_height: 200,
                                            motion_reveal: false
                                        -%}
                                    {%- else -%}
                                        {%- assign image_alt = product.featured_image.alt
                                            | default: product.title
                                            | escape
                                        -%}
                                        {%- render 'image',
                                            class: 'h-full w-full',
                                            image: product.featured_image,
                                            alt: image_alt,
                                            width: 220,
                                            sizes: '220px',
                                            motion_reveal: false
                                        -%}
                                    {%- endif -%}
                                </div>
                            </div>

                            <span class="scroll-categories__item-side shrink-0 body-lg text-theme-text">
                                {%- render 'product-card-price', product: product -%}
                            </span>
                        </div>
                    </a>
                {%- else -%}
                    {%- for placeholder_index in (1..max_items) -%}
                        {%- liquid
                            assign product_placeholder_index = placeholder_index | minus: 1 | modulo: 6 | plus: 1
                            assign product_placeholder_key = 'product-' | append: product_placeholder_index
                        -%}
                        <div
                            class="scroll-categories__item block py-8 text-theme-text/80 pc:p-8"
                            data-motion-bound
                            x-data="{hover:false}"
                            @mouseenter="hover = true"
                            @mouseleave="hover = false"
                            :class="{ 'is-hovered': hover }"
                        >
                            <div
                                class="flex w-full flex-col gap-3 pc:flex-row pc:items-center pc:justify-between"
                                data-motion-reveal="content"
                            >
                                <span class="scroll-categories__item-side shrink-0 body-lg text-theme-text">
                                    {{- 'products.product.fallback_vendor' | t -}}
                                </span>

                                <div class="relative flex min-w-0 items-center gap-4 pc:pe-44">
                                    <h2 class="scroll-categories__product-title min-w-0 truncate {{ scroll_categories_collection_heading_class }}">
                                        {{-
                                            'products.product.example_title_numbered'
                                            | t: index: placeholder_index
                                        -}}
                                    </h2>

                                    <div
                                        class="
                                            scroll-categories__preview
                                            absolute
                                            end-0
                                            top-1/2
                                            hidden
                                            aspect-100/72 h-30
                                            -translate-y-1/2 scale-95
                                            opacity-0
                                            pc:block
                                        "
                                        :class="hover ? 'opacity-100 scale-100' : ''"
                                    >
                                        {%- render 'image-magnifier',
                                            class: 'h-full w-full',
                                            image: blank,
                                            placeholder_key: product_placeholder_key,
                                            aspect_ratio: '100/72',
                                            fit: 'contain',
                                            image_wrapper_class: 'h-full w-full',
                                            width: 220,
                                            sizes: '220px',
                                            zoom_width: 1200,
                                            preview_mode: 'contain',
                                            preview_width: 280,
                                            preview_height: 200,
                                            motion_reveal: false
                                        -%}
                                    </div>
                                </div>

                                <span class="scroll-categories__item-side shrink-0 body-lg text-theme-text">
                                    {{- 1999 | money -}}
                                </span>
                            </div>
                        </div>
                    {%- endfor -%}
                {%- endfor -%}
            </div>

            <div
                class="rte rte--compact flex flex-col items-center justify-center self-center text-center"
                data-motion-reveal="content"
            >
                {% render 'icons', icon: 'icon-eyeglasses' %}

                {{ section.settings.caption }}
            </div>
        </div>
    </div>
</div>

{% stylesheet %}
    .scroll-categories__item {
        transition:
            background-color var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease),
            color var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease);
    }

    .scroll-categories__item.is-hovered {
        background-color: rgb(var(--color-foreground));
        color: rgb(var(--color-background));
    }

    /* Explicit foreground on title and side meta; inherit only on row hover invert */
    .scroll-categories__item.is-hovered .scroll-categories__product-title,
    .scroll-categories__item.is-hovered .scroll-categories__item-side {
        color: inherit;
    }

    .scroll-categories__preview {
        transition:
            opacity var(--motion-duration-base, 300ms) var(--motion-ease-exit, ease-out),
            transform var(--motion-duration-base, 300ms) var(--motion-ease-exit, ease-out);
    }
{% endstylesheet %}

