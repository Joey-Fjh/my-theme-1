<div
    data-section-id="{{ section.id }}"
    class="scroll-categories-section full-width"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <div class="layout container-page color-{{ section.settings.color_scheme }}">
        {%- assign selected_collection = section.settings.collection -%}

        <div class="flex flex-col gap-16">
            <div class="flex flex-col gap-3 pc:flex-row pc:items-center pc:justify-between">
                {%- capture link_content -%}
                    <h2 class="font-bold">
                        {%- if section.settings.heading != blank -%}
                            {{ section.settings.heading }}
                        {%- else -%}
                            {{ selected_collection.title }}
                        {%- endif -%}

                        {%- if selected_collection != nil and selected_collection.products_count > 0 -%}
                            <sup class="sup-badge">({{ selected_collection.products_count }})</sup>
                        {%- endif -%}
                    </h2>
                {%- endcapture -%}

                {%- render 'link',
                    href: selected_collection.url,
                    content: link_content,
                    variant: 'underline',
                    color: 'current'
                -%}

                <div class="rte rte--compact opacity-80">{{ section.settings.description }}</div>
            </div>

            <div>
                {%- assign max_items = section.settings.max_items -%}

                {% # theme-check-disable-next-line LiquidHTMLSyntaxError %}
                {%- for product in selected_collection.products limit: max_items -%}
                    <a
                        class="flex flex-col gap-3 py-8 body-md pc:flex-row pc:items-center pc:justify-between pc:p-8"
                        href="{{ product.url }}"
                        title="{{ product.title | escape }}"
                        x-data="{hover:false}"
                        @mouseenter="hover = true"
                        @mouseleave="hover = false"
                        @focus="hover = true"
                        @blur="hover = false"
                        :class=" hover ? 'bg-theme-text text-theme-bg':'' "
                    >
                        <span class="shrink-0 opacity-80">
                            {{ product.type | default: 'Momonise' }}
                        </span>

                        <div class="relative flex min-w-0 items-center gap-4 pc:pr-44">
                            <h2 class="truncate h1">{{ product.title }}</h2>

                            <div
                                class="
                                    absolute
                                    top-1/2
                                    right-0
                                    hidden
                                    aspect-100/72 h-30
                                    -translate-y-1/2 scale-95
                                    opacity-0
                                    transition-all duration-300
                                    ease-out pc:block
                                "
                                :class="hover ? 'opacity-100 scale-100' : ''"
                            >
                                {%- if product.featured_image != blank -%}
                                    {%-
                                        render 'image-magnifier',
                                        class: 'h-full w-full',
                                        image: product.featured_image,
                                        alt: product.featured_image.alt | default: product.title | escape,
                                        width: 220,
                                        sizes: '220px',
                                        zoom_width: 1200,
                                        preview_mode: 'contain',
                                        preview_width: 280,
                                        preview_height: 200
                                    -%}
                                {%- else -%}
                                    {%-
                                        render 'image',
                                        class: 'h-full w-full',
                                        image: product.featured_image,
                                        alt: product.featured_image.alt | default: product.title | escape,
                                        width: 220,
                                        sizes: '220px'
                                    -%}
                                {%- endif -%}
                            </div>
                        </div>

                        <span class="shrink-0">
                            {{ product.price | money }}
                        </span>
                    </a>
                {%- endfor -%}
            </div>

            <div class="rte rte--compact flex flex-col items-center justify-center self-center text-center body-md">
                {% render 'icons', icon: 'icon-eyeglasses', size: 'lg', color: 'current' %}

                {{ section.settings.caption }}
            </div>
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:sections.scroll-categories.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.scroll-categories.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "range",
            "id": "max_items",
            "min": 4,
            "max": 8,
            "step": 1,
            "default": 4,
            "label": "t:sections.scroll-categories.settings.maximum_items"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "t:sections.scroll-categories.settings.heading"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "t:sections.scroll-categories.settings.description",
            "default": "t:sections.scroll-categories.defaults.description"
        },
        {
            "type": "collection",
            "id": "collection",
            "label": "t:sections.scroll-categories.settings.select_collection"
        },
        {
            "type": "richtext",
            "id": "caption",
            "label": "t:sections.scroll-categories.settings.caption",
            "default": "t:sections.scroll-categories.defaults.caption"
        },
        {
            "type": "header",
            "content": "t:sections.scroll-categories.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.scroll-categories.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.scroll-categories.settings.padding_bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "t:sections.scroll-categories.presets.scroll_categories",
            "settings": {}
        }
    ]
}
{% endschema %}
