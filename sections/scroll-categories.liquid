{%- liquid
    assign selected_collection = section.settings.collection
    assign max_items = section.settings.max_items
    assign scroll_categories_heading_class = section.settings.heading_size | default: 'title-2xl'
    assign scroll_categories_row_title_class = section.settings.collection_heading_size | default: 'title-l'
    assign scroll_categories_link_label_default = 'sections.scroll-categories.defaults.link_label' | t
    assign scroll_categories_link_label = section.settings.link_label | default: scroll_categories_link_label_default
    assign scroll_categories_description_words = 24
    assign scroll_categories_row_link_attributes = '@pointerdown="onRowLinkPointerDown($event)" @click="onRowLinkClick($event)"'

    case scroll_categories_heading_class
        when 'title-3xl'
            assign scroll_categories_heading_tiers = 'title-2xl tablet:title-3xl'
        when 'title-2xl'
            assign scroll_categories_heading_tiers = 'title-2xl tablet:title-2xl'
        when 'title-xl'
            assign scroll_categories_heading_tiers = 'title-xl tablet:title-xl'
        else
            assign scroll_categories_heading_tiers = scroll_categories_heading_class
    endcase

    case scroll_categories_row_title_class
        when 'title-l'
            assign scroll_categories_row_title_tiers = 'title-l'
        when 'title-m'
            assign scroll_categories_row_title_tiers = 'title-m'
        else
            assign scroll_categories_row_title_tiers = scroll_categories_row_title_class
    endcase

    assign scroll_categories_item_count = 0
    for scroll_categories_product in selected_collection.products limit: max_items
        assign scroll_categories_item_count = scroll_categories_item_count | plus: 1
    endfor
    if scroll_categories_item_count == 0
        assign scroll_categories_item_count = max_items
    endif

    if scroll_categories_item_count < 10
        assign scroll_categories_count_label = scroll_categories_item_count | prepend: '0'
    else
        assign scroll_categories_count_label = scroll_categories_item_count
    endif

    if section.settings.heading != blank
        assign scroll_categories_heading_text = section.settings.heading
    elsif selected_collection != blank
        assign scroll_categories_heading_text = selected_collection.title
    else
        assign scroll_categories_heading_text = 'sections.scroll-categories.defaults.heading' | t
    endif
-%}

{%- capture scroll_categories_panel_link_content -%}
    <span class="uppercase">{{ scroll_categories_link_label }}</span>
    {%- render 'icons', icon: 'icon-arrow2', class: 'ms-step-2xs', size: 'sm' -%}
{%- endcapture -%}

{%- capture scroll_categories_children -%}
    <div
        class="scroll-categories__root flex flex-col gap-step-l tablet:gap-step-4xl"
        data-module-id="scroll-categories"
        data-module-lazy
        x-data="scrollCategories()"
        data-initial-active="1"
    >
        <div class="scroll-categories__header flex flex-col">
            <h2
                class="scroll-categories__heading {{ scroll_categories_heading_tiers }}"
            >
                <span>{{- scroll_categories_heading_text -}}</span>
                <span class="shrink-0">({{ scroll_categories_count_label }})</span>
            </h2>
            <hr class="scroll-categories__divider" />
        </div>

        <div
            class="scroll-categories__grid"
            data-motion-cascade
            style="--scroll-categories-rows: {{ scroll_categories_item_count }}"
        >
            {%- for product in selected_collection.products limit: max_items -%}
                {%- liquid
                    assign scroll_categories_index_label = forloop.index
                    if forloop.index < 10
                        assign scroll_categories_index_label = forloop.index | prepend: '0'
                    endif
                    assign scroll_categories_description = product.description | strip_html | strip | truncatewords: scroll_categories_description_words
                    assign scroll_categories_image = product.featured_image
                    assign scroll_categories_image_alt = scroll_categories_image.alt | default: product.title | escape
                    assign scroll_categories_panel_aria_label = 'sections.scroll-categories.panel_link_aria' | t: product: product.title, label: scroll_categories_link_label
                    if forloop.first
                        assign scroll_categories_image_loading = 'eager'
                    else
                        assign scroll_categories_image_loading = 'lazy'
                    endif
                -%}
                <article
                    class="scroll-categories__item flex flex-col gap-step-xl tablet:contents"
                    data-motion-bound
                >
                    <div
                        class="scroll-categories__row scroll-categories__row--desktop-pitch{% if forloop.first %} is-active{% else %} is-inactive{% endif %}"
                        data-item-index="{{ forloop.index }}"
                        @mouseenter="onRowEnterFromEl($el)"
                        @focusin="setActiveFromEl($el)"
                        :class="rowClassFromEl($el)"
                    >
                        {%- capture scroll_categories_row_title -%}
                            <h3 class="scroll-categories__row-heading flex min-w-0 flex-1 flex-col items-start gap-step-3xs tablet:flex-row tablet:items-baseline tablet:gap-step-m {{ scroll_categories_row_title_tiers }} text-theme-text">
                                <span class="scroll-categories__index copy-s">{{ scroll_categories_index_label }}</span>
                                <span class="scroll-categories__title">{{ product.title }}</span>
                            </h3>
                        {%- endcapture -%}
                        {%- render 'link',
                            href: product.url,
                            variant: 'plain',
                            class: 'min-w-0 flex-1',
                            attributes: scroll_categories_row_link_attributes,
                            content: scroll_categories_row_title
                        -%}
                    </div>

                    <div
                        class="scroll-categories__details{% if forloop.first %} is-active{% endif %}{% unless forloop.first %} scroll-categories__details--inactive{% endunless %}"
                        data-item-index="{{ forloop.index }}"
                        :class="detailsClassFromEl($el)"
                    >
                        <div class="scroll-categories__media">
                            {%- render 'image',
                                class: 'h-full w-full object-cover',
                                image: scroll_categories_image,
                                alt: scroll_categories_image_alt,
                                loading: scroll_categories_image_loading,
                                sizes: '(min-width: 48rem) 45vw, 100vw',
                                widths: '400,600,800,1000,1200,1600'
                            -%}
                        </div>

                        {%- if scroll_categories_description != blank -%}
                            <p class="order-1 line-clamp-3 copy-xl text-theme-text tablet:order-2">{{ scroll_categories_description }}</p>
                        {%- endif -%}

                        <div class="order-2 tablet:order-3">
                            {%- render 'link',
                                href: product.url,
                                variant: 'default',
                                class: 'link-with-icon-motion copy-s uppercase text-theme-text tablet:copy-s self-start',
                                aria_label: scroll_categories_panel_aria_label,
                                content: scroll_categories_panel_link_content
                            -%}
                        </div>
                    </div>
                </article>
            {%- else -%}
                {%- for placeholder_index in (1..max_items) -%}
                    {%- liquid
                        assign scroll_categories_index_label = placeholder_index
                        if placeholder_index < 10
                            assign scroll_categories_index_label = placeholder_index | prepend: '0'
                        endif
                        assign product_placeholder_index = placeholder_index | minus: 1 | modulo: 6 | plus: 1
                        assign product_placeholder_key = 'product-' | append: product_placeholder_index
                        assign scroll_categories_placeholder_title = 'products.product.example_title_numbered' | t: index: placeholder_index
                        assign scroll_categories_placeholder_description = 'sections.scroll-categories.placeholder_description' | t
                        assign scroll_categories_placeholder_panel_aria_label = 'sections.scroll-categories.panel_link_aria' | t: product: scroll_categories_placeholder_title, label: scroll_categories_link_label
                        if forloop.first
                            assign scroll_categories_image_loading = 'eager'
                        else
                            assign scroll_categories_image_loading = 'lazy'
                        endif
                    -%}
                    <article
                        class="scroll-categories__item flex flex-col gap-step-xl tablet:contents"
                        data-motion-bound
                    >
                        <div
                            class="scroll-categories__row scroll-categories__row--desktop-pitch{% if forloop.first %} is-active{% else %} is-inactive{% endif %}"
                            data-item-index="{{ forloop.index }}"
                            @mouseenter="onRowEnterFromEl($el)"
                            @focusin="setActiveFromEl($el)"
                            :class="rowClassFromEl($el)"
                        >
                            {%- capture scroll_categories_placeholder_row_title -%}
                                <h3 class="scroll-categories__row-heading flex min-w-0 flex-1 flex-col items-start gap-step-3xs tablet:flex-row tablet:items-baseline tablet:gap-step-m {{ scroll_categories_row_title_tiers }} text-theme-text">
                                    <span class="scroll-categories__index copy-s">{{ scroll_categories_index_label }}</span>
                                    <span class="scroll-categories__title">{{ scroll_categories_placeholder_title }}</span>
                                </h3>
                            {%- endcapture -%}
                            {%- render 'link',
                                href: routes.all_products_collection_url,
                                variant: 'plain',
                                class: 'min-w-0 flex-1',
                                attributes: scroll_categories_row_link_attributes,
                                content: scroll_categories_placeholder_row_title
                            -%}
                        </div>

                        <div
                            class="scroll-categories__details{% if forloop.first %} is-active{% endif %}{% unless forloop.first %} scroll-categories__details--inactive{% endunless %}"
                            data-item-index="{{ forloop.index }}"
                            :class="detailsClassFromEl($el)"
                        >
                            <div class="scroll-categories__media scroll-categories__media--placeholder">
                                {% render 'decorative-placeholder-svg',
                                    placeholder_key: product_placeholder_key,
                                    class: 'h-full w-full object-cover'
                                %}
                            </div>

                            <p class="order-1 line-clamp-3 copy-xl text-theme-text tablet:order-2">{{ scroll_categories_placeholder_description }}</p>

                            <div class="order-2 tablet:order-3">
                                {%- render 'link',
                                    href: routes.all_products_collection_url,
                                    variant: 'default',
                                    class: 'link-with-icon-motion copy-s uppercase text-theme-text tablet:copy-s self-start',
                                    aria_label: scroll_categories_placeholder_panel_aria_label,
                                    content: scroll_categories_panel_link_content
                                -%}
                            </div>
                        </div>
                    </article>
                {%- endfor -%}
            {%- endfor -%}
        </div>
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: 'scroll-categories-section',
    scheme_target: 'inner',
    surface_section: false,
    width: 'page',
    height_kind: 'content',
    motion: true,
    children: scroll_categories_children
%}

{% stylesheet %}
    .scroll-categories__heading {
        margin-block-end: 1.05em;
    }

    :where(.scroll-categories__heading) {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: clamp(0.9rem, 0.6514rem + 0.663vw, 1.5rem);
        color: rgb(var(--color-foreground));
    }

    .scroll-categories__index,
    .scroll-categories__title {
        font-weight: 400;
    }

    @media (width >= 64rem) {
        .scroll-categories__index {
            flex: 0 0 36%;
            white-space: nowrap;
            font-size: 1em;
            line-height: inherit;
        }
    }

    .scroll-categories__divider {
        height: 1px;
        background-color: var(--color-line);
    }

    .scroll-categories__row {
        transition: color var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease);
        color: rgb(var(--color-foreground));
    }

    @media (width < 64rem) {
        .scroll-categories__row.is-inactive,
        .scroll-categories__row.is-active {
            opacity: 1;
        }
    }

    .scroll-categories__details {
        transition:
            opacity var(--motion-duration-base, 300ms) var(--motion-ease-exit, ease-out),
            visibility 0s linear var(--motion-duration-base, 300ms);
    }

    .scroll-categories__media,
    .scroll-categories__media--placeholder {
        aspect-ratio: 1 / 1;
        border-radius: var(--radius-card);
    }

    /* Tablet portrait: a full-width square is taller than the screen allows for a list. */
    @media (width >= 48rem) and (width < 64rem) {
        .scroll-categories__media,
        .scroll-categories__media--placeholder {
            aspect-ratio: 4 / 3;
        }
    }

    @media (width >= 64rem) {
        .scroll-categories__heading {
            margin-block-end: 1.05em;
        }

        .scroll-categories__title {
            white-space: nowrap;
        }

        .scroll-categories__row--desktop-pitch {
            padding-block: 0.45em;
        }

        .scroll-categories__grid {
            display: grid;
            grid-template-columns: minmax(0, 62.6%) minmax(0, 37.4%);
            grid-template-rows: repeat(var(--scroll-categories-rows, 1), auto);
            column-gap: 2.5rem;
            row-gap: 0;
        }

        .scroll-categories__row {
            grid-column: 1;
        }

        .scroll-categories__details {
            grid-column: 2;
            grid-row: 1 / -1;
            align-self: start;
            transition:
                opacity var(--motion-duration-base, 300ms) var(--motion-ease-exit, ease-out),
                visibility 0s;
        }

        .scroll-categories__row.is-inactive {
            color: var(--color-muted);
        }

        .scroll-categories__row.is-inactive h3 {
            color: inherit;
        }

        .scroll-categories__row.is-active {
            color: rgb(var(--color-foreground));
        }

        .scroll-categories__media,
        .scroll-categories__media--placeholder {
            aspect-ratio: 513 / 371;
        }

        .scroll-categories__details:not(.is-active) {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition:
                opacity var(--motion-duration-base, 300ms) var(--motion-ease-exit, ease-out),
                visibility 0s linear var(--motion-duration-base, 300ms);
        }

        .scroll-categories__details.is-active {
            opacity: 1;
            visibility: visible;
        }
    }

    .scroll-categories__media--placeholder {
        border: 1px solid var(--color-line);
        background-color: rgb(var(--color-background));

        @supports (background-color: color-mix(in oklab, white, black)) {
            background-color: var(--color-surface-muted);
        }
    }

    .scroll-categories__media--placeholder svg {
        width: 100%;
        height: 100%;
        display: block;
    }

    @media (prefers-reduced-motion: reduce) {
        .scroll-categories__row,
        .scroll-categories__details {
            transition: none;
        }
    }

    :where(.scroll-categories__divider) {
        border-style: var(--tw-border-style);
        border-width: 0px;
    }

    :where(.scroll-categories__grid) {
        display: flex;
        flex-direction: column;
        gap: clamp(1.2rem, 0.8685rem + 0.884vw, 2rem);
    }

    :where(.scroll-categories__index) {
        color: rgb(var(--color-foreground));
    }

    :where(.scroll-categories__title) {
        min-width: calc(var(--spacing) * 0);
        flex: 1;
    }

    :where(.scroll-categories__media) {
        order: 3;
        width: 100%;
        overflow: hidden;
        @media (width >= 48rem) {
            order: 1;
        }
    }

    :where(.scroll-categories__row) {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: clamp(0.15rem, 0.1086rem + 0.11vw, 0.25rem);
        @media (width >= 48rem) {
            flex-direction: row;
            align-items: baseline;
            gap: clamp(0.9rem, 0.6514rem + 0.663vw, 1.5rem);
        }
    }

    :where(.scroll-categories__details) {
        display: flex;
        flex-direction: column;
        gap: clamp(1.2rem, 0.8685rem + 0.884vw, 2rem);
        @media (width >= 48rem) {
            gap: clamp(0.9rem, 0.6514rem + 0.663vw, 1.5rem);
        }
    }

    :where(.scroll-categories__media--placeholder) {
        order: 3;
        width: 100%;
        overflow: hidden;
        @media (width >= 48rem) {
            order: 1;
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.scroll-categories.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer", "custom.overlay"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.scroll-categories.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.font"
        },
        {
            "type": "header",
            "content": "t:sections.scroll-categories.content.section_heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "title-4xl",
                    "label": "t:settings.type_size.title_4xl"
                },
                {
                    "value": "title-3xl",
                    "label": "t:settings.type_size.title_3xl"
                },
                {
                    "value": "title-2xl",
                    "label": "t:settings.type_size.title_2xl"
                },
                {
                    "value": "title-xl",
                    "label": "t:settings.type_size.title_xl"
                },
                {
                    "value": "title-l",
                    "label": "t:settings.type_size.title_l"
                },
                {
                    "value": "title-m",
                    "label": "t:settings.type_size.title_m"
                },
                {
                    "value": "title-s",
                    "label": "t:settings.type_size.title_s"
                },
                {
                    "value": "title-xs",
                    "label": "t:settings.type_size.title_xs"
                }
            ],
            "default": "title-3xl"
        },
        {
            "type": "header",
            "content": "t:sections.scroll-categories.content.collection_title_heading"
        },
        {
            "type": "select",
            "id": "collection_heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "title-4xl",
                    "label": "t:settings.type_size.title_4xl"
                },
                {
                    "value": "title-3xl",
                    "label": "t:settings.type_size.title_3xl"
                },
                {
                    "value": "title-2xl",
                    "label": "t:settings.type_size.title_2xl"
                },
                {
                    "value": "title-xl",
                    "label": "t:settings.type_size.title_xl"
                },
                {
                    "value": "title-l",
                    "label": "t:settings.type_size.title_l"
                },
                {
                    "value": "title-m",
                    "label": "t:settings.type_size.title_m"
                },
                {
                    "value": "title-s",
                    "label": "t:settings.type_size.title_s"
                },
                {
                    "value": "title-xs",
                    "label": "t:settings.type_size.title_xs"
                }
            ],
            "default": "title-l"
        },
        {
            "type": "range",
            "id": "max_items",
            "min": 4,
            "max": 8,
            "step": 1,
            "default": 4,
            "label": "t:sections.scroll-categories.settings.maximum_items"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "t:sections.scroll-categories.settings.heading"
        },
        {
            "type": "text",
            "id": "link_label",
            "label": "t:sections.scroll-categories.settings.link_label",
            "default": "t:sections.scroll-categories.defaults.link_label"
        },
        {
            "type": "collection",
            "id": "collection",
            "label": "t:sections.scroll-categories.settings.select_collection"
        },
        {
            "type": "header",
            "content": "t:sections.scroll-categories.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.scroll-categories.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.scroll-categories.settings.padding_bottom",
            "default": 32
        }
    ],
    "presets": [
        {
            "name": "t:sections.scroll-categories.presets.scroll_categories",
            "settings": {}
        }
    ]
}
{% endschema %}
