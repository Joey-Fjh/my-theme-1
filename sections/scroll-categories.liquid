{%- liquid
    assign selected_collection = section.settings.collection
    assign max_items = section.settings.max_items
    assign scroll_categories_heading_class = section.settings.heading_size | default: 'heading-2xl'
    assign scroll_categories_row_title_class = section.settings.collection_heading_size | default: 'heading-3xl'
    assign scroll_categories_link_label_default = 'sections.scroll-categories.defaults.link_label' | t
    assign scroll_categories_link_label = section.settings.link_label | default: scroll_categories_link_label_default
    assign scroll_categories_description_words = 24

    case scroll_categories_heading_class
        when 'heading-3xl'
            assign scroll_categories_heading_tiers = 'heading-2xl pc:heading-3xl'
        when 'heading-2xl'
            assign scroll_categories_heading_tiers = 'heading-2xl pc:heading-2xl'
        when 'heading-xl'
            assign scroll_categories_heading_tiers = 'heading-xl pc:heading-xl'
        else
            assign scroll_categories_heading_tiers = 'heading-2xl pc:heading-3xl'
    endcase

    case scroll_categories_row_title_class
        when 'heading-h1'
            assign scroll_categories_row_title_tiers = 'heading-h1'
        when 'heading-h2'
            assign scroll_categories_row_title_tiers = 'heading-h2'
        else
            assign scroll_categories_row_title_tiers = 'heading-h1'
    endcase

    assign scroll_categories_item_count = 0
    for scroll_categories_product in selected_collection.products limit: max_items
        assign scroll_categories_item_count = scroll_categories_item_count | plus: 1
    endfor
    if scroll_categories_item_count == 0
        assign scroll_categories_item_count = max_items
    endif

    if scroll_categories_item_count < 10
        assign scroll_categories_count_label = scroll_categories_item_count | prepend: '0'
    else
        assign scroll_categories_count_label = scroll_categories_item_count
    endif

    if section.settings.heading != blank
        assign scroll_categories_heading_text = section.settings.heading
    elsif selected_collection != blank
        assign scroll_categories_heading_text = selected_collection.title
    else
        assign scroll_categories_heading_text = 'sections.scroll-categories.defaults.heading' | t
    endif
-%}

{%- capture scroll_categories_panel_link_content -%}
    <span class="uppercase">{{ scroll_categories_link_label }}</span>
    {%- render 'icons', icon: 'icon-arrow2', class: 'ms-2', size: 'sm' -%}
{%- endcapture -%}

{%- capture scroll_categories_children -%}
    <div
        class="scroll-categories__root flex flex-col gap-9 pc:gap-28"
        data-module-id="scroll-categories"
        data-module-lazy
        x-data="scrollCategories()"
        data-initial-active="1"
    >
        <div class="scroll-categories__header flex flex-col">
            <h2
                class="scroll-categories__heading {{ scroll_categories_heading_tiers }} flex items-end justify-between gap-6 text-theme-text"
            >
                <span>{{- scroll_categories_heading_text -}}</span>
                <span class="shrink-0">({{ scroll_categories_count_label }})</span>
            </h2>
            <hr class="scroll-categories__divider border-0" />
        </div>

        <div
            class="scroll-categories__grid flex flex-col gap-9"
            data-motion-cascade
            style="--scroll-categories-rows: {{ scroll_categories_item_count }}"
        >
            {%- for product in selected_collection.products limit: max_items -%}
                {%- liquid
                    assign scroll_categories_index_label = forloop.index
                    if forloop.index < 10
                        assign scroll_categories_index_label = forloop.index | prepend: '0'
                    endif
                    assign scroll_categories_description = product.description | strip_html | strip | truncatewords: scroll_categories_description_words
                    assign scroll_categories_image = product.featured_image
                    assign scroll_categories_image_alt = scroll_categories_image.alt | default: product.title | escape
                    assign scroll_categories_panel_aria_label = 'sections.scroll-categories.panel_link_aria' | t: product: product.title, label: scroll_categories_link_label
                    if forloop.first
                        assign scroll_categories_image_loading = 'eager'
                    else
                        assign scroll_categories_image_loading = 'lazy'
                    endif
                -%}
                <article
                    class="scroll-categories__item flex flex-col gap-10 pc:contents"
                    data-motion-bound
                >
                    <div
                        class="scroll-categories__row flex flex-col items-start gap-1 pc:flex-row pc:items-baseline pc:gap-6 scroll-categories__row--desktop-pitch{% if forloop.first %} is-active{% else %} is-inactive{% endif %}"
                        data-item-index="{{ forloop.index }}"
                        @mouseenter="onRowEnterFromEl($el)"
                        @focusin="setActiveFromEl($el)"
                        :class="rowClassFromEl($el)"
                    >
                        {%- capture scroll_categories_row_title -%}
                            <h3 class="scroll-categories__row-heading flex min-w-0 flex-1 flex-col items-start gap-1 pc:flex-row pc:items-baseline pc:gap-6 {{ scroll_categories_row_title_tiers }} text-theme-text">
                                <span class="scroll-categories__index body-xs text-theme-text">{{ scroll_categories_index_label }}</span>
                                <span class="scroll-categories__title min-w-0 flex-1">{{ product.title }}</span>
                            </h3>
                        {%- endcapture -%}
                        {%- render 'link',
                            href: product.url,
                            variant: 'plain',
                            class: 'min-w-0 flex-1',
                            content: scroll_categories_row_title
                        -%}
                    </div>

                    <div
                        class="scroll-categories__details flex flex-col gap-8 pc:gap-6{% if forloop.first %} is-active{% endif %}{% unless forloop.first %} scroll-categories__details--inactive{% endunless %}"
                        data-item-index="{{ forloop.index }}"
                        :class="detailsClassFromEl($el)"
                    >
                        <div class="scroll-categories__media order-3 w-full overflow-hidden pc:order-1">
                            {%- render 'image',
                                class: 'h-full w-full object-cover',
                                image: scroll_categories_image,
                                alt: scroll_categories_image_alt,
                                loading: scroll_categories_image_loading,
                                sizes: '(min-width: 48rem) 45vw, 100vw',
                                widths: '400,600,800,1000,1200,1600'
                            -%}
                        </div>

                        {%- if scroll_categories_description != blank -%}
                            <p class="order-1 line-clamp-3 body-2xl text-theme-text pc:order-2">{{ scroll_categories_description }}</p>
                        {%- endif -%}

                        <div class="order-2 pc:order-3">
                            {%- render 'link',
                                href: product.url,
                                variant: 'default',
                                class: 'link-with-icon-motion body-sm uppercase text-theme-text pc:body-sm self-start',
                                aria_label: scroll_categories_panel_aria_label,
                                content: scroll_categories_panel_link_content
                            -%}
                        </div>
                    </div>
                </article>
            {%- else -%}
                {%- for placeholder_index in (1..max_items) -%}
                    {%- liquid
                        assign scroll_categories_index_label = placeholder_index
                        if placeholder_index < 10
                            assign scroll_categories_index_label = placeholder_index | prepend: '0'
                        endif
                        assign product_placeholder_index = placeholder_index | minus: 1 | modulo: 6 | plus: 1
                        assign product_placeholder_key = 'product-' | append: product_placeholder_index
                        assign scroll_categories_placeholder_title = 'products.product.example_title_numbered' | t: index: placeholder_index
                        assign scroll_categories_placeholder_description = 'sections.scroll-categories.placeholder_description' | t
                        assign scroll_categories_placeholder_panel_aria_label = 'sections.scroll-categories.panel_link_aria' | t: product: scroll_categories_placeholder_title, label: scroll_categories_link_label
                        if forloop.first
                            assign scroll_categories_image_loading = 'eager'
                        else
                            assign scroll_categories_image_loading = 'lazy'
                        endif
                    -%}
                    <article
                        class="scroll-categories__item flex flex-col gap-10 pc:contents"
                        data-motion-bound
                    >
                        <div
                            class="scroll-categories__row flex flex-col items-start gap-1 pc:flex-row pc:items-baseline pc:gap-6 scroll-categories__row--desktop-pitch{% if forloop.first %} is-active{% else %} is-inactive{% endif %}"
                            data-item-index="{{ forloop.index }}"
                            @mouseenter="onRowEnterFromEl($el)"
                            @focusin="setActiveFromEl($el)"
                            :class="rowClassFromEl($el)"
                        >
                            {%- capture scroll_categories_placeholder_row_title -%}
                                <h3 class="scroll-categories__row-heading flex min-w-0 flex-1 flex-col items-start gap-1 pc:flex-row pc:items-baseline pc:gap-6 {{ scroll_categories_row_title_tiers }} text-theme-text">
                                    <span class="scroll-categories__index body-xs text-theme-text">{{ scroll_categories_index_label }}</span>
                                    <span class="scroll-categories__title min-w-0 flex-1">{{ scroll_categories_placeholder_title }}</span>
                                </h3>
                            {%- endcapture -%}
                            {%- render 'link',
                                href: routes.all_products_collection_url,
                                variant: 'plain',
                                class: 'min-w-0 flex-1',
                                content: scroll_categories_placeholder_row_title
                            -%}
                        </div>

                        <div
                            class="scroll-categories__details flex flex-col gap-8 pc:gap-6{% if forloop.first %} is-active{% endif %}{% unless forloop.first %} scroll-categories__details--inactive{% endunless %}"
                            data-item-index="{{ forloop.index }}"
                            :class="detailsClassFromEl($el)"
                        >
                            <div class="scroll-categories__media scroll-categories__media--placeholder order-3 w-full overflow-hidden pc:order-1">
                                {{ product_placeholder_key | placeholder_svg_tag: 'h-full w-full object-cover' }}
                            </div>

                            <p class="order-1 line-clamp-3 body-2xl text-theme-text pc:order-2">{{ scroll_categories_placeholder_description }}</p>

                            <div class="order-2 pc:order-3">
                                {%- render 'link',
                                    href: routes.all_products_collection_url,
                                    variant: 'default',
                                    class: 'link-with-icon-motion body-sm uppercase text-theme-text pc:body-sm self-start',
                                    aria_label: scroll_categories_placeholder_panel_aria_label,
                                    content: scroll_categories_panel_link_content
                                -%}
                            </div>
                        </div>
                    </article>
                {%- endfor -%}
            {%- endfor -%}
        </div>
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: 'scroll-categories-section',
    scheme_target: 'inner',
    surface_section: false,
    width: 'page',
    height_kind: 'content',
    motion: true,
    children: scroll_categories_children
%}

{% stylesheet %}
    .scroll-categories__heading {
        margin-block-end: 1.05em;
    }

    .scroll-categories__index,
    .scroll-categories__title {
        font-weight: 400;
    }

    @media (width >= 64rem) {
        .scroll-categories__index {
            flex: 0 0 36%;
            white-space: nowrap;
            font-size: 1em;
            line-height: inherit;
        }
    }

    .scroll-categories__divider {
        height: 1px;
        background-color: rgb(var(--color-foreground));

        @supports (background-color: color-mix(in oklab, white, black)) {
            background-color: color-mix(in oklab, rgb(var(--color-foreground)) 15%, transparent);
        }
    }

    .scroll-categories__row {
        transition: opacity var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease);
        opacity: 1;
    }

    @media (width < 64rem) {
        .scroll-categories__row.is-inactive,
        .scroll-categories__row.is-active {
            opacity: 1;
        }
    }

    .scroll-categories__details {
        transition:
            opacity var(--motion-duration-base, 300ms) var(--motion-ease-exit, ease-out),
            visibility 0s linear var(--motion-duration-base, 300ms);
    }

    .scroll-categories__media,
    .scroll-categories__media--placeholder {
        aspect-ratio: 1 / 1;
        border-radius: var(--radius-xl, 1rem);
    }

    @media (width >= 64rem) {
        .scroll-categories__heading {
            margin-block-end: 1.05em;
        }

        .scroll-categories__title {
            white-space: nowrap;
        }

        .scroll-categories__row-heading {
            font-size: calc(var(--font-heading-scale) * 4rem);
        }

        .scroll-categories__row--desktop-pitch {
            padding-block: 0.45em;
        }

        .scroll-categories__grid {
            display: grid;
            grid-template-columns: minmax(0, 62.6%) minmax(0, 37.4%);
            grid-template-rows: repeat(var(--scroll-categories-rows, 1), auto);
            column-gap: 2.5rem;
            row-gap: 0;
        }

        .scroll-categories__row {
            grid-column: 1;
        }

        .scroll-categories__details {
            grid-column: 2;
            grid-row: 1 / -1;
            align-self: start;
            transition:
                opacity var(--motion-duration-base, 300ms) var(--motion-ease-exit, ease-out),
                visibility 0s;
        }

        .scroll-categories__row.is-inactive {
            opacity: 0.3;
        }

        .scroll-categories__row.is-active {
            opacity: 1;
        }

        .scroll-categories__media,
        .scroll-categories__media--placeholder {
            aspect-ratio: 513 / 371;
        }

        .scroll-categories__details:not(.is-active) {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition:
                opacity var(--motion-duration-base, 300ms) var(--motion-ease-exit, ease-out),
                visibility 0s linear var(--motion-duration-base, 300ms);
        }

        .scroll-categories__details.is-active {
            opacity: 1;
            visibility: visible;
        }
    }

    .scroll-categories__media--placeholder {
        border: 1px solid rgba(var(--color-foreground), 0.12);
        background-color: rgb(var(--color-background));

        @supports (background-color: color-mix(in oklab, white, black)) {
            background-color: color-mix(
                in oklab,
                rgb(var(--color-background)) 95%,
                rgb(var(--color-foreground)) 5%
            );
        }
    }

    .scroll-categories__media--placeholder svg {
        width: 100%;
        height: 100%;
        display: block;
    }

    @media (prefers-reduced-motion: reduce) {
        .scroll-categories__row,
        .scroll-categories__details {
            transition: none;
        }
    }
{% endstylesheet %}

