<footer
    data-section-id="{{ section.id }}"
    class="footer-section full-width relative color-{{ section.settings.color_scheme }}"
    x-data="motionRevealSection()"
    data-motion-section
>
    {%- if section.settings.bg_image -%}
        {% render 'image',
            class: '!absolute inset-0',
            image: section.settings.bg_image,
            alt: section.settings.bg_image.alt,
            width: section.settings.bg_image.width
        %}
    {%- endif -%}

    <div class="container-page">
        <div class="relative overflow-hidden p-12">
            {% comment %} Top Content Area {% endcomment %}
            <div
                class="z-10 flex flex-col gap-12 pc:mb-24 pc:flex-row pc:justify-between"
                data-motion-reveal="content"
            >
                {%- comment -%} Navigation Link Columns {%- endcomment -%}
                <div class="grid grid-cols-3 gap-x-4 gap-y-10 pc:flex pc:gap-20 fw:gap-28">
                    {% for block in section.blocks %}
                        {% if block.type == 'link_column' %}
                            <div {{ block.shopify_attributes }}>
                                <h2 class="mb-6 pc:mb-10">
                                    {{ block.settings.heading }}
                                </h2>
                                <ul class="flex flex-col gap-3">
                                    {% assign links_menu = block.settings.menu %}
                                    {% if links_menu != blank %}
                                        {% for link in linklists[links_menu].links %}
                                            <li>
                                                {% render 'link',
                                                    text: link.title,
                                                    variant: 'underline',
                                                    href: link.url
                                                %}
                                            </li>
                                        {% endfor %}
                                    {% else %}
                                        {% assign fallback_links = block.settings.heading
                                            | downcase
                                        %}
                                        {% for i in (1..4) %}
                                            <li>
                                                {%- assign link_text = 'Link ' | append: i -%}
                                                {% render 'link',
                                                    text: link_text,
                                                    variant: 'underline',
                                                    href: '#'
                                                %}
                                            </li>
                                        {% endfor %}
                                    {% endif %}
                                </ul>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>

                {%- comment -%} Right Content Block {%- endcomment -%}
                <div class="flex max-w-3xl flex-col gap-8 pc:gap-12">
                    {% if section.settings.content_heading != blank %}
                        <h3>
                            {{ section.settings.content_heading }}
                        </h3>
                    {% endif %}
                    {% if section.settings.content_text != blank %}
                        <div class="rte rte--compact body-lg">
                            {{ section.settings.content_text }}
                        </div>
                    {% endif %}
                    {% if section.settings.content_link != blank %}
                        {%- capture link_content -%}
                            <span>{{ section.settings.content_link_text }}</span>
                            {% render 'icons', icon: 'icon-arrow2', class: 'ms-3' %}
                        {%- endcapture -%}

                        {%- render 'link',
                            href: section.settings.content_link,
                            content: link_content,
                            class: 'body-lg',
                            variant: 'underline'
                        -%}
                    {% endif %}
                    {% if section.settings.enable_follow_on_shop
                        and shop.features.follow_on_shop?
                    %}
                        <div class="flex flex-col gap-3">
                            <p>{{ 'footer.follow_on_shop' | t }}</p>
                            <div>
                                {{ shop | login_button: action: 'follow' }}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

            {%- comment -%} Large Brand Name with Brush Texture {%- endcomment -%}
            <div
                class="z-0 mb-8 select-none pc:mb-12"
                data-motion-reveal="content"
            >
                {%- comment -%} Brush stroke decoration {%- endcomment -%}
                {% if section.settings.brush_image != blank %}
                    <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
                        {% render 'image',
                            class: '!h-fit mix-blend-lighten',
                            image: section.settings.brush_image,
                            alt: section.settings.brush_image.alt,
                            width: section.settings.brush_image.width,
                            mode: 'natural',
                            fit: 'contain'
                        %}
                    </div>

                    {% render 'watermark',
                        text: section.settings.brand_name,
                        container_class: 'relative z-10 w-full',
                        svg_class: 'mx-auto',
                        text_class: ''
                    %}
                {% endif %}
            </div>

            {%- comment -%} Bottom Bar {%- endcomment -%}
            <div
                class="z-10 grid grid-cols-2 gap-y-8 border-t border-theme-border-50 pt-6 pc:flex pc:flex-row pc:items-center pc:justify-between"
            >
                {%- liquid
                    assign footer_location = section.settings.location
                    if footer_location == blank
                        assign footer_location = 'footer.default_location' | t
                    endif
                -%}
                <span class="col-span-1 pc:order-first">
                    {{ footer_location }}
                </span>
                <span class="col-span-1 text-end pc:order-0 pc:text-center">
                    {%- liquid
                        assign copyright_brand = section.settings.brand_name | strip_html
                        if copyright_brand == blank
                            assign copyright_brand = 'footer.default_brand_name' | t
                        endif
                        assign copyright_brand = copyright_brand | escape
                    -%}
                    {{ 'now' | date: '%Y' }}
                    {{ copyright_brand }}
                    {{ 'footer.all_rights_reserved' | t }}
                </span>
                <button
                    type="button"
                    @click="window.scrollTo({ top: 0, behavior: 'smooth' })"
                    class="footer__back-to-top col-span-2 pc:order-last pc:col-span-1"
                >
                    <span>{{ 'footer.back_to_top' | t }}</span>
                    {%- render 'icons', icon: 'icon-chevron-up' -%}
                </button>
            </div>
        </div>
    </div>
</footer>

{% stylesheet %}
    .footer__back-to-top {
        display: flex;
        cursor: pointer;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
        opacity: 0.5;
        transition: opacity var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease);
    }

    .footer__back-to-top:hover {
        opacity: 1;
    }

    .footer__back-to-top:focus-visible {
        outline: var(--focus-ring-width) solid
            rgba(var(--color-focus-ring), var(--focus-ring-opacity, 0.4));
        outline-offset: var(--focus-ring-offset);
    }

    @media (min-width: 48rem) {
        .footer__back-to-top {
            justify-content: flex-end;
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:general.footer",
    "tag": "section",
    "class": "section footer",
    "limit": 1,
    "enabled_on": {
        "groups": ["footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.footer.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "image_picker",
            "id": "bg_image",
            "label": "t:sections.footer.settings.background_image"
        },
        {
            "type": "header",
            "content": "t:sections.footer.content.brand"
        },
        {
            "type": "inline_richtext",
            "id": "brand_name",
            "label": "t:sections.footer.settings.brand_name",
            "default": "t:sections.footer.defaults.brand_name"
        },
        {
            "type": "image_picker",
            "id": "brush_image",
            "label": "t:sections.footer.settings.brush_texture_image"
        },
        {
            "type": "inline_richtext",
            "id": "location",
            "label": "t:sections.footer.settings.location_text",
            "default": "t:sections.footer.defaults.location"
        },
        {
            "type": "header",
            "content": "t:sections.footer.content.right_content"
        },
        {
            "type": "inline_richtext",
            "id": "content_heading",
            "label": "t:sections.footer.settings.heading",
            "default": "t:sections.footer.defaults.content_heading"
        },
        {
            "type": "richtext",
            "id": "content_text",
            "label": "t:sections.footer.settings.description",
            "default": "t:sections.footer.defaults.content_text"
        },
        {
            "type": "url",
            "id": "content_link",
            "label": "t:sections.footer.settings.link"
        },
        {
            "type": "text",
            "id": "content_link_text",
            "label": "t:sections.footer.settings.link_text",
            "default": "t:sections.footer.defaults.content_link_text"
        },
        {
            "type": "header",
            "content": "t:sections.footer.content.follow_on_shop"
        },
        {
            "type": "checkbox",
            "id": "enable_follow_on_shop",
            "label": "t:sections.footer.settings.enable_follow_on_shop_button",
            "default": true
        }
    ],
    "blocks": [
        {
            "type": "link_column",
            "name": "t:sections.footer.blocks.link_column",
            "settings": [
                {
                    "type": "inline_richtext",
                    "id": "heading",
                    "label": "t:sections.footer.block_settings.column_heading",
                    "default": "t:sections.footer.defaults.link_column_heading"
                },
                {
                    "type": "link_list",
                    "id": "menu",
                    "label": "t:sections.footer.block_settings.menu"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.footer.presets.footer",
            "blocks": [
                {
                    "type": "link_column",
                    "settings": {
                        "heading": "Catalog"
                    }
                },
                {
                    "type": "link_column",
                    "settings": {
                        "heading": "Pages"
                    }
                },
                {
                    "type": "link_column",
                    "settings": {
                        "heading": "Social"
                    }
                }
            ]
        }
    ]
}
{% endschema %}
