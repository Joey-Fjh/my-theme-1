<footer
    data-section-id="{{ section.id }}"
    class="
        footer-section full-width relative
        color-{{ section.settings.color_scheme }}
    "
    x-data="
        {
          visible:false,
          scrollToTop() {
            window.scrollTo({
              top: 0,
              behavior: 'smooth'
            })
          }
        }
    "
    x-intersect:enter.once="visible = true"
>
    {%- if section.settings.bg_image -%}
        {% render 'image',
            class: '!absolute inset-0',
            image: section.settings.bg_image,
            alt: section.settings.bg_image.alt,
            width: section.settings.bg_image.width
        %}
    {%- endif -%}

    <div class="container-page">
        <div class="relative overflow-hidden p-12">
            {% comment %} Top Content Area {% endcomment %}
            <div
                class="z-10 flex flex-col gap-12 transition-all duration-700 ease-out pc:mb-24 pc:flex-row pc:justify-between"
                :class="visible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-6'"
            >
                {%- comment -%} Navigation Link Columns {%- endcomment -%}
                <div class="grid grid-cols-3 gap-x-4 gap-y-10 pc:flex pc:gap-20 fw:gap-28">
                    {% for block in section.blocks %}
                        {% if block.type == 'link_column' %}
                            <div {{ block.shopify_attributes }}>
                                <h2 class="mb-6 body-lg font-medium tracking-wider pc:mb-10">
                                    {{ block.settings.heading }}
                                </h2>
                                <ul class="flex flex-col gap-3">
                                    {% assign links_menu = block.settings.menu %}
                                    {% if links_menu != blank %}
                                        {% for link in linklists[links_menu].links %}
                                            <li>
                                                {% render 'link',
                                                    text: link.title,
                                                    class: 'body-md',
                                                    color: 'current',
                                                    variant: 'underline',
                                                    href: link.url
                                                %}
                                            </li>
                                        {% endfor %}
                                    {% else %}
                                        {% assign fallback_links = block.settings.heading
                                            | downcase
                                        %}
                                        {% for i in (1..4) %}
                                            <li>
                                                {%
                                                    render 'link',
                                                    text: 'Link ' | append: i,
                                                    class: 'body-md',
                                                    color: 'current',
                                                    variant: 'underline',
                                                    href: '#'
                                                %}
                                            </li>
                                        {% endfor %}
                                    {% endif %}
                                </ul>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>

                {%- comment -%} Right Content Block {%- endcomment -%}
                <div class="flex max-w-2xl flex-col gap-8 pc:gap-12">
                    {% if section.settings.content_heading != blank %}
                        <h3 class="body-lg font-medium">
                            {{ section.settings.content_heading }}
                        </h3>
                    {% endif %}
                    {% if section.settings.content_text != blank %}
                        <div class="rte rte--compact body-lg leading-relaxed">
                            {{ section.settings.content_text }}
                        </div>
                    {% endif %}
                    {% if section.settings.content_link != blank %}
                        {%- capture link_content -%}
                            <span>{{ section.settings.content_link_text }}</span>
                            {% render 'icons', icon: 'icon-arrow2', size: 'lg', class: 'ml-3', color: 'current' %}
                        {%- endcapture -%}

                        {%- render 'link',
                            href: section.settings.content_link,
                            content: link_content,
                            class: 'body-lg',
                            color: 'current',
                            variant: 'underline'
                        -%}
                    {% endif %}
                    {% if section.settings.enable_follow_on_shop
                        and shop.features.follow_on_shop?
                    %}
                        <div class="flex flex-col gap-3">
                            <p class="body-md opacity-60">{{ 'footer.follow_on_shop' | t }}</p>
                            <div>
                                {{ shop | login_button: action: 'follow' }}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

            {%- comment -%} Large Brand Name with Brush Texture {%- endcomment -%}
            <div
                class="transtion-all z-0 mb-8 delay-300 duration-1000 ease-out select-none pc:mb-12"
                :class="visible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-10'"
            >
                {%- comment -%} Brush stroke decoration {%- endcomment -%}
                {% if section.settings.brush_image != blank %}
                    <div class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-20">
                        {% render 'image',
                            class: '!h-fit object-contain mix-blend-lighten',
                            image: section.settings.brush_image,
                            alt: section.settings.brush_image.alt,
                            width: section.settings.brush_image.width
                        %}
                    </div>

                    {% render 'watermark',
                        text: section.settings.brand_name,
                        container_class: 'relative z-10 w-full',
                        svg_class: 'mx-auto',
                        text_class: 'font-bold'
                    %}
                {% endif %}
            </div>

            {%- comment -%} Bottom Bar {%- endcomment -%}
            <div
                class="
                    z-10 grid grid-cols-2 gap-y-8 border-t border-theme-border-soft pt-6
                    transition-all delay-500 duration-700 ease-out pc:flex pc:flex-row pc:items-center pc:justify-between
                "
                :class="visible ? 'opacity-100' : 'opacity-0'"
            >
                <span class="col-span-1 body-sm opacity-60 pc:order-first">
                    {{ section.settings.location | default: 'Shibuya, JP' }}
                </span>
                <span class="col-span-1 text-right body-sm opacity-60 pc:order-0 pc:text-center">
                    {{ 'now' | date: '%Y' }}©
                    {{ section.settings.brand_name | default: 'Eccenova' }}® {{ 'footer.all_rights_reserved' | t }}
                </span>
                <button
                    type="button"
                    @click="scrollToTop()"
                    class="col-span-2 flex cursor-pointer items-center justify-center gap-1 body-sm opacity-60 transition-opacity hover:opacity-100 pc:order-last pc:col-span-1 pc:justify-end"
                >
                    <span>{{ 'footer.back_to_top' | t }}</span>
                    <svg
                        class="h-4 w-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</footer>

{% schema %}
{
    "name": "t:general.footer",
    "tag": "section",
    "class": "section footer",
    "limit": 1,
    "enabled_on": {
        "groups": [
            "footer"
        ]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.footer.settings.color_scheme",
            "default": "color-scheme-1"
        },
        {
            "type": "image_picker",
            "id": "bg_image",
            "label": "t:sections.footer.settings.background_image"
        },
        {
            "type": "header",
            "content": "t:sections.footer.content.brand"
        },
        {
            "type": "inline_richtext",
            "id": "brand_name",
            "label": "t:sections.footer.settings.brand_name",
            "default": "Eccenova"
        },
        {
            "type": "image_picker",
            "id": "brush_image",
            "label": "t:sections.footer.settings.brush_texture_image"
        },
        {
            "type": "inline_richtext",
            "id": "location",
            "label": "t:sections.footer.settings.location_text",
            "default": "Shibuya, JP"
        },
        {
            "type": "header",
            "content": "t:sections.footer.content.right_content"
        },
        {
            "type": "inline_richtext",
            "id": "content_heading",
            "label": "t:sections.footer.settings.heading",
            "default": "#1 China Cosmetic Products"
        },
        {
            "type": "richtext",
            "id": "content_text",
            "label": "t:sections.footer.settings.description",
            "default": "<p>Personalized with AI insight. Personalized with AI insight. Personalized with AI insight.</p>"
        },
        {
            "type": "url",
            "id": "content_link",
            "label": "t:sections.footer.settings.link"
        },
        {
            "type": "text",
            "id": "content_link_text",
            "label": "t:sections.footer.settings.link_text",
            "default": "See Our New Product"
        },
        {
            "type": "header",
            "content": "t:sections.footer.content.follow_on_shop"
        },
        {
            "type": "checkbox",
            "id": "enable_follow_on_shop",
            "label": "t:sections.footer.settings.enable_follow_on_shop_button",
            "default": true
        }
    ],
    "blocks": [
        {
            "type": "link_column",
            "name": "t:sections.footer.blocks.link_column",
            "settings": [
                {
                    "type": "inline_richtext",
                    "id": "heading",
                    "label": "t:sections.footer.block_settings.column_heading",
                    "default": "Catalog"
                },
                {
                    "type": "link_list",
                    "id": "menu",
                    "label": "t:sections.footer.block_settings.menu"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.footer.presets.footer",
            "blocks": [
                {
                    "type": "link_column",
                    "settings": {
                        "heading": "Catalog"
                    }
                },
                {
                    "type": "link_column",
                    "settings": {
                        "heading": "Pages"
                    }
                },
                {
                    "type": "link_column",
                    "settings": {
                        "heading": "Social"
                    }
                }
            ]
        }
    ]
}
    {% endschema %}
