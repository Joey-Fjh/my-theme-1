{%- liquid
    assign brand_statement_heading_class = section.settings.heading_size | default: 'title-2xl'
-%}
{%- capture brand_statement_background -%}
    {%- comment -%}
        Decorative brushstroke is a true background layer: absolute inset-0 so it never
        owns height. Section height comes only from statement copy + section padding.
        Do not use max-pc:h-full + natural image — that vertically centers a fixed-aspect
        band on mobile and lets text overflow above/below the media.
    {%- endcomment -%}
    <div
        class="
            pointer-events-none absolute inset-0
            {% if section.settings.brushstroke_image == blank %}media-placeholder-frame{% endif %}
        "
        aria-hidden="true"
    >
        {%- if section.settings.brushstroke_image != blank -%}
            {%- render 'image',
                image: section.settings.brushstroke_image,
                alt: '',
                width: section.settings.brushstroke_image.width,
                widths: '750,1100,1500,2000',
                sizes: '100vw',
                mode: 'frame',
                fit: 'cover',
                position: 'center',
                wrapper_class: '!absolute inset-0 h-full w-full',
                img_class: 'h-full w-full object-cover',
            -%}
        {%- else -%}
            {%- render 'image',
                image: blank,
                alt: '',
                placeholder_key: 'image',
                placeholder_style: 'plain',
                mode: 'frame',
                fit: 'cover',
                wrapper_class: '!absolute inset-0 h-full w-full',
                img_class: 'h-full w-full object-cover opacity-50',
            -%}
        {%- endif -%}
    </div>
{%- endcapture -%}
{%- capture brand_statement_children -%}
    <div class="relative flex items-center justify-center py-8">
        {% render 'text',
            tier: brand_statement_heading_class,
            element: 'div',
            rte: true,
            align: 'center',
            class: 'text-balance pc:max-w-5/6',
            content: section.settings.statement
        %}
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: 'brand-statement-section',
    width: 'page',
    height_kind: 'content',
    motion: false,
    background: brand_statement_background,
    children: brand_statement_children
%}

{% schema %}
{
    "name": "t:sections.brand-statement.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer", "custom.overlay"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.brand-statement.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "richtext",
            "id": "statement",
            "default": "t:sections.brand-statement.defaults.statement",
            "label": "t:sections.brand-statement.settings.statement_text"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "title-4xl",
                    "label": "t:settings.type_size.title_4xl"
                },
                {
                    "value": "title-3xl",
                    "label": "t:settings.type_size.title_3xl"
                },
                {
                    "value": "title-2xl",
                    "label": "t:settings.type_size.title_2xl"
                },
                {
                    "value": "title-xl",
                    "label": "t:settings.type_size.title_xl"
                },
                {
                    "value": "title-l",
                    "label": "t:settings.type_size.title_l"
                },
                {
                    "value": "title-m",
                    "label": "t:settings.type_size.title_m"
                },
                {
                    "value": "title-s",
                    "label": "t:settings.type_size.title_s"
                },
                {
                    "value": "title-xs",
                    "label": "t:settings.type_size.title_xs"
                }
            ],
            "default": "title-2xl"
        },
        {
            "type": "image_picker",
            "id": "brushstroke_image",
            "label": "t:sections.brand-statement.settings.brushstroke_decoration_image"
        },
        {
            "type": "header",
            "content": "t:sections.brand-statement.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.brand-statement.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.brand-statement.settings.padding_bottom",
            "default": 32
        }
    ],
    "presets": [
        {
            "name": "t:sections.brand-statement.presets.brand_statement",
            "settings": {}
        }
    ]
}
{% endschema %}
