<div
    data-section-id="{{ section.id }}"
    class="brand-statement-section full-width relative overflow-hidden color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="motionRevealSection()"
    data-motion-section
>
    {%- liquid
        assign brand_statement_heading_class = section.settings.heading_size | default: 'heading-2xl'
    -%}
    {%- comment -%}
        Decorative brushstroke is a true background layer: absolute inset-0 so it never
        owns height. Section height comes only from statement copy + section padding.
        Do not use max-pc:h-full + natural image — that vertically centers a fixed-aspect
        band on mobile and lets text overflow above/below the media.
    {%- endcomment -%}
    <div
        class="
            pointer-events-none absolute inset-0 z-0
            {% if section.settings.brushstroke_image == blank %}media-placeholder-frame{% endif %}
        "
        aria-hidden="true"
    >
        {%- if section.settings.brushstroke_image != blank -%}
            {%- render 'image',
                image: section.settings.brushstroke_image,
                alt: '',
                width: section.settings.brushstroke_image.width,
                widths: '750,1100,1500,2000',
                sizes: '100vw',
                mode: 'frame',
                fit: 'cover',
                position: 'center',
                wrapper_class: '!absolute inset-0 h-full w-full',
                img_class: 'h-full w-full object-cover',
                motion_reveal: false
            -%}
        {%- else -%}
            {%- render 'image',
                image: blank,
                alt: '',
                placeholder_key: 'image',
                placeholder_style: 'plain',
                mode: 'frame',
                fit: 'cover',
                wrapper_class: '!absolute inset-0 h-full w-full',
                img_class: 'h-full w-full object-cover opacity-50',
                motion_reveal: false
            -%}
        {%- endif -%}
    </div>

    <div class="layout container-page relative z-10">
        {% comment %} Statement text — height owner {% endcomment %}
        <div class="mx-auto flex items-center justify-center py-8">
            <div
                class="rte rte--compact {{ brand_statement_heading_class }} text-center text-balance pc:max-w-5/6"
                data-motion-reveal="content"
            >
                {{ section.settings.statement }}
            </div>
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:sections.brand-statement.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer", "custom.overlay"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.brand-statement.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "richtext",
            "id": "statement",
            "default": "t:sections.brand-statement.defaults.statement",
            "label": "t:sections.brand-statement.settings.statement_text"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "heading-4xl",
                    "label": "t:sections.slides-show.options.heading_4xl"
                },
                {
                    "value": "heading-3xl",
                    "label": "t:sections.slides-show.options.heading_3xl"
                },
                {
                    "value": "heading-2xl",
                    "label": "t:sections.slides-show.options.heading_2xl"
                },
                {
                    "value": "heading-xl",
                    "label": "t:sections.slides-show.options.heading_xl"
                },
                {
                    "value": "heading-h1",
                    "label": "t:sections.slides-show.options.heading_h1"
                },
                {
                    "value": "heading-h2",
                    "label": "t:sections.slides-show.options.heading_h2"
                },
                {
                    "value": "heading-h3",
                    "label": "t:sections.slides-show.options.heading_h3"
                },
                {
                    "value": "heading-h4",
                    "label": "t:sections.slides-show.options.heading_h4"
                },
                {
                    "value": "heading-h5",
                    "label": "t:sections.slides-show.options.heading_h5"
                },
                {
                    "value": "heading-h6",
                    "label": "t:sections.slides-show.options.heading_h6"
                }
            ],
            "default": "heading-2xl"
        },
        {
            "type": "image_picker",
            "id": "brushstroke_image",
            "label": "t:sections.brand-statement.settings.brushstroke_decoration_image"
        },
        {
            "type": "header",
            "content": "t:sections.brand-statement.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.brand-statement.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.brand-statement.settings.padding_bottom",
            "default": 32
        }
    ],
    "presets": [
        {
            "name": "t:sections.brand-statement.presets.brand_statement",
            "settings": {}
        }
    ]
}
{% endschema %}
