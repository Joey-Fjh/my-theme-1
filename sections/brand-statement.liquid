<div
    data-section-id="{{ section.id }}"
    class="brand-statement-section full-width relative overflow-hidden color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="brand-statement"
    data-component-id="{{ section.id }}"
>
    {% comment %} Decorative brushstroke {% endcomment %}
    <div
        class="pointer-events-none absolute inset-x-0 bottom-0 z-0 flex translate-y-6 justify-center opacity-0 max-pc:h-full"
        data-gsap-brush
    >
        {%- if section.settings.brushstroke_image != blank -%}
            {%- assign brushstroke_alt_fallback = 'sections.brand-statement.defaults.image_alt'
                | t
            -%}
            {%- assign image_alt = section.settings.brushstroke_image.image_alt
                | default: brushstroke_alt_fallback
                | escape
            -%}
            {%- render 'image',
                image: section.settings.brushstroke_image,
                alt: image_alt,
                width: section.settings.brushstroke_image.width,
                class: 'max-w-none w-full',
                img_class: 'h-full pc:h-auto w-full pc:object-contain object-center'
            -%}
        {%- endif -%}
    </div>

    <div class="layout container-page relative z-10">
        {% comment %} Statement Text {% endcomment %}
        <div class="mx-auto flex min-h-96 items-center justify-center py-8 pc:min-h-120 pc:py-0">
            <div
                class="rte rte--compact translate-y-4 text-center body-lg text-balance opacity-0 pc:max-w-5/6 pc:body-xl"
                data-gsap-text
            >
                {{ section.settings.statement }}
            </div>
        </div>
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components) return;

        Components.register(
            'brand-statement',
            {
                init(el) {
                    const brush = el.querySelector('[data-gsap-brush]');
                    const text = el.querySelector('[data-gsap-text]');
                    if (!brush || !text) return;

                    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
                        brush.classList.remove('translate-y-6', 'opacity-0');
                        text.classList.remove('translate-y-4', 'opacity-0');
                        return;
                    }

                    gsap.registerPlugin(ScrollTrigger);

                    const ctx = gsap.context(() => {
                        const tl = gsap.timeline({
                            scrollTrigger: {
                                trigger: el,
                                start: 'top 80%',
                                once: true,
                            },
                            defaults: { ease: 'power2.out' },
                        });

                        gsap.set(brush, { y: 24, opacity: 0 });
                        gsap.set(text, { y: 16, opacity: 0 });

                        tl.to(brush, {
                            opacity: 1,
                            y: 0,
                            duration: 0.8,
                        });

                        tl.to(
                            text,
                            {
                                opacity: 1,
                                y: 0,
                                duration: 0.9,
                            },
                            '-=0.35',
                        );
                    }, el);

                    return { ctx };
                },

                destroy(el, state) {
                    if (state?.ctx) {
                        state.ctx.revert();
                    }
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{% schema %}
{
    "name": "t:sections.brand-statement.name",
    "tag": "section",
    "class": "section",
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.brand-statement.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "richtext",
            "id": "statement",
            "default": "t:sections.brand-statement.defaults.statement",
            "label": "t:sections.brand-statement.settings.statement_text"
        },
        {
            "type": "image_picker",
            "id": "brushstroke_image",
            "label": "t:sections.brand-statement.settings.brushstroke_decoration_image"
        },
        {
            "type": "header",
            "content": "t:sections.brand-statement.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.brand-statement.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.brand-statement.settings.padding_bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "t:sections.brand-statement.presets.brand_statement",
            "settings": {}
        }
    ]
}
{% endschema %}
