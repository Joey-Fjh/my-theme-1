{%- capture password_footer_children -%}
    <div class="flex flex-col items-center gap-6 border-t border-line pt-6 text-center">
        {%- if section.settings.show_social -%}
            {%- render 'social-icons', class: 'justify-center' -%}
        {%- endif -%}

        <div class="flex flex-col items-center gap-2 body-xs">
            <span>{{ powered_by_link }}</span>
            <span>
                {{ 'password.store_owner' | t }}
                <a class="links-default links" href="/admin">
                    {{ 'password.log_in' | t }}
                </a>
            </span>
        </div>
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    element: 'footer',
    section_class: 'password-footer-section',
    width: 'page',
    height_kind: 'content',
    surface_section: false,
    children: password_footer_children
%}

{% schema %}
{
    "name": "t:sections.password_footer.name",
    "tag": "section",
    "class": "section",
    "limit": 1,
    "enabled_on": {
        "templates": ["password"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.password_footer.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "checkbox",
            "id": "show_social",
            "label": "t:sections.password_footer.settings.show_social",
            "default": true
        },
        {
            "type": "header",
            "content": "t:sections.password_footer.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.password_footer.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.password_footer.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
