<div
    data-section-id="{{ section.id }}"
    class="slides-show-section full-width h-screen color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="slides-show"
    data-component-id="{{ section.id }}"
    x-data="motionRevealSection()"
    data-motion-section
    data-motion-media="static"
>
    {%- liquid
        assign slides_show_sr_only_title = shop.name
        assign slides_show_first_block = section.blocks.first
        if slides_show_first_block.settings.headline != blank
            assign slides_show_sr_only_title = slides_show_first_block.settings.headline
        endif
        assign slides_show_multi_slide = false
        if section.blocks.size > 1
            assign slides_show_multi_slide = true
        endif

        assign slides_show_heading_class = section.settings.heading_size | default: 'heading-3xl'
        assign slides_show_subtitle_size = section.settings.subtitle_size | default: 'body-3xl'
        assign slides_show_subtitle_class = 'typo-subtitle ' | append: slides_show_subtitle_size
    -%}
    <div
        class="swiper h-full w-full focus-ring"
        role="region"
        aria-label="{{ 'accessibility.hero_slides' | t }}"
        aria-roledescription="{{ 'accessibility.carousel' | t }}"
        {% if slides_show_multi_slide %}
            tabindex="0"
            aria-keyshortcuts="ArrowLeft ArrowRight"
        {% endif %}
    >
        {%- if slides_show_multi_slide -%}
            <h1 class="sr-only">{{ slides_show_sr_only_title }}</h1>
        {%- endif -%}
        <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
                <div class="swiper-slide" {{ block.shopify_attributes }}>
                    {%- capture sizes -%}
                        (min-width: 80rem) 100vw, (min-width: 48rem) 1280px, 100vw
                    {%- endcapture -%}

                    {%- capture widths -%}
                        400,480,768,1280,1536,2400,2560
                    {%- endcapture -%}

                    {%- assign image_loading = 'lazy' -%}
                    {%- assign image_fetchpriority = 'auto' -%}
                    {%- if forloop.first -%}
                        {%- assign image_loading = 'eager' -%}
                        {%- assign image_fetchpriority = 'high' -%}
                    {%- endif -%}

                    {%- assign image_alt = block.settings.slide_image.alt
                        | default: shop.name
                        | escape
                    -%}
                    {%- render 'image',
                        image: block.settings.slide_image,
                        alt: image_alt,
                        width: block.settings.slide_image.width,
                        sizes: sizes,
                        widths: widths,
                        loading: image_loading,
                        fetchpriority: image_fetchpriority,
                        placeholder_style: 'plain',
                        motion_reveal: false
                    -%}

                    <div class="layout layout-safe-top container-page absolute inset-0">
                        <div class="slides-show__content-grid grid h-full min-h-0 grid-cols-1 grid-rows-3 text-theme-text/80 pc:grid-cols-3">
                            <div
                                class="slides-show__caption-content {{ block.settings.caption_position }} flex h-full min-h-0 w-full flex-col justify-around gap-4"
                                {% if forloop.first %}
                                    data-motion-reveal="content"
                                    data-motion-hero-copy
                                    data-motion-index="0"
                                {% endif %}
                            >
                                <p class="body-3xl">
                                    {{ block.settings.year }}
                                </p>

                                <div class="rte rte--compact mt-2 {{ slides_show_subtitle_class }}">
                                    {{ block.settings.description }}
                                </div>

                                {%- if block.settings.cta_text != blank
                                    and block.settings.cta_link != blank
                                -%}
                                    {%- liquid
                                        assign cta_href = block.settings.cta_link
                                        if cta_href == '/collections'
                                            assign cta_href = routes.collections_url
                                        endif
                                    -%}
                                    {%- capture link_content -%}
                                        <span>{{ block.settings.cta_text }}</span>
                                        {% render 'icons', icon: 'icon-arrow2', class: 'ms-3' %}
                                    {%- endcapture -%}

                                    {%- if block.settings.cta_style == 'button' -%}
                                        {%- render 'link',
                                            href: cta_href,
                                            variant: 'plain',
                                            class: 'btn-primary w-fit max-w-full',
                                            content: link_content
                                        -%}
                                    {%- else -%}
                                        {%- render 'link',
                                            href: cta_href,
                                            variant: 'underline',
                                            class: 'body-2xl text-theme-text',
                                            content: link_content
                                        -%}
                                    {%- endif -%}
                                {%- endif -%}
                            </div>

                            <div
                                class="slides-show__headline-content {{ block.settings.heading_position }} flex h-full min-h-0 w-full items-center"
                                {% if forloop.first %}
                                    data-motion-reveal="content"
                                    data-motion-hero-copy
                                    data-motion-index="1"
                                {% endif %}
                            >
                                {%- if slides_show_multi_slide -%}
                                    <h2 class="{{ slides_show_heading_class }}">
                                        {{ block.settings.headline }}
                                    </h2>
                                {%- else -%}
                                    <h1 class="{{ slides_show_heading_class }}">
                                        {{ block.settings.headline }}
                                    </h1>
                                {%- endif -%}
                            </div>

                            <div
                                class="slides-show__meta-content {{ block.settings.meta_position }} flex h-full min-h-0 w-full flex-col justify-around pc:items-center"
                                {% if forloop.first %}
                                    data-motion-reveal="content"
                                    data-motion-hero-copy
                                    data-motion-index="2"
                                {% endif %}
                            >
                                <div>{{ block.settings.meta_text }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            {%- endfor -%}
        </div>
    </div>
</div>

{% javascript %}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components) return;

        Components.register(
            'slides-show',
            {
                init(el) {
                    const slides = el.querySelectorAll('.swiper-slide');
                    const swiperContainer = el.querySelector('.swiper');
                    const cleanups = [];

                    if (!swiperContainer || typeof Swiper === 'undefined' || slides.length <= 1) {
                        return { swiper: null, cleanups };
                    }

                    const swiper = new Swiper(swiperContainer, {
                        loop: slides.length > 1,
                        autoplay: false,
                        slidesPerView: 1,
                        effect: 'fade',
                        fadeEffect: {
                            crossFade: true,
                        },
                        pagination: false,
                        navigation: false,
                    });

                    function syncSlideAriaHidden() {
                        swiperContainer.querySelectorAll('.swiper-slide').forEach(function (slide) {
                            const isActive = slide.classList.contains('swiper-slide-active');
                            slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
                            if (isActive) {
                                slide.removeAttribute('inert');
                            } else {
                                slide.setAttribute('inert', '');
                            }
                        });
                    }

                    function onSlideChange() {
                        syncSlideAriaHidden();
                    }

                    swiper.on('slideChange', onSlideChange);
                    syncSlideAriaHidden();
                    cleanups.push(function () {
                        swiper.off('slideChange', onSlideChange);
                    });

                    function onKeydown(event) {
                        if (
                            event.target !== swiperContainer ||
                            (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight')
                        ) {
                            return;
                        }

                        event.preventDefault();
                        const moveNext =
                            event.key === (swiper.rtlTranslate ? 'ArrowLeft' : 'ArrowRight');
                        if (moveNext) {
                            swiper.slideNext();
                        } else {
                            swiper.slidePrev();
                        }
                    }
                    swiperContainer.addEventListener('keydown', onKeydown);
                    cleanups.push(function () {
                        swiperContainer.removeEventListener('keydown', onKeydown);
                    });

                    return { swiper, cleanups };
                },

                destroy(_el, state) {
                    if (!state) return;

                    if (Array.isArray(state.cleanups)) {
                        state.cleanups.forEach(function (fn) {
                            fn();
                        });
                    }

                    if (state.swiper && typeof state.swiper.destroy === 'function') {
                        state.swiper.destroy(true, true);
                    }
                },
            },
            { lazy: true },
        );
    })();
{% endjavascript %}

{% stylesheet %}
    .slides-show-section .slides-show__content-grid {
        grid-template-rows: repeat(3, minmax(0, 1fr));
        row-gap: 1rem;
    }

    .slides-show-section .place-top-left,
    .slides-show-section .place-top-center,
    .slides-show-section .place-top-right {
        grid-column: 1 / -1;
        grid-row-start: 1;
        align-self: start;
        justify-self: stretch;
    }

    .slides-show-section .place-center-left,
    .slides-show-section .place-center,
    .slides-show-section .place-center-right {
        grid-column: 1 / -1;
        grid-row-start: 2;
        align-self: center;
        justify-self: stretch;
    }

    .slides-show-section .place-bottom-left,
    .slides-show-section .place-bottom-center,
    .slides-show-section .place-bottom-right {
        grid-column: 1 / -1;
        grid-row-start: 3;
        align-self: end;
        justify-self: stretch;
    }

    .slides-show-section .slides-show__caption-content {
        grid-column: 1 / -1;
        grid-row-start: 1;
        align-self: stretch;
        justify-self: stretch;
    }

    .slides-show-section .slides-show__headline-content {
        grid-column: 1 / -1;
        grid-row-start: 2;
        align-self: stretch;
        justify-self: stretch;
    }

    .slides-show-section .slides-show__meta-content {
        grid-column: 1 / -1;
        grid-row-start: 3;
        align-self: stretch;
        justify-self: stretch;
    }

    @media (width >= 48rem) {
        .slides-show-section .place-top-left {
            grid-column: auto;
            grid-column-start: 1;
            grid-row-start: 1;
            align-self: start;
            justify-self: start;
        }

        .slides-show-section .place-top-center {
            grid-column: auto;
            grid-column-start: 2;
            grid-row-start: 1;
            align-self: start;
            justify-self: center;
        }

        .slides-show-section .place-top-right {
            grid-column: auto;
            grid-column-start: 3;
            grid-row-start: 1;
            align-self: start;
            justify-self: end;
        }

        .slides-show-section .place-center-left {
            grid-column: auto;
            grid-column-start: 1;
            grid-row-start: 2;
            align-self: center;
            justify-self: start;
        }

        .slides-show-section .place-center {
            grid-column: auto;
            grid-column-start: 2;
            grid-row-start: 2;
            align-self: center;
            justify-self: center;
        }

        .slides-show-section .place-center-right {
            grid-column: auto;
            grid-column-start: 3;
            grid-row-start: 2;
            align-self: center;
            justify-self: end;
        }

        .slides-show-section .place-bottom-left {
            grid-column: auto;
            grid-column-start: 1;
            grid-row-start: 3;
            align-self: end;
            justify-self: start;
        }

        .slides-show-section .place-bottom-center {
            grid-column: auto;
            grid-column-start: 2;
            grid-row-start: 3;
            align-self: end;
            justify-self: center;
        }

        .slides-show-section .place-bottom-right {
            grid-column: auto;
            grid-column-start: 3;
            grid-row-start: 3;
            align-self: end;
            justify-self: end;
        }
    }

    .slides-show-section {
        --motion-reveal-base-delay: 180ms;
        --motion-reveal-rise-distance: clamp(48px, 6vw, 80px);
        --motion-slide-content-distance-y: clamp(36px, 5vw, 64px);
    }
{% endstylesheet %}

