{%- assign slides_show_root_attrs = 'data-component-kind="section" data-component-type="slides-show" data-component-id="'
    | append: section.id
    | append: '"'
-%}
{%- capture slides_show_children -%}
    {%- liquid
        assign slides_show_sr_only_title = shop.name
        assign slides_show_first_block = section.blocks.first
        if slides_show_first_block.settings.headline != blank
            assign slides_show_sr_only_title = slides_show_first_block.settings.headline
        endif
        assign slides_show_multi_slide = false
        if section.blocks.size > 1
            assign slides_show_multi_slide = true
        endif

        assign slides_show_heading_mobile_size = section.settings.heading_size_mobile | default: 'heading-xl'
        assign slides_show_heading_desktop_size = section.settings.heading_size | default: 'heading-3xl'

        assign slides_show_heading_mobile_class = 'max-pc:heading-xl'
        case slides_show_heading_mobile_size
            when 'heading-4xl'
                assign slides_show_heading_mobile_class = 'max-pc:heading-4xl'
            when 'heading-3xl'
                assign slides_show_heading_mobile_class = 'max-pc:heading-3xl'
            when 'heading-2xl'
                assign slides_show_heading_mobile_class = 'max-pc:heading-2xl'
            when 'heading-xl'
                assign slides_show_heading_mobile_class = 'max-pc:heading-xl'
            when 'heading-h1'
                assign slides_show_heading_mobile_class = 'max-pc:heading-h1'
            when 'heading-h2'
                assign slides_show_heading_mobile_class = 'max-pc:heading-h2'
            when 'heading-h3'
                assign slides_show_heading_mobile_class = 'max-pc:heading-h3'
            when 'heading-h4'
                assign slides_show_heading_mobile_class = 'max-pc:heading-h4'
            when 'heading-h5'
                assign slides_show_heading_mobile_class = 'max-pc:heading-h5'
            when 'heading-h6'
                assign slides_show_heading_mobile_class = 'max-pc:heading-h6'
        endcase

        assign slides_show_heading_desktop_class = 'pc:heading-3xl'
        case slides_show_heading_desktop_size
            when 'heading-4xl'
                assign slides_show_heading_desktop_class = 'pc:heading-4xl'
            when 'heading-3xl'
                assign slides_show_heading_desktop_class = 'pc:heading-3xl'
            when 'heading-2xl'
                assign slides_show_heading_desktop_class = 'pc:heading-2xl'
            when 'heading-xl'
                assign slides_show_heading_desktop_class = 'pc:heading-xl'
            when 'heading-h1'
                assign slides_show_heading_desktop_class = 'pc:heading-h1'
            when 'heading-h2'
                assign slides_show_heading_desktop_class = 'pc:heading-h2'
            when 'heading-h3'
                assign slides_show_heading_desktop_class = 'pc:heading-h3'
            when 'heading-h4'
                assign slides_show_heading_desktop_class = 'pc:heading-h4'
            when 'heading-h5'
                assign slides_show_heading_desktop_class = 'pc:heading-h5'
            when 'heading-h6'
                assign slides_show_heading_desktop_class = 'pc:heading-h6'
        endcase

        assign slides_show_heading_class = slides_show_heading_mobile_class | append: ' ' | append: slides_show_heading_desktop_class
        assign slides_show_subtitle_size = section.settings.subtitle_size | default: 'body-3xl'
    -%}
    <div
        class="absolute inset-0"
        data-module-id="slides-show"
        x-data="slidesShow()"
        data-swiper-src="{{ 'vendor-swiper.min.js' | asset_url }}"
        data-section-id="{{ section.id }}"
        data-slide-count="{{ section.blocks.size }}"
        data-autoplay="{% if section.settings.autoplay %}true{% else %}false{% endif %}"
        data-autoplay-delay-ms="{{ section.settings.autoplay_speed | default: 5 | times: 1000 }}"
    >
        <div
            class="swiper h-full w-full focus-ring"
            role="region"
            aria-label="{{ 'accessibility.hero_slides' | t }}"
            aria-roledescription="{{ 'accessibility.carousel' | t }}"
            {% if slides_show_multi_slide %}
                tabindex="0"
                aria-keyshortcuts="ArrowLeft ArrowRight"
            {% endif %}
        >
            {%- if slides_show_multi_slide -%}
                <h1 class="sr-only">{{ slides_show_sr_only_title }}</h1>
            {%- endif -%}
            <div class="swiper-wrapper">
                {%- for block in section.blocks -%}
                    <div
                        class="swiper-slide"
                        data-block-id="{{ block.id }}"
                        data-slide-index="{{ forloop.index0 }}"
                        {{ block.shopify_attributes }}
                    >
                        {%- capture sizes -%}
                            (min-width: 80rem) 100vw, (min-width: 48rem) 1280px, 100vw
                        {%- endcapture -%}

                        {%- capture widths -%}
                            400,480,768,1280,1536,2400,2560
                        {%- endcapture -%}

                        {%- assign image_loading = 'lazy' -%}
                        {%- assign image_fetchpriority = 'auto' -%}
                        {%- if forloop.first -%}
                            {%- assign image_loading = 'eager' -%}
                            {%- assign image_fetchpriority = 'high' -%}
                        {%- endif -%}

                        {%- assign image_alt = block.settings.slide_image.alt
                            | default: shop.name
                            | escape
                        -%}
                        <div class="slides-show__media absolute inset-0">
                            {%- render 'image',
                                image: block.settings.slide_image,
                                mobile_image: block.settings.slide_image_mobile,
                                alt: image_alt,
                                width: block.settings.slide_image.width,
                                sizes: sizes,
                                widths: widths,
                                loading: image_loading,
                                fetchpriority: image_fetchpriority,
                                placeholder_key: 'lifestyle-1',
                                placeholder_style: 'plain',
                                wrapper_class: 'h-full w-full',
                                img_class: 'h-full w-full object-cover'
                            -%}
                        </div>

                        <div class="section-frame__overlay-padding section-frame__overlay-safe-top pointer-events-none container-page absolute inset-0">
                            <div class="slides-show__content-grid{% if slides_show_multi_slide %} slides-show__content-grid--with-controls{% endif %} grid h-full min-h-0 grid-cols-1 grid-rows-3 text-theme-text pc:grid-cols-3">
                                <div
                                    class="slides-show__headline-group {{ block.settings.heading_position }} pointer-events-auto flex h-full min-h-0 w-full max-w-3xl flex-col items-start justify-start gap-4 pc:max-w-4xl"
                                    data-slides-show-text-motion
                                >
                                    {%- if slides_show_multi_slide -%}
                                        {% render 'heading',
                                            level: '2',
                                            tier: slides_show_heading_class,
                                            class: 'slides-show__headline',
                                            content: block.settings.headline
                                        %}
                                    {%- else -%}
                                        {% render 'heading',
                                            level: '1',
                                            tier: slides_show_heading_class,
                                            class: 'slides-show__headline',
                                            content: block.settings.headline
                                        %}
                                    {%- endif -%}

                                    {%- if block.settings.cta_text != blank
                                        and block.settings.cta_link != blank
                                    -%}
                                        {%- liquid
                                            assign cta_href = block.settings.cta_link
                                            if cta_href == '/collections'
                                                assign cta_href = routes.collections_url
                                            endif
                                        -%}
                                        {%- capture link_content -%}
                                            <span class="uppercase">{{ block.settings.cta_text }}</span>
                                            {% render 'icons', icon: 'icon-arrow2', class: 'ms-2', size: 'sm' %}
                                        {%- endcapture -%}
                                        {%- render 'link',
                                            href: cta_href,
                                            variant: 'underline',
                                            class: 'body-lg uppercase text-theme-text pc:body-xl',
                                            content: link_content
                                        -%}
                                    {%- endif -%}
                                </div>

                                <div
                                    class="slides-show__body {{ block.settings.caption_position }} pointer-events-auto flex h-full min-h-0 w-full max-w-xl flex-col justify-end pc:max-w-2xl"
                                    data-slides-show-text-motion
                                >
                                    {% render 'text',
                                        tier: slides_show_subtitle_size,
                                        element: 'div',
                                        rte: true,
                                        class: 'text-theme-text/90',
                                        content: block.settings.description
                                    %}
                                </div>
                            </div>
                        </div>
                    </div>
                {%- endfor -%}
            </div>

            {%- if slides_show_multi_slide -%}
                <div
                    class="slides-show__controls container-page"
                    data-slides-show-controls
                    hidden
                >
                    <div class="slides-show__controls-row">
                        <div
                            class="slides-show__pagination"
                            role="group"
                            aria-label="{{ 'accessibility.slideshow_pagination' | t }}"
                        >
                            {%- for block in section.blocks -%}
                                <button
                                    type="button"
                                    class="slides-show__pagination-button focus-ring"
                                    data-slides-show-pagination-button
                                    data-slide-index="{{ forloop.index0 }}"
                                    aria-label="{{ 'accessibility.go_to_slide' | t: index: forloop.index }}"
                                    {% if forloop.first %}
                                        aria-current="true"
                                    {% endif %}
                                >
                                    <span
                                        class="slides-show__dot{% if forloop.first %} is-active{% endif %}"
                                        aria-hidden="true"
                                    >
                                        <span
                                            class="slides-show__dot-fill"
                                            {% if forloop.first %}
                                                data-slides-show-progress-fill
                                                style="--slides-show-progress: 0"
                                            {% endif %}
                                        ></span>
                                    </span>
                                </button>
                            {%- endfor -%}
                        </div>
                        <button
                            type="button"
                            class="slides-show__autoplay-toggle focus-ring"
                            data-slides-show-autoplay-toggle
                            data-state="playing"
                            data-label-pause="{{ 'accessibility.slideshow_pause' | t | escape }}"
                            data-label-play="{{ 'accessibility.slideshow_play' | t | escape }}"
                            aria-label="{{ 'accessibility.slideshow_pause' | t }}"
                        >
                            <span class="slides-show__autoplay-icon slides-show__autoplay-icon--pause" aria-hidden="true"></span>
                            <span class="slides-show__autoplay-icon slides-show__autoplay-icon--play hidden" aria-hidden="true">
                                {% render 'icons', icon: 'icon-play', size: 'xs' %}
                            </span>
                        </button>
                    </div>
                </div>
            {%- endif -%}
        </div>
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: 'slides-show-section',
    surface_section: false,
    width: 'full',
    height_kind: 'stage',
    padding_mode: 'overlay',
    motion: false,
    safe_top: false,
    root_attrs: slides_show_root_attrs,
    children: slides_show_children
%}

{% stylesheet %}
    /* Hero display headline (design specification): its own case, leading and tracking.
       Unlayered, so it wins over the responsive heading tier utilities, which reset
       text-transform and line-height to the global typography settings. */
    .slides-show-section .slides-show__headline {
        text-transform: uppercase;
        line-height: 0.95;
        letter-spacing: -0.02em;
    }

    .slides-show-section .slides-show__content-grid {
        grid-template-rows: repeat(3, minmax(0, 1fr));
        row-gap: 1rem;
    }

    .slides-show-section .slides-show__media .theme-image {
        height: 100%;
        aspect-ratio: auto;
    }

    .slides-show-section .place-top-left,
    .slides-show-section .place-top-center,
    .slides-show-section .place-top-right {
        grid-column: 1 / -1;
        grid-row-start: 1;
        align-self: start;
        justify-self: stretch;
    }

    .slides-show-section .place-center-left,
    .slides-show-section .place-center,
    .slides-show-section .place-center-right {
        grid-column: 1 / -1;
        grid-row-start: 2;
        align-self: center;
        justify-self: stretch;
    }

    .slides-show-section .place-bottom-left,
    .slides-show-section .place-bottom-center,
    .slides-show-section .place-bottom-right {
        grid-column: 1 / -1;
        grid-row-start: 3;
        align-self: end;
        justify-self: stretch;
    }

    /* Page-width row along the bottom, so the controls share the copy's gutter. */
    .slides-show-section .slides-show__controls {
        position: absolute;
        right: 0;
        bottom: 1.6rem;
        left: 0;
        z-index: 2;
        pointer-events: none;
    }

    .slides-show-section .slides-show__controls-row {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.8rem;
    }

    .slides-show-section .slides-show__controls-row > * {
        pointer-events: auto;
    }

    /* Stays hidden until the slideshow mounts (no-JS: no dead controls). */
    .slides-show-section .slides-show__controls[hidden] {
        display: none;
    }

    /* Phones: full-width copy would run under the controls; keep it above them. */
    @media (width < 48rem) {
        .slides-show-section .slides-show__content-grid--with-controls {
            padding-bottom: 4rem;
        }
    }

    @media (width >= 48rem) {
        .slides-show-section .slides-show__controls {
            bottom: 3.2rem;
        }
    }

    /* The root font size is 62.5%: 1rem = 10px. Each dot button is a 24px target
       (WCAG 2.5.8); the visible dot sits centred inside it. */
    .slides-show-section .slides-show__pagination {
        display: flex;
        align-items: center;
    }

    .slides-show-section .slides-show__pagination-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 2.4rem;
        height: 2.4rem;
        padding: 0 0.4rem;
        border: 0;
        background: transparent;
        cursor: pointer;
    }

    .slides-show-section .slides-show__dot {
        display: block;
        width: 0.8rem;
        height: 0.8rem;
        border-radius: 9999px;
        background: rgba(var(--color-foreground), 0.5);
        overflow: hidden;
        transition: width 0.2s ease;
    }

    .slides-show-section .slides-show__dot.is-active {
        width: 4.8rem;
        background: rgba(var(--color-foreground), 0.25);
    }

    .slides-show-section .slides-show__dot:not(.is-active) .slides-show__dot-fill {
        width: 0;
    }

    .slides-show-section .slides-show__dot-fill {
        display: block;
        height: 100%;
        width: calc(var(--slides-show-progress, 1) * 100%);
        background: rgb(var(--color-primary-button));
        border-radius: inherit;
    }

    .slides-show-section .slides-show__autoplay-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.4rem;
        height: 2.4rem;
        padding: 0;
        border: 0;
        border-radius: 9999px;
        background: rgba(var(--color-foreground), 0.12);
        color: rgb(var(--color-foreground));
        cursor: pointer;
    }

    .slides-show-section .slides-show__autoplay-icon--pause {
        display: inline-flex;
        gap: 0.3rem;
    }

    .slides-show-section .slides-show__autoplay-icon--pause::before,
    .slides-show-section .slides-show__autoplay-icon--pause::after {
        content: '';
        display: block;
        width: 0.2rem;
        height: 1rem;
        border-radius: 1px;
        background: currentcolor;
    }

    .slides-show-section
        .slides-show__autoplay-toggle[data-state='paused']
        .slides-show__autoplay-icon--pause {
        display: none;
    }

    .slides-show-section
        .slides-show__autoplay-toggle[data-state='paused']
        .slides-show__autoplay-icon--play {
        display: inline-flex;
    }

    @keyframes slides-show-text-rise {
        from {
            opacity: 0;
            transform: translate3d(0, 2.4rem, 0);
        }

        to {
            opacity: 1;
            transform: translate3d(0, 0, 0);
        }
    }

    .slides-show-section [data-slides-show-text-motion].is-slides-show-text-enter {
        animation: slides-show-text-rise 0.75s
            var(--motion-ease-default, cubic-bezier(0.22, 1, 0.36, 1)) both;
        animation-delay: calc(var(--slides-show-text-index, 0) * 120ms);
    }

    body[data-motion-enabled='false']
        .slides-show-section
        [data-slides-show-text-motion].is-slides-show-text-enter {
        animation: none !important;
    }

    /* Motion off: the active pill shows full and still (the script stops updating it). */
    body[data-motion-enabled='false']
        .slides-show-section
        .slides-show__dot.is-active
        .slides-show__dot-fill {
        width: 100% !important;
    }

    @media (prefers-reduced-motion: reduce) {
        .slides-show-section [data-slides-show-text-motion].is-slides-show-text-enter {
            animation: none !important;
        }

        .slides-show-section .slides-show__dot.is-active .slides-show__dot-fill {
            width: 100% !important;
        }
    }

    @media (width >= 48rem) {
        .slides-show-section .place-top-left {
            grid-column: auto;
            grid-column-start: 1;
            grid-row-start: 1;
            align-self: start;
            justify-self: start;
        }

        .slides-show-section .place-top-center {
            grid-column: auto;
            grid-column-start: 2;
            grid-row-start: 1;
            align-self: start;
            justify-self: center;
        }

        .slides-show-section .place-top-right {
            grid-column: auto;
            grid-column-start: 3;
            grid-row-start: 1;
            align-self: start;
            justify-self: end;
        }

        .slides-show-section .place-center-left {
            grid-column: auto;
            grid-column-start: 1;
            grid-row-start: 2;
            align-self: center;
            justify-self: start;
        }

        .slides-show-section .place-center {
            grid-column: auto;
            grid-column-start: 2;
            grid-row-start: 2;
            align-self: center;
            justify-self: center;
        }

        .slides-show-section .place-center-right {
            grid-column: auto;
            grid-column-start: 3;
            grid-row-start: 2;
            align-self: center;
            justify-self: end;
        }

        .slides-show-section .place-bottom-left {
            grid-column: auto;
            grid-column-start: 1;
            grid-row-start: 3;
            align-self: end;
            justify-self: start;
        }

        .slides-show-section .place-bottom-center {
            grid-column: auto;
            grid-column-start: 2;
            grid-row-start: 3;
            align-self: end;
            justify-self: center;
        }

        .slides-show-section .place-bottom-right {
            grid-column: auto;
            grid-column-start: 3;
            grid-row-start: 3;
            align-self: end;
            justify-self: end;
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.slides-show.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer", "custom.overlay"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.slides-show.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.font"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "heading-4xl",
                    "label": "t:sections.slides-show.options.heading_4xl"
                },
                {
                    "value": "heading-3xl",
                    "label": "t:sections.slides-show.options.heading_3xl"
                },
                {
                    "value": "heading-2xl",
                    "label": "t:sections.slides-show.options.heading_2xl"
                },
                {
                    "value": "heading-xl",
                    "label": "t:sections.slides-show.options.heading_xl"
                },
                {
                    "value": "heading-h1",
                    "label": "t:sections.slides-show.options.heading_h1"
                },
                {
                    "value": "heading-h2",
                    "label": "t:sections.slides-show.options.heading_h2"
                },
                {
                    "value": "heading-h3",
                    "label": "t:sections.slides-show.options.heading_h3"
                },
                {
                    "value": "heading-h4",
                    "label": "t:sections.slides-show.options.heading_h4"
                },
                {
                    "value": "heading-h5",
                    "label": "t:sections.slides-show.options.heading_h5"
                },
                {
                    "value": "heading-h6",
                    "label": "t:sections.slides-show.options.heading_h6"
                }
            ],
            "default": "heading-3xl"
        },
        {
            "type": "select",
            "id": "heading_size_mobile",
            "label": "t:sections.slides-show.settings.heading_size_mobile",
            "options": [
                {
                    "value": "heading-4xl",
                    "label": "t:sections.slides-show.options.heading_4xl"
                },
                {
                    "value": "heading-3xl",
                    "label": "t:sections.slides-show.options.heading_3xl"
                },
                {
                    "value": "heading-2xl",
                    "label": "t:sections.slides-show.options.heading_2xl"
                },
                {
                    "value": "heading-xl",
                    "label": "t:sections.slides-show.options.heading_xl"
                },
                {
                    "value": "heading-h1",
                    "label": "t:sections.slides-show.options.heading_h1"
                },
                {
                    "value": "heading-h2",
                    "label": "t:sections.slides-show.options.heading_h2"
                },
                {
                    "value": "heading-h3",
                    "label": "t:sections.slides-show.options.heading_h3"
                },
                {
                    "value": "heading-h4",
                    "label": "t:sections.slides-show.options.heading_h4"
                },
                {
                    "value": "heading-h5",
                    "label": "t:sections.slides-show.options.heading_h5"
                },
                {
                    "value": "heading-h6",
                    "label": "t:sections.slides-show.options.heading_h6"
                }
            ],
            "default": "heading-xl"
        },
        {
            "type": "header",
            "content": "t:sections.scroll-categories.content.subtitle"
        },
        {
            "type": "select",
            "id": "subtitle_size",
            "label": "t:sections.scroll-categories.settings.subtitle_size",
            "options": [
                {
                    "value": "body-3xl",
                    "label": "t:sections.scroll-categories.options.body_3xl"
                },
                {
                    "value": "body-2xl",
                    "label": "t:sections.scroll-categories.options.body_2xl"
                },
                {
                    "value": "body-xl",
                    "label": "t:sections.scroll-categories.options.body_xl"
                },
                {
                    "value": "body-lg",
                    "label": "t:sections.scroll-categories.options.body_lg"
                },
                {
                    "value": "body-md",
                    "label": "t:sections.scroll-categories.options.body_md"
                },
                {
                    "value": "body-sm",
                    "label": "t:sections.scroll-categories.options.body_sm"
                }
            ],
            "default": "body-3xl"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.autoplay"
        },
        {
            "type": "checkbox",
            "id": "autoplay",
            "label": "t:sections.slides-show.settings.autoplay",
            "default": true
        },
        {
            "type": "range",
            "id": "autoplay_speed",
            "min": 3,
            "max": 10,
