<div
    data-section-id="{{ section.id }}"
    class="
        slides-show-section full-width h-screen
        color-{{ section.settings.color_scheme }}
    "
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="slides-show"
    data-component-id="{{ section.id }}"
    data-auto-slide="{{ section.settings.is_auto_slide }}"
    data-slide-delay="{{ section.settings.slide_delay }}"
>
    <div class="swiper h-full w-full">
        <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
                <div class="swiper-slide" {{ block.shopify_attributes }}>
                    {%- capture sizes -%}
                        (min-width: 80rem) 100vw, (min-width: 48rem) 1280px, 768px
                    {%- endcapture -%}

                    {%- capture widths -%}
                        400,768,1280,1536,2560
                    {%- endcapture -%}

                    {%- assign image_loading = 'lazy' -%}
                    {%- if forloop.first -%}
                        {%- assign image_loading = 'eager' -%}
                    {%- endif -%}

                    {%-
                        render 'image',
                        image: block.settings.slide_image,
                        alt: block.settings.slide_image.alt | default: shop.name | escape,
                        width: block.settings.slide_image.width,
                        sizes: sizes,
                        widths: widths,
                        loading: image_loading
                    -%}

                    <div class="layout layout-safe-top container-page absolute inset-0">
                        <div class="grid grid-cols-1 grid-rows-3 pc:grid-cols-3">
                            <div
                                class="text-theme-text/80 {{ block.settings.caption_position }} flex flex-col justify-around pc:h-full pc:w-full"
                            >
                                <p class="body-md leading-relaxed font-light">
                                    {{ block.settings.year }}
                                </p>

                                <div class="mt-2 body-md leading-tight font-light">
                                    {{ block.settings.description }}
                                </div>

                                {%- capture link_content -%}
                                    <span>{{ block.settings.cta_text }}</span>
                                    {% render 'icons', icon: 'icon-arrow2', size: 'lg', class: 'ml-3',color: 'current' %}
                                {%- endcapture -%}

                                {%- render 'link',
                                    href: block.settings.cta_link,
                                    content: link_content,
                                    variant: 'underline',
                                    color: 'current'
                                -%}
                            </div>

                            <div
                                class="{{ block.settings.heading_position }} flex items-center pc:h-full pc:w-full"
                            >
                                <h1 class="hxl leading-tight font-bold tracking-tight">
                                    {{ block.settings.headline }}
                                </h1>
                            </div>

                            <div
                                class="text-theme-text/80 {{ block.settings.meta_position }} flex flex-col justify-around pc:h-full pc:w-full pc:items-center"
                            >
                                <div>{{ block.settings.meta_text }}</div>
                                <div>{{ block.settings.meta_counter }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            {%- endfor -%}
        </div>
    </div>
</div>

{% javascript %}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components) return;

        Components.register(
            'slides-show',
            {
                init(el) {
                    const slides = el.querySelectorAll('.swiper-slide');
                    const autoSlide = el.getAttribute('data-auto-slide') === 'true';
                    const slideDelay = parseInt(el.getAttribute('data-slide-delay'), 10) || 5;

                    const swiperContainer = el.querySelector('.swiper');

                    if (!swiperContainer || typeof Swiper === 'undefined') return;

                    const swiper = new Swiper(swiperContainer, {
                        loop: slides.length > 1,
                        autoplay: autoSlide
                            ? {
                                  delay: slideDelay * 1000,
                                  disableOnInteraction: false,
                              }
                            : false,
                        slidesPerView: 1,
                        effect: 'fade',
                        fadeEffect: {
                            crossFade: true,
                        },
                        pagination: false,
                        navigation: false,
                    });

                    return { swiper };
                },

                destroy(el, state) {
                    if (!state || !state.swiper) return;

                    if (typeof state.swiper.destroy === 'function') {
                        state.swiper.destroy(true, true);
                    }
                },
            },
            { lazy: true },
        );
    })();
{% endjavascript %}

