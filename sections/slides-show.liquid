<div
    data-section-id="{{ section.id }}"
    class="slides-show-section full-width h-screen color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
        --slides-show-hero-reveal-distance: 3.25rem;
        --slides-show-hero-reveal-duration: 780ms;
        --slides-show-hero-reveal-stagger: 140ms;
        --slides-show-hero-reveal-base-delay: 180ms;
    "
    data-component-kind="section"
    data-component-type="slides-show"
    data-component-id="{{ section.id }}"
    data-auto-slide="{{ section.settings.is_auto_slide }}"
    data-slide-delay="{{ section.settings.slide_delay }}"
    x-data="motionRevealSection()"
    data-motion-section
    data-motion-media="static"
>
    {%- liquid
        assign slides_show_sr_only_title = shop.name
        assign slides_show_first_block = section.blocks.first
        if slides_show_first_block.settings.headline != blank
            assign slides_show_sr_only_title = slides_show_first_block.settings.headline
        endif
        assign slides_show_multi_slide = false
        if section.blocks.size > 1
            assign slides_show_multi_slide = true
        endif

        assign slides_show_heading_class = section.settings.heading_size | default: 'heading-3xl'
        assign slides_show_subtitle_size = section.settings.subtitle_size | default: 'body-3xl'
        assign slides_show_subtitle_class = 'typo-subtitle ' | append: slides_show_subtitle_size
    -%}
    <div
        class="swiper h-full w-full"
        role="region"
        aria-label="{{ 'accessibility.hero_slides' | t }}"
        aria-roledescription="{{ 'accessibility.carousel' | t }}"
    >
        {%- if slides_show_multi_slide -%}
            <h1 class="sr-only">{{ slides_show_sr_only_title }}</h1>
        {%- endif -%}
        <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
                <div class="swiper-slide" {{ block.shopify_attributes }}>
                    {%- capture sizes -%}
                        (min-width: 80rem) 100vw, (min-width: 48rem) 1280px, 100vw
                    {%- endcapture -%}

                    {%- capture widths -%}
                        400,480,768,1280,1536,2400,2560
                    {%- endcapture -%}

                    {%- assign image_loading = 'lazy' -%}
                    {%- assign image_fetchpriority = 'auto' -%}
                    {%- if forloop.first -%}
                        {%- assign image_loading = 'eager' -%}
                        {%- assign image_fetchpriority = 'high' -%}
                    {%- endif -%}

                    {%- assign image_alt = block.settings.slide_image.alt
                        | default: shop.name
                        | escape
                    -%}
                    {%- render 'image',
                        image: block.settings.slide_image,
                        alt: image_alt,
                        width: block.settings.slide_image.width,
                        sizes: sizes,
                        widths: widths,
                        loading: image_loading,
                        fetchpriority: image_fetchpriority,
                        motion_reveal: false
                    -%}

                    <div class="layout layout-safe-top container-page absolute inset-0">
                        <div class="slides-show__content-grid grid h-full min-h-0 grid-cols-1 grid-rows-3 text-theme-text/80 pc:grid-cols-3">
                            <div
                                class="slides-show__caption-content {{ block.settings.caption_position }} flex h-full min-h-0 w-full flex-col justify-around gap-4"
                                {% if forloop.first %}
                                    data-motion-reveal="content"
                                    data-motion-hero-copy
                                    data-motion-index="0"
                                {% endif %}
                            >
                                <p class="body-3xl">
                                    {{ block.settings.year }}
                                </p>

                                <div class="rte rte--compact mt-2 {{ slides_show_subtitle_class }}">
                                    {{ block.settings.description }}
                                </div>

                                {%- if block.settings.cta_text != blank
                                    and block.settings.cta_link != blank
                                -%}
                                    {%- liquid
                                        assign cta_href = block.settings.cta_link
                                        if cta_href == '/collections'
                                            assign cta_href = routes.collections_url
                                        endif
                                    -%}
                                    {%- capture link_content -%}
                                        <span>{{ block.settings.cta_text }}</span>
                                        {% render 'icons', icon: 'icon-arrow2', class: 'ms-3' %}
                                    {%- endcapture -%}

                                    {%- if block.settings.cta_style == 'button' -%}
                                        {%- render 'link',
                                            href: cta_href,
                                            variant: 'plain',
                                            class: 'btn-primary w-fit max-w-full',
                                            content: link_content
                                        -%}
                                    {%- else -%}
                                        {%- render 'link',
                                            href: cta_href,
                                            variant: 'underline',
                                            class: 'body-2xl text-theme-text',
                                            content: link_content
                                        -%}
                                    {%- endif -%}
                                {%- endif -%}
                            </div>

                            <div
                                class="slides-show__headline-content {{ block.settings.heading_position }} flex h-full min-h-0 w-full items-center"
                                {% if forloop.first %}
                                    data-motion-reveal="content"
                                    data-motion-hero-copy
                                    data-motion-index="1"
                                {% endif %}
                            >
                                {%- if slides_show_multi_slide -%}
                                    <h2 class="{{ slides_show_heading_class }}">
                                        {{ block.settings.headline }}
                                    </h2>
                                {%- else -%}
                                    <h1 class="{{ slides_show_heading_class }}">
                                        {{ block.settings.headline }}
                                    </h1>
                                {%- endif -%}
                            </div>

                            <div
                                class="slides-show__meta-content {{ block.settings.meta_position }} flex h-full min-h-0 w-full flex-col justify-around pc:items-center"
                                {% if forloop.first %}
                                    data-motion-reveal="content"
                                    data-motion-hero-copy
                                    data-motion-index="2"
                                {% endif %}
                            >
                                <div>{{ block.settings.meta_text }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            {%- endfor -%}
        </div>
        {%- if section.blocks.size > 1 -%}
            <div class="slides-show__controls absolute right-6 bottom-6 z-10 flex items-center gap-3 pc:right-10 pc:bottom-10">
                <button
                    type="button"
                    class="slides-show__nav-button slides-show__nav-prev"
                    aria-label="{{ 'accessibility.previous_slide' | t }}"
                >
                    {%- render 'icons', icon: 'icon-arrow2', class: 'scale-x-[-1]' -%}
                </button>
                <button
                    type="button"
                    class="slides-show__nav-button slides-show__nav-next"
                    aria-label="{{ 'accessibility.next_slide' | t }}"
                >
                    {%- render 'icons', icon: 'icon-arrow2' -%}
                </button>
                {%- if section.settings.is_auto_slide -%}
                    <button
                        type="button"
                        class="slides-show__nav-button slides-show__pause-toggle"
                        aria-label="{{ 'accessibility.pause_slideshow' | t }}"
                        aria-pressed="false"
                        data-play-label="{{ 'accessibility.play_slideshow' | t }}"
                    ></button>
                {%- endif -%}
            </div>
        {%- endif -%}
    </div>
</div>

{% javascript %}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components) return;

        Components.register(
            'slides-show',
            {
                init(el) {
                    const slides = el.querySelectorAll('.swiper-slide');
                    const swiperContainer = el.querySelector('.swiper');
                    const cleanups = [];

                    if (!swiperContainer || typeof Swiper === 'undefined' || slides.length <= 1) {
                        return { swiper: null, cleanups };
                    }

                    const autoSlide = el.getAttribute('data-auto-slide') === 'true';
                    const slideDelay = parseInt(el.getAttribute('data-slide-delay'), 10) || 5;

                    const swiper = new Swiper(swiperContainer, {
                        loop: slides.length > 1,
                        autoplay: autoSlide
                            ? {
                                  delay: slideDelay * 1000,
                                  disableOnInteraction: false,
                              }
                            : false,
                        slidesPerView: 1,
                        effect: 'fade',
                        fadeEffect: {
                            crossFade: true,
                        },
                        pagination: false,
                        navigation: false,
                    });

                    function syncSlideAriaHidden() {
                        swiperContainer.querySelectorAll('.swiper-slide').forEach(function (slide) {
                            slide.setAttribute(
                                'aria-hidden',
                                slide.classList.contains('swiper-slide-active') ? 'false' : 'true',
                            );
                        });
                    }

                    function onSlideChange() {
                        syncSlideAriaHidden();
                    }

                    swiper.on('slideChange', onSlideChange);
                    syncSlideAriaHidden();
                    cleanups.push(function () {
                        swiper.off('slideChange', onSlideChange);
                    });

                    const prevBtn = el.querySelector('.slides-show__nav-prev');
                    const nextBtn = el.querySelector('.slides-show__nav-next');

                    if (prevBtn) {
                        function onPrev() {
                            swiper.slidePrev();
                        }
                        prevBtn.addEventListener('click', onPrev);
                        cleanups.push(function () {
                            prevBtn.removeEventListener('click', onPrev);
                        });
                    }

                    if (nextBtn) {
                        function onNext() {
                            swiper.slideNext();
                        }
                        nextBtn.addEventListener('click', onNext);
                        cleanups.push(function () {
                            nextBtn.removeEventListener('click', onNext);
                        });
                    }

                    const pauseBtn = el.querySelector('.slides-show__pause-toggle');
                    if (pauseBtn && swiper.autoplay) {
                        const pauseLabel = pauseBtn.getAttribute('aria-label');
                        const playLabel = pauseBtn.getAttribute('data-play-label');

                        function updatePauseButton() {
                            const isRunning = swiper.autoplay.running;
                            pauseBtn.setAttribute('aria-label', isRunning ? pauseLabel : playLabel);
                            pauseBtn.setAttribute('aria-pressed', String(!isRunning));
                        }

                        function onTogglePause() {
                            if (swiper.autoplay.running) {
                                swiper.autoplay.stop();
                            } else {
                                swiper.autoplay.start();
                            }
                            updatePauseButton();
                        }

                        pauseBtn.addEventListener('click', onTogglePause);
                        cleanups.push(function () {
                            pauseBtn.removeEventListener('click', onTogglePause);
                        });
                    }

                    return { swiper, cleanups };
                },

                destroy(el, state) {
                    if (!state) return;

                    if (Array.isArray(state.cleanups)) {
                        state.cleanups.forEach(function (fn) {
                            fn();
                        });
                    }

                    if (state.swiper && typeof state.swiper.destroy === 'function') {
                        state.swiper.destroy(true, true);
                    }
                },
            },
            { lazy: true },
        );
    })();
{% endjavascript %}

{% stylesheet %}
    .slides-show-section .slides-show__content-grid {
        grid-template-rows: repeat(3, minmax(0, 1fr));
        row-gap: 1rem;
    }

    .slides-show-section .place-top-left,
    .slides-show-section .place-top-center,
    .slides-show-section .place-top-right {
        grid-column: 1 / -1;
        grid-row-start: 1;
        align-self: start;
        justify-self: stretch;
    }

    .slides-show-section .place-center-left,
    .slides-show-section .place-center,
    .slides-show-section .place-center-right {
        grid-column: 1 / -1;
        grid-row-start: 2;
        align-self: center;
        justify-self: stretch;
    }

    .slides-show-section .place-bottom-left,
    .slides-show-section .place-bottom-center,
    .slides-show-section .place-bottom-right {
        grid-column: 1 / -1;
        grid-row-start: 3;
        align-self: end;
        justify-self: stretch;
    }

    .slides-show-section .slides-show__caption-content {
        grid-column: 1 / -1;
        grid-row-start: 1;
        align-self: stretch;
        justify-self: stretch;
    }

    .slides-show-section .slides-show__headline-content {
        grid-column: 1 / -1;
        grid-row-start: 2;
        align-self: stretch;
        justify-self: stretch;
    }

    .slides-show-section .slides-show__meta-content {
        grid-column: 1 / -1;
        grid-row-start: 3;
        align-self: stretch;
        justify-self: stretch;
    }

    @media (width >= 48rem) {
        .slides-show-section .place-top-left {
            grid-column: auto;
            grid-column-start: 1;
            grid-row-start: 1;
            align-self: start;
            justify-self: start;
        }

        .slides-show-section .place-top-center {
            grid-column: auto;
            grid-column-start: 2;
            grid-row-start: 1;
            align-self: start;
            justify-self: center;
        }

        .slides-show-section .place-top-right {
            grid-column: auto;
            grid-column-start: 3;
            grid-row-start: 1;
            align-self: start;
            justify-self: end;
        }

        .slides-show-section .place-center-left {
            grid-column: auto;
            grid-column-start: 1;
            grid-row-start: 2;
            align-self: center;
            justify-self: start;
        }

        .slides-show-section .place-center {
            grid-column: auto;
            grid-column-start: 2;
            grid-row-start: 2;
            align-self: center;
            justify-self: center;
        }

        .slides-show-section .place-center-right {
            grid-column: auto;
            grid-column-start: 3;
            grid-row-start: 2;
            align-self: center;
            justify-self: end;
        }

        .slides-show-section .place-bottom-left {
            grid-column: auto;
            grid-column-start: 1;
            grid-row-start: 3;
            align-self: end;
            justify-self: start;
        }

        .slides-show-section .place-bottom-center {
            grid-column: auto;
            grid-column-start: 2;
            grid-row-start: 3;
            align-self: end;
            justify-self: center;
        }

        .slides-show-section .place-bottom-right {
            grid-column: auto;
            grid-column-start: 3;
            grid-row-start: 3;
            align-self: end;
            justify-self: end;
        }
    }

    .slides-show-section {
        [data-motion-hero-copy][data-motion-reveal][data-motion-state='pending'] {
            opacity: 0;
            transform: translate3d(0, var(--slides-show-hero-reveal-distance, 3.25rem), 0);
            will-change: opacity, transform;
            transition:
                opacity var(--slides-show-hero-reveal-duration, 780ms)
                    var(--motion-ease-enter, cubic-bezier(0.22, 1, 0.36, 1)),
                transform var(--slides-show-hero-reveal-duration, 780ms)
                    var(--motion-ease-enter, cubic-bezier(0.22, 1, 0.36, 1));
            transition-delay: calc(
                var(--slides-show-hero-reveal-base-delay, 180ms) + var(--motion-index, 0) *
                    var(--slides-show-hero-reveal-stagger, 140ms)
            );
        }

        [data-motion-hero-copy][data-motion-reveal][data-motion-state='revealed'] {
            opacity: 1;
            transform: translate3d(0, 0, 0);
            will-change: auto;
            transition:
                opacity var(--slides-show-hero-reveal-duration, 780ms)
                    var(--motion-ease-enter, cubic-bezier(0.22, 1, 0.36, 1)),
                transform var(--slides-show-hero-reveal-duration, 780ms)
                    var(--motion-ease-enter, cubic-bezier(0.22, 1, 0.36, 1));
            transition-delay: calc(
                var(--slides-show-hero-reveal-base-delay, 180ms) + var(--motion-index, 0) *
                    var(--slides-show-hero-reveal-stagger, 140ms)
            );
        }
    }

    .slides-show__nav-button {
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9999px;
        background-color: rgb(var(--color-background) / 0.5);
        color: rgb(var(--color-foreground));
        backdrop-filter: blur(8px);
        transition:
            background-color var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease),
            color var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease);
    }

    .slides-show__nav-button:hover {
        background-color: rgb(var(--color-background) / 0.8);
    }

    .slides-show__nav-button:focus-visible {
        outline: var(--focus-ring-width) solid
            rgba(var(--color-focus-ring), var(--focus-ring-opacity, 0.4));
        outline-offset: var(--focus-ring-offset);
    }

    .slides-show__pause-toggle {
        width: 5rem;
        height: 5rem;
    }

    .slides-show__pause-toggle::before {
        content: '\23F8';
        font-size: 0.75rem;
        line-height: 1;
    }

    .slides-show__pause-toggle[aria-pressed='true']::before {
        content: '\25B6';
    }
{% endstylesheet %}

{% schema %}
