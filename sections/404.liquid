<div
    data-section-id="{{ section.id }}"
    class="404-section full-width color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="404"
    data-component-id="{{ section.id }}"
>
    <div class="layout container-page">
        <div class="relative flex flex-col justify-between gap-40 overflow-hidden">
            {%- comment -%} Main Content {%- endcomment -%}
            <div class="relative">
                <h1
                    class="translate-y-5 text-[clamp(3rem,8vw,6rem)] leading-[1.05]  font-bold opacity-0"
                    data-gsap-title
                >
                    {{ section.settings.heading_line1 | default: '404' -}}
                    <br>
                    {{ section.settings.heading_line2 | default: 'Not Found' }}
                </h1>
                <p
                    class="pc:max-w-1/3 fw:max-w-1/2 max-w-2/3 translate-y-5 leading-relaxed opacity-0"
                    data-gsap-desc
                >
                    {{
                        section.settings.description
                        | default: 'Tailored experiences powered by AI intelligence. Discover insights that adapt to your needs.'
                    }}
                </p>

                {%- if section.settings.show_button -%}
                    <a
                        href="{{ section.settings.button_link | default: '/' }}"
                        class="
                            mt-8 inline-flex translate-y-5 items-center gap-2 rounded bg-[#2d3a2e] px-6 py-3 text-xl font-medium
                            text-white opacity-0 transition-colors hover:bg-[#3d4d3f]
                        "
                        data-gsap-btn
                    >
                        {{ section.settings.button_text | default: 'Back to Home' }}
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M5 12h14"/>
                            <path d="m12 5 7 7-7 7"/>
                        </svg>
                    </a>
                {%- endif -%}
            </div>

            {%- comment -%} Brand Watermark {%- endcomment -%}
            {% render 'watermark',
                container_class: 'relative z-0 w-full overflow-hidden pointer-events-none select-none',
                text_class: 'block text-[clamp(12vw,16vw,18vw)] font-bold leading-none text-[#e4e3df] whitespace-nowrap translate-y-[10%]',
                html_attr: 'data-gsap-watermark',
                text: section.settings.watermark_text
            %}
        </div>
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components || typeof gsap === 'undefined') return;

        Components.register(
            '404',
            {
                init(el) {
                    const ctx = gsap.context(() => {
                        const tl = gsap.timeline({
                            defaults: { ease: 'power2.out' },
                        });

                        tl.to(el.querySelector('[data-gsap-title]'), {
                            opacity: 1,
                            y: 0,
                            duration: 0.7,
                        })
                            .to(
                                el.querySelector('[data-gsap-desc]'),
                                {
                                    opacity: 1,
                                    y: 0,
                                    duration: 0.5,
                                },
                                '-=0.3',
                            )
                            .to(
                                el.querySelector('[data-gsap-btn]'),
                                {
                                    opacity: 1,
                                    y: 0,
                                    duration: 0.5,
                                },
                                '-=0.2',
                            )
                            .fromTo(
                                el.querySelector('[data-gsap-watermark]'),
                                {
                                    opacity: 0,
                                    x: 60,
                                },
                                {
                                    opacity: 1,
                                    x: 0,
                                    duration: 1,
                                    ease: 'power3.out',
                                },
                                '-=0.4',
                            );
                    }, el);

                    return { ctx };
                },

                destroy(el, state) {
                    if (state?.ctx) {
                        state.ctx.revert();
                    }
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{%- stylesheet -%}
{%- endstylesheet -%}

{% schema %}
{
    "name": "t:general.404",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["404"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "scheme-1"
        },
        {
            "type": "text",
            "id": "heading_line1",
            "default": "404",
            "label": "Heading line 1"
        },
        {
            "type": "text",
            "id": "heading_line2",
            "default": "Not Found",
            "label": "Heading line 2"
        },
        {
            "type": "textarea",
            "id": "description",
            "default": "Tailored experiences powered by AI intelligence. Discover insights that adapt to your needs.",
            "label": "Description"
        },
        {
            "type": "checkbox",
            "id": "show_button",
            "default": true,
            "label": "Show button"
        },
        {
            "type": "text",
            "id": "button_text",
            "default": "Back to Home",
            "label": "Button text"
        },
        {
            "type": "url",
            "id": "button_link",
            "default": "/",
            "label": "Button link"
        },
        {
            "type": "text",
            "id": "watermark_text",
            "default": "Eccenova®",
            "label": "Watermark text"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "t:general.404"
        }
    ]
}
{% endschema %}
