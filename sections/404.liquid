<div
    data-section-id="{{ section.id }}"
    class="404-section full-width color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="404"
    data-component-id="{{ section.id }}"
>
    <div class="layout container-page">
        <div class="flex flex-col gap-40 overflow-hidden">
            {%- comment -%} Main Content {%- endcomment -%}
            <div class="relative">
                <h1
                    class="hxxl pc:hxxxl font-bold"
                >
                    {{ section.settings.heading_line1 | default: '404' -}}
                    <br>
                    {{ section.settings.heading_line2 | default: 'Not Found' }}
                </h1>
                <p
                    class="pc:max-w-1/3 body-md max-w-2/3"
                >
                    {{
                        section.settings.description
                        | default: 'Tailored experiences powered by AI intelligence. Discover insights that adapt to your needs.'
                    }}
                </p>

                {%- if section.settings.show_button -%}
                    <a
                        href="{{ section.settings.button_link | default: '/' }}"
                        class="                            btn btn-primary mt-8"
                    >
                        {{ section.settings.button_text | default: 'Back to Home' }}

                        {% render 'icons',
                            icon: 'icon-arrow2',
                            size: 'lg',
                            class: 'ml-3',
                            color: 'current'
                        %}
                    </a>
                {%- endif -%}
            </div>

            {%- comment -%} Brand Watermark {%- endcomment -%}
            {% render 'watermark',
                container_class: 'relative w-full overflow-hidden pointer-events-none select-none',
                text_class: 'font-bold text-[#e4e3df]',
                text: section.settings.watermark_text
            %}
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:general.404",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["404"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "scheme-1"
        },
        {
            "type": "text",
            "id": "heading_line1",
            "default": "404",
            "label": "Heading line 1"
        },
        {
            "type": "text",
            "id": "heading_line2",
            "default": "Not Found",
            "label": "Heading line 2"
        },
        {
            "type": "textarea",
            "id": "description",
            "default": "Tailored experiences powered by AI intelligence. Discover insights that adapt to your needs.",
            "label": "Description"
        },
        {
            "type": "checkbox",
            "id": "show_button",
            "default": true,
            "label": "Show button"
        },
        {
            "type": "text",
            "id": "button_text",
            "default": "Back to Home",
            "label": "Button text"
        },
        {
            "type": "url",
            "id": "button_link",
            "default": "/",
            "label": "Button link"
        },
        {
            "type": "text",
            "id": "watermark_text",
            "default": "Eccenova®",
            "label": "Watermark text"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "t:general.404"
        }
    ]
}
{% endschema %}
