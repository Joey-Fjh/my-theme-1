{%- liquid
    assign not_found_heading_class = section.settings.heading_size | default: 'title-3xl'
    assign heading_line1 = section.settings.heading_line1
    assign heading_line2 = section.settings.heading_line2
    assign not_found_description = section.settings.description
    assign not_found_heading_ready = false
    if heading_line1 != blank or heading_line2 != blank
        assign not_found_heading_ready = true
    endif
    assign not_found_button_ready = false
    if section.settings.show_button and section.settings.button_text != blank
        assign not_found_button_ready = true
    endif
    assign not_found_copy_ready = false
    if not_found_heading_ready or not_found_description != blank or not_found_button_ready
        assign not_found_copy_ready = true
    endif
-%}
{%- capture not_found_heading_content -%}
    {%- if heading_line1 != blank -%}
        {{ heading_line1 -}}
    {%- endif -%}
    {%- if heading_line1 != blank and heading_line2 != blank -%}
        <br>
    {%- endif -%}
    {%- if heading_line2 != blank -%}
        {{ heading_line2 }}
    {%- endif -%}
{%- endcapture -%}
{%- capture not_found_children -%}
    <div class="not-found__stack">
        {%- if not_found_copy_ready -%}
            <div
                class="relative flex flex-col items-start gap-related p-step-xs"
            >
                {%- if not_found_heading_ready -%}
                    {% render 'heading',
                        level: '1',
                        tier: not_found_heading_class,
                        content: not_found_heading_content,
                    %}
                {%- endif -%}
                {%- if not_found_description != blank -%}
                    {% render 'text',
                        tier: 'copy-l',
                        element: 'div',
                        rte: true,
                        measure: '2/3',
                        class: 'tablet:max-w-1/3',
                        content: not_found_description,
                    %}
                {%- endif -%}

                {%- if section.settings.show_button -%}
                    {%- liquid
                        assign button_label = section.settings.button_text
                        assign link_href = section.settings.button_link
                        if link_href == blank or link_href == '/'
                            assign link_href = routes.root_url
                        endif
                    -%}
                    {%- if button_label != blank -%}
                        {%- capture button_content -%}
                            {{ button_label }}
                            {% render 'icons',
                                icon: 'icon-arrow2',
                                class: 'ms-step-xs'
                            %}
                        {%- endcapture -%}
                        {% render 'button',
                            href: link_href,
                            style: 'primary',
                            size: 'xl',
                            content: button_content
                        %}
                    {%- endif -%}
                {%- endif -%}
            </div>
        {%- endif -%}

        {% render 'watermark',
            container_class: 'relative w-full overflow-hidden pointer-events-none select-none',
            text: section.settings.watermark_text,
            html_attr: ''
        %}
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: '404-section',
    width: 'page',
    height_kind: 'stage',
    inner_class: 'section-frame__stage--center',
    motion: false,
    children: not_found_children
%}

{% stylesheet %}
    :where(.not-found__stack) {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-step-4xl);
        box-sizing: border-box;
        width: 100%;
        padding-inline: var(--page-inset);
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:general.404",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["404"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.404.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "title-4xl",
                    "label": "t:settings.type_size.title_4xl"
                },
                {
                    "value": "title-3xl",
                    "label": "t:settings.type_size.title_3xl"
                },
                {
                    "value": "title-2xl",
                    "label": "t:settings.type_size.title_2xl"
                },
                {
                    "value": "title-xl",
                    "label": "t:settings.type_size.title_xl"
                },
                {
                    "value": "title-l",
                    "label": "t:settings.type_size.title_l"
                },
                {
                    "value": "title-m",
                    "label": "t:settings.type_size.title_m"
                },
                {
                    "value": "title-s",
                    "label": "t:settings.type_size.title_s"
                },
                {
                    "value": "title-xs",
                    "label": "t:settings.type_size.title_xs"
                }
            ],
            "default": "title-3xl"
        },
        {
            "type": "inline_richtext",
            "id": "heading_line1",
            "default": "404",
            "label": "t:sections.404.settings.heading_line_1"
        },
        {
            "type": "inline_richtext",
            "id": "heading_line2",
            "default": "t:sections.404.defaults.heading_line_2",
            "label": "t:sections.404.settings.heading_line_2"
        },
        {
            "type": "richtext",
            "id": "description",
            "default": "t:sections.404.defaults.description_html",
            "label": "t:sections.404.settings.description"
        },
        {
            "type": "checkbox",
            "id": "show_button",
            "default": true,
            "label": "t:sections.404.settings.show_button"
        },
        {
            "type": "text",
            "id": "button_text",
            "default": "t:sections.404.defaults.button_text",
            "label": "t:sections.404.settings.button_text"
        },
        {
            "type": "url",
            "id": "button_link",
            "default": "/",
            "label": "t:sections.404.settings.button_link"
        },
        {
            "type": "text",
            "id": "watermark_text",
            "default": "t:sections.404.defaults.watermark_text",
            "label": "t:sections.404.settings.watermark_text"
        },
        {
            "type": "header",
            "content": "t:sections.404.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.404.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.404.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
