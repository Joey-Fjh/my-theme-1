<div
    data-section-id="{{ section.id }}"
    class="404-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="404"
    data-component-id="{{ section.id }}"
    x-data="motionRevealSection()"
    data-motion-section
>
    <div class="layout container-page flex min-h-[60vh] flex-col justify-center pc:min-h-[80vh]">
        <div class="flex flex-col gap-40 overflow-hidden">
            {%- assign fallback_heading_line2 = '404.heading_line_2' | t -%}
            {%- assign fallback_description = '404.description_html' | t -%}

            {%- comment -%} Main Content {%- endcomment -%}
            <div class="relative p-3" data-motion-reveal="content">
                <h1
                    class="heading-3xl pc:heading-4xl"
                >
                    {{ section.settings.heading_line1 | default: '404' -}}
                    <br>
                    {{ section.settings.heading_line2 | default: fallback_heading_line2 }}
                </h1>
                <div
                    class="rte rte--compact max-w-2/3 pc:max-w-1/3"
                >
                    {{ section.settings.description | default: fallback_description }}
                </div>

                {%- if section.settings.show_button -%}
                    {%- capture button_content -%}
                        {{ section.settings.button_text | default: 'Back to Home' }}

                        {% render 'icons',
                            icon: 'icon-arrow2',
                            class: 'ms-3'
                        %}
                    {%- endcapture -%}

                    {%- assign link_href = section.settings.button_link | default: '/' -%}
                    {% render 'link',
                        href: link_href,
                        class: 'mt-8 btn-primary',
                        variant: 'plain',
                        content: button_content
                    %}
                {%- endif -%}
            </div>

            {%- comment -%} Brand Watermark {%- endcomment -%}
            {% render 'watermark',
                container_class: 'relative w-full overflow-hidden pointer-events-none select-none',
                text: section.settings.watermark_text,
                html_attr: 'data-motion-reveal="media"'
            %}
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:general.404",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["404"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.404.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "inline_richtext",
            "id": "heading_line1",
            "default": "404",
            "label": "t:sections.404.settings.heading_line_1"
        },
        {
            "type": "inline_richtext",
            "id": "heading_line2",
            "default": "t:sections.404.defaults.heading_line_2",
            "label": "t:sections.404.settings.heading_line_2"
        },
        {
            "type": "richtext",
            "id": "description",
            "default": "t:sections.404.defaults.description_html",
            "label": "t:sections.404.settings.description"
        },
        {
            "type": "checkbox",
            "id": "show_button",
            "default": true,
            "label": "t:sections.404.settings.show_button"
        },
        {
            "type": "text",
            "id": "button_text",
            "default": "t:sections.404.defaults.button_text",
            "label": "t:sections.404.settings.button_text"
        },
        {
            "type": "url",
            "id": "button_link",
            "default": "/",
            "label": "t:sections.404.settings.button_link"
        },
        {
            "type": "text",
            "id": "watermark_text",
            "default": "t:sections.404.defaults.watermark_text",
            "label": "t:sections.404.settings.watermark_text"
        },
        {
            "type": "header",
            "content": "t:sections.404.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.404.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.404.settings.padding_bottom",
            "default": 0
        }
    ]
}
{% endschema %}
