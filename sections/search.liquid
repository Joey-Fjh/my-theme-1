{%- liquid
    assign terms = search.terms | strip
-%}

{%- capture search_children -%}
    {%- comment -%} Search form: always visible, independent of results {%- endcomment -%}
    <div{% unless search.performed %} class="flex flex-col items-center justify-center"{% endunless %}>
        <div
            class="mx-auto w-full px-4 pc:max-w-1/2 pc:px-0{% if search.performed %} py-10{% endif %}"
            data-module-id="predictive-search"
            x-data="predictiveSearch"
            data-predictive-search-enabled="{{ settings.predictive_search_enabled }}"
            data-search-url="{{ routes.search_url | escape }}"
            data-predictive-search-url="{{ routes.predictive_search_url | escape }}"
            data-predictive-search-query="{{ terms | escape }}"
            data-predictive-search-performed="{{ search.performed }}"
            data-toast-search-failed="{{ 'toast.search_failed' | t | escape }}"
        >
            <h1 class="sr-only">{{ 'search.title' | t }}</h1>

            <form
                action="{{ routes.search_url }}"
                method="get"
                @submit.prevent="performSearch()"
                role="search"
                class="relative w-full"
                :class="{ 'is-open': isOpen }"
                @click.outside="closePanel()"
            >
                <input type="hidden" name="options[prefix]" value="last">
                <input type="hidden" name="type" value="product">
                <div class="mb-1 flex items-center gap-3 border-b border-theme-border pb-3 text-theme-text">
                    {%- render 'icons', icon: 'icon-search', class: 'shrink-0' -%}
                    <label class="sr-only" for="SearchInput-{{ section.id }}">
                        {{ 'search.search' | t }}
                    </label>

                    <input
                        id="SearchInput-{{ section.id }}"
                        type="search"
                        name="q"
                        class="w-full flex-1 appearance-none border-none bg-transparent body-xl text-theme-text focus-ring outline-none placeholder:text-theme-text/50"
                        autocomplete="off"
                        :aria-expanded="isOpen"
                        placeholder="{{ 'search.search' | t }}"
                        x-model="query"
                        @input="onInput($event.target.value)"
                        @compositionend="onInput($event.target.value)"
                        @focus="openPanel()"
                        @click="openPanel()"
                        @keydown.escape.stop="closePanel()"
                        @keydown.enter.prevent="performSearch()"
                    >
                </div>

                {% render 'search-predictive-panel',
                    mobile_card_columns: section.settings.mobile_card_columns,
                    scope_id: section.id
                %}
            </form>
        </div>
    </div>

    {%- comment -%} Results tabs: only rendered after a search {%- endcomment -%}
    {% if search.performed %}
        <div class="search-section__results">
            {%- liquid
                assign q = search.terms | default: '' | strip | url_encode

                # A `type` query param narrows search.types to that one type (request.params does not
                # exist in Liquid, and search.types survives Section Rendering refreshes). Without it,
                # search.types lists every type, so pick the first type that has results.
                assign param_type = ''
                if search.types.size == 1
                    assign type_candidate = search.types.first | downcase | strip
                    if type_candidate == 'product' or type_candidate == 'article' or type_candidate == 'page'
                        assign param_type = type_candidate
                    endif
                endif

                if param_type == ''
                    for item in search.results
                        if item.object_type == 'product'
                            assign param_type = 'product'
                            break
                        endif
                    endfor
                endif

                if param_type == ''
                    for item in search.results
                        if item.object_type == 'article'
                            assign param_type = 'article'
                            break
                        endif
                    endfor
                endif

                if param_type == ''
                    for item in search.results
                        if item.object_type == 'page'
                            assign param_type = 'page'
                            break
                        endif
                    endfor
                endif

                if param_type == ''
                    assign param_type = 'product'
                endif

                assign active_tab_index = 0
                if param_type == 'article'
                    assign active_tab_index = 1
                elsif param_type == 'page'
                    assign active_tab_index = 2
                endif

                assign base_url = routes.search_url | append: '?q=' | append: q | append: '&options%5Bprefix%5D=last'
                assign products_url = base_url | append: '&type=product'
                assign articles_url = base_url | append: '&type=article'
                assign pages_url = base_url | append: '&type=page'
            -%}

            {%- render 'search-results-tabs',
                section_id: section.id,
                active_tab_index: active_tab_index,
                products_url: products_url,
                articles_url: articles_url,
                pages_url: pages_url,
                param_type: param_type,
                search_per_page: section.settings.search_per_page,
                mobile_card_columns: section.settings.mobile_card_columns,
                color_scheme: section.settings.color_scheme
            -%}
        </div>
    {% endif %}
{%- endcapture -%}

{%- liquid
    # Without results, the form centres in the 50svh minimum (padding included), as before the frame.
    assign search_root_class = 'min-h-[50svh]'
    assign search_inner_class = ''
    unless search.performed
        assign search_root_class = 'grid min-h-[50svh] grid-rows-[minmax(0,1fr)]'
        assign search_inner_class = 'grid-rows-[minmax(0,1fr)]'
    endunless
-%}

{% render 'section-frame',
    section: section,
    section_class: 'search-section',
    root_class: search_root_class,
    inner_class: search_inner_class,
    width: 'page',
    height_kind: 'content',
    clip: false,
    children: search_children
%}

{% stylesheet %}
    /* Before the frame, the form and the results were two padded blocks: keep both paddings between them. */
    .search-section__results {
        padding-top: calc(var(--section-frame-padding-bottom) + var(--section-frame-padding-top));
    }

    .search-section {
        .product-grid {
            width: 100%;
            display: grid;
            grid-template-columns: repeat(var(--product-grid-columns-mobile), minmax(0, 1fr));
            gap: 3px;

            @media (width >= 48rem) {
                grid-template-columns: repeat(var(--product-grid-columns), minmax(0, 1fr));
                gap: 8px;
            }
        }
    }

    @layer snippets {
        .search-predictive-panel {
            .product-card-shell__brand {
                font-family: var(--font-body-family);
                font-style: var(--font-body-style);
                line-height: var(--font-body-line-height);
                letter-spacing: var(--font-body-letter-spacing);
                text-transform: var(--font-body-text-transform);
                word-break: break-word;
                font-size: calc(var(--font-body-size-mobile) * var(--font-body-scale) * 0.75);
                @media (width >= 48rem) {
                    font-size: calc(var(--font-body-size) * var(--font-body-scale) * 0.875);
                }
            }
            .product-card-shell__title,
            .product-card-shell__price {
                font-family: var(--font-body-family);
                font-style: var(--font-body-style);
                line-height: var(--font-body-line-height);
                letter-spacing: var(--font-body-letter-spacing);
                text-transform: var(--font-body-text-transform);
                word-break: break-word;
                font-size: calc(var(--font-body-size-mobile) * var(--font-body-scale) * 0.875);
                @media (width >= 48rem) {
                    font-size: calc(var(--font-body-size) * var(--font-body-scale));
                }
                --tw-font-weight: var(--font-weight-medium);
                font-weight: var(--font-weight-medium);
            }
            .predictive-search-product-card__title {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:general.search",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["search"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.search.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "range",
            "id": "search_per_page",
            "min": 3,
            "max": 24,
            "step": 3,
            "default": 12,
            "label": "t:sections.search.settings.search_per_page"
        },
        {
            "type": "select",
            "id": "mobile_card_columns",
            "label": "t:sections.search.settings.mobile_product_card_columns",
            "default": "2",
            "options": [
                {
                    "value": "1",
                    "label": "t:sections.collection.options.1_column"
                },
                {
                    "value": "2",
                    "label": "t:sections.collection.options.2_columns"
                }
            ]
        },
        {
            "type": "header",
            "content": "t:sections.search.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.search.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.search.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
