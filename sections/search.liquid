{%- liquid
    assign terms = search.terms | strip
-%}

<div
    data-section-id="{{ section.id }}"
    class="
        search-section full-width min-h-[50vh]
        color-{{ section.settings.color_scheme }} bg-theme-bg text-theme-text
    "
    style="
        --section-padding-top: {{ section.settings.padding_top | default: 0 }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    "
    data-component-kind="section"
    data-component-type="search-section"
    data-component-id="{{ section.id }}"
>
    <div class="layout container-page overflow-visible!">
        <div
            class="mx-auto w-full pc:max-w-1/2"
            x-data="predictiveSearch"
            data-predictive-search-url="{{ routes.search_url }}"
            data-predictive-search-query="{{ terms | escape }}"
            data-predictive-search-performed="{{ search.performed }}"
        >
            <form
                @submit.prevent="performSearch()"
                role="search"
                class="relative w-full"
                @click.outside="closePanel()"
            >
                <div class="mb-1 flex items-center gap-3 border-b border-theme-border pb-3 text-theme-text">
                    {%- render 'icons', icon: 'icon-search', class: 'shrink-0' -%}

                    <input
                        id="SearchInput-{{ section.id }}"
                        type="search"
                        name="q"
                        class="w-full flex-1 appearance-none border-none bg-transparent body-xl text-theme-text outline-none placeholder:text-theme-text/50"
                        autocomplete="off"
                        :aria-expanded="isOpen"
                        placeholder="{{ 'search.search' | t }}"
                        x-model="query"
                        @input="onInput($event.target.value)"
                        @compositionend="onInput($event.target.value)"
                        @focus="openPanel()"
                        @click="openPanel()"
                        @keydown.escape.stop="closePanel()"
                        @keydown.enter.prevent="performSearch()"
                    >
                </div>

                {% render 'search-predictive-panel' %}
            </form>
        </div>

        {% if search.performed %}
            {%- liquid
                assign q = search.terms | default: '' | strip | url_encode
                assign param_type = request.params.type | default: '' | downcase | strip

                if param_type != 'product' and param_type != 'article' and param_type != 'page'
                    assign param_type = 'product'
                endif

                assign active_tab_index = 0
                if param_type == 'article'
                    assign active_tab_index = 1
                elsif param_type == 'page'
                    assign active_tab_index = 2
                endif

                assign base_url = routes.search_url | append: '?q=' | append: q | append: '&options%5Bprefix%5D=last'
                assign products_url = base_url | append: '&type=product'
                assign articles_url = base_url | append: '&type=article'
                assign pages_url = base_url | append: '&type=page'
            -%}

            {%- render 'search-results-tabs',
                section_id: section.id,
                active_tab_index: active_tab_index,
                products_url: products_url,
                articles_url: articles_url,
                pages_url: pages_url,
                param_type: param_type,
                search_per_page: section.settings.search_per_page
            -%}
        {% endif %}
    </div>
</div>

{% schema %}
{
    "name": "t:general.search",
    "tag": "section",
    "class": "section",
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.search.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "range",
            "id": "search_per_page",
            "min": 3,
            "max": 24,
            "step": 3,
            "default": 12,
            "label": "t:sections.search.settings.search_per_page"
        },
        {
            "type": "header",
            "content": "t:sections.search.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.search.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.search.settings.padding_bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "t:general.search",
            "settings": {}
        }
    ]
}
{% endschema %}
