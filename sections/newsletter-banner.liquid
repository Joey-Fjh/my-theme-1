{%- liquid
    assign banner_aspect_mobile = '9/16'
    assign banner_aspect_desktop = '16/9'
    if section.settings.background_image != blank
        if section.settings.background_image.width != blank and section.settings.background_image.height != blank
            assign banner_aspect_desktop = section.settings.background_image.width | append: '/' | append: section.settings.background_image.height
        endif
    endif

    assign newsletter_banner_heading_class = section.settings.heading_size | default: 'heading-xl'
    assign newsletter_banner_subtitle_size = section.settings.subtitle_size | default: 'body-3xl'
    assign newsletter_banner_subtitle_class = 'typo-subtitle ' | append: newsletter_banner_subtitle_size
-%}
<div
    data-section-id="{{ section.id }}"
    class="newsletter-banner-section full-width color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="motionRevealSection()"
    data-motion-section
>
    <div class="layout container-page">
        <div
            class="newsletter-banner__media relative overflow-hidden"
            style="
                --newsletter-banner-aspect-mobile: {{ banner_aspect_mobile }};
                --newsletter-banner-aspect-desktop: {{ banner_aspect_desktop }};
            "
        >
            {% comment %} Background Image {% endcomment %}
            {%- assign image_alt = section.settings.background_image.alt
                | default: section.settings.heading
                | escape
            -%}
            {%- render 'image',
                class: '!absolute inset-0',
                image: section.settings.background_image,
                alt: image_alt,
                width: section.settings.background_image.width,
                mode: 'frame',
                fit: section.settings.background_image_fit,
                position: section.settings.background_image_position
            -%}

            {% comment %} Frosted glass center overlay {% endcomment %}
            {%- assign blur_enabled = section.settings.enable_blur_overlay
                | default: true, allow_false: true
            -%}
            {%- assign blur_r = section.settings.blur_radius | default: 12 -%}
            {%- if blur_enabled and blur_r > 0 -%}
                <div
                    class="absolute inset-0"
                    style="
                        backdrop-filter: blur({{ blur_r }}px);
                        -webkit-backdrop-filter: blur({{ blur_r }}px);
                        mask-image: radial-gradient(ellipse {{ section.settings.blur_mask_width | default: 50 }}% {{ section.settings.blur_mask_height | default: 80 }}% at {{ section.settings.blur_position_x | default: 50 }}% {{ section.settings.blur_position_y | default: 50 }}%, black 0%, transparent 100%);
                        -webkit-mask-image: radial-gradient(ellipse {{ section.settings.blur_mask_width | default: 50 }}% {{ section.settings.blur_mask_height | default: 80 }}% at {{ section.settings.blur_position_x | default: 50 }}% {{ section.settings.blur_position_y | default: 50 }}%, black 0%, transparent 100%);
                    "
                ></div>
            {%- endif -%}

            {% comment %} Content {% endcomment %}
            <div
                class="relative z-10 flex h-full flex-col items-center justify-center gap-2.5 px-3.5 text-center pc:gap-6 pc:px-4"
                data-motion-reveal="content"
            >
                <p class="{{ newsletter_banner_subtitle_class }}">
                    {{ section.settings.subtitle }}
                </p>
                <h2 class="{{ newsletter_banner_heading_class }}">
                    {{ section.settings.heading }}
                </h2>
                <div
                    class="mt-4 w-full max-w-3xl pc:mt-0"
                    x-data="newsletterBanner()"
                    data-newsletter-success-message="{{ 'newsletter.success_message' | t | json }}"
                    data-newsletter-error-message="{{ 'newsletter.error_message' | t | json }}"
                    @submit.prevent="submit($event)"
                >
                    {%- assign email_placeholder_fallback = 'newsletter.email_placeholder' | t -%}
                    {%- form 'customer' -%}
                        <input type="hidden" name="customer[accepts_marketing]" value="true">
                        <input type="hidden" name="customer[tags]" value="newsletter">

                        <div class="inline-submit-field">
                            <input
                                type="email"
                                name="customer[email]"
                                placeholder="{{ section.settings.placeholder | default: email_placeholder_fallback | escape }}"
                                required
                                class="inline-submit-field__input"
                            >
                            <button
                                type="submit"
                                class="inline-submit-field__button inline-submit-field__button--icon"
                                aria-label="{{ 'newsletter.subscribe' | t }}"
                                :disabled="isLoading"
                            >
                                <span x-show="!isLoading">
                                    {%- render 'icons', icon: 'icon-arrow2' -%}
                                </span>
                                <span x-show="isLoading" x-cloak>
                                    {% render 'loading',
                                        size: 'small',
                                        spinner_color: 'border-current'
                                    %}
                                </span>
                            </button>
                        </div>
                    {%- endform -%}
                </div>
            </div>
        </div>
    </div>
</div>

{% stylesheet %}
    .newsletter-banner-section .newsletter-banner__media {
        aspect-ratio: var(--newsletter-banner-aspect-mobile, 9/16);
        min-height: 32rem;
    }

    @media (width >= 48rem) {
        .newsletter-banner-section .newsletter-banner__media {
            aspect-ratio: var(--newsletter-banner-aspect-desktop, 16/9);
            min-height: 0;
        }
    }

    /* Mobile-only inline-submit-field sizing for this section's hero form layout.
       Scoped here — not in components.css — so newsletter-overlay and other
       inline-submit-field consumers keep the default component chrome. */
    @media (width < 768px) {
        .newsletter-banner-section .inline-submit-field__input {
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
            border-start-end-radius: 0;
            border-end-end-radius: 0;
        }

        .newsletter-banner-section .inline-submit-field__button--icon {
            width: auto;
            min-width: 2.75rem;
            height: auto;
            aspect-ratio: auto;
            align-self: stretch;
            padding-inline: 0.75rem;
        }
    }
{% endstylesheet %}

{% schema %}
