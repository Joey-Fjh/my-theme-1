<div
    data-section-id="{{ section.id }}"
    class="newsletter-banner-section full-width"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <div class="layout container-page text-[#FFFFFF]">
        <div class="relative aspect-1392/480 overflow-hidden">
            {% comment %} Background Image {% endcomment %}
            {%- render 'image', 
                class: '!absolute inset-0',
                image: section.settings.background_image,
                alt: section.settings.background_image.alt,
                width: section.settings.background_image.width 
            -%}

            {% comment %} Frosted glass center overlay {% endcomment %}
            <div class="absolute inset-0 backdrop-blur-md"
                style="mask-image: radial-gradient(ellipse 60% 80% at center, black 0%, transparent 100%); 
                -webkit-mask-image: radial-gradient(ellipse 60% 80% at center, black 0%, transparent 100%);"
            ></div>

            {% comment %} Content {% endcomment %}
            <div class="relative z-10 flex h-full flex-col items-center justify-center px-4 text-center gap-6 opacity-100">
                <p class="opacity-80 tracking-wide">
                    {{ section.settings.subtitle }}
                </p>
                <h1 class="font-medium">
                    {{ section.settings.heading }}
                </h1>
                {% form 'customer', class: 'w-full max-w-xl' %}
                    <input type="hidden" name="customer[accepts_marketing]" value="true">
                    <input type="hidden" name="customer[tags]" value="newsletter">

                    <div
                        class="flex overflow-hidden bg-white"
                    >
                        <input
                            type="email"
                            name="customer[email]"
                            x-model="email"
                            placeholder="{{ section.settings.placeholder | default: 'Enter your email address' }}"
                            required
                            class="flex-1 bg-transparent p-5 text-xl text-stone-700 placeholder-stone-400 outline-none"
                        />
                        <button
                            type="submit"
                            class="flex items-center justify-center px-5 text-stone-500 transition-colors hover:text-stone-800"
                            :disabled="loading"
                        >
                            <svg
                                x-show="!loading"
                                class="h-5 w-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                            </svg>
                            <svg
                                x-show="loading"
                                x-cloak
                                class="h-5 w-5 animate-spin"
                                fill="none"
                                viewBox="0 0 24 24"
                            >
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                            </svg>
                        </button>
                    </div>
                {% endform %}
            </div>
        </div>
    </div>
</div>

{% schema %}
  {
    "name": "NewSletter Banner",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header","footer"]
    },
    "settings": [
        {
            "type": "image_picker",
            "id": "background_image",
            "label": "Background Image"
        },
        {
            "type": "inline_richtext",
            "id": "subtitle",
            "label": "Subtitle",
            "default": "Limited Time Offer"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "Heading",
            "default": "Up To 50% Off Everything"
        },
        {
            "type": "text",
            "id": "placeholder",
            "label": "Input Placeholder",
            "default": "Enter your email address"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "presets": [
      {
        "name": "NewSletter Banner",
        "settings": {
        }
      }
    ]
  }
{% endschema %}