<div
    data-section-id="{{ section.id }}"
    class="
        newsletter-banner-section full-width
        color-{{ section.settings.color_scheme }}
    "
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <div class="layout container-page">
        <div class="relative aspect-square overflow-hidden pc:aspect-1392/480">
            {% comment %} Background Image {% endcomment %}
            {%- render 'image',
                class: '!absolute inset-0',
                image: section.settings.background_image,
                alt: section.settings.background_image.alt,
                width: section.settings.background_image.width
            -%}

            {% comment %} Frosted glass center overlay {% endcomment %}
            <div
                class="absolute inset-0 backdrop-blur-md"
                style="
                    mask-image: radial-gradient(ellipse 60% 80% at center, black 0%, transparent 100%);
                    -webkit-mask-image: radial-gradient(ellipse 60% 80% at center, black 0%, transparent 100%);
                "
            ></div>

            {% comment %} Content {% endcomment %}
            <div class="relative z-10 flex h-full flex-col items-center justify-center gap-4 px-4 text-center text-theme-text opacity-100 pc:gap-6">
                <p class="body-md opacity-80 pc:body-lg">
                    {{ section.settings.subtitle }}
                </p>
                <h1 class="h2 pc:h1">
                    {{ section.settings.heading }}
                </h1>
                {% form 'customer', class: 'mt-4 w-full max-w-xl pc:mt-0' %}
                    <input type="hidden" name="customer[accepts_marketing]" value="true">
                    <input type="hidden" name="customer[tags]" value="newsletter">

                    <div class="flex w-full flex-col gap-3 pc:flex-row">
                        <input
                            type="email"
                            name="customer[email]"
                            x-model="email"
                            placeholder="{{ section.settings.placeholder | default: 'newsletter.email_placeholder' | t }}"
                            required
                            class="field flex-1"
                        >
                        <button
                            type="submit"
                            class="btn w-full btn-primary pc:w-auto"
                            :disabled="loading"
                        >
                            <span x-show="!loading" class="pc:hidden">
                                {{- 'newsletter.subscribe' | t -}}
                            </span>
                            <span x-show="!loading">
                                {%- render 'icons',
                                    icon: 'icon-arrow2',
                                    size: 'md',
                                    color: 'current'
                                -%}
                            </span>
                            <span x-show="loading" x-cloak>
                                {%- render 'loading',
                                    size: 'small',
                                    spinner_color: 'border-current'
                                -%}
                            </span>
                        </button>
                    </div>
                {% endform %}
            </div>
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:sections.newsletter-banner.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.newsletter-banner.settings.color_scheme",
            "default": "color-scheme-1"
        },
        {
            "type": "image_picker",
            "id": "background_image",
            "label": "t:sections.newsletter-banner.settings.background_image"
        },
        {
            "type": "inline_richtext",
            "id": "subtitle",
            "label": "t:sections.newsletter-banner.settings.subtitle",
            "default": "t:sections.newsletter-banner.defaults.subtitle"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "t:sections.newsletter-banner.settings.heading",
            "default": "t:sections.newsletter-banner.defaults.heading"
        },
        {
            "type": "text",
            "id": "placeholder",
            "label": "t:sections.newsletter-banner.settings.input_placeholder",
            "default": "t:sections.newsletter-banner.defaults.input_placeholder"
        },
        {
            "type": "header",
            "content": "t:sections.newsletter-banner.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.newsletter-banner.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.newsletter-banner.settings.padding_bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "t:sections.newsletter-banner.presets.newsletter_banner",
            "settings": {}
        }
    ]
}
{% endschema %}
