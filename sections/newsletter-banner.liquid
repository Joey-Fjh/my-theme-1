<div
    data-section-id="{{ section.id }}"
    class="newsletter-banner-section full-width color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <div class="layout container-page">
        <div class="relative aspect-square overflow-hidden pc:aspect-1392/480">
            {% comment %} Background Image {% endcomment %}
            {%- assign image_alt = section.settings.background_image.alt
                | default: section.settings.heading
                | escape
            -%}
            {%- render 'image',
                class: '!absolute inset-0',
                image: section.settings.background_image,
                alt: image_alt,
                width: section.settings.background_image.width
            -%}

            {% comment %} Frosted glass center overlay {% endcomment %}
            {%- assign blur_enabled = section.settings.enable_blur_overlay
                | default: true, allow_false: true
            -%}
            {%- assign blur_r = section.settings.blur_radius | default: 12 -%}
            {%- if blur_enabled and blur_r > 0 -%}
                <div
                    class="absolute inset-0"
                    style="
                        backdrop-filter: blur({{ blur_r }}px);
                        -webkit-backdrop-filter: blur({{ blur_r }}px);
                        mask-image: radial-gradient(ellipse {{ section.settings.blur_mask_width | default: 50 }}% {{ section.settings.blur_mask_height | default: 80 }}% at {{ section.settings.blur_position_x | default: 50 }}% {{ section.settings.blur_position_y | default: 50 }}%, black 0%, transparent 100%);
                        -webkit-mask-image: radial-gradient(ellipse {{ section.settings.blur_mask_width | default: 50 }}% {{ section.settings.blur_mask_height | default: 80 }}% at {{ section.settings.blur_position_x | default: 50 }}% {{ section.settings.blur_position_y | default: 50 }}%, black 0%, transparent 100%);
                    "
                ></div>
            {%- endif -%}

            {% comment %} Content {% endcomment %}
            <div class="relative z-10 flex h-full flex-col items-center justify-center gap-4 px-4 text-center pc:gap-6">
                <p class="body-lg">
                    {{ section.settings.subtitle }}
                </p>
                <h1>
                    {{ section.settings.heading }}
                </h1>
                <div
                    class="mt-4 w-full max-w-3xl pc:mt-0"
                    x-data="newsletterBanner()"
                    data-newsletter-success-message="{{ 'newsletter.success_message' | t | json }}"
                    data-newsletter-error-message="{{ 'newsletter.error_message' | t | json }}"
                    @submit.prevent="submit($event)"
                >
                    {%- assign email_placeholder_fallback = 'newsletter.email_placeholder' | t -%}
                    {%- form 'customer' -%}
                        <input type="hidden" name="customer[accepts_marketing]" value="true">
                        <input type="hidden" name="customer[tags]" value="newsletter">

                        <div class="flex w-full flex-col gap-3 pc:grid pc:grid-cols-[minmax(0,1fr)_auto]">
                            <input
                                type="email"
                                name="customer[email]"
                                placeholder="{{ section.settings.placeholder | default: email_placeholder_fallback | escape }}"
                                required
                                class="min-h-0 field flex-1"
                            >
                            <button
                                type="submit"
                                class="btn-primary btn h-12 w-full shrink-0 pc:aspect-square pc:h-full pc:w-auto pc:px-0"
                                aria-label="{{ 'newsletter.subscribe' | t }}"
                                :disabled="isLoading"
                            >
                                <span x-show="!isLoading" class="pc:hidden">
                                    {{- 'newsletter.subscribe' | t -}}
                                </span>
                                <span x-show="!isLoading">
                                    {%- render 'icons', icon: 'icon-arrow2' -%}
                                </span>
                                <span x-show="isLoading" x-cloak>
                                    {% render 'loading',
                                        size: 'small',
                                        spinner_color: 'border-current'
                                    %}
                                </span>
                            </button>
                        </div>
                    {%- endform -%}
                </div>
            </div>
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:sections.newsletter-banner.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.newsletter-banner.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "image_picker",
            "id": "background_image",
            "label": "t:sections.newsletter-banner.settings.background_image"
        },
        {
            "type": "inline_richtext",
            "id": "subtitle",
            "label": "t:sections.newsletter-banner.settings.subtitle",
            "default": "t:sections.newsletter-banner.defaults.subtitle"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "t:sections.newsletter-banner.settings.heading",
            "default": "t:sections.newsletter-banner.defaults.heading"
        },
        {
            "type": "text",
            "id": "placeholder",
            "label": "t:sections.newsletter-banner.settings.input_placeholder",
            "default": "t:sections.newsletter-banner.defaults.input_placeholder"
        },
        {
            "type": "header",
            "content": "t:sections.newsletter-banner.content.blur_overlay"
        },
        {
            "type": "checkbox",
            "id": "enable_blur_overlay",
            "label": "t:sections.newsletter-banner.settings.enable_blur_overlay",
            "default": true
        },
        {
            "type": "range",
            "id": "blur_radius",
            "min": 0,
            "max": 40,
            "step": 1,
            "unit": "px",
            "label": "t:sections.newsletter-banner.settings.blur_radius",
            "default": 12
        },
        {
            "type": "range",
            "id": "blur_mask_width",
            "min": 10,
            "max": 100,
            "step": 5,
            "unit": "%",
            "label": "t:sections.newsletter-banner.settings.blur_mask_width",
            "default": 60
        },
        {
            "type": "range",
            "id": "blur_mask_height",
            "min": 10,
            "max": 100,
            "step": 5,
            "unit": "%",
            "label": "t:sections.newsletter-banner.settings.blur_mask_height",
            "default": 80
        },
        {
            "type": "range",
            "id": "blur_position_x",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "%",
            "label": "t:sections.newsletter-banner.settings.blur_position_x",
            "default": 50
        },
        {
            "type": "range",
            "id": "blur_position_y",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "%",
            "label": "t:sections.newsletter-banner.settings.blur_position_y",
            "default": 50
        },
        {
            "type": "header",
            "content": "t:sections.newsletter-banner.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.newsletter-banner.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.newsletter-banner.settings.padding_bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "t:sections.newsletter-banner.presets.newsletter_banner",
            "settings": {}
        }
    ]
}
{% endschema %}
