{%- liquid
    assign pick_up_availabilities = product_variant.store_availabilities | where: 'pick_up_enabled', true
    assign has_pickup_availability = false
    if pick_up_availabilities.size > 0
        assign has_pickup_availability = true
    endif
-%}

<div data-pickup-availability-fragment>
    <div
        data-pickup-availability-content
        data-empty="{% if has_pickup_availability %}false{% else %}true{% endif %}"
    >
        {%- if has_pickup_availability -%}
            {%- assign closest_location = pick_up_availabilities.first -%}

            <div class="rounded-sm border border-line px-4 py-4 pc:px-5">
                <div class="flex items-start gap-3">
                    <span
                        class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full {% if closest_location.available %}bg-theme-bg text-muted{% else %}border border-theme-border text-theme-text{% endif %}"
                        aria-hidden="true"
                    >
                        {% if closest_location.available %}
                            {% render 'icons', icon: 'icon-check' %}
                        {% else %}
                            {% render 'icons', icon: 'icon-close' %}
                        {% endif %}
                    </span>

                    <div class="min-w-0 flex-1">
                        <p>
                            {% if closest_location.available %}
                                {{
                                    'products.product.pickup_availability.available_at_html'
                                    | t: location_name: closest_location.location.name
                                }}
                            {% else %}
                                {{
                                    'products.product.pickup_availability.unavailable_at_html'
                                    | t: location_name: closest_location.location.name
                                }}
                            {% endif %}
                        </p>

                        {% if closest_location.available
                            and closest_location.pick_up_time != blank
                        %}
                            {% render 'text',
                                tier: 'body-sm',
                                class: 'mt-1',
                                content: closest_location.pick_up_time
                            %}
                        {% endif %}

                        <details class="group mt-3">
                            <summary class="flex cursor-pointer list-none items-center gap-2 rounded-sm focus-ring [&::-webkit-details-marker]:hidden">
                                <span>
                                    {% if pick_up_availabilities.size == 1 %}
                                        {{
                                            'products.product.pickup_availability.view_store_info'
                                            | t
                                        }}
                                    {% else %}
                                        {{
                                            'products.product.pickup_availability.check_other_stores'
                                            | t
                                        }}
                                    {% endif %}
                                </span>
                                {% render 'icons',
                                    icon: 'icon-arrow2',
                                    class: 'transition-transform group-open:rotate-90'
                                %}
                            </summary>

                            <ul class="panel-motion panel-motion-disclosure panel-motion-disclosure--fluid mt-4 flex flex-col gap-4 border-t border-line pt-4">
                                {%- for availability in pick_up_availabilities -%}
                                    {%- assign address = availability.location.address -%}
                                    <li class="flex flex-col gap-2">
                                        <div class="flex items-start justify-between gap-4">
                                            <h3>
                                                {{ availability.location.name }}
                                            </h3>

                                            <p class="text-end">
                                                {% if availability.available %}
                                                    {{
                                                        'products.product.pickup_availability.available'
                                                        | t
                                                    }}
                                                {% else %}
                                                    {{
                                                        'products.product.pickup_availability.unavailable'
                                                        | t
                                                    }}
                                                {% endif %}
                                            </p>
                                        </div>

                                        {% if availability.available
                                            and availability.pick_up_time != blank
                                        %}
                                            <p>
                                                {{ availability.pick_up_time }}
                                            </p>
                                        {% endif %}

                                        <div>
                                            {{ address | format_address }}
                                        </div>

                                        {% if address.phone != blank %}
                                            <p>
                                                {{ address.phone }}
                                            </p>
                                        {% endif %}
                                    </li>
                                {%- endfor -%}
                            </ul>
                        </details>
                    </div>
                </div>
            </div>
        {%- endif -%}
    </div>
</div>

{% stylesheet %}
    @layer components {
        .panel-motion-disclosure {
            --panel-motion-dur: var(--panel-motion-duration-disclosure);
            overflow: hidden;
            max-height: 0;
            opacity: 0;
            pointer-events: none;
        }
        details[open] > .panel-motion-disclosure {
            max-height: var(--panel-motion-disclosure-max-height);
            pointer-events: auto;
            animation: panel-motion-disclosure-in var(--panel-motion-dur)
                var(--panel-motion-ease-soft) both;
        }
        details[open] > .panel-motion-disclosure--fluid {
            max-height: none;
            overflow: visible;
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.pickup-availability.name",
    "enabled_on": {
        "templates": ["product"]
    },
    "settings": []
}
{% endschema %}
