{% assign layout = section.settings.gallery_layout | default: 'thumbnails' %}
{% assign thumb_position = section.settings.thumbnail_position | default: 'left' %}
{% assign media_locks_info_height = true %}

<div
    data-section-id="{{ section.id }}"
    class="product-section full-width color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top | default: 0 }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    "
    data-component-kind="section"
    data-component-type="product"
    data-component-id="{{ section.id }}"
>
    <div
        class="layout container-page bg-theme-bg text-theme-text"
        style="{% if layout == 'stacked' %}overflow: clip;{% endif %}"
    >
        <div
            class="grid w-full min-w-0 grid-cols-1 items-start gap-8 pc:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] pc:items-stretch pc:gap-12 fw:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]"
        >
            <div
                class="min-w-0 {% if media_locks_info_height %}overflow-hidden{% endif %}"
                {% if media_locks_info_height %}
                    data-product-media-panel
                {% endif %}
            >
                {%- render 'product-gallery',
                    images: product.images,
                    layout: layout,
                    thumb_position: thumb_position,
                    thumbnail_visible_count: section.settings.thumbnail_visible_count,
                    zoom: 'true',
                    zoom_overlay_color: section.settings.zoom_overlay_color,
                    zoom_overlay_opacity: section.settings.zoom_overlay_opacity,
                    aspect_ratio: '576/622'
                -%}
            </div>

            <div
                class="min-w-0 {% if media_locks_info_height %}min-h-0 overflow-hidden pc:contain-[size]{% endif %}"
                {% if media_locks_info_height %}
                    data-product-info-panel
                {% endif %}
            >
                <div
                    class="{% if media_locks_info_height %}min-h-0{% else %}self-start{% endif %}"
                    style="{% if layout == 'stacked' %}position: sticky;top: calc(var(--header-height) + var(--announcement-bar-height));{% endif %}"
                >
                    {%- render 'product-info-blocks',
                        product: product,
                        section: section,
                        context: 'product',
                        container_class: 'p-6 pc:p-10'
                    -%}
                </div>
            </div>
        </div>
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components) return;

        function constrainDescription(el) {
            const mediaPanel = el.querySelector('[data-product-media-panel]');
            const infoBlocks = el.querySelector('[data-product-info-panel] .product-info-blocks');
            const descriptionBlock = infoBlocks?.querySelector(
                '.product-info-blocks__description-block',
            );
            const description = descriptionBlock?.querySelector(
                '.product-info-blocks__description',
            );
            if (!mediaPanel || !infoBlocks || !descriptionBlock || !description) return {};

            const desktopQuery = window.matchMedia('(min-width: 48rem)');
            let frame = 0;

            const reset = () => {
                infoBlocks.style.removeProperty('max-height');
                descriptionBlock.style.removeProperty('max-height');
                description.style.removeProperty('max-height');
            };

            const sync = () => {
                if (frame) cancelAnimationFrame(frame);
                frame = requestAnimationFrame(() => {
                    frame = 0;

                    if (!desktopQuery.matches) {
                        reset();
                        return;
                    }

                    const mediaHeight = mediaPanel.getBoundingClientRect().height;
                    if (mediaHeight <= 0) {
                        reset();
                        return;
                    }

                    const rootStyles = window.getComputedStyle(document.documentElement);
                    const headerHeight =
                        parseFloat(rootStyles.getPropertyValue('--header-height')) || 0;
                    const announcementHeight =
                        parseFloat(rootStyles.getPropertyValue('--announcement-bar-height')) || 0;
                    const viewportHeight = window.visualViewport?.height || window.innerHeight;
                    const maxReferenceHeight = Math.max(
                        360,
                        viewportHeight - headerHeight - announcementHeight,
                    );
                    const referenceHeight = Math.min(mediaHeight, maxReferenceHeight);

                    const styles = window.getComputedStyle(infoBlocks);
                    const gap = parseFloat(styles.rowGap || styles.gap) || 0;
                    const paddingY =
                        (parseFloat(styles.paddingTop) || 0) +
                        (parseFloat(styles.paddingBottom) || 0);
                    const children = Array.from(infoBlocks.children).filter(
                        (child) => child instanceof HTMLElement,
                    );
                    const otherBlocksHeight = children.reduce((total, child) => {
                        if (child === descriptionBlock) return total;
                        return total + child.getBoundingClientRect().height;
                    }, 0);
                    const gapsHeight = gap * Math.max(children.length - 1, 0);
                    const available = Math.max(
                        0,
                        referenceHeight - paddingY - gapsHeight - otherBlocksHeight,
                    );

                    infoBlocks.style.maxHeight = `${Math.round(referenceHeight)}px`;
                    descriptionBlock.style.maxHeight = `${Math.floor(available)}px`;
                    description.style.maxHeight = `${Math.floor(available)}px`;
                });
            };

            const resizeObserver = new ResizeObserver(sync);
            resizeObserver.observe(mediaPanel);
            Array.from(infoBlocks.children).forEach((child) => resizeObserver.observe(child));

            window.addEventListener('resize', sync);
            desktopQuery.addEventListener('change', sync);
            sync();

            return {
                description,
                descriptionBlock,
                desktopQuery,
                frame,
                infoBlocks,
                reset,
                resizeObserver,
                sync,
            };
        }

        Components.register(
            'product',
            {
                init(el) {
                    return constrainDescription(el);
                },

                destroy(el, state) {
                    if (state?.frame) cancelAnimationFrame(state.frame);
                    state?.resizeObserver?.disconnect?.();
                    window.removeEventListener('resize', state?.sync);
                    state?.desktopQuery?.removeEventListener?.('change', state?.sync);
                    state?.reset?.();
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{% schema %}
{
    "name": "t:general.product",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "scheme-1"
        },
        {
            "type": "select",
            "id": "gallery_layout",
            "label": "Image layout",
            "options": [
                { "value": "thumbnails", "label": "Thumbnails" },
                { "value": "carousel", "label": "Carousel" },
                { "value": "stacked", "label": "Stacked" },
                { "value": "grid", "label": "Grid" }
            ],
            "default": "thumbnails"
        },
        {
            "type": "select",
            "id": "thumbnail_position",
            "label": "Thumbnail position",
            "options": [
                { "value": "left", "label": "Left" },
                { "value": "bottom", "label": "Bottom" }
            ],
            "default": "left",
            "info": "Applies when Image layout is set to Thumbnails."
        },
        {
            "type": "select",
            "id": "thumbnail_visible_count",
            "label": "Visible thumbnails",
            "options": [
                { "value": "3", "label": "3" },
                { "value": "4", "label": "4" },
                { "value": "5", "label": "5" },
                { "value": "6", "label": "6" }
            ],
            "default": "4",
            "info": "Applies when Image layout is set to Thumbnails and thumbnail position is left."
        },
        {
            "type": "color",
            "id": "zoom_overlay_color",
            "label": "Zoom overlay color",
            "default": "#000000"
        },
        {
            "type": "range",
            "id": "zoom_overlay_opacity",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "%",
            "label": "Zoom overlay opacity",
            "default": 90
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "title",
            "name": "Title",
            "limit": 1
        },
        {
            "type": "price",
            "name": "Price",
            "limit": 1
        },
        {
            "type": "description",
            "name": "Description",
            "limit": 1
        },
        {
            "type": "variant_picker",
            "name": "Variant picker",
            "limit": 1,
            "settings": [
                {
                    "type": "select",
                    "id": "picker_type",
                    "label": "Style",
                    "options": [
                        { "value": "dropdown", "label": "Dropdown" },
                        { "value": "button", "label": "Pills" }
                    ],
                    "default": "button"
                },
                {
                    "type": "select",
                    "id": "swatch_shape",
                    "label": "Swatch shape",
                    "options": [
                        { "value": "circle", "label": "Circle" },
                        { "value": "square", "label": "Square" },
                        { "value": "none", "label": "None" }
                    ],
                    "default": "circle"
                }
            ]
        },
        {
            "type": "quantity_selector",
            "name": "Quantity selector",
            "limit": 1
        },
        {
            "type": "buy_buttons",
            "name": "Buy buttons",
            "limit": 1,
            "settings": [
                {
                    "type": "checkbox",
                    "id": "show_dynamic_checkout",
                    "label": "Show dynamic checkout buttons",
                    "info": "Using the payment methods available on your store, customers see their preferred option, like PayPal or Apple Pay.",
                    "default": false
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:general.product",
            "settings": {},
            "blocks": [
                { "type": "title" },
                { "type": "price" },
                { "type": "description" },
                { "type": "variant_picker" },
                { "type": "quantity_selector" },
                { "type": "buy_buttons" }
            ]
        }
    ]
}
{% endschema %}
