{% assign layout = section.settings.gallery_layout | default: 'thumbnails' %}
{% assign thumb_position = section.settings.thumbnail_position | default: 'left' %}
{% assign desktop_media_width = section.settings.desktop_media_width | default: 60 | plus: 0 %}
{% assign desktop_info_width = 100 | minus: desktop_media_width %}

<div
    data-section-id="{{ section.id }}"
    class="product-section full-width color-{{ section.settings.color_scheme }} bg-theme-bg text-theme-text"
    style="
        --section-padding-top: {{ section.settings.padding_top | default: 0 }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    "
    data-component-kind="section"
    data-component-type="product"
    data-component-id="{{ section.id }}"
>
    <div class="layout container-page overflow-visible!">
        <div
            class="grid w-full min-w-0 grid-cols-1 items-start gap-8 pc:grid-cols-[minmax(0,var(--product-media-fr))_minmax(0,var(--product-info-fr))] pc:items-stretch pc:gap-10 fw:gap-12"
            style="
                --product-media-fr: {{ desktop_media_width }}fr;
                --product-info-fr: {{ desktop_info_width }}fr;
            "
        >
            <div
                class="flex min-w-0 flex-col gap-8"
                data-product-media-column
            >
                <div
                    class="min-w-0 overflow-hidden"
                    data-product-media-panel
                    data-product-media-sticky-target
                >
                    {%- render 'product-gallery',
                        images: product.images,
                        layout: layout,
                        thumb_position: thumb_position,
                        thumbnail_visible_count: section.settings.thumbnail_visible_count,
                        zoom: 'true',
                        magnifier: 'true',
                        magnifier_preview_width: section.settings.magnifier_preview_size,
                        magnifier_preview_height: section.settings.magnifier_preview_size,
                        zoom_overlay_color: section.settings.zoom_overlay_color,
                        zoom_overlay_opacity: section.settings.zoom_overlay_opacity,
                        aspect_ratio: '3/4'
                    -%}
                </div>
            </div>

            <div class="min-w-0" data-product-info-panel>
                <div
                    class="self-start"
                    data-product-info-sticky-target
                >
                    {%- render 'product-info-blocks',
                        product: product,
                        section: section,
                        context: 'product',
                        container_class: 'p-6 pc:p-10'
                    -%}
                </div>
            </div>
        </div>
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        const Utils = window.__Theme__?.Utils;
        if (!Components || !Utils?.setupProductLayout) return;

        Components.register(
            'product',
            {
                init(el) {
                    return Utils.setupProductLayout(el);
                },

                destroy(el, state) {
                    if (state?.frame) cancelAnimationFrame(state.frame);
                    state?.resizeObserver?.disconnect?.();
                    window.removeEventListener('resize', state?.sync);
                    state?.desktopQuery?.removeEventListener?.('change', state?.sync);
                    state?.reset?.();
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{% schema %}
{
    "name": "t:general.product",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "scheme-1"
        },
        {
            "type": "select",
            "id": "gallery_layout",
            "label": "Image layout",
            "options": [
                { "value": "thumbnails", "label": "Thumbnails" },
                { "value": "carousel", "label": "Carousel" },
                { "value": "stacked", "label": "Stacked" },
                { "value": "grid", "label": "Grid" }
            ],
            "default": "thumbnails"
        },
        {
            "type": "select",
            "id": "thumbnail_position",
            "label": "Thumbnail position",
            "options": [
                { "value": "left", "label": "Left" },
                { "value": "bottom", "label": "Bottom" }
            ],
            "default": "left",
            "info": "Applies when Image layout is set to Thumbnails."
        },
        {
            "type": "range",
            "id": "desktop_media_width",
            "min": 40,
            "max": 60,
            "step": 1,
            "unit": "%",
            "label": "Desktop media width",
            "default": 60
        },
        {
            "type": "select",
            "id": "thumbnail_visible_count",
            "label": "Bottom visible thumbnails",
            "options": [
                { "value": "3", "label": "3" },
                { "value": "4", "label": "4" },
                { "value": "5", "label": "5" },
                { "value": "6", "label": "6" }
            ],
            "default": "4",
            "info": "Applies when Image layout is set to Thumbnails and thumbnail position is bottom."
        },
        {
            "type": "range",
            "id": "magnifier_preview_size",
            "min": 240,
            "max": 520,
            "step": 20,
            "unit": "px",
            "label": "Magnifier preview size",
            "default": 360
        },
        {
            "type": "color",
            "id": "zoom_overlay_color",
            "label": "Zoom overlay color",
            "default": "#000000"
        },
        {
            "type": "range",
            "id": "zoom_overlay_opacity",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "%",
            "label": "Zoom overlay opacity",
            "default": 90
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "@app"
        },
        {
            "type": "title",
            "name": "Title",
            "limit": 1
        },
        {
            "type": "price",
            "name": "Price",
            "limit": 1
        },
        {
            "type": "description",
            "name": "Description",
            "limit": 1
        },
        {
            "type": "variant_picker",
            "name": "Variant picker",
            "limit": 1,
            "settings": [
                {
                    "type": "select",
                    "id": "picker_type",
                    "label": "Style",
                    "options": [
                        { "value": "dropdown", "label": "Dropdown" },
                        { "value": "button", "label": "Pills" }
                    ],
                    "default": "button"
                },
                {
                    "type": "select",
                    "id": "swatch_shape",
                    "label": "Swatch shape",
                    "options": [
                        { "value": "circle", "label": "Circle" },
                        { "value": "square", "label": "Square" },
                        { "value": "none", "label": "None" }
                    ],
                    "default": "circle"
                }
            ]
        },
        {
            "type": "quantity_selector",
            "name": "Quantity selector",
            "limit": 1
        },
        {
            "type": "buy_buttons",
            "name": "Buy buttons",
            "limit": 1,
            "settings": [
                {
                    "type": "checkbox",
                    "id": "show_dynamic_checkout",
                    "label": "Show dynamic checkout buttons",
                    "info": "Using the payment methods available on your store, customers see their preferred option, like PayPal or Apple Pay.",
                    "default": false
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:general.product",
            "settings": {},
            "blocks": [
                { "type": "title" },
                { "type": "price" },
                { "type": "description" },
                { "type": "variant_picker" },
                { "type": "quantity_selector" },
                { "type": "buy_buttons" }
            ]
        }
    ]
}
{% endschema %}
