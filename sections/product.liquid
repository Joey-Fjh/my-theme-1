{% assign layout = section.settings.gallery_layout | default: 'thumbnails' %}
{% assign thumb_position = section.settings.thumbnail_position | default: 'left' %}
{% assign desktop_media_width = section.settings.desktop_media_width | default: 60 | plus: 0 %}
{% assign desktop_info_width = 100 | minus: desktop_media_width %}
{% assign media_aspect_ratio = section.settings.media_aspect_ratio | default: 'portrait_3_4' %}
{% assign gallery_aspect_ratio = '3/4' %}
{% case media_aspect_ratio %}
    {% when 'square_1_1' %}
        {% assign gallery_aspect_ratio = '1/1' %}
{% endcase %}
{% assign desktop_media_height = section.settings.desktop_media_height | default: 'balanced' %}
{% assign desktop_media_max_height = blank %}
{% case desktop_media_height %}
    {% when 'compact' %}
        {% assign desktop_media_max_height = '80svh' %}
    {% when 'balanced' %}
        {% assign desktop_media_max_height = '90svh' %}
    {% when 'full_screen' %}
        {% assign desktop_media_max_height = '100svh' %}
{% endcase %}
{% assign has_gallery_blocks = false %}
{% for block in section.blocks %}
    {% if block.type == 'description' and block.settings.position_desktop == 'gallery' %}
        {% assign has_gallery_blocks = true %}
    {% elsif block.type == 'collapsible_tab'
        and block.settings.collapsible_tab_position_desktop == 'gallery'
    %}
        {% assign has_gallery_blocks = true %}
    {% elsif block.type == 'share' and block.settings.share_position_desktop == 'gallery' %}
        {% assign has_gallery_blocks = true %}
    {% elsif block.type == 'callout' and block.settings.callout_position_desktop == 'gallery' %}
        {% assign has_gallery_blocks = true %}
    {% elsif block.type == 'icon_with_text_group'
        and block.settings.icon_with_text_position_desktop == 'gallery'
    %}
        {% assign has_gallery_blocks = true %}
    {% elsif block.type == 'spacer' and block.settings.spacer_position_desktop == 'gallery' %}
        {% assign has_gallery_blocks = true %}
    {% endif %}
{% endfor %}

<div
    data-section-id="{{ section.id }}"
    class="product-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top | default: 0 }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    "
    x-data="productLayout"
>
    <div class="layout container-page overflow-visible!">
        <div
            class="grid w-full min-w-0 grid-cols-1 items-start gap-8 pc:grid-cols-[minmax(0,var(--product-media-fr))_minmax(0,var(--product-info-fr))] pc:items-stretch pc:gap-10 fw:gap-12"
            style="
                --product-media-fr: {{ desktop_media_width }}fr;
                --product-info-fr: {{ desktop_info_width }}fr;
            "
        >
            <div
                class="flex min-w-0 flex-col gap-8"
                data-product-media-column
            >
                <div
                    class="min-w-0 overflow-hidden"
                    data-product-media-panel
                    data-product-media-sticky-target
                >
                    {%- assign id = 'product-gallery-' | append: section.id -%}
                    {%- render 'product-gallery',
                        media: product.media,
                        id: id,
                        layout: layout,
                        thumb_position: thumb_position,
                        thumbnail_visible_count: section.settings.thumbnail_visible_count,
                        zoom: 'true',
                        magnifier: 'true',
                        magnifier_preview_width: section.settings.magnifier_preview_size,
                        magnifier_preview_height: section.settings.magnifier_preview_size,
                        zoom_overlay_color: section.settings.zoom_overlay_color,
                        zoom_overlay_opacity: section.settings.zoom_overlay_opacity,
                        aspect_ratio: gallery_aspect_ratio,
                        max_height: desktop_media_max_height
                    -%}
                </div>

                {%- if has_gallery_blocks -%}
                    {%- render 'product-info-blocks',
                        product: product,
                        section: section,
                        context: 'product',
                        render_column: 'gallery'
                    -%}
                {%- endif -%}
            </div>

            <div class="min-w-0" data-product-info-panel>
                <div
                    class="self-start"
                    data-product-info-sticky-target
                >
                    {%- render 'product-info-blocks',
                        product: product,
                        section: section,
                        context: 'product',
                        render_column: 'form',
                        container_class: 'px-6 py-4 pc:px-10 pc:py-6'
                    -%}
                </div>
            </div>
        </div>
    </div>
</div>

