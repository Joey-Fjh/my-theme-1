{%- liquid
    assign editorial_collage_heading_class = section.settings.heading_size | default: 'title-xl'
    case editorial_collage_heading_class
        when 'title-4xl'
            assign editorial_collage_heading_tiers = 'title-l desktop:title-4xl'
        when 'title-3xl'
            assign editorial_collage_heading_tiers = 'title-l desktop:title-3xl'
        when 'title-2xl'
            assign editorial_collage_heading_tiers = 'title-m desktop:title-2xl'
        when 'title-xl'
            assign editorial_collage_heading_tiers = 'title-m desktop:title-xl'
        when 'title-l'
            assign editorial_collage_heading_tiers = 'title-m desktop:title-l'
        when 'title-m'
            assign editorial_collage_heading_tiers = 'title-s desktop:title-m'
        when 'title-s'
            assign editorial_collage_heading_tiers = 'title-s desktop:title-s'
        when 'title-xs'
            assign editorial_collage_heading_tiers = 'title-xs desktop:title-xs'
        else
            assign editorial_collage_heading_tiers = 'title-m desktop:title-xl'
    endcase

    if section.settings.heading != blank
        assign editorial_collage_heading_text = section.settings.heading
    else
        assign editorial_collage_heading_text = 'sections.editorial-collage.defaults.heading' | t
    endif

    if section.settings.text != blank
        assign editorial_collage_body = section.settings.text
    else
        assign editorial_collage_body = 'sections.editorial-collage.defaults.text' | t | prepend: '<p>' | append: '</p>'
    endif

    assign editorial_collage_texture = section.settings.texture_image
    assign editorial_collage_product = section.settings.product_image
    assign editorial_collage_detail = section.settings.detail_image

    assign editorial_collage_texture_alt = editorial_collage_texture.alt | escape
    assign editorial_collage_product_alt = editorial_collage_product.alt | escape
    assign editorial_collage_detail_alt = editorial_collage_detail.alt | escape
-%}

{%- capture editorial_collage_children -%}
    <div
        class="grid grid-cols-1 gap-step-l desktop:grid-cols-[minmax(0,55fr)_minmax(0,42fr)]"
        data-motion-cascade
    >
        <div
            class="flex flex-col gap-step-s desktop:col-start-1 desktop:row-start-1"
            data-motion-bound
        >
            <h2 class="text-theme-text">
                <span class="{{ editorial_collage_heading_tiers }}">{{ editorial_collage_heading_text }}</span>
            </h2>
            <div class="rte copy-m text-theme-text">{{ editorial_collage_body }}</div>
        </div>

        <div class="desktop:col-start-2 desktop:row-start-1" data-motion-bound>
            <div class="editorial-collage__media editorial-collage__media--texture">
                {%- if editorial_collage_texture != blank -%}
                    {%- render 'image',
                        image: editorial_collage_texture,
                        alt: editorial_collage_texture_alt,
                        mode: 'frame',
                        fit: 'cover',
                        loading: 'lazy',
                        sizes: '(min-width: 64rem) 42vw, 100vw',
                        widths: '400,600,800,1000,1200,1600',
                        wrapper: 'div',
                        wrapper_class: 'editorial-collage__image-wrap',
                        img_class: 'editorial-collage__img'
                    -%}
                {%- else -%}
                    <div class="editorial-collage__image-wrap editorial-collage__image-wrap--placeholder">
                        {% render 'decorative-placeholder-svg',
                            placeholder_key: 'lifestyle-1',
                            class: 'editorial-collage__placeholder-svg'
                        %}
                    </div>
                {%- endif -%}
            </div>
        </div>

        <div class="grid grid-cols-2 gap-step-m desktop:contents">
            <div class="desktop:col-start-1 desktop:row-start-2" data-motion-bound>
                <div class="editorial-collage__media editorial-collage__media--product">
                    {%- if editorial_collage_product != blank -%}
                        {%- render 'image',
                            image: editorial_collage_product,
                            alt: editorial_collage_product_alt,
                            mode: 'frame',
                            fit: 'cover',
                            loading: 'lazy',
                            sizes: '(min-width: 64rem) 55vw, 50vw',
                            widths: '400,600,800,1000,1200,1600,2000',
                            wrapper: 'div',
                            wrapper_class: 'editorial-collage__image-wrap',
                            img_class: 'editorial-collage__img'
                        -%}
                    {%- else -%}
                        <div class="editorial-collage__image-wrap editorial-collage__image-wrap--placeholder">
                            {% render 'decorative-placeholder-svg',
                                placeholder_key: 'product-1',
                                class: 'editorial-collage__placeholder-svg'
                            %}
                        </div>
                    {%- endif -%}
                </div>
            </div>

            <div class="desktop:col-start-2 desktop:row-start-2" data-motion-bound>
                <div class="editorial-collage__media editorial-collage__media--detail">
                    {%- if editorial_collage_detail != blank -%}
                        {%- render 'image',
                            image: editorial_collage_detail,
                            alt: editorial_collage_detail_alt,
                            mode: 'frame',
                            fit: 'cover',
                            loading: 'lazy',
                            sizes: '(min-width: 64rem) 42vw, 50vw',
                            widths: '400,600,800,1000,1200,1600',
                            wrapper: 'div',
                            wrapper_class: 'editorial-collage__image-wrap',
                            img_class: 'editorial-collage__img'
                        -%}
                    {%- else -%}
                        <div class="editorial-collage__image-wrap editorial-collage__image-wrap--placeholder">
                            {% render 'decorative-placeholder-svg',
                                placeholder_key: 'lifestyle-2',
                                class: 'editorial-collage__placeholder-svg'
                            %}
                        </div>
                    {%- endif -%}
                </div>
            </div>
        </div>
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: 'editorial-collage-section',
    width: 'page',
    height_kind: 'content',
    motion: true,
    children: editorial_collage_children
%}

{% stylesheet %}
    .editorial-collage__media {
        overflow: hidden;
        border-radius: var(--radius-card);
    }

    .editorial-collage__image-wrap {
        height: 100%;
        width: 100%;
    }

    .editorial-collage__img {
        height: 100%;
        width: 100%;
        object-fit: cover;
    }

    .editorial-collage__placeholder-svg {
        height: 100%;
        width: 100%;
        object-fit: cover;
    }

    .editorial-collage__image-wrap--placeholder {
        display: flex;
        height: 100%;
        width: 100%;
        background-color: rgb(var(--color-background));

        @supports (background-color: color-mix(in oklab, white, black)) {
            background-color: var(--color-surface-muted);
        }
    }

    .editorial-collage__media--texture {
        aspect-ratio: 417 / 254;
    }

    @media (width < 64rem) {
        .editorial-collage__media--product,
        .editorial-collage__media--detail {
            aspect-ratio: 545 / 410;
        }
    }

    @media (width >= 64rem) {
        .editorial-collage__media--product {
            aspect-ratio: 545 / 410;
        }

        .editorial-collage__media--detail {
            aspect-ratio: 417 / 410;
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.editorial-collage.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer", "custom.overlay"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.editorial-collage.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "t:sections.editorial-collage.settings.heading"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "title-4xl",
                    "label": "t:settings.type_size.title_4xl"
                },
                {
                    "value": "title-3xl",
                    "label": "t:settings.type_size.title_3xl"
                },
                {
                    "value": "title-2xl",
                    "label": "t:settings.type_size.title_2xl"
                },
                {
                    "value": "title-xl",
                    "label": "t:settings.type_size.title_xl"
                },
                {
                    "value": "title-l",
                    "label": "t:settings.type_size.title_l"
                },
                {
                    "value": "title-m",
                    "label": "t:settings.type_size.title_m"
                },
                {
                    "value": "title-s",
                    "label": "t:settings.type_size.title_s"
                },
                {
                    "value": "title-xs",
                    "label": "t:settings.type_size.title_xs"
                }
            ],
            "default": "title-xl"
        },
        {
            "type": "richtext",
            "id": "text",
            "label": "t:sections.editorial-collage.settings.text"
        },
        {
            "type": "header",
            "content": "t:sections.editorial-collage.content.images"
        },
        {
            "type": "image_picker",
            "id": "texture_image",
            "label": "t:sections.editorial-collage.settings.texture_image"
        },
        {
            "type": "image_picker",
            "id": "product_image",
            "label": "t:sections.editorial-collage.settings.product_image"
        },
        {
            "type": "image_picker",
            "id": "detail_image",
            "label": "t:sections.editorial-collage.settings.detail_image"
        },
        {
            "type": "header",
            "content": "t:sections.editorial-collage.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.editorial-collage.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.editorial-collage.settings.padding_bottom",
            "default": 32
        }
    ],
    "presets": [
        {
            "name": "t:sections.editorial-collage.presets.editorial_collage",
            "settings": {
                "heading": "An object of everyday care.",
                "text": "<p>More than just skincare, Ceylune is a daily ritual: a moment of calm, a return to yourself. Crafted with nature's finest, it brings balance to your skin and peace to your mind.</p>"
            }
        }
    ]
}
{% endschema %}
