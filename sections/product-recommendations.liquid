{%- liquid
    assign recommendation_type = section.settings.recommendation_type | default: 'related'
    assign default_heading = 'Related products'
    if recommendation_type == 'complementary'
        assign default_heading = 'Complementary products'
    endif
    assign heading = section.settings.heading | default: default_heading
    assign description = section.settings.description
    assign limit = section.settings.limit | default: 4
    assign empty_text = 'No related products available right now.'
    assign loading_text = 'Loading related products...'
    assign timeout_text = 'Request timed out. You can retry loading related products.'
    assign error_text = 'Failed to load related products.'
    if recommendation_type == 'complementary'
        assign empty_text = 'No complementary products available right now.'
        assign loading_text = 'Loading complementary products...'
        assign timeout_text = 'Request timed out. You can retry loading complementary products.'
        assign error_text = 'Failed to load complementary products.'
    endif
-%}

<section
    data-section-id="{{ section.id }}"
    class="
        product-recommendations-section full-width color-{{ section.settings.color_scheme }}
        bg-theme-bg text-theme-text
    "
    style="
        --section-padding-top: {{ section.settings.padding_top | default: 0 }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    "
    data-component-kind="section"
    data-component-type="product-recommendations"
    data-component-id="{{ section.id }}"
>
    {% render 'product-recommendations-section',
        product: product,
        section: section,
        heading: heading,
        description: description,
        limit: limit,
        intent: recommendation_type,
        empty_text: empty_text,
        loading_text: loading_text,
        timeout_text: timeout_text,
        error_text: error_text,
        retry_text: 'Retry'
    %}
</section>

{% schema %}
{
    "name": "Product recommendations",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["product"]
    },
    "settings": [
        {
            "type": "select",
            "id": "recommendation_type",
            "label": "Recommendation type",
            "options": [
                { "value": "related", "label": "Related products" },
                { "value": "complementary", "label": "Complementary products" }
            ],
            "default": "related"
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "scheme-1"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "Heading",
            "default": "Related Product"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description",
            "default": "<p>Personalized with AI insight. Personalized with AI insight. Personalized with AI insight.</p>"
        },
        {
            "type": "range",
            "id": "limit",
            "label": "Products limit",
            "min": 2,
            "max": 12,
            "step": 1,
            "default": 4
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "Product recommendations"
        }
    ]
}
{% endschema %}
