{%- liquid
    assign heading = section.settings.heading | default: 'Related Product'
    assign description = section.settings.description
    assign limit = section.settings.limit | default: 4

    assign base_url = routes.product_recommendations_url
-%}

<section
    data-section-id="{{ section.id }}"
    class="
        product-recommendations-section full-width color-{{ section.settings.color_scheme }}
        bg-theme-bg text-theme-text
    "
    style="
        --section-padding-top: {{ section.settings.padding_top | default: 0 }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    "
    data-component-kind="section"
    data-component-type="product-recommendations"
    data-component-id="{{ section.id }}"
>
    {%- if product -%}
        {%- capture rec_url -%}
            {{- base_url -}}?product_id={{ product.id }}&section_id={{ section.id }}&limit={{ limit }}&intent=related
        {%- endcapture -%}

        <div
            class="layout container-page py-12 pc:py-16"
            data-related-products-url="{{ rec_url | strip_newlines | escape }}"
            data-related-products-section-id="{{ section.id }}"
            x-data="relatedProducts()"
        >
            <div data-related-products-content>
                {%- if recommendations.performed -%}
                    {%- if recommendations.products_count > 0 -%}
                        <div class="flex flex-col items-start justify-between gap-4 pc:flex-row pc:gap-8">
                            <h1>{{ heading }}</h1>
                            {%- if description != blank -%}
                                <p class="max-w-md body-md leading-relaxed text-theme-text/70">
                                    {{ description }}
                                </p>
                            {%- endif -%}
                        </div>

                        <div class="mt-8 grid grid-cols-2 gap-6 pc:grid-cols-4">
                            {%- for product in recommendations.products -%}
                                {% render 'product-card', product: product %}
                            {%- endfor -%}
                        </div>
                    {%- else -%}
                        <div class="flex flex-col items-start justify-between gap-4 pc:flex-row pc:gap-8">
                            <h1>{{ heading }}</h1>
                            {%- if description != blank -%}
                                <p class="max-w-md body-md leading-relaxed text-theme-text/70">
                                    {{ description }}
                                </p>
                            {%- endif -%}
                        </div>
                        <p class="mt-8 body-md text-theme-text/70" role="status" aria-live="polite">
                            No related products available right now.
                        </p>
                    {%- endif -%}
                {%- else -%}
                    <div class="flex flex-col items-start justify-between gap-4 pc:flex-row pc:gap-8">
                        <h1>{{ heading }}</h1>
                        {%- if description != blank -%}
                            <p class="max-w-md body-md leading-relaxed text-theme-text/70">
                                {{ description }}
                            </p>
                        {%- endif -%}
                    </div>

                    <div
                        class="mt-8 grid grid-cols-2 gap-6 pc:grid-cols-4"
                        x-show="uiState == 'idle' || uiState == 'loading'"
                        x-cloak
                    >
                        {%- for i in (1..limit) -%}
                            <div class="border border-theme-border-soft bg-theme-bg p-4">
                                <div class="aspect-square animate-pulse bg-theme-border-soft"></div>
                                <div
                                    class="mt-4 h-4 w-3/4 animate-pulse bg-theme-border-soft"
                                ></div>
                                <div
                                    class="mt-2 h-4 w-1/2 animate-pulse bg-theme-border-soft"
                                ></div>
                            </div>
                        {%- endfor -%}
                    </div>

                    <p
                        class="mt-6 body-md text-theme-text/70"
                        role="status"
                        aria-live="polite"
                        x-show="uiState == 'loading'"
                        x-cloak
                    >
                        Loading related products... <span x-text="loadingSeconds"></span>s
                    </p>

                    <div
                        class="mt-6 flex flex-wrap items-center gap-3"
                        x-show="uiState == 'timeout'"
                        x-cloak
                    >
                        <p class="body-md text-theme-text/70" role="status" aria-live="polite">
                            Request timed out. You can retry loading related products.
                        </p>
                        <button
                            type="button"
                            class="border border-theme-border-soft px-3 py-2 body-md transition-opacity hover:opacity-70"
                            @click="retry()"
                        >
                            Retry
                        </button>
                    </div>

                    <div
                        class="mt-6 flex flex-wrap items-center gap-3"
                        x-show="uiState == 'error'"
                        x-cloak
                    >
                        <p class="body-md text-theme-text/70" role="status" aria-live="polite">
                            Failed to load related products.
                        </p>
                        <button
                            type="button"
                            class="border border-theme-border-soft px-3 py-2 body-md transition-opacity hover:opacity-70"
                            @click="retry()"
                        >
                            Retry
                        </button>
                    </div>
                {%- endif -%}
            </div>
        </div>
    {%- endif -%}
</section>

{% schema %}
{
    "name": "Related products",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["product"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "scheme-1"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Related Product"
        },
        {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "Personalized with AI insight. Personalized with AI insight. Personalized with AI insight."
        },
        {
            "type": "range",
            "id": "limit",
            "label": "Products limit",
            "min": 2,
            "max": 12,
            "step": 1,
            "default": 4
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "Related products"
        }
    ]
}
{% endschema %}
