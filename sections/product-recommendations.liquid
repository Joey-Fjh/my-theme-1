{%- liquid
    assign recommendation_type = section.settings.recommendation_type | default: 'related'
    assign default_heading = 'components.product_recommendations.heading_related' | t
    if recommendation_type == 'complementary'
        assign default_heading = 'components.product_recommendations.heading_complementary' | t
    endif
    assign heading = section.settings.heading | default: default_heading
    assign description = section.settings.description
    assign limit = section.settings.limit | default: 4

    assign empty_key = 'components.product_recommendations.empty_related'
    assign loading_key = 'components.product_recommendations.loading_related'
    assign timeout_key = 'components.product_recommendations.timeout_related'
    assign error_key = 'components.product_recommendations.error_related'
    if recommendation_type == 'complementary'
        assign empty_key = 'components.product_recommendations.empty_complementary'
        assign loading_key = 'components.product_recommendations.loading_complementary'
        assign timeout_key = 'components.product_recommendations.timeout_complementary'
        assign error_key = 'components.product_recommendations.error_complementary'
    endif
-%}

<section
    data-section-id="{{ section.id }}"
    class="product-recommendations-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top | default: 0 }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    "
    x-data="motionRevealSection()"
    data-motion-section
>
    {%- assign recommendations_empty_text = empty_key | t -%}
    {%- assign recommendations_loading_text = loading_key | t -%}
    {%- assign recommendations_timeout_text = timeout_key | t -%}
    {%- assign recommendations_error_text = error_key | t -%}
    {%- assign recommendations_retry_text = 'components.product_recommendations.retry' | t -%}
    {%- render 'product-recommendations-section',
        product: product,
        section: section,
        recommendations: recommendations,
        heading: heading,
        description: description,
        limit: limit,
        intent: recommendation_type,
        empty_text: recommendations_empty_text,
        loading_text: recommendations_loading_text,
        timeout_text: recommendations_timeout_text,
        error_text: recommendations_error_text,
        retry_text: recommendations_retry_text
    -%}
</section>

{% schema %}
{
    "name": "t:sections.product-recommendations.name",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["product"]
    },
    "settings": [
        {
            "type": "select",
            "id": "recommendation_type",
            "label": "t:sections.product-recommendations.settings.recommendation_type",
            "options": [
                {
                    "value": "related",
                    "label": "t:sections.product-recommendations.options.related_products"
                },
                {
                    "value": "complementary",
                    "label": "t:sections.product-recommendations.options.complementary_products"
                }
            ],
            "default": "related"
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.product-recommendations.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "t:sections.product-recommendations.settings.heading",
            "default": "t:sections.product-recommendations.defaults.heading"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "t:sections.product-recommendations.settings.description",
            "default": "t:sections.product-recommendations.defaults.description"
        },
        {
            "type": "range",
            "id": "limit",
            "label": "t:sections.product-recommendations.settings.products_limit",
            "min": 2,
            "max": 12,
            "step": 1,
            "default": 4
        },
        {
            "type": "header",
            "content": "t:sections.product-recommendations.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.product-recommendations.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.product-recommendations.settings.padding_bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "t:sections.product-recommendations.presets.product_recommendations"
        }
    ]
}
{% endschema %}
