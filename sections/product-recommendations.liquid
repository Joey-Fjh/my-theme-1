{%- liquid
    assign heading = section.settings.heading | default: 'Related Product'
    assign description = section.settings.description
    assign limit = section.settings.limit | default: 4
    assign bg_color = section.settings.bg_color | default: '#F3F3F3'

    assign base_url = routes.product_recommendations_url
-%}

<section
    data-section-id="{{ section.id }}"
    class="product-recommendations-section full-width"
    style="background-color: {{ bg_color }};"
    data-component-kind="section"
    data-component-type="product-recommendations"
    data-component-id="{{ section.id }}"
>
    {%- if product -%}
        {%- capture rec_url -%}
      {{- base_url -}}?product_id={{ product.id }}&section_id={{ section.id }}&limit={{ limit }}&intent=related
    {%- endcapture -%}

        <div
            class="layout container-page py-12 pc:py-16"
            x-data="relatedProducts({ url: {{ rec_url | strip_newlines | json }}, sectionId: {{ section.id | json }} })"
        >
            <div data-related-products-content>
                {%- if recommendations.performed -%}
                    {%- if recommendations.products_count > 0 -%}
                        <div class="flex items-start justify-between gap-8 text-[#263D29]">
                            <h2 class="h2">{{ heading }}</h2>
                            {%- if description != blank -%}
                                <p class="max-w-md text-sm leading-relaxed opacity-70">
                                    {{ description }}
                                </p>
                            {%- endif -%}
                        </div>

                        <div class="mt-8 grid grid-cols-2 gap-6 pc:grid-cols-4">
                            {%- for product in recommendations.products -%}
                                {% render 'product-card',
                                    product: product,
                                    class: 'border border-[#F2F3F0]'
                                %}
                            {%- endfor -%}
                        </div>
                    {%- endif -%}
                {%- else -%}
                    <div class="flex items-start justify-between gap-8 text-[#263D29]">
                        <h2 class="h2">{{ heading }}</h2>
                        {%- if description != blank -%}
                            <p class="max-w-md text-sm leading-relaxed opacity-70">
                                {{ description }}
                            </p>
                        {%- endif -%}
                    </div>

                    <div class="mt-8 grid grid-cols-2 gap-6 pc:grid-cols-4">
                        {%- for i in (1..limit) -%}
                            <div class="border border-[#F2F3F0] bg-white p-4">
                                <div class="aspect-square animate-pulse bg-[#E5E7E4]"></div>
                                <div class="mt-4 h-4 w-3/4 animate-pulse bg-[#E5E7E4]"></div>
                                <div class="mt-2 h-4 w-1/2 animate-pulse bg-[#E5E7E4]"></div>
                            </div>
                        {%- endfor -%}
                    </div>
                {%- endif -%}
            </div>
        </div>
    {%- endif -%}
</section>

{% schema %}
{
    "name": "Related products",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["product"]
    },
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Related Product"
        },
        {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "Personalized with AI insight. Personalized with AI insight. Personalized with AI insight."
        },
        {
            "type": "range",
            "id": "limit",
            "label": "Products limit",
            "min": 2,
            "max": 12,
            "step": 1,
            "default": 4
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background color",
            "default": "#F3F3F3"
        }
    ],
    "presets": [
        {
            "name": "Related products"
        }
    ]
}
{% endschema %}
