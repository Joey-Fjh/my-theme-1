<div
    data-section-id="{{ section.id }}"
    class="promo-banner-section full-width color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="motionRevealSection()"
    data-motion-section
>
    <div class="layout container-page">
        {% comment %} Hero Banner {% endcomment %}
        <div
            class="
                relative mb-2 aspect-4/5 overflow-hidden
                pc:aspect-16/7 fw:aspect-16/6
                {% if section.settings.hero_link != blank %}media-interaction-scope{% endif %}
            "
        >
            {%- assign iamge_alt = section.settings.hero_image.alt
                | default: section.settings.hero_heading
                | default: shop.name
                | escape
            -%}
            {%- assign hero_image_url = section.settings.hero_link -%}
            {%- render 'image',
                url: hero_image_url,
                wrapper_class: 'block h-full w-full',
                image: section.settings.hero_image,
                alt: iamge_alt,
                width: section.settings.hero_image.width,
                img_class: 'h-full w-full object-cover',
                loading: 'lazy'
            -%}

            {%- if section.settings.show_badge -%}
                {%- render 'rotating-badge',
                    classes: 'absolute right-4 top-4 z-10 pc:right-20 pc:top-20',
                    unique_id: section.id,
                    size: 100,
                    size_mobile: 76,
                    badge_text: section.settings.badge_text,
                    center_text: section.settings.badge_value
                -%}
            {%- endif -%}

            <div
                class="
                    absolute inset-0 z-10 flex flex-col justify-end gap-6 p-6
                    pc:p-10 fw:p-14
                    {% if section.settings.hero_link != blank %}pointer-events-none{% endif %}
                "
                data-motion-reveal="content"
            >
                {%- if section.settings.hero_subtitle != blank -%}
                    <p class="sub-heading">
                        {{ section.settings.hero_subtitle }}
                    </p>
                {%- endif -%}

                {%- if section.settings.hero_heading != blank -%}
                    <h1>
                        {{ section.settings.hero_heading }}
                    </h1>
                {%- endif -%}

                {%- if section.settings.hero_link != blank -%}
                    {%- capture link_content -%}
                        <span>{{ section.settings.hero_link_text }}</span>
                        {% render 'icons', icon: 'icon-arrow2', class: 'ms-3' %}
                    {%- endcapture -%}

                    {%- render 'link',
                        href: section.settings.hero_link,
                        content: link_content,
                        variant: 'underline',
                        class: 'pointer-events-auto relative z-10 w-fit'
                    -%}
                {%- endif -%}
            </div>
        </div>

        {% comment %} Two Column Cards {% endcomment %}
        <div class="grid grid-cols-1 gap-2 pc:grid-cols-2">
            {%- for block in section.blocks -%}
                <div
                    class="
                        pc:aspect-4/3.5 relative aspect-square overflow-hidden
                        {% if block.settings.link != blank %}media-interaction-scope{% endif %}
                    "
                    {{ block.shopify_attributes }}
                >
                    {%- assign image_alt = block.settings.image.alt
                        | default: block.settings.heading
                        | escape
                    -%}
                    {%- assign card_image_url = block.settings.link -%}
                    {%- render 'image',
                        url: card_image_url,
                        wrapper_class: 'block h-full w-full',
                        image: block.settings.image,
                        alt: image_alt,
                        width: block.settings.image.width,
                        sizes: '(max-width: 767px) 100vw, 50vw',
                        img_class: 'h-full w-full object-cover',
                        loading: 'lazy'
                    -%}

                    <div
                        class="
                            absolute inset-0 z-10 flex flex-col justify-end gap-6 p-6 pc:p-8
                            {% if block.settings.link != blank %}pointer-events-none{% endif %}
                        "
                        data-motion-reveal="content"
                    >
                        {%- if block.settings.subtitle != blank -%}
                            <p class="sub-heading mb-1">
                                {{ block.settings.subtitle }}
                            </p>
                        {%- endif -%}

                        {%- if block.settings.heading != blank -%}
                            <h2>
                                {{ block.settings.heading }}
                            </h2>
                        {%- endif -%}

                        {%- if block.settings.link != blank -%}
                            {%- capture link_content -%}
                                <span>{{ block.settings.link_text }}</span>
                                {% render 'icons', icon: 'icon-arrow2', class: 'ms-3' %}
                            {%- endcapture -%}

                            {%- render 'link',
                                href: block.settings.link,
                                content: link_content,
                                variant: 'underline',
                                class: 'pointer-events-auto relative z-10 w-fit'
                            -%}
                        {%- endif -%}
                    </div>
                </div>
            {%- endfor -%}
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:sections.promo-bannder.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.promo-bannder.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "header",
            "content": "t:sections.promo-bannder.content.hero_banner"
        },
        {
            "type": "image_picker",
            "id": "hero_image",
            "label": "t:sections.promo-bannder.settings.hero_image"
        },
        {
            "type": "inline_richtext",
            "id": "hero_subtitle",
            "label": "t:sections.promo-bannder.settings.subtitle",
            "default": "t:sections.promo-bannder.defaults.subtitle"
        },
        {
            "type": "inline_richtext",
            "id": "hero_heading",
            "label": "t:sections.promo-bannder.settings.heading",
            "default": "t:sections.promo-bannder.defaults.heading"
        },
        {
            "type": "url",
            "id": "hero_link",
            "label": "t:sections.promo-bannder.settings.link"
        },
        {
            "type": "text",
            "id": "hero_link_text",
            "label": "t:sections.promo-bannder.settings.link_text",
            "default": "t:sections.promo-bannder.defaults.link_text"
        },
        {
            "type": "header",
            "content": "t:sections.promo-bannder.content.badge"
        },
        {
            "type": "checkbox",
            "id": "show_badge",
            "label": "t:sections.promo-bannder.settings.show_badge",
            "default": true
        },
        {
            "type": "text",
            "id": "badge_text",
            "label": "t:sections.promo-bannder.settings.badge_text",
            "default": "t:sections.promo-bannder.defaults.badge_text"
        },
        {
            "type": "text",
            "id": "badge_value",
            "label": "t:sections.promo-bannder.settings.badge_value",
            "default": "100%"
        },
        {
            "type": "header",
            "content": "t:sections.promo-bannder.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.promo-bannder.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.promo-bannder.settings.padding_bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "card",
            "name": "t:sections.promo-bannder.blocks.card",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:sections.promo-bannder.block_settings.image"
                },
                {
                    "type": "inline_richtext",
                    "id": "subtitle",
                    "label": "t:sections.promo-bannder.block_settings.subtitle",
                    "default": "t:sections.promo-bannder.blocks.defaults.subtitle"
                },
                {
                    "type": "inline_richtext",
                    "id": "heading",
                    "label": "t:sections.promo-bannder.block_settings.heading",
                    "default": "t:sections.promo-bannder.blocks.defaults.heading"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "t:sections.promo-bannder.block_settings.link"
                },
                {
                    "type": "text",
                    "id": "link_text",
                    "label": "t:sections.promo-bannder.block_settings.link_text",
                    "default": "t:sections.promo-bannder.blocks.defaults.link_text"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.promo-bannder.presets.promo_banner",
            "settings": {}
        }
    ]
}
{% endschema %}
