<div
    data-section-id="{{ section.id }}"
    class="promo-banner-section full-width"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <div class="layout container-page">
        {% comment %} Hero Banner {% endcomment %}
        <div class="fw:aspect-16/6 relative mb-2 aspect-16/7 overflow-hidden">
            {%- render 'image',
                image: section.settings.hero_image,
                alt: section.settings.hero_image.alt,
                width: section.settings.hero_image.width,
                loading: 'eager'
            -%}

            {%- if section.settings.show_badge -%}
                {%- render 'rotating-badge',
                    classes: 'absolute right-20 top-20 z-10',
                    unique_id: section.id,
                    size: 100,
                    badge_text: section.settings.badge_text,
                    center_text: section.settings.badge_value
                -%}
            {%- endif -%}

            <div class="pc:p-10 fw:p-14 absolute inset-0 flex flex-col justify-end gap-6 p-6">
                {%- if section.settings.hero_subtitle != blank -%}
                    <p class="pc:text-3xl text-2xl tracking-wide text-white/80">
                        {{ section.settings.hero_subtitle }}
                    </p>
                {%- endif -%}

                {%- if section.settings.hero_heading != blank -%}
                    <h1 class="font-light tracking-tight text-white">
                        {{ section.settings.hero_heading }}
                    </h1>
                {%- endif -%}

                {%- if section.settings.hero_link != blank -%}
                    {%- capture link_content -%}
                        <span>{{ section.settings.hero_link_text }}</span>
                        <span class="ml-3 inline-block h-6 w-6">
                            {{- 'icon-arrow2.svg' | inline_asset_content -}}
                        </span>
                    {%- endcapture -%}
                    {%- render 'link',
                        class: 'text-white',
                        href: section.settings.hero_link,
                        content: link_content,
                        variant: 'underline'
                    -%}
                {%- endif -%}
            </div>
        </div>

        {% comment %} Two Column Cards {% endcomment %}
        <div class="pc:grid-cols-2 grid grid-cols-1 gap-2">
            {%- for block in section.blocks -%}
                <div
                    class="pc:aspect-4/3.5 relative aspect-4/3 overflow-hidden"
                    {{ block.shopify_attributes }}
                >
                    {%- render 'image',
                        image: block.settings.image,
                        alt: block.settings.image.alt,
                        width: block.settings.image.width,
                        sizes: '(max-width: 768px) 100vw, 50vw',
                        loading: 'lazy'
                    -%}

                    <div class="pc:p-8 absolute inset-0 flex flex-col justify-end gap-6 p-6">
                        {%- if block.settings.subtitle != blank -%}
                            <p class="pc:text-3xl mb-1 text-2xl tracking-wide text-white/80">
                                {{ block.settings.subtitle }}
                            </p>
                        {%- endif -%}

                        {%- if block.settings.heading != blank -%}
                            <h2 class="font-light tracking-tight text-white">
                                {{ block.settings.heading }}
                            </h2>
                        {%- endif -%}

                        {%- if block.settings.link != blank -%}
                            {%- capture link_content -%}
                                <span>{{ block.settings.link_text }}</span>
                                <span class="ml-3 inline-block h-6 w-6">
                                    {{- 'icon-arrow2.svg' | inline_asset_content -}}
                                </span>
                            {%- endcapture -%}
                            {%- render 'link',
                                class: 'text-white',
                                href: block.settings.link,
                                content: link_content,
                                variant: 'underline'
                            -%}
                        {%- endif -%}
                    </div>
                </div>
            {%- endfor -%}
        </div>
    </div>
</div>

{% schema %}
{
    "name": "Promo Banner",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "header",
            "content": "Hero Banner"
        },
        {
            "type": "image_picker",
            "id": "hero_image",
            "label": "Hero Image"
        },
        {
            "type": "inline_richtext",
            "id": "hero_subtitle",
            "label": "Subtitle",
            "default": "Lorem Ipsum"
        },
        {
            "type": "inline_richtext",
            "id": "hero_heading",
            "label": "Heading",
            "default": "Up To 50% Off Everything"
        },
        {
            "type": "url",
            "id": "hero_link",
            "label": "Link"
        },
        {
            "type": "text",
            "id": "hero_link_text",
            "label": "Link Text",
            "default": "Watch Now"
        },
        {
            "type": "header",
            "content": "Badge"
        },
        {
            "type": "checkbox",
            "id": "show_badge",
            "label": "Show Badge",
            "default": true
        },
        {
            "type": "text",
            "id": "badge_text",
            "label": "Badge Text",
            "default": "PRODUCT GUARANTEE • NATURAL •"
        },
        {
            "type": "text",
            "id": "badge_value",
            "label": "Badge Value",
            "default": "100%"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "card",
            "name": "Card",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "inline_richtext",
                    "id": "subtitle",
                    "label": "Subtitle",
                    "default": "Lorem Ipsum"
                },
                {
                    "type": "inline_richtext",
                    "id": "heading",
                    "label": "Heading",
                    "default": "Lorem Ipsum"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Link"
                },
                {
                    "type": "text",
                    "id": "link_text",
                    "label": "Link Text",
                    "default": "Watch Now"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Promo Banner",
            "settings": {}
        }
    ]
}
{% endschema %}
