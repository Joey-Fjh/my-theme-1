{%- liquid
    assign promo_heading_size = section.settings.heading_size | default: 'heading-xl'
    case promo_heading_size
        when 'heading-4xl'
            assign promo_heading_class = 'heading-h2 pc:heading-4xl'
        when 'heading-3xl'
            assign promo_heading_class = 'heading-h2 pc:heading-3xl'
        when 'heading-2xl'
            assign promo_heading_class = 'heading-h2 pc:heading-2xl'
        when 'heading-xl'
            assign promo_heading_class = 'heading-h3 pc:heading-xl'
        when 'heading-h1'
            assign promo_heading_class = 'heading-h2 pc:heading-h1'
        when 'heading-h2'
            assign promo_heading_class = 'heading-h3 pc:heading-h2'
        when 'heading-h3'
            assign promo_heading_class = 'heading-h4 pc:heading-h3'
        when 'heading-h4'
            assign promo_heading_class = 'heading-h5 pc:heading-h4'
        when 'heading-h5'
            assign promo_heading_class = 'heading-h6 pc:heading-h5'
        when 'heading-h6'
            assign promo_heading_class = 'body-xl pc:heading-h6'
        else
            assign promo_heading_class = 'heading-h3 pc:heading-xl'
    endcase
-%}

{%- assign promo_bannder_root_attrs = 'data-component-kind="section" data-component-type="promo-bannder" data-component-id="'
    | append: section.id
    | append: '"'
-%}

{%- capture promo_bannder_children -%}
    <div
        class="promo-bannder__root"
        data-module-id="promo-bannder"
        x-data="promoBannder()"
    >
        {%- for block in section.blocks -%}
            {%- if block.type != 'card' -%}
                {%- continue -%}
            {%- endif -%}
            {%- liquid
                assign promo_panel_scheme = block.settings.color_scheme | default: 'scheme-3'
                assign promo_placeholder_index = forloop.index0 | modulo: 2 | plus: 1
                assign promo_placeholder_key = 'lifestyle-' | append: promo_placeholder_index
                assign promo_image_alt = block.settings.image.alt | default: block.settings.heading | escape
                if block.settings.image == blank and block.settings.heading == blank
                    assign promo_image_alt = ''
                endif
                assign promo_small_alt = block.settings.image_small.alt | default: block.settings.heading | escape
                if block.settings.image_small == blank and block.settings.heading == blank
                    assign promo_small_alt = ''
                endif
                assign promo_show_link = false
                if block.settings.link != blank and block.settings.link_text != blank
                    assign promo_show_link = true
                endif
                if forloop.first
                    assign promo_main_loading = 'eager'
                else
                    assign promo_main_loading = 'lazy'
                endif
                assign promo_image_on_right = forloop.index | modulo: 2
            -%}
            <article
                class="promo-bannder__panel color-{{ promo_panel_scheme }}{% if promo_image_on_right == 0 %} promo-bannder__panel--image-right{% endif %}"
                data-promo-bannder-panel
                style="--promo-bannder-z: {{ forloop.index }};"
                {{ block.shopify_attributes }}
            >
                <div class="promo-bannder__panel-inner">
                    <div class="promo-bannder__media">
                        <div class="promo-bannder__media-scale"{% if block.settings.image == blank %} aria-hidden="true"{% endif %}>
                            {%- render 'image',
                                image: block.settings.image,
                                placeholder_key: promo_placeholder_key,
                                alt: promo_image_alt,
                                width: block.settings.image.width,
                                mode: 'frame',
                                fit: 'cover',
                                sizes: '(min-width: 64rem) 50vw, 100vw',
                                wrapper_class: 'promo-bannder__media-frame h-full w-full',
                                img_class: 'h-full w-full object-cover',
                                loading: promo_main_loading
                            -%}
                        </div>
                    </div>

                    <div class="promo-bannder__content">
                        <div class="promo-bannder__content-copy">
                            {%- if block.settings.heading != blank -%}
                                {% render 'heading',
                                    level: '2',
                                    tier: promo_heading_class,
                                    align: 'center',
                                    content: block.settings.heading
                                %}
                            {%- endif -%}

                            {%- if block.settings.description != blank -%}
                                {% render 'text',
                                    element: 'div',
                                    rte: true,
                                    tier: 'body-md pc:body-lg',
                                    align: 'center',
                                    content: block.settings.description
                                %}
                            {%- endif -%}
                        </div>

                        <div class="promo-bannder__small-wrap"{% if block.settings.image_small == blank %} aria-hidden="true"{% endif %}>
                            {%- render 'image',
                                image: block.settings.image_small,
                                placeholder_key: promo_placeholder_key,
                                alt: promo_small_alt,
                                width: block.settings.image_small.width,
                                mode: 'frame',
                                fit: 'cover',
                                placeholder_aspect_ratio: '17/10',
                                sizes: '(min-width: 64rem) 10vw, 45vw',
                                wrapper_class: 'promo-bannder__small h-full w-full',
                                img_class: 'h-full w-full object-cover',
                                loading: 'lazy'
                            -%}
                        </div>

                        {%- if promo_show_link -%}
                            {%- capture promo_link_content -%}
                                <span class="uppercase">{{ block.settings.link_text }}</span>
                                {%- render 'icons', icon: 'icon-arrow2', class: 'ms-2', size: 'sm' -%}
                            {%- endcapture -%}
                            <div class="promo-bannder__link">
                                {%- render 'link',
                                    href: block.settings.link,
                                    content: promo_link_content,
                                    variant: 'underline',
                                    class: 'body-sm pc:body-md'
                                -%}
                            </div>
                        {%- endif -%}
                    </div>
                </div>
            </article>
        {%- endfor -%}
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: 'promo-bannder-section',
    surface_section: false,
    width: 'full',
    clip: false,
    motion: false,
    root_attrs: promo_bannder_root_attrs,
    children: promo_bannder_children
%}

{% stylesheet %}
    .promo-bannder-section {
        overflow: visible;
    }

    .promo-bannder__root {
        display: flex;
        flex-direction: column;
    }

    .promo-bannder__panel {
        position: relative;
        z-index: var(--promo-bannder-z, 1);
        background-color: rgb(var(--color-background));
        color: rgb(var(--color-foreground));
    }

    @media (width >= 64rem) {
        .promo-bannder__panel {
            --promo-bannder-panel-height: max(40rem, var(--screen-height));
            position: sticky;
            top: 0;
            min-height: var(--promo-bannder-panel-height);
        }
    }

    .promo-bannder__panel-inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        min-height: inherit;
    }

    @media (width >= 64rem) {
        .promo-bannder__panel-inner {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            height: var(--promo-bannder-panel-height);
        }
    }

    @media (width >= 64rem) {
        .promo-bannder__panel--image-right .promo-bannder__media {
            order: 2;
        }

        .promo-bannder__panel--image-right .promo-bannder__content {
            order: 1;
        }
    }

    .promo-bannder__media {
        position: relative;
        overflow: hidden;
        aspect-ratio: 4 / 5;
    }

    @media (width >= 64rem) {
        .promo-bannder__media {
            aspect-ratio: auto;
            height: 100%;
        }
    }

    .promo-bannder__media-scale {
        height: 100%;
        width: 100%;
        transform-origin: center center;
    }

    .promo-bannder--motion .promo-bannder__media-scale {
        transform: scale(1.2);
        transition: transform 600ms ease-in-out;
    }

    @media (prefers-reduced-motion: reduce) {
        .promo-bannder--motion .promo-bannder__media-scale {
            transform: none;
            transition: none;
        }
    }

    .promo-bannder--motion .promo-bannder__panel.is-in-view .promo-bannder__media-scale {
        transform: scale(1);
    }

    .promo-bannder__media-frame {
        height: 100%;
    }

    .promo-bannder__content {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1.5rem;
        padding: 12vw 1.25rem 16vw;
        min-height: 100vw;
    }

    @media (width >= 64rem) {
        .promo-bannder__content {
            justify-content: flex-start;
            gap: 2rem;
            min-height: 0;
            padding: calc(var(--promo-bannder-panel-height) * 0.24) 2.5rem
                calc(var(--promo-bannder-panel-height) * 0.28);
            height: 100%;
        }
    }

    .promo-bannder__content-copy {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        width: 100%;
        max-width: 28rem;
        overflow-wrap: normal;
        word-break: normal;
    }

    @media (width >= 64rem) {
        .promo-bannder__content-copy {
            max-width: 65%;
        }
    }

    .promo-bannder__small-wrap {
        width: 45%;
        max-width: 100%;
        margin-top: auto;
    }

    @media (width >= 64rem) {
        .promo-bannder__small-wrap {
            width: 30%;
        }
    }

    .promo-bannder__small {
        aspect-ratio: 1.7 / 1;
    }

    .promo-bannder__link {
        margin-top: 0.25rem;
    }

    @media (width >= 64rem) {
        .promo-bannder__link {
            margin-top: 0;
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.promo-bannder.name",
    "tag": "section",
    "class": "section",
    "max_blocks": 5,
    "disabled_on": {
        "groups": ["header", "footer", "custom.overlay"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.promo-bannder.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.font"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "heading-4xl",
                    "label": "t:sections.slides-show.options.heading_4xl"
                },
                {
                    "value": "heading-3xl",
                    "label": "t:sections.slides-show.options.heading_3xl"
                },
                {
                    "value": "heading-2xl",
                    "label": "t:sections.slides-show.options.heading_2xl"
                },
                {
                    "value": "heading-xl",
                    "label": "t:sections.slides-show.options.heading_xl"
                },
                {
                    "value": "heading-h1",
                    "label": "t:sections.slides-show.options.heading_h1"
                },
                {
                    "value": "heading-h2",
                    "label": "t:sections.slides-show.options.heading_h2"
                },
                {
                    "value": "heading-h3",
                    "label": "t:sections.slides-show.options.heading_h3"
                },
                {
                    "value": "heading-h4",
                    "label": "t:sections.slides-show.options.heading_h4"
                },
                {
                    "value": "heading-h5",
                    "label": "t:sections.slides-show.options.heading_h5"
                },
                {
                    "value": "heading-h6",
                    "label": "t:sections.slides-show.options.heading_h6"
                }
            ],
            "default": "heading-xl"
        },
        {
            "type": "header",
            "content": "t:sections.promo-bannder.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.promo-bannder.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.promo-bannder.settings.padding_bottom",
            "default": 32
        }
    ],
    "blocks": [
        {
            "type": "card",
            "name": "t:sections.promo-bannder.blocks.card",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:sections.promo-bannder.block_settings.image"
                },
                {
                    "type": "inline_richtext",
                    "id": "heading",
                    "label": "t:sections.promo-bannder.block_settings.heading",
                    "default": "t:sections.promo-bannder.blocks.defaults.heading"
                },
                {
                    "type": "inline_richtext",
                    "id": "description",
                    "label": "t:sections.promo-bannder.block_settings.description",
                    "default": "t:sections.promo-bannder.blocks.defaults.description"
                },
                {
                    "type": "image_picker",
                    "id": "image_small",
                    "label": "t:sections.promo-bannder.block_settings.image_small"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "t:sections.promo-bannder.block_settings.link"
                },
                {
                    "type": "text",
                    "id": "link_text",
                    "label": "t:sections.promo-bannder.block_settings.link_text",
                    "default": "t:sections.promo-bannder.blocks.defaults.link_text"
                },
                {
                    "type": "color_scheme",
                    "id": "color_scheme",
                    "label": "t:sections.promo-bannder.block_settings.color_scheme",
                    "default": "scheme-3"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.promo-bannder.presets.promo_banner",
            "blocks": [
                {
                    "type": "card"
                },
                {
                    "type": "card"
                }
            ]
        }
    ]
}
{% endschema %}
