{%- assign size_class = 'w-12 h-12' -%}
{%- assign logo_position = section.settings.logo_position -%}
{%- if logo_position == 'middle-left' -%}
    {%- assign logo_position = 'middle-center' -%}
{%- endif -%}
{%- assign mobile_menu_popup_id = 'header-mobile-menu-drawer' -%}
{%- assign search_overlay_popup_id = 'search-overlay-drawer' -%}
{%- assign cart_overlay_popup_id = 'cart-overlay-drawer' -%}
{%- assign is_homepage = false -%}
{%- if request.page_type == 'index' -%}
    {%- assign is_homepage = true -%}
{%- endif -%}

<header
    data-section-id="{{ section.id }}"
    class="
        header-section full-width
        color-{{ section.settings.color_scheme }}
        bg-theme-bg text-theme-text
        {% if is_homepage %}is-homepage{% else %}is-innerpage{% endif %}
    "
    x-data="stickyHeader"
    :class="
        {
          'is-top': isTop,
          'is-hidden' : isHidden,
          'is-scrolled': !isTop,
          'is-menu-active': isMenuActive,
          'is-mobile-menu-active': $store.dialog?.active === '{{ mobile_menu_popup_id }}'
        }
    "
>
    <div class="container-page">
        <div class="header__cols header__cols-{{ logo_position }} grid py-5">
            <div class="flex items-center pc:hidden" style="grid-area: mobile-menu">
                {%- render 'header-mobile-menu-drawer',
                    popup_id: mobile_menu_popup_id,
                    menu_handle: section.settings.menu.handle,
                    color_scheme: section.settings.mobile_menu_color_scheme
                -%}

                <button
                    type="button"
                    class="cursor-pointer"
                    @click="$store.dialog.open('{{ mobile_menu_popup_id }}')"
                    aria-label="{{ 'accessibility.mobile_menu' | t }}"
                >
                    {%- render 'icons',
                        color: 'current',
                        icon: 'icon-menu',
                        class: 'ml-3 h-10 w-10'
                    -%}
                </button>
            </div>

            <div class="header-search hidden items-center justify-start" style="grid-area: search">
                <button
                    type="button"
                    class="cursor-pointer"
                    @click="$store.dialog.open('{{ search_overlay_popup_id }}')"
                    aria-label="{{ 'accessibility.search' | t }}"
                >
                    {% render 'icons', icon: 'icon-search', class: size_class, color: 'current' %}
                </button>
            </div>

            <div class="header-logo flex items-center justify-start" style="grid-area: logo">
                {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
                {%- assign logo_height = settings.logo_width
                    | divided_by: settings.logo.aspect_ratio
                -%}
                {%- capture sizes -%}
                    (max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px
                {%- endcapture -%}

                {%- capture widths -%}
                    {{ settings.logo_width }},{{ settings.logo_width | times: 1.5 | round }},{{ settings.logo_width | times:2 }}
                {%- endcapture -%}

                {%- if settings.logo -%}
                    {% render 'image',
                        image: settings.logo,
                        width: settings.logo_width,
                        height: logo_height,
                        alt: logo_alt,
                        url: routes.root_url,
                        sizes: sizes,
                        widths: widths,
                        loading: 'eager'
                    %}
                {%- else -%}
                    {%- render 'link',
                        text: shop.name,
                        class: 'h2 header-logo__text',
                        variant: 'underline',
                        href: routes.root_url,
                        color: 'current'
                    -%}
                {%- endif -%}
            </div>

            <div
                class="header-menu flex items-center justify-center max-pc:hidden"
                style="grid-area: menu"
            >
                {%- if section.settings.menu_type == 'super' -%}
                    {%- render 'header-dropdown-super-menu' -%}
                {%- else -%}
                    {%- render 'header-dropdown-menu' -%}
                {%- endif -%}
            </div>

            <div
                class="header-navigation flex items-center justify-end gap-3"
                style="grid-area:navigation"
            >
                <button
                    type="button"
                    class="header-search__right cursor-pointer"
                    @click="$store.dialog.open('{{ search_overlay_popup_id }}')"
                    aria-label="{{ 'accessibility.search' | t }}"
                >
                    {% render 'icons', icon: 'icon-search', class: size_class, color: 'current' %}
                </button>

                <button
                    type="button"
                    class="relative cursor-pointer"
                    @click="$store.dialog.open('{{ cart_overlay_popup_id }}')"
                    aria-label="{{ 'accessibility.cart' | t }}"
                >
                    {% render 'icons', icon: 'icon-cart', class: size_class, color: 'current' %}
                    <span
                        x-cloak
                        x-show="$store.cart && $store.cart.item_count > 0"
                        class="absolute -top-1 -right-1 inline-flex min-w-[1.25rem] items-center justify-center rounded-full bg-theme-text px-1.5 py-0.5 text-[0.625rem] leading-none text-theme-bg"
                        x-text="$store.cart.item_count"
                    ></span>
                </button>

                {% assign account_href = routes.account_login_url %}
                {% if customer %}
                    {% assign account_href = routes.account_url %}
                {% endif %}

                {% capture link_content %}
                    {% render 'icons', icon: 'icon-account', class: 'h-10 w-10', color: 'current' %}
                {% endcapture %}

                {% render 'link',
                    href: account_href,
                    content: link_content,
                    variant: 'plain',
                    class: 'cursor-pointer',
                    aria_label: 'Account'
                %}
            </div>
        </div>
    </div>
</header>

{% stylesheet %}
    .site-header {
        position: fixed;
        left: 0;
        right: 0;
        top: var(--announcement-bar-height);
        z-index: 9998;
    }

    .site-header > header {
        background-image: var(--gradient-background);
        box-shadow: none;
        transition:
            background-color 0.24s ease,
            box-shadow 0.24s ease,
            transform 0.24s ease;
    }

    .site-header > header.is-hidden {
        transform: translateY(calc(-100% - var(--announcement-bar-height)));
    }

    .site-header > header.is-scrolled,
    .site-header > header.is-menu-active,
    .site-header > header.is-mobile-menu-active,
    .site-header > header:has(.header-menu details.dropdown[open]) {
        box-shadow: 0 1px 10px rgba(0, 0, 0, 0.06);
    }

    .site-header
        > header.is-homepage.is-top:not(:hover):not(:focus-within):not(.is-menu-active):not(
            .is-mobile-menu-active
        ):not(:has(.header-menu details.dropdown[open])) {
        background-color: transparent;
        background-image: none;
    }

    .site-header > header.is-homepage.is-top:hover,
    .site-header > header.is-homepage.is-top:focus-within,
    .site-header > header.is-homepage.is-top.is-menu-active,
    .site-header > header.is-homepage.is-top.is-mobile-menu-active {
        background-image: var(--gradient-background);
        box-shadow: 0 1px 10px rgba(0, 0, 0, 0.06);
    }

    .header-section {
        .header__cols {
            grid-template-areas: 'mobile-menu logo navigation';
            grid-template-columns: auto minmax(0, 1fr) auto;
            align-items: center;
            column-gap: 1rem;
        }

        .header-logo {
            min-width: 0;
        }

        .header-logo > * {
            min-width: 0;
            max-width: 100%;
        }

        .header-logo .header-logo__text {
            display: block;
            width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .header-navigation {
            min-width: max-content;
        }

        @media (min-width: 48rem) {
            .header__cols {
                grid-template-areas: 'logo menu navigation';
                grid-template-columns: repeat(3, minmax(0, 1fr));
                column-gap: 0;
            }

            .header__cols-middle {
                grid-template-areas: 'menu logo navigation';
                grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
            }

            .header__cols-middle > .header-logo {
                justify-content: center;
                justify-self: center;
                width: max-content;
                max-width: 100%;
            }

            .header__cols-middle > .header-logo > *,
            .header__cols-middle > .header-logo .header-logo__text {
                width: auto;
                max-width: 100%;
            }

            .header__cols-middle > .header-logo > .theme-image {
                width: auto;
            }

            .header__cols-middle > .header-menu {
                justify-content: start;
                justify-self: start;
            }

            .header__cols-middle-center {
                grid-template-areas:
                    'search logo navigation'
                    '. menu .';
                grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
                row-gap: 10px;
            }

            .header__cols-middle-center > .header-search {
                display: flex;
                justify-self: start;
            }

            .header__cols-middle-center > .header-navigation {
                justify-self: end;
            }

            .header__cols-middle-center .header-search__right {
                display: none;
            }

            .header__cols-middle-center > .header-logo {
                justify-content: center;
                justify-self: center;
                width: max-content;
                max-width: 100%;
            }

            .header__cols-middle-center > .header-logo > *,
            .header__cols-middle-center > .header-logo .header-logo__text {
                width: auto;
                max-width: 100%;
            }

            .header__cols-middle-center > .header-logo > .theme-image {
                width: auto;
            }

            .header__cols-middle-center > .header-menu {
                justify-content: center;
                justify-self: center;
                width: max-content;
                max-width: 100%;
            }
        }

        .header-dropdown-super-menu {
            .header-super-menu-panel {
                min-height: clamp(18rem, 36vw, 28rem);
            }

            .header-super-menu-layout {
                display: grid;
                gap: 3rem;
                min-height: inherit;
                align-items: start;
            }

            .header-super-menu-layout--full {
                grid-template-columns: minmax(0, 1fr);
            }

            .header-super-menu-main {
                display: flex;
                min-width: 0;
                min-height: inherit;
                padding: 1rem 0 5rem;
            }

            .header-super-menu-columns {
                display: grid;
                width: 100%;
                align-items: start;
                grid-template-columns: repeat(var(--super-menu-column-count), minmax(0, 1fr));
                gap: 2rem 3.2rem;
            }

            .header-super-menu-column {
                display: flex;
                min-width: 0;
                flex-direction: column;
                align-items: flex-start;
                gap: 2rem;
            }

            .header-super-menu-child-item {
                width: 100%;
            }

            .header-super-menu-child-link {
                padding: 0;
                white-space: nowrap;
            }

            .header-super-menu-child-link--has-children {
                width: fit-content;
                max-width: 100%;
            }

            .header-super-menu-grandchildren-links a {
                display: inline-block;
                max-width: 100%;
                text-wrap: pretty;
                overflow-wrap: anywhere;
            }

            .header-super-menu-grandchildren-links {
                display: flex;
                width: 100%;
                min-height: 7.5rem;
                flex-direction: column;
                align-items: flex-start;
                gap: 1.2rem;
            }

            .header-super-menu-series {
                min-width: 0;
                min-height: inherit;
                padding-left: 2rem;
            }

            .header-super-menu-series-tabs {
                min-width: 0;
                min-height: inherit;
                padding: 0 0 5rem;
            }

            .header-super-menu-series-tabs .tab-content-default {
                min-width: 0;
            }

            .header-super-menu-series .product-card {
                padding: 0;
            }

            .header-super-menu-series .product-card-shell__media-frame {
                background-color: transparent;
            }

            @media (min-width: 64rem) {
                .header-super-menu-layout--with-series {
                    grid-template-columns:
                        minmax(0, var(--super-menu-primary-width))
                        minmax(0, var(--super-menu-secondary-width));
                }

                .header-super-menu-columns {
                    gap: 2.4rem 4rem;
                }
            }
        }
    }
{% endstylesheet %}

<script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      {% if settings.logo %}
        "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
      {% endif %}
      "sameAs": [
        {{ settings.social_twitter_link | json }},
        {{ settings.social_facebook_link | json }},
        {{ settings.social_pinterest_link | json }},
        {{ settings.social_instagram_link | json }},
        {{ settings.social_tiktok_link | json }},
        {{ settings.social_tumblr_link | json }},
        {{ settings.social_snapchat_link | json }},
        {{ settings.social_youtube_link | json }},
        {{ settings.social_vimeo_link | json }}
      ],
      "url": {{ request.origin | append: page.url | json }}
    }
</script>

{%- if request.page_type == 'index' -%}
    {% assign potential_action_target = request.origin
        | append: routes.search_url
        | append: '?q={search_term_string}'
    %}
    <script type="application/ld+json">
        {
          "@context": "http://schema.org",
          "@type": "WebSite",
          "name": {{ shop.name | json }},
          "potentialAction": {
            "@type": "SearchAction",
            "target": {{ potential_action_target | json }},
            "query-input": "required name=search_term_string"
          },
          "url": {{ request.origin | append: page.url | json }}
        }
    </script>
{%- endif -%}

{% schema %}
{
    "name": "t:general.header",
    "tag": "section",
    "class": "section site-header",
    "limit": 1,
    "enabled_on": {
        "groups": [
            "header"
        ]
    },
    "settings": [
        {
            "type": "header",
            "content": "t:sections.header.content.header"
        },
        {
            "type": "select",
            "id": "logo_position",
            "options": [
                {
                    "value": "left",
                    "label": "t:sections.header.options.left"
                },
                {
                    "value": "middle",
                    "label": "t:sections.header.options.middle"
                },
                {
                    "value": "middle-center",
                    "label": "t:sections.header.options.middle_center"
                }
            ],
            "label": "t:sections.header.settings.logo_position",
            "default": "left",
            "info": "t:sections.header.info.edit_your_logo_in_theme_settings_editor_"
        },
        {
            "type": "header",
            "content": "t:sections.header.content.color"
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.header.settings.color_scheme",
            "default": "color-scheme-1"
        },
        {
            "type": "color_scheme",
            "id": "menu_color_scheme",
            "label": "t:sections.header.settings.menu_color_scheme",
            "default": "color-scheme-1"
        },
        {
            "type": "color_scheme",
            "id": "mobile_menu_color_scheme",
            "label": "t:sections.header.settings.mobile_menu_color_scheme",
            "default": "color-scheme-1"
        },
        {
            "type": "link_list",
            "id": "menu",
            "label": "t:labels.menu"
        },
        {
            "type": "header",
            "content": "t:sections.header.content.menu_type"
        },
        {
            "type": "select",
            "id": "menu_type",
            "label": "t:sections.header.settings.menu_type",
            "default": "dropdown",
            "options": [
                {
                    "value": "dropdown",
                    "label": "t:sections.header.options.dropdown_menu"
                },
                {
                    "value": "super",
                    "label": "t:sections.header.options.super_menu"
                }
            ]
        },
        {
            "type": "text",
            "id": "super_menu_watermark_text",
            "label": "t:sections.header.settings.super_menu_watermark",
            "default": "Eccenova®",
            "visible_if": "{{ section.settings.menu_type == 'super' }}"
        },
        {
            "type": "checkbox",
            "id": "enable_super_menu_series",
            "label": "t:sections.header.settings.enable_product_series_tabs",
            "default": false,
            "visible_if": "{{ section.settings.menu_type == 'super' }}"
        },
        {
            "type": "range",
            "id": "super_menu_primary_width",
            "label": "t:sections.header.settings.super_menu_left_column_width",
            "min": 30,
            "max": 70,
            "step": 1,
            "unit": "%",
            "default": 42,
            "visible_if": "{{ section.settings.menu_type == 'super' and section.settings.enable_super_menu_series }}"
        },
        {
            "type": "collection",
            "id": "super_collection_1",
            "label": "t:sections.header.settings.series_collection_1"
        },
        {
            "type": "collection",
            "id": "super_collection_2",
            "label": "t:sections.header.settings.series_collection_2"
        },
        {
            "type": "collection",
            "id": "super_collection_3",
            "label": "t:sections.header.settings.series_collection_3"
        },
        {
            "type": "range",
            "id": "super_series_products_limit",
            "label": "t:sections.header.settings.products_per_series",
            "min": 3,
            "max": 12,
            "step": 1,
            "default": 6,
            "visible_if": "{{ section.settings.menu_type == 'super' and section.settings.enable_super_menu_series }}"
        }
    ]
}
    {% endschema %}
