<div
    data-section-id="{{ section.id }}"
    class="promise-section full-width"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="promise-section"
    data-component-id="{{ section.id }}"
>
    <div class="layout container-page text-[#263D29]">
        <div class="pc:grid-cols-2 fw:gap-16 grid grid-cols-1 items-center gap-10">
            {% comment %} Left - Image {% endcomment %}
            <div
                class="aspect-4/5 -translate-x-10 overflow-hidden rounded-sm opacity-0"
                data-gsap-image
            >
                {%-
                    render 'image',
                    image: section.settings.image,
                    alt: section.settings.image.alt | default: 'Promise Section Image' | escape,
                    width: section.settings.image.width
                -%}
            </div>

            {% comment %} Right - Content + Accordion  {% endcomment %}
            <div
                class="flex h-full translate-x-10 flex-col justify-around opacity-0"
                data-gsap-content
            >
                <div>
                    <h3 class="mb-4 text-xl">{{ section.settings.subtitle }}</h3>
                    <h0 class="mb-10 leading-tight font-bold text-balance">
                        {{ section.settings.heading }}
                    </h0>
                </div>
                {% comment %} Accordion {% endcomment %}
                {%- render 'accordion',
                    blocks: section.blocks,
                    initial_active: 0,
                    icon_type: 'chevron'
                -%}
            </div>
        </div>
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components || typeof gsap === 'undefined') return;

        gsap.registerPlugin(ScrollTrigger);

        Components.register(
            'promise-section',
            {
                init(el) {
                    const ctx = gsap.context(() => {
                        const image = el.querySelector('[data-gsap-image]');
                        const content = el.querySelector('[data-gsap-content]');

                        const tl = gsap.timeline({
                            scrollTrigger: {
                                trigger: el,
                                start: 'top 75%',
                                once: true,
                            },
                            defaults: { ease: 'power2.out' },
                        });

                        if (image) {
                            tl.to(image, {
                                opacity: 1,
                                x: 0,
                                duration: 0.8,
                            });
                        }
                        if (content) {
                            tl.to(
                                content,
                                {
                                    opacity: 1,
                                    x: 0,
                                    duration: 0.8,
                                },
                                '-=0.5',
                            );
                        }
                    }, el);

                    return { ctx };
                },

                destroy(el, state) {
                    if (state?.ctx) {
                        state.ctx.revert();
                    }
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{%- stylesheet -%}
{%- endstylesheet -%}

{% schema %}
{
    "name": "Promise Section",
    "tag": "section",
    "class": "section",
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "subtitle",
            "default": "Our Promise",
            "label": "Subtitle"
        },
        {
            "type": "text",
            "id": "heading",
            "default": "Thoughtfully Crafted for Your Skin",
            "label": "Heading"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "accordion_item",
            "name": "Accordion Item",
            "settings": [
                {
                    "type": "text",
                    "id": "title",
                    "default": "Accordion title",
                    "label": "Title"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "default": "<p>Accordion description text goes here.</p>",
                    "label": "Content"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Promise Section",
            "blocks": [
                {
                    "type": "accordion_item",
                    "settings": {
                        "title": "Responsible Beauty Commitment",
                        "text": "<p>Our promise extends beyond skincare. We embrace responsible practices that respect people, animals, and the planet at every step.</p>"
                    }
                },
                {
                    "type": "accordion_item",
                    "settings": {
                        "title": "Honest & Transparent Process",
                        "text": "<p>We believe in full transparency — from ingredient sourcing to formulation. You deserve to know exactly what goes into every product.</p>"
                    }
                },
                {
                    "type": "accordion_item",
                    "settings": {
                        "title": "Gentle Yet Effective Formulas",
                        "text": "<p>Our formulations balance gentleness with efficacy, ensuring your skin receives the care it needs without irritation or compromise.</p>"
                    }
                },
                {
                    "type": "accordion_item",
                    "settings": {
                        "title": "Thoughtfully Chosen Ingredients",
                        "text": "<p>Every ingredient is carefully selected for its proven benefits, purity, and compatibility with all skin types.</p>"
                    }
                }
            ]
        }
    ]
}
{% endschema %}
