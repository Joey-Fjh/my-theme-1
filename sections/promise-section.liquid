<div
    data-section-id="{{ section.id }}"
    class="promise-section full-width"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="promise-section"
    data-component-id="{{ section.id }}"
>
    <div class="layout container-page text-[#263D29]">
        <div class="grid grid-cols-1 pc:grid-cols-2 gap-10 fw:gap-16 items-center">
            {% comment %} Left - Image {% endcomment %}
            <div class="aspect-4/5 overflow-hidden rounded-sm opacity-0 -translate-x-10" data-gsap-image>
                {%- render 'image', 
                    image: section.settings.image,
                    alt: section.settings.image.alt | default: 'Promise Section Image' | escape,
                    width: section.settings.image.width
                -%}
            </div>

            {% comment %} Right - Content + Accordion  {% endcomment %}
            <div class="opacity-0 translate-x-10 flex flex-col h-full justify-around" data-gsap-content>
                <div>
                    <h3 class="text-xl mb-4">{{ section.settings.subtitle }}</h3>
                    <h0 class="font-bold leading-tight text-balance mb-10">
                        {{ section.settings.heading }}
                    </h0>
                </div>
                {% comment %} Accordion {% endcomment %}
                <div
                    x-data="{active:0}"
                    class="flex flex-col gap-8"
                >
                    {%- for block in section.blocks -%}
                        <div class="border-t border-[#d4d4d4] first:border-t-0" {{ block.shopify_attributes }}>
                            <button
                                type="button"
                                @click="active = active === {{ forloop.index0 }} ? null : {{ forloop.index0 }}"
                                class="flex w-full items-center justify-between py-5 text-left cursor-pointer"
                            >
                                <h2
                                    class="font-bold text-[#2d3a2e]"
                                    :class="{ 'text-[#2d3a2e]': active === {{ forloop.index0 }}, 'text-[#5a5a5a]': active !== {{ forloop.index0 }} }"
                                >
                                    {{ block.settings.title }}
                                </h2>
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="shrink-0 ml-4 text-[#5a5a5a] transition-transform duration-300"
                                    :class="{ 'rotate-180': active === {{ forloop.index0 }} }"
                                >
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </button>
                            <div
                                x-show="active === {{ forloop.index0 }}"
                            >
                                <p class="pb-5 text-[#6b6b6b] leading-relaxed pr-8">
                                    {{ block.settings.text }}
                                </p>
                            </div>
                        </div>
                    {%- endfor -%}
                </div> 
            </div>
        </div>
    </div>
</div>

{%- javascript -%}
    (function(){
        if (!window.$components || typeof gsap === 'undefined') return;

        gsap.registerPlugin(ScrollTrigger);

        $components.register(
            'promise-section',
            {
                init(el){
                    const ctx = gsap.context(() => {
                        const image = el.querySelector('[data-gsap-image]');
                        const content = el.querySelector('[data-gsap-content]');

                        const tl = gsap.timeline({
                            scrollTrigger: {
                                trigger: el,
                                start: 'top 75%',
                                once: true
                            },
                            defaults: { ease: 'power2.out' }
                        });

                        if (image) {
                            tl.to(image, {
                                opacity: 1,
                                x: 0,
                                duration: 0.8
                            });
                        }
                        if (content) {
                            tl.to(content, {
                                opacity: 1,
                                x: 0,
                                duration: 0.8
                            }, '-=0.5');
                        }
                    },el);

                    return { ctx };
                },

                destroy(el, state){
                    if (state?.ctx) {
                        state.ctx.revert();
                    }
                }
            },
            { lazy: true }
        );
    })();
{%- endjavascript -%}

{%- stylesheet -%}
{%- endstylesheet -%}

{% schema %}
  {
    "name": "Promise Section",
    "tag": "section",
    "class": "section",
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "subtitle",
            "default": "Our Promise",
            "label": "Subtitle"
        },
        {
            "type": "text",
            "id": "heading",
            "default": "Thoughtfully Crafted for Your Skin",
            "label": "Heading"
        }
    ],
    "blocks": [
        {
            "type": "accordion_item",
            "name": "Accordion Item",
            "settings": [
            {
                "type": "text",
                "id": "title",
                "default": "Accordion title",
                "label": "Title"
            },
            {
                "type": "richtext",
                "id": "text",
                "default": "<p>Accordion description text goes here.</p>",
                "label": "Content"
            }
            ]
        }
    ],
    "presets": [
      {
        "name": "Promise Section",
        "blocks": [
            {
                "type": "accordion_item",
                "settings": {
                    "title": "Responsible Beauty Commitment",
                    "text": "<p>Our promise extends beyond skincare. We embrace responsible practices that respect people, animals, and the planet at every step.</p>"
                }
            },
            {
                "type": "accordion_item",
                "settings": {
                    "title": "Honest & Transparent Process",
                    "text": "<p>We believe in full transparency — from ingredient sourcing to formulation. You deserve to know exactly what goes into every product.</p>"
                }
            },
            {
                "type": "accordion_item",
                "settings": {
                    "title": "Gentle Yet Effective Formulas",
                    "text": "<p>Our formulations balance gentleness with efficacy, ensuring your skin receives the care it needs without irritation or compromise.</p>"
                }
            },
            {
                "type": "accordion_item",
                "settings": {
                    "title": "Thoughtfully Chosen Ingredients",
                    "text": "<p>Every ingredient is carefully selected for its proven benefits, purity, and compatibility with all skin types.</p>"
                }
            }
        ]
      }
    ]
  }
{% endschema %}