<div
    data-section-id="{{ section.id }}"
    class="promise-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="promise-section"
    data-component-id="{{ section.id }}"
    x-data="motionRevealSection()"
    data-motion-section
>
    <div class="layout container-page text-theme-text">
        <div class="grid grid-cols-1 gap-8 pc:grid-cols-2 pc:grid-rows-[auto_auto] pc:items-stretch pc:gap-10 fw:gap-16">
            {% comment %} Right - Heading {% endcomment %}
            <div
                class="order-1 pc:order-2 pc:col-start-2 pc:row-start-1 pc:max-w-160"
                data-motion-reveal="content"
            >
                <p class="sub-heading mb-4">{{ section.settings.subtitle }}</p>
                <h1 class="heading-xl text-balance">
                    {{ section.settings.heading }}
                </h1>
            </div>

            {% comment %} Left - Image {% endcomment %}
            <div
                class="order-2 min-h-80 overflow-hidden rounded-sm pc:order-1 pc:col-start-1 pc:row-span-2 pc:row-start-1 pc:h-full pc:min-h-0"
            >
                {%- assign image_alt_fallback = 'sections.promise-section.defaults.image_alt'
                    | t
                -%}
                {%- assign promise_image_alt = section.settings.image.alt
                    | default: image_alt_fallback
                    | escape
                -%}
                {%- render 'image',
                    image: section.settings.image,
                    alt: promise_image_alt,
                    class: 'h-full',
                    aspect_ratio: '1/1',
                    width: section.settings.image.width
                -%}
            </div>

            {% comment %} Right - Accordion  {% endcomment %}
            <div
                class="order-3 flex h-full flex-col gap-9 pc:order-3 pc:col-start-2 pc:row-start-2 pc:justify-start pc:gap-8"
                data-motion-reveal="content"
            >
                {% comment %} Accordion {% endcomment %}
                {%- render 'accordion',
                    blocks: section.blocks,
                    initial_active: 0,
                    id_prefix: section.id,
                    icon_type: 'chevron',
                    wrapper_class: 'flex flex-col',
                    item_class: 'border-t border-theme-border-20 first:border-t-0',
                    title_active_class: 'heading-h4 text-theme-text',
                    title_inactive_class: 'heading-h4 text-theme-text opacity-80',
                    content_class: 'rte rte--compact pb-6 pe-8 text-theme-text opacity-80'
                -%}
            </div>
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:sections.promise-section.name",
    "tag": "section",
    "class": "section",
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.promise-section.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:sections.promise-section.settings.image"
        },
        {
            "type": "inline_richtext",
            "id": "subtitle",
            "default": "t:sections.promise-section.defaults.subtitle",
            "label": "t:sections.promise-section.settings.subtitle"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "default": "t:sections.promise-section.defaults.heading",
            "label": "t:sections.promise-section.settings.heading"
        },
        {
            "type": "header",
            "content": "t:sections.promise-section.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.promise-section.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.promise-section.settings.padding_bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "accordion_item",
            "name": "t:sections.promise-section.blocks.accordion_item",
            "settings": [
                {
                    "type": "inline_richtext",
                    "id": "title",
                    "default": "t:sections.promise-section.blocks_defaults.title",
                    "label": "t:sections.promise-section.block_settings.title"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "default": "t:sections.promise-section.blocks_defaults.text",
                    "label": "t:sections.promise-section.block_settings.content"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.promise-section.presets.promise_section",
            "blocks": [
                {
                    "type": "accordion_item",
                    "settings": {
                        "title": "Responsible Beauty Commitment",
                        "text": "<p>Our promise extends beyond skincare. We embrace responsible practices that respect people, animals, and the planet at every step.</p>"
                    }
                },
                {
                    "type": "accordion_item",
                    "settings": {
                        "title": "Honest & Transparent Process",
                        "text": "<p>We believe in full transparency — from ingredient sourcing to formulation. You deserve to know exactly what goes into every product.</p>"
                    }
                },
                {
                    "type": "accordion_item",
                    "settings": {
                        "title": "Gentle Yet Effective Formulas",
                        "text": "<p>Our formulations balance gentleness with efficacy, ensuring your skin receives the care it needs without irritation or compromise.</p>"
                    }
                },
                {
                    "type": "accordion_item",
                    "settings": {
                        "title": "Thoughtfully Chosen Ingredients",
                        "text": "<p>Every ingredient is carefully selected for its proven benefits, purity, and compatibility with all skin types.</p>"
                    }
                }
            ]
        }
    ]
}
{% endschema %}
