{%- liquid
    assign promise_heading_class = section.settings.heading_size | default: 'title-xl'
-%}
{%- capture promise_children -%}
    <div class="grid grid-cols-1 gap-8 text-theme-text pc:grid-cols-2 pc:grid-rows-[auto_auto] pc:items-stretch pc:gap-10 fw:gap-16">
        {% comment %} Right - Heading {% endcomment %}
        <div
            class="order-1 pc:order-2 pc:col-start-2 pc:row-start-1"
        >
            {%- capture promise_heading_copy -%}
                {% render 'text',
                    subtitle: true,
                    content: section.settings.subtitle,
                %}
                {% render 'heading',
                    level: '1',
                    tier: promise_heading_class,
                    class: 'text-balance',
                    content: section.settings.heading,
                %}
            {%- endcapture -%}
            {% render 'content-group',
                gap: 'related',
                children: promise_heading_copy
            %}
        </div>

        {% comment %} Left - Image {% endcomment %}
        <div
            class="order-2 min-h-80 overflow-hidden rounded-sm pc:order-1 pc:col-start-1 pc:row-span-2 pc:row-start-1 pc:h-full pc:min-h-0"
        >
            {%- assign image_alt_fallback = 'sections.promise-section.defaults.image_alt'
                | t
            -%}
            {%- assign promise_image_alt = section.settings.image.alt
                | default: image_alt_fallback
                | escape
            -%}
            {%- render 'image',
                image: section.settings.image,
                placeholder_key: 'lifestyle-1',
                alt: promise_image_alt,
                class: 'h-full',
                aspect_ratio: '1/1',
                width: section.settings.image.width
            -%}
        </div>

        {% comment %} Right - Accordion  {% endcomment %}
        <div class="order-3 flex h-full flex-col gap-9 pc:order-3 pc:col-start-2 pc:row-start-2 pc:justify-start pc:gap-8">
            {%- render 'accordion',
                blocks: section.blocks,
                initial_active: 0,
                id_prefix: section.id,
                icon_type: 'chevron',
                wrapper_class: 'flex flex-col',
                item_class: 'border-t border-line first:border-t-0',
                title_active_class: 'text-theme-text',
                title_inactive_class: 'text-theme-text opacity-80',
                content_class: 'rte rte--compact pb-6 pe-8 text-theme-text opacity-80'
            -%}
        </div>
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: 'promise-section',
    motion: false,
    children: promise_children
%}

{% schema %}
{
    "name": "t:sections.promise-section.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer", "custom.overlay"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.promise-section.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:sections.promise-section.settings.image"
        },
        {
            "type": "inline_richtext",
            "id": "subtitle",
            "default": "t:sections.promise-section.defaults.subtitle",
            "label": "t:sections.promise-section.settings.subtitle"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "default": "t:sections.promise-section.defaults.heading",
            "label": "t:sections.promise-section.settings.heading"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "title-4xl",
                    "label": "t:settings.type_size.title_4xl"
                },
                {
                    "value": "title-3xl",
                    "label": "t:settings.type_size.title_3xl"
                },
                {
                    "value": "title-2xl",
                    "label": "t:settings.type_size.title_2xl"
                },
                {
                    "value": "title-xl",
                    "label": "t:settings.type_size.title_xl"
                },
                {
                    "value": "title-l",
                    "label": "t:settings.type_size.title_l"
                },
                {
                    "value": "title-m",
                    "label": "t:settings.type_size.title_m"
                },
                {
                    "value": "title-s",
                    "label": "t:settings.type_size.title_s"
                },
                {
                    "value": "title-xs",
                    "label": "t:settings.type_size.title_xs"
                }
            ],
            "default": "title-xl"
        },
        {
            "type": "header",
            "content": "t:sections.promise-section.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.promise-section.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.promise-section.settings.padding_bottom",
            "default": 32
        }
    ],
    "blocks": [
        {
            "type": "accordion_item",
            "name": "t:sections.promise-section.blocks.accordion_item",
            "settings": [
                {
                    "type": "header",
                    "content": "t:sections.blog-stories.content.card_title"
                },
                {
                    "type": "select",
                    "id": "title_size",
                    "label": "t:sections.slides-show.settings.heading_size",
                    "options": [
                        {
                            "value": "title-4xl",
                            "label": "t:settings.type_size.title_4xl"
                        },
                        {
                            "value": "title-3xl",
                            "label": "t:settings.type_size.title_3xl"
                        },
                        {
                            "value": "title-2xl",
                            "label": "t:settings.type_size.title_2xl"
                        },
                        {
                            "value": "title-xl",
                            "label": "t:settings.type_size.title_xl"
                        },
                        {
                            "value": "title-l",
                            "label": "t:settings.type_size.title_l"
                        },
                        {
                            "value": "title-m",
                            "label": "t:settings.type_size.title_m"
                        },
                        {
                            "value": "title-s",
                            "label": "t:settings.type_size.title_s"
                        },
                        {
                            "value": "title-xs",
                            "label": "t:settings.type_size.title_xs"
                        }
                    ],
                    "default": "title-m"
                },
                {
                    "type": "inline_richtext",
                    "id": "title",
                    "default": "t:sections.promise-section.blocks_defaults.title",
                    "label": "t:sections.promise-section.block_settings.title"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "default": "t:sections.promise-section.blocks_defaults.text",
                    "label": "t:sections.promise-section.block_settings.content"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.promise-section.presets.promise_section",
            "blocks": [
                {
                    "type": "accordion_item"
                },
                {
                    "type": "accordion_item"
                },
                {
                    "type": "accordion_item"
                },
                {
                    "type": "accordion_item"
                }
            ]
        }
    ]
}
{% endschema %}
