{% assign desktop_media_width = section.settings.desktop_media_width | default: 60 | plus: 0 %}
{% assign desktop_info_width = 100 | minus: desktop_media_width %}

<div
    data-section-id="{{ section.id }}"
    class="
        featured-product-section full-width bg-theme-bg text-theme-text
        color-{{ section.settings.color_scheme }}
    "
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="featured-product"
    data-component-id="{{ section.id }}"
>
    <div class="layout container-page overflow-visible!">
        <div
            class="grid w-full min-w-0 grid-cols-1 items-start gap-8 pc:grid-cols-[minmax(0,var(--product-media-fr))_minmax(0,var(--product-info-fr))] pc:items-stretch pc:gap-10 fw:gap-12"
            style="
                --product-media-fr: {{ desktop_media_width }}fr;
                --product-info-fr: {{ desktop_info_width }}fr;
            "
        >
            <div
                class="flex min-w-0 flex-col gap-8"
                data-product-media-column
            >
                <div
                    class="min-w-0 overflow-hidden"
                    data-product-media-panel
                    data-product-media-sticky-target
                >
                    {% assign thumb_position = section.settings.thumb_position | default: 'left' %}
                    {%- render 'product-gallery',
                        images: section.settings.product.images,
                        layout: 'thumbnails',
                        thumb_position: thumb_position,
                        thumbnail_visible_count: section.settings.thumbnail_visible_count,
                        aspect_ratio: '3/4'
                    -%}
                </div>
            </div>

            <div class="min-w-0" data-product-info-panel>
                <div class="self-start" data-product-info-sticky-target>
                    {%- render 'product-info-blocks',
                        product: section.settings.product,
                        section: section,
                        context: 'featured',
                        render_column: 'form',
                        container_class: 'px-6 py-4 pc:px-10 pc:py-6'
                    -%}
                </div>
            </div>
        </div>
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        const Utils = window.__Theme__?.Utils;
        if (!Components || !Utils?.setupProductLayout) return;

        Components.register(
            'featured-product',
            {
                init(el) {
                    return Utils.setupProductLayout(el);
                },

                destroy(el, state) {
                    if (state?.frame) cancelAnimationFrame(state.frame);
                    state?.resizeObserver?.disconnect?.();
                    window.removeEventListener('resize', state?.sync);
                    state?.desktopQuery?.removeEventListener?.('change', state?.sync);
                    state?.reset?.();
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{% schema %}
{
    "name": "Featured Product",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color Scheme",
            "default": "color-scheme-1"
        },
        {
            "type": "product",
            "id": "product",
            "label": "Select Product"
        },
        {
            "type": "select",
            "id": "thumb_position",
            "label": "Thumbnail position",
            "options": [
                { "value": "left", "label": "Left" },
                { "value": "bottom", "label": "Bottom" }
            ],
            "default": "left"
        },
        {
            "type": "range",
            "id": "desktop_media_width",
            "min": 40,
            "max": 60,
            "step": 1,
            "unit": "%",
            "label": "Desktop media width",
            "default": 60
        },
        {
            "type": "select",
            "id": "thumbnail_visible_count",
            "label": "Bottom visible thumbnails",
            "options": [
                { "value": "3", "label": "3" },
                { "value": "4", "label": "4" },
                { "value": "5", "label": "5" },
                { "value": "6", "label": "6" }
            ],
            "default": "4",
            "info": "Applies when thumbnail position is bottom."
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "@app"
        },
        {
            "type": "title",
            "name": "Title",
            "limit": 1
        },
        {
            "type": "vendor",
            "name": "Vendor",
            "limit": 1
        },
        {
            "type": "price",
            "name": "Price",
            "limit": 1
        },
        {
            "type": "description",
            "name": "Description",
            "limit": 1
        },
        {
            "type": "variant_picker",
            "name": "Variant picker",
            "limit": 1,
            "settings": [
                {
                    "type": "select",
                    "id": "picker_type",
                    "label": "Style",
                    "options": [
                        { "value": "dropdown", "label": "Dropdown" },
                        { "value": "button", "label": "Pills" }
                    ],
                    "default": "button"
                },
                {
                    "type": "select",
                    "id": "swatch_shape",
                    "label": "Swatch shape",
                    "options": [
                        { "value": "circle", "label": "Circle" },
                        { "value": "square", "label": "Square" },
                        { "value": "none", "label": "None" }
                    ],
                    "default": "circle"
                }
            ]
        },
        {
            "type": "quantity_selector",
            "name": "Quantity selector",
            "limit": 1
        },
        {
            "type": "buy_buttons",
            "name": "Buy buttons",
            "limit": 1,
            "settings": [
                {
                    "type": "checkbox",
                    "id": "show_dynamic_checkout",
                    "label": "Show dynamic checkout buttons",
                    "info": "Using the payment methods available on your store, customers see their preferred option, like PayPal or Apple Pay.",
                    "default": true
                }
            ]
        },
        {
            "type": "custom_liquid",
            "name": "Custom liquid",
            "settings": [
                {
                    "type": "liquid",
                    "id": "custom_liquid",
                    "label": "Custom liquid"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Featured Product",
            "settings": {},
            "blocks": [
                { "type": "vendor" },
                { "type": "title" },
                { "type": "price" },
                { "type": "description" },
                { "type": "variant_picker" },
                { "type": "quantity_selector" },
                { "type": "buy_buttons" }
            ]
        }
    ]
}
{% endschema %}
