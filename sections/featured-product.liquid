{% assign desktop_media_width = section.settings.desktop_media_width | default: 60 | plus: 0 %}
{% assign desktop_info_width = 100 | minus: desktop_media_width %}
{% assign featured_product = section.settings.product %}
{% assign gallery_layout = section.settings.gallery_layout | default: 'thumbnails' %}
{% assign featured_use_carousel = false %}
{% if gallery_layout == 'carousel' %}
    {% assign featured_use_carousel = true %}
{% endif %}

{%- capture featured_product_children -%}
    <div
        x-data="productLayout"
        data-module-id="product-layout"
    >
        <div
            class="featured-product__layout w-full min-w-0{% if featured_use_carousel %} featured-product__layout--carousel{% endif %}"
            style="
                --product-media-fr: {{ desktop_media_width }}fr;
                --product-info-fr: {{ desktop_info_width }}fr;
            "
        >
            <div
                class="featured-product__media-column min-w-0"
                data-product-media-column
            >
                <div
                    class="featured-product__media-sticky flex w-full min-w-0 flex-col gap-8"
                    data-product-media-sticky-target
                >
                    <div
                        class="featured-product__media-panel min-w-0 overflow-hidden{% if featured_use_carousel %} featured-product__media-panel--carousel{% endif %}"
                        data-product-media-panel
                    >
                        {% assign thumb_position = section.settings.thumb_position | default: 'left' %}
                        {%- assign gallery_id = 'product-gallery-featured-' | append: section.id -%}
                        {%- if featured_product != blank -%}
                            {%- if featured_use_carousel -%}
                                {%- render 'product-gallery',
                                    media: featured_product.media,
                                    id: gallery_id,
                                    layout: 'carousel',
                                    pagination: 'vertical',
                                    class: 'featured-product__gallery h-full'
                                -%}
                            {%- else -%}
                                {%- render 'product-gallery',
                                    media: featured_product.media,
                                    id: gallery_id,
                                    layout: 'thumbnails',
                                    thumb_position: thumb_position,
                                    thumbnail_size: section.settings.thumbnail_size,
                                    aspect_ratio: '3/4'
                                -%}
                            {%- endif -%}
                        {%- else -%}
                            {%- render 'image',
                                image: blank,
                                placeholder_key: 'product-1',
                                aspect_ratio: '3/4',
                                mode: 'frame',
                                fit: 'contain'
                            -%}
                        {%- endif -%}
                    </div>
                </div>
            </div>

            <div
                class="featured-product__info-column min-w-0"
                data-product-info-panel
            >
                <div class="featured-product__info-sticky self-start" data-product-info-sticky-target>
                    {%- liquid
                        assign featured_info_class = 'px-6 py-4 pc:py-6'
                        if featured_use_carousel
                            assign featured_info_class = featured_info_class | append: ' featured-product__info-inset'
                        else
                            assign featured_info_class = featured_info_class | append: ' pc:px-10'
                        endif
                    -%}
                    {%- render 'product-info-blocks',
                        product: featured_product,
                        section: section,
                        context: 'featured',
                        render_column: 'form',
                        container_class: featured_info_class
                    -%}
                </div>
            </div>
        </div>
    </div>
{%- endcapture -%}

{%- liquid
    assign featured_frame_root_class = ''
    if featured_use_carousel
        assign featured_frame_root_class = 'featured-product-section--carousel'
    endif
-%}

{% render 'section-frame',
    section: section,
    section_class: 'featured-product-section',
    root_class: featured_frame_root_class,
    width: 'page',
    height_kind: 'content',
    clip: false,
    children: featured_product_children
%}

{% stylesheet %}
    .featured-product__layout {
        display: grid;
        width: 100%;
        min-width: 0;
        grid-template-columns: minmax(0, 1fr);
        align-items: start;
        gap: 2rem;
    }

    @media (width >= 64rem) {
        .featured-product__layout {
            grid-template-columns:
                minmax(0, var(--product-media-fr))
                minmax(0, var(--product-info-fr));
            align-items: stretch;
            gap: 2.5rem;
        }

        .featured-product-section--carousel .featured-product__layout--carousel {
            align-items: stretch;
        }

        .featured-product-section--carousel .featured-product__info-sticky,
        .featured-product-section--carousel .product-info-blocks--featured {
            height: 100%;
        }

        .featured-product-section--carousel .product-info-blocks--featured {
            justify-content: space-between;
        }

        .featured-product-section--carousel .product-info-blocks--featured > * {
            margin-top: 0;
        }

        .featured-product-section--carousel .featured-product__media-sticky {
            height: min(calc(var(--screen-height) - 6rem), 96rem);
        }

        .featured-product-section--carousel .featured-product__media-panel--carousel,
        .featured-product-section--carousel .featured-product__gallery,
        .featured-product-section--carousel .featured-product__gallery > .h-full,
        .featured-product-section--carousel .featured-product__gallery .theme-image {
            height: 100%;
        }

        .featured-product-section--carousel .featured-product__gallery img {
            height: 100%;
            object-fit: contain;
        }

        .featured-product-section--carousel .featured-product__media-panel--carousel {
            border-radius: 0;
        }

        .featured-product__info-inset {
            padding-inline: 0;
        }
    }

    .featured-product__media-panel--carousel {
        --swiper-pagination-color: rgb(var(--color-foreground));
        --swiper-pagination-bullet-inactive-color: rgb(var(--color-foreground));
        --swiper-pagination-bullet-inactive-opacity: 0.3;
        border-radius: var(--radius-sm);
    }
{% endstylesheet %}

