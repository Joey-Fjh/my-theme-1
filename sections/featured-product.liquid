{% assign desktop_media_width = section.settings.desktop_media_width | default: 60 | plus: 0 %}
{% assign desktop_info_width = 100 | minus: desktop_media_width %}

<div
    data-section-id="{{ section.id }}"
    class="featured-product-section full-width color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="featured-product"
    data-component-id="{{ section.id }}"
    x-data="productLayout"
>
    <div class="layout container-page overflow-visible!">
        <div
            class="grid w-full min-w-0 grid-cols-1 items-start gap-8 pc:grid-cols-[minmax(0,var(--product-media-fr))_minmax(0,var(--product-info-fr))] pc:items-stretch pc:gap-10 fw:gap-12"
            style="
                --product-media-fr: {{ desktop_media_width }}fr;
                --product-info-fr: {{ desktop_info_width }}fr;
            "
        >
            <div
                class="flex min-w-0 flex-col gap-8"
                data-product-media-column
            >
                <div
                    class="min-w-0 overflow-hidden"
                    data-product-media-panel
                    data-product-media-sticky-target
                >
                    {% assign thumb_position = section.settings.thumb_position | default: 'left' %}
                    {%- render 'product-gallery',
                        images: section.settings.product.images,
                        layout: 'thumbnails',
                        thumb_position: thumb_position,
                        thumbnail_visible_count: section.settings.thumbnail_visible_count,
                        aspect_ratio: '3/4'
                    -%}
                </div>
            </div>

            <div class="min-w-0" data-product-info-panel>
                <div class="self-start" data-product-info-sticky-target>
                    {%- render 'product-info-blocks',
                        product: section.settings.product,
                        section: section,
                        context: 'featured',
                        render_column: 'form',
                        container_class: 'px-6 py-4 pc:px-10 pc:py-6'
                    -%}
                </div>
            </div>
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:sections.featured-product.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.featured-product.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "product",
            "id": "product",
            "label": "t:sections.featured-product.settings.select_product"
        },
        {
            "type": "select",
            "id": "thumb_position",
            "label": "t:sections.featured-product.settings.thumbnail_position",
            "options": [
                {
                    "value": "left",
                    "label": "t:sections.featured-product.options.left"
                },
                {
                    "value": "bottom",
                    "label": "t:sections.featured-product.options.bottom"
                }
            ],
            "default": "left"
        },
        {
            "type": "range",
            "id": "desktop_media_width",
            "min": 40,
            "max": 60,
            "step": 1,
            "unit": "%",
            "label": "t:sections.featured-product.settings.desktop_media_width",
            "default": 60
        },
        {
            "type": "select",
            "id": "thumbnail_visible_count",
            "label": "t:sections.featured-product.settings.bottom_visible_thumbnails",
            "options": [
                {
                    "value": "3",
                    "label": "t:sections.featured-product.options.3"
                },
                {
                    "value": "4",
                    "label": "t:sections.featured-product.options.4"
                },
                {
                    "value": "5",
                    "label": "t:sections.featured-product.options.5"
                },
                {
                    "value": "6",
                    "label": "t:sections.featured-product.options.6"
                }
            ],
            "default": "4",
            "info": "t:sections.featured-product.info.applies_when_thumbnail_position_is_botto"
        },
        {
            "type": "header",
            "content": "t:sections.featured-product.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.featured-product.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.featured-product.settings.padding_bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "@app"
        },
        {
            "type": "title",
            "name": "t:sections.featured-product.blocks.title",
            "limit": 1
        },
        {
            "type": "vendor",
            "name": "t:sections.featured-product.blocks.vendor",
            "limit": 1
        },
        {
            "type": "price",
            "name": "t:sections.featured-product.blocks.price",
            "limit": 1
        },
        {
            "type": "description",
            "name": "t:sections.featured-product.blocks.description",
            "limit": 1
        },
        {
            "type": "variant_picker",
            "name": "t:sections.featured-product.blocks.variant_picker",
            "limit": 1,
            "settings": [
                {
                    "type": "select",
                    "id": "picker_type",
                    "label": "t:sections.featured-product.block_settings.style",
                    "options": [
                        {
                            "value": "dropdown",
                            "label": "t:sections.featured-product.options.dropdown"
                        },
                        {
                            "value": "button",
                            "label": "t:sections.featured-product.options.pills"
                        }
                    ],
                    "default": "button"
                },
                {
                    "type": "select",
                    "id": "swatch_shape",
                    "label": "t:sections.featured-product.block_settings.swatch_shape",
                    "options": [
                        {
                            "value": "circle",
                            "label": "t:sections.featured-product.options.circle"
                        },
                        {
                            "value": "square",
                            "label": "t:sections.featured-product.options.square"
                        },
                        {
                            "value": "none",
                            "label": "t:sections.featured-product.options.none"
                        }
                    ],
                    "default": "circle"
                }
            ]
        },
        {
            "type": "quantity_selector",
            "name": "t:sections.featured-product.blocks.quantity_selector",
            "limit": 1
        },
        {
            "type": "buy_buttons",
            "name": "t:sections.featured-product.blocks.buy_buttons",
            "limit": 1,
            "settings": [
                {
                    "type": "checkbox",
                    "id": "show_dynamic_checkout",
                    "label": "t:sections.featured-product.block_settings.show_dynamic_checkout_buttons",
                    "info": "t:sections.featured-product.block_info.using_the_payment_methods_available_on_y",
                    "default": true
                }
            ]
        },
        {
            "type": "custom_liquid",
            "name": "t:sections.featured-product.blocks.custom_liquid",
            "settings": [
                {
                    "type": "liquid",
                    "id": "custom_liquid",
                    "label": "t:sections.featured-product.block_settings.custom_liquid"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.featured-product.presets.featured_product",
            "settings": {},
            "blocks": [
                {
                    "type": "vendor"
                },
                {
                    "type": "title"
                },
                {
                    "type": "price"
                },
                {
                    "type": "description"
                },
                {
                    "type": "variant_picker"
                },
                {
                    "type": "quantity_selector"
                },
                {
                    "type": "buy_buttons"
                }
            ]
        }
    ]
}
{% endschema %}
