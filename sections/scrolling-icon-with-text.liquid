{%- liquid
    assign scrolling_direction = section.settings.direction | default: 'right_to_left'
    unless scrolling_direction == 'right_to_left' or scrolling_direction == 'left_to_right'
        assign scrolling_direction = 'right_to_left'
    endunless

    assign scrolling_speed = section.settings.speed | default: 'normal'
    unless scrolling_speed == 'slow' or scrolling_speed == 'normal' or scrolling_speed == 'fast'
        assign scrolling_speed = 'normal'
    endunless

    assign scrolling_gap = section.settings.gap | default: 40
    assign scrolling_height = section.settings.height | default: 120
    assign scrolling_content_scale = section.settings.content_scale | default: 100

    assign scrolling_pause_on_hover = true
    if section.settings.pause_on_hover == false
        assign scrolling_pause_on_hover = false
    endif

    if scrolling_pause_on_hover
        assign scrolling_pause_on_hover_attr = 'true'
    else
        assign scrolling_pause_on_hover_attr = 'false'
    endif

    assign scrolling_icon_size = scrolling_height | times: 42 | times: scrolling_content_scale | divided_by: 10000
    if scrolling_icon_size < 24
        assign scrolling_icon_size = 24
    endif

    assign scrolling_icon_size_max = scrolling_height | times: 50 | divided_by: 100
    if scrolling_icon_size > scrolling_icon_size_max
        assign scrolling_icon_size = scrolling_icon_size_max
    endif

    assign scrolling_icon_text_gap = scrolling_height | times: 10 | divided_by: 100
    if scrolling_icon_text_gap < 8
        assign scrolling_icon_text_gap = 8
    elsif scrolling_icon_text_gap > 20
        assign scrolling_icon_text_gap = 20
    endif

    assign scrolling_item_count = 0
    for block in section.blocks
        if block.settings.title != blank
            assign scrolling_item_count = scrolling_item_count | plus: 1
        endif
    endfor

    if scrolling_item_count == 1
        assign scrolling_copies_per_set = 6
    elsif scrolling_item_count == 2
        assign scrolling_copies_per_set = 3
    else
        assign scrolling_copies_per_set = 2
    endif
-%}

<div
    data-section-id="{{ section.id }}"
    class="scrolling-icon-with-text-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
        --scrolling-icon-gap: {{ scrolling_gap }}px;
        --scrolling-icon-height: {{ scrolling_height }}px;
        --scrolling-content-scale-pct: {{ scrolling_content_scale }};
        --scrolling-icon-media-size: {{ scrolling_icon_size }}px;
    "
>
    <div class="layout{% if section.settings.section_width == 'fixed' %} container-page{% endif %}">
        {%- if scrolling_item_count > 0 -%}
            {%- if section.settings.show_divider -%}
                <div
                    class="scrolling-icon-with-text__divider scrolling-icon-with-text__divider--top"
                    aria-hidden="true"
                ></div>
            {%- endif -%}

            <div
                class="scrolling-icon-with-text__marquee"
                data-scrolling-direction="{{ scrolling_direction }}"
                data-scrolling-speed="{{ scrolling_speed }}"
                data-scrolling-pause-on-hover="{{ scrolling_pause_on_hover_attr }}"
            >
                <div class="scrolling-icon-with-text__viewport">
                    <div class="scrolling-icon-with-text__track">
                        {%- for pass in (1..2) -%}
                            {%- for copy in (1..scrolling_copies_per_set) -%}
                                {%- for block in section.blocks -%}
                                    {%- liquid
                                        assign block_title = block.settings.title
                                        assign block_image = block.settings.image_icon
                                        assign block_icon = block.settings.icon | default: 'icon-content-check'
                                        assign block_layout = block.settings.layout | default: 'horizontal'
                                        assign is_primary_item = false
                                        if pass == 1 and copy == 1
                                            assign is_primary_item = true
                                        endif
                                        # Marquee duplicates stay visible for seamless scroll fill and keep
                                        # pointer/touch links on every copy. Duplicates are excluded from
                                        # assistive tech and sequential Tab navigation via aria-hidden and
                                        # tabindex="-1"; semantics and keyboard entry stay on the canonical
                                        # primary set only.
                                        assign block_link = block.settings.link
                                        assign block_link_tabindex = blank
                                        unless is_primary_item
                                            assign block_link_tabindex = '-1'
                                        endunless
                                    -%}
                                    {%- if block_title != blank -%}
                                        <div
                                            class="scrolling-icon-with-text__item"
                                            {% unless is_primary_item %}
                                                aria-hidden="true"
                                            {% endunless %}
                                            {% if is_primary_item %}
                                                {{ block.shopify_attributes }}
                                            {% endif %}
                                        >
                                            {%- render 'icon-with-text-item',
                                                title: block_title,
                                                icon: block_icon,
                                                image_icon: block_image,
                                                link: block_link,
                                                link_tabindex: block_link_tabindex,
                                                icon_size: scrolling_icon_size,
                                                icon_size_mobile: scrolling_icon_size,
                                                direction: block_layout,
                                                gap: scrolling_icon_text_gap,
                                                alignment: 'center',
                                                class: 'scrolling-icon-with-text__icon-item',
                                                title_class: 'scrolling-icon-with-text__title font-medium whitespace-nowrap'
                                            -%}
                                        </div>
                                    {%- endif -%}
                                {%- endfor -%}
                            {%- endfor -%}
                        {%- endfor -%}
                    </div>
                </div>
            </div>

            {%- if section.settings.show_divider -%}
                <div
                    class="scrolling-icon-with-text__divider scrolling-icon-with-text__divider--bottom"
                    aria-hidden="true"
                ></div>
            {%- endif -%}
        {%- endif -%}
    </div>
</div>

