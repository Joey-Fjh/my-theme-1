{%- liquid
    assign scrolling_direction = section.settings.direction | default: 'right_to_left'
    unless scrolling_direction == 'right_to_left' or scrolling_direction == 'left_to_right'
        assign scrolling_direction = 'right_to_left'
    endunless

    assign scrolling_speed = section.settings.speed | default: 'normal'
    unless scrolling_speed == 'slow' or scrolling_speed == 'normal' or scrolling_speed == 'fast'
        assign scrolling_speed = 'normal'
    endunless

    assign scrolling_gap = section.settings.gap | default: 40
    assign scrolling_bar_padding = section.settings.bar_padding | default: 24
    assign scrolling_text_size_mobile = section.settings.text_size_mobile | default: 'body-xl'
    assign scrolling_text_size = section.settings.text_size | default: 'heading-h1'

    assign scrolling_text_mobile_class = 'max-pc:body-xl'
    case scrolling_text_size_mobile
        when 'body-3xl'
            assign scrolling_text_mobile_class = 'max-pc:body-3xl'
        when 'body-2xl'
            assign scrolling_text_mobile_class = 'max-pc:body-2xl'
        when 'body-xl'
            assign scrolling_text_mobile_class = 'max-pc:body-xl'
        when 'body-lg'
            assign scrolling_text_mobile_class = 'max-pc:body-lg'
        when 'body-md'
            assign scrolling_text_mobile_class = 'max-pc:body-md'
        when 'body-sm'
            assign scrolling_text_mobile_class = 'max-pc:body-sm'
        when 'body-xs'
            assign scrolling_text_mobile_class = 'max-pc:body-xs'
        when 'heading-h1'
            assign scrolling_text_mobile_class = 'max-pc:heading-h1'
        when 'heading-h2'
            assign scrolling_text_mobile_class = 'max-pc:heading-h2'
        when 'heading-h3'
            assign scrolling_text_mobile_class = 'max-pc:heading-h3'
        when 'heading-h4'
            assign scrolling_text_mobile_class = 'max-pc:heading-h4'
        when 'heading-h5'
            assign scrolling_text_mobile_class = 'max-pc:heading-h5'
        when 'heading-h6'
            assign scrolling_text_mobile_class = 'max-pc:heading-h6'
    endcase

    assign scrolling_text_desktop_class = 'pc:heading-h1'
    case scrolling_text_size
        when 'heading-4xl'
            assign scrolling_text_desktop_class = 'pc:heading-4xl'
        when 'heading-3xl'
            assign scrolling_text_desktop_class = 'pc:heading-3xl'
        when 'heading-2xl'
            assign scrolling_text_desktop_class = 'pc:heading-2xl'
        when 'heading-xl'
            assign scrolling_text_desktop_class = 'pc:heading-xl'
        when 'heading-h1'
            assign scrolling_text_desktop_class = 'pc:heading-h1'
        when 'heading-h2'
            assign scrolling_text_desktop_class = 'pc:heading-h2'
        when 'heading-h3'
            assign scrolling_text_desktop_class = 'pc:heading-h3'
        when 'heading-h4'
            assign scrolling_text_desktop_class = 'pc:heading-h4'
        when 'heading-h5'
            assign scrolling_text_desktop_class = 'pc:heading-h5'
        when 'heading-h6'
            assign scrolling_text_desktop_class = 'pc:heading-h6'
    endcase

    assign scrolling_text_tier_class = scrolling_text_mobile_class | append: ' ' | append: scrolling_text_desktop_class
    assign scrolling_separator = section.settings.separator

    assign scrolling_pause_on_hover = true
    if section.settings.pause_on_hover == false
        assign scrolling_pause_on_hover = false
    endif

    if scrolling_pause_on_hover
        assign scrolling_pause_on_hover_attr = 'true'
    else
        assign scrolling_pause_on_hover_attr = 'false'
    endif

    assign scrolling_item_count = 0
    for block in section.blocks
        if block.settings.title != blank
            assign scrolling_item_count = scrolling_item_count | plus: 1
        endif
    endfor

    assign scrolling_title_class = 'scrolling-icon-with-text__title font-normal whitespace-nowrap ' | append: scrolling_text_tier_class
    assign scrolling_separator_class = 'scrolling-icon-with-text__separator ' | append: scrolling_text_tier_class

    if scrolling_item_count == 1
        assign scrolling_copies_per_set = 6
    elsif scrolling_item_count == 2
        assign scrolling_copies_per_set = 3
    else
        assign scrolling_copies_per_set = 2
    endif
-%}

{%- liquid
    assign scrolling_icon_width = 'full'
    if section.settings.section_width == 'fixed'
        assign scrolling_icon_width = 'page'
    endif
-%}
{%- capture scrolling_icon_root_style -%}
--scrolling-icon-gap: {{ scrolling_gap }}px; --scrolling-bar-padding-y: {{ scrolling_bar_padding }}px;
{%- endcapture -%}
{%- capture scrolling_icon_children -%}
        {%- if scrolling_item_count > 0 -%}
            <div
                class="scrolling-icon-with-text__module relative"
                data-module-id="scrolling-marquee"
                x-data="scrollingMarquee()"
            >
                <div class="flex flex-col gap-4">
                    {%- if section.settings.show_divider -%}
                        <div
                            class="scrolling-icon-with-text__divider scrolling-icon-with-text__divider--top"
                            aria-hidden="true"
                        ></div>
                    {%- endif -%}

                    <div
                        class="scrolling-icon-with-text__marquee"
                        data-scrolling-marquee
                        data-scrolling-direction="{{ scrolling_direction }}"
                        data-scrolling-speed="{{ scrolling_speed }}"
                        data-scrolling-pause-on-hover="{{ scrolling_pause_on_hover_attr }}"
                        data-scrolling-velocity-k="1"
                        data-scrolling-max-rate="6"
                    >
                        <button
                            type="button"
                            class="scrolling-icon-with-text__pause-btn focus-ring"
                            data-scrolling-marquee-pause
                            aria-pressed="false"
                            aria-label="{{ 'accessibility.marquee_pause' | t }}"
                        ></button>
                        <div class="scrolling-icon-with-text__viewport">
                            <div class="scrolling-icon-with-text__track" data-scrolling-marquee-track>
                                {%- for pass in (1..2) -%}
                                    {%- for copy in (1..scrolling_copies_per_set) -%}
                                        {%- for block in section.blocks -%}
                                            {%- liquid
                                                assign block_title = block.settings.title
                                                assign block_image = block.settings.image_icon
                                                assign block_icon = block.settings.icon | default: 'icon-content-check'
                                                assign block_layout = block.settings.layout | default: 'horizontal'
                                                assign is_primary_item = false
                                                if pass == 1 and copy == 1
                                                    assign is_primary_item = true
                                                endif
                                                assign block_link = block.settings.link
                                                assign block_link_tabindex = blank
                                                unless is_primary_item
                                                    assign block_link_tabindex = '-1'
                                                endunless
                                            -%}
                                            {%- if block_title != blank -%}
                                                <div
                                                    class="scrolling-icon-with-text__item"
                                                    {% unless is_primary_item %}
                                                        aria-hidden="true"
                                                    {% endunless %}
                                                    {% if is_primary_item %}
                                                        {{ block.shopify_attributes }}
                                                    {% endif %}
                                                >
                                                    <div class="scrolling-icon-with-text__item-row">
                                                        {%- render 'icon-with-text-item',
                                                            title: block_title,
                                                            icon: block_icon,
                                                            image_icon: block_image,
                                                            link: block_link,
                                                            link_tabindex: block_link_tabindex,
                                                            icon_size: 16,
                                                            icon_size_mobile: 16,
                                                            direction: block_layout,
                                                            gap: 8,
                                                            alignment: 'center',
                                                            class: 'scrolling-icon-with-text__icon-item',
                                                            title_class: scrolling_title_class
                                                        -%}
                                                        {%- if scrolling_separator != blank -%}
                                                            <span
                                                                class="{{ scrolling_separator_class }}"
                                                                aria-hidden="true"
                                                            >
                                                                {{- scrolling_separator -}}
                                                            </span>
                                                        {%- endif -%}
                                                    </div>
                                                </div>
                                            {%- endif -%}
                                        {%- endfor -%}
                                    {%- endfor -%}
                                {%- endfor -%}
                            </div>
                        </div>
                    </div>

                    {%- if section.settings.show_divider -%}
                        <div
                            class="scrolling-icon-with-text__divider scrolling-icon-with-text__divider--bottom"
                            aria-hidden="true"
                        ></div>
                    {%- endif -%}
                </div>
            </div>
        {%- endif -%}
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: 'scrolling-icon-with-text-section',
    width: scrolling_icon_width,
    motion: false,
    root_style: scrolling_icon_root_style,
    children: scrolling_icon_children
%}

{% stylesheet %}
    @layer snippets {
        .scrolling-icon-with-text-section {
            width: 100%;
            min-width: calc(var(--spacing) * 0);
            overflow: hidden;
        }
        .scrolling-icon-with-text__divider {
            border-bottom-style: solid;
            border-bottom-width: 1px;
            border-color: var(--color-line);
        }
        .scrolling-icon-with-text__marquee {
            position: relative;
            width: 100%;
            min-width: calc(var(--spacing) * 0);
        }
        .scrolling-icon-with-text__pause-btn {
            position: absolute;
            right: 0.8rem;
            bottom: 0.8rem;
            z-index: 2;
            width: 2.4rem;
            min-width: 2.4rem;
            height: 2.4rem;
            min-height: 2.4rem;
            padding: 0;
            border: 0;
            border-radius: 9999px;
            background: var(--color-surface-strong);
            color: rgb(var(--color-foreground));
            cursor: pointer;
            opacity: 0;
            pointer-events: none;
        }
        .scrolling-icon-with-text__pause-btn:focus-visible {
            opacity: 1;
            pointer-events: auto;
        }
        .scrolling-icon-with-text__pause-btn::before,
        .scrolling-icon-with-text__pause-btn::after {
            content: '';
            position: absolute;
            top: 50%;
            width: 0.2rem;
            height: 1rem;
            margin-top: -0.5rem;
            border-radius: 1px;
            background: currentcolor;
        }
        .scrolling-icon-with-text__pause-btn::before {
            left: calc(50% - 0.35rem);
        }
        .scrolling-icon-with-text__pause-btn::after {
            left: calc(50% + 0.15rem);
        }
        .scrolling-icon-with-text__pause-btn[aria-pressed='true']::after {
            content: none;
            width: 0;
            height: 0;
            margin-top: 0;
            border-radius: 0;
            background: none;
        }
        .scrolling-icon-with-text__pause-btn[aria-pressed='true']::before {
            content: '';
            width: 0;
            height: 0;
            left: calc(50% - 0.35rem);
            top: 50%;
            margin-top: -0.5rem;
            border-radius: 0;
            background: none;
            border-style: solid;
            border-width: 0.5rem 0 0.5rem 0.85rem;
            border-color: transparent transparent transparent currentcolor;
        }
    }
    @layer snippets {
        @media (hover: hover) and (pointer: fine) {
            .scrolling-icon-with-text__marquee[data-scrolling-pause-on-hover='true'] {
                pointer-events: auto;
            }
        }
    }
    @layer snippets {
        .scrolling-icon-with-text__viewport {
            position: relative;
            width: 100%;
            overflow: hidden;
            padding-block: var(--scrolling-bar-padding-y, 24px);
        }

        @media (width < 48rem) {
            .scrolling-icon-with-text__viewport {
                padding-block: calc(var(--scrolling-bar-padding-y, 24px) * 0.6);
            }
        }

        .scrolling-icon-with-text__track {
            display: flex;
            width: max-content;
            align-items: center;
            will-change: transform;
        }
        .scrolling-icon-with-text__item {
            display: flex;
            flex-shrink: 0;
            align-items: center;
            padding-inline-end: var(--scrolling-icon-gap, 40px);
        }
        .scrolling-icon-with-text__item-row {
            display: inline-flex;
            flex-shrink: 0;
            align-items: center;
        }
        .scrolling-icon-with-text__separator {
            flex-shrink: 0;
            margin-inline-start: 0.5em;
            margin-inline-end: 0;
            line-height: 1;
            font-weight: 400;
            font-size: inherit;
        }
        .scrolling-icon-with-text__icon-item {
            flex-shrink: 0;
            --icon-with-text-icon-size: 1em;
            --icon-with-text-icon-size-mobile: 1em;
            --icon-with-text-gap: 0.5em;
        }
        .scrolling-icon-with-text__icon-item .icon-with-text-item__image {
            width: 1em;
            height: 1em;
        }
        .scrolling-icon-with-text__icon-item .content-icon {
            width: 1em;
            height: 1em;
            --content-icon-size: 1em;
        }
    }

    .scrolling-icon-with-text-section .scrolling-icon-with-text__title,
    .scrolling-icon-with-text-section .scrolling-icon-with-text__separator {
        line-height: 1;
    }
{% endstylesheet %}

