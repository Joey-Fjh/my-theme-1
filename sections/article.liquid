<div
  data-section-id="{{ section.id }}"
  class="article-section full-width"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  data-component-kind="section"
  data-component-type="article"
  data-component-id="{{ section.id }}"
>
  <div class="max-h-200 overflow-hidden">
    {%- capture sizes -%}
      (min-width: 80rem) 100vw, (min-width: 48rem) 1280px, 768px
    {%- endcapture -%}
    
    {%- capture widths -%}
      400,768,1280,1536,2560
    {%- endcapture -%}

    {%- assign image = article.image -%}
    {%- if section.settings.image -%}
      {%- assign image = section.settings.image -%}
    {%- endif -%}

    {%- render 'image', 
      image: image,
      alt: image.alt | default: section.settings.image_alt | escape,
      width: image.width,
      sizes: sizes,
      widths: widths
    -%}
  </div>

  <div class="max-h-200 layout container-page absolute inset-0">
    <div class="text-white flex flex-col justify-center items-center text-center gap-5 max-w-1/2 mx-auto">
      <h3 
        class="opacity-80"
      >
        cateogires
      </h3>
      <h1 
        class="font-bold hxl"
      >
        {{ article.title }}
      </h1>
    </div>
  </div>

  <div class="layout-special container-page bg-[#FBFBFB] text-[#263D29]">
    <div class="flex flex-col pc:flex-row gap-30 pc:gap-60">
      {% comment %} Aside Bar {% endcomment %}
      <aside class="shrink-0 opacity-0 -translate-x-7.5 h2" data-gsap-sidebar>
        <nav class="pc:sticky">
          <ul 
            id="toc-container" 
            class="flex flex-row pc:flex-col gap-9 overflow-x-auto pc:overflow-x-hidden"
          >
            {% # theme-check-disable-next-line LiquidHTMLSyntaxError %}
            {%- for a in blog.articles limit: section.settings.max_items -%}
              <li>
                <a 
                  href="{{ a.url }}"
                  class="block leading-snug transition-colors duration-200 border-b
                  {% if a.id == article.id %} 
                    text-[#2d3a2e] 
                  {% else %}
                    text-[#6b6b6b] hover:text-[#2d3a2e]
                  {% endif %}"
                >
                  {{ a.title }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      </aside>  

      {% comment %} Article  {% endcomment %}
      <article class="flex-1 min-w-0 opacity-0 translate-y-7.5 article-content" data-gsap-content>
        <div class="flex justify-between items-center border-b border-[#e5e5e5] pb-3">
          <h1>{{ article.title }}</h1>
          {%- assign date = article.published_at | time_tag: format: 'date' -%}
          <p>{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
        </div>
        <div class="py-10">
          {{ article.content }}
        </div>
        <div class="flex flex-col gap-3 border-t border-[#e5e5e5] pt-3">
          {%- if section.settings.show_social -%}
            {%- render 'social-icons',type:'name',class:'self-end' -%}
          {%- endif -%}
        </div>
      </article>
    </div>
  </div>
</div>

{%- javascript -%}
  (function () {
    const Components = window.__Theme__?.Components;
    if (!Components) return;

    Components.register(
      'article',
      {
        init(el) {
          if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;

          gsap.registerPlugin(ScrollTrigger);

          const sidebar = el.querySelector('[data-gsap-sidebar]');
          const content = el.querySelector('[data-gsap-content]');

          const ctx = gsap.context(() => {

            const tl = gsap.timeline({
              defaults: { ease: 'power2.out' }
            });

            /* Sidebar slide in */
            if (sidebar) {
              tl.to(sidebar, {
                opacity: 1,
                x: 0,
                duration: 0.7
              });
            }

            /* Content fade up */
            if (content) {
              tl.to(
                content,
                {
                  opacity: 1,
                  y: 0,
                  duration: 0.7
                },
                '-=0.4'
              );
            }

          }, el);

          return { ctx };
        },

        destroy(el, state) {
          if (state?.ctx) {
            state.ctx.revert();
          }
        }
      },
      { lazy: true }
    );
  })();
{%- endjavascript -%}

{%- stylesheet -%}
{%- endstylesheet -%}

{% schema %}
{
  "name": "t:general.article",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["article"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "default": "About Us",
      "label": "Image alt text"
    },
    {
      "type": "range",
      "id": "max_items",
      "min": 1,
      "max": 10,
      "step": 1,
      "default":8,
      "label": "Maximum items"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "Social icon",
      "info": "[Manage social accounts](/editor?context=theme&category=social%20icon)"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:general.article"
    }
  ]
}
{% endschema %}
