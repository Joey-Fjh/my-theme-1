<div
    data-section-id="{{ section.id }}"
    class="article-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="motionRevealSection()"
    data-motion-section
>
    {%- liquid
        assign article_heading_class = section.settings.heading_size | default: 'heading-2xl'
        assign article_subtitle_class = section.settings.subtitle_size | default: 'body-xl'
        assign article_heading = section.settings.heading
        if article_heading == blank
            assign article_heading = article.title
        endif
    -%}
    <div class="article-hero relative overflow-hidden pc:max-h-200">
        {%- capture sizes -%}
            (min-width: 80rem) 100vw, (min-width: 48rem) 1280px, 768px
        {%- endcapture -%}

        {%- capture widths -%}
            400,768,1280,1536,2560
        {%- endcapture -%}

        {%- assign image = article.image -%}
        {%- if section.settings.image -%}
            {%- assign image = section.settings.image -%}
        {%- endif -%}

        {%- assign image_alt = image.alt | default: section.settings.image_alt | escape -%}
        {%- render 'image',
            image: image,
            alt: image_alt,
            width: image.width,
            class: 'h-full w-full',
            img_class: 'h-full w-full object-cover object-center',
            sizes: sizes,
            widths: widths
        -%}

        <div class="article-hero__overlay absolute inset-0 z-10">
            <div
                class="article-hero__content mx-auto flex h-full w-full max-w-lg flex-col items-center justify-center gap-4 px-6 text-center pc:max-w-1/2 pc:gap-5"
                data-motion-reveal="content"
            >
                {%- if section.settings.eyebrow != blank -%}
                    <p class="{{ article_subtitle_class }}">
                        {{ section.settings.eyebrow }}
                    </p>
                {%- endif -%}

                <h1
                    class="{{ article_heading_class }} line-clamp-3 max-w-full min-w-0"
                    title="{{ article_heading | strip_html | escape }}"
                >
                    {{ article_heading }}
                </h1>
            </div>
        </div>
    </div>

    <div class="layout layout-no-pt container-page mt-12">
        <div class="flex flex-col gap-16 pc:flex-row pc:gap-24 fw:gap-32">
            {% comment %} Aside Bar {% endcomment %}
            <aside
                class="shrink-0 body-xl max-pc:hidden pc:w-72 fw:w-80"
                data-motion-reveal="content"
            >
                <nav class="pc:sticky">
                    <ul
                        id="toc-container"
                        class="flex w-fit max-w-full flex-row gap-9 overflow-x-auto pc:w-full pc:flex-col pc:overflow-x-hidden"
                    >
                        {% # theme-check-disable-next-line LiquidHTMLSyntaxError %}
                        {%- for a in blog.articles limit: section.settings.max_items -%}
                            <li class="min-w-0">
                                <a
                                    href="{{ a.url }}"
                                    class="
                                        article-sidebar__link inline-block max-w-full truncate underline-offset-4 hover:underline
                                        {% if a.id == article.id %}
                                          text-theme-text/80 underline
                                        {% else %}
                                          text-theme-text/50 hover:text-theme-text/80
                                        {% endif %}
                                    "
                                >
                                    {{ a.title }}
                                </a>
                            </li>
                        {%- endfor -%}
                    </ul>
                </nav>
            </aside>

            {% comment %} Article  {% endcomment %}
            <article
                class="article-content min-w-0 flex-1"
                data-motion-reveal="content"
            >
                <div class="flex items-center justify-end border-b border-theme-border/20 pb-3 body-xl">
                    {%- assign date = article.published_at | time_tag: format: 'date' -%}
                    <p>
                        {{ 'blog.article_metadata_html' | t: date: date, author: article.author }}
                    </p>
                </div>
                <div class="rte py-10">
                    {{ article.content }}
                </div>
                <div class="flex flex-col gap-3 border-t border-theme-border/20 pt-3">
                    {%- if section.settings.show_social -%}
                        {%- render 'social-icons', type: 'name', class: 'body-xl self-end' -%}
                    {%- endif -%}
                </div>

                {%- if blog.previous_article or blog.next_article or blog.url != blank -%}
                    <nav
                        class="article-mobile-nav mt-14 pc:hidden"
                        aria-label="{{ 'blog.article_navigation' | t }}"
                    >
                        {%- if blog.previous_article or blog.next_article -%}
                            <div class="article-mobile-nav__row">
                                <div class="article-mobile-nav__slot article-mobile-nav__slot--prev">
                                    {%- if blog.previous_article -%}
                                        {%- capture previous_article_content -%}
                                            {%- render 'icons', icon: 'icon-arrow2', class: 'shrink-0 rotate-180' -%}
                                            <span class="truncate">{{ 'blog.previous_article' | t }}</span>
                                        {%- endcapture -%}
                                        {%- render 'link',
                                            href: blog.previous_article.url,
                                            content: previous_article_content,
                                            variant: 'plain',
                                            class: 'article-mobile-nav__link interactive-link'
                                        -%}
                                    {%- endif -%}
                                </div>

                                <div class="article-mobile-nav__slot article-mobile-nav__slot--next">
                                    {%- if blog.next_article -%}
                                        {%- capture next_article_content -%}
                                            <span class="truncate">{{ 'blog.next_article' | t }}</span>
                                            {%- render 'icons', icon: 'icon-arrow2', class: 'shrink-0' -%}
                                        {%- endcapture -%}
                                        {%- render 'link',
                                            href: blog.next_article.url,
                                            content: next_article_content,
                                            variant: 'plain',
                                            class: 'article-mobile-nav__link interactive-link'
                                        -%}
                                    {%- endif -%}
                                </div>
                            </div>
                        {%- endif -%}

                        {%- if blog.url != blank -%}
                            <div class="article-mobile-nav__back">
                                {%- assign back_to_blog_label = 'blog.back_to_blog' | t -%}
                                {%- render 'link',
                                    text: back_to_blog_label,
                                    href: blog.url,
                                    variant: 'plain',
                                    class: 'article-mobile-nav__back-link body-md underline underline-offset-4'
                                -%}
                            </div>
                        {%- endif -%}
                    </nav>
                {%- endif -%}
            </article>
        </div>
    </div>
</div>

{%- stylesheet -%}
    .article-hero {
        height: 55svh;
        min-height: 32rem;
    }

    .article-hero__content {
        padding-top: calc(var(--announcement-bar-height) + var(--header-height) + 1.5rem);
    }

    @media (min-width: 48rem) {
        .article-hero {
            height: auto;
            min-height: 0;
        }

        .article-hero__content {
            padding-top: 0;
        }
    }

    .article-sidebar__link {
        transition: color var(--motion-duration-fast, 250ms) var(--motion-ease-default, ease);
    }

    .article-mobile-nav__row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 1rem;
    }

    .article-mobile-nav__slot {
        min-width: 0;
    }

    .article-mobile-nav__slot--prev {
        justify-self: start;
    }

    .article-mobile-nav__slot--next {
        justify-self: end;
        text-align: end;
    }

    .article-mobile-nav__link {
        display: inline-flex;
        max-width: 100%;
        min-height: 2.5rem;
        align-items: center;
        gap: 0.5rem;
    }

    .article-mobile-nav__slot--next .article-mobile-nav__link {
        justify-content: flex-end;
    }

    .article-mobile-nav__back {
        display: flex;
        justify-content: center;
        padding-top: 0.75rem;
    }

    .article-mobile-nav__back-link {
        display: inline-flex;
        min-height: 2.5rem;
        align-items: center;
        justify-content: center;
    }

    .article-mobile-nav:not(:has(.article-mobile-nav__row)) .article-mobile-nav__back {
        padding-top: 0;
    }
{%- endstylesheet -%}

{% schema %}
{
    "name": "t:general.article",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["article"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.article.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:sections.article.settings.image"
        },
        {
            "type": "text",
            "id": "image_alt",
            "default": "t:sections.article.defaults.image_alt",
            "label": "t:sections.article.settings.image_alt_text"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "t:sections.article.settings.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "heading-4xl",
                    "label": "t:sections.slides-show.options.heading_4xl"
                },
                {
                    "value": "heading-3xl",
                    "label": "t:sections.slides-show.options.heading_3xl"
                },
                {
                    "value": "heading-2xl",
                    "label": "t:sections.slides-show.options.heading_2xl"
                },
                {
                    "value": "heading-xl",
                    "label": "t:sections.slides-show.options.heading_xl"
                },
                {
                    "value": "heading-h1",
                    "label": "t:sections.slides-show.options.heading_h1"
                },
                {
                    "value": "heading-h2",
                    "label": "t:sections.slides-show.options.heading_h2"
                },
                {
                    "value": "heading-h3",
                    "label": "t:sections.slides-show.options.heading_h3"
                },
                {
                    "value": "heading-h4",
                    "label": "t:sections.slides-show.options.heading_h4"
                },
                {
                    "value": "heading-h5",
                    "label": "t:sections.slides-show.options.heading_h5"
                },
                {
                    "value": "heading-h6",
                    "label": "t:sections.slides-show.options.heading_h6"
                }
            ],
            "default": "heading-2xl"
        },
        {
            "type": "inline_richtext",
            "id": "eyebrow",
            "default": "categories",
            "label": "t:sections.article.settings.eyebrow_text"
        },
        {
            "type": "header",
            "content": "t:sections.scroll-categories.content.subtitle"
        },
        {
            "type": "select",
            "id": "subtitle_size",
            "label": "t:sections.scroll-categories.settings.subtitle_size",
            "options": [
                {
                    "value": "body-3xl",
                    "label": "t:sections.scroll-categories.options.body_3xl"
                },
                {
                    "value": "body-2xl",
                    "label": "t:sections.scroll-categories.options.body_2xl"
                },
                {
                    "value": "body-xl",
                    "label": "t:sections.scroll-categories.options.body_xl"
                },
                {
                    "value": "body-lg",
                    "label": "t:sections.scroll-categories.options.body_lg"
                },
                {
                    "value": "body-md",
                    "label": "t:sections.scroll-categories.options.body_md"
                },
                {
                    "value": "body-sm",
                    "label": "t:sections.scroll-categories.options.body_sm"
                },
                {
                    "value": "body-xs",
                    "label": "t:sections.scroll-categories.options.body_xs"
                }
            ],
            "default": "body-xl"
        },
        {
            "type": "range",
            "id": "max_items",
            "min": 1,
            "max": 10,
            "step": 1,
            "default": 8,
            "label": "t:sections.article.settings.maximum_items"
        },
        {
            "type": "checkbox",
            "id": "show_social",
            "default": false,
            "label": "t:sections.article.settings.social_icon",
            "info": "t:sections.article.info.manage_social_accounts_editor_context_th"
        },
        {
            "type": "header",
            "content": "t:sections.article.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.article.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.article.settings.padding_bottom",
            "default": 0
        }
    ]
}
{% endschema %}
