<div
    data-section-id="{{ section.id }}"
    class="article-section full-width color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="article"
    data-component-id="{{ section.id }}"
>
    <div class="article-hero relative overflow-hidden pc:max-h-200">
        {%- capture sizes -%}
            (min-width: 80rem) 100vw, (min-width: 48rem) 1280px, 768px
        {%- endcapture -%}

        {%- capture widths -%}
            400,768,1280,1536,2560
        {%- endcapture -%}

        {%- assign image = article.image -%}
        {%- if section.settings.image -%}
            {%- assign image = section.settings.image -%}
        {%- endif -%}

        {%-
            render 'image',
            image: image,
            alt: image.alt | default: section.settings.image_alt | escape,
            width: image.width,
            class: 'h-full w-full',
            img_class: 'h-full w-full object-cover object-center',
            sizes: sizes,
            widths: widths
        -%}

        <div class="article-hero__overlay absolute inset-0 z-10">
            <div
                class="article-hero__content mx-auto flex h-full w-full max-w-lg flex-col items-center justify-center gap-4 px-6 text-center text-theme-text pc:max-w-1/2 pc:gap-5"
            >
                {%- if section.settings.eyebrow != blank -%}
                    <h3 class="opacity-80">
                        {{ section.settings.eyebrow }}
                    </h3>
                {%- endif -%}

                <h1 class="font-bold pc:hxl">
                    {{ article.title }}
                </h1>
            </div>
        </div>
    </div>

    <div class="layout layout-no-pt container-page mt-12 bg-theme-bg text-theme-text">
        <div class="flex flex-col gap-16 pc:flex-row pc:gap-60">
            {% comment %} Aside Bar {% endcomment %}
            <aside
                class="shrink-0 -translate-x-7.5 h2 opacity-0 max-pc:hidden pc:w-fit pc:max-w-1/3"
                data-gsap-sidebar
            >
                <nav class="pc:sticky">
                    <ul
                        id="toc-container"
                        class="flex w-fit max-w-full flex-row gap-9 overflow-x-auto pc:flex-col pc:overflow-x-hidden"
                    >
                        {% # theme-check-disable-next-line LiquidHTMLSyntaxError %}
                        {%- for a in blog.articles limit: section.settings.max_items -%}
                            <li class="min-w-0">
                                <a
                                    href="{{ a.url }}"
                                    class="
                                        inline-block max-w-full truncate border-b border-theme-border-soft body-md leading-snug transition-colors duration-200
                                        {% if a.id == article.id %}
                                          text-theme-text
                                        {% else %}
                                          text-theme-text/60 hover:text-theme-text
                                        {% endif %}
                                    "
                                >
                                    {{ a.title }}
                                </a>
                            </li>
                        {%- endfor -%}
                    </ul>
                </nav>
            </aside>

            {% comment %} Article  {% endcomment %}
            <article
                class="article-content min-w-0 flex-1 translate-y-7.5 opacity-0"
                data-gsap-content
            >
                <div class="flex items-center justify-between border-b border-theme-border-soft pb-3">
                    <h1 class="h2">{{ article.title }}</h1>
                    {%- assign date = article.published_at | time_tag: format: 'date' -%}
                    <p class="body-sm text-theme-text/70">
                        {{ 'blog.article_metadata_html' | t: date: date, author: article.author }}
                    </p>
                </div>
                <div class="rte py-10">
                    {{ article.content }}
                </div>
                <div class="flex flex-col gap-3 border-t border-theme-border-soft pt-3">
                    {%- if section.settings.show_social -%}
                        {%- render 'social-icons',
                            type: 'name',
                            color: 'current',
                            class: 'self-end'
                        -%}
                    {%- endif -%}
                </div>
            </article>
        </div>
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components) return;

        Components.register(
            'article',
            {
                init(el) {
                    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;

                    gsap.registerPlugin(ScrollTrigger);

                    const sidebar = el.querySelector('[data-gsap-sidebar]');
                    const content = el.querySelector('[data-gsap-content]');

                    const ctx = gsap.context(() => {
                        const tl = gsap.timeline({
                            defaults: { ease: 'power2.out' },
                        });

                        /* Sidebar slide in */
                        if (sidebar) {
                            tl.to(sidebar, {
                                opacity: 1,
                                x: 0,
                                duration: 0.7,
                            });
                        }

                        /* Content fade up */
                        if (content) {
                            tl.to(
                                content,
                                {
                                    opacity: 1,
                                    y: 0,
                                    duration: 0.7,
                                },
                                '-=0.4',
                            );
                        }
                    }, el);

                    return { ctx };
                },

                destroy(el, state) {
                    if (state?.ctx) {
                        state.ctx.revert();
                    }
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{%- stylesheet -%}
    .article-hero {
        height: 55svh;
        min-height: 32rem;
    }

    .article-hero__content {
        padding-top: calc(var(--announcement-bar-height) + var(--header-height) + 1.5rem);
    }

    @media (min-width: 48rem) {
        .article-hero {
            height: auto;
            min-height: 0;
        }

        .article-hero__content {
            padding-top: 0;
        }
    }
{%- endstylesheet -%}

{% schema %}
{
    "name": "t:general.article",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["article"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "scheme-1"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "image_alt",
            "default": "About Us",
            "label": "Image alt text"
        },
        {
            "type": "inline_richtext",
            "id": "eyebrow",
            "default": "categories",
            "label": "Eyebrow text"
        },
        {
            "type": "range",
            "id": "max_items",
            "min": 1,
            "max": 10,
            "step": 1,
            "default": 8,
            "label": "Maximum items"
        },
        {
            "type": "checkbox",
            "id": "show_social",
            "default": false,
            "label": "Social icon",
            "info": "[Manage social accounts](/editor?context=theme&category=social%20icon)"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "t:general.article"
        }
    ]
}
{% endschema %}
