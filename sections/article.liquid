{%- liquid
    assign article_heading_class = section.settings.heading_size | default: 'title-2xl'
    assign article_subtitle_size = section.settings.subtitle_size | default: 'copy-l'
    assign article_subtitle_class = 'typo-subtitle ' | append: article_subtitle_size
    assign article_title_text = article.title | strip_html | strip
    assign article_heading_override = section.settings.heading | strip_html | strip
-%}
{%- capture article_children -%}
    <div class="article-hero relative overflow-hidden color-{{ section.settings.header_color_scheme }} tablet:max-h-200">
        {%- capture sizes -%}
            (min-width: 80rem) 100vw, (min-width: 48rem) 1280px, 768px
        {%- endcapture -%}

        {%- capture widths -%}
            400,768,1280,1536,2560
        {%- endcapture -%}

        {%- assign image = article.image -%}
        {%- if section.settings.image -%}
            {%- assign image = section.settings.image -%}
        {%- endif -%}

        {%- assign image_alt = image.alt | default: section.settings.image_alt | escape -%}
        {%- render 'image',
            image: image,
            placeholder_key: 'lifestyle-1',
            alt: image_alt,
            width: image.width,
            class: 'h-full w-full',
            img_class: 'h-full w-full object-cover object-center',
            sizes: sizes,
            widths: widths,
        -%}

        <div class="article-hero__overlay absolute inset-0 z-10">
            <div
                class="article-hero__content"
            >
                {%- if section.settings.eyebrow != blank -%}
                    <p class="{{ article_subtitle_class }}">
                        {{ section.settings.eyebrow }}
                    </p>
                {%- endif -%}

                <h1 class="{{ article_heading_class }} max-w-full min-w-0 break-words">
                    {{ article.title }}
                </h1>

                {%- if article_heading_override != blank
                    and article_heading_override != article_title_text
                -%}
                    <p class="{{ article_subtitle_class }}">
                        {{ section.settings.heading }}
                    </p>
                {%- endif -%}
            </div>
        </div>
    </div>

    <div class="section-frame__overlay-padding-bottom container-page relative mt-step-xl overflow-clip!">
        <div class="flex flex-col gap-step-2xl tablet:flex-row tablet:gap-step-3xl wide:gap-step-4xl">
            {% comment %} Aside Bar {% endcomment %}
            <aside class="shrink-0 copy-l max-tablet:hidden tablet:w-72 wide:w-80">
                <nav
                    class="tablet:sticky-viewport-panel"
                    x-data="stickyViewportPanel"
                    data-module-id="sticky-viewport-panel"
                >
                    <ul
                        id="toc-container"
                        class="flex w-fit max-w-full flex-row gap-step-l overflow-x-auto tablet:w-full tablet:flex-col tablet:overflow-x-hidden"
                    >
                        {% # theme-check-disable-next-line LiquidHTMLSyntaxError %}
                        {%- for a in blog.articles limit: section.settings.max_items -%}
                            <li class="min-w-0">
                                <a
                                    href="{{ a.url }}"
                                    class="
                                        article-sidebar__link inline-block max-w-full truncate underline-offset-4 hover:underline
                                        {% if a.id == article.id %}
                                          text-muted underline
                                        {% else %}
                                          text-subtle hover:text-muted
                                        {% endif %}
                                    "
                                >
                                    {{ a.title }}
                                </a>
                            </li>
                        {%- endfor -%}
                    </ul>
                </nav>
            </aside>

            {% comment %} Article  {% endcomment %}
            <article class="article-content min-w-0 flex-1">
                <div
                    class="flex items-center justify-end border-b border-line pb-step-xs copy-l"
                >
                    {%- assign date = article.published_at | time_tag: format: 'date' -%}
                    <p>
                        {{ 'blog.article_metadata_html' | t: date: date, author: article.author }}
                    </p>
                </div>
                <div class="rte py-step-xl">
                    {{ article.content }}
                </div>
                <div class="flex flex-col gap-step-xs border-t border-line pt-step-xs">
                    {%- if section.settings.show_social -%}
                        {%- render 'social-icons', type: 'icon', class: 'copy-l self-end' -%}
                    {%- endif -%}
                </div>

                {%- if blog.comments_enabled? -%}
                    <section
                        id="ArticleComments-{{ section.id }}"
                        class="article-comments mt-step-2xl"
                        aria-labelledby="ArticleCommentsHeading-{{ section.id }}"
                    >
                        <h2
                            id="ArticleCommentsHeading-{{ section.id }}"
                            class="mb-step-l title-s"
                        >
                            {{ 'blog.comments_count_heading' | t: count: article.comments_count }}
                        </h2>

                        {% paginate article.comments by 5 %}
                            {%- if article.comments.size > 0 -%}
                                <ol class="article-comments__list flex list-none flex-col gap-step-m">
                                    {%- for comment in article.comments -%}
                                        <li>
                                            <article
                                                id="comment-{{ comment.id }}"
                                                class="article-comments__item flex flex-col gap-step-xs rounded-sm bg-surface-muted p-step-m tablet:p-step-m"
                                            >
                                                <div class="rte copy-l text-theme-text">
                                                    {{ comment.content }}
                                                </div>
                                                <p class="copy-s text-muted">
                                                    {%- liquid
                                                        assign comment_author = comment.author | escape
                                                        assign comment_date = comment.created_at | time_tag: format: 'date'
                                                    -%}
                                                    {{
                                                        'blog.comment_metadata_html'
                                                        | t:
                                                            author: comment_author,
                                                            date: comment_date
                                                    }}
                                                </p>
                                            </article>
                                        </li>
                                    {%- endfor -%}
                                </ol>

                                <div class="article-comments__pagination">
                                    {% render 'pagination', paginate_obj: paginate %}
                                </div>
                            {%- endif -%}
                        {% endpaginate %}

                        <div class="article-comments__form mt-step-xl">
                            <h3 class="mb-step-m title-xs">
                                {{ 'blog.comment_form_title' | t }}
                            </h3>

                            {%- form 'new_comment', article, class: 'flex flex-col gap-step-m' -%}
                                {%- if form.posted_successfully? -%}
                                    <div
                                        class="rounded border border-line bg-surface-muted p-step-s copy-l text-theme-text"
                                        role="status"
                                        aria-live="polite"
                                        tabindex="-1"
                                        autofocus
                                    >
                                        {%- if blog.moderated? -%}
                                            {{ 'blog.comment_pending_moderation' | t }}
                                        {%- else -%}
                                            {{ 'blog.comment_posted_success' | t }}
                                        {%- endif -%}
                                    </div>
                                {%- endif -%}

                                {%- if form.errors -%}
                                    <div
                                        id="CommentFormErrors-{{ section.id }}"
                                        class="rounded border border-line bg-surface-muted p-step-s text-theme-text"
                                        role="alert"
                                        tabindex="-1"
                                        autofocus
                                    >
                                        <h4 class="title-xs">
                                            {{ 'blog.comment_form_error_title' | t }}
                                        </h4>
                                        <ul class="mt-step-xs list-disc ps-step-m copy-s">
                                            {%- for field in form.errors -%}
                                                {%- if field == 'form' -%}
                                                    <li>
                                                        {{ form.errors.messages[field] }}
                                                    </li>
                                                {%- else -%}
                                                    {%- liquid
                                                        assign comment_field_id = ''
                                                        case field
                                                            when 'author'
                                                                assign comment_field_id = 'CommentFormAuthor-' | append: section.id
                                                            when 'email'
                                                                assign comment_field_id = 'CommentFormEmail-' | append: section.id
                                                            when 'body'
                                                                assign comment_field_id = 'CommentFormBody-' | append: section.id
                                                        endcase
                                                    -%}
                                                    <li>
                                                        {%- if comment_field_id != blank -%}
                                                            <a
                                                                href="#{{ comment_field_id }}"
                                                                class="underline underline-offset-4 interactive-link"
                                                            >
                                                                {{ form.errors.translated_fields[field] -}}
                                                                :
                                                                {{ form.errors.messages[field] }}
                                                            </a>
                                                        {%- else -%}
                                                            {{ form.errors.translated_fields[field] -}}
                                                            :
                                                            {{ form.errors.messages[field] }}
                                                        {%- endif -%}
                                                    </li>
                                                {%- endif -%}
                                            {%- endfor -%}
                                        </ul>
                                    </div>
                                {%- endif -%}

                                <div class="flex flex-col gap-step-2xs">
                                    <label for="CommentFormAuthor-{{ section.id }}">
                                        {{- 'blog.comment_form_name' | t -}}
                                    </label>
                                    <input
                                        type="text"
                                        id="CommentFormAuthor-{{ section.id }}"
                                        name="comment[author]"
                                        value="{{ form.author | escape }}"
                                        autocomplete="name"
                                        required
                                        class="field"
                                        {% if form.errors contains 'author' %}
                                            aria-invalid="true"
                                            aria-describedby="CommentFormAuthor-error-{{ section.id }}"
                                        {% endif %}
                                    >
                                    {%- if form.errors contains 'author' -%}
                                        <p
                                            id="CommentFormAuthor-error-{{ section.id }}"
                                            class="copy-s text-theme-text"
                                        >
                                            {{ form.errors.messages.author }}
                                        </p>
                                    {%- endif -%}
                                </div>

                                <div class="flex flex-col gap-step-2xs">
                                    <label for="CommentFormEmail-{{ section.id }}">
                                        {{- 'blog.comment_form_email' | t -}}
                                    </label>
                                    <input
                                        type="email"
                                        id="CommentFormEmail-{{ section.id }}"
                                        name="comment[email]"
                                        value="{{ form.email | escape }}"
                                        autocomplete="email"
                                        required
                                        class="field"
                                        {% if form.errors contains 'email' %}
                                            aria-invalid="true"
                                            aria-describedby="CommentFormEmail-error-{{ section.id }}"
                                        {% endif %}
                                    >
                                    {%- if form.errors contains 'email' -%}
                                        <p
                                            id="CommentFormEmail-error-{{ section.id }}"
                                            class="copy-s text-theme-text"
                                        >
                                            {{ form.errors.messages.email }}
                                        </p>
                                    {%- endif -%}
                                </div>

                                <div class="flex flex-col gap-step-2xs">
                                    <label for="CommentFormBody-{{ section.id }}">
                                        {{- 'blog.comment_form_body' | t -}}
                                    </label>
                                    <textarea
                                        id="CommentFormBody-{{ section.id }}"
                                        name="comment[body]"
                                        rows="5"
                                        required
                                        class="field-textarea"
                                        {% if form.errors contains 'body' %}
                                            aria-invalid="true"
                                            aria-describedby="CommentFormBody-error-{{ section.id }}"
                                        {% endif %}
                                    >{{- form.body | escape -}}</textarea>
                                    {%- if form.errors contains 'body' -%}
                                        <p
                                            id="CommentFormBody-error-{{ section.id }}"
                                            class="copy-s text-theme-text"
                                        >
                                            {{ form.errors.messages.body }}
                                        </p>
                                    {%- endif -%}
                                </div>

                                <div>
                                    <button type="submit" class="btn-primary">
                                        {{ 'blog.comment_form_submit' | t }}
                                    </button>
                                </div>
                            {%- endform -%}
                        </div>
                    </section>
                {%- endif -%}

                {%- if blog.previous_article or blog.next_article or blog.url != blank -%}
                    <nav
                        class="article-mobile-nav"
                        aria-label="{{ 'blog.article_navigation' | t }}"
                    >
                        {%- if blog.previous_article or blog.next_article -%}
                            <div class="article-mobile-nav__row">
                                <div class="article-mobile-nav__slot article-mobile-nav__slot--prev">
                                    {%- if blog.previous_article -%}
                                        {%- capture previous_article_content -%}
                                            {%- render 'icons', icon: 'icon-arrow2', class: 'shrink-0 rotate-180' -%}
                                            <span class="truncate">{{ 'blog.previous_article' | t }}</span>
                                        {%- endcapture -%}
                                        {%- render 'link',
                                            href: blog.previous_article.url,
                                            content: previous_article_content,
                                            variant: 'plain',
                                            class: 'article-mobile-nav__link interactive-link'
                                        -%}
                                    {%- endif -%}
                                </div>

                                <div class="article-mobile-nav__slot article-mobile-nav__slot--next">
                                    {%- if blog.next_article -%}
                                        {%- capture next_article_content -%}
                                            <span class="truncate">{{ 'blog.next_article' | t }}</span>
                                            {%- render 'icons', icon: 'icon-arrow2', class: 'shrink-0' -%}
                                        {%- endcapture -%}
                                        {%- render 'link',
                                            href: blog.next_article.url,
                                            content: next_article_content,
                                            variant: 'plain',
                                            class: 'article-mobile-nav__link interactive-link'
                                        -%}
                                    {%- endif -%}
                                </div>
                            </div>
                        {%- endif -%}

                        {%- if blog.url != blank -%}
                            <div class="article-mobile-nav__back">
                                {%- assign back_to_blog_label = 'blog.back_to_blog' | t -%}
                                {%- render 'link',
                                    text: back_to_blog_label,
                                    href: blog.url,
                                    variant: 'plain',
                                    class: 'article-mobile-nav__back-link underline underline-offset-4'
                                -%}
                            </div>
                        {%- endif -%}
                    </nav>
                {%- endif -%}
            </article>
        </div>
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: 'article-section',
    width: 'full',
    height_kind: 'content',
    motion: false,
    clip: false,
    safe_top: false,
    padding_mode: 'overlay',
    children: article_children
%}

{%- stylesheet -%}
    .article-hero {
        height: 55svh;
        min-height: 32rem;
    }

    .article-hero__content {
        padding-top: calc(var(--announcement-bar-height) + var(--header-height) + 1.5rem);
    }

    @media (width >= 48rem) {
        .article-hero {
            height: auto;
            min-height: 0;
        }

        .article-hero__content {
            padding-top: 0;
        }
    }

    .article-sidebar__link {
        transition: color var(--motion-duration-fast, 250ms) var(--motion-ease-default, ease);
    }

    .article-mobile-nav__row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 1rem;
    }

    .article-mobile-nav__slot {
        min-width: 0;
    }

    .article-mobile-nav__slot--prev {
        justify-self: start;
    }

    .article-mobile-nav__slot--next {
        justify-self: end;
        text-align: end;
    }

    .article-mobile-nav__link {
        display: inline-flex;
        max-width: 100%;
        min-height: 2.5rem;
        align-items: center;
        gap: 0.5rem;
    }

    .article-mobile-nav__slot--next .article-mobile-nav__link {
        justify-content: flex-end;
    }

    .article-mobile-nav__back {
        display: flex;
        justify-content: center;
        padding-top: 0.75rem;
    }

    .article-mobile-nav__back-link {
        display: inline-flex;
        min-height: 2.5rem;
        align-items: center;
        justify-content: center;
    }

    .article-mobile-nav:not(:has(.article-mobile-nav__row)) .article-mobile-nav__back {
        padding-top: 0;
    }

    :where(.article-hero__content) {
        margin-inline: auto;
        display: flex;
        height: 100%;
        width: 100%;
        max-width: var(--container-lg);
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: clamp(0.6rem, 0.4343rem + 0.442vw, 1rem);
        padding-inline: clamp(0.9rem, 0.6514rem + 0.663vw, 1.5rem);
        text-align: center;
        @media (width >= 48rem) {
            max-width: calc(1 / 2 * 100%);
        }
        @media (width >= 48rem) {
            gap: clamp(0.9rem, 0.6514rem + 0.663vw, 1.5rem);
        }
    }

    :where(.article-mobile-nav) {
        margin-top: clamp(2.4rem, 1.737rem + 1.768vw, 4rem);
        @media (width >= 48rem) {
            display: none;
        }
    }
{%- endstylesheet -%}

{% schema %}
{
    "name": "t:general.article",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["article"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "header_color_scheme",
            "label": "t:sections.article.settings.header_color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.article.settings.content_color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:sections.article.settings.image"
        },
        {
            "type": "text",
            "id": "image_alt",
            "default": "t:sections.article.defaults.image_alt",
            "label": "t:sections.article.settings.image_alt_text"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "t:sections.article.settings.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "title-4xl",
                    "label": "t:settings.type_size.title_4xl"
                },
                {
                    "value": "title-3xl",
                    "label": "t:settings.type_size.title_3xl"
                },
                {
                    "value": "title-2xl",
                    "label": "t:settings.type_size.title_2xl"
                },
                {
                    "value": "title-xl",
                    "label": "t:settings.type_size.title_xl"
                },
                {
                    "value": "title-l",
                    "label": "t:settings.type_size.title_l"
                },
                {
                    "value": "title-m",
                    "label": "t:settings.type_size.title_m"
                },
                {
                    "value": "title-s",
                    "label": "t:settings.type_size.title_s"
                },
                {
                    "value": "title-xs",
                    "label": "t:settings.type_size.title_xs"
                }
            ],
            "default": "title-2xl"
        },
        {
            "type": "inline_richtext",
            "id": "eyebrow",
            "default": "t:sections.article.defaults.eyebrow",
            "label": "t:sections.article.settings.eyebrow_text"
        },
        {
            "type": "header",
            "content": "t:sections.scroll-categories.content.subtitle"
        },
        {
            "type": "select",
            "id": "subtitle_size",
            "label": "t:sections.scroll-categories.settings.subtitle_size",
            "options": [
                {
                    "value": "copy-xl",
                    "label": "t:settings.type_size.copy_xl"
                },
                {
                    "value": "copy-l",
                    "label": "t:settings.type_size.copy_l"
                },
                {
                    "value": "copy-m",
                    "label": "t:settings.type_size.copy_m"
                },
                {
                    "value": "copy-s",
                    "label": "t:settings.type_size.copy_s"
                }
            ],
            "default": "copy-l"
        },
        {
            "type": "range",
            "id": "max_items",
            "min": 1,
            "max": 10,
            "step": 1,
            "default": 8,
            "label": "t:sections.article.settings.maximum_items"
        },
        {
            "type": "checkbox",
            "id": "show_social",
            "default": false,
            "label": "t:sections.article.settings.social_icon",
            "info": "t:sections.article.info.manage_social_accounts_editor_context_th"
        },
        {
            "type": "header",
            "content": "t:sections.article.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.article.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.article.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
