<div
    data-section-id="{{ section.id }}"
    class="cart-section full-width color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="{}"
    :class="{ 'opacity-50 pointer-events-none': $store.cart.loading }"
    data-component-kind="section"
    data-component-type="cart"
    data-component-id="{{ section.id }}"
>
    <div class="layout container-page">
        <div class="grid grid-cols-1 gap-10 pc:grid-cols-[minmax(0,1fr)_auto]">
            {%- comment -%} Left: Cart list (Liquid-rendered for SRA) {%- endcomment -%}
            <div class="flex flex-col gap-8 text-theme-text pc:gap-10">
                <h1>Cart</h1>

                <ul class="flex flex-col divide-y divide-theme-border-soft">
                    {%- for item in cart.items -%}
                        <li class="flex flex-wrap items-center gap-4 py-5 first:pt-0 pc:gap-6 pc:py-6">
                            <div class="flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden bg-theme-bg pc:h-22 pc:w-22">
                                {%- if item.image -%}
                                    {% render 'image',
                                        url: item.url,
                                        image: item.image,
                                        alt: item.image.alt,
                                        width: 120,
                                        height: 120
                                    %}
                                {%- else -%}
                                    <span class="body-md text-theme-text/60">No image</span>
                                {%- endif -%}
                            </div>

                            <div class="flex h-full min-w-0 flex-1 flex-col">
                                <p class="body-xs tracking-wide text-theme-text/70 uppercase">
                                    {{ item.vendor | default: ' ' }}
                                </p>
                                <a href="{{ item.url }}" class="mt-0.5 block h5 hover:underline">
                                    {{ item.product.title }}
                                </a>
                                <p class="mt-3 body-sm pc:mt-4">
                                    {{ item.final_line_price | money }}
                                </p>
                            </div>

                            <div class="ml-auto flex items-center gap-8 self-end pc:gap-10">
                                <a
                                    href="{{ item.url_to_remove }}"
                                    class="h-8 w-8 text-current opacity-80 transition-colors hover:opacity-100"
                                    aria-label="Remove {{ item.product.title }}"
                                    @click.prevent="$store.cart.change('{{ item.key }}', 0, ['{{ section.id }}'])"
                                >
                                    {% render 'icons',
                                        icon: 'icon-trash',
                                        class: 'h-full w-full',
                                        color: 'current'
                                    %}
                                </a>

                                {% assign max_qty = null %}
                                {% if item.variant.inventory_management != null
                                    and item.variant.inventory_policy == 'deny'
                                %}
                                    {% assign max_qty = item.variant.inventory_quantity %}
                                {% endif %}

                                <div @quantity:change="$store.cart.change('{{ item.key }}', $event.detail.value, ['{{ section.id }}'])">
                                    {%- render 'quantity-selector',
                                        value: item.quantity,
                                        min: 1,
                                        max: max_qty,
                                        label: item.product.title,
                                        wrapper_class: 'flex items-center gap-2 text-current'
                                    -%}
                                </div>
                            </div>
                        </li>
                    {%- endfor -%}
                </ul>

                <div class="text-center">
                    {%- render 'link',
                        text: 'Shop More',
                        href: routes.root_url,
                        variant: 'underline',
                        color: 'current',
                        class: 'body-md text-current'
                    -%}
                </div>
            </div>

            {%- comment -%} Right: Order Summary card {%- endcomment -%}
            <aside class="self-start">
                <div class="w-full surface p-4 pc:p-5">
                    <h3 class="text-current">Order Summary</h3>

                    {%- comment -%} Accordion: Order Special Instruction + Estimate Shipping {%- endcomment -%}
                    {%- capture note_html -%}
                        <textarea
                            name="note"
                            class="min-h-20 field resize-y bg-theme-bg/60 body-sm"
                            placeholder="Add a note to your order..."
                            @change="$store.cart.update({ note: $event.target.value })"
                        >
                            {{ cart.note }}
                        </textarea>
                    {%- endcapture -%}

                    {%- capture shipping_html -%}
                        <div class="space-y-3">
                            <div class="grid grid-cols-2 gap-2">
                                <input
                                    type="text"
                                    name="attributes[Country]"
                                    class="field bg-theme-bg/60 body-sm"
                                    placeholder="Country"
                                    value="{{ cart.attributes.Country | default: 'China' }}"
                                    @change="$store.cart.update({ attributes: { Country: $event.target.value } })"
                                >
                                <input
                                    type="text"
                                    name="attributes[Province]"
                                    class="field bg-theme-bg/60 body-sm"
                                    placeholder="Province"
                                    value="{{ cart.attributes.Province | default: 'Anhui' }}"
                                    @change="$store.cart.update({ attributes: { Province: $event.target.value } })"
                                >
                            </div>
                            <input
                                type="text"
                                class="field bg-theme-bg/60 body-sm"
                                placeholder="Pincode"
                            >
                            <button
                                type="button"
                                class="btn w-full btn-secondary body-sm"
                            >
                                Get Estimate
                            </button>
                        </div>
                    {%- endcapture -%}

                    {%- assign accordion_contents = note_html
                        | append: '|'
                        | append: shipping_html
                    -%}

                    {% render 'accordion',
                        wrapper_class: 'flex flex-col gap-3',
                        initial_active: 1,
                        titles: 'Order Special Instruction|Estimate Shipping',
                        contents: accordion_contents,
                        icon_type: 'plus',
                        icon_size: 'w-5 h-5',
                        item_class: 'border-t border-theme-border-soft first:border-t-0',
                        title_active_class: 'text-current',
                        title_inactive_class: 'text-current/80',
                        icon_color_class: 'text-current',
                        content_class: 'pb-5 pr-0 text-current/75'
                    %}

                    <div class="mt-5 border-t border-theme-border-soft pt-5">
                        <div class="flex items-baseline justify-between gap-4">
                            <span class="h6 text-current">Estimate Total</span>
                            <span class="h6 text-current">
                                {{- cart.total_price | money -}}
                            </span>
                        </div>
                        <p class="mt-5 border-t border-theme-border-soft pt-4 body-xs text-current/65">
                            Taxes, discounts and shipping calculated at checkout.
                        </p>
                    </div>

                    <form action="{{ routes.cart_url }}" method="post" class="mt-4">
                        <button
                            type="submit"
                            name="checkout"
                            class="btn w-full border-transparent bg-[#1f3a27] body-sm text-white hover:opacity-90"
                        >
                            Checkout
                            <sup class="sup-badge">({{ cart.item_count | default: 0 }})</sup>
                        </button>
                    </form>
                </div>
            </aside>
        </div>
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components) return;

        Components.register(
            'cart',
            {
                init(el) {
                    return {};
                },
                destroy(el, state) {},
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{%- stylesheet -%}
{%- endstylesheet -%}

{% schema %}
{
    "name": "t:general.cart",
    "tag": "section",
    "class": "section",
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "scheme-1"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "t:general.cart"
        }
    ]
}
{% endschema %}
