<div
  data-section-id="{{ section.id }}"
  class="cart-section full-width"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  x-data="{}"
  :class="{ 'opacity-50 pointer-events-none': $store.cart.loading }"
>
  <div class="layout container-page bg-[#F3F3F3]">
    <div class="p-6 grid grid-cols-1 pc:grid-cols-[1fr_auto] gap-10 pc:gap-12">
      {%- comment -%} Left: Cart list (Liquid-rendered for SRA) {%- endcomment -%}
      <div class="flex flex-col text-[#263D29] gap-9">
        <h1 class="hxxl font-bold">
          Cart
        </h1>

        <ul class="flex flex-col divide-y divide-[#e5e5e5]">
          {%- for item in cart.items -%}
            <li class="py-6 first:pt-0 flex flex-wrap items-center gap-4 pc:gap-6">
              <div class="w-50 h-50 shrink-0 rounded overflow-hidden flex items-center justify-center">
                {%- if item.image -%}
                  {% render 'image',
                    url: item.url,
                    image: item.image,
                    alt:item.image.alt,
                    width: 120,
                    height: 120
                  %}
                {%- else -%}
                  <span class="text-[#9ca3af]">No image</span>
                {%- endif -%}
              </div>

              <div class="flex-1 min-w-0 h-full flex flex-col">
                <p class="h6 uppercase tracking-wide">
                  {{ item.vendor | default: ' ' }}
                </p>
                <a href="{{ item.url }}" class="h3 font-bold hover:underline block">
                  {{ item.product.title }}
                </a>
                <p class="mt-auto h6 font-medium">
                  {{ item.final_line_price | money }}
                </p>
              </div>

              <div class="flex gap-12 self-end items-center">
                <a
                  href="{{ item.url_to_remove }}"
                  class="w-9 h-9 text-[#263D29] opacity-80 hover:opacity-100 transition-colors"
                  aria-label="Remove {{ item.product.title }}"
                  @click.prevent="$store.cart.change({{ forloop.index }}, 0, ['{{ section.id }}'])"
                >
                  <span class="w-full h-full inline-block">
                    {{ 'icon-trash.svg' | inline_asset_content }}
                  </span>
                </a>

                <div class="flex items-center gap-6">
                  <button
                    type="button"
                    aria-label="Decrease"
                    class="w-9 h-9 flex items-center justify-center text-[#263D29] opacity-80 hover:opacity-100 transition-colors cursor-pointer"
                    @click="$store.cart.change({{ forloop.index }}, {{ item.quantity | minus: 1 }}, ['{{ section.id }}'])"
                  >
                    <span class="sr-only">−</span>
                    <span class="w-full h-full inline-block">
                      {{ 'icon-minus.svg' | inline_asset_content }}
                    </span>
                  </button>

                  <span class="inline-block min-w-[2ch] border-b text-center font-medium text-[#263D29]" aria-live="polite">
                    {{ item.quantity }}
                  </span>
                  
                  <button
                    type="button"
                    aria-label="Increase"
                    class="w-9 h-9 flex items-center justify-center text-[#263D29] opacity-80 hover:opacity-100 transition-colors cursor-pointer"
                    @click="$store.cart.change({{ forloop.index }}, {{ item.quantity | plus: 1 }}, ['{{ section.id }}'])"
                  >
                    <span class="sr-only">+</span>
                    <span class="w-full h-full inline-block">
                      {{ 'icon-plus.svg' | inline_asset_content }}
                    </span>
                  </button>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        <div class="text-center">
          {%- render 'link', text: 'Shop More', href: routes.root_url, variant: 'underline' -%}
        </div>
      </div>

      {%- comment -%} Right: Order Summary card {%- endcomment -%}
      <aside class="pc:sticky self-start">
        <div class="bg-white rounded-lg shadow-md border border-[#e5e5e5] p-6 pc:p-9">
          <h2 class="font-bold text-[#111]">
            Order Summary
          </h2>

          {%- comment -%} Accordion: Order Special Instruction + Estimate Shipping {%- endcomment -%}
          <div
            x-data="{ active: 1 }"
            class="flex flex-col"
          >
            <div class="border-t border-[#d4d4d4] first:border-t-0">
              <button
                type="button"
                @click="active = active === 0 ? null : 0"
                class="flex w-full items-center justify-between py-4 text-left cursor-pointer group"
              >
                <span class="font-bold text-[#2d3a2e]">Order Special Instruction</span>
                <div class="relative shrink-0 ml-4 w-5 h-5 flex items-center justify-center text-[#5a5a5a]">
                  <span class="absolute w-full h-[1.5px] bg-current transition-transform duration-300" :class="{ 'rotate-90': active === 0 }"></span>
                  <span class="absolute w-[1.5px] h-full bg-current transition-transform duration-300" :class="{ 'rotate-90': active === 0 }"></span>
                </div>
              </button>
              <div
                class="grid transition-all duration-300 ease-in-out"
                :class="active === 0 ? 'grid-rows-[1fr] opacity-100' : 'grid-rows-[0fr] opacity-0'"
              >
                <div class="overflow-hidden">
                  <div class="pb-4 text-[#6b6b6b]">
                    <textarea
                      name="note"
                      class="w-full min-h-20 px-3 py-2 border border-[#d4d4d4] rounded bg-[#f5f5f5] text-[#111] placeholder:text-[#9ca3af] focus:outline-none focus:ring-2 focus:ring-[#263D29] focus:border-transparent"
                      placeholder="Add a note to your order..."
                    >{{ cart.note }}</textarea>
                  </div>
                </div>
              </div>
            </div>

            <div class="border-t border-[#d4d4d4]">
              <button
                type="button"
                @click="active = active === 1 ? null : 1"
                class="flex w-full items-center justify-between py-4 text-left cursor-pointer group"
              >
                <span class="font-bold text-[#2d3a2e]">Estimate Shipping</span>
                <span
                  class="w-5 h-5 shrink-0 ml-4 inline-block text-[#5a5a5a] transition-transform duration-300"
                  :class="{ 'rotate-180': active === 1 }"
                >
                  {{ 'icon-chevron-down.svg' | inline_asset_content }}
                </span>
              </button>
              <div
                class="grid transition-all duration-300 ease-in-out"
                :class="active === 1 ? 'grid-rows-[1fr] opacity-100' : 'grid-rows-[0fr] opacity-0'"
              >
                <div class="overflow-hidden">
                  <div class="pb-4 text-[#6b6b6b] space-y-3">
                    <div class="grid grid-cols-2 gap-2">
                      <input
                        type="text"
                        class="w-full px-3 py-2 border border-[#d4d4d4] rounded bg-[#f5f5f5] text-[#111] placeholder:text-[#9ca3af] focus:outline-none focus:ring-2 focus:ring-[#263D29]"
                        placeholder="Country"
                        value="{{ cart.attributes.country | default: 'China' }}"
                      >
                      <input
                        type="text"
                        class="w-full px-3 py-2 border border-[#d4d4d4] rounded bg-[#f5f5f5] text-[#111] placeholder:text-[#9ca3af] focus:outline-none focus:ring-2 focus:ring-[#263D29]"
                        placeholder="Province"
                        value="{{ cart.attributes.province | default: 'Anhui' }}"
                      >
                    </div>
                    <input
                      type="text"
                      class="w-full px-3 py-2 border border-[#d4d4d4] rounded bg-[#f5f5f5] text-[#111] placeholder:text-[#9ca3af] focus:outline-none focus:ring-2 focus:ring-[#263D29]"
                      placeholder="Pincode"
                    >
                    <button
                      type="button"
                      class="w-full py-2.5 px-4 border border-[#111] rounded text-[#111] font-medium hover:bg-[#f5f5f5] transition-colors"
                    >
                      Get Estimate
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-6 pt-6 border-t border-[#e5e5e5]">
            <div class="flex items-baseline justify-between gap-4">
              <span class="text-lg font-bold text-[#111]">Estimate Total</span>
              <span class="text-lg font-bold text-[#111]">{{ cart.total_price | money }}</span>
            </div>
            <p class="mt-2 text-sm text-[#9ca3af]">
              Taxes, discounts and shipping calculated at checkout.
            </p>
          </div>

          <form action="{{ routes.cart_url }}" method="post" class="mt-6">
            <button
              type="submit"
              name="checkout"
              class="w-full py-4 px-6 rounded font-bold text-white bg-[#263D29] hover:opacity-90 transition-opacity"
            >
              Checkout ({{ cart.item_count }})
            </button>
          </form>
        </div>
      </aside>
    </div>
  </div>
</div>

{%- javascript -%}
{%- endjavascript -%}

{%- stylesheet -%}
{%- endstylesheet -%}

{% schema %}
{
  "name": "t:general.cart",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:general.cart"
    }
  ]
}
{% endschema %}
