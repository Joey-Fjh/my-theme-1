<div
    data-section-id="{{ section.id }}"
    class="cart-section full-width"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="{}"
    :class="{ 'opacity-50 pointer-events-none': $store.cart.loading }"
    data-component-kind="section"
    data-component-type="cart"
    data-component-id="{{ section.id }}"
>
    <div class="layout container-page bg-[#F3F3F3]">
        <div class="pc:grid-cols-[1fr_auto] pc:gap-12 grid grid-cols-1 gap-10 p-6">
            {%- comment -%} Left: Cart list (Liquid-rendered for SRA) {%- endcomment -%}
            <div class="flex flex-col gap-9 text-[#263D29]">
                <h1 class="hxxl font-bold">Cart</h1>

                <ul class="flex flex-col divide-y divide-[#e5e5e5]">
                    {%- for item in cart.items -%}
                        <li class="pc:gap-6 flex flex-wrap items-center gap-4 py-6 first:pt-0">
                            <div class="flex h-50 w-50 shrink-0 items-center justify-center overflow-hidden rounded">
                                {%- if item.image -%}
                                    {% render 'image',
                                        url: item.url,
                                        image: item.image,
                                        alt: item.image.alt,
                                        width: 120,
                                        height: 120
                                    %}
                                {%- else -%}
                                    <span class="text-[#9ca3af]">No image</span>
                                {%- endif -%}
                            </div>

                            <div class="flex h-full min-w-0 flex-1 flex-col">
                                <p class="h6 tracking-wide uppercase">
                                    {{ item.vendor | default: ' ' }}
                                </p>
                                <a href="{{ item.url }}" class="h3 block font-bold hover:underline">
                                    {{ item.product.title }}
                                </a>
                                <p class="h6 mt-auto font-medium">
                                    {{ item.final_line_price | money }}
                                </p>
                            </div>

                            <div class="flex items-center gap-12 self-end">
                                <a
                                    href="{{ item.url_to_remove }}"
                                    class="h-9 w-9 text-[#263D29] opacity-80 transition-colors hover:opacity-100"
                                    aria-label="Remove {{ item.product.title }}"
                                    @click.prevent="$store.cart.change('{{ item.key }}', 0, ['{{ section.id }}'])"
                                >
                                    <span class="inline-block h-full w-full">
                                        {{ 'icon-trash.svg' | inline_asset_content }}
                                    </span>
                                </a>

                                {% assign max_qty = null %}
                                {% if item.variant.inventory_management != null
                                    and item.variant.inventory_policy == 'deny'
                                %}
                                    {% assign max_qty = item.variant.inventory_quantity %}
                                {% endif %}

                                <div @quantity:change="$store.cart.change('{{ item.key }}', $event.detail.value, ['{{ section.id }}'])">
                                    {%- render 'quantity-selector',
                                        value: item.quantity,
                                        min: 1,
                                        max: max_qty,
                                        label: item.product.title,
                                        wrapper_class: 'flex items-center gap-6'
                                    -%}
                                </div>
                            </div>
                        </li>
                    {%- endfor -%}
                </ul>

                <div class="text-center">
                    {%- render 'link',
                        text: 'Shop More',
                        href: routes.root_url,
                        variant: 'underline'
                    -%}
                </div>
            </div>

            {%- comment -%} Right: Order Summary card {%- endcomment -%}
            <aside class="pc:sticky self-start">
                <div class="pc:p-9 rounded-lg border border-[#e5e5e5] bg-white p-6 shadow-md">
                    <h2 class="h2 font-bold text-[#111]">Order Summary</h2>

                    {%- comment -%} Accordion: Order Special Instruction + Estimate Shipping {%- endcomment -%}
                    {%- capture note_html -%}
            <textarea
              name="note"
              class="min-h-20 w-full rounded border border-[#d4d4d4] bg-[#f5f5f5] px-3 py-2 text-[#111] placeholder:text-[#9ca3af] focus:border-transparent focus:ring-2 focus:ring-[#263D29] focus:outline-none"
              placeholder="Add a note to your order..."
              @change="$store.cart.update({ note: $event.target.value })"
            >{{ cart.note }}</textarea>
          {%- endcapture -%}

                    {%- capture shipping_html -%}
            <div class="space-y-3">
              <div class="grid grid-cols-2 gap-2">
                <input
                  type="text"
                  name="attributes[Country]"
                  class="w-full rounded border border-[#d4d4d4] bg-[#f5f5f5] px-3 py-2 text-[#111] placeholder:text-[#9ca3af] focus:ring-2 focus:ring-[#263D29] focus:outline-none"
                  placeholder="Country"
                  value="{{ cart.attributes.Country | default: 'China' }}"
                  @change="$store.cart.update({ attributes: { Country: $event.target.value } })"
                >
                <input
                  type="text"
                  name="attributes[Province]"
                  class="w-full rounded border border-[#d4d4d4] bg-[#f5f5f5] px-3 py-2 text-[#111] placeholder:text-[#9ca3af] focus:ring-2 focus:ring-[#263D29] focus:outline-none"
                  placeholder="Province"
                  value="{{ cart.attributes.Province | default: 'Anhui' }}"
                  @change="$store.cart.update({ attributes: { Province: $event.target.value } })"
                >
              </div>
              <input
                type="text"
                class="w-full rounded border border-[#d4d4d4] bg-[#f5f5f5] px-3 py-2 text-[#111] placeholder:text-[#9ca3af] focus:ring-2 focus:ring-[#263D29] focus:outline-none"
                placeholder="Pincode"
              >
              <button
                type="button"
                class="w-full cursor-pointer rounded border border-[#111] px-4 py-2.5 font-medium text-[#111] transition-colors hover:bg-[#f5f5f5]"
              >
                Get Estimate
              </button>
            </div>
          {%- endcapture -%}

                    {%- assign accordion_contents = note_html
                        | append: '|'
                        | append: shipping_html
                    -%}

                    {% render 'accordion',
                        wrapper_class: 'flex flex-col gap-3',
                        initial_active: 1,
                        titles: 'Order Special Instruction|Estimate Shipping',
                        contents: accordion_contents,
                        icon_type: 'plus',
                        icon_size: 'w-6 h-6'
                    %}

                    <div class="mt-6 border-t border-[#e5e5e5] pt-6">
                        <div class="flex items-baseline justify-between gap-4">
                            <span class="font-bold text-[#111]">Estimate Total</span>
                            <span class="font-bold text-[#111]">
                                {{- cart.total_price | money -}}
                            </span>
                        </div>
                        <p class="mt-2 text-[#9ca3af]">
                            Taxes, discounts and shipping calculated at checkout.
                        </p>
                    </div>

                    <form action="{{ routes.cart_url }}" method="post" class="mt-6">
                        <button
                            type="submit"
                            name="checkout"
                            class="w-full cursor-pointer rounded bg-[#263D29] px-6 py-4 font-bold text-white transition-opacity hover:opacity-90"
                        >
                            Checkout <sup class="sup-badge">({{ cart.item_count }})</sup>
                        </button>
                    </form>
                </div>
            </aside>
        </div>
    </div>
</div>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components) return;

        Components.register(
            'cart',
            {
                init(el) {
                    return {};
                },
                destroy(el, state) {},
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{%- stylesheet -%}
{%- endstylesheet -%}

{% schema %}
{
    "name": "t:general.cart",
    "tag": "section",
    "class": "section",
    "settings": [
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "t:general.cart"
        }
    ]
}
{% endschema %}
