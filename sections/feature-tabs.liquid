{%- liquid
    assign feature_tabs_heading_class = section.settings.heading_size | default: 'title-xl'
    case feature_tabs_heading_class
        when 'title-4xl'
            assign feature_tabs_heading_tiers = 'title-l desktop:title-4xl'
        when 'title-3xl'
            assign feature_tabs_heading_tiers = 'title-l desktop:title-3xl'
        when 'title-2xl'
            assign feature_tabs_heading_tiers = 'title-m desktop:title-2xl'
        when 'title-xl'
            assign feature_tabs_heading_tiers = 'title-m desktop:title-xl'
        when 'title-l'
            assign feature_tabs_heading_tiers = 'title-m desktop:title-l'
        when 'title-m'
            assign feature_tabs_heading_tiers = 'title-s desktop:title-m'
        when 'title-s'
            assign feature_tabs_heading_tiers = 'title-s desktop:title-s'
        when 'title-xs'
            assign feature_tabs_heading_tiers = 'title-xs desktop:title-xs'
        else
            assign feature_tabs_heading_tiers = 'title-m desktop:title-2xl'
    endcase

    assign feature_tabs_item_count = 0
    for feature_tabs_block in section.blocks
        if feature_tabs_block.type == 'item'
            assign feature_tabs_item_count = feature_tabs_item_count | plus: 1
        endif
    endfor
    if feature_tabs_item_count == 0
        assign feature_tabs_item_count = 4
    endif

    if feature_tabs_item_count < 10
        assign feature_tabs_total_label = feature_tabs_item_count | prepend: '0'
    else
        assign feature_tabs_total_label = feature_tabs_item_count
    endif

    assign feature_tabs_decorative = section.settings.decorative_image
-%}

{%- assign feature_tabs_root_attrs = 'data-component-kind="section" data-component-type="feature-tabs" data-component-id="'
    | append: section.id
    | append: '"'
-%}

{%- capture feature_tabs_decoration_markup -%}
    {%- render 'decorative-illustration',
        show: section.settings.show_decoration,
        image: feature_tabs_decorative,
        mask_asset: 'feature-tabs-botanical.webp',
        class: 'feature-tabs__decoration'
    -%}
{%- endcapture -%}

{%- capture feature_tabs_children -%}
    <div
        class="feature-tabs__frame"
        data-module-id="tab-control"
        x-data="tabControl()"
        data-tab-initial-strategy="first"
    >
        <div class="feature-tabs__layout">
            <div class="feature-tabs__media">
                {%- if section.blocks.size > 0 -%}
                    {%- for block in section.blocks -%}
                        {%- if block.type != 'item' -%}
                            {%- continue -%}
                        {%- endif -%}
                        {%- liquid
                            assign feature_tabs_item_heading = block.settings.heading
                            if feature_tabs_item_heading == blank
                                assign feature_tabs_item_heading = 'sections.feature-tabs.defaults.item_heading' | t: index: forloop.index
                            endif
                            assign feature_tabs_item_label = block.settings.label
                            if feature_tabs_item_label == blank
                                assign feature_tabs_item_label = 'sections.feature-tabs.defaults.item_label' | t: index: forloop.index
                            endif
                            assign feature_tabs_image_alt = block.settings.image.alt
                            if feature_tabs_image_alt == blank
                                assign feature_tabs_image_alt = feature_tabs_item_heading | strip_html | strip
                            endif
                            assign feature_tabs_image_alt = feature_tabs_image_alt | escape
                            assign feature_tabs_placeholder_index = forloop.index | minus: 1 | modulo: 2 | plus: 1
                            assign feature_tabs_placeholder_key = 'lifestyle-' | append: feature_tabs_placeholder_index
                            if forloop.first
                                assign feature_tabs_image_loading = 'eager'
                            else
                                assign feature_tabs_image_loading = 'lazy'
                            endif
                        -%}
                        <div
                            class="feature-tabs__image-layer{% if forloop.first %} is-active{% endif %}"
                            data-feature-tabs-image
                            data-tab-index="{{ forloop.index0 }}"
                            :class="{ 'is-active': isActive(panelIndexFor($el)) }"
                        >
                            {%- if block.settings.image != blank -%}
                                {%- render 'image',
                                    image: block.settings.image,
                                    alt: feature_tabs_image_alt,
                                    mode: 'frame',
                                    fit: 'cover',
                                    loading: feature_tabs_image_loading,
                                    sizes: '(min-width: 64rem) 60vw, 100vw',
                                    widths: '400,600,800,1000,1200,1600,2000',
                                    wrapper_class: 'feature-tabs__image-wrap h-full w-full',
                                    img_class: 'h-full w-full object-cover'
                                -%}
                            {%- else -%}
                                <div class="feature-tabs__image-wrap feature-tabs__image-wrap--placeholder">
                                    {% render 'decorative-placeholder-svg',
                                        placeholder_key: feature_tabs_placeholder_key,
                                        class: 'feature-tabs__placeholder-svg'
                                    %}
                                </div>
                            {%- endif -%}
                        </div>
                    {%- endfor -%}
                {%- else -%}
                    {%- for placeholder_index in (1..4) -%}
                        {%- liquid
                            assign feature_tabs_item_heading = 'sections.feature-tabs.defaults.item_heading' | t: index: placeholder_index
                            assign feature_tabs_placeholder_index = placeholder_index | minus: 1 | modulo: 2 | plus: 1
                            assign feature_tabs_placeholder_key = 'lifestyle-' | append: feature_tabs_placeholder_index
                            if placeholder_index == 1
                                assign feature_tabs_image_loading = 'eager'
                            else
                                assign feature_tabs_image_loading = 'lazy'
                            endif
                        -%}
                        <div
                            class="feature-tabs__image-layer{% if forloop.first %} is-active{% endif %}"
                            data-feature-tabs-image
                            data-tab-index="{{ forloop.index0 }}"
                            :class="{ 'is-active': isActive(panelIndexFor($el)) }"
                        >
                            <div class="feature-tabs__image-wrap feature-tabs__image-wrap--placeholder">
                                {% render 'decorative-placeholder-svg',
                                    placeholder_key: feature_tabs_placeholder_key,
                                    class: 'feature-tabs__placeholder-svg'
                                %}
                            </div>
                        </div>
                    {%- endfor -%}
                {%- endif -%}
            </div>

            {%- if section.blocks.size > 0 -%}
                {%- for block in section.blocks -%}
                    {%- if block.type != 'item' -%}
                        {%- continue -%}
                    {%- endif -%}
                    {%- liquid
                        assign feature_tabs_item_heading = block.settings.heading
                        if feature_tabs_item_heading == blank
                            assign feature_tabs_item_heading = 'sections.feature-tabs.defaults.item_heading' | t: index: forloop.index
                        endif
                        assign feature_tabs_item_label = block.settings.label
                        if feature_tabs_item_label == blank
                            assign feature_tabs_item_label = 'sections.feature-tabs.defaults.item_label' | t: index: forloop.index
                        endif
                        assign feature_tabs_item_text = block.settings.text
                        if feature_tabs_item_text == blank
                            assign feature_tabs_item_text = 'sections.feature-tabs.defaults.item_text' | t
                        endif
                        assign feature_tabs_index_label = forloop.index
                        if forloop.index < 10
                            assign feature_tabs_index_label = forloop.index | prepend: '0'
                        endif
                    -%}
                    <div
                        role="tabpanel"
                        id="feature-tabs-{{ section.id }}-panel-{{ forloop.index0 }}"
                        aria-labelledby="feature-tabs-{{ section.id }}-tab-{{ forloop.index0 }}"
                        class="feature-tabs__panel{% if forloop.first %} is-active{% endif %}"
                        tabindex="0"
                        x-init="registerPanel($el)"
                        :class="{ 'is-active': isActive(panelIndexFor($el)) }"
                        :hidden="!isActive(panelIndexFor($el))"
                        {% unless forloop.first %}hidden{% endunless %}
                    >
                        <div class="feature-tabs__panel-inner">
                            {{- feature_tabs_decoration_markup -}}
                            <p class="feature-tabs__counter">
                                <span class="feature-tabs__counter-current copy-m">{{ feature_tabs_index_label }}</span>
                                <span class="copy-m" aria-hidden="true"> / </span>
                                <span class="feature-tabs__counter-total copy-m">{{ feature_tabs_total_label }}</span>
                            </p>
                            <p class="feature-tabs__eyebrow">
                                <span class="copy-m uppercase">{{ feature_tabs_item_label }}</span>
                            </p>
                            <h2 class="feature-tabs__heading">
                                <span class="{{ feature_tabs_heading_tiers }}">{{ feature_tabs_item_heading }}</span>
                            </h2>
                            <div class="feature-tabs__body">
                                <div class="rte copy-m">{{ feature_tabs_item_text }}</div>
                            </div>
                        </div>
                    </div>
                {%- endfor -%}
            {%- else -%}
                {%- for placeholder_index in (1..4) -%}
                    {%- liquid
                        assign feature_tabs_item_heading = 'sections.feature-tabs.defaults.item_heading' | t: index: placeholder_index
                        assign feature_tabs_item_label = 'sections.feature-tabs.defaults.item_label' | t: index: placeholder_index
                        assign feature_tabs_item_text = 'sections.feature-tabs.defaults.item_text' | t
                        assign feature_tabs_index_label = placeholder_index
                        if placeholder_index < 10
                            assign feature_tabs_index_label = placeholder_index | prepend: '0'
                        endif
                    -%}
                    <div
                        role="tabpanel"
                        id="feature-tabs-{{ section.id }}-panel-{{ forloop.index0 }}"
                        aria-labelledby="feature-tabs-{{ section.id }}-tab-{{ forloop.index0 }}"
                        class="feature-tabs__panel{% if forloop.first %} is-active{% endif %}"
                        tabindex="0"
                        x-init="registerPanel($el)"
                        :class="{ 'is-active': isActive(panelIndexFor($el)) }"
                        :hidden="!isActive(panelIndexFor($el))"
                        {% unless forloop.first %}hidden{% endunless %}
                    >
                        <div class="feature-tabs__panel-inner">
                            {{- feature_tabs_decoration_markup -}}
                            <p class="feature-tabs__counter">
                                <span class="feature-tabs__counter-current copy-m">{{ feature_tabs_index_label }}</span>
                                <span class="copy-m" aria-hidden="true"> / </span>
                                <span class="feature-tabs__counter-total copy-m">{{ feature_tabs_total_label }}</span>
                            </p>
                            <p class="feature-tabs__eyebrow">
                                <span class="copy-m uppercase">{{ feature_tabs_item_label }}</span>
                            </p>
                            <h2 class="feature-tabs__heading">
                                <span class="{{ feature_tabs_heading_tiers }}">{{ feature_tabs_item_heading }}</span>
                            </h2>
                            <div class="feature-tabs__body">
                                <div class="rte copy-m">{{ feature_tabs_item_text }}</div>
                            </div>
                        </div>
                    </div>
                {%- endfor -%}
            {%- endif -%}

            <div
                role="tablist"
                aria-orientation="vertical"
                aria-label="{{ 'sections.feature-tabs.accessibility.tablist' | t }}"
                class="feature-tabs__tablist"
            >
                {%- if section.blocks.size > 0 -%}
                    {%- for block in section.blocks -%}
                        {%- if block.type != 'item' -%}
                            {%- continue -%}
                        {%- endif -%}
                        {%- liquid
                            assign feature_tabs_item_label = block.settings.label
                            if feature_tabs_item_label == blank
                                assign feature_tabs_item_label = 'sections.feature-tabs.defaults.item_label' | t: index: forloop.index
                            endif
                            assign feature_tabs_row_number = forloop.index
                            if forloop.index < 10
                                assign feature_tabs_row_number = forloop.index | prepend: '0'
                            endif
                        -%}
                        <button
                            type="button"
                            role="tab"
                            id="feature-tabs-{{ section.id }}-tab-{{ forloop.index0 }}"
                            aria-controls="feature-tabs-{{ section.id }}-panel-{{ forloop.index0 }}"
                            class="feature-tabs__tab"
                            x-init="registerTab($el)"
                            @click="setActive(tabIndexFor($el))"
                            @focusin="setActive(tabIndexFor($el))"
                            :tabindex="isFocusable(tabIndexFor($el)) ? 0 : -1"
                            :aria-selected="isActive(tabIndexFor($el))"
                            :class="isActive(tabIndexFor($el)) && 'is-active'"
                            {{ block.shopify_attributes }}
                        >
                            <span class="feature-tabs__tab-number"><span class="copy-m">{{ feature_tabs_row_number }}</span></span>
                            {%- # lint-allow typography-tier-heading: tab row label set in the heading face by design; a button, not a heading -%}
                            <span class="feature-tabs__tab-label"><span class="title-s desktop:title-m">{{ feature_tabs_item_label }}</span></span>
                            <span class="feature-tabs__tab-mark" aria-hidden="true"></span>
                        </button>
                    {%- endfor -%}
                {%- else -%}
                    {%- for placeholder_index in (1..4) -%}
                        {%- liquid
                            assign feature_tabs_item_label = 'sections.feature-tabs.defaults.item_label' | t: index: placeholder_index
                            assign feature_tabs_row_number = placeholder_index
                            if placeholder_index < 10
                                assign feature_tabs_row_number = placeholder_index | prepend: '0'
                            endif
                        -%}
                        <button
                            type="button"
                            role="tab"
                            id="feature-tabs-{{ section.id }}-tab-{{ forloop.index0 }}"
                            aria-controls="feature-tabs-{{ section.id }}-panel-{{ forloop.index0 }}"
                            class="feature-tabs__tab"
                            x-init="registerTab($el)"
                            @click="setActive(tabIndexFor($el))"
                            @focusin="setActive(tabIndexFor($el))"
                            :tabindex="isFocusable(tabIndexFor($el)) ? 0 : -1"
                            :aria-selected="isActive(tabIndexFor($el))"
                            :class="isActive(tabIndexFor($el)) && 'is-active'"
                        >
                            <span class="feature-tabs__tab-number"><span class="copy-m">{{ feature_tabs_row_number }}</span></span>
                            {%- # lint-allow typography-tier-heading: tab row label set in the heading face by design; a button, not a heading -%}
                            <span class="feature-tabs__tab-label"><span class="title-s desktop:title-m">{{ feature_tabs_item_label }}</span></span>
                            <span class="feature-tabs__tab-mark" aria-hidden="true"></span>
                        </button>
                    {%- endfor -%}
                {%- endif -%}
            </div>
        </div>
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: 'feature-tabs-section',
    width: 'page',
    height_kind: 'content',
    motion: false,
    root_attrs: feature_tabs_root_attrs,
    children: feature_tabs_children
%}

{% stylesheet %}
    .feature-tabs__frame {
        border: 1px solid rgb(var(--color-foreground));
        border-radius: var(--radius-card);
        overflow: hidden;
        background-color: rgb(var(--color-background));
    }

    .feature-tabs__layout {
        display: flex;
        flex-direction: column;
    }

    .feature-tabs__media {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        background-color: rgb(var(--color-background));

        @supports (background-color: color-mix(in oklab, white, black)) {
            background-color: var(--color-surface-muted);
        }
    }

    .feature-tabs__image-layer {
        position: absolute;
        inset: 0;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        /* The outgoing image stays opaque underneath until the incoming one has faded in on top. */
        transition:
            opacity 0s linear var(--motion-duration-base, 400ms),
            visibility 0s linear var(--motion-duration-base, 400ms);
    }

    .feature-tabs__image-layer.is-active {
        z-index: 1;
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transition:
            opacity var(--motion-duration-base, 400ms) var(--motion-ease-enter, ease-out),
            visibility 0s;
    }

    .feature-tabs__image-wrap {
        height: 100%;
        width: 100%;
    }

    .feature-tabs__image-wrap--placeholder {
        display: flex;
        align-items: stretch;
        border-bottom: 1px solid var(--color-line);
    }

    .feature-tabs__placeholder-svg {
        width: 100%;
        height: 100%;
        display: block;
    }

    .feature-tabs__panel-inner {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: clamp(2rem, 1.777rem + 0.571vw, 2.6rem);
    }

    .feature-tabs__decoration {
        display: none;
        pointer-events: none;
    }

    @media (width >= 48rem) {
        .feature-tabs__decoration {
            display: block;
            position: absolute;
            top: var(--spacing-step-4xl);
            right: var(--spacing-step-xl);
            width: min(28%, 9rem);
            z-index: 0;
        }

        .feature-tabs__panel-inner > :not(.feature-tabs__decoration) {
            position: relative;
            z-index: 1;
        }
    }

    .feature-tabs__counter {
        margin-block-end: clamp(2.4rem, 1.434rem + 2.476vw, 5rem);
        letter-spacing: 0.2em;
        color: rgb(var(--color-foreground));
        opacity: 0.72;
    }

    .feature-tabs__eyebrow {
        margin-block-end: clamp(1.2rem, 0.903rem + 0.762vw, 2rem);
        letter-spacing: 0.2em;
        color: rgb(var(--color-foreground));
        opacity: 0.85;
    }

    .feature-tabs__heading {
        margin-block-end: clamp(1.2rem, 0.903rem + 0.762vw, 2rem);
        padding-inline-end: clamp(0rem, -2.229rem + 5.714vw, 6rem);
        color: rgb(var(--color-foreground));
    }

    .feature-tabs__body {
        color: rgb(var(--color-foreground));
        max-width: 40rem;
    }

    .feature-tabs__tablist {
        display: flex;
        flex-direction: column;
        border-top: 1px solid var(--color-line);
    }

    .feature-tabs__tab {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: clamp(1.6rem, 1.229rem + 0.952vw, 2.6rem);
        width: 100%;
        min-height: 4.4rem;
        padding: clamp(1.4rem, 1.103rem + 0.762vw, 2.2rem) clamp(2rem, 1.777rem + 0.571vw, 2.6rem);
        border: 0;
        border-bottom: 1px solid var(--color-line);
        background: transparent;
        color: rgb(var(--color-foreground));
        text-align: start;
        cursor: pointer;
        transition:
            background-color var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease),
            color var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease);
    }

    .feature-tabs__tab:last-child {
        border-bottom: 0;
    }

    @media (hover: hover) and (pointer: fine) {
        .feature-tabs__tab:hover:not(.is-active) {
            background-color: rgba(var(--color-foreground), var(--alpha-8, 0.08));
        }
    }

    .feature-tabs__tab:focus-visible {
        outline: var(--focus-ring-width) solid
            rgba(var(--color-focus-ring), var(--focus-ring-opacity, 0.4));
        outline-offset: var(--focus-ring-offset);
    }

    .feature-tabs__tab:focus-visible:not(.is-active) {
        background-color: rgba(var(--color-foreground), var(--alpha-8, 0.08));
    }

    .feature-tabs__tab.is-active {
        background-color: rgb(var(--color-foreground));
        color: rgb(var(--color-background));
    }

    .feature-tabs__tab-number {
        min-width: 2ch;
    }

    .feature-tabs__tab-label {
        min-width: 0;
    }

    .feature-tabs__tab-label > span {
        color: inherit;
    }

    .feature-tabs__tab-mark {
        display: block;
        width: 6.6rem;
        height: 1px;
        background-color: currentColor;
        transform: scaleX(0);
        transform-origin: right center;
        transition: transform var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease);
    }

    .feature-tabs__tab.is-active .feature-tabs__tab-mark {
        transform: scaleX(1);
    }

    @media (width >= 64rem) {
        .feature-tabs__layout {
            display: grid;
            grid-template-columns: minmax(0, 60%) minmax(0, 40%);
            grid-template-rows: minmax(0, 1fr) auto;
        }

        .feature-tabs__media {
            grid-column: 1;
            grid-row: 1 / -1;
            aspect-ratio: 3 / 2;
            min-height: 100%;
        }

        .feature-tabs__panel {
            grid-column: 2;
            grid-row: 1;
            align-self: stretch;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            min-height: 0;
        }

        .feature-tabs__panel-inner {
            flex: 1;
            padding-block-start: clamp(2.6rem, 1.6rem + 1.389vw, 3.6rem);
        }

        .feature-tabs__tablist {
            grid-column: 2;
            grid-row: 2;
            align-self: end;
            border-top: 1px solid var(--color-line);
        }

        .feature-tabs__image-wrap--placeholder {
            border-bottom: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .feature-tabs__image-layer,
        .feature-tabs__image-layer.is-active,
        .feature-tabs__tab,
        .feature-tabs__tab-mark {
            transition: none;
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.feature-tabs.name",
    "tag": "section",
    "class": "feature-tabs-section",
    "enabled_on": {
        "templates": ["product", "index", "page"]
    },
    "settings": [
        {
            "type": "header",
            "content": "t:sections.feature-tabs.content.general"
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.feature-tabs.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.feature-tabs.settings.heading_size",
            "options": [
                {
                    "value": "title-4xl",
                    "label": "t:settings.type_size.title_4xl"
                },
                {
                    "value": "title-3xl",
                    "label": "t:settings.type_size.title_3xl"
                },
                {
                    "value": "title-2xl",
                    "label": "t:settings.type_size.title_2xl"
                },
                {
                    "value": "title-xl",
                    "label": "t:settings.type_size.title_xl"
                },
                {
                    "value": "title-l",
                    "label": "t:settings.type_size.title_l"
                },
                {
                    "value": "title-m",
                    "label": "t:settings.type_size.title_m"
                },
                {
                    "value": "title-s",
                    "label": "t:settings.type_size.title_s"
                },
                {
                    "value": "title-xs",
                    "label": "t:settings.type_size.title_xs"
                }
            ],
            "default": "title-xl"
        },
        {
            "type": "checkbox",
            "id": "show_decoration",
            "label": "t:sections.feature-tabs.settings.show_decoration",
            "default": true
        },
        {
            "type": "image_picker",
            "id": "decorative_image",
            "label": "t:sections.feature-tabs.settings.decorative_image",
            "info": "t:sections.feature-tabs.settings.decorative_image_info"
        },
        {
            "type": "header",
            "content": "t:sections.feature-tabs.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.feature-tabs.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.feature-tabs.settings.padding_bottom",
            "default": 32
        }
    ],
    "blocks": [
        {
            "type": "item",
            "name": "t:sections.feature-tabs.blocks.item",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:sections.feature-tabs.block_settings.image"
                },
                {
                    "type": "text",
                    "id": "label",
                    "label": "t:sections.feature-tabs.block_settings.label",
                    "default": "t:sections.feature-tabs.blocks_defaults.label"
                },
                {
                    "type": "inline_richtext",
                    "id": "heading",
                    "label": "t:sections.feature-tabs.block_settings.heading",
                    "default": "t:sections.feature-tabs.blocks_defaults.heading"
                },
                {
