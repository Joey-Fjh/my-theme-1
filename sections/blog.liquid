<div
    data-section-id="{{ section.id }}"
    class="blog-section full-width relative"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-pagination-section-id="{{ section.id }}"
    data-pagination-selectors='["[role=&quot;tabpanel&quot;]",".sup-badge"]'
    x-data="sectionPagination()"
>
    {%- liquid
        assign blog_heading_class = section.settings.heading_size | default: 'heading-3xl'
        assign blog_subtitle_class = section.settings.subtitle_size | default: 'body-xl'
    -%}
    <div
        class="
            layout layout-no-pb container-page
            color-{{ section.settings.header_color_scheme }}
        "
    >
        {%- comment -%} Hero {%- endcomment -%}
        <div
            class="relative py-20 pc:py-40"
            x-data="motionRevealSection()"
            data-motion-section
        >
            <div class="flex items-start justify-between">
                <div data-motion-reveal="content" data-motion-critical>
                    {%- render 'listing-page-hero-copy',
                        setting_header: section.settings.header,
                        object_title: blog.title,
                        header_locale_key: 'blog.title',
                        setting_description: section.settings.description,
                        description_locale_key: 'blog.description_html',
                        heading_class: blog_heading_class,
                        description_class: blog_subtitle_class
                    -%}
                </div>

                <div
                    class="absolute top-8 right-0 z-10 pc:static"
                    data-motion-reveal="media"
                >
                    {%- render 'rotating-badge',
                        classes: 'relative justify-self-center',
                        badge_class: 'text-current',
                        center_class: 'text-current',
                        unique_id: section.id,
                        size: 100,
                        size_mobile: 72,
                        badge_text: section.settings.rotate_badge_text,
                        center_text: section.settings.rotate_badge_percent
                    -%}
                </div>
            </div>
        </div>
    </div>

    <div
        class="
            layout layout-no-pt container-page
            color-{{ section.settings.color_scheme }} surface-section
            pt-6 pc:pt-8
        "
        style="--body-size-custom: 24px; --body-size-custom-pc: 32px;"
    >
        <div class="relative flex items-center justify-between">
            {%- comment -%} Tab Header (Router Trigger) + Tab Content (fetch replace) {%- endcomment -%}
            <div class="min-w-0 flex-1">
                {%- liquid
                    assign active_tab_index = 0
                    if current_tags != blank
                        for tag in blog.all_tags
                            if current_tags contains tag
                                assign active_tab_index = forloop.index
                                break
                            endif
                        endfor
                    endif
                -%}

                {% capture tab_header %}
                    <span class="hidden" x-init="$nextTick(() => { setActive({{ active_tab_index }}) })"></span>

                    <a
                        href="{{ blog.url }}"
                        role="tab"
                        x-data="{ index: null }"
                        x-init="index = registerTab($el);"
                        :id="`tab-${index}`"
                        aria-controls="blog-panel"
                        @click.prevent="loadUrl($el.href); setActive(index)"
                        @popstate.window="isUrlMatch($el.href) && setActive(index)"
                        :tabindex="isActive(index) ? 0 : -1"
                        :aria-selected="isActive(index)"
                        :class="isActive(index) && 'is-active'"
                        class="blog__tab tab-nav-item tab-nav-item--underline-opacity tab-nav-item--hover-muted"
                    >
                        {{ 'collections.all' | t }} <sup class="sup-badge">({{ blog.articles_count | default: 0 }})</sup>
                    </a>

                    {%- for tag in blog.all_tags -%}
                        <a
                            href="{{ blog.url }}/tagged/{{ tag | handle }}"
                            role="tab"
                            x-data="{ index: null }"
                            x-init="index = registerTab($el);"
                            :id="`tab-${index}`"
                            aria-controls="blog-panel"
                            @click.prevent="loadUrl($el.href); setActive(index)"
                            @popstate.window="isUrlMatch($el.href) && setActive(index)"
                            :tabindex="isActive(index) ? 0 : -1"
                            :aria-selected="isActive(index)"
                            :class="isActive(index) && 'is-active'"
                            class="blog__tab tab-nav-item tab-nav-item--underline-opacity tab-nav-item--hover-muted"
                        >
                            {{ tag }}
                        </a>
                    {%- endfor -%}
                {% endcapture %}

                {% capture tab_content %}
                    <div
                        role="tabpanel"
                        id="blog-panel"
                        x-data="{ index: null }"
                        x-init="index = registerPanel($el)"
                        class="relative w-full"
                    >
                        {% render 'loading', overlay: true, size: 'large' %}

                        {% paginate blog.articles by section.settings.articles_per_page %}
                            <div
                                class="grid grid-cols-1 gap-8 pb-10 pc:grid-cols-3"
                                x-data="motionRevealSection()"
                                data-motion-section
                                data-motion-cascade
                            >
                                {% for article in blog.articles %}
                                    {%- liquid
                                        assign editorial_placeholder_index = forloop.index0 | modulo: 2 | plus: 1
                                        assign editorial_placeholder_key = 'lifestyle-' | append: editorial_placeholder_index
                                    -%}
                                    <article
                                        class="group"
                                        data-motion-reveal="content"
                                    >
                                        <div class="mb-4 block aspect-4/3 overflow-hidden rounded-sm">
                                            {% comment %} Image {% endcomment %}
                                            {%- capture sizes -%}
                                                (max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw
                                            {%- endcapture -%}
                                            
                                            {%- capture widths -%}
                                                400, 700
                                            {%- endcapture -%}

                                            {%- render 'image',
                                                url: article.url,
                                                wrapper_class: 'block h-full w-full',
                                                img_class: 'h-full w-full object-cover',
                                                image: article.image,
                                                placeholder_key: editorial_placeholder_key,
                                                alt: article.title,
                                                width: article.image.width,
                                                sizes: sizes,
                                                widths: widths,
                                                motion_reveal: false
                                            -%}
                                        </div>

                                        <div data-motion-copy-bound>
                                            <div data-motion-copy>
                                                <p class="my-6">
                                                    {{ article.tags | first }}
                                                </p>

                                                <h2 class="my-6 heading-h2">
                                                    <a href="{{ article.url }}">{{ article.title }}</a>
                                                </h2>

                                                {%- liquid
                                                    assign article_excerpt = article.excerpt_or_content | strip_html | strip | truncatewords: 30
                                                -%}
                                                {%- if article_excerpt != blank -%}
                                                    <p class="my-6 body-lg text-theme-text/80">
                                                        {{- article_excerpt | escape_once -}}
                                                    </p>
                                                {%- endif -%}

                                                {%- if article.url !=blank -%}
                                                    {%- capture link_content -%}
                                                        <span>{{ section.settings.link_text }}</span>
                                                        {% render 'icons', icon: 'icon-arrow2', class: 'ms-3' %}
                                                    {%- endcapture -%}

                                                    {%- render 'link',
                                                        href: article.url,
                                                        content: link_content,
                                                        variant: 'underline',
                                                        class: 'body-xl'
                                                    -%}
                                                {%- endif -%}
                                            </div>
                                        </div>
                                    </article>
                                {% endfor %}
                            </div>

                            <div
                                class="blog-pagination-wrapper"
                                @click="
                                    let link = $event.target.closest('[data-pagination-nav] a');
                                    if (link) { 
                                        $event.preventDefault(); 
                                        loadUrl(link.href); 
                                    }
                                "
                            >
                                {% render 'pagination', paginate_obj: paginate %}
                            </div>
                        {% endpaginate %}
                    </div>
                {% endcapture %}

                {%- render 'tab-control',
                    custom_class: 'items-start',
                    tab_header: tab_header,
                    header_class: 'body-size-custom gap-9',
                    tab_content: tab_content
                -%}
            </div>
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:general.blog",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["blog"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "header_color_scheme",
            "label": "t:sections.blog.settings.header_color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "heading-4xl",
                    "label": "t:sections.slides-show.options.heading_4xl"
                },
                {
                    "value": "heading-3xl",
                    "label": "t:sections.slides-show.options.heading_3xl"
                },
                {
                    "value": "heading-2xl",
                    "label": "t:sections.slides-show.options.heading_2xl"
                },
                {
                    "value": "heading-xl",
                    "label": "t:sections.slides-show.options.heading_xl"
                },
                {
                    "value": "heading-h1",
                    "label": "t:sections.slides-show.options.heading_h1"
                },
                {
                    "value": "heading-h2",
                    "label": "t:sections.slides-show.options.heading_h2"
                },
                {
                    "value": "heading-h3",
                    "label": "t:sections.slides-show.options.heading_h3"
                },
                {
                    "value": "heading-h4",
                    "label": "t:sections.slides-show.options.heading_h4"
                },
                {
                    "value": "heading-h5",
                    "label": "t:sections.slides-show.options.heading_h5"
                },
                {
                    "value": "heading-h6",
                    "label": "t:sections.slides-show.options.heading_h6"
                }
            ],
            "default": "heading-3xl"
        },
        {
            "type": "inline_richtext",
            "id": "header",
            "default": "t:sections.blog.defaults.header",
            "label": "t:sections.blog.settings.header"
        },
        {
            "type": "richtext",
            "id": "description",
            "default": "t:sections.blog.defaults.description",
            "label": "t:sections.blog.settings.description"
        },
        {
            "type": "header",
            "content": "t:sections.scroll-categories.content.subtitle"
        },
        {
            "type": "select",
            "id": "subtitle_size",
            "label": "t:sections.scroll-categories.settings.subtitle_size",
            "options": [
                {
                    "value": "body-3xl",
                    "label": "t:sections.scroll-categories.options.body_3xl"
                },
                {
                    "value": "body-2xl",
                    "label": "t:sections.scroll-categories.options.body_2xl"
                },
                {
                    "value": "body-xl",
                    "label": "t:sections.scroll-categories.options.body_xl"
                },
                {
                    "value": "body-lg",
                    "label": "t:sections.scroll-categories.options.body_lg"
                },
                {
                    "value": "body-md",
                    "label": "t:sections.scroll-categories.options.body_md"
                },
                {
                    "value": "body-sm",
                    "label": "t:sections.scroll-categories.options.body_sm"
                },
                {
                    "value": "body-xs",
                    "label": "t:sections.scroll-categories.options.body_xs"
                }
            ],
            "default": "body-xl"
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.blog.settings.tab_control_color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "text",
            "id": "rotate_badge_text",
            "label": "t:sections.blog.settings.rotate_badge_text",
            "default": "t:sections.blog.defaults.rotate_badge_text"
        },
        {
            "type": "text",
            "id": "rotate_badge_percent",
            "label": "t:sections.blog.settings.rotate_badge_percent",
            "default": "t:sections.blog.defaults.rotate_badge_percent"
        },
        {
            "type": "range",
            "id": "articles_per_page",
            "min": 3,
            "max": 24,
            "step": 3,
            "default": 12,
            "label": "t:sections.blog.settings.articles_per_page"
        },
        {
            "type": "text",
            "id": "link_text",
            "label": "t:sections.blog.settings.link_text",
            "default": "t:sections.blog.defaults.link_text"
        },
        {
            "type": "header",
            "content": "t:sections.blog.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.blog.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.blog.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
