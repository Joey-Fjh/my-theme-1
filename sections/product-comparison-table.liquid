<section
    data-section-id="{{ section.id }}"
    class="product-comparison-table-section full-width color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top | default: 0 }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
        --comparison-column-bg-color: {{ section.settings.comparison_column_bg_color | default: '#F4F1E8' }};
        --comparison-success-color: {{ section.settings.comparison_success_color | default: '#228E58' }};
        --comparison-danger-color: {{ section.settings.comparison_danger_color | default: '#E04A4A' }};
    "
    data-component-kind="section"
    data-component-type="product-comparison-table"
    data-component-id="{{ section.id }}"
>
    <div
        class="layout container-page mx-auto pb-8"
        style="
            --comparison-table-width-mobile: {{ section.settings.products.size | times: 140 | plus: 116 }}px;
            --comparison-table-width-pc: {{ section.settings.products.size | times: 280 | plus: 156 }}px;
        "
    >
        {% if section.settings.heading != blank %}
            <h2 class="mb-10 text-center h1 font-bold text-theme-text pc:mb-16">
                {{ section.settings.heading }}
            </h2>
        {% endif %}
        {% if section.settings.products != blank and section.blocks.size > 0 %}
            <div
                class="comparison-table-scroll overflow-x-auto"
                aria-label="Scroll to compare more products"
                data-comparison-scroll
            >
                <table
                    class="comparison-table table-fixed border-collapse text-left"
                    role="grid"
                    aria-label="Product comparison"
                >
                    <tbody>
                        {% for block in section.blocks %}
                            <tr {{ block.shopify_attributes }}>
                                {% comment %} Row header (first column) — frozen when horizontal scroll {% endcomment %}
                                <th
                                    scope="row"
                                    class="
                                        comparison-table__sticky-col
                                        comparison-table__row-header
                                        sticky left-0 z-10
                                        border border-theme-border-soft bg-theme-bg
                                        px-4 py-5 align-middle body-md leading-snug font-medium whitespace-normal text-theme-text/70 shadow-[2px_0_6px_-2px_rgba(0,0,0,0.06)]
                                        pc:px-6 pc:py-7
                                    "
                                >
                                    {% case block.type %}
                                        {% when 'header' %}
                                            Product
                                        {% when 'price' %}
                                            Price
                                        {% when 'rating' %}
                                            Rating
                                        {% when 'metafield_text' %}
                                            {{ block.settings.row_title | default: '—' }}
                                        {% when 'availability' %}
                                            Availability
                                        {% else %}
                                            —
                                    {% endcase %}
                                </th>

                                {% comment %} Product data columns {% endcomment %}
                                {% for item in section.settings.products %}
                                    {% assign is_highlight = false %}
                                    {% if section.settings.highlight_index > 0
                                        and forloop.index == section.settings.highlight_index
                                    %}
                                        {% assign is_highlight = true %}
                                    {% endif %}
                                    <td
                                        class="
                                            comparison-table__product-cell
                                            border border-theme-border-soft p-3 align-middle pc:p-6
                                            {% if is_highlight %}bg-(--comparison-column-bg-color){% else %}bg-transparent{% endif %}
                                        "
                                    >
                                        {% case block.type %}
                                            {% when 'header' %}
                                                <a
                                                    href="{{ item.url }}"
                                                    class="comparison-table-product-link flex w-full cursor-pointer flex-col items-center text-inherit no-underline"
                                                >
                                                    <div class="mb-4 flex h-44 w-full items-center justify-center pc:mb-6 pc:h-[260px]">
                                                        <div class="h-full w-full max-w-[76%] pc:max-w-[74%]">
                                                            {%-
                                                                render 'image',
                                                                image: item.featured_image,
                                                                width: 360,
                                                                aspect_ratio: '3/4',
                                                                wrapper: 'div',
                                                                class: 'w-full h-full',
                                                                img_class: 'image_img w-full h-full object-contain object-center',
                                                                alt: item.featured_image.alt | default: item.title
                                                            -%}
                                                        </div>
                                                    </div>
                                                    <span class="block w-full text-center body-md font-semibold text-theme-text">
                                                        {{- item.title -}}
                                                    </span>
                                                </a>

                                            {% when 'price' %}
                                                <div class="flex flex-wrap items-baseline gap-2">
                                                    <span class="font-medium">
                                                        {{- item.price | money -}}
                                                    </span>
                                                    {% if item.compare_at_price != blank
                                                        and item.compare_at_price > item.price
                                                    %}
                                                        <span class="body-md text-theme-text/70 line-through">
                                                            {{- item.compare_at_price | money -}}
                                                        </span>
                                                    {% endif %}
                                                </div>

                                            {% when 'rating' %}
                                                <div class="comparison-table__rating inline-flex items-center gap-1 whitespace-nowrap">
                                                    {%- render 'starts',
                                                        rating: 4.5,
                                                        max: 5,
                                                        size: 'lg',
                                                        wrapper_class: 'mb-0 inline-flex items-center flex-none comparison-table__rating-stars'
                                                    -%}
                                                    <span class="comparison-table__rating-value shrink-0 body-md text-theme-text/70"
                                                        >4.5</span
                                                    >
                                                </div>

                                            {% when 'metafield_text' %}
                                                {% assign meta_key = block.settings.metafield_key
                                                    | strip
                                                %}
                                                {% if meta_key != '' %}
                                                    {% assign meta_parts = meta_key | split: '.' %}
                                                    {% assign meta_ns = meta_parts[0] %}
                                                    {% assign meta_key_name = meta_parts[1] %}
                                                    {% assign meta_val = item.metafields[meta_ns][meta_key_name] %}
                                                    <div class="body-md text-theme-text/70">
                                                        {% if meta_val != blank
                                                            and meta_val.value != blank
                                                        %}
                                                            {{ meta_val.value }}
                                                        {% elsif meta_val != blank %}
                                                            {{ meta_val }}
                                                        {% else %}
                                                            —
                                                        {% endif %}
                                                    </div>
                                                {% else %}
                                                    <span class="body-md text-theme-text/60"
                                                        >—</span
                                                    >
                                                {% endif %}

                                            {% when 'availability' %}
                                                {% if item.available %}
                                                    <span class="body-md text-(--comparison-success-color)"
                                                        >In stock</span
                                                    >
                                                {% else %}
                                                    <span class="body-md text-(--comparison-danger-color)"
                                                        >Out of Stock</span
                                                    >
                                                {% endif %}

                                            {% else %}
                                                <span class="text-theme-text/60">—</span>
                                        {% endcase %}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="py-12 text-center text-gray-500">
                <p class="h5">Select products in the section settings to compare.</p>
                <p class="mt-2 h6">Add blocks (Price, Rating, etc.) to define comparison rows.</p>
            </div>
        {% endif %}
    </div>
</section>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components) return;

        Components.register(
            'product-comparison-table',
            {
                init(el) {
                    const scrollEl = el.querySelector('[data-comparison-scroll]');
                    if (!scrollEl) return {};

                    const timeoutRef = { id: null };
                    const showDelayMs = 1000;
                    const dragThresholdPx = 5;

                    function showScrollbar() {
                        scrollEl.classList.add('is-scrolling');
                        if (timeoutRef.id) clearTimeout(timeoutRef.id);
                        timeoutRef.id = setTimeout(function () {
                            scrollEl.classList.remove('is-scrolling');
                            timeoutRef.id = null;
                        }, showDelayMs);
                    }

                    function onScroll() {
                        showScrollbar();
                    }

                    scrollEl.addEventListener('scroll', onScroll, { passive: true });

                    var dragStartX = 0;
                    var dragStartScrollLeft = 0;
                    var isPointerDown = false;
                    var didDrag = false;
                    var boundMove = null;
                    var boundUp = null;

                    function onPointerDown(e) {
                        if (e.button !== 0) return;
                        isPointerDown = true;
                        didDrag = false;
                        dragStartX = e.clientX;
                        dragStartScrollLeft = scrollEl.scrollLeft;
                        boundMove = onPointerMove;
                        boundUp = onPointerUp;
                        window.addEventListener('mousemove', boundMove, { passive: true });
                        window.addEventListener('mouseup', boundUp);
                    }

                    function onPointerMove(e) {
                        if (!isPointerDown) return;
                        var dx = dragStartX - e.clientX;
                        scrollEl.scrollLeft = dragStartScrollLeft + dx;
                        if (Math.abs(e.clientX - dragStartX) >= dragThresholdPx) {
                            didDrag = true;
                            scrollEl.classList.add('is-dragging');
                            showScrollbar();
                        }
                    }

                    function onPointerUp() {
                        isPointerDown = false;
                        scrollEl.classList.remove('is-dragging');
                        if (boundMove) window.removeEventListener('mousemove', boundMove);
                        if (boundUp) window.removeEventListener('mouseup', boundUp);
                        boundMove = null;
                        boundUp = null;
                        setTimeout(function () {
                            didDrag = false;
                        }, 0);
                    }

                    scrollEl.addEventListener('mousedown', onPointerDown);

                    function onLinkClick(e) {
                        if (didDrag && e.target.closest('.comparison-table-product-link')) {
                            e.preventDefault();
                            e.stopPropagation();
                        }
                    }

                    scrollEl.addEventListener('click', onLinkClick, true);

                    return {
                        scrollEl: scrollEl,
                        onScroll: onScroll,
                        timeoutRef: timeoutRef,
                        onPointerDown: onPointerDown,
                        onLinkClick: onLinkClick,
                    };
                },
                destroy(el, state) {
                    if (!state?.scrollEl) return;
                    state.scrollEl.removeEventListener('scroll', state.onScroll);
                    if (state.timeoutRef?.id) clearTimeout(state.timeoutRef.id);
                    state.scrollEl.removeEventListener('mousedown', state.onPointerDown);
                    state.scrollEl.removeEventListener('click', state.onLinkClick, true);
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{% stylesheet %}
    .product-comparison-table-section {
        .comparison-table {
            width: var(--comparison-table-width-mobile);
            min-width: var(--comparison-table-width-mobile);
        }
        .comparison-table__row-header {
            width: 116px;
            min-width: 116px;
            max-width: 116px;
        }
        .comparison-table__product-cell {
            width: 140px;
            min-width: 140px;
            max-width: 140px;
            overflow-wrap: anywhere;
        }
        .comparison-table-product-link {
            min-width: 0;
        }
        .comparison-table tbody tr:first-child .comparison-table__row-header,
        .comparison-table tbody tr:first-child .comparison-table__product-cell {
            height: 250px;
        }
        .comparison-table__rating {
            max-width: 100%;
            line-height: 1;
        }
        .comparison-table__rating-stars {
            gap: 0.2rem;
            margin-bottom: 0;
            line-height: 1;
        }
        .comparison-table__rating .stars__icon {
            width: 1.35rem;
            height: 1.35rem;
        }
        .comparison-table__rating-value {
            line-height: 1;
        }
        @media (width >= 48rem) {
            .comparison-table {
                width: var(--comparison-table-width-pc);
                min-width: var(--comparison-table-width-pc);
            }
            .comparison-table__row-header {
                width: 156px;
                min-width: 156px;
                max-width: 156px;
            }
            .comparison-table__product-cell {
                width: 280px;
                min-width: 280px;
                max-width: 280px;
            }
            .comparison-table tbody tr:first-child .comparison-table__row-header,
            .comparison-table tbody tr:first-child .comparison-table__product-cell {
                height: 360px;
            }
            .comparison-table__rating {
                gap: 0.8rem;
            }
            .comparison-table__rating-stars {
                gap: 0.35rem;
            }
            .comparison-table__rating .stars__icon {
                width: 1.75rem;
                height: 1.75rem;
            }
        }
        .comparison-table-scroll {
            scrollbar-width: thin;
            scrollbar-color: transparent transparent;
            cursor: grab;
        }
        .comparison-table-scroll:active {
            cursor: grab;
        }
        .comparison-table-scroll.is-dragging {
            cursor: grabbing;
            user-select: none;
        }
        .comparison-table-scroll.is-dragging * {
            user-select: none;
            pointer-events: none;
        }
        .comparison-table-scroll .comparison-table-product-link {
            pointer-events: auto;
            cursor: pointer;
        }
        .comparison-table-scroll.is-dragging .comparison-table-product-link {
            pointer-events: none;
        }
        .comparison-table-scroll::-webkit-scrollbar {
            height: 8px;
        }
        .comparison-table-scroll.is-scrolling {
            scrollbar-color: rgba(0, 0, 0, 0.25) transparent;
        }
        .comparison-table-scroll::-webkit-scrollbar-track {
            background: transparent;
            border-radius: 4px;
        }
        .comparison-table-scroll::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.25);
            border-radius: 4px;
            opacity: 0;
            transition: opacity 0.25s ease-out;
        }
        .comparison-table-scroll.is-scrolling::-webkit-scrollbar-thumb {
            opacity: 1;
        }
        .comparison-table-scroll.is-scrolling::-webkit-scrollbar-thumb:hover {
            background: rgba(0, 0, 0, 0.35);
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "Comparison Table",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "scheme-1"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "Section heading",
            "default": "Similar Comparison Products"
        },
        {
            "type": "color",
            "id": "comparison_column_bg_color",
            "label": "Highlight column background",
            "default": "#F4F1E8"
        },
        {
            "type": "color",
            "id": "comparison_success_color",
            "label": "Availability in stock color",
            "default": "#228E58"
        },
        {
            "type": "color",
            "id": "comparison_danger_color",
            "label": "Availability out of stock color",
            "default": "#E04A4A"
        },
        {
            "type": "product_list",
            "id": "products",
            "label": "Select Products",
            "limit": 8
        },
        {
            "type": "range",
            "id": "highlight_index",
            "min": 0,
            "max": 8,
            "step": 1,
            "default": 1,
            "label": "Highlight Column Index",
            "info": "1 = first product column; 0 = no highlight"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "header",
            "name": "Product Info",
            "limit": 1
        },
        {
            "type": "price",
            "name": "Price",
            "limit": 1
        },
        {
            "type": "rating",
            "name": "Rating",
            "limit": 1
        },
        {
            "type": "metafield_text",
            "name": "Ingredients / Metafield",
            "settings": [
                {
                    "type": "inline_richtext",
                    "id": "row_title",
                    "label": "Row title",
                    "default": "Ingredients"
                },
                {
                    "type": "text",
                    "id": "metafield_key",
                    "label": "Metafield key (namespace.key)",
                    "default": "custom.ingredients",
                    "info": "e.g. custom.ingredients"
                }
            ]
        },
        {
            "type": "availability",
            "name": "Availability",
            "limit": 1
        }
    ],
    "presets": [
        {
            "name": "Comparison Table",
            "blocks": [
                { "type": "header" },
                { "type": "price" },
                { "type": "rating" },
                {
                    "type": "metafield_text",
                    "settings": {
                        "row_title": "Ingredients",
                        "metafield_key": "custom.ingredients"
                    }
                },
                { "type": "availability" }
            ]
        }
    ]
}
{% endschema %}
