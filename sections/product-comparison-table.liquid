{%- liquid
    assign comparison_heading_class = section.settings.heading_size | default: 'title-2xl'
    assign comparison_products = section.settings.products
    assign comparison_columns = comparison_products
    assign comparison_item_count = comparison_products.size
    assign has_comparison_products = false
    if comparison_item_count > 0
        assign has_comparison_products = true
    else
        assign comparison_columns = '1,2,3,4,5,6' | split: ','
        assign comparison_item_count = comparison_columns.size
    endif
-%}
{%- assign comparison_root_attrs = 'data-component-kind="section" data-component-type="product-comparison-table" data-component-id="'
    | append: section.id
    | append: '"'
-%}
{%- capture product_comparison_children -%}
    <div
        class="mx-auto flex flex-col gap-10 pb-8 pc:gap-16"
        style="
            --comparison-table-width-mobile: {{ comparison_item_count | times: 140 | plus: 116 }}px;
            --comparison-table-width-pc: {{ comparison_item_count | times: 280 | plus: 156 }}px;
        "
        x-data="productComparisonTable()"
        data-module-id="product-comparison-table"
    >
        {% if section.settings.heading != blank %}
            {% render 'heading',
                level: '1',
                tier: comparison_heading_class,
                align: 'center',
                content: section.settings.heading
            %}
        {% endif %}
        {% if section.blocks.size > 0 %}
            <div
                class="comparison-table-scroll overflow-x-auto"
                tabindex="0"
                role="group"
                aria-label="{{ 'accessibility.scroll_to_compare' | t }}"
                data-comparison-scroll
            >
                <table
                    class="comparison-table table-fixed border-collapse text-start"
                    aria-label="{{ 'accessibility.product_comparison' | t }}"
                >
                    <tbody>
                        {% for block in section.blocks %}
                            <tr {{ block.shopify_attributes }}>
                                {% comment %} Row header (first column) — frozen when horizontal scroll {% endcomment %}
                                <th
                                    scope="row"
                                    class="
                                        comparison-table__sticky-col
                                        comparison-table__row-header
                                        comparison-table__sticky-col-shadow sticky left-0
                                        z-10 border border-line
                                        bg-theme-bg px-4 py-5 align-middle whitespace-normal
                                        pc:px-6 pc:py-7
                                        {% unless block.type == 'metafield_text' %}body-lg{% endunless %}
                                    "
                                >
                                    {% case block.type %}
                                        {% when 'header' %}
                                            {{ 'products.comparison.product' | t }}
                                        {% when 'price' %}
                                            {{ 'products.comparison.price' | t }}
                                        {% when 'rating' %}
                                            {{ 'products.comparison.rating' | t }}
                                        {% when 'metafield_text' %}
                                            {{ block.settings.row_title | default: '—' }}
                                        {% when 'availability' %}
                                            {{ 'products.comparison.availability' | t }}
                                        {% else %}
                                            —
                                    {% endcase %}
                                </th>

                                {% comment %} Product data columns {% endcomment %}
                                {% for item in comparison_columns %}
                                    {%- liquid
                                        assign column_index = forloop.index
                                        assign is_placeholder = false
                                        unless has_comparison_products
                                            assign is_placeholder = true
                                        endunless
                                        assign placeholder_index = column_index | minus: 1 | modulo: 6 | plus: 1
                                        assign placeholder_key = 'product-' | append: placeholder_index
                                        assign is_highlight = false
                                        if section.settings.highlight_index > 0 and column_index == section.settings.highlight_index
                                            assign is_highlight = true
                                        endif
                                    -%}
                                    <td
                                        class="
                                            comparison-table__product-cell
                                            border border-line p-3 align-middle pc:p-6
                                            {% if is_highlight %}bg-card{% else %}bg-transparent{% endif %}
                                            {% if block.type != 'header' and block.type != 'metafield_text' %}body-lg{% endif %}
                                        "
                                    >
                                        {% case block.type %}
                                            {% when 'header' %}
                                                {%- if is_placeholder -%}
                                                    <div class="flex w-full flex-col items-center gap-4 text-inherit pc:gap-6">
                                                        <div class="flex h-44 w-full items-center justify-center pc:h-[260px]">
                                                            <div class="h-full w-full max-w-[76%] pc:max-w-[74%]">
                                                                {%- render 'image',
                                                                    image: blank,
                                                                    placeholder_key: placeholder_key,
                                                                    aspect_ratio: '3/4',
                                                                    mode: 'frame',
                                                                    fit: 'contain',
                                                                    wrapper_class: 'h-full w-full',
                                                                -%}
                                                            </div>
                                                        </div>
                                                        <span class="block w-full text-center body-xl">
                                                            {{-
                                                                'products.comparison.example_product'
                                                                | t: index: column_index
                                                            -}}
                                                        </span>
                                                    </div>
                                                {%- else -%}
                                                    <a
                                                        href="{{ item.url }}"
                                                        class="comparison-table-product-link media-interaction flex w-full cursor-pointer flex-col items-center gap-4 text-inherit no-underline pc:gap-6"
                                                    >
                                                        <div class="flex h-44 w-full items-center justify-center pc:h-[260px]">
                                                            <div class="h-full w-full max-w-[76%] pc:max-w-[74%]">
                                                                {%- assign image_alt = item.featured_image.alt
                                                                    | default: item.title
                                                                -%}
                                                                {%- if item.featured_image != blank
                                                                -%}
                                                                    {%- render 'image',
                                                                        image: item.featured_image,
                                                                        width: 360,
                                                                        aspect_ratio: '3/4',
                                                                        wrapper: 'div',
                                                                        class: 'w-full h-full',
                                                                        img_class: 'image_img w-full h-full object-contain object-center',
                                                                        alt: image_alt,
                                                                    -%}
                                                                {%- else -%}
                                                                    {%- render 'image',
                                                                        image: blank,
                                                                        placeholder_key: placeholder_key,
                                                                        aspect_ratio: '3/4',
                                                                        mode: 'frame',
                                                                        fit: 'contain',
                                                                        wrapper_class: 'h-full w-full',
                                                                    -%}
                                                                {%- endif -%}
                                                            </div>
                                                        </div>
                                                        <span class="block w-full text-center body-xl">
                                                            {{- item.title -}}
                                                        </span>
                                                    </a>
                                                {%- endif -%}

                                            {% when 'price' %}
                                                <div class="flex flex-wrap items-baseline gap-2">
                                                    <span>
                                                        {%- if is_placeholder -%}
                                                            {{- 1999 | money -}}
                                                        {%- else -%}
                                                            {{- item.price | money -}}
                                                        {%- endif -%}
                                                    </span>
                                                    {% if is_placeholder == false
                                                        and item.compare_at_price != blank
                                                        and item.compare_at_price > item.price
                                                    %}
                                                        <span class="line-through">
                                                            {{- item.compare_at_price | money -}}
                                                        </span>
                                                    {% endif %}
                                                </div>

                                            {% when 'rating' %}
                                                <div class="comparison-table__rating inline-flex items-center gap-1 whitespace-nowrap">
                                                    {%- render 'starts',
                                                        rating: 4.5,
                                                        max: 5,
                                                        wrapper_class: 'mb-0 inline-flex items-center flex-none comparison-table__rating-stars'
                                                    -%}
                                                    <span class="comparison-table__rating-value shrink-0"
                                                        >4.5</span
                                                    >
                                                </div>

                                            {% when 'metafield_text' %}
                                                {% if is_placeholder %}
                                                    <span>
                                                        {{-
                                                            'products.comparison.example_detail'
                                                            | t
                                                        -}}
                                                    </span>
                                                {% else %}
                                                    {% assign meta_key = block.settings.metafield_key
                                                        | strip
                                                    %}
                                                    {% if meta_key != '' %}
                                                        {% assign meta_parts = meta_key
                                                            | split: '.'
                                                        %}
                                                        {% assign meta_ns = meta_parts[0] %}
                                                        {% assign meta_key_name = meta_parts[1] %}
                                                        {% assign meta_val = item.metafields[meta_ns][meta_key_name] %}
                                                        <div>
                                                            {% if meta_val != blank
                                                                and meta_val.value != blank
                                                            %}
                                                                {{ meta_val.value }}
                                                            {% elsif meta_val != blank %}
                                                                {{ meta_val }}
                                                            {% else %}
                                                                —
                                                            {% endif %}
                                                        </div>
                                                    {% else %}
                                                        <span>—</span>
                                                    {% endif %}
                                                {% endif %}

                                            {% when 'availability' %}
                                                {% if is_placeholder %}
                                                    <span class="text-subtle">
                                                        {{- 'products.product.unavailable' | t -}}
                                                    </span>
                                                {% elsif item.available %}
                                                    <span class="comparison-table__availability--success">
                                                        {{- 'products.comparison.in_stock' | t -}}
                                                    </span>
                                                {% else %}
                                                    <span class="comparison-table__availability--danger">
                                                        {{-
                                                            'products.comparison.out_of_stock'
                                                            | t
                                                        -}}
                                                    </span>
                                                {% endif %}

                                            {% else %}
                                                <span>—</span>
                                        {% endcase %}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="py-12 text-center text-subtle">
                <p>{{ 'products.comparison.no_blocks' | t }}</p>
            </div>
        {% endif %}
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: 'product-comparison-table-section',
    motion: false,
    root_attrs: comparison_root_attrs,
    children: product_comparison_children
%}

{% stylesheet %}
    .product-comparison-table-section {
        .comparison-table {
            width: var(--comparison-table-width-mobile);
            min-width: var(--comparison-table-width-mobile);
        }
        .comparison-table__row-header {
            width: 116px;
            min-width: 116px;
            max-width: 116px;
        }
        .comparison-table__product-cell {
            width: 140px;
            min-width: 140px;
            max-width: 140px;
            overflow-wrap: anywhere;
        }
        .comparison-table-product-link {
            min-width: 0;
        }
        .comparison-table tbody tr:first-child .comparison-table__row-header,
        .comparison-table tbody tr:first-child .comparison-table__product-cell {
            height: 250px;
        }
        .comparison-table__sticky-col-shadow {
            box-shadow: var(--shadow-sm);
        }
        .comparison-table__rating {
            max-width: 100%;
            line-height: inherit;
        }
        .comparison-table__rating-stars {
            gap: 0.2rem;
            margin-bottom: 0;
            line-height: inherit;
        }
        .comparison-table__availability--success {
            color: rgb(var(--color-success-foreground));
        }
        .comparison-table__availability--danger {
            color: rgb(var(--color-error-foreground));
        }
        .comparison-table__rating .stars__icon {
            width: 1.35rem;
            height: 1.35rem;
        }
        .comparison-table__rating-value {
            line-height: inherit;
        }
        @media (width >= 48rem) {
            .comparison-table {
                width: var(--comparison-table-width-pc);
                min-width: var(--comparison-table-width-pc);
            }
            .comparison-table__row-header {
                width: 156px;
                min-width: 156px;
                max-width: 156px;
            }
            .comparison-table__product-cell {
                width: 280px;
                min-width: 280px;
                max-width: 280px;
            }
            .comparison-table tbody tr:first-child .comparison-table__row-header,
            .comparison-table tbody tr:first-child .comparison-table__product-cell {
                height: 360px;
            }
            .comparison-table__rating {
                gap: 0.8rem;
            }
            .comparison-table__rating-stars {
                gap: 0.35rem;
            }
            .comparison-table__rating .stars__icon {
                width: 1.75rem;
                height: 1.75rem;
            }
        }
        .comparison-table-scroll {
            scrollbar-width: thin;
            scrollbar-color: transparent transparent;
            cursor: grab;
        }
        .comparison-table-scroll:active {
            cursor: grab;
        }
        .comparison-table-scroll.is-dragging {
            cursor: grabbing;
            user-select: none;
        }
        .comparison-table-scroll.is-dragging * {
            user-select: none;
            pointer-events: none;
        }
        .comparison-table-scroll .comparison-table-product-link {
            pointer-events: auto;
            cursor: pointer;
        }
        .comparison-table-scroll.is-dragging .comparison-table-product-link {
            pointer-events: none;
        }
        .comparison-table-scroll::-webkit-scrollbar {
            height: 8px;
        }
        .comparison-table-scroll.is-scrolling {
            scrollbar-color: var(--color-line) transparent;
        }
        .comparison-table-scroll::-webkit-scrollbar-track {
            background: transparent;
            border-radius: 4px;
        }
        .comparison-table-scroll::-webkit-scrollbar-thumb {
            background: var(--color-line);
            border-radius: 4px;
            opacity: 0;
            transition: opacity 0.25s ease-out;
        }
        .comparison-table-scroll.is-scrolling::-webkit-scrollbar-thumb {
            opacity: 1;
        }
        .comparison-table-scroll.is-scrolling::-webkit-scrollbar-thumb:hover {
            background: var(--color-line-strong);
        }
        .comparison-table-scroll:focus-visible {
            outline: 2px solid rgb(var(--color-foreground));
            outline-offset: -2px;
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.product-comparison-table.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer", "custom.overlay"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.product-comparison-table.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "t:sections.product-comparison-table.settings.section_heading",
            "default": "t:sections.product-comparison-table.defaults.heading"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "title-4xl",
                    "label": "t:settings.type_size.title_4xl"
                },
                {
                    "value": "title-3xl",
                    "label": "t:settings.type_size.title_3xl"
                },
                {
                    "value": "title-2xl",
                    "label": "t:settings.type_size.title_2xl"
                },
                {
                    "value": "title-xl",
                    "label": "t:settings.type_size.title_xl"
                },
                {
                    "value": "title-l",
                    "label": "t:settings.type_size.title_l"
                },
                {
                    "value": "title-m",
                    "label": "t:settings.type_size.title_m"
                },
                {
                    "value": "title-s",
                    "label": "t:settings.type_size.title_s"
                },
                {
                    "value": "title-xs",
                    "label": "t:settings.type_size.title_xs"
                }
            ],
            "default": "title-2xl"
        },
        {
            "type": "product_list",
            "id": "products",
            "label": "t:sections.product-comparison-table.settings.select_products",
            "limit": 8
        },
        {
            "type": "range",
            "id": "highlight_index",
            "min": 0,
            "max": 8,
            "step": 1,
            "default": 0,
            "label": "t:sections.product-comparison-table.settings.highlight_column_index",
            "info": "t:sections.product-comparison-table.info.1_first_product_column_0_no_highlight"
        },
        {
            "type": "header",
            "content": "t:sections.product-comparison-table.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.product-comparison-table.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.product-comparison-table.settings.padding_bottom",
            "default": 32
        }
    ],
    "blocks": [
        {
            "type": "header",
            "name": "t:sections.product-comparison-table.blocks.product_info",
            "limit": 1
        },
        {
            "type": "price",
            "name": "t:sections.product-comparison-table.blocks.price",
            "limit": 1
        },
        {
            "type": "rating",
            "name": "t:sections.product-comparison-table.blocks.rating",
            "limit": 1
        },
        {
            "type": "metafield_text",
            "name": "t:sections.product-comparison-table.blocks.ingredients_metafield",
            "settings": [
                {
                    "type": "inline_richtext",
                    "id": "row_title",
                    "label": "t:sections.product-comparison-table.block_settings.row_title",
                    "default": "t:sections.product-comparison-table.blocks_defaults.row_title"
                },
                {
                    "type": "text",
                    "id": "metafield_key",
                    "label": "t:sections.product-comparison-table.block_settings.metafield_key_namespace_key",
                    "default": "t:sections.product-comparison-table.blocks_defaults.metafield_key",
                    "info": "t:sections.product-comparison-table.block_info.e_g_custom_ingredients"
                }
            ]
        },
        {
            "type": "availability",
            "name": "t:sections.product-comparison-table.blocks.availability",
            "limit": 1
        }
    ],
    "presets": [
        {
            "name": "t:sections.product-comparison-table.presets.comparison_table",
            "blocks": [
                {
                    "type": "header"
                },
                {
                    "type": "price"
                },
                {
                    "type": "rating"
                },
                {
                    "type": "metafield_text"
                },
                {
                    "type": "availability"
                }
            ]
        }
    ]
}
{% endschema %}
