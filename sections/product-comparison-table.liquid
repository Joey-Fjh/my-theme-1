<section
    data-section-id="{{ section.id }}"
    class="product-comparison-table-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top | default: 0 }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
        --comparison-column-bg-color: {{ section.settings.comparison_column_bg_color | default: '#F4F1E8' }};
        --comparison-success-color: {{ section.settings.comparison_success_color | default: '#228E58' }};
        --comparison-danger-color: {{ section.settings.comparison_danger_color | default: '#E04A4A' }};
    "
    data-component-kind="section"
    data-component-type="product-comparison-table"
    data-component-id="{{ section.id }}"
    x-data="motionRevealSection()"
    data-motion-section
>
    <div
        class="layout container-page mx-auto pb-8"
        style="
            --comparison-table-width-mobile: {{ section.settings.products.size | times: 140 | plus: 116 }}px;
            --comparison-table-width-pc: {{ section.settings.products.size | times: 280 | plus: 156 }}px;
        "
    >
        {% if section.settings.heading != blank %}
            <h1 class="mb-10 text-center pc:mb-16" data-motion-reveal="content">
                {{ section.settings.heading }}
            </h1>
        {% endif %}
        {% if section.settings.products != blank and section.blocks.size > 0 %}
            <div
                class="comparison-table-scroll overflow-x-auto"
                data-motion-reveal="content"
                tabindex="0"
                role="group"
                aria-label="{{ 'accessibility.scroll_to_compare' | t }}"
                data-comparison-scroll
            >
                <table
                    class="comparison-table table-fixed border-collapse text-start"
                    role="grid"
                    aria-label="{{ 'accessibility.product_comparison' | t }}"
                >
                    <tbody>
                        {% for block in section.blocks %}
                            <tr {{ block.shopify_attributes }}>
                                {% comment %} Row header (first column) — frozen when horizontal scroll {% endcomment %}
                                <th
                                    scope="row"
                                    class="
                                        comparison-table__sticky-col
                                        comparison-table__row-header
                                        sticky left-0 z-10
                                        border border-theme-border/20 bg-theme-bg
                                        px-4 py-5 align-middle whitespace-normal shadow-[2px_0_6px_-2px_rgba(0,0,0,0.06)]
                                        pc:px-6 pc:py-7
                                    "
                                >
                                    {% case block.type %}
                                        {% when 'header' %}
                                            {{ 'products.comparison.product' | t }}
                                        {% when 'price' %}
                                            {{ 'products.comparison.price' | t }}
                                        {% when 'rating' %}
                                            {{ 'products.comparison.rating' | t }}
                                        {% when 'metafield_text' %}
                                            {{ block.settings.row_title | default: '—' }}
                                        {% when 'availability' %}
                                            {{ 'products.comparison.availability' | t }}
                                        {% else %}
                                            —
                                    {% endcase %}
                                </th>

                                {% comment %} Product data columns {% endcomment %}
                                {% for item in section.settings.products %}
                                    {% assign is_highlight = false %}
                                    {% if section.settings.highlight_index > 0
                                        and forloop.index == section.settings.highlight_index
                                    %}
                                        {% assign is_highlight = true %}
                                    {% endif %}
                                    <td
                                        class="
                                            comparison-table__product-cell
                                            border border-theme-border/20 p-3 align-middle pc:p-6
                                            {% if is_highlight %}bg-(--comparison-column-bg-color){% else %}bg-transparent{% endif %}
                                        "
                                    >
                                        {% case block.type %}
                                            {% when 'header' %}
                                                <a
                                                    href="{{ item.url }}"
                                                    class="comparison-table-product-link media-interaction flex w-full cursor-pointer flex-col items-center text-inherit no-underline"
                                                >
                                                    <div class="mb-4 flex h-44 w-full items-center justify-center pc:mb-6 pc:h-[260px]">
                                                        <div class="h-full w-full max-w-[76%] pc:max-w-[74%]">
                                                            {%- assign image_alt = item.featured_image.alt
                                                                | default: item.title
                                                            -%}
                                                            {%- render 'image',
                                                                image: item.featured_image,
                                                                width: 360,
                                                                aspect_ratio: '3/4',
                                                                wrapper: 'div',
                                                                class: 'w-full h-full',
                                                                img_class: 'image_img w-full h-full object-contain object-center',
                                                                alt: image_alt
                                                            -%}
                                                        </div>
                                                    </div>
                                                    <span class="block w-full text-center">
                                                        {{- item.title -}}
                                                    </span>
                                                </a>

                                            {% when 'price' %}
                                                <div class="flex flex-wrap items-baseline gap-2">
                                                    <span>
                                                        {{- item.price | money -}}
                                                    </span>
                                                    {% if item.compare_at_price != blank
                                                        and item.compare_at_price > item.price
                                                    %}
                                                        <span class="line-through">
                                                            {{- item.compare_at_price | money -}}
                                                        </span>
                                                    {% endif %}
                                                </div>

                                            {% when 'rating' %}
                                                <div class="comparison-table__rating inline-flex items-center gap-1 whitespace-nowrap">
                                                    {%- render 'starts',
                                                        rating: 4.5,
                                                        max: 5,
                                                        wrapper_class: 'mb-0 inline-flex items-center flex-none comparison-table__rating-stars'
                                                    -%}
                                                    <span class="comparison-table__rating-value shrink-0"
                                                        >4.5</span
                                                    >
                                                </div>

                                            {% when 'metafield_text' %}
                                                {% assign meta_key = block.settings.metafield_key
                                                    | strip
                                                %}
                                                {% if meta_key != '' %}
                                                    {% assign meta_parts = meta_key | split: '.' %}
                                                    {% assign meta_ns = meta_parts[0] %}
                                                    {% assign meta_key_name = meta_parts[1] %}
                                                    {% assign meta_val = item.metafields[meta_ns][meta_key_name] %}
                                                    <div>
                                                        {% if meta_val != blank
                                                            and meta_val.value != blank
                                                        %}
                                                            {{ meta_val.value }}
                                                        {% elsif meta_val != blank %}
                                                            {{ meta_val }}
                                                        {% else %}
                                                            —
                                                        {% endif %}
                                                    </div>
                                                {% else %}
                                                    <span>—</span>
                                                {% endif %}

                                            {% when 'availability' %}
                                                {% if item.available %}
                                                    <span class="text-(--comparison-success-color)">
                                                        {{- 'products.comparison.in_stock' | t -}}
                                                    </span>
                                                {% else %}
                                                    <span class="text-(--comparison-danger-color)">
                                                        {{-
                                                            'products.comparison.out_of_stock'
                                                            | t
                                                        -}}
                                                    </span>
                                                {% endif %}

                                            {% else %}
                                                <span>—</span>
                                        {% endcase %}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="py-12 text-center text-theme-text/60">
                <h4>{{ 'products.comparison.no_products' | t }}</h4>
                <p class="mt-2">{{ 'products.comparison.no_blocks' | t }}</p>
            </div>
        {% endif %}
    </div>
</section>

{%- javascript -%}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components) return;

        Components.register(
            'product-comparison-table',
            {
                init(el) {
                    const scrollEl = el.querySelector('[data-comparison-scroll]');
                    if (!scrollEl) return {};

                    var Events = window.__Theme__?.Events;
                    if (!Events?.createScope) return {};

                    var scope = Events.createScope({ target: window });
                    var timeoutRef = { id: null };
                    var showDelayMs = 1000;
                    var dragThresholdPx = 5;

                    function showScrollbar() {
                        scrollEl.classList.add('is-scrolling');
                        if (timeoutRef.id) clearTimeout(timeoutRef.id);
                        timeoutRef.id = setTimeout(function () {
                            scrollEl.classList.remove('is-scrolling');
                            timeoutRef.id = null;
                        }, showDelayMs);
                    }

                    function onScroll() {
                        showScrollbar();
                    }

                    scrollEl.addEventListener('scroll', onScroll, { passive: true });

                    var dragStartX = 0;
                    var dragStartScrollLeft = 0;
                    var isPointerDown = false;
                    var didDrag = false;

                    scope.on(
                        'mousemove',
                        function (e) {
                            if (!isPointerDown) return;
                            var dx = dragStartX - e.clientX;
                            scrollEl.scrollLeft = dragStartScrollLeft + dx;
                            if (Math.abs(e.clientX - dragStartX) >= dragThresholdPx) {
                                didDrag = true;
                                scrollEl.classList.add('is-dragging');
                                showScrollbar();
                            }
                        },
                        { passive: true },
                    );

                    scope.on('mouseup', function () {
                        isPointerDown = false;
                        scrollEl.classList.remove('is-dragging');
                        setTimeout(function () {
                            didDrag = false;
                        }, 0);
                    });

                    function onPointerDown(e) {
                        if (e.button !== 0) return;
                        isPointerDown = true;
                        didDrag = false;
                        dragStartX = e.clientX;
                        dragStartScrollLeft = scrollEl.scrollLeft;
                    }

                    scrollEl.addEventListener('mousedown', onPointerDown);

                    function onLinkClick(e) {
                        if (didDrag && e.target.closest('.comparison-table-product-link')) {
                            e.preventDefault();
                            e.stopPropagation();
                        }
                    }

                    scrollEl.addEventListener('click', onLinkClick, true);

                    return {
                        scope: scope,
                        scrollEl: scrollEl,
                        onScroll: onScroll,
                        timeoutRef: timeoutRef,
                        onPointerDown: onPointerDown,
                        onLinkClick: onLinkClick,
                    };
                },
                destroy(el, state) {
                    if (!state?.scrollEl) return;
                    state.scrollEl.removeEventListener('scroll', state.onScroll);
                    if (state.timeoutRef?.id) clearTimeout(state.timeoutRef.id);
                    state.scrollEl.removeEventListener('mousedown', state.onPointerDown);
                    state.scrollEl.removeEventListener('click', state.onLinkClick, true);
                    state?.scope?.dispose();
                },
            },
            { lazy: true },
        );
    })();
{%- endjavascript -%}

{% stylesheet %}
    .product-comparison-table-section {
        .comparison-table {
            width: var(--comparison-table-width-mobile);
            min-width: var(--comparison-table-width-mobile);
        }
        .comparison-table__row-header {
            width: 116px;
            min-width: 116px;
            max-width: 116px;
        }
        .comparison-table__product-cell {
            width: 140px;
            min-width: 140px;
            max-width: 140px;
            overflow-wrap: anywhere;
        }
        .comparison-table-product-link {
            min-width: 0;
        }
        .comparison-table tbody tr:first-child .comparison-table__row-header,
        .comparison-table tbody tr:first-child .comparison-table__product-cell {
            height: 250px;
        }
        .comparison-table__rating {
            max-width: 100%;
            line-height: 1;
        }
        .comparison-table__rating-stars {
            gap: 0.2rem;
            margin-bottom: 0;
            line-height: 1;
        }
        .comparison-table__rating .stars__icon {
            width: 1.35rem;
            height: 1.35rem;
        }
        .comparison-table__rating-value {
            line-height: 1;
        }
        @media (width >= 48rem) {
            .comparison-table {
                width: var(--comparison-table-width-pc);
                min-width: var(--comparison-table-width-pc);
            }
            .comparison-table__row-header {
                width: 156px;
                min-width: 156px;
                max-width: 156px;
            }
            .comparison-table__product-cell {
                width: 280px;
                min-width: 280px;
                max-width: 280px;
            }
            .comparison-table tbody tr:first-child .comparison-table__row-header,
            .comparison-table tbody tr:first-child .comparison-table__product-cell {
                height: 360px;
            }
            .comparison-table__rating {
                gap: 0.8rem;
            }
            .comparison-table__rating-stars {
                gap: 0.35rem;
            }
            .comparison-table__rating .stars__icon {
                width: 1.75rem;
                height: 1.75rem;
            }
        }
        .comparison-table-scroll {
            scrollbar-width: thin;
            scrollbar-color: transparent transparent;
            cursor: grab;
        }
        .comparison-table-scroll:active {
            cursor: grab;
        }
        .comparison-table-scroll.is-dragging {
            cursor: grabbing;
            user-select: none;
        }
        .comparison-table-scroll.is-dragging * {
            user-select: none;
            pointer-events: none;
        }
        .comparison-table-scroll .comparison-table-product-link {
            pointer-events: auto;
            cursor: pointer;
        }
        .comparison-table-scroll.is-dragging .comparison-table-product-link {
            pointer-events: none;
        }
        .comparison-table-scroll::-webkit-scrollbar {
            height: 8px;
        }
        .comparison-table-scroll.is-scrolling {
            scrollbar-color: rgba(var(--color-foreground), 0.25) transparent;
        }
        .comparison-table-scroll::-webkit-scrollbar-track {
            background: transparent;
            border-radius: 4px;
        }
        .comparison-table-scroll::-webkit-scrollbar-thumb {
            background: rgba(var(--color-foreground), 0.25);
            border-radius: 4px;
            opacity: 0;
            transition: opacity 0.25s ease-out;
        }
        .comparison-table-scroll.is-scrolling::-webkit-scrollbar-thumb {
            opacity: 1;
        }
        .comparison-table-scroll.is-scrolling::-webkit-scrollbar-thumb:hover {
            background: rgba(var(--color-foreground), 0.35);
        }
        .comparison-table-scroll:focus-visible {
            outline: 2px solid var(--color-theme-text);
            outline-offset: -2px;
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.product-comparison-table.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.product-comparison-table.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "t:sections.product-comparison-table.settings.section_heading",
            "default": "t:sections.product-comparison-table.defaults.heading"
        },
        {
            "type": "color",
            "id": "comparison_column_bg_color",
            "label": "t:sections.product-comparison-table.settings.highlight_column_background",
            "default": "#F4F1E8"
        },
        {
            "type": "color",
            "id": "comparison_success_color",
            "label": "t:sections.product-comparison-table.settings.availability_in_stock_color",
            "default": "#228E58"
        },
        {
            "type": "color",
            "id": "comparison_danger_color",
            "label": "t:sections.product-comparison-table.settings.availability_out_of_stock_color",
            "default": "#E04A4A"
        },
        {
            "type": "product_list",
            "id": "products",
            "label": "t:sections.product-comparison-table.settings.select_products",
            "limit": 8
        },
        {
            "type": "range",
            "id": "highlight_index",
            "min": 0,
            "max": 8,
            "step": 1,
            "default": 0,
            "label": "t:sections.product-comparison-table.settings.highlight_column_index",
            "info": "t:sections.product-comparison-table.info.1_first_product_column_0_no_highlight"
        },
        {
            "type": "header",
            "content": "t:sections.product-comparison-table.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.product-comparison-table.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.product-comparison-table.settings.padding_bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "header",
            "name": "t:sections.product-comparison-table.blocks.product_info",
            "limit": 1
        },
        {
            "type": "price",
            "name": "t:sections.product-comparison-table.blocks.price",
            "limit": 1
        },
        {
            "type": "rating",
            "name": "t:sections.product-comparison-table.blocks.rating",
            "limit": 1
        },
        {
            "type": "metafield_text",
            "name": "t:sections.product-comparison-table.blocks.ingredients_metafield",
            "settings": [
                {
                    "type": "inline_richtext",
                    "id": "row_title",
                    "label": "t:sections.product-comparison-table.block_settings.row_title",
                    "default": "t:sections.product-comparison-table.blocks_defaults.row_title"
                },
                {
                    "type": "text",
                    "id": "metafield_key",
                    "label": "t:sections.product-comparison-table.block_settings.metafield_key_namespace_key",
                    "default": "custom.ingredients",
                    "info": "t:sections.product-comparison-table.block_info.e_g_custom_ingredients"
                }
            ]
        },
        {
            "type": "availability",
            "name": "t:sections.product-comparison-table.blocks.availability",
            "limit": 1
        }
    ],
    "presets": [
        {
            "name": "t:sections.product-comparison-table.presets.comparison_table",
            "blocks": [
                {
                    "type": "header"
                },
                {
                    "type": "price"
                },
                {
                    "type": "rating"
                },
                {
                    "type": "metafield_text",
                    "settings": {
                        "row_title": "Ingredients",
                        "metafield_key": "custom.ingredients"
                    }
                },
                {
                    "type": "availability"
                }
            ]
        }
    ]
}
{% endschema %}
