<div
    data-section-id="{{ section.id }}"
    class="promotion-countdown-section full-width"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <div class="layout container-page">
        <div class="flex flex-col gap-6 text-center text-[#263D29]">
            <h3 class="opacity-80">
                {{ section.settings.sub_heading }}
            </h3>
            <h1 class="font-bold">
                {{ section.settings.heading }}
            </h1>
        </div>

        <div
            class="md:gap-4 mt-25 mb-8 flex items-center justify-center gap-2"
            x-data="countdownTimer('{{ section.settings.end_date }}')"
        >
            <!-- Days -->
            <div class="text-center">
                <div class="flex justify-center gap-1">
                    {% render 'flip-digit', value: 'days', length: 3, unit: 'day' %}
                </div>
                <span class="md:text-base mt-3 block text-sm text-gray-600">
                    {{- section.settings.days_label -}}
                </span>
            </div>

            <span class="md:mt-10 md:text-5xl mt-6 self-start text-3xl font-light text-gray-400"
                >:</span
            >

            <!-- Hours -->
            <div class="text-center">
                <div class="flex justify-center gap-1">
                    {% render 'flip-digit', value: 'hours', length: 2, unit: 'hour' %}
                </div>
                <span class="md:text-base mt-3 block text-sm text-gray-600">
                    {{- section.settings.hours_label -}}
                </span>
            </div>

            <span class="md:mt-10 md:text-5xl mt-6 self-start text-3xl font-light text-gray-400"
                >:</span
            >

            <!-- Minutes -->
            <div class="text-center">
                <div class="flex justify-center gap-1">
                    {% render 'flip-digit', value: 'minutes', length: 2, unit: 'minute' %}
                </div>
                <span class="md:text-base mt-3 block text-sm text-gray-600">
                    {{- section.settings.minutes_label -}}
                </span>
            </div>

            <span class="md:mt-10 md:text-5xl mt-6 self-start text-3xl font-light text-gray-400"
                >:</span
            >

            <!-- Seconds -->
            <div class="text-center">
                <div class="flex justify-center gap-1">
                    {% render 'flip-digit', value: 'seconds', length: 2, unit: 'second' %}
                </div>
                <span class="md:text-base mt-3 block text-sm text-gray-600">
                    {{- section.settings.seconds_label -}}
                </span>
            </div>
        </div>

        <!-- CTA Button -->
        {% if section.settings.show_cta %}
            {%- capture link_content -%}
                <span>{{ section.settings.cta_text }}</span>
                {% render 'icons', icon: 'icon-arrow2', size: 'lg', class: 'ml-3' %}
            {%- endcapture -%}

            {%- render 'link',
                class: 'justify-self-center text-black',
                href: section.settings.cta_link,
                content: link_content,
                variant: 'underline'
            -%}
        {% endif %}
    </div>
</div>

{% schema %}
{
    "name": "Promotion Countdown",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "inline_richtext",
            "id": "sub_heading",
            "label": "Sub Heading",
            "default": "Lorem Ipsum"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "Heading",
            "default": "Up To 50% Off Everything"
        },
        {
            "type": "text",
            "id": "end_date",
            "label": "End Date",
            "info": "Format: YYYY-MM-DD HH:MM:SS (e.g., 2026-12-31 23:59:59)",
            "default": "2026-12-31 23:59:59"
        },
        {
            "type": "text",
            "id": "days_label",
            "label": "Days Label",
            "default": "Days"
        },
        {
            "type": "text",
            "id": "hours_label",
            "label": "Hours Label",
            "default": "Hours"
        },
        {
            "type": "text",
            "id": "minutes_label",
            "label": "Minutes Label",
            "default": "Minutes"
        },
        {
            "type": "text",
            "id": "seconds_label",
            "label": "Seconds Label",
            "default": "Seconds"
        },
        {
            "type": "checkbox",
            "id": "show_cta",
            "label": "Show CTA Button",
            "default": true
        },
        {
            "type": "text",
            "id": "cta_text",
            "label": "CTA Text",
            "default": "Get Notification on Calendar"
        },
        {
            "type": "url",
            "id": "cta_link",
            "label": "CTA Link"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "Promotion Countdown",
            "settings": {}
        }
    ]
}
{% endschema %}
