{%- liquid
    assign promotion_countdown_heading_class = section.settings.heading_size | default: 'heading-2xl'
    assign promotion_countdown_subtitle_size = section.settings.subtitle_size | default: 'body-3xl'
    assign promotion_countdown_subtitle_class = 'typo-subtitle ' | append: promotion_countdown_subtitle_size
-%}

<div
    data-section-id="{{ section.id }}"
    class="promotion-countdown-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="motionRevealSection()"
    data-motion-section
>
    <div class="layout container-page" data-motion-sequence>
        <div class="flex flex-col gap-6 text-center" data-motion-reveal="content">
            <p class="{{ promotion_countdown_subtitle_class }}">
                {{ section.settings.sub_heading }}
            </p>
            <h2 class="{{ promotion_countdown_heading_class }}">
                {{ section.settings.heading }}
            </h2>
        </div>

        <div
            class="promotion-countdown-section__timer"
            data-countdown-end-date="{{ section.settings.end_date }}"
            x-data="countdownTimer()"
            data-motion-reveal="content"
        >
            <!-- Days -->
            <div class="promotion-countdown-section__unit text-center">
                <span class="sr-only">
                    <span x-text="days">0</span>
                    {{ section.settings.days_label }}
                </span>
                <div class="promotion-countdown-section__digits">
                    {% render 'flip-digit', value: 'days', length: 3, unit: 'day' %}
                </div>
                <span class="promotion-countdown-section__label" aria-hidden="true">
                    {{- section.settings.days_label -}}
                </span>
            </div>

            <span class="promotion-countdown-section__separator" aria-hidden="true">:</span>

            <!-- Hours -->
            <div class="promotion-countdown-section__unit text-center">
                <span class="sr-only">
                    <span x-text="hours">0</span>
                    {{ section.settings.hours_label }}
                </span>
                <div class="promotion-countdown-section__digits">
                    {% render 'flip-digit', value: 'hours', length: 2, unit: 'hour' %}
                </div>
                <span class="promotion-countdown-section__label" aria-hidden="true">
                    {{- section.settings.hours_label -}}
                </span>
            </div>

            <span class="promotion-countdown-section__separator" aria-hidden="true">:</span>

            <!-- Minutes -->
            <div class="promotion-countdown-section__unit text-center">
                <span class="sr-only">
                    <span x-text="minutes">0</span>
                    {{ section.settings.minutes_label }}
                </span>
                <div class="promotion-countdown-section__digits">
                    {% render 'flip-digit', value: 'minutes', length: 2, unit: 'minute' %}
                </div>
                <span class="promotion-countdown-section__label" aria-hidden="true">
                    {{- section.settings.minutes_label -}}
                </span>
            </div>

            <span class="promotion-countdown-section__separator" aria-hidden="true">:</span>

            <!-- Seconds -->
            <div class="promotion-countdown-section__unit text-center">
                <span class="sr-only">
                    <span x-text="seconds">0</span>
                    {{ section.settings.seconds_label }}
                </span>
                <div class="promotion-countdown-section__digits">
                    {% render 'flip-digit', value: 'seconds', length: 2, unit: 'second' %}
                </div>
                <span class="promotion-countdown-section__label" aria-hidden="true">
                    {{- section.settings.seconds_label -}}
                </span>
            </div>
        </div>

        <!-- CTA Button -->
        {% if section.settings.show_cta %}
            {%- capture link_content -%}
                <span>{{ section.settings.cta_text }}</span>
                {% render 'icons', icon: 'icon-arrow2', class: 'ms-3' %}
            {%- endcapture -%}

            <div class="justify-self-center" data-motion-reveal="content">
                {%- render 'link',
                    class: 'body-xl text-theme-text',
                    href: section.settings.cta_link,
                    content: link_content,
                    variant: 'underline'
                -%}
            </div>
        {% endif %}
    </div>
</div>

{% schema %}
{
    "name": "t:sections.promotion-countdown.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer", "custom.overlay"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.promotion-countdown.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.font"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.heading"
        },
        {
            "type": "select",
            "id": "heading_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "heading-4xl",
                    "label": "t:sections.slides-show.options.heading_4xl"
                },
                {
                    "value": "heading-3xl",
                    "label": "t:sections.slides-show.options.heading_3xl"
                },
                {
                    "value": "heading-2xl",
                    "label": "t:sections.slides-show.options.heading_2xl"
                },
                {
                    "value": "heading-xl",
                    "label": "t:sections.slides-show.options.heading_xl"
                },
                {
                    "value": "heading-h1",
                    "label": "t:sections.slides-show.options.heading_h1"
                },
                {
                    "value": "heading-h2",
                    "label": "t:sections.slides-show.options.heading_h2"
                },
                {
                    "value": "heading-h3",
                    "label": "t:sections.slides-show.options.heading_h3"
                },
                {
                    "value": "heading-h4",
                    "label": "t:sections.slides-show.options.heading_h4"
                },
                {
                    "value": "heading-h5",
                    "label": "t:sections.slides-show.options.heading_h5"
                },
                {
                    "value": "heading-h6",
                    "label": "t:sections.slides-show.options.heading_h6"
                }
            ],
            "default": "heading-2xl"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "t:sections.promotion-countdown.settings.heading",
            "default": "t:sections.promotion-countdown.defaults.heading"
        },
        {
            "type": "header",
            "content": "t:sections.scroll-categories.content.subtitle"
        },
        {
            "type": "select",
            "id": "subtitle_size",
            "label": "t:sections.scroll-categories.settings.subtitle_size",
            "options": [
                {
                    "value": "body-3xl",
                    "label": "t:sections.scroll-categories.options.body_3xl"
                },
                {
                    "value": "body-2xl",
                    "label": "t:sections.scroll-categories.options.body_2xl"
                },
                {
                    "value": "body-xl",
                    "label": "t:sections.scroll-categories.options.body_xl"
                },
                {
                    "value": "body-lg",
                    "label": "t:sections.scroll-categories.options.body_lg"
                },
                {
                    "value": "body-md",
                    "label": "t:sections.scroll-categories.options.body_md"
                },
                {
                    "value": "body-sm",
                    "label": "t:sections.scroll-categories.options.body_sm"
                }
            ],
            "default": "body-3xl"
        },
        {
            "type": "inline_richtext",
            "id": "sub_heading",
            "label": "t:sections.promotion-countdown.settings.sub_heading",
            "default": "t:sections.promotion-countdown.defaults.sub_heading"
        },
        {
            "type": "text",
            "id": "end_date",
            "label": "t:sections.promotion-countdown.settings.end_date",
            "info": "t:sections.promotion-countdown.info.format_yyyy_mm_dd_hh_mm_ss_e_g_2026_12_3",
            "default": "2026-12-31 23:59:59"
        },
        {
            "type": "text",
            "id": "days_label",
            "label": "t:sections.promotion-countdown.settings.days_label",
            "default": "t:sections.promotion-countdown.defaults.days_label"
        },
        {
            "type": "text",
            "id": "hours_label",
            "label": "t:sections.promotion-countdown.settings.hours_label",
            "default": "t:sections.promotion-countdown.defaults.hours_label"
        },
        {
            "type": "text",
            "id": "minutes_label",
            "label": "t:sections.promotion-countdown.settings.minutes_label",
            "default": "t:sections.promotion-countdown.defaults.minutes_label"
        },
        {
            "type": "text",
            "id": "seconds_label",
            "label": "t:sections.promotion-countdown.settings.seconds_label",
            "default": "t:sections.promotion-countdown.defaults.seconds_label"
        },
        {
            "type": "checkbox",
            "id": "show_cta",
            "label": "t:sections.promotion-countdown.settings.show_cta_button",
            "default": true
        },
        {
            "type": "text",
            "id": "cta_text",
            "label": "t:sections.promotion-countdown.settings.cta_text",
            "default": "t:sections.promotion-countdown.defaults.cta_text"
        },
        {
            "type": "url",
            "id": "cta_link",
            "label": "t:sections.promotion-countdown.settings.cta_link"
        },
        {
            "type": "header",
            "content": "t:sections.promotion-countdown.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.promotion-countdown.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.promotion-countdown.settings.padding_bottom",
            "default": 32
        }
    ],
    "presets": [
        {
            "name": "t:sections.promotion-countdown.presets.promotion_countdown",
            "settings": {}
        }
    ]
}
{% endschema %}
