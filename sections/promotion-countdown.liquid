{%- liquid
    assign promotion_countdown_heading_class = section.settings.heading_size | default: 'heading-2xl'
    assign promotion_countdown_subtitle_size = section.settings.subtitle_size | default: 'body-3xl'
-%}

{%- capture promotion_countdown_children -%}
    <div class="flex flex-col items-center gap-25">
        <div class="flex flex-col gap-6 text-center">
            {% render 'text',
                tier: promotion_countdown_subtitle_size,
                subtitle: true,
                align: 'center',
                content: section.settings.sub_heading,
            %}
            {% render 'heading',
                level: '2',
                tier: promotion_countdown_heading_class,
                align: 'center',
                content: section.settings.heading,
            %}
        </div>

        <div class="flex w-full flex-col items-center gap-16 pc:gap-20{% unless section.settings.show_cta %} pb-16 pc:pb-20{% endunless %}">
        <div
            class="promotion-countdown-section__timer"
            data-countdown-end-date="{{ section.settings.end_date }}"
            data-module-id="countdown-timer"
            x-data="countdownTimer()"
        >
            <!-- Days -->
            <div class="promotion-countdown-section__unit text-center">
                <span class="sr-only">
                    <span x-text="days">0</span>
                    {{ section.settings.days_label }}
                </span>
                <div class="promotion-countdown-section__digits body-size-custom">
                    {% render 'flip-digit', value: 'days', length: 3, unit: 'day' %}
                </div>
                <span class="promotion-countdown-section__label" aria-hidden="true">
                    {{- section.settings.days_label -}}
                </span>
            </div>

            <span class="promotion-countdown-section__separator" aria-hidden="true">:</span>

            <!-- Hours -->
            <div class="promotion-countdown-section__unit text-center">
                <span class="sr-only">
                    <span x-text="hours">0</span>
                    {{ section.settings.hours_label }}
                </span>
                <div class="promotion-countdown-section__digits body-size-custom">
                    {% render 'flip-digit', value: 'hours', length: 2, unit: 'hour' %}
                </div>
                <span class="promotion-countdown-section__label" aria-hidden="true">
                    {{- section.settings.hours_label -}}
                </span>
            </div>

            <span class="promotion-countdown-section__separator" aria-hidden="true">:</span>

            <!-- Minutes -->
            <div class="promotion-countdown-section__unit text-center">
                <span class="sr-only">
                    <span x-text="minutes">0</span>
                    {{ section.settings.minutes_label }}
                </span>
                <div class="promotion-countdown-section__digits body-size-custom">
                    {% render 'flip-digit', value: 'minutes', length: 2, unit: 'minute' %}
                </div>
                <span class="promotion-countdown-section__label" aria-hidden="true">
                    {{- section.settings.minutes_label -}}
                </span>
            </div>

            <span class="promotion-countdown-section__separator" aria-hidden="true">:</span>

            <!-- Seconds -->
            <div class="promotion-countdown-section__unit text-center">
                <span class="sr-only">
                    <span x-text="seconds">0</span>
                    {{ section.settings.seconds_label }}
                </span>
                <div class="promotion-countdown-section__digits body-size-custom">
                    {% render 'flip-digit', value: 'seconds', length: 2, unit: 'second' %}
                </div>
                <span class="promotion-countdown-section__label" aria-hidden="true">
                    {{- section.settings.seconds_label -}}
                </span>
            </div>
        </div>

        <!-- CTA Button -->
        {% if section.settings.show_cta %}
            {%- capture link_content -%}
                <span>{{ section.settings.cta_text }}</span>
                {% render 'icons', icon: 'icon-arrow2', class: 'ms-3' %}
            {%- endcapture -%}

            <div class="justify-self-center">
                <div>
                    {%- render 'link',
                        class: 'body-xl text-theme-text',
                        href: section.settings.cta_link,
                        content: link_content,
                        variant: 'underline'
                    -%}
                </div>
            </div>
        {% endif %}
        </div>
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: 'promotion-countdown-section',
    motion: false,
    children: promotion_countdown_children
%}

{% stylesheet %}
    @layer snippets {
        .promotion-countdown-section__timer {
            --body-size-custom: 36px;
            --body-size-custom-pc: 120px;
            --promotion-countdown-size: var(--body-size-custom);
            --promotion-countdown-digit-width-ratio: 0.72;
            --promotion-countdown-tile-scale: 1.14;
            --promotion-countdown-digit-font-ratio: 0.8;
            display: flex;
            max-width: 100%;
            align-items: flex-start;
            justify-content: center;
            gap: calc(var(--promotion-countdown-size) * 0.22);
            @media (width >= 48rem) {
                --promotion-countdown-size: var(--body-size-custom-pc);
                gap: calc(var(--promotion-countdown-size) * 0.28);
            }
        }
        .promotion-countdown-section__unit {
            display: flex;
            flex-direction: column;
            gap: calc(var(--spacing) * 3);
        }

        .promotion-countdown-section__label {
            display: block;
            white-space: nowrap;
            color: rgb(var(--color-foreground));
            @supports (color: color-mix(in lab, red, red)) {
                color: color-mix(in oklab, rgb(var(--color-foreground)) 80%, transparent);
            }
        }

        .promotion-countdown-section__digits {
            --promotion-countdown-digit-gap: 0.08em;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: calc(1em * var(--promotion-countdown-tile-scale));
            gap: var(--promotion-countdown-digit-gap);
        }

        @media (width >= 48rem) {
            .promotion-countdown-section__digits {
                --promotion-countdown-digit-gap: 0.1em;
            }
        }

        .promotion-countdown-section__digits .flip-digit {
            height: calc(1em * var(--promotion-countdown-tile-scale));
            width: calc(
                1em * var(--promotion-countdown-tile-scale) *
                    var(--promotion-countdown-digit-width-ratio)
            );
            font-size: inherit;
        }

        .promotion-countdown-section__digits .flip-digit__value {
            line-height: 100%;
            font-weight: var(--font-weight-bold);
            color: rgb(var(--color-background));
            --flip-digit-font-ratio: var(--promotion-countdown-digit-font-ratio);
            font-size: calc(var(--font-body-scale) * var(--flip-digit-font-ratio) * 1em);
        }

        .promotion-countdown-section__separator {
            display: flex;
            flex-shrink: 0;
            align-items: center;
            justify-content: center;
            line-height: 100%;
            color: rgb(var(--color-foreground));
            height: calc(
                var(--promotion-countdown-size) * var(--font-body-scale) *
                    var(--promotion-countdown-tile-scale)
            );
            font-size: calc(var(--promotion-countdown-size) * 0.22 * var(--font-body-scale));
            padding-inline: calc(var(--promotion-countdown-size) * 0.02);
        }

        @supports (color: color-mix(in lab, red, red)) {
            .promotion-countdown-section__separator {
                color: color-mix(in oklab, rgb(var(--color-foreground)) 80%, transparent);
            }
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.promotion-countdown.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer", "custom.overlay"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
