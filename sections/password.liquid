<main
    class="password-section full-width color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <div class="layout container-page h-full">
        <div class="mx-auto flex h-full w-full max-w-2xl flex-col items-center justify-center py-16 text-center pc:py-24">
            <h1 class="heading-2xl">
                {%- if section.settings.heading != blank -%}
                    {{ section.settings.heading }}
                {%- else -%}
                    {{ 'password.title' | t }}
                {%- endif -%}
            </h1>

            {%- if section.settings.message != blank -%}
                <div class="mt-5">
                    {{ section.settings.message }}
                </div>
            {%- elsif shop.password_message != blank -%}
                <div class="mt-5">
                    {{ shop.password_message }}
                </div>
            {%- endif -%}

            {%- assign email_placeholder_fallback = 'newsletter.email_placeholder' | t -%}
            {% form 'customer', class: 'mt-8 w-full text-left' %}
                <input type="hidden" name="customer[accepts_marketing]" value="true">
                <input type="hidden" name="customer[tags]" value="newsletter">

                {%- if form.posted_successfully? -%}
                    <p
                        class="password-section__status mb-4 border border-theme-border/20 px-4 py-3 body-sm text-theme-text"
                        role="status"
                    >
                        {{ 'newsletter.success_message' | t }}
                    </p>
                {%- elsif form.errors -%}
                    <div
                        class="password-section__status mb-4 border border-theme-border/20 px-4 py-3 body-sm text-theme-text"
                        role="alert"
                    >
                        {{ form.errors | default_errors }}
                    </div>
                {%- endif -%}

                <label class="sr-only" for="password-email-{{ section.id }}">
                    {{ 'newsletter.email_address' | t }}
                </label>

                <div class="password-section__field-group flex flex-col gap-3 pc:grid pc:grid-cols-[minmax(0,1fr)_auto] pc:gap-0">
                    <input
                        class="password-section__field field min-w-0 flex-1"
                        type="email"
                        name="customer[email]"
                        id="password-email-{{ section.id }}"
                        placeholder="{{ section.settings.placeholder | default: email_placeholder_fallback | escape }}"
                        autocomplete="email"
                        required
                    >

                    <button
                        class="password-section__submit btn-primary shrink-0 tracking-[0.14em] uppercase pc:min-w-40"
                        type="submit"
                    >
                        {{ 'newsletter.subscribe' | t }}
                    </button>
                </div>
            {% endform %}
        </div>
    </div>
</main>

{% stylesheet %}
    .password-layout > .shopify-section:has(.password-section) {
        display: flex;
        flex: 1;
    }

    .password-layout > .shopify-section:has(.password-section) > .password-section {
        flex: 1;
    }

    .password-section__status {
        border-radius: 0.75rem;
    }

    .password-section__status ul {
        list-style: disc;
        padding-left: 1.25rem;
    }

    @media (width >= 48rem) {
        .password-section__field {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

        .password-section__submit {
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:general.password",
    "tag": "section",
    "class": "section",
    "limit": 1,
    "enabled_on": {
        "templates": ["password"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.password.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "t:sections.password.settings.heading",
            "default": "t:sections.password.defaults.heading"
        },
        {
            "type": "richtext",
            "id": "message",
            "label": "t:sections.password.settings.message",
            "default": "t:sections.password.defaults.message"
        },
        {
            "type": "text",
            "id": "placeholder",
            "label": "t:sections.password.settings.placeholder",
            "default": "t:sections.password.defaults.placeholder"
        },
        {
            "type": "header",
            "content": "t:sections.password.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "t:sections.password.settings.padding_top",
            "default": 120
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "t:sections.password.settings.padding_bottom",
            "default": 120
        }
    ]
}
{% endschema %}
