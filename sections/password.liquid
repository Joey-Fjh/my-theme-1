{%- capture password_children -%}
    <div class="mx-auto flex h-full w-full flex-col items-center justify-center py-step-2xl text-center tablet:max-w-1/2 tablet:py-step-3xl">
        <h1 class="title-2xl">
            {%- if section.settings.heading != blank -%}
                {{ section.settings.heading }}
            {%- else -%}
                {{ 'password.title' | t }}
            {%- endif -%}
        </h1>

        {%- if section.settings.message != blank -%}
            <div class="rte rte--compact mt-step-m">
                {{ section.settings.message }}
            </div>
        {%- elsif shop.password_message != blank -%}
            <div class="mt-step-m">
                {{ shop.password_message }}
            </div>
        {%- endif -%}

        {%- assign email_placeholder_fallback = 'newsletter.email_placeholder' | t -%}
        {% form 'customer', class: 'mt-step-l w-full text-start', data-shopify-captcha: 'true' %}
            <input type="hidden" name="contact[tags]" value="newsletter">

            {%- if form.posted_successfully? -%}
                <p
                    class="password-section__status mb-step-s border border-line px-step-s py-step-xs copy-s text-theme-text"
                    role="status"
                >
                    {{ 'newsletter.success_message' | t }}
                </p>
            {%- elsif form.errors -%}
                <div
                    class="password-section__status mb-step-s border border-line px-step-s py-step-xs copy-s text-theme-text"
                    role="alert"
                >
                    {{ form.errors | default_errors }}
                </div>
            {%- endif -%}

            <label class="sr-only" for="password-email-{{ section.id }}">
                {{ 'newsletter.email_address' | t }}
            </label>

            <div class="password-section__field-group inline-submit-field">
                <input
                    class="password-section__field inline-submit-field__input"
                    type="email"
                    name="contact[email]"
                    id="password-email-{{ section.id }}"
                    placeholder="{{ section.settings.placeholder | default: email_placeholder_fallback | escape }}"
                    autocomplete="email"
                    required
                >

                <button
                    class="password-section__submit inline-submit-field__button typo-subtitle uppercase tablet:min-w-40"
                    type="submit"
                >
                    {{ 'newsletter.subscribe' | t }}
                </button>
            </div>
        {% endform %}
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    element: 'main',
    section_class: 'password-section',
    width: 'page',
    height_kind: 'content',
    inner_class: 'h-full',
    root_attrs: 'id="MainContent" tabindex="-1"',
    children: password_children
%}

{% stylesheet %}
    .shopify-section:has(.password-section) {
        display: flex;
        flex: 1;
    }

    .shopify-section:has(.password-section) > .password-section {
        flex: 1;
    }

    .password-section__status {
        border-radius: 0.75rem;
    }

    .password-section__status ul {
        list-style: disc;
        padding-inline-start: 1.25rem;
    }

    @media (width >= 48rem) {
        .password-section__field {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

        .password-section__submit {
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:general.password",
    "tag": "section",
    "class": "section",
    "limit": 1,
    "enabled_on": {
        "templates": ["password"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.password.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "t:sections.password.settings.heading",
            "default": "t:sections.password.defaults.heading"
        },
        {
            "type": "richtext",
            "id": "message",
            "label": "t:sections.password.settings.message",
            "default": "t:sections.password.defaults.message"
        },
        {
            "type": "text",
            "id": "placeholder",
            "label": "t:sections.password.settings.placeholder",
            "default": "t:sections.password.defaults.placeholder"
        },
        {
            "type": "header",
            "content": "t:sections.password.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "t:sections.password.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "t:sections.password.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
