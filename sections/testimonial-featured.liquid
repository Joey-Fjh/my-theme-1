<div
    data-section-id="{{ section.id }}"
    class="testimonial-featured-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="testimonial-featured"
    data-component-id="{{ section.id }}"
    data-auto-slide="{{ section.settings.is_auto_slide }}"
    data-slide-delay="{{ section.settings.slide_delay }}"
    x-data="motionRevealSection()"
    data-motion-section
>
    <div class="layout container-page pc:h-full">
        <div class="flex flex-col gap-12 pc:h-screen pc:flex-row pc:gap-0">
            {% comment %} Left - Testimonial {% endcomment %}
            <div class="swiper w-full flex-1 pc:h-full pc:w-1/2">
                <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                        {%- liquid
                            assign testimonial_author_name = block.settings.author_name
                            if testimonial_author_name == blank
                                assign testimonial_author_name = 'testimonial.defaults.author_name' | t
                            endif

                            assign testimonial_author_title = block.settings.author_title
                            if testimonial_author_title == blank
                                assign testimonial_author_title = 'testimonial.defaults.author_title' | t
                            endif
                        -%}
                        <div class="swiper-slide h-auto pc:h-full" {{ block.shopify_attributes }}>
                            <div
                                class="
                                    flex flex-1 flex-col items-center justify-center
                                    py-16 text-center pc:h-full pc:py-0
                                "
                            >
                                <div
                                    class="flex w-full flex-col items-center gap-10 pc:gap-24"
                                    {% if forloop.first %}
                                        data-motion-reveal="content"
                                    {% endif %}
                                >
                                    {% render 'starts', rating: block.settings.rating, size: 'lg' %}

                                    <blockquote
                                        class="rte rte--compact max-w-[90%] body-3xl pc:max-w-[60%]"
                                    >
                                        {{ block.settings.quote }}
                                    </blockquote>

                                    <div class="flex flex-col gap-3">
                                        <p class="body-3xl font-bold">
                                            {{ testimonial_author_name }}
                                        </p>
                                        <p>
                                            {{ testimonial_author_title }}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {% comment %} Right - Image  {% endcomment %}
            <div class="relative flex-1 pc:w-1/2" data-motion-bound>
                {% render 'image',
                    class: 'h-full w-full',
                    image: section.settings.image,
                    placeholder_key: 'lifestyle-2',
                    alt: section.settings.image.alt,
                    width: section.settings.image.width,
                    mode: 'frame',
                    fit: 'cover'
                %}

                {% comment %} Floating Card {% endcomment %}
                {% if section.settings.show_floating_card %}
                    <div
                        class="absolute inset-x-0 bottom-8 mx-auto w-[90%]"
                        data-motion-copy-bound
                    >
                        <div class="w-full bg-theme-bg p-6 italic" data-motion-copy>
                            <p class="mb-3">
                                {{ section.settings.card_label }}
                            </p>
                            <p class="body-3xl font-bold">
                                {{ section.settings.card_title }}
                            </p>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{% javascript %}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components) return;

        Components.register(
            'testimonial-featured',
            {
                init(el) {
                    const slides = el.querySelectorAll('.swiper-slide');
                    const autoSlide = el.getAttribute('data-auto-slide') === 'true';
                    const slideDelay = parseInt(el.getAttribute('data-slide-delay'), 10) || 5;
                    const Utils = window.__Theme__?.Utils;
                    const prefersReducedMotion =
                        typeof Utils?.prefersReducedMotion === 'function'
                            ? Utils.prefersReducedMotion()
                            : window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches ===
                              true;
                    const autoplayAllowed =
                        autoSlide &&
                        document.body?.dataset?.motionEnabled !== 'false' &&
                        !prefersReducedMotion;

                    const swiperContainer = el.querySelector('.swiper');

                    if (!swiperContainer || typeof Swiper === 'undefined') return;

                    const swiper = new Swiper(swiperContainer, {
                        loop: slides.length > 1,
                        autoHeight: true,
                        autoplay: autoplayAllowed
                            ? {
                                  delay: slideDelay * 1000,
                                  disableOnInteraction: false,
                              }
                            : false,
                        slidesPerView: 1,
                        effect: 'fade',
                        fadeEffect: {
                            crossFade: true,
                        },
                        pagination: false,
                        navigation: false,
                    });

                    return { swiper };
                },

                destroy(el, state) {
                    if (!state || !state.swiper) return;

                    if (typeof state.swiper.destroy === 'function') {
                        state.swiper.destroy(true, true);
                    }
                },
            },
            { lazy: true },
        );
    })();
{% endjavascript %}

{% schema %}
{
    "name": "t:sections.testimonial-featured.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.testimonial-featured.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:sections.testimonial-featured.settings.image"
        },
        {
            "type": "header",
            "content": "t:sections.testimonial-featured.content.floating_card"
        },
        {
            "type": "checkbox",
            "id": "show_floating_card",
            "label": "t:sections.testimonial-featured.settings.show_floating_card",
            "default": true
        },
        {
            "type": "inline_richtext",
            "id": "card_label",
            "label": "t:sections.testimonial-featured.settings.card_label",
            "default": "t:sections.testimonial-featured.defaults.card_label"
        },
        {
            "type": "inline_richtext",
            "id": "card_title",
            "label": "t:sections.testimonial-featured.settings.card_title",
            "default": "t:sections.testimonial-featured.defaults.card_title"
        },
        {
            "type": "header",
            "content": "t:sections.testimonial-featured.content.slide_setting"
        },
        {
            "type": "checkbox",
            "id": "is_auto_slide",
            "label": "t:sections.testimonial-featured.settings.auto_slide",
            "default": true
        },
        {
            "type": "range",
            "id": "slide_delay",
            "min": 3,
            "max": 10,
            "step": 1,
            "unit": "s",
            "label": "t:sections.testimonial-featured.settings.slide_delay",
            "default": 5
        },
        {
            "type": "header",
            "content": "t:sections.testimonial-featured.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.testimonial-featured.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.testimonial-featured.settings.padding_bottom",
            "default": 32
        }
    ],
    "blocks": [
        {
            "type": "testimonial",
            "name": "t:sections.testimonial-featured.blocks.testimonial",
            "settings": [
                {
                    "type": "range",
                    "id": "rating",
                    "label": "t:sections.testimonial-featured.block_settings.star_rating",
                    "min": 1,
                    "max": 5,
                    "step": 1,
                    "default": 5
                },
                {
                    "type": "richtext",
                    "id": "quote",
                    "label": "t:sections.testimonial-featured.block_settings.quote",
                    "default": "t:sections.testimonial-featured.defaults.quote"
                },
                {
                    "type": "inline_richtext",
                    "id": "author_name",
                    "label": "t:sections.testimonial-featured.block_settings.author_name",
                    "default": "t:sections.testimonial-featured.defaults.author_name"
                },
                {
                    "type": "inline_richtext",
                    "id": "author_title",
                    "label": "t:sections.testimonial-featured.block_settings.author_title",
                    "default": "t:sections.testimonial-featured.defaults.author_title"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.testimonial-featured.presets.testimonial_featured",
            "blocks": [
                {
                    "type": "testimonial"
                }
            ]
        }
    ]
}
{% endschema %}
