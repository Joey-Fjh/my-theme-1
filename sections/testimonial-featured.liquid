<div
    data-section-id="{{ section.id }}"
    class="testimonial-featured-section full-width h-screen"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-component-kind="section"
    data-component-type="testimonial-featured"
    data-component-id="{{ section.id }}"
    data-auto-slide="{{ section.settings.is_auto_slide }}"
    data-slide-delay="{{ section.settings.slide_delay }}"
>
    <div class="layout container-page">
        <div class="pc:flex-row flex flex-col">
            {% comment %} Left - Testimonial {% endcomment %}
            <div class="swiper flex-1 text-[#263D29]">
                <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                        <div class="swiper-slide" {{ block.shopify_attributes }}>
                            <div
                                class="
                                    flex h-full flex-1 flex-col items-center justify-center
                                    gap-30 text-center
                                "
                            >
                                {% render 'starts', rating: block.settings.rating, size: 'lg' %}

                                <blockquote
                                    class="h2 max-w-[50%] leading-relaxed"
                                >
                                    {{ block.settings.quote }}
                                </blockquote>

                                <div class="flex flex-col gap-3">
                                    <p
                                        class="text-3xl font-bold"
                                    >
                                        {{
                                            block.settings.author_name
                                            | default: 'Alexandria Maria'
                                        }}
                                    </p>
                                    <p
                                        class="text-xl opacity-80"
                                    >
                                        {{
                                            block.settings.author_title
                                            | default: 'Beauty Influencer'
                                        }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {% comment %} Right - Image  {% endcomment %}
            <div class="relative flex-1 text-[#111111]">
                {% render 'image',
                    class: '!h-auto',
                    image: section.settings.image,
                    alt: section.settings.image.alt,
                    width: section.settings.image.width
                %}

                {% comment %} Floating Card {% endcomment %}
                {% if section.settings.show_floating_card %}
                    <div
                        class="absolute bottom-8 w-[90%] justify-self-center bg-white p-6 italic shadow-lg"
                    >
                        <p class="mb-3 text-xl opacity-80">
                            {{ section.settings.card_label }}
                        </p>
                        <p class="text-3xl font-bold">
                            {{ section.settings.card_title }}
                        </p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{% javascript %}
    (function () {
        const Components = window.__Theme__?.Components;
        if (!Components) return;

        Components.register(
            'testimonial-featured',
            {
                init(el) {
                    const slides = el.querySelectorAll('.swiper-slide');
                    const autoSlide = el.getAttribute('data-auto-slide') === 'true';
                    const slideDelay = parseInt(el.getAttribute('data-slide-delay'), 10) || 5;

                    const swiperContainer = el.querySelector('.swiper');

                    if (!swiperContainer || typeof Swiper === 'undefined') return;

                    const swiper = new Swiper(swiperContainer, {
                        loop: slides.length > 1,
                        autoplay: autoSlide
                            ? {
                                  delay: slideDelay * 1000,
                                  disableOnInteraction: false,
                              }
                            : false,
                        slidesPerView: 1,
                        effect: 'fade',
                        fadeEffect: {
                            crossFade: true,
                        },
                        pagination: false,
                        navigation: false,
                    });

                    return { swiper };
                },

                destroy(el, state) {
                    if (!state || !state.swiper) return;

                    if (typeof state.swiper.destroy === 'function') {
                        state.swiper.destroy(true, true);
                    }
                },
            },
            { lazy: true },
        );
    })();
{% endjavascript %}

{% schema %}
{
    "name": "Testimonial Featured",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "header",
            "content": "Floating Card"
        },
        {
            "type": "checkbox",
            "id": "show_floating_card",
            "label": "Show Floating Card",
            "default": true
        },
        {
            "type": "inline_richtext",
            "id": "card_label",
            "label": "Card Label",
            "default": "Recent Purchased"
        },
        {
            "type": "inline_richtext",
            "id": "card_title",
            "label": "Card Title",
            "default": "Skincare Momonies"
        },
        {
            "type": "header",
            "content": "Slide Setting"
        },
        {
            "type": "checkbox",
            "id": "is_auto_slide",
            "label": "Auto Slide",
            "default": true
        },
        {
            "type": "range",
            "id": "slide_delay",
            "min": 3,
            "max": 10,
            "step": 1,
            "unit": "s",
            "label": "Slide Delay",
            "default": 5
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "testimonial",
            "name": "Testimonial",
            "settings": [
                {
                    "type": "range",
                    "id": "rating",
                    "label": "Star Rating",
                    "min": 1,
                    "max": 5,
                    "step": 1,
                    "default": 5
                },
                {
                    "type": "richtext",
                    "id": "quote",
                    "label": "Quote",
                    "default": "<p>Using this software has transformed my workflow! The AI insights are incredibly personalized, making my tasks easier and more efficient. I can't imagine going back to the old way of doing things!</p>"
                },
                {
                    "type": "inline_richtext",
                    "id": "author_name",
                    "label": "Author Name",
                    "default": "Alexandria Maria"
                },
                {
                    "type": "inline_richtext",
                    "id": "author_title",
                    "label": "Author Title",
                    "default": "Beauty Influencer"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Testimonial Featured"
        }
    ]
}
{% endschema %}
