{% comment %}
    This section is used in the page template to render store pages like About us
    or Contact us.
{% endcomment %}
{%- capture page_children -%}
    <div class="mx-auto flex w-full max-w-2/3 flex-col gap-8">
        {%- capture page_title_content -%}{{ page.title | escape }}{%- endcapture -%}
        {% render 'heading',
            level: '1',
            tier: 'heading-h1',
            content: page_title_content,
            motion_attrs: 'data-motion-critical'
        %}
        {% render 'text', element: 'div', class: 'rte w-full', content: page.content, motion_reveal: false %}
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: 'page-section',
    width: 'page',
    height_kind: 'content',
    motion: true,
    children: page_children
%}

{% schema %}
{
    "name": "t:general.page",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["page"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.page.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.page.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.page.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.page.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
