<div
    data-section-id="{{ section.id }}"
    class="custom-liquid-section full-width color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    {%- liquid
        assign wrapper_class = 'layout container-page bg-theme-bg text-theme-text'
        if section.settings.section_width == 'full'
            assign wrapper_class = 'bg-theme-bg text-theme-text'
        endif
    -%}

    <div class="{{ wrapper_class }}">
        <div class="w-full px-4 pc:px-0">
            {{ section.settings.custom_liquid }}
        </div>
    </div>
</div>

{% schema %}
{
    "name": "Custom Liquid",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "paragraph",
            "content": "[Learn how to use this section](https://shopify.dev/docs/storefronts/themes/store/requirements)"
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "scheme-1"
        },
        {
            "type": "select",
            "id": "section_width",
            "label": "Section width",
            "options": [
                { "value": "fixed", "label": "Fixed width" },
                { "value": "full", "label": "Full width" }
            ],
            "default": "fixed"
        },
        {
            "type": "liquid",
            "id": "custom_liquid",
            "label": "Custom liquid",
            "default": "<div class=\"rte\"><p>Use this section to add app snippets, custom markup, or theme-aware Liquid content.</p></div>"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "Custom Liquid",
            "settings": {
                "section_width": "fixed"
            }
        }
    ]
}
{% endschema %}
