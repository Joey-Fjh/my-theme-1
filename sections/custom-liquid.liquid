{%- liquid
    assign custom_liquid_width = 'page'
    if section.settings.section_width == 'full'
        assign custom_liquid_width = 'full'
    endif
-%}
{%- capture custom_liquid_children -%}
    <div class="w-full px-4 pc:px-0">
        {{ section.settings.custom_liquid }}
    </div>
{%- endcapture -%}

{% render 'section-frame',
    section: section,
    section_class: 'custom-liquid-section',
    width: custom_liquid_width,
    motion: false,
    children: custom_liquid_children
%}

{% schema %}
{
    "name": "t:sections.custom-liquid.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer", "custom.overlay"]
    },
    "settings": [
        {
            "type": "paragraph",
            "content": "t:sections.custom-liquid.content.learn_how_to_use_this_section_https_shop"
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.custom-liquid.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "select",
            "id": "section_width",
            "label": "t:sections.custom-liquid.settings.section_width",
            "options": [
                {
                    "value": "fixed",
                    "label": "t:sections.custom-liquid.options.fixed_width"
                },
                {
                    "value": "full",
                    "label": "t:sections.custom-liquid.options.full_width"
                }
            ],
            "default": "fixed"
        },
        {
            "type": "liquid",
            "id": "custom_liquid",
            "label": "t:sections.custom-liquid.settings.custom_liquid",
            "default": "t:sections.custom-liquid.defaults.custom_liquid"
        },
        {
            "type": "header",
            "content": "t:sections.custom-liquid.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.custom-liquid.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.custom-liquid.settings.padding_bottom",
            "default": 32
        }
    ],
    "presets": [
        {
            "name": "t:sections.custom-liquid.presets.custom_liquid"
        }
    ]
}
{% endschema %}
