{%- assign popup_id = 'cart-overlay-drawer' -%}
{%- capture cart_unit_prices_json -%}
    {
    {%- assign cart_unit_price_map_first = true -%}
    {%- for item in cart.items -%}
        {%- if item.unit_price_measurement -%}
            {%- unless cart_unit_price_map_first -%},{%- endunless -%}
            {{ item.key | json }}:{{ item.unit_price | unit_price_with_measurement: item.unit_price_measurement | json }}
            {%- assign cart_unit_price_map_first = false -%}
        {%- endif -%}
    {%- endfor -%}
    }
{%- endcapture -%}
{%- capture cart_quantity_constraints_json -%}
    {
    {%- for item in cart.items -%}
        {%- unless forloop.first -%},{%- endunless -%}
        {{ item.key | json }}:{%- render 'quantity-constraints', variant: item.variant, surface: 'cart', value: item.quantity -%}
    {%- endfor -%}
    }
{%- endcapture -%}

<div
    data-section-id="{{ section.id }}"
    class="cart-overlay-section"
>
    <div
        data-cart-unit-price-map
        hidden
        data-map="{{ cart_unit_prices_json | strip | escape }}"
    ></div>
    <div
        data-cart-quantity-constraints-map
        hidden
        data-map="{{ cart_quantity_constraints_json | strip | escape }}"
    ></div>
    {%- capture drawer_content -%}
        <div
            data-dialog-id="{{ popup_id }}"
            class="flex h-full flex-col"
            data-cart-sections='["{{ section.id }}"]'
            data-section-id="{{ section.id }}"
            x-data="cartOverlay()"
            @keydown.escape.window="$store.dialog.close()"
            :class="{ 'opacity-80': $store.cart.loading && showItems }"
        >
            <div class="ui-dialog-overlay-header">
                <h1 
                    id="dialog-title-{{ popup_id }}"
                >
                    {{ 'cart.title' | t }}
                </h1>

                <button
                    type="button"
                    class="close-button"
                    @click="$store.dialog.close()"
                    aria-label="{{ 'accessibility.close_cart_drawer' | t }}"
                >
                    {% render 'icons', icon: 'icon-close' %}
                </button>
            </div>

            <div class="ui-dialog-overlay-body pc:px-6 pc:py-4">
                <div
                    x-show="showInitialLoading"
                    class="flex h-full items-center justify-center text-center"
                    role="status"
                    aria-live="polite"
                >
                    <p>{{ 'cart.loading' | t }}</p>
                </div>

                <div x-show="showEmpty" class="flex h-full items-center justify-center text-center">
                    <p>{{ 'cart.empty' | t }}</p>
                </div>

                <ul x-show="showItems" class="flex flex-col divide-y divide-theme-border/20">
                    <template x-for="item in items" :key="item.key">
                        <li
                            class="grid grid-cols-[minmax(6rem,0.95fr)_minmax(0,1.35fr)_auto] gap-4 py-3"
                            data-cart-product-alt="{{ 'cart.product_alt' | t | escape }}"
                            data-cart-item-fallback="{{ 'general.item' | t | escape }}"
                        >
                            <a
                                :href="item.url"
                                class="flex aspect-square w-full items-center justify-center overflow-hidden bg-theme-bg/50"
                            >
                                <img
                                    class="h-full w-full object-contain p-3"
                                    :src="typeof item.image === 'string' ? item.image : (item.image?.url || item.featured_image?.url || '')"
                                    :alt="item.product_title || item.title || $el.closest('li').dataset.cartProductAlt"
                                    width="120"
                                    height="120"
                                    loading="lazy"
                                >
                            </a>

                            <div class="flex min-w-0 flex-col py-1">
                                <p class="body-sm uppercase" x-text="item.vendor || ''"></p>
                                <a
                                    :href="item.url"
                                    class="cart-overlay__product-link mt-3 line-clamp-2 body-lg interactive-link"
                                    x-text="item.product_title || item.title"
                                >
                                </a>
                                <template x-if="normalizedOptions(item).length > 0">
                                    <ul class="mt-1 body-xs text-theme-text/80">
                                        <template
                                            x-for="option in normalizedOptions(item)"
                                            :key="option.key"
                                        >
                                            <li
                                                x-text="option.name ? (option.name + ': ' + option.value) : option.value"
                                            ></li>
                                        </template>
                                    </ul>
                                </template>
                                <template x-if="item.selling_plan_allocation && item.selling_plan_allocation.selling_plan">
                                    <p class="mt-1 body-xs text-theme-text/80" x-text="'{{ 'cart.selling_plan_label' | t | escape }}: ' + item.selling_plan_allocation.selling_plan.name"></p>
                                </template>
                                <template x-if="publicProperties(item).length > 0">
                                    <ul class="mt-1 body-xs text-theme-text/80">
                                        <template
                                            x-for="property in publicProperties(item)"
                                            :key="property.key"
                                        >
                                            <li>
                                                <span x-text="property.label + ':'"></span>
                                                <template x-if="property.uploadUrl">
                                                    <a
                                                        class="ms-1 interactive-link"
                                                        :href="property.uploadUrl"
                                                        x-text="property.fileName || property.value"
                                                    ></a>
                                                </template>
                                                <template x-if="!property.uploadUrl">
                                                    <span class="ms-1" x-text="property.value"></span>
                                                </template>
                                            </li>
                                        </template>
                                    </ul>
                                </template>
                                <div class="mt-auto pt-4">
                                    <p class="body-xs text-theme-text/80">
                                        <template x-if="Number(item.original_price || 0) > Number(item.final_price || 0)">
                                            <span>
                                                <span
                                                    class="line-through"
                                                    x-text="formatMoney(item.original_price)"
                                                ></span>
                                                <span
                                                    class="ms-1"
                                                    x-text="formatMoney(item.final_price)"
                                                ></span>
                                            </span>
                                        </template>
                                        <template x-if="!(Number(item.original_price || 0) > Number(item.final_price || 0))">
                                            <span x-text="perUnitPrice(item)"></span>
                                        </template>
                                    </p>
                                    <template x-if="item.original_line_price > item.final_line_price">
                                        <p>
                                            <span
                                                class="text-theme-text/80 line-through"
                                                x-text="formatMoney(item.original_line_price)"
                                            ></span>
                                            <span
                                                class="ms-1"
                                                x-text="formatMoney(item.final_line_price)"
                                            ></span>
                                        </p>
                                    </template>
                                    <template x-if="!(item.original_line_price > item.final_line_price)">
                                        <p x-text="linePrice(item)"></p>
                                    </template>
                                    <template x-if="unitPriceText(item)">
                                        <p
                                            class="mt-1 body-xs text-theme-text/80"
                                            x-text="unitPriceText(item)"
                                        ></p>
                                    </template>
                                    <template x-if="item.line_level_discount_allocations && item.line_level_discount_allocations.length > 0">
                                        <ul class="mt-1">
                                            <template
                                                x-for="alloc in item.line_level_discount_allocations"
                                                :key="alloc.discount_application.title"
                                            >
                                                <li
                                                    class="body-xs text-theme-text/80"
                                                    x-text="alloc.discount_application.title + ' (-' + formatMoney(alloc.amount) + ')'"
                                                ></li>
                                            </template>
                                        </ul>
                                    </template>
                                </div>
                            </div>

                            <div class="flex shrink-0 flex-col items-end justify-between py-1">
                                <button
                                    type="button"
                                    class="cart-overlay__remove-button"
                                    @click="remove(item)"
                                    :disabled="$store.cart.loading || pending[item.key]"
                                    data-remove-item-label="{{ 'accessibility.remove_item' | t: item: '__ITEM__' | escape }}"
                                    :aria-label="$el.dataset.removeItemLabel.replace('__ITEM__', item.product_title || item.title || $el.closest('li').dataset.cartItemFallback)"
                                >
                                    {% render 'icons', icon: 'icon-trash' %}
                                </button>

                                <div class="quantity-selector">
                                    <button
                                        type="button"
                                        class="quantity-selector__button"
                                        @click="decrement(item)"
                                        :disabled="$store.cart.loading || pending[item.key] || !canDecrement(item)"
                                        aria-label="{{ 'accessibility.decrease_quantity' | t }}"
                                    >
                                        {% render 'icons', icon: 'icon-minus' %}
                                    </button>

                                    <span
                                        class="quantity-selector__value"
                                        x-text="item.quantity"
                                    >
                                    </span>

                                    <button
                                        type="button"
                                        class="quantity-selector__button"
                                        @click="increment(item)"
                                        :disabled="$store.cart.loading || pending[item.key] || !canIncrement(item)"
                                        aria-label="{{ 'accessibility.increase_quantity' | t }}"
                                    >
                                        {% render 'icons', icon: 'icon-plus' %}
                                    </button>
                                </div>
                            </div>
                        </li>
                    </template>
                </ul>

                <div x-show="showItems" class="pt-4 text-center">
                    {%- assign link_text = 'cart.add_more_product' | t -%}
                    {%- render 'link',
                        text: link_text,
                        href: routes.all_products_collection_url,
                        variant: 'underline'
                    -%}
                </div>
            </div>

            <div class="ui-dialog-overlay-footer mt-auto pc:px-6 pc:py-4">
                <template x-if="$store.cart.cart_level_discount_applications && $store.cart.cart_level_discount_applications.length > 0">
                    <div class="mb-3">
                        <p class="body-sm font-medium">{{ 'cart.discounts' | t }}</p>
                        <ul class="mt-2 space-y-1">
                            <template x-for="disc in $store.cart.cart_level_discount_applications" :key="disc.title">
                                <li class="flex items-baseline justify-between gap-4 body-sm text-theme-text/80">
                                    <span x-text="disc.title"></span>
                                    <span x-text="'-' + formatMoney(disc.total_allocated_amount)"></span>
                                </li>
                            </template>
                        </ul>
                    </div>
                </template>

                <template x-if="$store.cart.total_discount > 0">
                    <div class="mb-3 flex items-center justify-between body-sm">
                        <span>{{ 'cart.you_saved' | t }}</span>
                        <span class="text-theme-text/80" x-text="'-' + formatMoney($store.cart.total_discount)"></span>
                    </div>
                </template>

                <div class="mb-3 flex items-center justify-between">
                    <p>{{ 'cart.total' | t }}</p>
                    <p x-text="formatMoney($store.cart.total_price)"></p>
                </div>

                <div class="grid grid-cols-1 gap-2">
                    <button
                        type="button"
                        class="btn-secondary w-full"
                        @click="clearCart()"
                        :disabled="isEmpty || $store.cart.loading"
                    >
                        {{ 'cart.clear_all' | t }}<sup class="sup-badge" x-text="'(' + $store.cart.item_count + ')'"></sup>
                    </button>
                    <button
                        type="button"
                        class="btn-primary w-full"
                        @click="goCheckout()"
                        :disabled="!canCheckout"
                    >
                        {{ 'cart.checkout' | t }}<sup class="sup-badge" x-text="'(' + $store.cart.item_count + ')'"></sup>
                    </button>
                </div>
            </div>
        </div>
    {%- endcapture -%}

    {%- if request.visual_preview_mode -%}
        {%- liquid
            assign drawer_position = section.settings.drawer_position | default: 'right'
            assign drawer_side_class = 'right-0'
            if drawer_position == 'left'
                assign drawer_side_class = 'left-0'
            endif
        -%}
        <div
            class="z-layer-drawer-backdrop fixed inset-0"
            data-overlay-visual-preview="cart"
        >
            <div
                class="z-layer-drawer-backdrop fixed inset-x-0 top-[var(--announcement-bar-height)] bottom-0 bg-dialog-overlay pc:top-0"
            ></div>
            <div
                class="
                    ui-dialog-drawer-shell ui-dialog-drawer-width-default ui-dialog-desktop-drawer
                    ui-dialog-desktop-drawer--{{ drawer_position }} ui-dialog-mobile-layout-inset
                    z-layer-drawer fixed top-[var(--announcement-bar-height)] bottom-0 w-full
                    {{ drawer_side_class }} pc:top-0
                "
                role="dialog"
                aria-modal="true"
                aria-labelledby="dialog-title-{{ popup_id }}"
            >
                <div
                    class="ui-dialog-panel ui-dialog-drawer-panel ui-dialog-mobile-layout-panel color-{{ section.settings.color_scheme }} surface-component"
                >
                    <div class="flex h-full flex-col">
                        <div class="ui-dialog-overlay-header">
                            <h1 id="dialog-title-{{ popup_id }}">{{ 'cart.title' | t }}</h1>
                            <button
                                type="button"
                                class="close-button"
                                aria-label="{{ 'accessibility.close_cart_drawer' | t }}"
                                disabled
                            >
                                {% render 'icons', icon: 'icon-close' %}
                            </button>
                        </div>
                        <div class="ui-dialog-overlay-body flex h-full items-center justify-center text-center pc:px-6 pc:py-4">
                            <p>{{ 'cart.empty' | t }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {%- else -%}
        {%- render 'ui-dialog',
            id: popup_id,
            type: 'drawer',
            layer: 'drawer',
            position: section.settings.drawer_position,
            top_class: 'top-[var(--announcement-bar-height)] pc:top-0',
            color_scheme: section.settings.color_scheme,
            drawer_motion_sheet: true,
            mobile_layout: 'inset',
            drawer_desktop_layout: true,
            content: drawer_content
        -%}
    {%- endif -%}
</div>

{% stylesheet %}
    .cart-overlay__remove-button {
        display: inline-flex;
        cursor: pointer;
        align-items: center;
        justify-content: center;
        opacity: 0.8;
        transition: opacity var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease);
    }

    .cart-overlay__remove-button:hover {
        opacity: 1;
    }

    .cart-overlay__remove-button:focus-visible {
        outline: var(--focus-ring-width) solid
            rgba(var(--color-focus-ring), var(--focus-ring-opacity, 0.4));
        outline-offset: var(--focus-ring-offset);
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.cart-overlay.name",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "groups": ["custom.overlay"]
    },
    "limit": 1,
    "settings": [
        {
            "type": "select",
            "id": "drawer_position",
            "label": "t:sections.cart-overlay.settings.drawer_position",
            "default": "right",
            "options": [
                {
                    "value": "left",
                    "label": "t:sections.cart-overlay.options.left"
                },
                {
                    "value": "right",
                    "label": "t:sections.cart-overlay.options.right"
                }
            ]
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.cart-overlay.settings.color_scheme",
            "default": "scheme-2"
        }
    ],
    "presets": [
        {
            "name": "t:sections.cart-overlay.presets.cart_overlay"
        }
    ]
}
{% endschema %}
