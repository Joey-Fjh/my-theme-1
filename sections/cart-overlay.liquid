{%- assign popup_id = 'cart-overlay-drawer' -%}

<div
    data-section-id="{{ section.id }}"
    class="cart-overlay-section"
>
    {%- capture drawer_content -%}
        <div
            class="flex h-full flex-col text-theme-text"
            x-data="cartOverlay({ sections: ['{{ section.id }}'] })"
            @keydown.escape.window="$store.dialog.close()"
            :class="{ 'opacity-70 pointer-events-none': $store.cart.loading }"
        >
            <div class="p-6">
                <div class="flex items-center justify-between gap-4">
                    <h2 id="dialog-title-{{ popup_id }}">Cart</h2>
                    <button
                        type="button"
                        class="inline-flex h-8 w-8 cursor-pointer items-center justify-center text-theme-text/75 transition hover:text-theme-text"
                        @click="$store.dialog.close()"
                        aria-label="Close cart drawer"
                    >
                        {% render 'icons', icon: 'icon-close', size: 'lg', color: 'current' %}
                    </button>
                </div>
            </div>

            <div class="min-h-0 flex-1 overflow-y-auto px-5 py-4 pc:px-6">
                <div x-show="isEmpty" class="flex h-full items-center justify-center text-center">
                    <p class="body-md">Your cart is empty.</p>
                </div>

                <ul x-show="!isEmpty" class="flex flex-col divide-y divide-theme-border-soft">
                    <template x-for="item in items" :key="item.key">
                        <li class="flex gap-3 py-4">
                            <a :href="item.url" class="h-20 w-20 shrink-0 overflow-hidden bg-theme-bg/60">
                                <img
                                    class="h-full w-full object-cover"
                                    :src="typeof item.image === 'string' ? item.image : (item.image?.url || item.featured_image?.url || '')"
                                    :alt="item.product_title || item.title || 'Cart product'"
                                    width="80"
                                    height="80"
                                >
                            </a>

                            <div class="flex min-w-0 flex-1 flex-col">
                                <p class="body-md tracking-[0.14em] uppercase opacity-70" x-text="item.vendor || ''"></p>
                                <a :href="item.url" class="mt-1 line-clamp-2 body-md leading-tight hover:underline" x-text="item.product_title || item.title"></a>
                                <p class="mt-2 body-md" x-text="linePrice(item)"></p>
                            </div>

                            <div class="flex shrink-0 flex-col items-end justify-between gap-3">
                                <button
                                    type="button"
                                    class="inline-flex h-6 w-6 cursor-pointer items-center justify-center opacity-75 hover:opacity-100"
                                    @click="remove(item)"
                                    :aria-label="'Remove ' + (item.product_title || item.title || 'item')"
                                >
                                    {% render 'icons', icon: 'icon-trash', size: 'sm', color: 'current' %}
                                </button>

                                <div class="flex items-center gap-2 border border-theme-border-soft px-1.5 py-0.5">
                                    <button
                                        type="button"
                                        class="inline-flex h-6 w-6 cursor-pointer items-center justify-center disabled:opacity-35"
                                        @click="decrement(item)"
                                        :disabled="Number(item.quantity || 0) <= 1"
                                        aria-label="Decrease quantity"
                                    >
                                        {% render 'icons', icon: 'icon-minus', size: 'sm', color: 'current' %}
                                    </button>

                                    <span class="min-w-[2ch] text-center body-md tabular-nums" x-text="item.quantity"></span>
                                    
                                    <button
                                        type="button"
                                        class="inline-flex h-6 w-6 cursor-pointer items-center justify-center disabled:opacity-35"
                                        @click="increment(item)"
                                        :disabled="maxQty(item) !== null && Number(item.quantity || 0) >= maxQty(item)"
                                        aria-label="Increase quantity"
                                    >
                                        {% render 'icons', icon: 'icon-plus', size: 'sm', color: 'current' %}
                                    </button>
                                </div>
                            </div>
                        </li>
                    </template>
                </ul>

                <div x-show="!isEmpty" class="pt-4 text-center">
                    {%- render 'link', 
                        text: 'Add More Product', 
                        href: routes.all_products_collection_url, 
                        variant: 'underline'
                    -%}
                </div>
            </div>

            <div class="mt-auto border-t border-theme-border-soft bg-theme-bg px-5 py-4 pc:px-6">
                <div class="mb-3 flex items-center justify-between">
                    <p class="body-md tracking-[0.12em] uppercase">Total</p>
                    <p class="body-md" x-text="formatMoney($store.cart.total_price)"></p>
                </div>

                <div class="grid grid-cols-1 gap-2">
                    <button
                        type="button"
                        class="w-full cursor-pointer border border-theme-border-strong px-4 py-3 text-theme-text transition-colors hover:bg-theme-bg/80 disabled:cursor-not-allowed disabled:opacity-45"
                        @click="clearCart()"
                        :disabled="isEmpty || $store.cart.loading"
                    >
                        Clear out
                    </button>
                    <button
                        type="button"
                        class="w-full cursor-pointer border border-primary-border bg-primary px-4 py-3 text-primary-text transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-45"
                        @click="goCheckout()"
                        :disabled="!canCheckout"
                    >
                        Checkout <sup class="sup-badge" x-text="'(' + $store.cart.item_count + ')'"></sup>
                    </button>
                </div>
            </div>
        </div>
    {%- endcapture -%}

    {%- render 'ui-dialog',
        id: popup_id,
        type: 'drawer',
        position: 'right',
        top_class: 'top-[var(--announcement-bar-height)] pc:top-0',
        color_scheme: section.settings.color_scheme,
        root_class: 'z-[10010]',
        drawer_wrapper_class: '
            !left-1/2 !right-auto !-translate-x-1/2 !top-[calc(var(--announcement-bar-height)+3rem)] !bottom-12 !w-[calc(100%-2rem)] !max-w-none 
            pc:!left-auto pc:!right-0 pc:!-translate-x-0 pc:!top-[var(--announcement-bar-height)] pc:!bottom-0 pc:!w-full pc:!max-w-[40rem] fw:!max-w-[33vw]
        ',
        drawer_panel_class: 'overflow-hidden',
        content: drawer_content
    -%}
</div>

{% schema %}
{
    "name": "Cart Overlay",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "groups": ["custom.overlay"]
    },
    "limit": 1,
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "scheme-1"
        }
    ],
    "presets": [
        {
            "name": "Cart Overlay"
        }
    ]
}
{% endschema %}
