{%- assign popup_id = 'cart-overlay-drawer' -%}

<div
    data-section-id="{{ section.id }}"
    class="cart-overlay-section"
>
    {%- capture drawer_content -%}
        <div
            data-dialog-id="{{ popup_id }}"
            class="flex h-full flex-col text-theme-text"
            data-cart-sections='["{{ section.id }}"]'
            x-data="cartOverlay()"
            @keydown.escape.window="$store.dialog.close()"
            :class="{ 'opacity-70': $store.cart.loading && showItems }"
        >
            <div class="p-6">
                <div class="flex items-center justify-between gap-4">
                    <h2 id="dialog-title-{{ popup_id }}" class="h3 font-semibold">{{ 'cart.title' | t }}</h2>
                    <button
                        type="button"
                        class="inline-flex h-11 w-11 cursor-pointer items-center justify-center text-theme-text/75 transition hover:text-theme-text"
                        @click="$store.dialog.close()"
                        aria-label="{{ 'accessibility.close_cart_drawer' | t }}"
                    >
                        {% render 'icons', icon: 'icon-close', size: 'xl', color: 'current' %}
                    </button>
                </div>
            </div>

            <div class="min-h-0 flex-1 overflow-y-auto px-5 py-4 pc:px-6">
                <div
                    x-show="showInitialLoading"
                    class="flex h-full items-center justify-center text-center"
                    role="status"
                    aria-live="polite"
                >
                    <p class="body-md">{{ 'cart.loading' | t }}</p>
                </div>

                <div x-show="showEmpty" class="flex h-full items-center justify-center text-center">
                    <p class="body-md">{{ 'cart.empty' | t }}</p>
                </div>

                <ul x-show="showItems" class="flex flex-col divide-y divide-theme-border-soft">
                    <template x-for="item in items" :key="item.key">
                        <li class="grid grid-cols-[minmax(6rem,0.95fr)_minmax(0,1.35fr)_auto] gap-4 py-3">
                            <a
                                :href="item.url"
                                class="flex aspect-square w-full items-center justify-center overflow-hidden bg-theme-bg/50"
                            >
                                <img
                                    class="h-full w-full object-contain p-3"
                                    :src="typeof item.image === 'string' ? item.image : (item.image?.url || item.featured_image?.url || '')"
                                    :alt="item.product_title || item.title || 'Cart product'"
                                    width="120"
                                    height="120"
                                    loading="lazy"
                                >
                            </a>

                            <div class="flex min-w-0 flex-col py-1">
                                <p class="body-md tracking-[0.08em] uppercase opacity-70" x-text="item.vendor || ''"></p>
                                <a
                                    :href="item.url"
                                    class="mt-1 line-clamp-2 body-md leading-tight hover:underline"
                                    x-text="item.product_title || item.title"
                                ></a>
                                <p class="mt-auto pt-4 body-md" x-text="linePrice(item)"></p>
                            </div>

                            <div class="flex shrink-0 flex-col items-end justify-between py-1">
                                <button
                                    type="button"
                                    class="inline-flex h-10 w-10 cursor-pointer items-center justify-center opacity-75 hover:opacity-100"
                                    @click="remove(item)"
                                    data-remove-item-label="{{ 'accessibility.remove_item' | t: item: '__ITEM__' | escape }}"
                                    :aria-label="$el.dataset.removeItemLabel.replace('__ITEM__', item.product_title || item.title || 'item')"
                                >
                                    {% render 'icons', icon: 'icon-trash', size: 'xl', color: 'current' %}
                                </button>

                                <div class="flex items-center gap-2">
                                    <button
                                        type="button"
                                        class="inline-flex h-10 w-10 cursor-pointer items-center justify-center disabled:opacity-35"
                                        @click="decrement(item)"
                                        :disabled="Number(item.quantity || 0) <= 1"
                                        aria-label="{{ 'accessibility.decrease_quantity' | t }}"
                                    >
                                        {% render 'icons', icon: 'icon-minus', size: 'xl', color: 'current' %}
                                    </button>

                                    <span class="min-w-9 border-b border-theme-border-strong px-2 pb-1 text-center body-md tabular-nums" x-text="item.quantity"></span>
                                    
                                    <button
                                        type="button"
                                        class="inline-flex h-10 w-10 cursor-pointer items-center justify-center disabled:opacity-35"
                                        @click="increment(item)"
                                        :disabled="maxQty(item) !== null && Number(item.quantity || 0) >= maxQty(item)"
                                        aria-label="{{ 'accessibility.increase_quantity' | t }}"
                                    >
                                        {% render 'icons', icon: 'icon-plus', size: 'xl', color: 'current' %}
                                    </button>
                                </div>
                            </div>
                        </li>
                    </template>
                </ul>

                <div x-show="showItems" class="pt-4 text-center">
                    {%- render 'link',
                        text: 'cart.add_more_product' | t,
                        href: routes.all_products_collection_url,
                        variant: 'underline',
                        class: 'body-md'
                    -%}
                </div>
            </div>

            <div class="mt-auto border-t border-theme-border-soft bg-theme-bg px-5 py-4 pc:px-6">
                <div class="mb-3 flex items-center justify-between">
                    <p class="body-md font-semibold tracking-[0.12em] uppercase">{{ 'cart.total' | t }}</p>
                    <p class="body-md" x-text="formatMoney($store.cart.total_price)"></p>
                </div>

                <div class="grid grid-cols-1 gap-2">
                    <button
                        type="button"
                        class="w-full cursor-pointer border border-theme-border-strong px-4 py-3 body-md text-theme-text transition-colors hover:bg-theme-bg/80 disabled:cursor-not-allowed disabled:opacity-45"
                        @click="clearCart()"
                        :disabled="isEmpty || $store.cart.loading"
                    >
                        {{ 'cart.clear_all' | t }}<sup class="sup-badge" x-text="'(' + $store.cart.item_count + ')'"></sup>
                    </button>
                    <button
                        type="button"
                        class="w-full cursor-pointer border border-primary-border bg-primary px-4 py-3 body-md text-primary-text transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-45"
                        @click="goCheckout()"
                        :disabled="!canCheckout"
                    >
                        {{ 'cart.checkout' | t }}<sup class="sup-badge" x-text="'(' + $store.cart.item_count + ')'"></sup>
                    </button>
                </div>
            </div>
        </div>
    {%- endcapture -%}

    {%- render 'ui-dialog',
        id: popup_id,
        type: 'drawer',
        position: 'right',
        top_class: 'top-[var(--announcement-bar-height)] pc:top-0',
        color_scheme: section.settings.color_scheme,
        root_class: 'z-[10010]',
        drawer_wrapper_class: '
            !left-1/2 !right-auto !-translate-x-1/2 !top-[calc(var(--announcement-bar-height)+3rem)] !bottom-12 !w-[calc(100%-2rem)] !max-w-none
            pc:!left-auto pc:!right-0 pc:!-translate-x-0 pc:!top-[var(--announcement-bar-height)] pc:!bottom-0 pc:!w-full pc:!max-w-[40rem] fw:!max-w-[33vw]
        ',
        drawer_panel_class: 'overflow-hidden',
        content: drawer_content
    -%}
</div>

{% schema %}
{
    "name": "t:sections.cart-overlay.name",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "groups": ["custom.overlay"]
    },
    "limit": 1,
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.cart-overlay.settings.color_scheme",
            "default": "scheme-1"
        }
    ],
    "presets": [
        {
            "name": "t:sections.cart-overlay.presets.cart_overlay"
        }
    ]
}
{% endschema %}
