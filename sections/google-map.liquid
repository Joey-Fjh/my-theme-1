{%- if section.settings.show_map -%}
    {%- liquid
        assign google_map_root_style = '--map-height: ' | append: section.settings.map_height | append: 'px;'
    -%}
    {%- if section.settings.map_embed_code != blank -%}
        {%- liquid
            assign map_embed_code = section.settings.map_embed_code
            unless map_embed_code contains 'title='
                assign map_title = 'accessibility.google_map' | t | escape
                capture iframe_opening_tag
                    echo '<iframe title="' | append: map_title | append: '"'
                endcapture
                assign map_embed_code = map_embed_code | replace_first: '<iframe', iframe_opening_tag
            endunless
        -%}

        {%- capture google_map_children -%}
            <div class="google-map-section__embed">
                {{ map_embed_code }}
            </div>
        {%- endcapture -%}

        {% render 'section-frame',
            section: section,
            section_class: 'google-map-section',
            width: 'full',
            motion: false,
            surface_section: false,
            root_style: google_map_root_style,
            children: google_map_children
        %}
    {%- elsif request.visual_preview_mode -%}
        {%- capture google_map_preview_children -%}
            <div
                class="google-map-section__embed google-map-section__embed--preview flex flex-col items-center justify-center gap-3 bg-surface-muted text-center"
                role="img"
                aria-label="{{ 'sections.google-map.visual_preview_label' | t | escape }}"
            >
                {% render 'icons', icon: 'icon-info-circle', class: 'opacity-60' %}
                <p class="body-md text-muted">
                    {{ 'sections.google-map.visual_preview_hint' | t }}
                </p>
            </div>
        {%- endcapture -%}

        {% render 'section-frame',
            section: section,
            section_class: 'google-map-section',
            width: 'full',
            motion: false,
            surface_section: false,
            root_style: google_map_root_style,
            children: google_map_preview_children
        %}
    {%- endif -%}
{%- endif -%}

{%- stylesheet -%}
    .google-map-section__embed {
        width: 100%;
        height: var(--map-height);
        overflow: hidden;
    }

    .google-map-section__embed iframe {
        display: block;
        width: 100% !important;
        height: 100% !important;
        max-width: 100%;
        border: 0;
    }
{%- endstylesheet -%}

{% schema %}
{
    "name": "t:sections.google-map.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer", "custom.overlay"]
    },
    "settings": [
        {
            "type": "checkbox",
            "id": "show_map",
            "label": "t:sections.google-map.settings.show_map",
            "default": true
        },
        {
            "type": "textarea",
            "id": "map_embed_code",
            "label": "t:sections.google-map.settings.map_embed_code",
            "info": "t:sections.google-map.info.map_embed_code"
        },
        {
            "type": "range",
            "id": "map_height",
            "min": 200,
            "max": 1000,
            "step": 10,
            "unit": "px",
            "label": "t:sections.google-map.settings.map_height",
            "default": 450
        },
        {
            "type": "header",
            "content": "t:sections.google-map.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.google-map.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.google-map.settings.padding_bottom",
            "default": 32
        }
    ],
    "presets": [
        {
            "name": "t:sections.google-map.presets.google_map"
        }
    ]
}
{% endschema %}
