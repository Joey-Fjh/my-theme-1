<div
    data-section-id="{{ section.id }}"
    class="about-stats-section full-width color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <div class="layout container-page bg-theme-bg text-theme-text">
        <div class="flex flex-col gap-20 pc:flex-row pc:gap-80">
            {% comment %} Image {% endcomment %}
            {%- liquid
                assign primary_image = section.settings.image
                assign secondary_image = section.settings.image_secondary
                assign display_image = primary_image | default: secondary_image
                assign has_both_images = false
                if primary_image != blank and secondary_image != blank
                    assign has_both_images = true
                endif
            -%}
            <div class="relative shrink-0">
                {%- if has_both_images -%}
                    <div class="flex w-full gap-4 pc:hidden">
                        <div class="h-56 w-1/2 overflow-hidden">
                            {%- render 'image',
                                image: primary_image,
                                alt: primary_image.alt,
                                width: primary_image.width
                            -%}
                        </div>
                        <div class="h-56 w-1/2 overflow-hidden">
                            {%- render 'image',
                                image: secondary_image,
                                alt: secondary_image.alt,
                                width: secondary_image.width
                            -%}
                        </div>
                    </div>

                    <div
                        class="relative hidden h-100 w-64 pc:block"
                        x-data="{ activeImage: 'primary' }"
                    >
                        <button
                            type="button"
                            class="absolute left-0 h-64 w-64 overflow-hidden transition-all duration-500 ease-out"
                            :class="activeImage === 'primary' ? 'top-0 z-20 opacity-100' : 'top-36 z-10 opacity-95'"
                            @click="activeImage = 'primary'"
                            aria-label="{{ 'accessibility.show_first_image' | t }}"
                        >
                            {%- render 'image',
                                image: primary_image,
                                alt: primary_image.alt,
                                width: primary_image.width
                            -%}
                        </button>

                        <button
                            type="button"
                            class="absolute left-0 h-64 w-64 overflow-hidden transition-all duration-500 ease-out"
                            :class="activeImage === 'secondary' ? 'top-0 z-20 opacity-100' : 'top-36 z-10 opacity-95'"
                            @click="activeImage = 'secondary'"
                            aria-label="{{ 'accessibility.show_second_image' | t }}"
                        >
                            {%- render 'image',
                                image: secondary_image,
                                alt: secondary_image.alt,
                                width: secondary_image.width
                            -%}
                        </button>
                    </div>
                {%- else -%}
                    <div class="h-56 w-56 overflow-hidden pc:hidden">
                        {%- render 'image',
                            image: display_image,
                            alt: display_image.alt,
                            width: display_image.width
                        -%}
                    </div>
                    <div class="hidden h-64 w-64 overflow-hidden pc:block">
                        {%- render 'image',
                            image: display_image,
                            alt: display_image.alt,
                            width: display_image.width
                        -%}
                    </div>
                {%- endif -%}
            </div>

            {% comment %} Content {% endcomment %}
            <div class="flex flex-1 flex-col gap-12 pc:gap-20">
                <p class="body-md opacity-80">
                    {{ section.settings.year }}
                </p>

                <div class="body-lg pc:body-xl font-bold">
                    {{ section.settings.description }}
                </div>

                {%- if section.settings.link != blank -%}
                    {%- capture link_content -%}
                        <span>{{ section.settings.link_text }}</span>
                        {% render 'icons', icon: 'icon-arrow2', size: 'lg', class: 'ml-3', color: 'current' %}
                    {%- endcapture -%}

                    {%- render 'link',
                        href: section.settings.link,
                        content: link_content,
                        variant: 'underline',
                        color: 'current'
                    -%}
                {%- endif -%}

                {% comment %} Stats {% endcomment %}
                <div class="flex gap-12 pc:gap-16 fw:gap-24">
                    {%- for block in section.blocks -%}
                        <div
                            class="mt-25"
                            {{ block.shopify_attributes }}
                        >
                            <p class="mb-2 body-lg opacity-80">{{ block.settings.label }}</p>
                            <p class="body-lg pc:body-xl font-bold">{{ block.settings.value }}</p>
                        </div>
                    {%- endfor -%}
                </div>
            </div>
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:sections.about-stats.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": [
            "header",
            "footer"
        ]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.about-stats.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:sections.about-stats.settings.image"
        },
        {
            "type": "image_picker",
            "id": "image_secondary",
            "label": "t:sections.about-stats.settings.secondary_image"
        },
        {
            "type": "text",
            "id": "year",
            "label": "t:sections.about-stats.settings.year_text",
            "default": "2026©"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "t:sections.about-stats.settings.description",
            "default": "<p>Personalized with AI insight. Personalized with AI insight. Personalized with AI insight. Personalized with AI insight.</p>"
        },
        {
            "type": "url",
            "id": "link",
            "label": "t:sections.about-stats.settings.link"
        },
        {
            "type": "text",
            "id": "link_text",
            "label": "t:sections.about-stats.settings.link_text",
            "default": "See Our New Product"
        },
        {
            "type": "header",
            "content": "t:sections.about-stats.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.about-stats.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.about-stats.settings.padding_bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "stat",
            "name": "t:sections.about-stats.blocks.stat",
            "settings": [
                {
                    "type": "inline_richtext",
                    "id": "label",
                    "label": "t:sections.about-stats.block_settings.label",
                    "default": "Authentic"
                },
                {
                    "type": "inline_richtext",
                    "id": "value",
                    "label": "t:sections.about-stats.block_settings.value",
                    "default": "100%"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.about-stats.presets.about_stats",
            "settings": {}
        }
    ]
}
    {% endschema %}
