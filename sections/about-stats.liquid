<div
    data-section-id="{{ section.id }}"
    class="about-stats-section full-width layout bg-[#F3F3F3] text-[#263D29]"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <div class="container-page">
        <div class="flex flex-col gap-12 pc:flex-row pc:gap-85">
            {% comment %} Image {% endcomment %}
            <div class="relative shrink-0 overflow-hidden h-64 w-full pc:h-fit pc:w-40 fw:w-48">
                {%- render 'image', 
                    image: section.settings.image,
                    alt: section.settings.image.alt,
                    width: section.settings.image.width    
                -%}
            </div>
            {% comment %} Content {% endcomment %}
            <div class="flex flex-col gap-20 flex-1">
                <p class="opacity-80">
                    {{ section.settings.year }}
                </p>
                
                <div class="leading-relaxed h1">
                    {{ section.settings.description }}
                </div>

                {%- if section.settings.link != blank -%}
                    {%- capture link_content -%}
                            <span>{{ section.settings.link_text }}</span>
                            <span class="inline-block w-6 h-6 ml-3">
                                {{- 'icon-arrow2.svg' | inline_asset_content -}}
                            </span>
                        {%- endcapture -%}
                        {%- render 'link', href: section.settings.link, content: link_content, variant: "underline" -%}
                {%- endif -%}

                {% comment %} Stats {% endcomment %}
                <div class="flex gap-12 pc:gap-16 fw:gap-24">
                    {%- for block in section.blocks -%}
                        <div 
                            class="mt-25"
                            {{ block.shopify_attributes }}
                        >
                            <p class="mb-2 opacity-80">{{ block.settings.label }}</p>
                            <p class="h1 font-bold">{{ block.settings.value }}</p>
                        </div>
                    {%- endfor -%}
                </div>
            </div>
        </div>
    </div>
</div>

{% schema %}
  {
    "name": "About Stats",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header","footer"]
    },
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "year",
            "label": "Year Text",
            "default": "2026©"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description",
            "default": "<p>Personalized with AI insight. Personalized with AI insight. Personalized with AI insight. Personalized with AI insight.</p>"
        },
        {
            "type": "url",
            "id": "link",
            "label": "Link"
        },
        {
            "type": "text",
            "id": "link_text",
            "label": "Link Text",
            "default": "See Our New Product"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "stat",
            "name": "Stat",
            "settings": [
                {
                    "type": "inline_richtext",
                    "id": "label",
                    "label": "Label",
                    "default": "Authentic"
                },
                {
                    "type": "inline_richtext",
                    "id": "value",
                    "label": "Value",
                    "default": "100%"
                }
            ]
        }
    ],
    "presets": [
      {
        "name": "About Stats",
        "settings": {
        }
      }
    ]
  }
{% endschema %}