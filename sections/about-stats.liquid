{%- liquid
    assign about_stats_stat_title_class = section.settings.stat_title_size | default: 'body-3xl'
    assign about_stats_stat_subtitle_class = section.settings.stat_subtitle_size | default: 'heading-2xl'
    assign about_stats_stat_subtitle_class = 'typo-subtitle ' | append: about_stats_stat_subtitle_class
-%}

<div
    data-section-id="{{ section.id }}"
    class="about-stats-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="motionRevealSection()"
    data-motion-section
>
    <div class="layout container-page">
        <div class="flex flex-col gap-12 pc:grid pc:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] pc:items-stretch pc:gap-20 fw:gap-28">
            {% comment %} Image {% endcomment %}
            {%- liquid
                assign primary_image = section.settings.image
                assign secondary_image = section.settings.image_secondary
                assign display_image = primary_image | default: secondary_image
                assign has_both_images = false
                if primary_image != blank and secondary_image != blank
                    assign has_both_images = true
                endif
            -%}
            <div class="relative w-full shrink-0">
                {%- if has_both_images -%}
                    <div class="w-full pc:hidden" data-motion-reveal="media">
                        <div class="aspect-square overflow-hidden">
                            {%- render 'image',
                                image: primary_image,
                                alt: primary_image.alt,
                                width: primary_image.width,
                                sizes: '100vw',
                                motion_reveal: false
                            -%}
                        </div>
                    </div>

                    <div
                        class="relative hidden aspect-square w-full pc:block"
                        x-data="{ activeImage: 'primary' }"
                    >
                        <button
                            type="button"
                            class="absolute top-0 left-0 aspect-square w-[62.5%] origin-center cursor-pointer overflow-hidden focus-ring transition-[transform,opacity,filter] duration-[520ms] ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform motion-reduce:transition-none"
                            :class="activeImage === 'primary' ? 'z-20 opacity-100 brightness-100 [transform:translate3d(0,0,0)_scale(1)]' : 'z-10 opacity-70 brightness-90 [transform:translate3d(1rem,1rem,0)_scale(0.94)]'"
                            @click="activeImage = 'primary'"
                            :aria-pressed="String(activeImage === 'primary')"
                            aria-label="{{ 'accessibility.show_first_image' | t }}"
                        >
                            {%- render 'image',
                                image: primary_image,
                                alt: primary_image.alt,
                                width: primary_image.width,
                                sizes: '(min-width: 1280px) 17vw, 16vw',
                                motion_reveal: false
                            -%}
                        </button>

                        <button
                            type="button"
                            class="absolute right-0 bottom-0 aspect-square w-[62.5%] origin-center cursor-pointer overflow-hidden focus-ring transition-[transform,opacity,filter] duration-[520ms] ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform motion-reduce:transition-none"
                            :class="activeImage === 'secondary' ? 'z-20 opacity-100 brightness-100 [transform:translate3d(0,0,0)_scale(1)]' : 'z-10 opacity-70 brightness-90 [transform:translate3d(-1rem,-1rem,0)_scale(0.94)]'"
                            @click="activeImage = 'secondary'"
                            :aria-pressed="String(activeImage === 'secondary')"
                            aria-label="{{ 'accessibility.show_second_image' | t }}"
                        >
                            {%- render 'image',
                                image: secondary_image,
                                alt: secondary_image.alt,
                                width: secondary_image.width,
                                sizes: '(min-width: 1280px) 17vw, 16vw',
                                motion_reveal: false
                            -%}
                        </button>
                    </div>
                {%- else -%}
                    <div
                        class="aspect-square w-full overflow-hidden pc:hidden"
                        data-motion-reveal="media"
                    >
                        {%- render 'image',
                            image: display_image,
                            alt: display_image.alt,
                            width: display_image.width,
                            sizes: '100vw',
                            motion_reveal: false
                        -%}
                    </div>
                    <div
                        class="hidden aspect-square w-full overflow-hidden pc:block"
                        data-motion-reveal="media"
                    >
                        {%- render 'image',
                            image: display_image,
                            alt: display_image.alt,
                            width: display_image.width,
                            sizes: '(min-width: 1280px) 32vw, 40vw',
                            motion_reveal: false
                        -%}
                    </div>
                {%- endif -%}
            </div>

            {% comment %} Content {% endcomment %}
            <div
                class="flex flex-1 flex-col gap-12 pc:h-full pc:justify-between pc:gap-16"
                data-motion-sequence
            >
                <p class="body-3xl" data-motion-reveal="content">
                    {{ section.settings.year }}
                </p>

                <div
                    class="rte rte--compact body-size-custom"
                    style="--body-size-custom: 24px; --body-size-custom-pc: 40px;"
                    data-motion-reveal="content"
                >
                    {{ section.settings.description }}
                </div>

                {%- if section.settings.link != blank -%}
                    {%- capture link_content -%}
                        <span>{{ section.settings.link_text }}</span>
                        {% render 'icons', icon: 'icon-arrow2', class: 'ms-3' %}
                    {%- endcapture -%}

                    <div class="w-fit" data-motion-reveal="content">
                        {%- render 'link',
                            href: section.settings.link,
                            content: link_content,
                            variant: 'underline',
                            class: 'body-xl'
                        -%}
                    </div>
                {%- endif -%}

                {% comment %} Stats {% endcomment %}
                <div
                    class="flex gap-12 pc:gap-16 fw:gap-24"
                    data-motion-reveal="content"
                >
                    {%- for block in section.blocks -%}
                        <div
                            class="mt-25"
                            {{ block.shopify_attributes }}
                        >
                            <p class="mb-2 {{ about_stats_stat_title_class }}">
                                {{ block.settings.label }}
                            </p>
                            <h3 class="{{ about_stats_stat_subtitle_class }}">
                                {{ block.settings.value }}
                            </h3>
                        </div>
                    {%- endfor -%}
                </div>
            </div>

            {%- if has_both_images -%}
                <div
                    class="aspect-square w-full overflow-hidden pc:hidden"
                    data-motion-reveal="media"
                >
                    {%- render 'image',
                        image: secondary_image,
                        alt: secondary_image.alt,
                        width: secondary_image.width,
                        sizes: '100vw',
                        motion_reveal: false
                    -%}
                </div>
            {%- endif -%}
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:sections.about-stats.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.about-stats.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.slides-show.content.font"
        },
        {
            "type": "header",
            "content": "t:sections.about-stats.content.stat_title"
        },
        {
            "type": "select",
            "id": "stat_title_size",
            "label": "t:sections.scroll-categories.settings.subtitle_size",
            "options": [
                {
                    "value": "body-3xl",
                    "label": "t:sections.scroll-categories.options.body_3xl"
                },
                {
                    "value": "body-2xl",
                    "label": "t:sections.scroll-categories.options.body_2xl"
                },
                {
                    "value": "body-xl",
                    "label": "t:sections.scroll-categories.options.body_xl"
                },
                {
                    "value": "body-lg",
                    "label": "t:sections.scroll-categories.options.body_lg"
                },
                {
                    "value": "body-md",
                    "label": "t:sections.scroll-categories.options.body_md"
                },
                {
                    "value": "body-sm",
                    "label": "t:sections.scroll-categories.options.body_sm"
                }
            ],
            "default": "body-3xl"
        },
        {
            "type": "header",
            "content": "t:sections.about-stats.content.stat_subtitle"
        },
        {
            "type": "select",
            "id": "stat_subtitle_size",
            "label": "t:sections.slides-show.settings.heading_size",
            "options": [
                {
                    "value": "heading-4xl",
                    "label": "t:sections.slides-show.options.heading_4xl"
                },
                {
                    "value": "heading-3xl",
                    "label": "t:sections.slides-show.options.heading_3xl"
                },
                {
                    "value": "heading-2xl",
                    "label": "t:sections.slides-show.options.heading_2xl"
                },
                {
                    "value": "heading-xl",
                    "label": "t:sections.slides-show.options.heading_xl"
                },
                {
                    "value": "heading-h1",
                    "label": "t:sections.slides-show.options.heading_h1"
                },
                {
                    "value": "heading-h2",
                    "label": "t:sections.slides-show.options.heading_h2"
                },
                {
                    "value": "heading-h3",
                    "label": "t:sections.slides-show.options.heading_h3"
                },
                {
                    "value": "heading-h4",
                    "label": "t:sections.slides-show.options.heading_h4"
                },
                {
                    "value": "heading-h5",
                    "label": "t:sections.slides-show.options.heading_h5"
                },
                {
                    "value": "heading-h6",
                    "label": "t:sections.slides-show.options.heading_h6"
                }
            ],
            "default": "heading-2xl"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:sections.about-stats.settings.image"
        },
        {
            "type": "image_picker",
            "id": "image_secondary",
            "label": "t:sections.about-stats.settings.secondary_image"
        },
        {
            "type": "text",
            "id": "year",
            "label": "t:sections.about-stats.settings.year_text",
            "default": "2026©"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "t:sections.about-stats.settings.description",
            "default": "t:sections.about-stats.defaults.description_html"
        },
        {
            "type": "url",
            "id": "link",
            "label": "t:sections.about-stats.settings.link"
        },
        {
            "type": "text",
            "id": "link_text",
            "label": "t:sections.about-stats.settings.link_text",
            "default": "t:sections.about-stats.defaults.link_text"
        },
        {
            "type": "header",
            "content": "t:sections.about-stats.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.about-stats.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.about-stats.settings.padding_bottom",
            "default": 32
        }
    ],
    "blocks": [
        {
            "type": "stat",
            "name": "t:sections.about-stats.blocks.stat",
            "settings": [
                {
                    "type": "inline_richtext",
                    "id": "label",
                    "label": "t:sections.about-stats.block_settings.label",
                    "default": "t:sections.about-stats.defaults.block_label"
                },
                {
                    "type": "inline_richtext",
                    "id": "value",
                    "label": "t:sections.about-stats.block_settings.value",
                    "default": "100%"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.about-stats.presets.about_stats",
            "settings": {}
        }
    ]
}
{% endschema %}
