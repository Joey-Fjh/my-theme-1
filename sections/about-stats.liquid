<div
    data-section-id="{{ section.id }}"
    class="about-stats-section full-width color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <div class="layout container-page bg-theme-bg text-theme-text">
        <div class="flex flex-col gap-20 pc:flex-row pc:gap-80">
            {% comment %} Image {% endcomment %}
            {%- liquid
                assign primary_image = section.settings.image
                assign secondary_image = section.settings.image_secondary
                assign display_image = primary_image | default: secondary_image
                assign has_both_images = false
                if primary_image != blank and secondary_image != blank
                    assign has_both_images = true
                endif
            -%}
            <div class="relative shrink-0">
                {%- if has_both_images -%}
                    <div class="flex w-full gap-4 pc:hidden">
                        <div class="h-56 w-1/2 overflow-hidden">
                            {%- render 'image',
                                image: primary_image,
                                alt: primary_image.alt,
                                width: primary_image.width
                            -%}
                        </div>
                        <div class="h-56 w-1/2 overflow-hidden">
                            {%- render 'image',
                                image: secondary_image,
                                alt: secondary_image.alt,
                                width: secondary_image.width
                            -%}
                        </div>
                    </div>

                    <div
                        class="relative hidden h-100 w-64 pc:block"
                        x-data="{ activeImage: 'primary' }"
                    >
                        <button
                            type="button"
                            class="absolute left-0 h-64 w-64 overflow-hidden transition-all duration-500 ease-out"
                            :class="activeImage === 'primary' ? 'top-0 z-20 opacity-100' : 'top-36 z-10 opacity-95'"
                            @click="activeImage = 'primary'"
                            aria-label="Show first image"
                        >
                            {%- render 'image',
                                image: primary_image,
                                alt: primary_image.alt,
                                width: primary_image.width
                            -%}
                        </button>

                        <button
                            type="button"
                            class="absolute left-0 h-64 w-64 overflow-hidden transition-all duration-500 ease-out"
                            :class="activeImage === 'secondary' ? 'top-0 z-20 opacity-100' : 'top-36 z-10 opacity-95'"
                            @click="activeImage = 'secondary'"
                            aria-label="Show second image"
                        >
                            {%- render 'image',
                                image: secondary_image,
                                alt: secondary_image.alt,
                                width: secondary_image.width
                            -%}
                        </button>
                    </div>
                {%- else -%}
                    <div class="h-56 w-56 overflow-hidden pc:hidden">
                        {%- render 'image',
                            image: display_image,
                            alt: display_image.alt,
                            width: display_image.width
                        -%}
                    </div>
                    <div class="hidden h-64 w-64 overflow-hidden pc:block">
                        {%- render 'image',
                            image: display_image,
                            alt: display_image.alt,
                            width: display_image.width
                        -%}
                    </div>
                {%- endif -%}
            </div>

            {% comment %} Content {% endcomment %}
            <div class="flex flex-1 flex-col gap-12 pc:gap-20">
                <p class="body-md opacity-80">
                    {{ section.settings.year }}
                </p>

                <div class="h2 pc:h1">
                    {{ section.settings.description }}
                </div>

                {%- if section.settings.link != blank -%}
                    {%- capture link_content -%}
                        <span>{{ section.settings.link_text }}</span>
                        {% render 'icons', icon: 'icon-arrow2', size: 'lg', class: 'ml-3', color: 'current' %}
                    {%- endcapture -%}

                    {%- render 'link',
                        href: section.settings.link,
                        content: link_content,
                        variant: 'underline',
                        color: 'current'
                    -%}
                {%- endif -%}

                {% comment %} Stats {% endcomment %}
                <div class="flex gap-12 pc:gap-16 fw:gap-24">
                    {%- for block in section.blocks -%}
                        <div
                            class="mt-25"
                            {{ block.shopify_attributes }}
                        >
                            <p class="mb-2 h4 opacity-80 pc:h3">{{ block.settings.label }}</p>
                            <p class="h2 pc:h1">{{ block.settings.value }}</p>
                        </div>
                    {%- endfor -%}
                </div>
            </div>
        </div>
    </div>
</div>

{% schema %}
{
    "name": "About Stats",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "scheme-1"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "image_picker",
            "id": "image_secondary",
            "label": "Secondary Image"
        },
        {
            "type": "text",
            "id": "year",
            "label": "Year Text",
            "default": "2026©"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description",
            "default": "<p>Personalized with AI insight. Personalized with AI insight. Personalized with AI insight. Personalized with AI insight.</p>"
        },
        {
            "type": "url",
            "id": "link",
            "label": "Link"
        },
        {
            "type": "text",
            "id": "link_text",
            "label": "Link Text",
            "default": "See Our New Product"
        },
        {
            "type": "header",
            "content": "Padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "stat",
            "name": "Stat",
            "settings": [
                {
                    "type": "inline_richtext",
                    "id": "label",
                    "label": "Label",
                    "default": "Authentic"
                },
                {
                    "type": "inline_richtext",
                    "id": "value",
                    "label": "Value",
                    "default": "100%"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "About Stats",
            "settings": {}
        }
    ]
}
{% endschema %}
