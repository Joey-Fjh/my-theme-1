<div
    data-section-id="{{ section.id }}"
    class="about-stats-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="motionRevealSection()"
    data-motion-section
>
    <div class="layout container-page">
        <div class="flex flex-col gap-12 pc:grid pc:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] pc:items-stretch pc:gap-20 fw:gap-28">
            {% comment %} Image {% endcomment %}
            {%- liquid
                assign primary_image = section.settings.image
                assign secondary_image = section.settings.image_secondary
                assign display_image = primary_image | default: secondary_image
                assign has_both_images = false
                if primary_image != blank and secondary_image != blank
                    assign has_both_images = true
                endif
            -%}
            <div class="relative w-full shrink-0">
                {%- if has_both_images -%}
                    <div class="w-full pc:hidden">
                        <div class="aspect-square overflow-hidden">
                            {%- render 'image',
                                image: primary_image,
                                alt: primary_image.alt,
                                width: primary_image.width,
                                sizes: '100vw'
                            -%}
                        </div>
                    </div>

                    <div
                        class="relative hidden aspect-square w-full pc:block"
                        x-data="{ activeImage: 'primary' }"
                    >
                        <button
                            type="button"
                            class="absolute top-0 left-0 aspect-square w-[62.5%] origin-center cursor-pointer overflow-hidden focus-ring transition-[transform,opacity,filter] duration-[520ms] ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform motion-reduce:transition-none"
                            :class="activeImage === 'primary' ? 'z-20 opacity-100 brightness-100 [transform:translate3d(0,0,0)_scale(1)]' : 'z-10 opacity-70 brightness-90 [transform:translate3d(1rem,1rem,0)_scale(0.94)]'"
                            @click="activeImage = 'primary'"
                            :aria-pressed="String(activeImage === 'primary')"
                            aria-label="{{ 'accessibility.show_first_image' | t }}"
                        >
                            {%- render 'image',
                                image: primary_image,
                                alt: primary_image.alt,
                                width: primary_image.width,
                                sizes: '(min-width: 1280px) 17vw, 16vw'
                            -%}
                        </button>

                        <button
                            type="button"
                            class="absolute right-0 bottom-0 aspect-square w-[62.5%] origin-center cursor-pointer overflow-hidden focus-ring transition-[transform,opacity,filter] duration-[520ms] ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform motion-reduce:transition-none"
                            :class="activeImage === 'secondary' ? 'z-20 opacity-100 brightness-100 [transform:translate3d(0,0,0)_scale(1)]' : 'z-10 opacity-70 brightness-90 [transform:translate3d(-1rem,-1rem,0)_scale(0.94)]'"
                            @click="activeImage = 'secondary'"
                            :aria-pressed="String(activeImage === 'secondary')"
                            aria-label="{{ 'accessibility.show_second_image' | t }}"
                        >
                            {%- render 'image',
                                image: secondary_image,
                                alt: secondary_image.alt,
                                width: secondary_image.width,
                                sizes: '(min-width: 1280px) 17vw, 16vw'
                            -%}
                        </button>
                    </div>
                {%- else -%}
                    <div class="aspect-square w-full overflow-hidden pc:hidden">
                        {%- render 'image',
                            image: display_image,
                            alt: display_image.alt,
                            width: display_image.width,
                            sizes: '100vw'
                        -%}
                    </div>
                    <div class="hidden aspect-square w-full overflow-hidden pc:block">
                        {%- render 'image',
                            image: display_image,
                            alt: display_image.alt,
                            width: display_image.width,
                            sizes: '(min-width: 1280px) 32vw, 40vw'
                        -%}
                    </div>
                {%- endif -%}
            </div>

            {% comment %} Content {% endcomment %}
            <div
                class="flex flex-1 flex-col gap-12 pc:h-full pc:justify-between pc:gap-16"
                data-motion-reveal="content"
            >
                <p>
                    {{ section.settings.year }}
                </p>

                <div class="rte rte--compact body-lg pc:body-xl">
                    {{ section.settings.description }}
                </div>

                {%- if section.settings.link != blank -%}
                    {%- capture link_content -%}
                        <span>{{ section.settings.link_text }}</span>
                        {% render 'icons', icon: 'icon-arrow2', class: 'ms-3' %}
                    {%- endcapture -%}

                    {%- render 'link',
                        href: section.settings.link,
                        content: link_content,
                        variant: 'underline'
                    -%}
                {%- endif -%}

                {% comment %} Stats {% endcomment %}
                <div class="flex gap-12 pc:gap-16 fw:gap-24">
                    {%- for block in section.blocks -%}
                        <div
                            class="mt-25"
                            {{ block.shopify_attributes }}
                        >
                            <p class="mb-2 body-lg">{{ block.settings.label }}</p>
                            <p>{{ block.settings.value }}</p>
                        </div>
                    {%- endfor -%}
                </div>
            </div>

            {%- if has_both_images -%}
                <div class="aspect-square w-full overflow-hidden pc:hidden">
                    {%- render 'image',
                        image: secondary_image,
                        alt: secondary_image.alt,
                        width: secondary_image.width,
                        sizes: '100vw'
                    -%}
                </div>
            {%- endif -%}
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:sections.about-stats.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.about-stats.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "t:sections.about-stats.settings.image"
        },
        {
            "type": "image_picker",
            "id": "image_secondary",
            "label": "t:sections.about-stats.settings.secondary_image"
        },
        {
            "type": "text",
            "id": "year",
            "label": "t:sections.about-stats.settings.year_text",
            "default": "2026©"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "t:sections.about-stats.settings.description",
            "default": "t:sections.about-stats.defaults.description_html"
        },
        {
            "type": "url",
            "id": "link",
            "label": "t:sections.about-stats.settings.link"
        },
        {
            "type": "text",
            "id": "link_text",
            "label": "t:sections.about-stats.settings.link_text",
            "default": "t:sections.about-stats.defaults.link_text"
        },
        {
            "type": "header",
            "content": "t:sections.about-stats.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.about-stats.settings.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.about-stats.settings.padding_bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "stat",
            "name": "t:sections.about-stats.blocks.stat",
            "settings": [
                {
                    "type": "inline_richtext",
                    "id": "label",
                    "label": "t:sections.about-stats.block_settings.label",
                    "default": "t:sections.about-stats.defaults.block_label"
                },
                {
                    "type": "inline_richtext",
                    "id": "value",
                    "label": "t:sections.about-stats.block_settings.value",
                    "default": "100%"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.about-stats.presets.about_stats",
            "settings": {}
        }
    ]
}
{% endschema %}
